      {heroSlides.map((_, i) => (
        <button data-dot={String(i)} class={`h-1.5 transition-all duration-300 ${i === 0 ? 'w-10 bg-white' : 'w-4 bg-white/40'}`} aria-label={`Slide ${i + 1}`}></button>
