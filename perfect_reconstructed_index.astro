function resolveProjectImage(p: any) {
  if (p.documentUrl && p.documentUrl.trim() !== '') {
    if (p.documentUrl.startsWith('/uploads/')) {
      return `${BACKEND_URL}${p.documentUrl}`;
    }
    return p.documentUrl;
  }
  return null;
}

const defaultProjectPhotos = allProjectsList
  .map((p: any, index: number) => {
    const img = resolveProjectImage(p);
    if (!img) return null;
    return {
      id: p.id || `proj-${index}`,
      title: p.name,
      caption: `${p.name}${p.capacityMw ? ` (${p.capacityMw} MW)` : ''}`,
      imageUrl: img,
      location: p.location || '',
      capacity: p.capacityMw ? `${p.capacityMw} MW` : undefined,
      desc: getCleanDesc(p.description),
      configuration: p.configuration || '—',
      designEnergy: p.designEnergy,
      yearOfCommissioning: p.yearOfCommissioning,
      href: `/our-business/power-station-details?id=${p.id}`,
    };
  })
  .filter(Boolean);

let displayProjectPhotos = defaultProjectPhotos;
