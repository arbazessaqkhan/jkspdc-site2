<script is:inline define:vars={{ heroSettings, welcomeSettings, aboutSettings }}>
(function () {
  function initAllCarousels() {
    var motionQuery = window.matchMedia('(prefers-reduced-motion: reduce)');
    var isReducedMotion = motionQuery.matches;

    /* ── HERO SLIDER ─────────────────────────────────────────── */
    var heroContainer = document.getElementById('hero-slides');
    var slideEls = heroContainer ? Array.from(heroContainer.children) : [];
    var total = slideEls.length;
    var cur = 0;
    var dots = Array.from(document.querySelectorAll('[data-dot]'));
    var heroTimer = null;

    var heroAutoplay = heroSettings.autoplay !== false;
    var heroDuration = (parseInt(heroSettings.duration, 10) || 6) * 1000;

    function goTo(n) {
      if (total <= 1) return;
      cur = ((n % total) + total) % total;

      slideEls.forEach(function (slide, idx) {
        if (idx === cur) {
          slide.classList.remove('opacity-0', 'z-0', 'pointer-events-none');
          slide.classList.add('opacity-100', 'z-10');
          var img = slide.querySelector('img');
          if (img && img.loading === 'lazy') {
            img.loading = 'eager';
          }
        } else {
          slide.classList.remove('opacity-100', 'z-10');
          slide.classList.add('opacity-0', 'z-0', 'pointer-events-none');
        }
      });

      dots.forEach(function (dot, idx) {
        if (idx === cur) {
          dot.className = 'h-1.5 transition-all duration-300 w-10 bg-white';
        } else {
          dot.className = 'h-1.5 transition-all duration-300 w-4 bg-white/40';
        }
      });
    }

    function startHeroTimer() {
      if (heroTimer) {
        clearInterval(heroTimer);
        heroTimer = null;
      }
      if (!heroAutoplay || total <= 1) return;
      heroTimer = setInterval(function () {
        goTo(cur + 1);
      }, heroDuration);
    }

    var heroSection = document.getElementById('home');
    if (heroSection) {
      heroSection.addEventListener('mouseenter', function () {
        if (heroTimer) clearInterval(heroTimer);
      });
      heroSection.addEventListener('mouseleave', function () {
        startHeroTimer();
      });
    }

    var prev = document.getElementById('hero-prev');
    if (prev) {
      prev.onclick = function (e) {
        if (e) e.preventDefault();
        goTo(cur - 1);
        startHeroTimer();
      };
    }

    var next = document.getElementById('hero-next');
    if (next) {
      next.onclick = function (e) {
        if (e) e.preventDefault();
        goTo(cur + 1);
        startHeroTimer();
      };
    }

    dots.forEach(function (d) {
      d.onclick = function (e) {
        if (e) e.preventDefault();
        var idx = parseInt(d.dataset.dot, 10);
        if (!isNaN(idx)) {
          goTo(idx);
          startHeroTimer();
        }
      };
    });

    startHeroTimer();

    /* ── OFFICE GALLERY CAROUSEL (Welcome Section) ────────────── */
    var oSlides = document.querySelectorAll('.office-slide');
    var oTotal = oSlides.length;
    var oCur = 0, oDots = document.querySelectorAll('[data-office-dot]');
    var officeTimer = null;

    var officeAutoplay = welcomeSettings.autoplay !== false;
    var officeDuration = (parseInt(welcomeSettings.duration, 10) || 5) * 1000;

    function goToOffice(n) {
      if (oTotal <= 1) return;
      oCur = ((n % oTotal) + oTotal) % oTotal;
      oSlides.forEach(function (slide, idx) {
        if (idx === oCur) {
          slide.classList.remove('opacity-0', 'z-0');
          slide.classList.add('opacity-100', 'z-10');
        } else {
          slide.classList.remove('opacity-100', 'z-10');
          slide.classList.add('opacity-0', 'z-0');
        }
      });
      oDots.forEach(function (dot, idx) {
        if (idx === oCur) {
          dot.className = 'w-1.5 h-1.5 transition-all duration-300 bg-white w-3';
        } else {
          dot.className = 'w-1.5 h-1.5 transition-all duration-300 bg-white/50';
        }
      });
    }

    function startOfficeTimer() {
      if (officeTimer) { clearInterval(officeTimer); officeTimer = null; }
      if (!officeAutoplay || oTotal <= 1) return;
      officeTimer = setInterval(function() { goToOffice(oCur + 1); }, officeDuration);
    }

    var officeContainer = document.getElementById('office-carousel-container');
    if (officeContainer) {
      officeContainer.addEventListener('mouseenter', function () {
        if (officeTimer) clearInterval(officeTimer);
      });
      officeContainer.addEventListener('mouseleave', function () {
        startOfficeTimer();
      });
    }

    var oPrev = document.getElementById('office-prev');
    if (oPrev) oPrev.onclick = function() { goToOffice(oCur - 1); startOfficeTimer(); };
    var oNext = document.getElementById('office-next');
    if (oNext) oNext.onclick = function() { goToOffice(oCur + 1); startOfficeTimer(); };
    oDots.forEach(function(d) {
      d.onclick = function() { goToOffice(parseInt(d.dataset.officeDot, 10)); startOfficeTimer(); };
    });

    startOfficeTimer();

    /* ── PROJECT GALLERY CAROUSEL (About Us Section) ─────────── */
    var pSlides = document.querySelectorAll('.project-slide');
    var pTotal = pSlides.length;
    var pCur = 0, pDots = document.querySelectorAll('[data-project-dot]');
    var projectTimer = null;

    var projectAutoplay = aboutSettings.autoplay !== false && !isReducedMotion;
    var projectDuration = (aboutSettings.duration || 5) * 1000;

    function goToProject(n) {
      if (pTotal === 0) return;
      if (pSlides[pCur]) {
        pSlides[pCur].classList.replace('opacity-100', 'opacity-0');
        pSlides[pCur].classList.replace('z-10', 'z-0');
      }
      if (pDots[pCur]) {
        pDots[pCur].className = 'w-2 h-2 transition-all duration-300 bg-white/50';
      }
      pCur = ((n % pTotal) + pTotal) % pTotal;
      if (pSlides[pCur]) {
        pSlides[pCur].classList.replace('opacity-0', 'opacity-100');
        pSlides[pCur].classList.replace('z-0', 'z-10');
      }
      if (pDots[pCur]) {
        pDots[pCur].className = 'w-2 h-2 transition-all duration-300 bg-white w-4';
      }
    }

    var pPrev = document.getElementById('project-prev');
    if (pPrev) pPrev.onclick = function() { goToProject(pCur - 1); };
    var pNext = document.getElementById('project-next');
    if (pNext) pNext.onclick = function() { goToProject(pCur + 1); };
    pDots.forEach(function(d) {
      d.onclick = function() { goToProject(parseInt(d.dataset.projectDot, 10)); };
    });

    if (projectAutoplay && pTotal > 1) {
      projectTimer = setInterval(function() { goToProject(pCur + 1); }, projectDuration);
    }

    // Cleanup on view transitions
    document.addEventListener('astro:before-swap', function cleanup() {
      if (heroTimer) clearInterval(heroTimer);
      if (officeTimer) clearInterval(officeTimer);
      if (projectTimer) clearInterval(projectTimer);
      document.removeEventListener('astro:before-swap', cleanup);
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initAllCarousels);
  } else {
    initAllCarousels();
  }
  document.addEventListener('astro:page-load', initAllCarousels);
})();

(function() {
  /* ── PROJECT FILTER & CATEGORY PREVIEW ───────────────────── */
  var cards = Array.from(document.querySelectorAll('.project-card'));
  var tabBtns = Array.from(document.querySelectorAll('.project-tab'));
  var searchEl = document.getElementById('project-search');
  var projectsGrid = document.getElementById('projects-grid');
  var emptyCategoryEl = document.getElementById('project-empty-category');
  var emptySearchEl = document.getElementById('project-empty-search');
  var viewAllBtn = document.getElementById('project-view-all-btn');

  var PREVIEW_LIMIT = 6;
  var isExpandedAll = false;

  var categoryNav = {
    'All': {
      text: function() {
        return isExpandedAll 
          ? 'Show fewer projects ↑' 
          : 'View full project register (' + cards.length + ') ↓';
      },
      href: '#projects'
    },
    'Operational': {
      text: function() { return 'View all operational projects →'; },
      href: '/our-business/power-stations'
    },
    'Under Construction': {
      text: function() { return 'View all under-construction projects →'; },
      href: '/our-business/construction'
    },
    'Upcoming': {
      text: function() { return 'View all upcoming projects →'; },
      href: '/our-business/under-development'
    }
  };

  var activeTab = 'All';

  // Read URL query param if present (e.g. ?status=operational or ?status=upcoming)
  var urlParams = new URLSearchParams(window.location.search);
  var statusParam = urlParams.get('status');
  if (statusParam) {
    var cleanStatus = statusParam.trim().toLowerCase().replace(/[-_]/g, ' ');
    if (cleanStatus === 'operational') activeTab = 'Operational';
    else if (cleanStatus === 'under construction') activeTab = 'Under Construction';
    else if (cleanStatus === 'upcoming') activeTab = 'Upcoming';
    else if (cleanStatus === 'all') activeTab = 'All';
  }

  function updateTabUI() {
    tabBtns.forEach(function(btn) {
      var isCurrent = btn.dataset.tab === activeTab;
      if (isCurrent) {
        btn.className = 'project-tab px-4 py-2 rounded-lg text-xs transition-all bg-[#0B3B60] text-white font-bold shadow-xs';
        btn.setAttribute('aria-selected', 'true');
      } else {
        btn.className = 'project-tab px-4 py-2 rounded-lg text-xs transition-all text-slate-700 hover:text-[#0B3B60] hover:bg-white/70 font-semibold';
        btn.setAttribute('aria-selected', 'false');
      }
    });

    if (viewAllBtn && categoryNav[activeTab]) {
      viewAllBtn.textContent = categoryNav[activeTab].text();
      viewAllBtn.setAttribute('href', categoryNav[activeTab].href);
    }
  }

  function filterProjects() {
    var q = searchEl ? searchEl.value.trim().toLowerCase() : '';

    // Filter projects belonging strictly to active category
    var categoryCards = cards.filter(function(c) {
      return activeTab === 'All' || c.dataset.status === activeTab;
    });

    // Zero records in category (e.g. Under Construction)
    if (categoryCards.length === 0) {
      if (projectsGrid) projectsGrid.style.display = 'none';
      if (emptyCategoryEl) emptyCategoryEl.style.display = 'block';
      if (emptySearchEl) emptySearchEl.style.display = 'none';
      cards.forEach(function(c) { c.style.display = 'none'; });
      return;
    }

    if (emptyCategoryEl) emptyCategoryEl.style.display = 'none';

    // Match with search query if typed
    var matchedCards = categoryCards.filter(function(c) {
      if (!q) return true;
      var searchContent = c.dataset.search || (c.dataset.name + ' ' + (c.dataset.status || ''));
      return searchContent.toLowerCase().includes(q);
    });

    // Zero matches from search
    if (q && matchedCards.length === 0) {
      if (projectsGrid) projectsGrid.style.display = 'none';
      if (emptySearchEl) emptySearchEl.style.display = 'block';
      cards.forEach(function(c) { c.style.display = 'none'; });
      return;
    }

    if (emptySearchEl) emptySearchEl.style.display = 'none';
    if (projectsGrid) projectsGrid.style.display = '';

    // Show preview count when not searching and not expanded
    var shownCount = 0;
    var shouldLimit = !q && (!isExpandedAll || activeTab !== 'All');

    cards.forEach(function(c) {
      var isMatch = matchedCards.indexOf(c) !== -1;
      if (isMatch) {
        if (shouldLimit && shownCount >= PREVIEW_LIMIT) {
          c.style.display = 'none';
        } else {
          c.style.display = '';
          shownCount++;
        }
      } else {
        c.style.display = 'none';
      }
    });
  }

  if (viewAllBtn) {
    viewAllBtn.onclick = function(e) {
      if (activeTab === 'All') {
        e.preventDefault();
        isExpandedAll = !isExpandedAll;
        updateTabUI();
        filterProjects();
        if (!isExpandedAll) {
          document.getElementById('projects')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      }
    };
  }

  tabBtns.forEach(function(btn) {
    btn.onclick = function() {
      activeTab = btn.dataset.tab;
      isExpandedAll = false;
      updateTabUI();
      filterProjects();
    };
  });

  if (searchEl) {
    searchEl.oninput = filterProjects;
  }

  updateTabUI();
  filterProjects();
})();
</script>

<style is:global>
  /* Hero: responsive height via aspect-ratio, no fixed pixels, no CLS */
  .hero-section {
    aspect-ratio: 16 / 9;
    max-height: 540px;
    width: 100%;
  }
  @media (min-width: 768px) {
    .hero-section {
      aspect-ratio: 21 / 9;
    }
  }
  @media (min-width: 1280px) {
    .hero-section {
      aspect-ratio: 2 / 1;
      min-height: 480px;
    }
  }

  @keyframes marquee-vertical {
    0% {
      transform: translate3d(0, 0, 0);
    }
    100% {
      transform: translate3d(0, -50%, 0);
    }
  }

  .scroll-track {
    display: flex;
    flex-direction: column;
    gap: 12px;
    animation: marquee-vertical var(--marquee-duration, 25s) linear infinite !important;
    will-change: transform;
  }

  .scroll-track:hover {
    animation-play-state: paused !important;
  }


  /* ── HOME TENDERS & NOTIFICATIONS VERTICAL FEED WITH ZEBRA ROWS ── */
  @keyframes feed-vertical {
    0% {
      transform: translate3d(0, 0, 0);
    }
    100% {
      transform: translate3d(0, -50%, 0);
    }
  }

  .feed-scroll-track {
    display: flex;
    flex-direction: column;
    animation: feed-vertical var(--feed-duration, 10s) linear infinite !important;
    will-change: transform;
  }

  .feed-scroll-track:hover {
    animation-play-state: paused !important;
  }

  .feed-row {
    display: block;
    width: 100%;
    padding: 0.75rem 1rem;
    border-bottom: 1px solid #CBD5E1;
    text-align: left;
    text-decoration: none;
    transition: background-color 0.15s ease, color 0.15s ease;
  }

  .feed-row:hover {
    background-color: #EAF4FF !important;
  }

</style>

<script is:inline>
  (function() {
    function syncFeedSpeeds() {
      var speedPxPerSec = 70; // Fast and interactive scroll speed matching previous pace
      var tracks = document.querySelectorAll('.feed-scroll-track');
      tracks.forEach(function(t) {
        var distance = t.scrollHeight / 2;
        if (distance > 0) {
          var duration = (distance / speedPxPerSec).toFixed(2);
          t.style.setProperty('--feed-duration', duration + 's');
          t.style.animationDuration = duration + 's';
        }
        if (document.activeElement && t.contains(document.activeElement)) {
          document.activeElement.blur();
        }
        t.style.animationPlayState = 'running';
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', syncFeedSpeeds);
    } else {
      syncFeedSpeeds();
    }
    setTimeout(syncFeedSpeeds, 100);
    setTimeout(syncFeedSpeeds, 500);

    document.addEventListener('astro:page-load', syncFeedSpeeds);
    window.addEventListener('load', syncFeedSpeeds);
    window.addEventListener('pageshow', syncFeedSpeeds);
    window.addEventListener('resize', syncFeedSpeeds);
    window.addEventListener('focus', syncFeedSpeeds);
    document.addEventListener('visibilitychange', function() {
      if (!document.hidden) {
        syncFeedSpeeds();
      }
    });

    // Keyboard users: pause the feed while any link inside it has focus (GIGW)
    document.addEventListener('focusin', function(e) {
      var track = e.target.closest && e.target.closest('.feed-scroll-track, .scroll-track');
      if (track) { track.style.animationPlayState = 'paused'; }
    });
    document.addEventListener('focusout', function(e) {
      var track = e.target.closest && e.target.closest('.feed-scroll-track, .scroll-track');
      if (track && !(track.contains(document.activeElement))) {
        track.style.animationPlayState = 'running';
      }
    });
  })();
</script>

