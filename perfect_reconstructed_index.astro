let directors: any[] = [];
let tenders: any[] = [];
let projects: any[] = [];
let notifications: any[] = [];
let heroSlidesData: any[] = [];
let gallery = [
  {
    id: 'gallery-seed-1',
    title: 'Signing of Implementation Agreement NHPC & JKSPDC',
    imageUrl: '/gallery/signing_agreement.png',
    partition: 'Official Events',
  },
  {
    id: 'gallery-seed-2',
    title: 'Retirement Ceremony of Executive Director Civil, JKSPDC',
    imageUrl: '/gallery/retirement_ed_civil.png',
    partition: 'Corporate',
  },
  {
    id: 'gallery-seed-5',
    title: 'Corporate HQ and Administrative Building',
    imageUrl: '/slider2.jpg',
    partition: 'Corporate',
  },
];

try {
  // Fetch dignitaries
  const digRes = await fetch(`${BACKEND_URL}/api/dignitaries`);
  if (digRes.ok) {
    dignitaries = await digRes.json();
    dignitaries.sort((a: any, b: any) => a.sNo - b.sNo);
  }

  // Fetch directors
  const dirRes = await fetch(`${BACKEND_URL}/api/directors`);
  if (dirRes.ok) {
    directors = await dirRes.json();
    directors.sort((a: any, b: any) => a.sNo - b.sNo);
  }

  // Fetch tenders
  const tenderRes = await fetch(`${BACKEND_URL}/api/tenders`);
  if (tenderRes.ok) {
    tenders = await tenderRes.json();
  }

  // Fetch projects
  const projRes = await fetch(`${BACKEND_URL}/api/projects`);
  if (projRes.ok) {
    projects = await projRes.json();
    projects.sort((a, b) => (b.capacityMw || 0) - (a.capacityMw || 0));
  }

  // Fetch notifications
  const notifRes = await fetch(`${BACKEND_URL}/api/public/notifications`);
  if (notifRes.ok) {
    notifications = await notifRes.json();
  }

  // Fetch gallery items
  const galleryRes = await fetch(`${BACKEND_URL}/api/gallery`);
  if (galleryRes.ok) {
    gallery = await galleryRes.json();
  }

  // Fetch active hero slides (managed directly from Admin Console)
  const heroRes = await fetch(`${BACKEND_URL}/api/hero-slides/active`);
  if (heroRes.ok) {
    heroSlidesData = await heroRes.json();
  }
} catch (e) {
  console.error('Failed to sync index.astro from backend:', e);
}

// Fetch Homepage Carousels Settings
let heroSettings = { autoplay: true, duration: 6 };
let welcomeSettings = { autoplay: true, duration: 5, items: [] as any[] };
let aboutSettings = { autoplay: true, duration: 5, items: [] as any[] };

try {
  const [heroSetRes, welcomeSetRes, aboutSetRes] = await Promise.all([
    fetch(`${BACKEND_URL}/api/public/site-settings/homepage_hero_settings`).catch(() => null),
    fetch(`${BACKEND_URL}/api/public/site-settings/homepage_welcome_settings`).catch(() => null),
    fetch(`${BACKEND_URL}/api/public/site-settings/homepage_about_settings`).catch(() => null),
  ]);

  if (heroSetRes && heroSetRes.ok) {
    const d = await heroSetRes.json();
    if (d?.value) {
      try { heroSettings = Object.assign(heroSettings, JSON.parse(d.value)); } catch {}
    }
  }

  if (welcomeSetRes && welcomeSetRes.ok) {
    const d = await welcomeSetRes.json();
    if (d?.value) {
      try { welcomeSettings = Object.assign(welcomeSettings, JSON.parse(d.value)); } catch {}
    }
  }

  if (aboutSetRes && aboutSetRes.ok) {
    const d = await aboutSetRes.json();
    if (d?.value) {
      try { aboutSettings = Object.assign(aboutSettings, JSON.parse(d.value)); } catch {}
    }
  }
} catch (err) {
  console.error('Error fetching homepage carousel settings:', err);
}

function getImageUrl(url: string) {
  if (!url) return '';
  if (url.startsWith('/uploads/')) {
    return `${BACKEND_URL}${url}`;
