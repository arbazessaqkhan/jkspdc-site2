# =============================================================================
# JKSPDC Backend — Production Environment Variables Template
# =============================================================================
# INSTRUCTIONS:
#  1. Copy this file to .env for production deployment.
#  2. Replace ALL [CHANGE_ME_*] values with real secrets before deployment.
#  3. NEVER commit .env to version control. Add it to .gitignore.
#  4. Store secrets in a secure secret manager (e.g., Vault, AWS Secrets Manager).
# =============================================================================

# ── Application ───────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000

# ── Database (PostgreSQL only) ────────────────────────────────────────────────
DATABASE_URL="postgresql://[USER]:[PASSWORD]@[HOST]:[PORT]/[DBNAME]?schema=public"

# ── Initial Admin Bootstrap (Required for seed in production) ─────────────────
INITIAL_ADMIN_PASSWORD=[CHANGE_ME_INITIAL_ADMIN_PASSWORD]

# ── JWT Authentication ─────────────────────────────────────────────────────────
# CRITICAL: Generate a strong random secret for production.
# Use: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=[CHANGE_ME_GENERATE_A_STRONG_64_BYTE_HEX_SECRET]
JWT_EXPIRES_IN=24h

# ── Session ────────────────────────────────────────────────────────────────────
SESSION_SECRET=[CHANGE_ME_GENERATE_A_STRONG_SESSION_SECRET]

# ── File Storage ───────────────────────────────────────────────────────────────
# Local filesystem storage is used by default (/app/backend/uploads).
# If using MinIO / S3-compatible object storage:
STORAGE_ENDPOINT=[CHANGE_ME_STORAGE_HOST]
STORAGE_PORT=9000
STORAGE_USE_SSL=true
STORAGE_ACCESS_KEY=[CHANGE_ME_ACCESS_KEY]
STORAGE_SECRET_KEY=[CHANGE_ME_SECRET_KEY]
STORAGE_BUCKET_NAME=jkspdc-uploads

# ── CORS & Routing ─────────────────────────────────────────────────────────────
# Set to the official production frontend domain (e.g., https://jkspdc.jk.gov.in)
# Wildcards are strictly rejected in production.
CORS_ORIGIN="https://[YOUR-DOMAIN]"

# ── Backend URL for Frontend SSR ──────────────────────────────────────────────
BACKEND_URL="http://127.0.0.1:3000"

# ── Email (for Contact Form) ───────────────────────────────────────────────────
SMTP_HOST=[CHANGE_ME_SMTP_HOST]
SMTP_PORT=587
SMTP_USER=[CHANGE_ME_SMTP_USER]
SMTP_PASS=[CHANGE_ME_SMTP_PASS]
SMTP_FROM=noreply@[YOUR-DOMAIN]
CONTACT_EMAIL=md-jkspdcl@jk.gov.in

# ── Rate Limiting ──────────────────────────────────────────────────────────────
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# ── Security Notes ─────────────────────────────────────────────────────────────
# 1. Rotate JWT_SECRET and SESSION_SECRET after every major security event.
# 2. Use TLS/HTTPS at the load balancer/reverse proxy level (Nginx, NIC's CDN).
# 3. Set CORS_ALLOWED_ORIGIN to the exact production domain (no wildcards).
# 4. Keep this file in secure secret management, NOT in version control.
# 5. Ensure the host server is certified by STQC/NIC as per GIGW 3.0 requirements.
# 6. Hosting must comply with MeitY Safe-to-Host guidelines.
