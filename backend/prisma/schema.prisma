datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String   // Hashed password
  name      String
  role      String   @default("VIEWER")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PowerStation {
  id                String    @id @default(uuid())
  name              String    @unique
  type              String    // e.g., Run-of-River, Storage
  capacityMw        Float
  status            String    // e.g., Operational, Under Construction, Under Development
  location          String    // District name
  description       String?
  commissionedDate  DateTime?
  configuration     String?   // e.g., 3x3MW
  designEnergy      Float?    // in MU
  yearOfCommissioning Int?    // Year
  sector            String?   // e.g., State, JV, Private
  basin             String?   // e.g., Chenab, Jhelum River
  salientFeatures   String?   // Rich text description
  documentUrl       String?   // S3 URL or local path
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model Tender {
  id             String    @id @default(uuid())
  referenceNo    String    @unique
  title          String
  description    String?
  documentType   String    @default("NIT") // NIT, NIO, CORRIGENDUM, CONTRACT_AWARD, BANNED_FIRM
  workCategory   String    @default("Civil") // Civil, Electro-Mechanical, Hydro, Solar, Services, IT
  locationTag    String    @default("HQ_SRINAGAR") // HQ_SRINAGAR, HQ_JAMMU, HEP_BAGLIHAR, etc.
  publishDate    DateTime  @default(now())
  closingDate    DateTime?
  bidOpeningDate DateTime?
  documentUrl    String    // S3 URL
  fileSizeBytes  Int
  status         String    @default("Active") // Active, Archived, Cancelled
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  parentTenderId String?
  corrigendums   String?
}

model Career {
  id             String    @id @default(uuid())
  advertisementNo String   @unique
  title          String
  description    String?
  publishDate    DateTime  @default(now())
  closingDate    DateTime
  documentUrl    String    // S3 URL
  fileSizeBytes  Int
  status         String    @default("Active") // Active, Closed
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model PressRelease {
  id          String   @id @default(uuid())
  title       String
  content     String
  publishDate DateTime @default(now())
  imageUrl    String?  // S3 URL for press photo
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String
  action    String   // e.g., "TENDER_CREATE", "USER_LOGIN_FAILED"
  ipAddress String
  userAgent String
  details   String?  // Stored as string in SQLite
  createdAt DateTime @default(now())
}

model ContactSubmission {
  id        String   @id @default(uuid())
  name      String
  email     String
  message   String
  ipAddress String?
  createdAt DateTime @default(now())
}

model Director {
  id        String   @id @default(uuid())
  name      String
  position  String
  role      String
  sNo       Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Notification {
  id          String   @id @default(uuid())
  title       String
  fileName    String
  documentUrl String
  publishDate DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model GalleryItem {
  id        String   @id @default(uuid())
  title     String
  imageUrl  String
  partition String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
