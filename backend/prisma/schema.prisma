datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String   // Hashed password
  name      String
  role      String   @default("VIEWER")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PowerStation {
  id                String    @id @default(uuid())
  name              String    @unique
  type              String    // e.g., Run-of-River, Storage
  capacityMw        Float
  status            String    // e.g., Operational, Under Construction, Under Development
  location          String    // District name
  description       String?
  commissionedDate  DateTime?
  configuration     String?   // e.g., 3x3MW
  designEnergy      Float?    // in MU
  yearOfCommissioning Int?    // Year
  sector            String?   // e.g., State, JV, Private
  basin             String?   // e.g., Chenab, Jhelum River
  salientFeatures   String?   // Rich text description
  documentUrl       String?   // S3 URL or local path
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model Tender {
  id             String    @id @default(uuid())
  referenceNo    String    @unique
  title          String
  description    String?
  documentType   String    @default("NIT") // NIT, NIO, CORRIGENDUM, CONTRACT_AWARD, BANNED_FIRM
  workCategory   String    @default("Civil") // Civil, Electro-Mechanical, Hydro, Solar, Services, IT
  locationTag    String    @default("HQ_SRINAGAR") // HQ_SRINAGAR, HQ_JAMMU, HEP_BAGLIHAR, etc.
  publishDate    DateTime  @default(now())
  closingDate    DateTime?
  bidOpeningDate DateTime?
  documentUrl    String    // S3 URL
  fileSizeBytes  Int
  status         String    @default("Active") // Active, Archived, Cancelled
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  parentTenderId String?
  corrigendums   String?
}

model Career {
  id             String    @id @default(uuid())
  advertisementNo String   @unique
  title          String
  description    String?
  publishDate    DateTime  @default(now())
  closingDate    DateTime
  documentUrl    String    // S3 URL
  fileSizeBytes  Int
  status         String    @default("Active") // Active, Closed
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model PressRelease {
  id          String   @id @default(uuid())
  title       String
  content     String
  publishDate DateTime @default(now())
  imageUrl    String?  // S3 URL for press photo
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String
  action    String   // e.g., "TENDER_CREATE", "USER_LOGIN_FAILED"
  ipAddress String
  userAgent String
  details   String?  // Stored as string in SQLite
  createdAt DateTime @default(now())
}

model ContactSubmission {
  id        String   @id @default(uuid())
  name      String
  email     String
  message   String
  ipAddress String?
  createdAt DateTime @default(now())
}

model Director {
  id          String   @id @default(uuid())
  name        String
  position    String
  role        String
  sNo         Int      @default(0)
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Dignitary {
  id                  String   @id @default(uuid())
  name                String
  position            String
  subTitle            String?
  role                String
  sNo                 Int      @default(0)
  imageUrl            String?
  iasBatch            String?
  education           String?
  officeLocation      String?
  description         String?
  keyResponsibilities String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model Notification {
  id          String   @id @default(uuid())
  title       String
  fileName    String
  documentUrl String
  publishDate DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model GalleryItem {
  id        String   @id @default(uuid())
  title       String
  imageUrl    String
  partition String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PolicyDocument {
  id          String   @id @default(uuid())
  title       String
  description String?
  category    String   // "Policies", "CSR", "Memorandum", "Ethics", "Downloads"
  documentUrl String
  status      String   @default("Active") // "Active", "Archived"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AgmDocument {
  id          String   @id @default(uuid())
  title       String
  meetingDate DateTime
  fileName    String
  documentUrl String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model PageContent {
  id        String   @id @default(uuid())
  pageSlug  String   @unique
  title     String
  content   String
  metaDesc  String?
  imageUrl  String?
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

model Download {
  id            String   @id @default(uuid())
  title         String
  description   String?
  category      String
  fileName      String
  documentUrl   String
  fileSizeBytes Int      @default(0)
  publishDate   DateTime @default(now())
  status        String   @default("Active")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model FinancialDocument {
  id          String   @id @default(uuid())
  title       String
  category    String
  fiscalYear  String?
  documentUrl String
  fileName    String
  publishDate DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Executive {
  id            String   @id @default(uuid())
  name          String
  designation   String
  department    String?
  phone         String?
  email         String?
  officeAddress String?
  sNo           Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model HeroSlide {
  id        String   @id @default(uuid())
  title     String
  subtitle  String?
  imageUrl  String
  ctaText   String?
  ctaHref   String?
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SiteSetting {
  id    String @id @default(uuid())
  key   String @unique
  value String
}

// ── HYDRO AI Knowledge Assistant ──────────────────────────────

model HydroDocument {
  id              String   @id @default(uuid())
  sourceUrl       String?
  sourceType      String   // "page", "pdf", "docx", "manual", "database"
  title           String
  documentType    String?  // "notice", "tender", "policy", "page", etc.
  department      String?
  category        String?
  publicationDate DateTime?
  lastUpdated     DateTime?
  documentNumber  String?
  language        String   @default("en")
  contentHash     String   // SHA-256 of raw content for change detection
  status          String   @default("active") // active, archived, superseded
  authority       String?
  version         Int      @default(1)
  fileSizeBytes   Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  chunks          HydroChunk[]
}

model HydroChunk {
  id            String   @id @default(uuid())
  documentId    String
  document      HydroDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  chunkIndex    Int
  content       String
  heading       String?
  pageNumber    Int?
  sectionRef    String?
  metadata      String?  // JSON string — keywords, entities, etc.
  embeddingId   String?  // Reference key in vector index
  createdAt     DateTime @default(now())
}

model HydroAdminOverride {
  id            String   @id @default(uuid())
  question      String
  answer        String
  category      String?
  priority      Int      @default(0)
  isActive      Boolean  @default(true)
  createdBy     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model HydroConversation {
  id             String   @id @default(uuid())
  sessionId      String
  userMessage    String
  botResponse    String
  confidence     String?
  category       String?
  sourcesUsed    String?  // JSON array
  latencyMs      Int?
  feedbackRating Int?     // 1 = thumbs up, -1 = thumbs down
  feedbackText   String?
  currentPage    String?
  createdAt      DateTime @default(now())
}

model HydroIngestionLog {
  id             String   @id @default(uuid())
  sourceUrl      String?
  sourceType     String
  status         String   // "success", "failed", "skipped"
  chunksCreated  Int      @default(0)
  errorMessage   String?
  durationMs     Int?
  createdAt      DateTime @default(now())
}

model IppProject {
  id         String   @id @default(uuid())
  name       String
  capacityMw Float
  status     String
  location   String
  awardedTo  String
  phase      Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}
