datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                     String            @id @default(uuid())
  email                  String            @unique
  password               String            // Hashed password
  name                   String
  role                   String            @default("VIEWER")
  isActive               Boolean           @default(true)
  mfaEnabled             Boolean           @default(false)
  mfaSecret              String?           // AES-256-GCM encrypted TOTP secret (v1:iv:tag:ct)
  mfaEnrolledAt          DateTime?
  lastUsedTotpStep       BigInt?           // Monotonic step counter to prevent TOTP replay
  mfaEnrollmentCodeHash  String?           // Single-use enrollment authorization code hash
  mfaEnrollmentExpiresAt DateTime?         // Expiration timestamp for enrollment authorization
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt
  sessions               Session[]
  mfaRecoveryCodes       MfaRecoveryCode[]
  mfaChallenges          MfaChallenge[]
}

model Session {
  id           String    @id @default(uuid())
  tokenHash    String    @unique
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime  @default(now())
  expiresAt    DateTime
  lastActiveAt DateTime  @default(now())
  revokedAt    DateTime?

  @@index([userId])
  @@index([tokenHash])
  @@index([expiresAt])
}

model MfaRecoveryCode {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([codeHash])
}

model MfaChallenge {
  id                String   @id @default(uuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ticketHash        String   @unique
  tempSecret        String?  // AES-256-GCM encrypted temporary secret during setup (v1:iv:tag:ct)
  isEnrollmentReady Boolean  @default(false)
  expiresAt         DateTime
  attempts          Int      @default(0)
  createdAt         DateTime @default(now())

  @@index([userId])
  @@index([ticketHash])
  @@index([expiresAt])
}

model PowerStation {
  id                String    @id @default(uuid())
  name              String    @unique
  type              String    // e.g., Run-of-River, Storage
  capacityMw        Float
  status            String    // e.g., Operational, Under Construction, Under Development
  location          String    // District name
  description       String?
  commissionedDate  DateTime?
  configuration     String?   // e.g., 3x3MW
  designEnergy      Float?    // in MU
  yearOfCommissioning Int?    // Year
  sector            String?   // e.g., State, JV, Private
  basin             String?   // e.g., Chenab, Jhelum River
  salientFeatures   String?   // Rich text description
  documentUrl       String?   // S3 URL or local path
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model Tender {
  id             String    @id @default(uuid())
  referenceNo    String    @unique
  title          String
  description    String?
  documentType   String    @default("NIT") // NIT, NIO, CORRIGENDUM, CONTRACT_AWARD, BANNED_FIRM
  workCategory   String    @default("Civil") // Civil, Electro-Mechanical, Hydro, Solar, Services, IT
  locationTag    String    @default("HQ_SRINAGAR") // HQ_SRINAGAR, HQ_JAMMU, HEP_BAGLIHAR, etc.
  publishDate    DateTime  @default(now())
  closingDate    DateTime?
  bidOpeningDate DateTime?
  documentUrl    String    // S3 URL
  fileSizeBytes  Int
  fileFormat     String?   // PDF, DOCX, XLSX, ... captured from the uploaded file
  status         String    @default("Active") // Active, Archived, Cancelled
  showInTicker   Boolean   @default(false)
  priority       String    @default("Normal") // Normal, Urgent
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  parentTenderId String?
  corrigendums   String?
}

model Career {
  id             String    @id @default(uuid())
  advertisementNo String   @unique
  title          String
  description    String?
  publishDate    DateTime  @default(now())
  closingDate    DateTime
  documentUrl    String    // S3 URL
  fileSizeBytes  Int
  status         String    @default("Active") // Active, Closed
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model PressRelease {
  id          String   @id @default(uuid())
  title       String
  content     String
  publishDate DateTime @default(now())
  imageUrl    String?  // S3 URL for press photo
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String
  action    String   // e.g., "TENDER_CREATE", "USER_LOGIN_FAILED"
  ipAddress String
  userAgent String
  details   String?  // Stored as string in SQLite
  createdAt DateTime @default(now())
}

model ContactSubmission {
  id        String   @id @default(uuid())
  name      String
  email     String
  message   String
  ipAddress String?
  createdAt DateTime @default(now())
}

model Director {
  id          String   @id @default(uuid())
  name        String
  position    String
  role        String
  sNo         Int      @default(0)
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Dignitary {
  id                  String   @id @default(uuid())
  name                String
  position            String
  subTitle            String?
  role                String
  sNo                 Int      @default(0)
  imageUrl            String?
  iasBatch            String?
  education           String?
  officeLocation      String?
  description         String?
  keyResponsibilities String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model Notification {
  id            String   @id @default(uuid())
  title         String
  fileName      String
  documentUrl   String
  fileSizeBytes Int?
  fileFormat    String?
  validTillDate DateTime?
  status        String   @default("Active") // "Active", "Archived", "Draft"
  showInTicker  Boolean  @default(false)
  priority      String   @default("Normal") // Normal, Urgent
  publishDate   DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model GalleryItem {
  id           String   @id @default(uuid())
  title        String
  imageUrl     String
  status       String   @default("Active") // "Active", "Archived", "Draft"
  partition    String?  @default("General")
  projectId    String?
  projectName  String?
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model PolicyDocument {
  id          String   @id @default(uuid())
  title       String
  description String?
  category    String   // "Policies", "CSR", "Memorandum", "Ethics", "Downloads"
  documentUrl String
  status      String   @default("Active") // "Active", "Archived"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AgmDocument {
  id          String   @id @default(uuid())
  title       String
  meetingDate DateTime
  fileName    String
  documentUrl String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model PageContent {
  id        String   @id @default(uuid())
  pageSlug  String   @unique
  title     String
  content   String
  metaDesc  String?
  imageUrl  String?
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

model Download {
  id            String   @id @default(uuid())
  title         String
  description   String?
  category      String
  fileName      String
  documentUrl   String
  fileSizeBytes Int      @default(0)
  publishDate   DateTime @default(now())
  status        String   @default("Active")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model FinancialDocument {
  id          String   @id @default(uuid())
  title       String
  category    String
  fiscalYear  String?
  documentUrl String
  fileName    String
  publishDate DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Executive {
  id            String   @id @default(uuid())
  name          String
  designation   String
  department    String?
  phone         String?
  email         String?
  officeAddress String?
  sNo           Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model HeroSlide {
  id          String   @id @default(uuid())
  title       String
  subtitle    String?
  description String?
  imageUrl    String
  ctaText     String?
  ctaHref     String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SiteSetting {
  id    String @id @default(uuid())
  key   String @unique
  value String
}

model IppProject {
  id         String   @id @default(uuid())
  name       String
  capacityMw Float
  status     String
  location   String
  awardedTo  String
  phase      Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model OfficialContact {
  id            String   @id @default(uuid())
  name          String
  position      String
  email         String?
  srinagarPhone String?
  srinagarFax   String?
  jammuPhone    String?
  jammuFax      String?
  viewOrder     Int      @default(0)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model ContactSubOffice {
  id            String   @id @default(uuid())
  name          String
  designation   String
  email         String?
  phone         String?
  wing          String
  address       String?
  viewOrder     Int      @default(0)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model DraftRevision {
  id         String   @id @default(uuid())
  entityType String
  entityId   String
  draftData  String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([entityType, entityId])
  @@index([entityType, entityId])
}
