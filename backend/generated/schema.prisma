datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
  output   = "../generated"
}

enum Role {
  ADMIN
  EDITOR
  VIEWER
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String // Hashed password
  name      String
  role      Role     @default(VIEWER)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PowerStation {
  id               String    @id @default(uuid())
  name             String    @unique
  type             String // e.g., Run-of-River, Storage
  capacityMw       Float
  status           String // e.g., Operational, Under Construction, Under Development
  location         String // District name
  description      String?
  commissionedDate DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model Tender {
  id            String   @id @default(uuid())
  referenceNo   String   @unique
  title         String
  description   String?
  publishDate   DateTime @default(now())
  closingDate   DateTime
  documentUrl   String // S3 URL
  fileSizeBytes Int
  status        String   @default("Active") // Active, Archived, Cancelled
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Career {
  id              String   @id @default(uuid())
  advertisementNo String   @unique
  title           String
  description     String?
  publishDate     DateTime @default(now())
  closingDate     DateTime
  documentUrl     String // S3 URL
  fileSizeBytes   Int
  status          String   @default("Active") // Active, Closed
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model PressRelease {
  id          String   @id @default(uuid())
  title       String
  content     String
  publishDate DateTime @default(now())
  imageUrl    String? // S3 URL for press photo
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String
  action    String // e.g., "TENDER_CREATE", "USER_LOGIN_FAILED"
  ipAddress String
  userAgent String
  details   Json? // Optional JSON payload storing non-sensitive metadata of the action
  createdAt DateTime @default(now())
}

model ContactSubmission {
  id        String   @id @default(uuid())
  name      String
  email     String
  message   String
  ipAddress String?
  createdAt DateTime @default(now())
}
