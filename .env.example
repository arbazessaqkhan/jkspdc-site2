# Environment Configurations for JKSPDC Web Platform

# General
NODE_ENV=development
PORT=3000
BACKEND_URL="http://localhost:3000"

# Database Configuration (PostgreSQL)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/jkspdc?schema=public"

# Admin Bootstrap Credentials
INITIAL_ADMIN_PASSWORD="CHANGE_ME"

# S3 Compatible Object Storage (MinIO local or AWS S3)
S3_ENDPOINT="http://localhost:9000"
S3_ACCESS_KEY="minio_admin_user"
S3_SECRET_KEY="minio_admin_password"
S3_BUCKET_NAME="jkspdc-assets"
S3_FORCE_PATH_STYLE=true

# Security Secrets
JWT_SECRET="replace_this_with_a_secure_long_random_string_in_production"
SESSION_SECRET="replace_this_with_another_secure_long_random_string"

# CORS configurations (Comma separated origins)
CORS_ORIGIN="http://localhost,http://localhost:3000,http://localhost:4321"

# ── HYDRO AI Knowledge Assistant ──────────────────────────────
# Optional: Set your Google Gemini API key to enable full LLM generation & text-embedding-004
# (HYDRO runs in direct-grounded fallback mode when this key is not configured)
GEMINI_API_KEY=""
HYDRO_LLM_MODEL="gemini-2.5-flash"
HYDRO_EMBEDDING_MODEL="text-embedding-004"
HYDRO_CONFIDENCE_HIGH=0.70
HYDRO_CONFIDENCE_MEDIUM=0.40
HYDRO_MAX_CONVERSATION_TURNS=10
