# Environment Configurations for JKSPDC Web Platform

# General
NODE_ENV=development
PORT=3000

# Database Configuration (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres_secure_pass@localhost:5432/jkspdc?schema=public"

# S3 Compatible Object Storage (MinIO local or AWS S3)
S3_ENDPOINT="http://localhost:9000"
S3_ACCESS_KEY="minio_admin_user"
S3_SECRET_KEY="minio_admin_password"
S3_BUCKET_NAME="jkspdc-assets"
S3_FORCE_PATH_STYLE=true

# Security Secrets
JWT_SECRET="replace_this_with_a_secure_long_random_string_in_production"
SESSION_SECRET="replace_this_with_another_secure_long_random_string"

# CORS configurations (Comma separated origins)
CORS_ORIGIN="http://localhost,http://localhost:3000,http://localhost:4321"
