    fetch(`${BACKEND_URL}/api/public/site-settings/homepage_hero_settings`).catch(() => null),
    fetch(`${BACKEND_URL}/api/public/site-settings/homepage_welcome_settings`).catch(() => null),
    fetch(`${BACKEND_URL}/api/public/site-settings/homepage_about_settings`).catch(() => null),
  ]);

  if (heroSetRes && heroSetRes.ok) {
    const d = await heroSetRes.json();
    if (d?.value) {
      try { heroSettings = Object.assign(heroSettings, JSON.parse(d.value)); } catch {}
