    const d = await aboutSetRes.json();
    if (d?.value) {
      try { aboutSettings = Object.assign(aboutSettings, JSON.parse(d.value)); } catch {}
    }
  }
} catch (err) {
  console.error('Error fetching homepage carousel settings:', err);
