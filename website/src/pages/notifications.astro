---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';

let notifications: any[] = [];
let errorMessage = '';

try {
  const res = await fetch('http://localhost:3000/api/public/notifications');
  if (res.ok) {
    notifications = await res.json();
  } else {
    errorMessage = 'Failed to load notifications.';
  }
} catch (e) {
  console.error('Error fetching public notifications:', e);
  errorMessage = 'Failed to connect to the server.';
}

// Extract available years for filter
const yearsSet = new Set(notifications.map(n => new Date(n.publishDate).getFullYear()));
const years = Array.from(yearsSet).sort((a, b) => b - a);

const getDocUrl = (url?: string) => {
  if (!url) return '#';
  if (url.startsWith('/uploads/')) {
    return `http://localhost:3000${url}`;
  }
  return url;
};

const formatDate = (dateStr: string) => {
  return new Date(dateStr).toLocaleDateString('en-IN', {
    day: '2-digit',
    month: 'long',
    year: 'numeric'
  });
};
---

<Layout 
  title="Notifications & Circulars - JKSPDC" 
  description="Official notifications, circulars, office orders, and public notices of JKSPDC."
>
  <div class="space-y-0 max-w-5xl mx-auto">
    <!-- Page Header Band -->
    <div class="page-header-band animate-fadeInUp">
      <nav class="breadcrumb-trail" aria-label="Breadcrumbs">
        <a href="/">Home</a>
        <span class="separator">/</span>
        <span class="current">Notifications</span>
      </nav>
      <h1>Notifications &amp; Circulars</h1>
      <p class="page-subtitle">Jammu &amp; Kashmir State Power Development Corporation Limited (JKSPDCL)</p>
    </div>

    {errorMessage && (
      <div class="bg-red-50 border border-red-200 text-red-800 rounded-lg p-4 text-xs font-semibold">
        {errorMessage}
      </div>
    )}

    <!-- Content Layout -->
    <div class="mt-6">
      
      <!-- Main Content -->
      <article class="w-full space-y-6">
        
        <!-- Dynamic Segregation & Filter Bar -->
        <div class="bg-slate-50 border border-slate-200 rounded-xl p-5 space-y-4">
          <div class="flex items-center justify-between border-b border-slate-200 pb-3">
            <h3 class="text-xs font-extrabold text-slate-800 uppercase tracking-wider flex items-center gap-2">
              <span>📢</span> Segregate &amp; Filter Notifications
            </h3>
            <div class="text-xs font-semibold text-slate-500" id="count-display">
              Showing {notifications.length} item(s)
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
            <!-- Segregate By Project / Topic -->
            <div class="flex flex-col gap-1">
              <label for="project-filter" class="text-[10px] font-bold text-slate-500 uppercase tracking-wider">By Project / Topic</label>
              <select id="project-filter" class="w-full form-select text-xs bg-white border border-slate-200 rounded-lg py-1.5 focus:ring-2 focus:ring-[#0B4F9C]">
                <option value="All">All Projects &amp; Topics</option>
                <option value="kirthai">Kirthai HEP Stage-1</option>
                <option value="baglihar">Baglihar HEP</option>
                <option value="jhelum">Lower Jhelum HEP</option>
                <option value="ushp">Upper Sindh HEP</option>
                <option value="corporate">Corporate &amp; Finance</option>
                <option value="board">Board &amp; Administrative</option>
              </select>
            </div>

            <!-- Segregate By Published Year -->
            <div class="flex flex-col gap-1">
              <label for="year-filter" class="text-[10px] font-bold text-slate-500 uppercase tracking-wider">By Published Year</label>
              <select id="year-filter" class="w-full form-select text-xs bg-white border border-slate-200 rounded-lg py-1.5 focus:ring-2 focus:ring-[#0B4F9C]">
                <option value="All">All Years</option>
                {years.map((y: any) => (
                  <option value={String(y)}>{y}</option>
                ))}
              </select>
            </div>

            <!-- Sort By Date -->
            <div class="flex flex-col gap-1">
              <label for="sort-order" class="text-[10px] font-bold text-slate-500 uppercase tracking-wider">Sort Date</label>
              <select id="sort-order" class="w-full form-select text-xs bg-white border border-slate-200 rounded-lg py-1.5 focus:ring-2 focus:ring-[#0B4F9C]">
                <option value="newest">Newest First</option>
                <option value="oldest">Oldest First</option>
              </select>
            </div>

            <!-- Segregate By Notification ID / Title / Keyword -->
            <div class="flex flex-col gap-1">
              <label for="notif-search-input" class="text-[10px] font-bold text-slate-500 uppercase tracking-wider">By ID / Title / Keyword</label>
              <input 
                id="notif-search-input" 
                type="text" 
                placeholder="Notification ID, Title, File..." 
                class="w-full text-xs bg-white border border-slate-200 rounded-lg py-1.5 px-3 focus:outline-none focus:ring-2 focus:ring-[#0B4F9C]" 
              />
            </div>
          </div>
        </div>

        <!-- Notifications List -->
        <div class="space-y-3" id="notifications-list">
          {notifications.length === 0 ? (
            <div class="bg-slate-50 border border-slate-200 text-slate-500 rounded-xl p-6 text-center text-xs font-semibold italic">
              No official notifications or circulars published yet.
            </div>
          ) : (
            notifications.map((notif: any) => (
              <div 
                id={`notif-${notif.id}`}
                class="notif-card p-5 bg-white border border-slate-200 rounded-xl shadow-sm hover:shadow-md transition-all duration-200 flex flex-col sm:flex-row sm:items-center justify-between gap-4 scroll-mt-24"
                data-year={new Date(notif.publishDate).getFullYear()}
                data-timestamp={new Date(notif.publishDate).getTime()}
                data-search-keys={`${(notif.id || '').toLowerCase()} ${(notif.title || '').toLowerCase()} ${(notif.fileName || '').toLowerCase()}`}
              >
                <div class="space-y-1.5 flex-1 min-w-0 text-left">
                  <h4 class="font-extrabold text-slate-800 text-sm leading-snug">{notif.title}</h4>
                  <div class="flex items-center gap-3 text-[11px] text-slate-450 font-semibold">
                    <span class="bg-slate-100 px-2 py-0.5 rounded text-slate-600 font-bold uppercase tracking-wider font-mono">
                      {notif.fileName.split('.').pop() || 'PDF'}
                    </span>
                    <span>Uploaded: {formatDate(notif.publishDate)}</span>
                  </div>
                </div>
                
                <div class="shrink-0 flex items-center justify-end sm:justify-center">
                  <a 
                    href={getDocUrl(notif.documentUrl)} 
                    target="_blank" 
                    rel="noopener noreferrer"
                    class="w-full sm:w-auto inline-flex items-center justify-center gap-1.5 px-4 py-2 border border-[#0B4F9C] hover:bg-[#0B4F9C] hover:text-white text-[#0B4F9C] rounded text-xs font-bold transition-all"
                  >
                    <Icon name="file-text" size={12} />
                    <span>View PDF</span>
                  </a>
                </div>
              </div>
            ))
          )}

          <!-- Empty State Container when 0 results match filters -->
          <div id="notif-empty-state" class="hidden text-center py-12 bg-slate-50 border border-slate-200 border-dashed rounded-xl text-slate-500 font-semibold italic text-xs">
            No notifications or circulars found matching your search or filter criteria.
          </div>
        </div>
      </article>

    </div>
  </div>
</Layout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const projectFilter = document.getElementById('project-filter') as HTMLSelectElement;
    const yearFilter = document.getElementById('year-filter') as HTMLSelectElement;
    const sortOrder = document.getElementById('sort-order') as HTMLSelectElement;
    const searchInput = document.getElementById('notif-search-input') as HTMLInputElement;
    const countDisplay = document.getElementById('count-display');
    const container = document.getElementById('notifications-list');

    function filterAnnouncements() {
      const selectedProj = projectFilter ? projectFilter.value.toLowerCase() : 'all';
      const selectedYr = yearFilter ? yearFilter.value : 'All';
      const query = searchInput ? searchInput.value.toLowerCase().trim() : '';
      const order = sortOrder ? sortOrder.value : 'newest';

      const cards = Array.from(document.querySelectorAll('.notif-card'));
      let visibleCount = 0;

      cards.forEach((card: any) => {
        const year = card.getAttribute('data-year');
        const searchKeys = card.getAttribute('data-search-keys') || '';

        const matchesProj = selectedProj === 'all' || searchKeys.includes(selectedProj);
        const matchesYear = selectedYr === 'All' || year === selectedYr;
        const matchesSearch = query === '' || searchKeys.includes(query);

        if (matchesProj && matchesYear && matchesSearch) {
          card.classList.remove('hidden');
          visibleCount++;
        } else {
          card.classList.add('hidden');
        }
      });

      // Sort cards DOM order based on date timestamp
      cards.sort((a: any, b: any) => {
        const timeA = parseInt(a.getAttribute('data-timestamp') || '0', 10);
        const timeB = parseInt(b.getAttribute('data-timestamp') || '0', 10);
        return order === 'newest' ? timeB - timeA : timeA - timeB;
      });

      cards.forEach((card: any) => {
        if (container) container.appendChild(card);
      });

      const emptyState = document.getElementById('notif-empty-state');
      if (emptyState) {
        if (visibleCount === 0) {
          emptyState.classList.remove('hidden');
        } else {
          emptyState.classList.add('hidden');
        }
      }

      if (countDisplay) {
        countDisplay.textContent = `Showing ${visibleCount} item(s)`;
      }
    }

    projectFilter?.addEventListener('change', filterAnnouncements);
    yearFilter?.addEventListener('change', filterAnnouncements);
    sortOrder?.addEventListener('change', filterAnnouncements);
    searchInput?.addEventListener('input', filterAnnouncements);
    filterAnnouncements();
  });
</script>

<style>
  .form-select {
    border: 1px solid #e2e8f0;
    border-radius: 0.375rem;
    padding: 0.375rem 2rem 0.375rem 0.75rem;
    font-size: 0.75rem;
    cursor: pointer;
  }
  .form-select:focus {
    border-color: #0B4F9C;
    outline: none;
  }
</style>
