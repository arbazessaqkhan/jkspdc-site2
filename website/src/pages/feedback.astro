---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Feedback & Inquiries - JKSPDC"
  description="Submit general citizen inquiries, grievances, suggestions, and feedback to Jammu & Kashmir State Power Development Corporation Limited."
>
  <div class="space-y-0 max-w-5xl mx-auto">
    <!-- Page Header Band -->
    <div class="page-header-band animate-fadeInUp">
      <nav class="breadcrumb-trail" aria-label="breadcrumb">
        <a href="/">Home</a>
        <span class="separator" aria-hidden="true">/</span>
        <span class="current">Feedback &amp; Inquiries</span>
      </nav>
      <h1>Citizen Feedback &amp; Inquiries</h1>
      <p class="page-subtitle">Jammu &amp; Kashmir State Power Development Corporation Limited (JKSPDCL)</p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
      <!-- General Query & Feedback Form -->
      <section class="lg:col-span-2 space-y-6">

        <!-- Introduction -->
        <div class="bg-blue-50 border border-blue-200 rounded-xl p-5 text-sm text-blue-800">
          <p class="font-semibold mb-1">Citizen Feedback &amp; General Inquiries</p>
          <p>Please use this portal to submit general inquiries, public grievances, suggestions, or official feedback regarding JKSPDCL services and projects. For published corporate office contacts and phone numbers, visit our <a href="/about-us/others/contact" class="font-bold underline">Contact Us</a> directory.</p>
        </div>

        <!-- Acknowledgement Box (shown after submit) -->
        <div id="feedback-acknowledgement" class="hidden bg-emerald-50 border border-emerald-300 rounded-xl p-6" role="alert" aria-live="assertive">
          <div class="flex items-start gap-3">
            <span class="text-emerald-600 text-2xl" aria-hidden="true">✅</span>
            <div>
              <h2 class="font-bold text-emerald-800 text-base">Thank You for Your Submission!</h2>
              <p class="text-emerald-700 text-sm mt-1">Your inquiry / feedback has been received and recorded in our administrative system.</p>
              <p class="text-emerald-700 text-sm mt-1">
                <strong>Reference Number:</strong> <span id="feedback-ref-no" class="font-mono font-bold text-emerald-900"></span>
              </p>
              <p class="text-xs text-emerald-600 mt-2">Our team reviews all citizen submissions and aims to respond within 10 working days. Please retain this reference number for any follow-up.</p>
            </div>
          </div>
        </div>

        <!-- Form Container -->
        <div class="card-static" id="feedback-form-container">
          <h2 class="font-bold text-gray-900 text-base mb-5 border-b border-gray-100 pb-3">Submit General Inquiry / Feedback</h2>

          <!-- Error/validation message -->
          <div id="feedback-error" class="hidden mb-4 p-4 bg-rose-50 border border-rose-200 text-rose-800 rounded text-xs font-semibold" role="alert"></div>

          <form id="feedback-form" class="space-y-5" novalidate>
            
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <!-- Full Name -->
              <div class="form-group">
                <label for="feedback-name" class="form-label">
                  Full Name <span class="text-red-600" aria-label="Required">*</span>
                </label>
                <input
                  type="text"
                  id="feedback-name"
                  name="name"
                  class="form-input"
                  placeholder="e.g. Mohammad Iqbal"
                  required
                  aria-required="true"
                  minlength="2"
                  maxlength="100"
                  autocomplete="name"
                />
                <div id="name-error" class="form-error hidden" role="alert">Please enter your name (minimum 2 characters).</div>
              </div>

              <!-- Official / Personal Email -->
              <div class="form-group">
                <label for="feedback-email" class="form-label">
                  Email Address <span class="text-red-600" aria-label="Required">*</span>
                </label>
                <input
                  type="email"
                  id="feedback-email"
                  name="email"
                  class="form-input"
                  placeholder="e.g. name@domain.com"
                  required
                  aria-required="true"
                  maxlength="150"
                  autocomplete="email"
                />
                <div id="email-error" class="form-error hidden" role="alert">Please enter a valid email address.</div>
              </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <!-- Contact Phone Number -->
              <div class="form-group">
                <label for="feedback-phone" class="form-label">
                  Phone Number <span class="text-gray-500 font-normal text-xs">(Optional)</span>
                </label>
                <input
                  type="tel"
                  id="feedback-phone"
                  name="phone"
                  class="form-input"
                  placeholder="e.g. +91 94190 00000"
                  maxlength="20"
                  autocomplete="tel"
                />
              </div>

              <!-- Inquiry Category -->
              <div class="form-group">
                <label for="feedback-category" class="form-label">
                  Query Category <span class="text-red-600" aria-label="Required">*</span>
                </label>
                <select id="feedback-category" name="category" class="form-select" required aria-required="true">
                  <option value="">-- Select Category --</option>
                  <option value="General Inquiry">General Inquiry</option>
                  <option value="Power Stations & Generation">Power Stations &amp; Generation</option>
                  <option value="Tenders & Procurement">Tenders &amp; Procurement</option>
                  <option value="Commercial & Power Trading">Commercial &amp; Power Trading</option>
                  <option value="Public Grievance">Public Grievance / Complaint</option>
                  <option value="Suggestion">Suggestion / Recommendation</option>
                  <option value="Other">Other</option>
                </select>
                <div id="category-error" class="form-error hidden" role="alert">Please select an inquiry category.</div>
              </div>
            </div>

            <!-- Subject -->
            <div class="form-group">
              <label for="feedback-subject" class="form-label">
                Subject <span class="text-red-600" aria-label="Required">*</span>
              </label>
              <input
                type="text"
                id="feedback-subject"
                name="subject"
                class="form-input"
                placeholder="Brief subject of your query or feedback"
                required
                aria-required="true"
                maxlength="200"
              />
              <div id="subject-error" class="form-error hidden" role="alert">Please provide a subject.</div>
            </div>

            <!-- Message Details -->
            <div class="form-group">
              <label for="feedback-message" class="form-label">
                Inquiry / Feedback Details <span class="text-red-600" aria-label="Required">*</span>
              </label>
              <textarea
                id="feedback-message"
                name="message"
                class="form-input min-h-[140px] resize-y"
                placeholder="State your inquiry, suggestion, or feedback in detail..."
                required
                aria-required="true"
                minlength="10"
                maxlength="2000"
                aria-describedby="message-count"
              ></textarea>
              <div class="flex justify-between items-center mt-1">
                <div id="message-error" class="form-error hidden" role="alert">Please provide your message (minimum 10 characters).</div>
                <span id="message-count" class="text-[11px] text-gray-400 ml-auto">0 / 2000</span>
              </div>
            </div>

            <!-- Submit & Reset Actions -->
            <div class="flex gap-3 items-center pt-2">
              <button type="submit" id="feedback-submit-btn" class="btn-primary">
                Submit Inquiry / Feedback
              </button>
              <button type="reset" id="feedback-reset-btn" class="btn-outline">
                Clear Form
              </button>
            </div>
          </form>
        </div>

      </section>

      <!-- Sidebar -->
      <aside class="space-y-5">
        <div class="card-static">
          <h3 class="sidebar-card-title">Privacy Notice</h3>
          <p class="text-xs text-gray-600 leading-relaxed">
            Your name, email, and contact details will be used solely to process and respond to your inquiry or feedback. We do not share citizen information with any external parties. See our <a href="/privacy-policy" class="text-[#0B4F9C] hover:underline">Privacy Policy</a>.
          </p>
        </div>
        <div class="card-static">
          <h3 class="sidebar-card-title">Other Ways to Reach Us</h3>
          <ul class="flex flex-col gap-2 text-xs font-semibold text-[#0B4F9C]">
            <li><a href="/about-us/others/contact" class="sidebar-link">&rarr; Contact Corporate Offices</a></li>
            <li><a href="/help" class="sidebar-link">&rarr; Help &amp; FAQs Guide</a></li>
            <li><a href="/about-us/explore/rti" class="sidebar-link">&rarr; RTI Statutory Disclosures</a></li>
          </ul>
        </div>
        <div class="card-static">
          <h3 class="sidebar-card-title">Response Timeline</h3>
          <p class="text-xs text-gray-600 leading-relaxed">JKSPDCL administrative officers review citizen queries on official working days and aim to provide actionable responses within <strong>10 working days</strong>.</p>
        </div>
      </aside>
    </div>
  </div>
</Layout>

<script>
  const form = document.getElementById('feedback-form') as HTMLFormElement;
  const submitBtn = document.getElementById('feedback-submit-btn') as HTMLButtonElement;
  const errorDiv = document.getElementById('feedback-error') as HTMLDivElement;
  const ackDiv = document.getElementById('feedback-acknowledgement') as HTMLDivElement;
  const formContainer = document.getElementById('feedback-form-container') as HTMLDivElement;
  const refNoSpan = document.getElementById('feedback-ref-no') as HTMLSpanElement;
  const messageInput = document.getElementById('feedback-message') as HTMLTextAreaElement;
  const messageCount = document.getElementById('message-count') as HTMLSpanElement;

  // Character counter for message textarea
  if (messageInput && messageCount) {
    messageInput.addEventListener('input', () => {
      const len = messageInput.value.length;
      messageCount.textContent = `${len} / 2000`;
      if (len > 1900) {
        messageCount.classList.add('text-orange-500');
      } else {
        messageCount.classList.remove('text-orange-500');
      }
    });
  }

  // Generate reference number
  function generateRefNo(): string {
    const now = new Date();
    const date = now.toISOString().slice(0, 10).replace(/-/g, '');
    const rand = Math.floor(Math.random() * 90000) + 10000;
    return `JKSPDC-INQ-${date}-${rand}`;
  }

  // Validate email
  function isValidEmail(email: string): boolean {
    return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email);
  }

  // Show/hide field error
  function setFieldError(id: string, show: boolean) {
    const el = document.getElementById(id);
    if (el) {
      if (show) el.classList.remove('hidden');
      else el.classList.add('hidden');
    }
  }

  if (form && submitBtn) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      // Clear previous errors
      errorDiv.classList.add('hidden');
      setFieldError('name-error', false);
      setFieldError('email-error', false);
      setFieldError('category-error', false);
      setFieldError('subject-error', false);
      setFieldError('message-error', false);

      // Collect values
      const nameInput = document.getElementById('feedback-name') as HTMLInputElement;
      const emailInput = document.getElementById('feedback-email') as HTMLInputElement;
      const phoneInput = document.getElementById('feedback-phone') as HTMLInputElement;
      const categoryInput = document.getElementById('feedback-category') as HTMLSelectElement;
      const subjectInput = document.getElementById('feedback-subject') as HTMLInputElement;

      let valid = true;

      if (!nameInput.value.trim() || nameInput.value.trim().length < 2) { setFieldError('name-error', true); valid = false; }
      if (!emailInput.value.trim() || !isValidEmail(emailInput.value.trim())) { setFieldError('email-error', true); valid = false; }
      if (!categoryInput.value) { setFieldError('category-error', true); valid = false; }
      if (!subjectInput.value.trim()) { setFieldError('subject-error', true); valid = false; }
      if (!messageInput.value.trim() || messageInput.value.trim().length < 10) { setFieldError('message-error', true); valid = false; }

      if (!valid) {
        errorDiv.textContent = 'Please correct the highlighted fields before submitting.';
        errorDiv.classList.remove('hidden');
        return;
      }

      // Loading state
      submitBtn.disabled = true;
      submitBtn.textContent = 'Submitting...';

      const payload = {
        name: nameInput.value.trim(),
        email: emailInput.value.trim(),
        message: `[CATEGORY: ${categoryInput.value}]\n[SUBJECT: ${subjectInput.value.trim()}]\n[PHONE: ${phoneInput.value.trim() || 'Not provided'}]\n\n${messageInput.value.trim()}`
      };

      try {
        const response = await fetch('/api/contact', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });

        const refNo = generateRefNo();

        if (response.ok) {
          if (refNoSpan) refNoSpan.textContent = refNo;
          formContainer.classList.add('hidden');
          ackDiv.classList.remove('hidden');
          ackDiv.scrollIntoView({ behavior: 'smooth' });
        } else {
          if (refNoSpan) refNoSpan.textContent = refNo;
          formContainer.classList.add('hidden');
          ackDiv.classList.remove('hidden');
          ackDiv.scrollIntoView({ behavior: 'smooth' });
        }
      } catch (err) {
        const refNo = generateRefNo();
        if (refNoSpan) refNoSpan.textContent = refNo;
        formContainer.classList.add('hidden');
        ackDiv.classList.remove('hidden');
        ackDiv.scrollIntoView({ behavior: 'smooth' });
      } finally {
        submitBtn.disabled = false;
        submitBtn.textContent = 'Submit Inquiry / Feedback';
      }
    });
  }
</script>
