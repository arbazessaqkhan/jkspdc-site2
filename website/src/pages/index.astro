---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';

const heroSlides = [
  { id: 0, badge: "Powering Jammu & Kashmir since 1995", title: "Baglihar Hydroelectric Project", desc: "A 900 MW run-of-the-river hydroelectric plant on the Chenab River — one of India's most strategic power assets.", stat: "900", statUnit: "MW", statLabel: "Installed Capacity", statPct: 80, img: "/slider1.jpg", ctaText: "Explore Project", ctaHref: "/our-business/power-stations" },
  { id: 1, badge: "Green Energy Initiative", title: "Uri Hydroelectric Power Station", desc: "The largest hydro project in J&K with 480 MW capacity, contributing massively to the northern grid.", stat: "480", statUnit: "MW", statLabel: "Installed Capacity", statPct: 55, img: "/slider2.jpg", ctaText: "View Details", ctaHref: "/our-business/power-stations" },
  { id: 2, badge: "Under Construction", title: "Pakal Dul Hydroelectric Project", desc: "A 1,000 MW project on Marusudar River nearing completion — set to be the largest.", stat: "1000", statUnit: "MW", statLabel: "Planned Capacity", statPct: 70, img: "/slider3.jpg", ctaText: "Learn More", ctaHref: "/our-business/under-construction" },
  { id: 3, badge: "Renewable Energy", title: "Solar Power Development", desc: "JKSPDC is expanding into solar with multiple projects across Ladakh and Jammu.", stat: "300", statUnit: "MW", statLabel: "Solar Target", statPct: 40, img: "/slider1.jpg", ctaText: "Solar Projects", ctaHref: "/sustainability/environment/preamble" },
];



const quickLinks = [
  { icon: "building", label: "About JKSPDC", desc: "Corporate profile & leadership", href: "/about-us/explore/overview", bg: "bg-[#EAF4FF]", text: "text-[#0B4F9C]" },
  { icon: "factory", label: "Projects", desc: "Explore power stations", href: "/our-business/power-stations", bg: "bg-[#EAF4FF]", text: "text-[#0B4F9C]" },
  { icon: "file-text", label: "Tender Portal", desc: "Live tenders & bids", href: "/stakeholders/vendors/tender-bids", bg: "bg-[#EAF4FF]", text: "text-[#0B4F9C]" },
  { icon: "briefcase", label: "Careers", desc: "Open positions", href: "/stakeholders/career-seekers/current-openings", bg: "bg-[#EAF4FF]", text: "text-[#0B4F9C]" },
  { icon: "scroll-text", label: "RTI", desc: "Right to Information", href: "/about-us/explore/overview", bg: "bg-[#EAF4FF]", text: "text-[#0B4F9C]" },
  { icon: "landmark", label: "Investors", desc: "Financial reports", href: "/commercial/overview", bg: "bg-[#EAF4FF]", text: "text-[#0B4F9C]" },
  { icon: "leaf", label: "CSR", desc: "Community initiatives", href: "/sustainability/environment/preamble", bg: "bg-[#EAF4FF]", text: "text-[#0B4F9C]" },
  { icon: "newspaper", label: "Media Centre", desc: "Press & announcements", href: "/media/press-releases", bg: "bg-[#EAF4FF]", text: "text-[#0B4F9C]" },
  { icon: "download", label: "Downloads", desc: "Documents & forms", href: "/stakeholders/vendors/tender-bids", bg: "bg-[#EAF4FF]", text: "text-[#0B4F9C]" },
  { icon: "eye", label: "Vigilance", desc: "Integrity & compliance", href: "/about-us/explore/ethics-code", bg: "bg-[#EAF4FF]", text: "text-[#0B4F9C]" },
];

const projects = [
  { name: "Baglihar Stage I & II", river: "Chenab", capacity: 900, district: "Ramban", status: "Operational", type: "Hydro", year: 2008 },
  { name: "Uri Stage I", river: "Jhelum", capacity: 480, district: "Baramulla", status: "Operational", type: "Hydro", year: 1997 },
  { name: "Uri Stage II", river: "Jhelum", capacity: 240, district: "Baramulla", status: "Operational", type: "Hydro", year: 2014 },
  { name: "Salal Stage I & II", river: "Chenab", capacity: 345, district: "Reasi", status: "Operational", type: "Hydro", year: 1987 },
  { name: "Dulhasti", river: "Chenab", capacity: 390, district: "Kishtwar", status: "Operational", type: "Hydro", year: 2007 },
  { name: "Lower Jhelum", river: "Jhelum", capacity: 105, district: "Baramulla", status: "Operational", type: "Hydro", year: 2015 },
  { name: "Chutak", river: "Suru", capacity: 44, district: "Kargil", status: "Operational", type: "Hydro", year: 2012 },
  { name: "Nimmo Bazgo", river: "Indus", capacity: 45, district: "Leh", status: "Operational", type: "Hydro", year: 2013 },
  { name: "Pakal Dul", river: "Marusudar", capacity: 1000, district: "Kishtwar", status: "Under Construction", type: "Hydro", year: 2026 },
  { name: "Kiru", river: "Chenab", capacity: 624, district: "Kishtwar", status: "Under Construction", type: "Hydro", year: 2025 },
  { name: "Kwar", river: "Chenab", capacity: 540, district: "Kishtwar", status: "Under Construction", type: "Hydro", year: 2026 },
  { name: "Ratle", river: "Chenab", capacity: 850, district: "Kishtwar", status: "Under Construction", type: "Hydro", year: 2026 },
  { name: "Sawalkot", river: "Chenab", capacity: 1856, district: "Ramban", status: "Upcoming", type: "Hydro", year: 2030 },
  { name: "Bursar", river: "Marusudar", capacity: 800, district: "Kishtwar", status: "Upcoming", type: "Hydro", year: 2031 },
  { name: "Kirthai II", river: "Chenab", capacity: 930, district: "Kishtwar", status: "Upcoming", type: "Hydro", year: 2029 },
  { name: "Ladakh Solar Park I", river: "—", capacity: 100, district: "Leh", status: "Under Construction", type: "Solar", year: 2025 },
  { name: "Jammu Solar Cluster", river: "—", capacity: 200, district: "Jammu", status: "Upcoming", type: "Solar", year: 2026 },
];

const tenders = [
  { nit: "NIT-521/2025", title: "Civil Works — Baglihar Stage II Refurbishment", dept: "Civil", value: "Rs. 42.5 Cr", closing: "28 Jun 2025", status: "Open" },
  { nit: "NIT-518/2025", title: "Supply of Transformers for Ratle HEP", dept: "Electrical", value: "Rs. 87.3 Cr", closing: "15 Jul 2025", status: "Open" },
  { nit: "NIT-515/2025", title: "Security Services for Srinagar HQ (3 Years)", dept: "Admin", value: "Rs. 6.1 Cr", closing: "05 Jul 2025", status: "Open" },
  { nit: "NIT-509/2025", title: "Pakal Dul HEP — E&M Equipment Supply", dept: "Electrical", value: "Rs. 230 Cr", closing: "20 Aug 2025", status: "Open" },
  { nit: "NIT-506/2025", title: "IT Infrastructure Upgrade — Datacenter", dept: "IT", value: "Rs. 12.8 Cr", closing: "01 Jul 2025", status: "Closing Soon" },
  { nit: "NIT-501/2025", title: "EPC for Jammu Solar Cluster — Phase I", dept: "Renewable", value: "Rs. 165 Cr", closing: "30 Sep 2025", status: "Open" },
];

const careers = [
  { title: "Junior Engineer (Civil)", posts: 120, qual: "B.E/B.Tech Civil", lastDate: "30 Jun 2025", pay: "Rs.35,400-1,12,400" },
  { title: "Junior Engineer (Electrical)", posts: 90, qual: "B.E/B.Tech Electrical", lastDate: "30 Jun 2025", pay: "Rs.35,400-1,12,400" },
  { title: "Accounts Assistant", posts: 40, qual: "B.Com with Tally", lastDate: "15 Jul 2025", pay: "Rs.29,200-92,300" },
  { title: "Data Entry Operator", posts: 35, qual: "12th + Diploma in IT", lastDate: "20 Jul 2025", pay: "Rs.19,900-63,200" },
  { title: "Assistant Engineer (E&M)", posts: 25, qual: "B.E/B.Tech + 2yr Exp", lastDate: "31 Jul 2025", pay: "Rs.56,100-1,77,500" },
];

const corpStats = [
  { label: "Authorised Capital", value: "Rs.5,000 Cr" },
  { label: "Paid-Up Capital", value: "Rs.2,593 Cr" },
  { label: "Revenue 2023-24", value: "Rs.1,136 Cr" },
  { label: "JV Investment", value: "Rs.2,357 Cr" },
];
---

<Layout title="Home | JKSPDC Official Portal" description="Official enterprise portal of Jammu and Kashmir State Power Development Corporation Ltd. Powering the future of J&K through clean, sustainable, and reliable energy generation." isHome={true}>

  <!-- HERO SLIDER -->
  <section id="home" class="relative w-full overflow-hidden bg-[#084A8F]" style="height: calc(100vh - 240px); min-height: 580px;">
    <div id="hero-slides" class="absolute inset-0">
      {heroSlides.map((slide, i) => (
        <div id={`slide-${slide.id}`} class={`absolute inset-0 transition-opacity duration-700 ${i === 0 ? 'opacity-100 z-10' : 'opacity-0 z-0'}`}>
          <img src={slide.img} alt={slide.title} class="w-full h-full object-cover" />
          <div class="absolute inset-0 bg-gradient-to-r from-[#084A8F]/90 via-[#084A8F]/60 to-[#084A8F]/20"></div>
          <div class="absolute inset-0 bg-gradient-to-t from-black/50 via-transparent to-transparent"></div>
          
          <!-- Slide Text Content Centered -->
          <div class="absolute inset-0 z-20 max-w-7xl mx-auto h-full px-4 flex items-center">
            <div class="max-w-2xl text-white">
              <div class="inline-flex items-center bg-[#D8681B] text-white text-xs font-bold uppercase tracking-wider px-3 py-1 rounded-full mb-5">{slide.badge}</div>
              <h2 class="text-4xl sm:text-5xl md:text-6xl font-bold leading-tight tracking-tight text-balance">{slide.title}</h2>
              <p class="mt-5 text-base sm:text-lg text-white/85 max-w-xl leading-relaxed text-pretty">{slide.desc}</p>
              <div class="mt-8 flex flex-wrap items-center gap-3">
                <a href={slide.ctaHref} class="inline-flex items-center gap-2 bg-[#D8681B] hover:bg-[#C65D18] text-white font-semibold px-6 h-12 rounded-md transition-colors text-sm shadow-lg">{slide.ctaText} &rarr;</a>
                <button class="inline-flex items-center gap-2 border border-white/40 bg-white/5 backdrop-blur-sm text-white hover:bg-white/15 px-6 h-12 rounded-md transition-colors text-sm font-medium">&#9654; Corporate Video</button>
              </div>
            </div>
            
            <!-- Stat Box (Desktop) -->
            <div class="hidden lg:block absolute right-8 bottom-24 z-20">
              <div class="bg-black/40 backdrop-blur-md border border-white/15 rounded-2xl p-6 pr-10 min-w-[220px]">
                <div class="text-white/60 text-xs uppercase tracking-widest font-medium">{slide.statLabel}</div>
                <div class="flex items-end gap-1 mt-2">
                  <span class="text-white text-6xl font-bold leading-none font-variant-numeric: tabular-nums">{slide.stat}</span>
                  <span class="text-[#D8681B] text-xl font-semibold pb-1">{slide.statUnit}</span>
                </div>
                <div class="mt-4 h-1.5 bg-white/15 rounded-full overflow-hidden">
                  <div class="h-full bg-[#D8681B] rounded-full transition-all duration-700" style={`width:${slide.statPct}%`}></div>
                </div>
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>
    <div class="absolute bottom-8 left-1/2 -translate-x-1/2 flex items-center gap-2 z-20">
      {heroSlides.map((_, i) => (
        <button data-dot={String(i)} class={`h-1.5 rounded-full transition-all duration-300 ${i === 0 ? 'w-10 bg-[#D8681B]' : 'w-4 bg-white/40'}`} aria-label={`Slide ${i + 1}`}></button>
      ))}
    </div>
    <button id="hero-prev" class="absolute left-4 top-1/2 -translate-y-1/2 z-20 w-11 h-11 rounded-full bg-black/40 text-white flex items-center justify-center hover:bg-white/20 transition border border-white/20 text-2xl" aria-label="Previous">&#8249;</button>
    <button id="hero-next" class="absolute right-4 top-1/2 -translate-y-1/2 z-20 w-11 h-11 rounded-full bg-black/40 text-white flex items-center justify-center hover:bg-white/20 transition border border-white/20 text-2xl" aria-label="Next">&#8250;</button>
  </section>

  <!-- MAIN CONTAINER WITH MAX-WIDTH AND SIDE MARGINS FOR PROPER CONTENT SPACINGS -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 space-y-12 relative z-20">

    <!-- KEY DIGNITARIES SECTION -->
    <section class="relative z-30">
      <div class="bg-gradient-to-br from-[#083B73] to-[#0A2E5C] rounded-2xl border border-[#0B4F9C]/50 p-8 md:p-10 shadow-xl text-white">
        <div class="text-center mb-8">
          <span class="text-[10px] uppercase tracking-widest text-[#BDD7EE] font-extrabold bg-white/10 px-3 py-1 rounded-full border border-white/10">Leadership & Governance</span>
          <h2 class="text-2xl md:text-3xl font-extrabold text-white mt-3 text-balance">Key Dignitaries</h2>
          <div class="w-16 h-0.5 bg-[#D8681B] mx-auto mt-3 rounded-full"></div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 w-full">
          <!-- Dignitary 1: LG -->
          <div class="group bg-white rounded-xl border border-white/10 shadow-md p-5 flex flex-col justify-between hover:shadow-2xl hover:scale-[1.02] transition-[transform,box-shadow] duration-300 w-full text-slate-800 text-center">
            <div>
              <div class="w-24 h-24 rounded-full overflow-hidden bg-slate-100 mx-auto border-2 border-[#0B4F9C]/20 shadow-inner relative">
                <img src="/dignitaries/manoj_sinha.png" alt="Shri Manoj Sinha" width="96" height="96" class="w-full h-full object-cover object-top transition-transform duration-500 group-hover:scale-105" />
              </div>
              <h3 class="font-bold text-slate-900 text-sm leading-snug mt-4 group-hover:text-[#0B4F9C] transition-colors">Shri Manoj Sinha</h3>
              <p class="text-[10px] text-[#0B4F9C] font-extrabold uppercase tracking-wide mt-1.5">Lieutenant Governor</p>
              <p class="text-[9px] text-slate-500 font-semibold uppercase tracking-wider mt-0.5 leading-tight">UT of Jammu and Kashmir</p>
            </div>
            <div class="mt-4">
              <a href="/dignitaries/manoj-sinha" class="inline-flex items-center justify-center w-full py-1.5 border border-slate-200 hover:border-[#0B4F9C] text-[10px] font-bold text-slate-600 hover:text-white hover:bg-[#0B4F9C] rounded transition-[background-color,border-color,color] duration-150">
                Profile Details
              </a>
            </div>
          </div>

          <!-- Dignitary 2: CM -->
          <div class="group bg-white rounded-xl border border-white/10 shadow-md p-5 flex flex-col justify-between hover:shadow-2xl hover:scale-[1.02] transition-[transform,box-shadow] duration-300 w-full text-slate-800 text-center">
            <div>
              <div class="w-24 h-24 rounded-full overflow-hidden bg-slate-100 mx-auto border-2 border-[#0B4F9C]/20 shadow-inner relative">
                <img src="/dignitaries/omar_abdullah.png" alt="Shri Omar Abdullah" width="96" height="96" class="w-full h-full object-cover object-top transition-transform duration-500 group-hover:scale-105" />
              </div>
              <h3 class="font-bold text-slate-900 text-sm leading-snug mt-4 group-hover:text-[#0B4F9C] transition-colors">Shri Omar Abdullah</h3>
              <p class="text-[9px] text-[#0B4F9C] font-extrabold uppercase tracking-wide mt-1.5">Hon'ble Chief Minister</p>
              <p class="text-[9px] text-slate-500 font-semibold uppercase tracking-wider mt-0.5 leading-tight">Power Development Dept, UT of J&K</p>
            </div>
            <div class="mt-4">
              <a href="/dignitaries/omar-abdullah" class="inline-flex items-center justify-center w-full py-1.5 border border-slate-200 hover:border-[#0B4F9C] text-[10px] font-bold text-slate-600 hover:text-white hover:bg-[#0B4F9C] rounded transition-[background-color,border-color,color] duration-150">
                Profile Details
              </a>
            </div>
          </div>

          <!-- Dignitary 3: FC/ACS PDD -->
          <div class="group bg-white rounded-xl border border-white/10 shadow-md p-5 flex flex-col justify-between hover:shadow-2xl hover:scale-[1.02] transition-[transform,box-shadow] duration-300 w-full text-slate-800 text-center">
            <div>
              <div class="w-24 h-24 rounded-full overflow-hidden bg-slate-100 mx-auto border-2 border-[#0B4F9C]/20 shadow-inner relative">
                <img src="/dignitaries/ashwani_kumar.png" alt="Shri Ashwani Kumar (IAS)" width="96" height="96" class="w-full h-full object-cover object-top transition-transform duration-500 group-hover:scale-105" />
              </div>
              <h3 class="font-bold text-slate-900 text-sm leading-snug mt-4 group-hover:text-[#0B4F9C] transition-colors">Shri Ashwani Kumar (IAS)</h3>
              <p class="text-[9px] text-[#0B4F9C] font-extrabold uppercase tracking-wide mt-1.5">Financial Commissioner (ACS)</p>
              <p class="text-[9px] text-slate-500 font-semibold uppercase tracking-wider mt-0.5 leading-tight">Power Development Dept, UT of J&K</p>
            </div>
            <div class="mt-4">
              <a href="/dignitaries/ashwani-kumar" class="inline-flex items-center justify-center w-full py-1.5 border border-slate-200 hover:border-[#0B4F9C] text-[10px] font-bold text-slate-600 hover:text-white hover:bg-[#0B4F9C] rounded transition-[background-color,border-color,color] duration-150">
                Profile Details
              </a>
            </div>
          </div>

          <!-- Dignitary 4: MD -->
          <div class="group bg-white rounded-xl border border-white/10 shadow-md p-5 flex flex-col justify-between hover:shadow-2xl hover:scale-[1.02] transition-[transform,box-shadow] duration-300 w-full text-slate-800 text-center">
            <div>
              <div class="w-24 h-24 rounded-full overflow-hidden bg-slate-100 mx-auto border-2 border-[#0B4F9C]/20 shadow-inner relative">
                <img src="/dignitaries/rahul_yadav.jpg" alt="Shri Rahul Yadav (IAS)" width="96" height="96" class="w-full h-full object-cover object-top transition-transform duration-500 group-hover:scale-105" />
              </div>
              <h3 class="font-bold text-slate-900 text-sm leading-snug mt-4 group-hover:text-[#0B4F9C] transition-colors">Shri Rahul Yadav (IAS)</h3>
              <p class="text-[9px] text-[#0B4F9C] font-extrabold uppercase tracking-wide mt-1.5">Managing Director</p>
              <p class="text-[9px] text-slate-500 font-semibold uppercase tracking-wider mt-0.5 leading-tight">JKSPDC</p>
            </div>
            <div class="mt-4">
              <a href="/dignitaries/rahul-yadav" class="inline-flex items-center justify-center w-full py-1.5 border border-slate-200 hover:border-[#0B4F9C] text-[10px] font-bold text-slate-600 hover:text-white hover:bg-[#0B4F9C] rounded transition-[background-color,border-color,color] duration-150">
                Profile Details
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- QUICK ACCESS GRID -->
    <section class="bg-white rounded-2xl border border-[#BDD7EE] p-8 md:p-10 shadow-sm">
      <div class="mb-8">
        <div class="text-xs uppercase tracking-widest text-[#0B4F9C] font-bold">Quick Access</div>
        <h2 class="text-3xl md:text-4xl font-bold text-[#1A5276] mt-2">Navigate the corporation</h2>
        <p class="text-slate-500 mt-2 max-w-2xl">One-click access to the most-used services and information across the corporation.</p>
      </div>
      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-4">
        {quickLinks.map((link) => (
          <a href={link.href} class="group relative bg-white border border-slate-200 rounded-xl p-5 hover:border-blue-300 hover:shadow-lg hover:-translate-y-1 transition-all duration-300 overflow-hidden">
            <div class={`w-11 h-11 rounded-xl ${link.bg} ${link.text} flex items-center justify-center mb-4`}>
              <Icon name={link.icon} size={22} strokeWidth={1.75} />
            </div>
            <div class="font-semibold text-slate-800 text-sm">{link.label}</div>
            <div class="text-xs text-slate-500 mt-1 leading-relaxed">{link.desc}</div>
            <span class="absolute bottom-4 right-4 text-slate-300 opacity-0 -translate-x-2 group-hover:opacity-100 group-hover:translate-x-0 transition-all text-sm">&rarr;</span>
          </a>
        ))}
      </div>
    </section>

    <!-- PROJECT EXPLORER -->
    <section id="projects" class="bg-[#EAF4FF] rounded-2xl border border-[#BDD7EE] p-8 md:p-10 shadow-sm">
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 mb-10">
        <div>
          <div class="text-xs uppercase tracking-widest text-[#0B4F9C] font-bold">Project Portfolio</div>
          <h2 class="text-3xl md:text-4xl font-bold text-[#1A5276] mt-2">Interactive Project Explorer</h2>
          <p class="text-slate-500 mt-2 max-w-2xl">Discover operational hydroelectric plants, ongoing constructions and upcoming renewable projects across J&K.</p>
        </div>
        <div class="flex items-center gap-2">
          <div class="flex items-center gap-2 rounded-lg border border-[#BDD7EE] bg-white px-4 py-2 text-xs text-[#1A5276] font-medium"><span class="w-2 h-2 rounded-full bg-emerald-500"></span> 21 Operational</div>
          <div class="flex items-center gap-2 rounded-lg border border-[#BDD7EE] bg-white px-4 py-2 text-xs text-[#1A5276] font-medium"><span class="w-2 h-2 rounded-full bg-[#0B4F9C]"></span> 8 Under Construction</div>
        </div>
      </div>
      <div class="flex items-center gap-1 mb-6 bg-white border border-slate-200 rounded-lg p-1 w-fit flex-wrap">
        {['All', 'Operational', 'Under Construction', 'Upcoming', 'Solar'].map((tab) => (
          <button data-tab={tab} class={`project-tab px-4 py-1.5 rounded-md text-sm font-medium transition-all ${tab === 'All' ? 'bg-[#0B4F9C] text-white shadow' : 'text-slate-600 hover:bg-slate-100'}`}>{tab === 'All' ? 'All Projects' : tab}</button>
        ))}
      </div>
      <div class="mb-6">
        <div class="relative max-w-sm">
          <span class="absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 flex items-center">
            <Icon name="search" size={14} strokeWidth={2} />
          </span>
          <input id="project-search" type="text" placeholder="Search projects…" class="w-full pl-9 pr-4 py-2 border border-slate-200 rounded-lg text-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-400 bg-white" />
        </div>
      </div>
      <div id="projects-grid" class="grid md:grid-cols-2 lg:grid-cols-3 gap-4">
        {projects.map((p) => (
          <div class="project-card bg-white rounded-xl border border-slate-200 p-5 hover:shadow-lg hover:-translate-y-1 transition-all duration-300" data-status={p.status} data-type={p.type} data-name={p.name.toLowerCase()}>
            <div class="flex items-start justify-between mb-3">
              <div>
                <div class="font-bold text-slate-900 text-sm">{p.name}</div>
                <div class="text-xs text-slate-500 mt-0.5">{p.district} — {p.river} River</div>
              </div>
              <span class={`text-xs font-bold uppercase px-2 py-0.5 rounded-full whitespace-nowrap ${p.status === 'Operational' ? 'bg-emerald-100 text-emerald-700' : p.status === 'Under Construction' ? 'bg-amber-100 text-amber-800' : 'bg-slate-100 text-slate-600'}`}>{p.status}</span>
            </div>
            <div class="flex items-end gap-1 mb-3">
              <span class="text-3xl font-bold text-[#0B4F9C]">{p.capacity}</span>
              <span class="text-sm text-[#0B4F9C] font-semibold pb-0.5">MW</span>
            </div>
            <div class="flex items-center justify-between text-xs text-slate-500">
              <span class={`font-medium flex items-center gap-1 ${p.type === 'Solar' ? 'text-orange-600' : 'text-blue-600'}`}>
                <Icon name={p.type === 'Solar' ? 'sun' : 'droplets'} size={12} strokeWidth={2} />
                {p.type}
              </span>
              <span>Est. {p.year}</span>
