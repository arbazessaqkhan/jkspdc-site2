const formatLongDate = (dateStr: string) => {
  if (!dateStr) return '—';
  try {
    const d = new Date(dateStr);
    return d.toLocaleDateString('en-US', { weekday: 'long', month: 'long', day: 'numeric', year: 'numeric' });
  } catch (e) {
    return dateStr;
  }
};

const formatRefDate = (dateStr: string) => {
  if (!dateStr) return '—';
  try {
    const d = new Date(dateStr);
    return d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
  } catch (e) {
    return dateStr;
  }
};

const getDocUrl = (url?: string) => {
  if (!url) return undefined;
  if (url.startsWith('/uploads/')) {
    return `http://localhost:3000${url}`;
  }
  return url;
};

const mergedTenderItems: any[] = [];
if (tenders.length > 0) {
  tenders.forEach((t: any) => {
    // 1. Add the tender itself (strictly original publishDate/createdAt, NEVER updatedAt so updating an existing tender does not bump it)
    mergedTenderItems.push({
      id: t.id,
      title: t.title,
      referenceNo: t.referenceNo,
      publishDate: t.publishDate || t.createdAt,
      closingDate: t.closingDate,
      documentUrl: t.documentUrl,
      isCorrigendum: false,
    });

    // 2. Unpack any attached corrigendums (handles JSON string or Array from database)
    let corrs: any[] = [];
    if (t.corrigendums) {
      if (Array.isArray(t.corrigendums)) {
        corrs = t.corrigendums;
      } else if (typeof t.corrigendums === 'string') {
        try {
          corrs = JSON.parse(t.corrigendums);
        } catch (e) {
          corrs = [];
        }
      }
    }

    corrs.forEach((c: any, cIdx: number) => {
      // Newly uploaded corrigendums have their own recent publishDate/createdAt
      // Updated corrigendums preserve their initial publishDate/createdAt
      mergedTenderItems.push({
        id: c.id || `${t.id}-corr-${cIdx}`,
        parentTenderId: t.id,
        title: c.title,
        parentTitle: t.title,
        referenceNo: t.referenceNo,
        publishDate: c.publishDate || c.createdAt || t.publishDate,
        closingDate: c.extendedClosingDate || t.closingDate,
        documentUrl: c.documentUrl || t.documentUrl,
        isCorrigendum: true,
      });
    });
  });
}

// Use actual active database tenders/corrigendums, or clean fallback if empty
const displayTenders = mergedTenderItems.length > 0 ? mergedTenderItems : fallbackTenders;
displayTenders.sort((a, b) => new Date(b.publishDate || 0).getTime() - new Date(a.publishDate || 0).getTime());
// Recent 10 tenders and attached corrigendums
const feedTenders = displayTenders.slice(0, 10).map((item: any, rankIdx: number) => ({
  ...item,
  isNew: rankIdx === 0,
}));

// Use actual active database notifications, or clean fallback if empty
const displayNotifs = notifications.length > 0 ? notifications : fallbackNotifications;
displayNotifs.sort((a, b) => new Date(b.publishDate || 0).getTime() - new Date(a.publishDate || 0).getTime());
// Recent 10 notifications
const feedNotifications = displayNotifs.slice(0, 10).map((item: any, rankIdx: number) => ({
  ...item,
  isNew: rankIdx === 0,
}));
