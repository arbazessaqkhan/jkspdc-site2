          <div class="w-10 h-0.5 bg-[#D8681B] mt-2.5 rounded-full"></div>
        </div>

        <!-- Dignitaries Card Container (stretches to match right column height) -->
        <div class="bg-[#F0F7FF] border border-[#BDD7EE]/50 rounded-2xl p-5 shadow-sm flex-grow flex flex-col justify-center">
