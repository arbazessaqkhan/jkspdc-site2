<script is:inline>
(function () {
  var slides = [
    { badge: "Powering Jammu & Kashmir since 1995", title: "Baglihar Hydroelectric Project", desc: "A 900 MW run-of-the-river hydroelectric plant on the Chenab River.", stat: "900", statUnit: "MW", statLabel: "Installed Capacity", statPct: 80, ctaText: "Explore Project", ctaHref: "/our-business/power-stations" },
    { badge: "Green Energy Initiative", title: "Uri Hydroelectric Power Station", desc: "The largest hydro project in J&K with 480 MW capacity.", stat: "480", statUnit: "MW", statLabel: "Installed Capacity", statPct: 55, ctaText: "View Details", ctaHref: "/our-business/power-stations" },
    { badge: "Under Construction", title: "Pakal Dul Hydroelectric Project", desc: "A 1,000 MW project on Marusudar River nearing completion.", stat: "1000", statUnit: "MW", statLabel: "Planned Capacity", statPct: 70, ctaText: "Learn More", ctaHref: "/our-business/under-construction" },
    { badge: "Renewable Energy", title: "Solar Power Development", desc: "JKSPDC is expanding into solar with projects across Ladakh and Jammu.", stat: "300", statUnit: "MW", statLabel: "Solar Target", statPct: 40, ctaText: "Solar Projects", ctaHref: "/sustainability/environment/preamble" }
  ];
  var cur = 0, total = slides.length;
  var slideEls = [], dots = document.querySelectorAll('[data-dot]');
  for (var i = 0; i < total; i++) slideEls.push(document.getElementById('slide-' + i));

  function goTo(n) {
    if (slideEls[cur]) { slideEls[cur].classList.replace('opacity-100','opacity-0'); slideEls[cur].classList.replace('z-10','z-0'); }
    if (dots[cur]) dots[cur].className = 'h-1.5 rounded-full transition-all duration-300 w-4 bg-white/40';
    cur = ((n % total) + total) % total;
    if (slideEls[cur]) { slideEls[cur].classList.replace('opacity-0','opacity-100'); slideEls[cur].classList.replace('z-0','z-10'); }
    if (dots[cur]) dots[cur].className = 'h-1.5 rounded-full transition-all duration-300 w-10 bg-[#D8681B]';
    var s = slides[cur];
    var badge = document.getElementById('hero-badge'); if (badge) badge.textContent = s.badge;
    var title = document.getElementById('hero-title'); if (title) title.textContent = s.title;
    var desc = document.getElementById('hero-desc'); if (desc) desc.textContent = s.desc;
    var sv = document.getElementById('hero-stat-value'); if (sv) sv.textContent = s.stat;
    var su = document.getElementById('hero-stat-unit'); if (su) su.textContent = s.statUnit;
    var sl = document.getElementById('hero-stat-label'); if (sl) sl.textContent = s.statLabel;
    var sb = document.getElementById('hero-stat-bar'); if (sb) sb.style.width = s.statPct + '%';
    var cta = document.getElementById('hero-cta'); if (cta) { cta.textContent = s.ctaText + ' \u2192'; cta.href = s.ctaHref; }
  }

  var prev = document.getElementById('hero-prev'); if (prev) prev.onclick = function() { goTo(cur-1); };
  var next = document.getElementById('hero-next'); if (next) next.onclick = function() { goTo(cur+1); };
  dots.forEach(function(d) { d.onclick = function() { goTo(parseInt(d.dataset.dot,10)); }; });
  setInterval(function() { goTo(cur+1); }, 6000);

  var counters = document.querySelectorAll('.metric-counter'), counted = false;
  function animateCounters() {
    counters.forEach(function(el) {
      var target = parseInt(el.dataset.target, 10), val = 0, step = Math.max(1, target/80);
      var t = setInterval(function() {
        val = Math.min(val + step, target);
        el.textContent = Math.round(val).toLocaleString('en-IN');
        if (val >= target) clearInterval(t);
      }, 20);
    });
  }
  if ('IntersectionObserver' in window && counters.length) {
    var obs = new IntersectionObserver(function(entries) {
      if (entries[0].isIntersecting && !counted) { counted = true; animateCounters(); }
    }, { threshold: 0.3 });
    obs.observe(counters[0].closest('section'));
  } else animateCounters();

  var cards = document.querySelectorAll('.project-card');
  var tabBtns = document.querySelectorAll('.project-tab');
  var searchEl = document.getElementById('project-search');
  var activeTab = 'All';
  function filterProjects() {
    var q = searchEl ? searchEl.value.toLowerCase() : '';
    cards.forEach(function(c) {
      var tabOk = activeTab==='All' || c.dataset.status===activeTab || (activeTab==='Solar' && c.dataset.type==='Solar');
      c.style.display = (tabOk && (!q || c.dataset.name.includes(q))) ? '' : 'none';
    });
  }
  tabBtns.forEach(function(btn) {
    btn.onclick = function() {
      tabBtns.forEach(function(t) { t.className = 'project-tab px-4 py-1.5 rounded-md text-sm font-medium transition-all text-slate-600 hover:bg-slate-100'; });
      btn.className = 'project-tab px-4 py-1.5 rounded-md text-sm font-medium transition-all bg-[#003366] text-white shadow';
      activeTab = btn.dataset.tab;
      filterProjects();
    };
  });
  if (searchEl) searchEl.oninput = filterProjects;
})();
</script>
