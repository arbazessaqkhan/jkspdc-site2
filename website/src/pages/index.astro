    </section>

  </div>
  <!-- end page body -->

</Layout>

<script is:inline>
(function () {
  /* ── HERO SLIDER ─────────────────────────────────────────── */
  var heroContainer = document.getElementById('hero-slides');
  var slideEls = heroContainer ? Array.from(heroContainer.children) : [];
  var total = slideEls.length;
  var cur = 0;
  var dots = Array.from(document.querySelectorAll('[data-dot]'));
  var timer = null;

  function goTo(n) {
    if (total <= 1) return;

    if (slideEls[cur]) {
      slideEls[cur].classList.remove('opacity-100', 'z-10');
      slideEls[cur].classList.add('opacity-0', 'z-0', 'pointer-events-none');
    }
    if (dots[cur]) {
      dots[cur].className = 'h-1.5 rounded-full transition-all duration-300 w-4 bg-white/40';
    }

    cur = ((n % total) + total) % total;

    if (slideEls[cur]) {
      var img = slideEls[cur].querySelector('img');
      if (img && img.loading === 'lazy') {
        img.loading = 'eager';
      }
      slideEls[cur].classList.remove('opacity-0', 'z-0', 'pointer-events-none');
      slideEls[cur].classList.add('opacity-100', 'z-10');
    }
    if (dots[cur]) {
      dots[cur].className = 'h-1.5 rounded-full transition-all duration-300 w-10 bg-[#D8681B]';
    }
  }

  function startTimer() {
    if (timer) clearInterval(timer);
    timer = setInterval(function () {
      goTo(cur + 1);
    }, 6000);
  }

  var prev = document.getElementById('hero-prev');
  if (prev) {
    prev.onclick = function (e) {
      if (e) e.preventDefault();
      goTo(cur - 1);
      startTimer();
    };
  }

  var next = document.getElementById('hero-next');
  if (next) {
    next.onclick = function (e) {
      if (e) e.preventDefault();
      goTo(cur + 1);
      startTimer();
    };
  }

  dots.forEach(function (d) {
    d.onclick = function (e) {
      if (e) e.preventDefault();
      var idx = parseInt(d.dataset.dot, 10);
      if (!isNaN(idx)) {
        goTo(idx);
        startTimer();
      }
    };
  });

  startTimer();

  /* ── OFFICE GALLERY CAROUSEL (Top Section) ───────────────── */
  var oSlides = document.querySelectorAll('.office-slide');
  var oTotal = oSlides.length;
  var oCur = 0, oDots = document.querySelectorAll('[data-office-dot]');

  function goToOffice(n) {
    if (oTotal === 0) return;
    if (oSlides[oCur]) {
      oSlides[oCur].classList.replace('opacity-100', 'opacity-0');
      oSlides[oCur].classList.replace('z-10', 'z-0');
    }
    if (oDots[oCur]) {
      oDots[oCur].className = 'w-1.5 h-1.5 rounded-full transition-all duration-300 bg-white/50';
    }
    oCur = ((n % oTotal) + oTotal) % oTotal;
    if (oSlides[oCur]) {
      oSlides[oCur].classList.replace('opacity-0', 'opacity-100');
      oSlides[oCur].classList.replace('z-0', 'z-10');
    }
    if (oDots[oCur]) {
      oDots[oCur].className = 'w-1.5 h-1.5 rounded-full transition-all duration-300 bg-[#D8681B] w-3';
    }
  }

  var oPrev = document.getElementById('office-prev');
  if (oPrev) oPrev.onclick = function() { goToOffice(oCur - 1); };
  var oNext = document.getElementById('office-next');
  if (oNext) oNext.onclick = function() { goToOffice(oCur + 1); };
  oDots.forEach(function(d) {
    d.onclick = function() { goToOffice(parseInt(d.dataset.officeDot, 10)); };
  });
  setInterval(function() { goToOffice(oCur + 1); }, 5000);

  /* ── PROJECT GALLERY CAROUSEL (About Us Section) ─────────── */
  var pSlides = document.querySelectorAll('.project-slide');
  var pTotal = pSlides.length;
  var pCur = 0, pDots = document.querySelectorAll('[data-project-dot]');

  function goToProject(n) {
    if (pTotal === 0) return;
    if (pSlides[pCur]) {
      pSlides[pCur].classList.replace('opacity-100', 'opacity-0');
      pSlides[pCur].classList.replace('z-10', 'z-0');
    }
    if (pDots[pCur]) {
      pDots[pCur].className = 'w-2 h-2 rounded-full transition-all duration-300 bg-white/50';
    }
    pCur = ((n % pTotal) + pTotal) % pTotal;
    if (pSlides[pCur]) {
      pSlides[pCur].classList.replace('opacity-0', 'opacity-100');
      pSlides[pCur].classList.replace('z-0', 'z-10');
    }
    if (pDots[pCur]) {
      pDots[pCur].className = 'w-2 h-2 rounded-full transition-all duration-300 bg-[#D8681B] w-4';
    }
  }

  var pPrev = document.getElementById('project-prev');
  if (pPrev) pPrev.onclick = function() { goToProject(pCur - 1); };
  var pNext = document.getElementById('project-next');
  if (pNext) pNext.onclick = function() { goToProject(pCur + 1); };
  pDots.forEach(function(d) {
    d.onclick = function() { goToProject(parseInt(d.dataset.projectDot, 10)); };
  });
  setInterval(function() { goToProject(pCur + 1); }, 5500);

  /* ── PROJECT FILTER & CATEGORY PREVIEW ───────────────────── */
  var cards = Array.from(document.querySelectorAll('.project-card'));
  var tabBtns = Array.from(document.querySelectorAll('.project-tab'));
  var searchEl = document.getElementById('project-search');
  var projectsGrid = document.getElementById('projects-grid');
  var emptyCategoryEl = document.getElementById('project-empty-category');
  var emptySearchEl = document.getElementById('project-empty-search');
  var viewAllBtn = document.getElementById('project-view-all-btn');

  var PREVIEW_LIMIT = 6;
  var isExpandedAll = false;

  var categoryNav = {
    'All': {
      text: function() {
        return isExpandedAll 
          ? 'Show Fewer Projects ↑' 
          : 'Show All Projects (' + cards.length + ') ↓';
      },
      href: '#projects'
    },
    'Operational': {
      text: function() { return 'View All Operational Projects →'; },
      href: '/our-business/power-stations'
    },
    'Under Construction': {
      text: function() { return 'View All Under Construction Projects →'; },
      href: '/our-business/construction'
    },
    'Upcoming': {
      text: function() { return 'View All Upcoming Projects →'; },
      href: '/our-business/under-development'
    }
  };

  var activeTab = 'All';

  // Read URL query param if present (e.g. ?status=operational or ?status=upcoming)
  var urlParams = new URLSearchParams(window.location.search);
  var statusParam = urlParams.get('status');
  if (statusParam) {
    var cleanStatus = statusParam.trim().toLowerCase().replace(/[-_]/g, ' ');
    if (cleanStatus === 'operational') activeTab = 'Operational';
    else if (cleanStatus === 'under construction') activeTab = 'Under Construction';
    else if (cleanStatus === 'upcoming') activeTab = 'Upcoming';
    else if (cleanStatus === 'all') activeTab = 'All';
  }

  function updateTabUI() {
    tabBtns.forEach(function(btn) {
      var isCurrent = btn.dataset.tab === activeTab;
      if (isCurrent) {
        btn.className = 'project-tab px-4 py-1.5 rounded-md text-xs font-semibold transition-all bg-[#0B4F9C] text-white shadow-sm';
        btn.setAttribute('aria-selected', 'true');
      } else {
        btn.className = 'project-tab px-4 py-1.5 rounded-md text-xs font-semibold transition-all text-slate-600 hover:bg-slate-100';
        btn.setAttribute('aria-selected', 'false');
      }
    });

    if (viewAllBtn && categoryNav[activeTab]) {
      viewAllBtn.textContent = categoryNav[activeTab].text();
      viewAllBtn.setAttribute('href', categoryNav[activeTab].href);
    }
  }

  function filterProjects() {
    var q = searchEl ? searchEl.value.trim().toLowerCase() : '';

    // Filter projects belonging strictly to active category
    var categoryCards = cards.filter(function(c) {
      return activeTab === 'All' || c.dataset.status === activeTab;
    });

    // Zero records in category (e.g. Under Construction)
    if (categoryCards.length === 0) {
      if (projectsGrid) projectsGrid.style.display = 'none';
      if (emptyCategoryEl) emptyCategoryEl.style.display = 'block';
      if (emptySearchEl) emptySearchEl.style.display = 'none';
      cards.forEach(function(c) { c.style.display = 'none'; });
      return;
    }

    if (emptyCategoryEl) emptyCategoryEl.style.display = 'none';

    // Match with search query if typed
    var matchedCards = categoryCards.filter(function(c) {
      if (!q) return true;
      var searchContent = c.dataset.search || (c.dataset.name + ' ' + (c.dataset.status || ''));
      return searchContent.toLowerCase().includes(q);
    });

    // Zero matches from search
    if (q && matchedCards.length === 0) {
      if (projectsGrid) projectsGrid.style.display = 'none';
      if (emptySearchEl) emptySearchEl.style.display = 'block';
      cards.forEach(function(c) { c.style.display = 'none'; });
      return;
    }

    if (emptySearchEl) emptySearchEl.style.display = 'none';
    if (projectsGrid) projectsGrid.style.display = '';

    // Show preview count when not searching and not expanded
    var shownCount = 0;
    var shouldLimit = !q && (!isExpandedAll || activeTab !== 'All');

    cards.forEach(function(c) {
      var isMatch = matchedCards.indexOf(c) !== -1;
      if (isMatch) {
        if (shouldLimit && shownCount >= PREVIEW_LIMIT) {
          c.style.display = 'none';
        } else {
          c.style.display = '';
          shownCount++;
        }
      } else {
        c.style.display = 'none';
      }
    });
  }

  if (viewAllBtn) {
    viewAllBtn.onclick = function(e) {
      if (activeTab === 'All') {
        e.preventDefault();
        isExpandedAll = !isExpandedAll;
        updateTabUI();
        filterProjects();
        if (!isExpandedAll) {
          document.getElementById('projects')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      }
    };
  }

  tabBtns.forEach(function(btn) {
    btn.onclick = function() {
      activeTab = btn.dataset.tab;
      isExpandedAll = false;
      updateTabUI();
      filterProjects();
    };
  });

  if (searchEl) {
    searchEl.oninput = filterProjects;
  }

  updateTabUI();
  filterProjects();
})();
</script>

<style is:global>
  @keyframes marquee-vertical {
    0% {
      transform: translate3d(0, 0, 0);
    }
    100% {
      transform: translate3d(0, -50%, 0);
    }
  }

  .scroll-track {
    display: flex;
    flex-direction: column;
    gap: 12px;
    animation: marquee-vertical var(--marquee-duration, 25s) linear infinite !important;
    will-change: transform;
  }

  .scroll-track:hover {
    animation-play-state: paused !important;
  }


  /* ── HOME TENDERS & NOTIFICATIONS VERTICAL FEED WITH ZEBRA ROWS ── */
  @keyframes feed-vertical {
    0% {
      transform: translate3d(0, 280px, 0);
    }
    100% {
      transform: translate3d(0, calc(280px - 50%), 0);
    }
  }

  .feed-scroll-track {
    display: flex;
    flex-direction: column;
    animation: feed-vertical 10s linear infinite !important;
    will-change: transform;
  }

  .feed-scroll-track:hover {
    animation-play-state: paused !important;
  }

  .feed-row {
    display: block;
    width: 100%;
    padding: 0.75rem 1rem;
    border-bottom: 1px solid #CBD5E1;
    text-align: left;
    text-decoration: none;
    transition: background-color 0.15s ease, color 0.15s ease;
  }

  .feed-row:hover {
    background-color: #EDF4FD !important;
  }

</style>

<script is:inline>
  (function() {
    function ensureFeedRunning() {
      var tracks = document.querySelectorAll('.feed-scroll-track');
      tracks.forEach(function(t) {
        if (document.activeElement && t.contains(document.activeElement)) {
          document.activeElement.blur();
        }
        t.style.animationPlayState = 'running';
      });
    }

    document.addEventListener('astro:page-load', ensureFeedRunning);
    window.addEventListener('pageshow', ensureFeedRunning);
    window.addEventListener('focus', ensureFeedRunning);
    document.addEventListener('visibilitychange', function() {
      if (!document.hidden) {
        ensureFeedRunning();
      }
    });
  })();
</script>

