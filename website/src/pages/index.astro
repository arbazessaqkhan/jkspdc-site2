---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';

const heroSlides = [
  { id: 0, badge: "Powering Jammu & Kashmir since 1995", title: "Baglihar Hydroelectric Project", desc: "A 900 MW run-of-the-river hydroelectric plant on the Chenab River — one of India's most strategic power assets.", stat: "900", statUnit: "MW", statLabel: "Installed Capacity", statPct: 80, img: "/slider1.jpg", ctaText: "Explore Project", ctaHref: "/our-business/power-stations" },
  { id: 1, badge: "Green Energy Initiative", title: "Uri Hydroelectric Power Station", desc: "The largest hydro project in J&K with 480 MW capacity, contributing massively to the northern grid.", stat: "480", statUnit: "MW", statLabel: "Installed Capacity", statPct: 55, img: "/slider2.jpg", ctaText: "View Details", ctaHref: "/our-business/power-stations" },
  { id: 2, badge: "Under Construction", title: "Pakal Dul Hydroelectric Project", desc: "A 1,000 MW project on Marusudar River nearing completion — set to be the largest.", stat: "1000", statUnit: "MW", statLabel: "Planned Capacity", statPct: 70, img: "/slider3.jpg", ctaText: "Learn More", ctaHref: "/our-business/under-construction" },
  { id: 3, badge: "Renewable Energy", title: "Solar Power Development", desc: "JKSPDC is expanding into solar with multiple projects across Ladakh and Jammu.", stat: "300", statUnit: "MW", statLabel: "Solar Target", statPct: 40, img: "/slider1.jpg", ctaText: "Solar Projects", ctaHref: "/sustainability/environment/preamble" },
];

const metrics = [
  { icon: "zap", label: "Total Installed Capacity", value: 3820, unit: "MW", color: "from-blue-700 to-blue-500" },
  { icon: "droplets", label: "Hydro Capacity", value: 3520, unit: "MW", color: "from-cyan-700 to-cyan-500" },
  { icon: "sun", label: "Solar Capacity", value: 300, unit: "MW", color: "from-orange-500 to-orange-400" },
  { icon: "hardhat", label: "Under Construction", value: 8, unit: "Projects", color: "from-emerald-700 to-emerald-500" },
  { icon: "factory", label: "Operational Stations", value: 21, unit: "", color: "from-blue-700 to-blue-500" },
  { icon: "users", label: "Employees", value: 4200, unit: "+", color: "from-cyan-700 to-cyan-500" },
  { icon: "file-text", label: "Open Tenders", value: 12, unit: "", color: "from-orange-500 to-orange-400" },
  { icon: "briefcase", label: "Ongoing Recruitments", value: 5, unit: "", color: "from-emerald-700 to-emerald-500" },
];

const quickLinks = [
  { icon: "building", label: "About JKSPDC", desc: "Corporate profile & leadership", href: "/about-us/explore/overview", bg: "bg-blue-50", text: "text-blue-700" },
  { icon: "factory", label: "Projects", desc: "Explore power stations", href: "/our-business/power-stations", bg: "bg-blue-50", text: "text-blue-700" },
  { icon: "file-text", label: "Tender Portal", desc: "Live tenders & bids", href: "/stakeholders/vendors/tender-bids", bg: "bg-orange-50", text: "text-orange-600" },
  { icon: "briefcase", label: "Careers", desc: "Open positions", href: "/stakeholders/career-seekers/current-openings", bg: "bg-emerald-50", text: "text-emerald-700" },
  { icon: "scroll-text", label: "RTI", desc: "Right to Information", href: "/about-us/explore/overview", bg: "bg-blue-50", text: "text-blue-700" },
  { icon: "landmark", label: "Investors", desc: "Financial reports", href: "/commercial/overview", bg: "bg-cyan-50", text: "text-cyan-700" },
  { icon: "leaf", label: "CSR", desc: "Community initiatives", href: "/sustainability/environment/preamble", bg: "bg-emerald-50", text: "text-emerald-700" },
  { icon: "newspaper", label: "Media Centre", desc: "Press & announcements", href: "/media/press-releases", bg: "bg-orange-50", text: "text-orange-600" },
  { icon: "download", label: "Downloads", desc: "Documents & forms", href: "/stakeholders/vendors/tender-bids", bg: "bg-blue-50", text: "text-blue-700" },
  { icon: "eye", label: "Vigilance", desc: "Integrity & compliance", href: "/about-us/explore/ethics-code", bg: "bg-red-50", text: "text-red-600" },
];

const projects = [
  { name: "Baglihar Stage I & II", river: "Chenab", capacity: 900, district: "Ramban", status: "Operational", type: "Hydro", year: 2008 },
  { name: "Uri Stage I", river: "Jhelum", capacity: 480, district: "Baramulla", status: "Operational", type: "Hydro", year: 1997 },
  { name: "Uri Stage II", river: "Jhelum", capacity: 240, district: "Baramulla", status: "Operational", type: "Hydro", year: 2014 },
  { name: "Salal Stage I & II", river: "Chenab", capacity: 345, district: "Reasi", status: "Operational", type: "Hydro", year: 1987 },
  { name: "Dulhasti", river: "Chenab", capacity: 390, district: "Kishtwar", status: "Operational", type: "Hydro", year: 2007 },
  { name: "Lower Jhelum", river: "Jhelum", capacity: 105, district: "Baramulla", status: "Operational", type: "Hydro", year: 2015 },
  { name: "Chutak", river: "Suru", capacity: 44, district: "Kargil", status: "Operational", type: "Hydro", year: 2012 },
  { name: "Nimmo Bazgo", river: "Indus", capacity: 45, district: "Leh", status: "Operational", type: "Hydro", year: 2013 },
  { name: "Pakal Dul", river: "Marusudar", capacity: 1000, district: "Kishtwar", status: "Under Construction", type: "Hydro", year: 2026 },
  { name: "Kiru", river: "Chenab", capacity: 624, district: "Kishtwar", status: "Under Construction", type: "Hydro", year: 2025 },
  { name: "Kwar", river: "Chenab", capacity: 540, district: "Kishtwar", status: "Under Construction", type: "Hydro", year: 2026 },
  { name: "Ratle", river: "Chenab", capacity: 850, district: "Kishtwar", status: "Under Construction", type: "Hydro", year: 2026 },
  { name: "Sawalkot", river: "Chenab", capacity: 1856, district: "Ramban", status: "Upcoming", type: "Hydro", year: 2030 },
  { name: "Bursar", river: "Marusudar", capacity: 800, district: "Kishtwar", status: "Upcoming", type: "Hydro", year: 2031 },
  { name: "Kirthai II", river: "Chenab", capacity: 930, district: "Kishtwar", status: "Upcoming", type: "Hydro", year: 2029 },
  { name: "Ladakh Solar Park I", river: "—", capacity: 100, district: "Leh", status: "Under Construction", type: "Solar", year: 2025 },
  { name: "Jammu Solar Cluster", river: "—", capacity: 200, district: "Jammu", status: "Upcoming", type: "Solar", year: 2026 },
];

const tenders = [
  { nit: "NIT-521/2025", title: "Civil Works — Baglihar Stage II Refurbishment", dept: "Civil", value: "Rs. 42.5 Cr", closing: "28 Jun 2025", status: "Open" },
  { nit: "NIT-518/2025", title: "Supply of Transformers for Ratle HEP", dept: "Electrical", value: "Rs. 87.3 Cr", closing: "15 Jul 2025", status: "Open" },
  { nit: "NIT-515/2025", title: "Security Services for Srinagar HQ (3 Years)", dept: "Admin", value: "Rs. 6.1 Cr", closing: "05 Jul 2025", status: "Open" },
  { nit: "NIT-509/2025", title: "Pakal Dul HEP — E&M Equipment Supply", dept: "Electrical", value: "Rs. 230 Cr", closing: "20 Aug 2025", status: "Open" },
  { nit: "NIT-506/2025", title: "IT Infrastructure Upgrade — Datacenter", dept: "IT", value: "Rs. 12.8 Cr", closing: "01 Jul 2025", status: "Closing Soon" },
  { nit: "NIT-501/2025", title: "EPC for Jammu Solar Cluster — Phase I", dept: "Renewable", value: "Rs. 165 Cr", closing: "30 Sep 2025", status: "Open" },
];

const careers = [
  { title: "Junior Engineer (Civil)", posts: 120, qual: "B.E/B.Tech Civil", lastDate: "30 Jun 2025", pay: "Rs.35,400-1,12,400" },
  { title: "Junior Engineer (Electrical)", posts: 90, qual: "B.E/B.Tech Electrical", lastDate: "30 Jun 2025", pay: "Rs.35,400-1,12,400" },
  { title: "Accounts Assistant", posts: 40, qual: "B.Com with Tally", lastDate: "15 Jul 2025", pay: "Rs.29,200-92,300" },
  { title: "Data Entry Operator", posts: 35, qual: "12th + Diploma in IT", lastDate: "20 Jul 2025", pay: "Rs.19,900-63,200" },
  { title: "Assistant Engineer (E&M)", posts: 25, qual: "B.E/B.Tech + 2yr Exp", lastDate: "31 Jul 2025", pay: "Rs.56,100-1,77,500" },
];

const corpStats = [
  { label: "Authorised Capital", value: "Rs.5,000 Cr" },
  { label: "Paid-Up Capital", value: "Rs.2,593 Cr" },
  { label: "Revenue 2023-24", value: "Rs.1,136 Cr" },
  { label: "JV Investment", value: "Rs.2,357 Cr" },
];
---

<Layout title="Home | JKSPDC Official Portal" description="Official enterprise portal of Jammu and Kashmir State Power Development Corporation Ltd. Powering the future of J&K through clean, sustainable, and reliable energy generation." isHome={true}>

  <!-- HERO SLIDER -->
  <section id="home" class="relative w-full overflow-hidden bg-[#084A8F]" style="height: calc(100vh - 240px); min-height: 580px;">
    <div id="hero-slides" class="absolute inset-0">
      {heroSlides.map((slide, i) => (
        <div id={`slide-${slide.id}`} class={`absolute inset-0 transition-opacity duration-700 ${i === 0 ? 'opacity-100 z-10' : 'opacity-0 z-0'}`}>
          <img src={slide.img} alt={slide.title} class="w-full h-full object-cover" />
          <div class="absolute inset-0 bg-gradient-to-r from-[#084A8F]/90 via-[#084A8F]/60 to-[#084A8F]/20"></div>
          <div class="absolute inset-0 bg-gradient-to-t from-black/50 via-transparent to-transparent"></div>
        </div>
      ))}
    </div>
    <div class="relative z-20 max-w-7xl mx-auto h-full px-4 flex items-center">
      <div class="max-w-2xl text-white">
        <div id="hero-badge" class="inline-flex items-center bg-[#D8681B] text-white text-xs font-bold uppercase tracking-wider px-3 py-1 rounded-full mb-5">{heroSlides[0].badge}</div>
        <h1 id="hero-title" class="text-4xl sm:text-5xl md:text-6xl font-bold leading-tight tracking-tight">{heroSlides[0].title}</h1>
        <p id="hero-desc" class="mt-5 text-base sm:text-lg text-white/85 max-w-xl leading-relaxed">{heroSlides[0].desc}</p>
        <div class="mt-8 flex flex-wrap items-center gap-3">
          <a id="hero-cta" href={heroSlides[0].ctaHref} class="inline-flex items-center gap-2 bg-[#D8681B] hover:bg-[#C65D18] text-white font-semibold px-6 h-12 rounded-md transition-colors text-sm shadow-lg">{heroSlides[0].ctaText} &rarr;</a>
          <button class="inline-flex items-center gap-2 border border-white/40 bg-white/5 backdrop-blur-sm text-white hover:bg-white/15 px-6 h-12 rounded-md transition-colors text-sm font-medium">&#9654; Corporate Video</button>
        </div>
      </div>
      <div class="hidden lg:block absolute right-8 bottom-24 z-20">
        <div class="bg-black/40 backdrop-blur-md border border-white/15 rounded-2xl p-6 pr-10 min-w-[220px]">
          <div id="hero-stat-label" class="text-white/60 text-xs uppercase tracking-widest font-medium">{heroSlides[0].statLabel}</div>
          <div class="flex items-end gap-1 mt-2">
            <span id="hero-stat-value" class="text-white text-6xl font-bold leading-none">{heroSlides[0].stat}</span>
            <span id="hero-stat-unit" class="text-[#D8681B] text-xl font-semibold pb-1">{heroSlides[0].statUnit}</span>
          </div>
          <div class="mt-4 h-1.5 bg-white/15 rounded-full overflow-hidden">
            <div id="hero-stat-bar" class="h-full bg-[#D8681B] rounded-full transition-all duration-700" style={`width:${heroSlides[0].statPct}%`}></div>
          </div>
        </div>
      </div>
    </div>
    <div class="absolute bottom-8 left-1/2 -translate-x-1/2 flex items-center gap-2 z-20">
      {heroSlides.map((_, i) => (
        <button data-dot={String(i)} class={`h-1.5 rounded-full transition-all duration-300 ${i === 0 ? 'w-10 bg-[#D8681B]' : 'w-4 bg-white/40'}`} aria-label={`Slide ${i + 1}`}></button>
      ))}
    </div>
    <button id="hero-prev" class="absolute left-4 top-1/2 -translate-y-1/2 z-20 w-11 h-11 rounded-full bg-black/40 text-white flex items-center justify-center hover:bg-white/20 transition border border-white/20 text-2xl" aria-label="Previous">&#8249;</button>
    <button id="hero-next" class="absolute right-4 top-1/2 -translate-y-1/2 z-20 w-11 h-11 rounded-full bg-black/40 text-white flex items-center justify-center hover:bg-white/20 transition border border-white/20 text-2xl" aria-label="Next">&#8250;</button>
  </section>

  <!-- METRICS DASHBOARD -->
  <section class="relative -mt-10 z-20 pb-6">
    <div class="max-w-7xl mx-auto px-4">
      <div class="bg-white rounded-2xl shadow-2xl border border-slate-200 overflow-hidden">
        <div class="flex items-center justify-between px-6 pt-5 pb-3 border-b border-slate-100">
          <div>
            <div class="text-xs uppercase tracking-widest text-slate-400 font-semibold">Live Corporate Dashboard</div>
            <div class="text-lg font-bold text-slate-900">Enterprise Performance Metrics</div>
          </div>
          
        </div>
        <div class="grid grid-cols-2 md:grid-cols-4 divide-x divide-y md:divide-y-0 divide-slate-100">
          {metrics.map((m) => (
            <div class="p-5 hover:bg-slate-50 transition group cursor-pointer">
              <div class={`w-10 h-10 rounded-lg bg-gradient-to-br ${m.color} flex items-center justify-center mb-3 shadow-md group-hover:scale-110 transition-transform text-white`}>
                <Icon name={m.icon} size={18} strokeWidth={2} />
              </div>
              <div class="text-xs text-slate-400 uppercase tracking-wider font-medium">{m.label}</div>
              <div class="mt-1 text-2xl xl:text-3xl font-bold text-slate-900 tabular-nums">
                <span class="metric-counter" data-target={String(m.value)}>0</span>
                <span class="text-base font-semibold text-blue-700 ml-1">{m.unit}</span>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- QUICK ACCESS GRID -->
  <section class="py-16 md:py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4">
      <div class="mb-8">
        <div class="text-xs uppercase tracking-widest text-orange-500 font-bold">Quick Access</div>
        <h2 class="text-3xl md:text-4xl font-bold text-slate-900 mt-2">Navigate the corporation</h2>
        <p class="text-slate-500 mt-2 max-w-2xl">One-click access to the most-used services and information across the corporation.</p>
      </div>
      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-4">
        {quickLinks.map((link) => (
          <a href={link.href} class="group relative bg-white border border-slate-200 rounded-xl p-5 hover:border-blue-300 hover:shadow-lg hover:-translate-y-1 transition-all duration-300 overflow-hidden">
            <div class={`w-11 h-11 rounded-xl ${link.bg} ${link.text} flex items-center justify-center mb-4`}>
              <Icon name={link.icon} size={22} strokeWidth={1.75} />
            </div>
            <div class="font-semibold text-slate-800 text-sm">{link.label}</div>
            <div class="text-xs text-slate-500 mt-1 leading-relaxed">{link.desc}</div>
            <span class="absolute bottom-4 right-4 text-slate-300 opacity-0 -translate-x-2 group-hover:opacity-100 group-hover:translate-x-0 transition-all text-sm">&rarr;</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- PROJECT EXPLORER -->
  <section id="projects" class="py-16 md:py-24 bg-gradient-to-b from-slate-50 to-slate-100">
    <div class="max-w-7xl mx-auto px-4">
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 mb-10">
        <div>
          <div class="text-xs uppercase tracking-widest text-orange-500 font-bold">Project Portfolio</div>
          <h2 class="text-3xl md:text-4xl font-bold text-slate-900 mt-2">Interactive Project Explorer</h2>
          <p class="text-slate-500 mt-2 max-w-2xl">Discover operational hydroelectric plants, ongoing constructions and upcoming renewable projects across J&K.</p>
        </div>
        <div class="flex items-center gap-2">
          <div class="flex items-center gap-2 rounded-lg border bg-white px-4 py-2 text-xs text-slate-600"><span class="w-2 h-2 rounded-full bg-emerald-500"></span> 21 Operational</div>
          <div class="flex items-center gap-2 rounded-lg border bg-white px-4 py-2 text-xs text-slate-600"><span class="w-2 h-2 rounded-full bg-orange-500"></span> 8 Under Construction</div>
        </div>
      </div>
      <div class="flex items-center gap-1 mb-6 bg-white border border-slate-200 rounded-lg p-1 w-fit flex-wrap">
        {['All', 'Operational', 'Under Construction', 'Upcoming', 'Solar'].map((tab) => (
          <button data-tab={tab} class={`project-tab px-4 py-1.5 rounded-md text-sm font-medium transition-all ${tab === 'All' ? 'bg-[#003366] text-white shadow' : 'text-slate-600 hover:bg-slate-100'}`}>{tab === 'All' ? 'All Projects' : tab}</button>
        ))}
      </div>
      <div class="mb-6">
        <div class="relative max-w-sm">
          <span class="absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 flex items-center">
            <Icon name="search" size={14} strokeWidth={2} />
          </span>
          <input id="project-search" type="text" placeholder="Search projects..." class="w-full pl-9 pr-4 py-2 border border-slate-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-400 bg-white" />
        </div>
      </div>
      <div id="projects-grid" class="grid md:grid-cols-2 lg:grid-cols-3 gap-4">
        {projects.map((p) => (
          <div class="project-card bg-white rounded-xl border border-slate-200 p-5 hover:shadow-lg hover:-translate-y-1 transition-all duration-300" data-status={p.status} data-type={p.type} data-name={p.name.toLowerCase()}>
            <div class="flex items-start justify-between mb-3">
              <div>
                <div class="font-bold text-slate-900 text-sm">{p.name}</div>
                <div class="text-xs text-slate-500 mt-0.5">{p.district} — {p.river} River</div>
              </div>
              <span class={`text-xs font-bold uppercase px-2 py-0.5 rounded-full whitespace-nowrap ${p.status === 'Operational' ? 'bg-emerald-100 text-emerald-700' : p.status === 'Under Construction' ? 'bg-orange-100 text-orange-700' : 'bg-slate-100 text-slate-600'}`}>{p.status}</span>
            </div>
            <div class="flex items-end gap-1 mb-3">
              <span class="text-3xl font-bold text-[#003366]">{p.capacity}</span>
              <span class="text-sm text-orange-500 font-semibold pb-0.5">MW</span>
            </div>
            <div class="flex items-center justify-between text-xs text-slate-500">
              <span class={`font-medium flex items-center gap-1 ${p.type === 'Solar' ? 'text-orange-600' : 'text-blue-600'}`}>
                <Icon name={p.type === 'Solar' ? 'sun' : 'droplets'} size={12} strokeWidth={2} />
                {p.type}
              </span>
              <span>Est. {p.year}</span>
              <a href="/our-business/power-stations" class="text-blue-600 hover:underline font-medium">Details &rarr;</a>
            </div>
          </div>
        ))}
      </div>
      <div class="text-center mt-10">
        <a href="/our-business/power-stations" class="inline-flex items-center gap-2 border border-slate-300 hover:border-blue-400 text-slate-700 hover:text-blue-700 px-6 py-2.5 rounded-lg text-sm font-medium bg-white transition-colors">View All Projects &rarr;</a>
      </div>
    </div>
  </section>

  <!-- ACTIVE TENDERS -->
  <section id="tenders" class="py-16 md:py-24 bg-white">
    <div class="max-w-7xl mx-auto px-4">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-10">
        <div>
          <div class="text-xs uppercase tracking-widest text-[#D8681B] font-bold">Procurement</div>
          <h2 class="text-3xl md:text-4xl font-bold text-slate-900 mt-2">Active Tenders &amp; Bids</h2>
          <p class="text-slate-500 mt-2">All currently open tenders from JKSPDCL. Download bid documents and submit online.</p>
        </div>
        <a href="/stakeholders/vendors/tender-bids" class="inline-flex items-center gap-2 bg-[#0284C7] hover:bg-[#0369A1] text-white px-5 py-2.5 rounded-lg text-sm font-medium transition-colors whitespace-nowrap shadow">View All Tenders &rarr;</a>
      </div>
      <div class="overflow-x-auto rounded-xl border border-slate-200 shadow-sm">
        <table class="w-full text-sm">
          <thead class="bg-slate-50 text-slate-600 text-xs uppercase tracking-wider">
            <tr>
              <th class="px-5 py-3 text-left font-semibold">NIT No.</th>
              <th class="px-5 py-3 text-left font-semibold">Description</th>
              <th class="px-5 py-3 text-left font-semibold hidden md:table-cell">Dept.</th>
              <th class="px-5 py-3 text-left font-semibold hidden lg:table-cell">Est. Value</th>
              <th class="px-5 py-3 text-left font-semibold">Closing</th>
              <th class="px-5 py-3 text-left font-semibold">Status</th>
              <th class="px-5 py-3"></th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            {tenders.map((t) => (
              <tr class="hover:bg-slate-50 transition-colors">
                <td class="px-5 py-4 font-mono font-semibold text-[#003366] text-xs">{t.nit}</td>
                <td class="px-5 py-4 text-slate-800 font-medium max-w-xs">{t.title}</td>
                <td class="px-5 py-4 text-slate-500 hidden md:table-cell">{t.dept}</td>
                <td class="px-5 py-4 text-slate-700 font-semibold hidden lg:table-cell">{t.value}</td>
                <td class="px-5 py-4 text-slate-600">{t.closing}</td>
                <td class="px-5 py-4"><span class={`text-xs font-bold uppercase px-2.5 py-1 rounded-full ${t.status === 'Open' ? 'bg-emerald-100 text-emerald-700' : 'bg-amber-100 text-amber-700'}`}>{t.status}</span></td>
                <td class="px-5 py-4"><a href="/stakeholders/vendors/tender-bids" class="text-blue-600 hover:underline font-medium text-xs whitespace-nowrap">Bid Docs &rarr;</a></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- ABOUT SECTION -->
  <section id="about" class="py-16 md:py-24 bg-gradient-to-br from-[#0369A1] to-[#0284C7] text-white">
    <div class="max-w-7xl mx-auto px-4">
      <div class="grid lg:grid-cols-2 gap-12 items-center">
        <div>
          <div class="text-xs uppercase tracking-widest text-[#FFE0C2] font-bold mb-4">About JKSPDC</div>
          <h2 class="text-3xl md:text-4xl font-bold leading-tight mb-6">Powering J&K Since 1995</h2>
          <p class="text-white/80 leading-relaxed mb-4">Jammu and Kashmir State Power Development Corporation Limited (JKSPDCL) is a wholly owned Public Sector Undertaking (PSU) of the Government of Jammu &amp; Kashmir, incorporated in 1995 under the Companies Act.</p>
          <p class="text-white/80 leading-relaxed mb-8">With an authorised share capital of Rs.5,000 crores, JKSPDC has investments of Rs.2,357.61 crores in joint ventures with NHPC — including CVPPPL and RHPCL.</p>
          <div class="grid grid-cols-2 gap-4 mb-8">
            {corpStats.map(stat => (
              <div class="bg-white/10 backdrop-blur-sm rounded-xl p-4 border border-white/15">
