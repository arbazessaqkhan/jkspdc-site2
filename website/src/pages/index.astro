<script is:inline>
(function () {
  /* ── HERO SLIDER ─────────────────────────────────────────── */
  var slideEls = document.querySelectorAll('[id^="slide-"]');
  var total = slideEls.length;
  var cur = 0, dots = document.querySelectorAll('[data-dot]');

  function goTo(n) {
    if (slideEls[cur]) { slideEls[cur].classList.replace('opacity-100','opacity-0'); slideEls[cur].classList.replace('z-10','z-0'); }
    if (dots[cur]) dots[cur].className = 'h-1.5 rounded-full transition-all duration-300 w-4 bg-white/40';
    cur = ((n % total) + total) % total;
    if (slideEls[cur]) { slideEls[cur].classList.replace('opacity-0','opacity-100'); slideEls[cur].classList.replace('z-0','z-10'); }
    if (dots[cur]) dots[cur].className = 'h-1.5 rounded-full transition-all duration-300 w-10 bg-[#D8681B]';
  }

  var prev = document.getElementById('hero-prev'); if (prev) prev.onclick = function() { goTo(cur-1); };
  var next = document.getElementById('hero-next'); if (next) next.onclick = function() { goTo(cur+1); };
  dots.forEach(function(d) { d.onclick = function() { goTo(parseInt(d.dataset.dot, 10)); }; });
  setInterval(function() { goTo(cur+1); }, 6000);

  /* ── GALLERY CAROUSEL ────────────────────────────────────── */
  var gSlides = document.querySelectorAll('.gallery-slide');
  var gTotal = gSlides.length;
  var gCur = 0, gDots = document.querySelectorAll('[data-gallery-dot]');

  function goToGallery(n) {
    if (gTotal === 0) return;
    if (gSlides[gCur]) {
      gSlides[gCur].classList.replace('opacity-100', 'opacity-0');
      gSlides[gCur].classList.replace('z-10', 'z-0');
    }
    if (gDots[gCur]) {
      gDots[gCur].className = 'w-2 h-2 rounded-full transition-all duration-300 bg-white/50';
    }
    gCur = ((n % gTotal) + gTotal) % gTotal;
    if (gSlides[gCur]) {
      gSlides[gCur].classList.replace('opacity-0', 'opacity-100');
      gSlides[gCur].classList.replace('z-0', 'z-10');
    }
    if (gDots[gCur]) {
      gDots[gCur].className = 'w-2 h-2 rounded-full transition-all duration-300 bg-[#D8681B] w-4';
    }
  }

  var gPrev = document.getElementById('gallery-prev');
  if (gPrev) gPrev.onclick = function() { goToGallery(gCur - 1); };
  var gNext = document.getElementById('gallery-next');
  if (gNext) gNext.onclick = function() { goToGallery(gCur + 1); };
  gDots.forEach(function(d) {
    d.onclick = function() { goToGallery(parseInt(d.dataset.galleryDot, 10)); };
  });
  setInterval(function() { goToGallery(gCur + 1); }, 5000);

  /* ── PROJECT FILTER ──────────────────────────────────────── */
  var cards = document.querySelectorAll('.project-card');
  var tabBtns = document.querySelectorAll('.project-tab');
  var searchEl = document.getElementById('project-search');
  var activeTab = 'All';

  function filterProjects() {
    var q = searchEl ? searchEl.value.toLowerCase() : '';
    cards.forEach(function(c) {
      var tabOk = activeTab === 'All' || c.dataset.status === activeTab;
      c.style.display = (tabOk && (!q || c.dataset.name.includes(q))) ? '' : 'none';
    });
  }

  tabBtns.forEach(function(btn) {
    btn.onclick = function() {
      tabBtns.forEach(function(t) {
        t.className = 'project-tab px-4 py-1.5 rounded-md text-xs font-semibold transition-all text-slate-600 hover:bg-slate-100';
      });
      btn.className = 'project-tab px-4 py-1.5 rounded-md text-xs font-semibold transition-all bg-[#0B4F9C] text-white shadow-sm';
      activeTab = btn.dataset.tab;
      filterProjects();
    };
  });
  if (searchEl) searchEl.oninput = filterProjects;
})();
</script>

