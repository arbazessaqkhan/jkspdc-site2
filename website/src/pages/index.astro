                      <h4 class="font-bold text-slate-900 text-[11px] leading-snug">
                        {tender.title}
                        {isNew && (
                          <span class="inline-block bg-[#D8681B] text-white text-[7px] font-extrabold uppercase px-1 py-0.5 rounded ml-1.5 tracking-wider">
                            New!
                          </span>
