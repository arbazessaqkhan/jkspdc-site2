                {/* Duplicate for seamless scrolling marquee */}
                {displayTenders.map((tender: any) => {
                  const isNew = tender.isNew || (new Date().getTime() - new Date(tender.publishDate).getTime()) < 7 * 24 * 60 * 60 * 1000;
                  return (
                    <a href={tender.documentUrl} class="block p-2.5 bg-white border border-slate-200 hover:border-[#0B4F9C]/30 rounded-xl shadow-sm hover:shadow transition-all duration-200 text-left">
