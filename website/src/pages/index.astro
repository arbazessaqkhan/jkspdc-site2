---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';

let directors = [];
let tenders = [];
let projects = [];
let notifications: any[] = [];
let gallery = [
  {
    id: 'gallery-seed-1',
    title: 'Signing of Implementation Agreement NHPC & JKSPDC',
    imageUrl: '/gallery/signing_agreement.png',
    partition: 'Official Events',
  },
  {
    id: 'gallery-seed-2',
    title: 'Retirement Ceremony of Executive Director Civil, JKSPDC',
    imageUrl: '/gallery/retirement_ed_civil.png',
    partition: 'Corporate',
  },
  {
    id: 'gallery-seed-3',
    title: 'Hydroelectric Project Site View',
    imageUrl: '/gallery/projects_gallery.jpg',
    partition: 'Projects',
  },
];

try {
  // Fetch directors
  const dirRes = await fetch('http://127.0.0.1:3000/api/directors');
  if (dirRes.ok) {
    directors = await dirRes.json();
    directors.sort((a: any, b: any) => a.sNo - b.sNo);
  }

  // Fetch tenders
  const tenderRes = await fetch('http://127.0.0.1:3000/api/tenders');
  if (tenderRes.ok) {
    tenders = await tenderRes.json();
    tenders.sort((a: any, b: any) => new Date(b.publishDate).getTime() - new Date(a.publishDate).getTime());
    tenders = tenders.slice(0, 5);
  }

  // Fetch projects
  const projRes = await fetch('http://127.0.0.1:3000/api/projects');
  if (projRes.ok) {
    projects = await projRes.json();
    projects.sort((a, b) => (b.capacityMw || 0) - (a.capacityMw || 0));
  }

  // Fetch notifications
  const notifRes = await fetch('http://127.0.0.1:3000/api/public/notifications');
  if (notifRes.ok) {
    notifications = await notifRes.json();
    notifications.sort((a: any, b: any) => new Date(b.publishDate).getTime() - new Date(a.publishDate).getTime());
    notifications = notifications.slice(0, 5);
  }

  // Fetch gallery items
  const galleryRes = await fetch('http://127.0.0.1:3000/api/gallery');
  if (galleryRes.ok) {
    gallery = await galleryRes.json();
  }
} catch (e) {
  console.error('Failed to sync index.astro from backend:', e);
}

function getImageUrl(url: string) {
  if (!url) return '';
  if (url.startsWith('/uploads/')) {
    return `http://127.0.0.1:3000${url}`;
  }
  return url;
}

// Get the latest uploaded gallery pictures (limit to 6)
const latestPhotos = gallery.slice().reverse().slice(0, 6);

const photoMap = {
  "Shri Manoj Sinha": "/dignitaries/manoj_sinha.png",
  "Shri Omar Abdullah": "/dignitaries/omar_abdullah.png",
  "Shri Ashwani Kumar (IAS)": "/dignitaries/ashwani_kumar.png",
  "Shri Ashwani Kumar": "/dignitaries/ashwani_kumar.png",
  "Shri Rahul Yadav (IAS)": "/dignitaries/rahul_yadav.jpg",
  "Shri Rahul Yadav": "/dignitaries/rahul_yadav.jpg",
