---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';

const heroSlides = [
  { id: 0, badge: "Powering Jammu & Kashmir since 1995", title: "Baglihar Hydroelectric Project", desc: "A 900 MW run-of-the-river hydroelectric plant on the Chenab River — one of India's most strategic power assets.", stat: "900", statUnit: "MW", statLabel: "Installed Capacity", statPct: 80, img: "/slider1.jpg", ctaText: "Explore Project", ctaHref: "/our-business/power-stations" },
  { id: 1, badge: "Green Energy Initiative", title: "Uri Hydroelectric Power Station", desc: "The largest hydro project in J&K with 480 MW capacity, contributing massively to the northern grid.", stat: "480", statUnit: "MW", statLabel: "Installed Capacity", statPct: 55, img: "/slider2.jpg", ctaText: "View Details", ctaHref: "/our-business/power-stations" },
  { id: 2, badge: "Under Construction", title: "Pakal Dul Hydroelectric Project", desc: "A 1,000 MW project on Marusudar River nearing completion — set to be the largest.", stat: "1000", statUnit: "MW", statLabel: "Planned Capacity", statPct: 70, img: "/slider3.jpg", ctaText: "Learn More", ctaHref: "/our-business/under-construction" },
  { id: 3, badge: "Renewable Energy", title: "Solar Power Development", desc: "JKSPDC is expanding into solar with multiple projects across Ladakh and Jammu.", stat: "300", statUnit: "MW", statLabel: "Solar Target", statPct: 40, img: "/slider1.jpg", ctaText: "Solar Projects", ctaHref: "/sustainability/environment/preamble" },
];

const quickLinks = [
  { icon: "building", label: "About JKSPDC", desc: "Corporate profile & leadership", href: "/about-us/explore/overview" },
  { icon: "factory", label: "Projects", desc: "Explore power stations", href: "/our-business/power-stations" },
  { icon: "file-text", label: "Tender Portal", desc: "Live tenders & bids", href: "/stakeholders/vendors/tender-bids" },
  { icon: "briefcase", label: "Careers", desc: "Open positions", href: "/stakeholders/career-seekers/current-openings" },
  { icon: "scroll-text", label: "RTI", desc: "Right to Information", href: "/about-us/explore/overview" },
  { icon: "landmark", label: "Investors", desc: "Financial reports", href: "/commercial/overview" },
  { icon: "leaf", label: "CSR", desc: "Community initiatives", href: "/sustainability/environment/preamble" },
  { icon: "newspaper", label: "Media Centre", desc: "Press & announcements", href: "/media/press-releases" },
  { icon: "download", label: "Downloads", desc: "Documents & forms", href: "/stakeholders/vendors/tender-bids" },
  { icon: "eye", label: "Vigilance", desc: "Integrity & compliance", href: "/about-us/explore/ethics-code" },
];

const projects = [
  { name: "Baglihar Stage I & II", river: "Chenab", capacity: 900, district: "Ramban", status: "Operational", type: "Hydro", year: 2008 },
  { name: "Uri Stage I", river: "Jhelum", capacity: 480, district: "Baramulla", status: "Operational", type: "Hydro", year: 1997 },
  { name: "Uri Stage II", river: "Jhelum", capacity: 240, district: "Baramulla", status: "Operational", type: "Hydro", year: 2014 },
  { name: "Salal Stage I & II", river: "Chenab", capacity: 345, district: "Reasi", status: "Operational", type: "Hydro", year: 1987 },
  { name: "Dulhasti", river: "Chenab", capacity: 390, district: "Kishtwar", status: "Operational", type: "Hydro", year: 2007 },
  { name: "Lower Jhelum", river: "Jhelum", capacity: 105, district: "Baramulla", status: "Operational", type: "Hydro", year: 2015 },
  { name: "Chutak", river: "Suru", capacity: 44, district: "Kargil", status: "Operational", type: "Hydro", year: 2012 },
  { name: "Nimmo Bazgo", river: "Indus", capacity: 45, district: "Leh", status: "Operational", type: "Hydro", year: 2013 },
  { name: "Pakal Dul", river: "Marusudar", capacity: 1000, district: "Kishtwar", status: "Under Construction", type: "Hydro", year: 2026 },
  { name: "Kiru", river: "Chenab", capacity: 624, district: "Kishtwar", status: "Under Construction", type: "Hydro", year: 2025 },
  { name: "Kwar", river: "Chenab", capacity: 540, district: "Kishtwar", status: "Under Construction", type: "Hydro", year: 2026 },
  { name: "Ratle", river: "Chenab", capacity: 850, district: "Kishtwar", status: "Under Construction", type: "Hydro", year: 2026 },
  { name: "Sawalkot", river: "Chenab", capacity: 1856, district: "Ramban", status: "Upcoming", type: "Hydro", year: 2030 },
  { name: "Bursar", river: "Marusudar", capacity: 800, district: "Kishtwar", status: "Upcoming", type: "Hydro", year: 2031 },
  { name: "Kirthai II", river: "Chenab", capacity: 930, district: "Kishtwar", status: "Upcoming", type: "Hydro", year: 2029 },
  { name: "Ladakh Solar Park I", river: "—", capacity: 100, district: "Leh", status: "Under Construction", type: "Solar", year: 2025 },
  { name: "Jammu Solar Cluster", river: "—", capacity: 200, district: "Jammu", status: "Upcoming", type: "Solar", year: 2026 },
];

const tenders = [
  { nit: "NIT-521/2025", title: "Civil Works — Baglihar Stage II Refurbishment", dept: "Civil", value: "Rs. 42.5 Cr", closing: "28 Jun 2025", status: "Open" },
  { nit: "NIT-518/2025", title: "Supply of Transformers for Ratle HEP", dept: "Electrical", value: "Rs. 87.3 Cr", closing: "15 Jul 2025", status: "Open" },
  { nit: "NIT-515/2025", title: "Security Services for Srinagar HQ (3 Years)", dept: "Admin", value: "Rs. 6.1 Cr", closing: "05 Jul 2025", status: "Open" },
  { nit: "NIT-509/2025", title: "Pakal Dul HEP — E&M Equipment Supply", dept: "Electrical", value: "Rs. 230 Cr", closing: "20 Aug 2025", status: "Open" },
  { nit: "NIT-506/2025", title: "IT Infrastructure Upgrade — Datacenter", dept: "IT", value: "Rs. 12.8 Cr", closing: "01 Jul 2025", status: "Closing Soon" },
  { nit: "NIT-501/2025", title: "EPC for Jammu Solar Cluster — Phase I", dept: "Renewable", value: "Rs. 165 Cr", closing: "30 Sep 2025", status: "Open" },
];

const corpStats = [
  { label: "Authorised Capital", value: "Rs. 5,000 Cr" },
  { label: "Paid-Up Capital", value: "Rs. 2,593 Cr" },
  { label: "Revenue 2023-24", value: "Rs. 1,136 Cr" },
  { label: "JV Investment", value: "Rs. 2,357 Cr" },
];
---

<Layout title="Home | JKSPDC Official Portal" description="Official enterprise portal of Jammu and Kashmir State Power Development Corporation Ltd. Powering the future of J&K through clean, sustainable, and reliable energy generation." isHome={true}>

  <!-- HERO SLIDER -->
  <section id="home" class="relative w-full overflow-hidden bg-[#084A8F]" style="height: calc(100vh - 240px); min-height: 580px;">
    <div id="hero-slides" class="absolute inset-0">
      {heroSlides.map((slide, i) => (
        <div id={`slide-${slide.id}`} class={`absolute inset-0 transition-opacity duration-700 ${i === 0 ? 'opacity-100 z-10' : 'opacity-0 z-0'}`}>
          <img src={slide.img} alt={slide.title} class="w-full h-full object-cover" />
          <div class="absolute inset-0 bg-gradient-to-r from-[#084A8F]/92 via-[#084A8F]/60 to-[#084A8F]/15"></div>
          <div class="absolute inset-0 bg-gradient-to-t from-black/55 via-transparent to-transparent"></div>

          <!-- Slide Content -->
          <div class="absolute inset-0 z-20 flex items-center">
            <div class="w-full max-w-7xl mx-auto px-6 sm:px-8 lg:px-10">
              <div class="max-w-2xl text-white">
                <div class="inline-flex items-center bg-[#D8681B] text-white text-[11px] font-bold uppercase tracking-widest px-3 py-1.5 rounded-full mb-6">{slide.badge}</div>
                <h2 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold leading-[1.1] tracking-tight text-balance">{slide.title}</h2>
                <p class="mt-5 text-base sm:text-lg text-white/80 max-w-xl leading-relaxed">{slide.desc}</p>
                <div class="mt-8 flex flex-wrap items-center gap-3">
                  <a href={slide.ctaHref} class="inline-flex items-center gap-2 bg-[#D8681B] hover:bg-[#C65D18] text-white font-semibold px-7 h-12 rounded-md transition-colors text-sm shadow-lg">{slide.ctaText} &rarr;</a>
                  <button class="inline-flex items-center gap-2 border border-white/40 bg-white/8 backdrop-blur-sm text-white hover:bg-white/18 px-6 h-12 rounded-md transition-colors text-sm font-medium">&#9654; Corporate Video</button>
                </div>
              </div>
            </div>
          </div>

          <!-- Stat Box -->
          <div class="hidden lg:block absolute right-10 bottom-20 z-20">
            <div class="bg-black/40 backdrop-blur-md border border-white/15 rounded-2xl p-6 pr-12 min-w-[230px]">
              <div class="text-white/55 text-[10px] uppercase tracking-[0.15em] font-semibold">{slide.statLabel}</div>
              <div class="flex items-end gap-1.5 mt-3">
                <span class="text-white text-6xl font-extrabold leading-none tabular-nums">{slide.stat}</span>
                <span class="text-[#D8681B] text-2xl font-bold pb-1">{slide.statUnit}</span>
              </div>
              <div class="mt-4 h-1.5 bg-white/15 rounded-full overflow-hidden">
                <div class="h-full bg-[#D8681B] rounded-full transition-all duration-700" style={`width:${slide.statPct}%`}></div>
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>

    <!-- Dots -->
    <div class="absolute bottom-8 left-1/2 -translate-x-1/2 flex items-center gap-2.5 z-20">
      {heroSlides.map((_, i) => (
        <button data-dot={String(i)} class={`h-1.5 rounded-full transition-all duration-300 ${i === 0 ? 'w-10 bg-[#D8681B]' : 'w-4 bg-white/40'}`} aria-label={`Slide ${i + 1}`}></button>
      ))}
    </div>
    <button id="hero-prev" class="absolute left-4 top-1/2 -translate-y-1/2 z-20 w-10 h-10 rounded-full bg-black/40 text-white flex items-center justify-center hover:bg-white/20 transition border border-white/20 text-xl" aria-label="Previous">&#8249;</button>
    <button id="hero-next" class="absolute right-4 top-1/2 -translate-y-1/2 z-20 w-10 h-10 rounded-full bg-black/40 text-white flex items-center justify-center hover:bg-white/20 transition border border-white/20 text-xl" aria-label="Next">&#8250;</button>
  </section>

  <!-- PAGE BODY — unified container + consistent vertical rhythm -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14 space-y-14">

    <!-- ============================================================ -->
    <!-- HONORABLE DIGNITARIES                                        -->
    <!-- ============================================================ -->
    <section aria-labelledby="dignitaries-heading" class="space-y-6">
      <!-- Section Header (Outside of the box) -->
      <div class="text-center">
        <span class="inline-block text-[11px] uppercase tracking-[0.14em] text-[#0B4F9C] font-extrabold bg-[#EAF4FF] px-4 py-1.5 rounded-full border border-[#BDD7EE]/50 mb-3">Leadership &amp; Governance</span>
        <h2 id="dignitaries-heading" class="text-2xl md:text-3xl font-extrabold text-[#1B2A41]">Honorable Dignitaries</h2>
        <div class="w-12 h-0.5 bg-[#D8681B] mx-auto mt-3.5 rounded-full"></div>
      </div>

      <div class="bg-gradient-to-br from-[#083B73] to-[#0A2E5C] rounded-2xl border border-white/10 shadow-xl text-white overflow-hidden">
        <!-- Cards Grid -->
        <div class="px-8 md:px-12 py-10 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">

          <!-- Dignitary Card Pattern (shared styles via inline classes) -->
          {[
            { img: "/dignitaries/manoj_sinha.png", name: "Shri Manoj Sinha", role: "Lieutenant Governor", org: "UT of Jammu and Kashmir", href: "/dignitaries/manoj-sinha" },
            { img: "/dignitaries/omar_abdullah.png", name: "Shri Omar Abdullah", role: "Hon'ble Chief Minister", org: "Power Development Dept, UT of J&K", href: "/dignitaries/omar-abdullah" },
            { img: "/dignitaries/ashwani_kumar.png", name: "Shri Ashwani Kumar (IAS)", role: "Financial Commissioner (ACS)", org: "Power Development Dept, UT of J&K", href: "/dignitaries/ashwani-kumar" },
            { img: "/dignitaries/rahul_yadav.jpg", name: "Shri Rahul Yadav (IAS)", role: "Managing Director", org: "JKSPDC", href: "/dignitaries/rahul-yadav" },
          ].map(d => (
            <div class="group bg-white rounded-xl border border-slate-100 shadow-sm p-6 flex flex-col items-center text-center hover:shadow-xl hover:-translate-y-1 transition-all duration-300">
              <div class="w-28 h-28 rounded-full overflow-hidden bg-slate-100 border-[3px] border-[#0B4F9C]/20 shadow-md flex-shrink-0">
                <img src={d.img} alt={d.name} width="112" height="112" class="w-full h-full object-cover object-top group-hover:scale-105 transition-transform duration-500" />
              </div>
              <div class="mt-4 flex-1 flex flex-col items-center">
                <h3 class="font-bold text-slate-900 text-sm leading-snug group-hover:text-[#0B4F9C] transition-colors">{d.name}</h3>
                <p class="text-[10px] text-[#0B4F9C] font-extrabold uppercase tracking-wide mt-2">{d.role}</p>
                <p class="text-[10px] text-slate-400 font-medium mt-1 leading-snug">{d.org}</p>
              </div>
              <a href={d.href} class="mt-5 w-full inline-flex items-center justify-center py-2 border border-slate-200 hover:border-[#0B4F9C] text-[11px] font-bold text-slate-600 hover:text-white hover:bg-[#0B4F9C] rounded-lg transition-all duration-150">
                Profile Details
              </a>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ============================================================ -->
    <!-- QUICK ACCESS GRID                                             -->
    <!-- ============================================================ -->
    <section aria-labelledby="quick-access-heading" class="bg-white rounded-2xl border border-[#BDD7EE] shadow-sm overflow-hidden">
      <div class="px-8 md:px-12 pt-10 pb-3">
        <div class="text-[11px] uppercase tracking-[0.14em] text-[#0B4F9C] font-extrabold mb-2">Quick Access</div>
        <h2 id="quick-access-heading" class="text-2xl md:text-3xl font-extrabold text-[#1A5276]">Navigate the corporation</h2>
        <p class="text-sm text-slate-500 mt-2.5 max-w-2xl leading-relaxed">One-click access to the most-used services and information across the corporation.</p>
      </div>
      <div class="px-8 md:px-12 pb-10 pt-8">
        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-4">
          {quickLinks.map((link) => (
            <a href={link.href} class="group relative bg-white border border-slate-200 rounded-xl p-5 hover:border-[#0B4F9C]/40 hover:shadow-lg hover:-translate-y-1 transition-all duration-300 overflow-hidden flex flex-col gap-3">
              <div class="w-11 h-11 rounded-xl bg-[#EAF4FF] text-[#0B4F9C] flex items-center justify-center flex-shrink-0">
                <Icon name={link.icon} size={20} strokeWidth={1.75} />
              </div>
              <div>
                <div class="font-semibold text-slate-800 text-sm leading-snug">{link.label}</div>
                <div class="text-xs text-slate-500 mt-1 leading-relaxed">{link.desc}</div>
              </div>
              <span class="absolute bottom-4 right-4 text-[#0B4F9C] opacity-0 -translate-x-1 group-hover:opacity-100 group-hover:translate-x-0 transition-all duration-200 text-sm font-bold">&rarr;</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- ============================================================ -->
    <!-- PROJECT EXPLORER                                              -->
    <!-- ============================================================ -->
    <section id="projects" aria-labelledby="projects-heading" class="bg-[#EAF4FF] rounded-2xl border border-[#BDD7EE] shadow-sm overflow-hidden">
      <!-- Section Header -->
      <div class="px-8 md:px-12 pt-10 pb-0">
        <div class="flex flex-col md:flex-row md:items-end justify-between gap-5">
          <div>
            <div class="text-[11px] uppercase tracking-[0.14em] text-[#0B4F9C] font-extrabold mb-2">Project Portfolio</div>
            <h2 id="projects-heading" class="text-2xl md:text-3xl font-extrabold text-[#1A5276]">Interactive Project Explorer</h2>
            <p class="text-sm text-slate-500 mt-2.5 max-w-xl leading-relaxed">Discover operational hydroelectric plants, ongoing constructions and upcoming renewable projects across J&K.</p>
          </div>
          <div class="flex items-center gap-2 flex-shrink-0">
            <div class="flex items-center gap-2 rounded-lg border border-[#BDD7EE] bg-white px-3.5 py-2 text-xs text-[#1A5276] font-semibold">
              <span class="w-2 h-2 rounded-full bg-emerald-500"></span> 21 Operational
            </div>
            <div class="flex items-center gap-2 rounded-lg border border-[#BDD7EE] bg-white px-3.5 py-2 text-xs text-[#1A5276] font-semibold">
              <span class="w-2 h-2 rounded-full bg-[#0B4F9C]"></span> 8 Under Construction
            </div>
          </div>
        </div>
      </div>

      <!-- Filters + Search -->
      <div class="px-8 md:px-12 pt-8">
        <div class="flex flex-col sm:flex-row sm:items-center gap-4">
          <div class="flex items-center gap-1 bg-white border border-slate-200 rounded-lg p-1 flex-wrap">
            {['All', 'Operational', 'Under Construction', 'Upcoming', 'Solar'].map((tab) => (
              <button data-tab={tab} class={`project-tab px-4 py-1.5 rounded-md text-xs font-semibold transition-all ${tab === 'All' ? 'bg-[#0B4F9C] text-white shadow-sm' : 'text-slate-600 hover:bg-slate-100'}`}>
                {tab === 'All' ? 'All Projects' : tab}
              </button>
            ))}
          </div>
          <div class="relative sm:ml-auto">
            <span class="absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 flex items-center">
              <Icon name="search" size={13} strokeWidth={2} />
            </span>
            <input id="project-search" type="text" placeholder="Search projects…" class="w-full sm:w-56 pl-9 pr-4 py-2 border border-slate-200 rounded-lg text-xs focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#0B4F9C]/40 bg-white" />
          </div>
        </div>
      </div>

      <!-- Project Cards Grid -->
      <div class="px-8 md:px-12 pt-6 pb-3">
        <div id="projects-grid" class="grid md:grid-cols-2 lg:grid-cols-3 gap-4">
          {projects.map((p) => (
            <div class="project-card bg-white rounded-xl border border-slate-200 p-5 hover:shadow-lg hover:-translate-y-0.5 transition-all duration-250" data-status={p.status} data-type={p.type} data-name={p.name.toLowerCase()}>
              <div class="flex items-start justify-between mb-4">
                <div class="flex-1 min-w-0 pr-3">
                  <div class="font-bold text-slate-900 text-sm leading-snug">{p.name}</div>
                  <div class="text-xs text-slate-400 mt-1">{p.district} — {p.river} River</div>
                </div>
                <span class={`text-[10px] font-bold uppercase px-2.5 py-1 rounded-full whitespace-nowrap flex-shrink-0 ${p.status === 'Operational' ? 'bg-emerald-100 text-emerald-700' : p.status === 'Under Construction' ? 'bg-amber-100 text-amber-800' : 'bg-slate-100 text-slate-600'}`}>{p.status}</span>
              </div>
              <div class="flex items-end gap-1.5 mb-4">
                <span class="text-3xl font-extrabold text-[#0B4F9C] leading-none tabular-nums">{p.capacity}</span>
                <span class="text-sm text-[#0B4F9C] font-semibold mb-0.5">MW</span>
              </div>
              <div class="flex items-center justify-between text-xs text-slate-500">
                <span class={`font-medium flex items-center gap-1 ${p.type === 'Solar' ? 'text-orange-600' : 'text-blue-600'}`}>
                  <Icon name={p.type === 'Solar' ? 'sun' : 'droplets'} size={12} strokeWidth={2} />
                  {p.type}
                </span>
                <span class="text-slate-400">Est. {p.year}</span>
                <a href="/our-business/power-stations" class="text-[#0B4F9C] hover:underline font-semibold">Details &rarr;</a>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- View All -->
      <div class="px-8 md:px-12 pt-8 pb-10 text-center">
        <a href="/our-business/power-stations" class="inline-flex items-center gap-2 border border-slate-300 hover:border-[#0B4F9C] text-slate-600 hover:text-[#0B4F9C] px-7 py-2.5 rounded-lg text-sm font-semibold bg-white transition-colors shadow-sm">View All Projects &rarr;</a>
      </div>
    </section>

    <!-- ============================================================ -->
    <!-- ACTIVE TENDERS                                                -->
    <!-- ============================================================ -->
    <section id="tenders" aria-labelledby="tenders-heading" class="bg-white rounded-2xl border border-[#BDD7EE] shadow-sm overflow-hidden">
      <div class="px-8 md:px-12 pt-10 pb-8">
        <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-5">
          <div>
            <div class="text-[11px] uppercase tracking-[0.14em] text-[#0B4F9C] font-extrabold mb-2">Procurement</div>
            <h2 id="tenders-heading" class="text-2xl md:text-3xl font-extrabold text-[#1A5276]">Active Tenders &amp; Bids</h2>
            <p class="text-sm text-slate-500 mt-2.5 leading-relaxed">All currently open tenders from JKSPDCL. Download bid documents and submit online.</p>
          </div>
          <a href="/stakeholders/vendors/tender-bids" class="inline-flex items-center gap-2 bg-[#0B4F9C] hover:bg-[#084A8F] text-white px-5 py-2.5 rounded-lg text-sm font-semibold transition-colors whitespace-nowrap shadow-sm flex-shrink-0">View All Tenders &rarr;</a>
        </div>
      </div>
      <div class="overflow-x-auto border-t border-slate-100">
        <table class="w-full text-sm">
          <thead class="bg-[#D6EAF8] text-[#1A5276] text-[11px] uppercase tracking-wider border-b border-[#BDD7EE]">
            <tr>
              <th class="px-6 py-3.5 text-left font-semibold">NIT No.</th>
              <th class="px-6 py-3.5 text-left font-semibold">Description</th>
              <th class="px-6 py-3.5 text-left font-semibold hidden md:table-cell">Dept.</th>
              <th class="px-6 py-3.5 text-left font-semibold hidden lg:table-cell">Est. Value</th>
              <th class="px-6 py-3.5 text-left font-semibold">Closing</th>
              <th class="px-6 py-3.5 text-left font-semibold">Status</th>
              <th class="px-6 py-3.5"></th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            {tenders.map((t) => (
              <tr class="hover:bg-[#EAF4FF]/50 transition-colors">
                <td class="px-6 py-4 font-mono font-semibold text-[#0B4F9C] text-xs whitespace-nowrap">{t.nit}</td>
                <td class="px-6 py-4 text-slate-800 font-medium max-w-xs text-sm">{t.title}</td>
                <td class="px-6 py-4 text-slate-500 text-xs hidden md:table-cell">{t.dept}</td>
                <td class="px-6 py-4 text-slate-700 font-semibold text-xs hidden lg:table-cell">{t.value}</td>
                <td class="px-6 py-4 text-slate-500 text-xs whitespace-nowrap">{t.closing}</td>
                <td class="px-6 py-4"><span class={`text-[10px] font-bold uppercase px-2.5 py-1 rounded-full ${t.status === 'Open' ? 'bg-emerald-100 text-emerald-700' : 'bg-amber-100 text-amber-700'}`}>{t.status}</span></td>
                <td class="px-6 py-4"><a href="/stakeholders/vendors/tender-bids" class="text-[#0B4F9C] hover:underline font-semibold text-xs whitespace-nowrap">Bid Docs &rarr;</a></td>
              </tr>
