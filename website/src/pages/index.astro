function getCleanDesc(htmlStr) {
  if (!htmlStr) return "Hydel power station operated by JKSPDC under state/central sector.";
  const clean = htmlStr.replace(/<\/?[^>]+(>|$)/g, "").replace(/\s+/g, " ").trim();
  if (clean.length > 220) {
    return clean.substring(0, 220) + "...";
  }
  return clean;
}

const operationalProjects = projects.filter((p) => p.status === 'Operational');
const displaySlides = operationalProjects.length > 0 ? operationalProjects : fallbackOperationalProjects;
displaySlides.sort((a, b) => (b.capacityMw || 0) - (a.capacityMw || 0));

const heroSlides = displaySlides.map((p, index) => {
  const slug = p.name.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
  let img = '/slider1.jpg';
  
  if (slug === 'ganderbal' || slug === 'ushp-i' || slug === 'sewa-iii') {
    img = `/projects/${slug}.png`;
  } else {
    img = `/projects/${slug}.jpg`;
  }

  return {
    id: index,
    badge: p.basin ? `${p.basin} Basin` : 'River Basin',
    title: p.name,
    desc: getCleanDesc(p.description),
    capacityMw: p.capacityMw,
    configuration: p.configuration || '—',
    designEnergy: p.designEnergy,
    yearOfCommissioning: p.yearOfCommissioning,
    basin: p.basin || '—',
    location: p.location || '—',
    img: img,
    ctaText: 'Explore Details',
    ctaHref: `/our-business/power-station-details?id=${p.id}`
  };
});

