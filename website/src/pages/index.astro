        <!-- Section Header -->
        <div class="text-left mb-4 flex-shrink-0">
          <span class="inline-block text-[10px] uppercase tracking-[0.12em] text-[#1B3A6B] font-bold bg-transparent px-3 py-1 rounded-full border border-[#1B3A6B] mb-2.5">Updates &amp; Notices</span>
