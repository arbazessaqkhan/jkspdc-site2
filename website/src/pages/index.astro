---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import { formatProjectName } from '../utils/projectFormatter';

let dignitaries: any[] = [];
let directors: any[] = [];
let tenders: any[] = [];
let projects: any[] = [];
let notifications: any[] = [];
let heroSlides: any[] = [];
let heroSettings = { autoplay: true, duration: 3 };
let welcomeSettings: { autoplay: boolean; duration: number; items: any[] } = {
  autoplay: true,
  duration: 5,
  items: [],
};
let gallery = [];

try {
  // Fetch dignitaries
  const digRes = await fetch(`${process.env.BACKEND_URL ?? import.meta.env.PUBLIC_API_BASE}/api/dignitaries`);
  if (digRes.ok) {
    const digData = await digRes.json();
    if (Array.isArray(digData)) {
      dignitaries = digData;
      dignitaries.sort((a: any, b: any) => a.sNo - b.sNo);
    }
  }

  // Fetch directors
  const dirRes = await fetch(`${process.env.BACKEND_URL ?? import.meta.env.PUBLIC_API_BASE}/api/directors`);
  if (dirRes.ok) {
    const dirData = await dirRes.json();
    if (Array.isArray(dirData)) {
      directors = dirData;
      directors.sort((a: any, b: any) => a.sNo - b.sNo);
    }
  }

  // Fetch tenders
  const tenderRes = await fetch(`${process.env.BACKEND_URL ?? import.meta.env.PUBLIC_API_BASE}/api/tenders`);
  if (tenderRes.ok) {
    const tenderData = await tenderRes.json();
    if (Array.isArray(tenderData)) {
      tenders = tenderData;
    }
  }

  // Fetch projects
  const projRes = await fetch(`${process.env.BACKEND_URL ?? import.meta.env.PUBLIC_API_BASE}/api/projects`);
  if (projRes.ok) {
    const projData = await projRes.json();
    if (Array.isArray(projData)) {
      projects = projData;
      projects.sort((a, b) => (b.capacityMw || 0) - (a.capacityMw || 0));
    }
  }

  // Fetch notifications
  const notifRes = await fetch(`${process.env.BACKEND_URL ?? import.meta.env.PUBLIC_API_BASE}/api/public/notifications`);
  if (notifRes.ok) {
    const notifData = await notifRes.json();
    if (Array.isArray(notifData)) {
      notifications = notifData;
    }
  }

  // Fetch gallery items
  const galleryRes = await fetch(`${process.env.BACKEND_URL ?? import.meta.env.PUBLIC_API_BASE}/api/gallery`);
  if (galleryRes.ok) {
    const galData = await galleryRes.json();
    if (Array.isArray(galData)) {
      gallery = galData;
    }
  }

  // Fetch homepage hero carousel slides (admin-managed, active only, ordered by sortOrder)
  const heroRes = await fetch(`${process.env.BACKEND_URL ?? import.meta.env.PUBLIC_API_BASE}/api/hero-slides/active`);
  if (heroRes.ok) {
    const rawSlides = await heroRes.json();
    heroSlides = Array.isArray(rawSlides) ? rawSlides : [];
  }

  // Fetch admin-configured carousel motion settings (autoplay + slide duration)
  const heroSettingsRes = await fetch(`${process.env.BACKEND_URL ?? import.meta.env.PUBLIC_API_BASE}/api/site-settings/homepage_hero_settings`);
  if (heroSettingsRes.ok) {
    const stored = await heroSettingsRes.json();
    if (stored && typeof stored.value === 'string') {
      try {
        const parsed = JSON.parse(stored.value);
        heroSettings = {
          autoplay: parsed.autoplay !== false,
          duration: Number(parsed.duration) >= 3 && Number(parsed.duration) <= 10 ? Number(parsed.duration) : 3,
        };
      } catch {}
    }
  }

  // Fetch Corporate Overview carousel config (admin Media Gallery selection)
  const welcomeRes = await fetch(`${process.env.BACKEND_URL ?? import.meta.env.PUBLIC_API_BASE}/api/site-settings/homepage_welcome_settings`);
  if (welcomeRes.ok) {
    const stored = await welcomeRes.json();
    if (stored && typeof stored.value === 'string') {
      try {
        const parsed = JSON.parse(stored.value);
        const parsedDuration = Number(parsed.duration);
        welcomeSettings = {
          autoplay: parsed.autoplay !== false,
          duration: parsedDuration >= 3 && parsedDuration <= 10 ? parsedDuration : 5,
          items: Array.isArray(parsed.items) ? parsed.items : [],
        };
      } catch {}
    }
  }
} catch (e) {
  console.error('Failed to sync index.astro from backend:', e);
}

const safeDignitaries = Array.isArray(dignitaries) ? dignitaries : [];
const safeProjects = Array.isArray(projects) ? projects : [];
const safeTenders = Array.isArray(tenders) ? tenders : [];
const safeNotifications = Array.isArray(notifications) ? notifications : [];
const safeGallery = Array.isArray(gallery) ? gallery : [];

function getImageUrl(url: string) {
  if (!url) return '';
  if (url.startsWith('/uploads/')) {
    return `${process.env.BACKEND_URL ?? import.meta.env.PUBLIC_API_BASE}${url}`;
  }
  return url;
}

// 1. Corporate Overview carousel — ONLY items explicitly selected in the
// Admin Media Gallery carousel config (homepage_welcome_settings), in the
// administrator's order, excluding slides disabled by the administrator.
const welcomeItems = Array.isArray(welcomeSettings?.items) ? welcomeSettings.items : [];
const overviewSlides = welcomeItems
  .filter((item: any) => item && item.imageUrl && item.isActive !== false)
  .slice()
  .sort((a: any, b: any) => (Number(a.displayOrder) || 0) - (Number(b.displayOrder) || 0));

// 2. Project Photographs ONLY (Hydroelectric Plants, Dams, Solar Assets)
const projectGalleryPhotos = safeGallery.filter((item: any) => 
  item.partition && item.partition.toLowerCase() === 'projects'
);
const displayProjectPhotos = projectGalleryPhotos;

const photoMap = {
  "Shri Manoj Sinha": "/dignitaries/manoj_sinha.png",
  "Shri Omar Abdullah": "/dignitaries/omar_abdullah.png",
  "Shri Ashwani Kumar (IAS)": "/dignitaries/ashwani_kumar.png",
  "Shri Ashwani Kumar": "/dignitaries/ashwani_kumar.png",
  "Shri Rahul Yadav (IAS)": "/dignitaries/rahul_yadav.jpg",
  "Shri Rahul Yadav": "/dignitaries/rahul_yadav.jpg",
  "Rahul Yadav": "/dignitaries/rahul_yadav.jpg",
  "Sh. Satish Chandra, IAS": "/dignitaries/manoj_sinha.png", // fallback or default
  "Sh. Vikrant Gupta": "/dignitaries/ashwani_kumar.png",
  "Smt. Anjali Dev": null
};

const routeMap = {
  "Shri Manoj Sinha": "/dignitaries/manoj-sinha",
  "Shri Omar Abdullah": "/dignitaries/omar-abdullah",
  "Shri Ashwani Kumar (IAS)": "/dignitaries/ashwani-kumar",
  "Shri Ashwani Kumar": "/dignitaries/ashwani-kumar",
  "Shri Rahul Yadav (IAS)": "/dignitaries/rahul-yadav",
  "Shri Rahul Yadav": "/dignitaries/rahul-yadav"
};

// Fallback purpose: When projects are populated from admin side, fallback is automatically removed
const displayProjects = safeProjects;



// Hero carousel timing is fully admin-controlled. Defaults only guard against a
// missing setting; they never introduce carousel content.
const heroSlideMs = Math.max(3, Math.min(10, Number(heroSettings.duration) || 3)) * 1000;

const quickLinks = [
  { icon: "building", label: "About JKSPDC", desc: "Corporate profile & leadership", href: "/about-us/explore/overview" },
  { icon: "factory", label: "Projects", desc: "Explore power stations", href: "/our-business/power-stations" },
  { icon: "file-text", label: "Tender Portal", desc: "Live tenders & bids", href: "/stakeholders/vendors/tender-bids" },
  { icon: "scroll-text", label: "RTI", desc: "Right to Information", href: "/about-us/explore/rti" },
  { icon: "landmark", label: "Investors", desc: "AGM & IPP Projects", href: "/stakeholders/investors/agm" },
  { icon: "leaf", label: "CSR Policy", desc: "Community initiatives", href: "/sustainability/csr/policy" },
  { icon: "image", label: "Media Gallery", desc: "Photos & event coverage", href: "/media/gallery" },
  { icon: "download", label: "Downloads", desc: "Documents & forms", href: "/media/downloads" },
  { icon: "bell", label: "Notifications", desc: "Circulars & updates", href: "/notifications" },
  { icon: "eye", label: "Policies", desc: "Corporate guidelines", href: "/about-us/explore/policies" },
];


const corpStats = [
  { label: "Authorised Capital", value: "Rs. 5,000 Cr" },
  { label: "Paid-Up Capital", value: "Rs. 2,593 Cr" },
  { label: "Revenue 2023-24", value: "Rs. 1,136 Cr" },
  { label: "JV Investment", value: "Rs. 2,357 Cr" },
];

const formatLongDate = (dateStr: string) => {
  if (!dateStr) return '—';
  try {
    const d = new Date(dateStr);
    return d.toLocaleDateString('en-US', { weekday: 'long', month: 'long', day: 'numeric', year: 'numeric' });
  } catch (e) {
    return dateStr;
  }
};

const formatRefDate = (dateStr: string) => {
  if (!dateStr) return '—';
  try {
    const d = new Date(dateStr);
    return d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
  } catch (e) {
    return dateStr;
  }
};

const getDocUrl = (url?: string) => {
  if (!url) return undefined;
  if (url.startsWith('/uploads/')) {
    return `${process.env.BACKEND_URL ?? import.meta.env.PUBLIC_API_BASE}${url}`;
  }
  return url;
};

const mergedTenderItems: any[] = [];
if (safeTenders.length > 0) {
  safeTenders.forEach((t: any) => {
    // 1. Add the tender itself (strictly original publishDate/createdAt, NEVER updatedAt so updating an existing tender does not bump it)
    mergedTenderItems.push({
      id: t.id,
      title: t.title,
      referenceNo: t.referenceNo,
      publishDate: t.publishDate || t.createdAt,
      closingDate: t.closingDate,
      documentUrl: t.documentUrl,
      isCorrigendum: false,
    });

    // 2. Unpack any attached corrigendums (handles JSON string or Array from database)
    let corrs: any[] = [];
    if (t.corrigendums) {
      if (Array.isArray(t.corrigendums)) {
        corrs = t.corrigendums;
      } else if (typeof t.corrigendums === 'string') {
        try {
          corrs = JSON.parse(t.corrigendums);
        } catch (e) {
          corrs = [];
        }
      }
    }

    corrs.forEach((c: any, cIdx: number) => {
      // Newly uploaded corrigendums have their own recent publishDate/createdAt
      // Updated corrigendums preserve their initial publishDate/createdAt
      mergedTenderItems.push({
        id: c.id || `${t.id}-corr-${cIdx}`,
        parentTenderId: t.id,
        title: c.title,
        parentTitle: t.title,
        referenceNo: t.referenceNo,
        publishDate: c.publishDate || c.createdAt || t.publishDate,
        closingDate: c.extendedClosingDate || t.closingDate,
        documentUrl: c.documentUrl || t.documentUrl,
        isCorrigendum: true,
      });
    });
  });
}

// Use actual active database tenders/corrigendums
const displayTenders = mergedTenderItems.slice();
displayTenders.sort((a, b) => new Date(b.publishDate || 0).getTime() - new Date(a.publishDate || 0).getTime());
// Recent 10 tenders and attached corrigendums
const feedTenders = displayTenders.slice(0, 10).map((item: any, rankIdx: number) => ({
  ...item,
  isNew: rankIdx === 0,
}));

// Use actual active database notifications
const displayNotifs = safeNotifications.slice();
displayNotifs.sort((a, b) => new Date(b.publishDate || 0).getTime() - new Date(a.publishDate || 0).getTime());
// Recent 10 notifications
const feedNotifications = displayNotifs.slice(0, 10).map((item: any, rankIdx: number) => ({
  ...item,
  isNew: rankIdx === 0,
}));
---

<Layout title="Home | JKSPDC Official Portal" description="Official enterprise portal of Jammu and Kashmir State Power Development Corporation Ltd. Powering the future of J&K through clean, sustainable, and reliable energy generation." isHome={true}>

  <!-- HERO CAROUSEL (admin-managed slides) -->
  <section
    id="home"
    class="hero-section relative w-full overflow-hidden bg-[#002B49]"
    aria-roledescription="carousel"
    aria-label="Featured highlights"
    data-hero-duration={heroSlideMs}
    data-hero-autoplay={heroSettings.autoplay ? 'true' : 'false'}
  >
    {heroSlides.length > 0 ? (
      <>
        <div id="hero-slides" class="absolute inset-0">
          {heroSlides.map((slide, i) => (
            <div
              class={`hero-slide absolute inset-0 transition-opacity duration-700 ease-out ${i === 0 ? 'opacity-100 z-10' : 'opacity-0 z-0 pointer-events-none'}`}
              aria-hidden={i === 0 ? undefined : 'true'}
            >
              {slide.imageUrl ? (
                <img
                  src={getImageUrl(slide.imageUrl)}
                  alt={slide.title || ''}
                  class="absolute inset-0 h-full w-full object-cover"
                  fetchpriority={i === 0 ? 'high' : 'auto'}
                  loading={i === 0 ? 'eager' : 'lazy'}
                />
              ) : (
                <div class="absolute inset-0 bg-[#002B49]"></div>
              )}

              <!-- No dark scrim: images keep their natural brightness -->
              <div class="absolute inset-0 z-20 flex items-end sm:items-center">
                <div class="w-full max-w-7xl mx-auto pl-16 sm:pl-20 lg:pl-24 pr-6 sm:pr-8 lg:pr-10 pb-6 sm:pb-0">
                  <div class="max-w-2xl text-white">
                    <h2 class="text-2xl sm:text-4xl lg:text-[2.75rem] font-bold leading-tight tracking-tight" style="text-shadow: 0 2px 12px rgba(0,0,0,0.5);">
                      {slide.title}
                    </h2>
                    <div class="mt-4 h-0.5 w-14 bg-[#0EA4E5]"></div>
                    {slide.description && (
                      <p class="mt-4 max-w-xl text-sm sm:text-base text-white/90 leading-relaxed line-clamp-3" style="text-shadow: 0 1px 6px rgba(0,0,0,0.55);">
                        {slide.description}
                      </p>
                    )}
                    {slide.ctaHref && (
                      <a
                        href={slide.ctaHref}
                        class="mt-6 inline-flex h-11 items-center gap-2 rounded-sm bg-[#0B3B60] px-6 text-sm font-semibold text-white transition-colors hover:bg-[#002B49] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white/70"
                      >
                        {slide.ctaText || 'Explore Details'} &rarr;
                      </a>
                    )}
                  </div>
                </div>
              </div>
            </div>
          ))}
        </div>

        {heroSlides.length > 1 && (
          <>
            <button
              id="hero-prev"
              type="button"
              class="absolute left-3 sm:left-5 top-1/2 z-30 flex h-9 w-9 -translate-y-1/2 items-center justify-center rounded-full border border-white/30 bg-black/25 text-white/90 backdrop-blur-sm transition-colors hover:bg-black/50 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white/70"
              aria-label="Previous slide"
            >
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6" /></svg>
            </button>
            <button
              id="hero-next"
              type="button"
              class="absolute right-3 sm:right-5 top-1/2 z-30 flex h-9 w-9 -translate-y-1/2 items-center justify-center rounded-full border border-white/30 bg-black/25 text-white/90 backdrop-blur-sm transition-colors hover:bg-black/50 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white/70"
              aria-label="Next slide"
            >
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6" /></svg>
            </button>

            <!-- Indicators: Horizontal Strips / Progress Dashes -->
            <div
              id="hero-indicators"
              class="absolute bottom-3 sm:bottom-4 left-1/2 -translate-x-1/2 z-30 flex items-center justify-center gap-1.5 sm:gap-2 px-3 py-1.5 rounded-full bg-black/30 backdrop-blur-xs"
              role="tablist"
              aria-label="Carousel slide indicators"
            >
              {heroSlides.map((_, i) => (
                <button
                  type="button"
                  data-hero-indicator={String(i)}
                  class={`hero-indicator-strip h-1 sm:h-1.5 rounded-full transition-all duration-300 cursor-pointer focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white/80 ${i === 0 ? 'w-8 sm:w-10 bg-[#0EA4E5]' : 'w-4 sm:w-5 bg-white/40 hover:bg-white/70'}`}
                  aria-label={`Go to slide ${i + 1}`}
                  aria-current={i === 0 ? 'true' : undefined}
                ></button>
              ))}
            </div>
          </>
        )}
      </>
    ) : (
      <div class="absolute inset-0 z-20 flex items-center justify-center bg-gradient-to-r from-[#002B49] via-[#0B3B60] to-[#002B49]">
        <div class="w-full max-w-4xl mx-auto px-6 text-center text-white">
          <h1 class="text-2xl sm:text-4xl lg:text-5xl font-bold leading-tight tracking-tight" style="text-shadow: 0 2px 10px rgba(0,0,0,0.5);">
            Jammu and Kashmir State Power Development Corporation Limited
          </h1>
          <div class="mt-4 h-0.5 w-16 bg-[#0EA4E5] mx-auto"></div>
          <p class="mt-4 max-w-2xl mx-auto text-sm sm:text-base text-white/90 leading-relaxed" style="text-shadow: 0 1px 4px rgba(0,0,0,0.5);">
            Harnessing Clean, Sustainable, and Reliable Hydroelectric &amp; Renewable Energy for Jammu &amp; Kashmir.
          </p>
        </div>
      </div>
    )}
  </section>

  <!-- PAGE BODY — unified container + consistent vertical rhythm -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14 space-y-14">

    <!-- ============================================================ -->
    <!-- DIGNITARIES SECTION (FULL WIDTH)                              -->
    <!-- ==========================================================    <!-- ============================================================ -->
    <!-- DIGNITARIES & UPDATES SIDE-BY-SIDE SECTION                     -->
    <!-- ========================================================    <!-- ============================================================ -->
    <!-- WELCOME, TENDERS & NOTIFICATIONS (3-COLUMN LAYOUT)            -->
    <!-- ============================================================ -->
    <section class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-10 gap-6 items-stretch">
      
      <!-- LEFT COLUMN: WELCOME & OFFICE GALLERY CAROUSEL (40% width = 4 cols) -->
      <div class="md:col-span-2 lg:col-span-4 flex flex-col">
        <!-- Section Header -->
        <div class="text-left mb-4 flex-shrink-0">
          <span class="inline-block text-xs uppercase tracking-[0.12em] text-brand-primary-dark font-bold bg-transparent px-3 py-1 border border-brand-primary-dark mb-2.5">Corporate Overview</span>
          <h2 class="text-lg xl:text-xl font-bold text-brand-text">
            Welcome to <span class="text-brand-primary">JKSPDCL</span>
          </h2>
          <div class="w-10 h-0.5 bg-sky-600/70 mt-2.5"></div>
        </div>

        <!-- Welcome Card Container with Office Gallery Carousel -->
        <div class="bg-white border border-slate-200 rounded-md p-4 flex flex-col justify-between flex-grow h-[320px] shadow-xs overflow-hidden relative">
          <!-- Office Events, Retirements & Awards Carousel -->
          {overviewSlides.length > 0 ? (
            <div
              class="relative w-full flex-grow rounded-md overflow-hidden shadow-xs border border-slate-200 bg-[#F4F8FB] group"
              id="office-carousel-container"
              data-overview-duration={String(welcomeSettings.duration * 1000)}
              data-overview-autoplay={welcomeSettings.autoplay ? 'true' : 'false'}
            >
              <div class="absolute inset-0" id="office-slides">
                {overviewSlides.map((photo: any, index: number) => (
                  <div class={`office-slide absolute inset-0 transition-opacity duration-700 ease-in-out ${index === 0 ? 'opacity-100 z-10' : 'opacity-0 z-0'}`}>
                    <img 
                      src={getImageUrl(photo.imageUrl)} 
                      alt={photo.title || ''} 
                      class="w-full h-full object-cover" 
                      loading={index === 0 ? 'eager' : 'lazy'}
                    />
                    <!-- Overlay Caption -->
                    <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/35 to-transparent flex flex-col justify-end p-3 z-10 text-left">
                      <span class="block w-8 h-0.5 bg-brand-accent mb-1.5 shadow-xs" aria-hidden="true"></span>
                      <h4 class="text-white text-xs font-bold leading-snug line-clamp-1" style="text-shadow: 0 1px 3px rgba(0,0,0,0.6);">
                        {photo.title}
                      </h4>
                    </div>
                  </div>
                ))}
              </div>

              {overviewSlides.length > 1 && (
                <>
                  <!-- Controls -->
                  <button id="office-prev" class="absolute left-2 top-1/2 -translate-y-1/2 z-20 w-6 h-6 rounded-full bg-black/45 text-white flex items-center justify-center hover:bg-black/65 transition text-xs font-bold shadow-xs focus-visible:outline-none" aria-label="Previous image">&#8249;</button>
                  <button id="office-next" class="absolute right-2 top-1/2 -translate-y-1/2 z-20 w-6 h-6 rounded-full bg-black/45 text-white flex items-center justify-center hover:bg-black/65 transition text-xs font-bold shadow-xs focus-visible:outline-none" aria-label="Next image">&#8250;</button>

                  <!-- Indicators (Dots) -->
                  <div class="absolute bottom-2 left-1/2 -translate-x-1/2 flex items-center gap-1 z-20">
                    {overviewSlides.map((_: any, i: number) => (
                      <button data-office-dot={String(i)} class={`w-1.5 h-1.5 transition-all duration-300 ${i === 0 ? 'bg-white w-3' : 'bg-white/50'}`} aria-label={`Go to slide ${i + 1}`}></button>
                    ))}
                  </div>
                </>
              )}
            </div>
          ) : (
            <div class="relative w-full flex-grow rounded-md overflow-hidden border border-slate-200 bg-gradient-to-br from-[#F4F8FB] to-[#E9F2F9] flex flex-col items-center justify-center p-6 text-center">
              <div class="w-12 h-12 rounded-full bg-brand-primary/10 flex items-center justify-center text-brand-primary mb-3">
                <Icon name="building" size={24} />
              </div>
              <h4 class="text-sm font-bold text-slate-800 mb-1">Corporate Overview</h4>
              <p class="text-xs text-slate-500 max-w-xs leading-relaxed">
                Jammu &amp; Kashmir State Power Development Corporation Limited. Featured gallery highlights can be curated via Media Gallery in Admin.
              </p>
            </div>
          )}

          <!-- Read More & Admin Gallery Link -->
          <div class="flex items-center justify-between mt-2 pt-2 border-t border-slate-100">
            <a href="/about-us/explore/overview" class="text-brand-primary hover:underline font-bold text-xs">
              Read More &raquo;
            </a>
            <a href="/media/gallery" class="text-xs text-slate-500 hover:text-brand-primary font-semibold flex items-center gap-1.5">
              <Icon name="camera" size={13} class="shrink-0" />
              <span>Office Gallery &rarr;</span>
            </a>
          </div>
        </div>
      </div>

      <!-- MIDDLE COLUMN: TENDERS & BIDS (30% width = 3 cols) -->
      <div class="md:col-span-1 lg:col-span-3 flex flex-col">
        <!-- Section Header -->
        <div class="text-left mb-4 flex-shrink-0">
          <span class="inline-block text-xs uppercase tracking-[0.12em] text-brand-primary-dark font-bold bg-transparent px-3 py-1 border border-brand-primary-dark mb-2.5">Procurement</span>
          <h2 id="tenders-heading" class="text-lg xl:text-xl font-bold text-brand-text">Tenders</h2>
          <div class="w-10 h-0.5 bg-sky-600/70 mt-2.5"></div>
        </div>

        <!-- Tenders Card Container -->
        <div class="bg-white border border-slate-200 rounded-md overflow-hidden flex flex-col justify-between flex-grow h-[320px] shadow-xs">
          {feedTenders.length > 0 ? (
            <div class="relative flex-grow overflow-hidden">
              <div class="absolute left-0 right-0 top-0 h-4 bg-gradient-to-b from-[#ffffff] to-transparent z-10 pointer-events-none"></div>
              <div class="absolute left-0 right-0 bottom-0 h-4 bg-gradient-to-t from-[#ffffff] to-transparent z-10 pointer-events-none"></div>

              <div 
                id="home-tenders-track" 
