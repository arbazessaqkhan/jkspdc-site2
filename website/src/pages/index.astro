import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';

let directors = [];
let tenders = [];
let projects = [];
let notifications: any[] = [];

try {
  // Fetch directors
  const dirRes = await fetch('http://localhost:3000/api/directors');
  if (dirRes.ok) {
    directors = await dirRes.json();
    directors.sort((a: any, b: any) => a.sNo - b.sNo);
  }

  // Fetch tenders
  const tenderRes = await fetch('http://localhost:3000/api/tenders');
  if (tenderRes.ok) {
    tenders = await tenderRes.json();
    tenders.sort((a: any, b: any) => new Date(b.publishDate).getTime() - new Date(a.publishDate).getTime());
    tenders = tenders.slice(0, 5);
  }

  // Fetch projects
  const projRes = await fetch('http://localhost:3000/api/projects');
  if (projRes.ok) {
    projects = await projRes.json();
  }

  // Fetch notifications
  const notifRes = await fetch('http://localhost:3000/api/public/notifications');
  if (notifRes.ok) {
    notifications = await notifRes.json();
    notifications.sort((a: any, b: any) => new Date(b.publishDate).getTime() - new Date(a.publishDate).getTime());
    notifications = notifications.slice(0, 5);
  }
} catch (e) {
  console.error('Failed to sync index.astro from backend:', e);
}

