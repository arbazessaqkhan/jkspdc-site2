const formatLongDate = (dateStr: string) => {
  if (!dateStr) return '—';
  try {
    const d = new Date(dateStr);
    return d.toLocaleDateString('en-US', { weekday: 'long', month: 'long', day: 'numeric', year: 'numeric' });
  } catch (e) {
    return dateStr;
  }
};

const formatRefDate = (dateStr: string) => {
  if (!dateStr) return '—';
  try {
    const d = new Date(dateStr);
    return d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
  } catch (e) {
    return dateStr;
  }
};

const getDocUrl = (url?: string) => {
  if (!url) return undefined;
  if (url.startsWith('/uploads/')) {
    return `http://localhost:3000${url}`;
  }
  return url;
};

const displayNotifications = notifications.length > 0 ? notifications : fallbackNotifications;
const displayTenders = tenders.length > 0 ? tenders : fallbackTenders;
---

<Layout title="Home | JKSPDC Official Portal" description="Official enterprise portal of Jammu and Kashmir State Power Development Corporation Ltd. Powering the future of J&K through clean, sustainable, and reliable energy generation." isHome={true}>

  <!-- HERO SLIDER -->
  <section id="home" class="relative w-full overflow-hidden bg-[#084A8F]" style="height: 52vh; min-height: 480px; max-height: 600px;">
    <div id="hero-slides" class="absolute inset-0">
      {heroSlides.map((slide, i) => (
        <div id={`slide-${slide.id}`} class={`absolute inset-0 transition-opacity duration-700 ${i === 0 ? 'opacity-100 z-10' : 'opacity-0 z-0'}`}>
          <img src={slide.img} alt={slide.title} class="absolute inset-0 w-full h-full object-cover opacity-90" />
          <div class="absolute inset-0 bg-gradient-to-r from-black/65 via-black/35 to-transparent z-10"></div>
          <div class="absolute inset-0 bg-gradient-to-t from-black/50 via-transparent to-transparent z-10"></div>

          <!-- Slide Content -->
          <div class="absolute inset-0 z-20 flex items-center">
            <div class="w-full max-w-7xl mx-auto px-6 sm:px-8 lg:px-10">
              <div class="grid grid-cols-1 md:grid-cols-5 gap-8 items-center">
                <!-- Left: Title, Desc, Buttons -->
                <div class="md:col-span-3 text-white">
                  <div class="inline-flex items-center bg-[#D8681B] text-white text-[10px] font-bold uppercase tracking-widest px-3 py-1.5 rounded-full mb-6">
                    {slide.badge}
                  </div>
                  <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold leading-[1.15] tracking-tight" style="text-shadow: 0 2px 8px rgba(0,0,0,0.45);">
                    {slide.title}
                  </h2>
                  <p class="mt-5 text-sm sm:text-base text-white/90 max-w-xl leading-relaxed">
                    {slide.desc}
                  </p>
                  <div class="mt-8 flex flex-wrap items-center gap-3">
                    <a href={slide.ctaHref} class="inline-flex items-center gap-2 bg-[#D8681B] hover:bg-[#C65D18] text-white font-semibold px-7 h-12 rounded transition-colors text-sm shadow-lg">
                      Explore Details &rarr;
                    </a>
                  </div>
                </div>

                <!-- Right: Technical Specifications -->
                <div class="md:col-span-2 hidden md:block">
                  <div class="bg-black/35 backdrop-blur-md border border-white/25 rounded-2xl p-5 text-white max-w-sm ml-auto shadow-xl">
                    <h3 class="font-extrabold text-[10px] uppercase tracking-wider text-[#D8681B] border-b border-white/10 pb-2 mb-3">
                      ⚙️ Technical Specifications
                    </h3>
                    <dl class="grid grid-cols-2 gap-x-4 gap-y-2.5 text-[11px]">
                      <div>
                        <dt class="text-white/60 font-semibold uppercase tracking-wider text-[11px]">Installed Capacity</dt>
                        <dd class="text-base font-extrabold text-white mt-0.5">{slide.capacityMw} MW</dd>
                      </div>
                      <div>
                        <dt class="text-white/60 font-semibold uppercase tracking-wider text-[11px]">Configuration</dt>
                        <dd class="text-xs font-bold text-white mt-0.5">{slide.configuration}</dd>
                      </div>
                      <div>
                        <dt class="text-white/60 font-semibold uppercase tracking-wider text-[11px]">Design Energy</dt>
                        <dd class="text-xs font-bold text-white mt-0.5">{slide.designEnergy ? `${slide.designEnergy} MU` : '—'}</dd>
                      </div>
                      <div>
                        <dt class="text-white/60 font-semibold uppercase tracking-wider text-[11px]">Commissioning</dt>
                        <dd class="text-xs font-bold text-white mt-0.5">{slide.yearOfCommissioning || '—'}</dd>
                      </div>
                      <div>
                        <dt class="text-white/60 font-semibold uppercase tracking-wider text-[11px]">River Basin</dt>
                        <dd class="text-xs font-bold text-white mt-0.5">{slide.basin}</dd>
                      </div>
                      <div>
                        <dt class="text-white/60 font-semibold uppercase tracking-wider text-[11px]">District Location</dt>
                        <dd class="text-xs font-bold text-white mt-0.5">{slide.location}</dd>
                      </div>
                    </dl>
                  </div>
                </div>

              </div>
            </div>
          </div>
        </div>
      ))}
    </div>

    <!-- Dots -->
    <div class="absolute bottom-8 left-1/2 -translate-x-1/2 flex items-center gap-2.5 z-20">
      {heroSlides.map((_, i) => (
        <button data-dot={String(i)} class={`h-1.5 rounded-full transition-all duration-300 ${i === 0 ? 'w-10 bg-[#D8681B]' : 'w-4 bg-white/40'}`} aria-label={`Slide ${i + 1}`}></button>
      ))}
    </div>
    <button id="hero-prev" class="absolute left-4 top-1/2 -translate-y-1/2 z-20 w-10 h-10 rounded-full bg-black/40 text-white flex items-center justify-center hover:bg-white/20 transition border border-white/20 text-xl" aria-label="Previous">&#8249;</button>
    <button id="hero-next" class="absolute right-4 top-1/2 -translate-y-1/2 z-20 w-10 h-10 rounded-full bg-black/40 text-white flex items-center justify-center hover:bg-white/20 transition border border-white/20 text-xl" aria-label="Next">&#8250;</button>
  </section>

  <!-- PAGE BODY — unified container + consistent vertical rhythm -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14 space-y-14">

    <!-- ============================================================ -->
    <!-- DIGNITARIES SECTION (FULL WIDTH)                              -->
    <!-- ==========================================================    <!-- ============================================================ -->
    <!-- DIGNITARIES & UPDATES SIDE-BY-SIDE SECTION                     -->
    <!-- ========================================================    <!-- ============================================================ -->
    <!-- WELCOME, TENDERS & NOTIFICATIONS (3-COLUMN LAYOUT)            -->
    <!-- ============================================================ -->
    <section class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-10 gap-6 items-stretch">
      
      <!-- LEFT COLUMN: WELCOME TO JKSPDC (40% width = 4 cols) -->
      <div class="md:col-span-2 lg:col-span-4 flex flex-col">
        <!-- Section Header -->
        <div class="text-left mb-4 flex-shrink-0">
          <span class="inline-block text-[10px] uppercase tracking-[0.12em] text-[#1B3A6B] font-bold bg-transparent px-3 py-1 rounded-full border border-[#1B3A6B] mb-2.5">Corporate Overview</span>
          <h2 class="text-lg xl:text-xl font-extrabold text-[#1B2A41]">
            Welcome to <span class="text-[#0B4F9C]">JKSPDCL</span>
          </h2>
          <div class="w-10 h-0.5 bg-[#D8681B] mt-2.5 rounded-full"></div>
        </div>

        <!-- Welcome Card Container -->
        <div class="bg-white border border-[#BDD7EE]/60 rounded-2xl p-6 flex flex-col justify-between flex-grow h-[320px] shadow-sm">
          <p class="text-slate-600 text-xs lg:text-[13px] leading-relaxed text-left">
            Electricity is an essential source of commercial energy. It is vital for sustained economic growth. An increase in demand for power implies growth of the economy leading to modernization, industrialization and improvement in basic amenities culminating into a better quality of life of people.
          </p>
          <a href="/about-us/explore/overview" class="inline-flex items-center gap-2 bg-[#0C58B6] hover:bg-[#084A8F] text-white font-semibold px-5 py-2.5 rounded-lg text-xs transition-colors shadow-sm self-start mt-4">
            Read More &raquo;
          </a>
        </div>
      </div>

      <!-- MIDDLE COLUMN: TENDERS & BIDS (30% width = 3 cols) -->
      <div class="md:col-span-1 lg:col-span-3 flex flex-col">
        <!-- Section Header -->
        <div class="text-left mb-4 flex-shrink-0">
          <span class="inline-block text-[10px] uppercase tracking-[0.12em] text-[#1B3A6B] font-bold bg-transparent px-3 py-1 rounded-full border border-[#1B3A6B] mb-2.5">Procurement</span>
          <h2 id="tenders-heading" class="text-lg xl:text-xl font-extrabold text-[#1B2A41]">Tenders</h2>
          <div class="w-10 h-0.5 bg-[#D8681B] mt-2.5 rounded-full"></div>
        </div>

        <!-- Tenders Card Container -->
        <div class="bg-white border border-[#BDD7EE]/60 rounded-2xl overflow-hidden flex flex-col justify-between flex-grow h-[320px] shadow-sm">
          <div class="relative flex-grow overflow-hidden px-4 py-3">
            <div class="absolute left-0 right-0 top-0 h-4 bg-gradient-to-b from-[#ffffff] to-transparent z-10 pointer-events-none"></div>
            <div class="absolute left-0 right-0 bottom-0 h-4 bg-gradient-to-t from-[#ffffff] to-transparent z-10 pointer-events-none"></div>

            <div class="scroll-track animate-marquee-vertical flex flex-col gap-2.5" style={`--marquee-duration: ${displayTenders.length * 8}s`}>
              {displayTenders.map((tender: any) => {
                const docUrl = getDocUrl(tender.documentUrl) || `/stakeholders/vendors/tender-details?id=${tender.id}`;
                return (
                  <a href={docUrl} target="_blank" rel="noopener noreferrer" class="block p-3 bg-slate-50/50 border border-slate-200/60 hover:border-[#0B4F9C]/35 rounded-lg shadow-xs text-left transition-all duration-150">
                    <div class="text-[10px] text-[#0C58B6] font-bold mb-1 flex items-center gap-1">
                      <span>📅</span>
                      <span>{formatRefDate(tender.publishDate)}</span>
                    </div>
                    <h4 class="font-bold text-slate-800 text-xs leading-snug line-clamp-2">
                      {tender.title}
                    </h4>
                  </a>
                );
              })}
              {/* Duplicate for marquee */}
              {displayTenders.map((tender: any) => {
                const docUrl = getDocUrl(tender.documentUrl) || `/stakeholders/vendors/tender-details?id=${tender.id}`;
                return (
                  <a href={docUrl} target="_blank" rel="noopener noreferrer" tabindex="-1" aria-hidden="true" class="block p-3 bg-slate-50/50 border border-slate-200/60 hover:border-[#0B4F9C]/35 rounded-lg shadow-xs text-left transition-all duration-150">
                    <div class="text-[10px] text-[#0C58B6] font-bold mb-1 flex items-center gap-1">
                      <span>📅</span>
                      <span>{formatRefDate(tender.publishDate)}</span>
                    </div>
                    <h4 class="font-bold text-slate-800 text-xs leading-snug line-clamp-2">
                      {tender.title}
                    </h4>
                  </a>
                );
              })}
            </div>
          </div>
