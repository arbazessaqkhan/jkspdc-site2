function getCleanDesc(htmlStr) {
  if (!htmlStr) return "Hydel power station operated by JKSPDC under state/central sector.";
  const clean = htmlStr.replace(/<\/?[^>]+(>|$)/g, "").replace(/\s+/g, " ").trim();
  if (clean.length > 180) {
    return clean.substring(0, 180) + "...";
  }
  return clean;
}

