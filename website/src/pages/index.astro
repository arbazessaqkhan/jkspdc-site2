    <div id="hero-slides" class="absolute inset-0">
      {heroSlides.map((slide, i) => (
        <div id={`slide-${slide.id}`} class={`absolute inset-0 transition-opacity duration-500 ${i === 0 ? 'opacity-100 z-10' : 'opacity-0 z-0 pointer-events-none'}`}>
          <img src={slide.img} alt={slide.title} class="absolute inset-0 w-full h-full object-cover" fetchpriority={i === 0 ? 'high' : 'auto'} loading={i === 0 || i === 1 || i === heroSlides.length - 1 ? 'eager' : 'lazy'} onerror="this.onerror=null; this.src='/slider1.jpg';" />
          <div class="absolute inset-0 bg-gradient-to-r from-black/40 via-black/20 to-transparent z-10"></div>
          <div class="absolute inset-0 bg-gradient-to-t from-black/25 via-transparent to-transparent z-10"></div>

          <!-- Slide Content -->
          <div class="absolute inset-0 z-20 flex items-center">
            <div class="w-full max-w-7xl mx-auto px-6 sm:px-8 lg:px-10">
              <div class="grid grid-cols-1 md:grid-cols-5 gap-6 sm:gap-8 items-center">
                <!-- Left: Title, Desc, Buttons -->
