  if (p.documentUrl && p.documentUrl.trim() !== '') {
    if (p.documentUrl.startsWith('/uploads/')) {
      img = `http://localhost:3000${p.documentUrl}`;
    } else {
      img = p.documentUrl;
    }
  } else if (slug === 'ganderbal' || slug === 'ushp-i' || slug === 'sewa-iii') {
    img = `/projects/${slug}.png`;
