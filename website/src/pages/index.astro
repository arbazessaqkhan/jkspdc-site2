            <span class="inline-flex items-center gap-1.5"><span class="w-2 h-2 rounded-full bg-amber-500"></span> {displayProjects.filter((p: any) => p.status === 'Under Construction').length} Under Construction</span>
            <span class="text-slate-300">•</span>
            <span class="inline-flex items-center gap-1.5"><span class="w-2 h-2 rounded-full bg-sky-500"></span> {displayProjects.filter((p: any) => p.status === 'Upcoming').length} Upcoming</span>
          </div>
        </div>

        <!-- Unified Filters + Search Control Bar -->
        <div class="bg-slate-50/80 border border-slate-200/85 rounded-lg p-2 shadow-2xs flex flex-col md:flex-row md:items-center md:justify-between gap-2.5 mb-8">
          <div class="inline-flex w-full md:w-fit overflow-x-auto flex-nowrap items-center gap-1 rounded-md bg-slate-200/70 p-1" role="tablist" aria-label="Project Categories">
            {['All', 'Operational', 'Under Construction', 'Upcoming'].map((tab) => (
              <button 
                type="button" 
                role="tab" 
                aria-selected={tab === 'All' ? 'true' : 'false'} 
                data-tab={tab} 
                class={`project-tab px-3.5 py-1.5 text-sm font-semibold whitespace-nowrap transition-all rounded-md shrink-0 cursor-pointer ${tab === 'All' ? 'bg-[#0B3D6B] text-white shadow-xs' : 'text-slate-700 hover:text-slate-900 hover:bg-white/70'}`}
              >
                {tab === 'All' ? 'All Projects' : tab}
              </button>
            ))}
          </div>
          <div class="relative w-full md:w-72">
            <span class="absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 flex items-center pointer-events-none">
              <Icon name="search" size={14} strokeWidth={2} />
            </span>
            <input 
              id="project-search" 
              type="text" 
              placeholder="Search projects…" 
              class="w-full md:w-72 h-9 bg-white border border-slate-200 rounded-md pl-9 pr-3.5 text-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#0B3D6B]/40 transition-colors" 
              aria-label="Search projects by name, river basin, or location"
            />
          </div>
        </div>

        <!-- Project Cards Grid -->
        <div id="projects-grid" class={displayProjects.length > 0 ? "grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5 items-stretch" : "hidden"}>
          {displayProjects.map((p) => {
            const statusBadgeClass = p.status === 'Operational'
              ? 'bg-emerald-50 text-emerald-800 border border-emerald-200'
              : p.status === 'Under Construction'
              ? 'bg-amber-50 text-amber-800 border border-amber-200'
              : 'bg-sky-50 text-sky-800 border border-sky-200';
            const topBorderClass = p.status === 'Operational'
              ? 'border-t-emerald-600'
              : p.status === 'Under Construction'
              ? 'border-t-amber-500'
              : 'border-t-[#0B3D6B]';
            const statusDotClass = p.status === 'Operational'
              ? 'bg-emerald-600'
              : p.status === 'Under Construction'
              ? 'bg-amber-500'
              : 'bg-[#0B3D6B]';
            const capVal = p.capacityMw ? `${p.capacityMw} MW` : null;
            const unitsVal = p.configuration ? String(p.configuration).trim() : null;
            const typeVal = p.type || 'Hydro';
            const codVal = p.yearOfCommissioning ? String(p.yearOfCommissioning).trim() : null;
            return (
              <a 
                href={`/our-business/power-station-details?id=${p.id}`} 
                class={`project-card group relative bg-white border border-slate-200/90 border-t-[3px] ${topBorderClass} rounded-lg shadow-xs hover:shadow-md hover:-translate-y-0.5 hover:border-[#0B3D6B]/50 transition-all duration-200 flex flex-col h-full overflow-hidden focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#0B3D6B]`} 
                data-status={p.status} 
                data-type={p.type} 
                data-name={p.name.toLowerCase()} 
                data-search={`${p.name} ${formatProjectName(p.name)} ${p.location || ''} ${p.basin || ''} ${p.type || ''} ${p.status}`.toLowerCase()}
              >
                <div class="p-5 flex-1 flex flex-col">
                  <!-- Compact, Aligned Header Block -->
                  <div class="min-h-[76px] flex flex-col">
                    <span class={`inline-flex w-fit items-center gap-1.5 text-[10px] font-bold uppercase tracking-wider px-2 py-0.5 rounded mb-2 ${statusBadgeClass}`}>
                      <span class={`w-1.5 h-1.5 rounded-full ${statusDotClass}`}></span>
                      {p.status}
                    </span>

                    <h3 class="text-[15px] font-bold text-slate-900 group-hover:text-[#0B3D6B] transition-colors leading-snug line-clamp-2">
                      {formatProjectName(p.name)}
                    </h3>

                    {(p.location || p.basin) && (
                      <p class="text-xs text-slate-500 mt-1 truncate">
                        {p.location}{p.location && p.basin ? ' • ' : ''}{p.basin ? (p.basin.toLowerCase().includes('basin') ? p.basin : `${p.basin} Basin`) : ''}
                      </p>
                    )}
                  </div>

                  <!-- Dynamic Specs Box (hides empty Units/Target dashes gracefully) -->
                  <dl class="grid grid-cols-2 gap-x-3 gap-y-2.5 bg-slate-50/90 border border-slate-200/70 rounded-md p-3.5 mt-3.5">
                    {capVal && (
                      <div>
                        <dt class="text-[10px] font-semibold uppercase tracking-wider text-slate-500">Capacity</dt>
                        <dd class="text-[13px] font-bold text-[#0B3D6B] leading-tight truncate tabular-nums mt-0.5" title={capVal}>{capVal}</dd>
                      </div>
                    )}
                    <div>
                      <dt class="text-[10px] font-semibold uppercase tracking-wider text-slate-500">Type</dt>
                      <dd class="text-[13px] font-bold text-slate-900 leading-tight truncate mt-0.5" title={typeVal}>{typeVal}</dd>
                    </div>
                    {unitsVal && (
                      <div>
                        <dt class="text-[10px] font-semibold uppercase tracking-wider text-slate-500">Units</dt>
                        <dd class="text-[13px] font-bold text-slate-900 leading-tight truncate tabular-nums mt-0.5" title={unitsVal}>{unitsVal}</dd>
                      </div>
                    )}
                    {codVal && (
                      <div>
                        <dt class="text-[10px] font-semibold uppercase tracking-wider text-slate-500">{p.status === 'Operational' ? 'COD' : 'Target'}</dt>
                        <dd class="text-[13px] font-bold text-slate-900 leading-tight truncate tabular-nums mt-0.5" title={codVal}>{codVal}</dd>
                      </div>
                    )}
                  </dl>
                </div>

                <!-- Matching Card Footer -->
                <div class="mt-auto px-5 py-3 border-t border-slate-100 bg-slate-50/50 flex items-center justify-between text-xs font-semibold text-[#0B3D6B]">
                  <span class="group-hover:underline">View Details</span>
                  <span class="transition-transform group-hover:translate-x-0.5" aria-hidden="true">&rarr;</span>
                </div>
              </a>
            );
          })}
        </div>

        {displayProjects.length === 0 && (
          <div class="py-12 px-6 text-center max-w-lg mx-auto">
            <div class="w-10 h-10 rounded-full bg-slate-100 text-slate-500 border border-slate-200 flex items-center justify-center mx-auto mb-2.5">
              <Icon name="building" size={18} />
            </div>
            <p class="text-sm font-bold text-slate-700">No power projects catalogued yet</p>
            <p class="text-xs text-slate-500 mt-1 leading-relaxed">
              Hydroelectric and renewable power stations will appear here once added in the administrative portal.
            </p>
          </div>
        )}

        <!-- Compact Empty State for Category with Zero Records -->
        <div id="project-empty-category" class="hidden py-12 px-6 text-center max-w-lg mx-auto">
          <div class="w-10 h-10 rounded-full bg-slate-100 text-slate-500 border border-slate-200 flex items-center justify-center mx-auto mb-2.5">
            <Icon name="building" size={18} />
          </div>
          <p class="text-sm font-bold text-slate-700">No projects currently under construction</p>
          <p class="text-xs text-slate-500 mt-1 leading-relaxed">
            Hydroelectric projects in survey, detailed project report (DPR) formulation, and statutory clearances are catalogued under Upcoming Projects.
          </p>
        </div>

        <!-- Empty State for Search Filter with Zero Matches -->
        <div id="project-empty-search" class="hidden py-12 px-6 text-center max-w-md mx-auto">
          <div class="w-10 h-10 rounded-full bg-slate-100 text-slate-400 border border-slate-200 flex items-center justify-center mx-auto mb-2.5">
            <Icon name="search" size={18} />
          </div>
          <p class="text-sm font-bold text-slate-700">No projects found</p>
          <p class="text-xs text-slate-500 mt-1">Try adjusting your search keywords or switching category tabs.</p>
        </div>

        <!-- View All Action Footer -->
        {displayProjects.length > 0 && (
          <div id="project-footer-bar" class="mt-10 pt-6 border-t border-slate-200 flex flex-col sm:flex-row items-center justify-between gap-4">
            <p id="project-count-text" class="text-sm font-medium text-slate-600">Showing {Math.min(6, displayProjects.length)} of {displayProjects.length} projects</p>
            <div class="flex flex-wrap items-center justify-center sm:justify-end gap-3">
              <a 
                id="project-view-all-btn" 
                href="#projects" 
                class="h-11 px-5 rounded-md text-sm font-semibold inline-flex items-center justify-center gap-2 whitespace-nowrap transition-colors bg-[#0B3D6B] text-white hover:bg-[#082E52] shadow-xs focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#0B3D6B] cursor-pointer"
              >
                View More &darr;
              </a>
            </div>
          </div>
        )}
      </div>
    </section>



    <!-- ============================================================ -->
    <!-- QUICK ACCESS GRID                                             -->
    <!-- ============================================================ -->
    <section aria-labelledby="quick-access-heading" class="text-left bg-slate-50 border-b border-slate-200 py-12 lg:py-16">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <!-- Section Header -->
        <div class="text-left mb-8 flex-shrink-0">
          <span class="inline-block text-xs font-semibold tracking-wider uppercase text-[#0B3D6B]">QUICK ACCESS</span>
          <h2 id="quick-access-heading" class="text-2xl sm:text-3xl font-bold text-slate-900 mt-1">Navigate the Corporation</h2>
          <div class="w-10 h-0.5 bg-[#0B3D6B] mt-2.5"></div>
          <p class="text-sm text-slate-500 max-w-2xl leading-relaxed mt-2">One-click access to the most-used services and information across the corporation.</p>
        </div>

        <!-- 10-Item 5-Column Grid -->
        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-4">
          {quickLinks.map((link) => (
            <a 
              href={link.href} 
              class="group bg-white border border-slate-200/90 border-t-[3px] !border-t-[#0B3D6B] rounded-lg p-4 shadow-xs hover:shadow-md hover:-translate-y-0.5 hover:border-[#0B3D6B]/50 transition-all duration-200 flex flex-col justify-between gap-3 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#0B3D6B]"
            >
              <div class="flex items-center justify-between gap-2">
                <div class="w-10 h-10 rounded-lg bg-[#0B3D6B]/10 text-[#0B3D6B] group-hover:bg-[#0B3D6B] group-hover:text-white flex items-center justify-center shrink-0 transition-colors">
                  <Icon name={link.icon} size={18} strokeWidth={2} class="w-[18px] h-[18px]" />
                </div>
                <span class="text-sm text-slate-400 group-hover:text-[#0B3D6B] group-hover:translate-x-0.5 transition-all" aria-hidden="true">&rarr;</span>
              </div>
              <div class="min-w-0">
                <div class="text-sm font-bold text-slate-900 group-hover:text-[#0B3D6B] leading-snug transition-colors">{link.label}</div>
                <div class="text-[11.5px] text-slate-500 leading-snug mt-1">{link.desc}</div>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- ============================================================ -->
    <!-- QUICK LINKS LOGO DIRECTORY SECTION                            -->
    <!-- ============================================================ -->
    <section id="quick-links-section" aria-labelledby="marquee-heading" class="text-center bg-white border-b border-slate-200 py-12 lg:py-16">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <!-- Centered Section Header -->
        <div class="text-center mb-8 flex-shrink-0">
          <span class="inline-block text-xs font-semibold tracking-wider uppercase text-[#0B3D6B]">GOVERNMENT &amp; REGULATORY PORTALS</span>
          <h2 id="marquee-heading" class="text-2xl sm:text-3xl font-bold text-slate-900 mt-1">Important Quick Links</h2>
          <div class="w-10 h-0.5 bg-[#0B3D6B] mt-2.5 mx-auto"></div>
        </div>

        <!-- Centered Government Portal Grid (4 on top, 3 centered at bottom) -->
        <div class="flex flex-wrap justify-center gap-4">
          {[
            { name: "Central Electricity Authority", domain: "cea.nic.in", href: "https://cea.nic.in/", logo: "/logos/cea.webp" },
            { name: "Ministry of Environment & Forests", domain: "moef.gov.in", href: "https://moef.gov.in/", logo: "/logos/moef.png" },
            { name: "National Portal of India", domain: "india.gov.in", href: "https://www.india.gov.in/", logo: "/logos/india.svg" },
            { name: "Ministry of New & Renewable Energy", domain: "mnre.gov.in", href: "https://mnre.gov.in/", logo: "/logos/mnre.svg" },
            { name: "Power Development Dept (J&K)", domain: "pdd.jk.gov.in", href: "https://pdd.jk.gov.in/", logo: "/logos/pdd.svg" },
            { name: "Central Water Commission", domain: "cwc.gov.in", href: "https://cwc.gov.in/", logo: "/logos/cwc.png" },
            { name: "J&K Electricity Regulatory Commission", domain: "jercjkl.jk.gov.in", href: "https://jercjkl.jk.gov.in/AboutUs.html", logo: "/logos/jerc.png" },
          ].map((portal) => (
            <a 
              href={portal.href} 
              target="_blank" 
              rel="noopener noreferrer" 
              title={`${portal.name} (opens in new tab)`}
              class="group bg-white border border-slate-200/90 border-t-[3px] !border-t-[#0B3D6B] rounded-lg shadow-xs hover:shadow-md hover:-translate-y-0.5 hover:border-[#0B3D6B]/50 transition-all duration-200 flex flex-col overflow-hidden w-full sm:w-[calc(50%-0.5rem)] md:w-[calc(33.333%-0.7rem)] lg:w-[calc(25%-0.75rem)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#0B3D6B]"
            >
              <!-- Standardized Wide Emblem Band -->
              <div class="w-full h-16 bg-slate-50/80 border-b border-slate-100 px-4 py-2.5 flex items-center justify-center">
                <img src={portal.logo} alt={`${portal.name} Emblem`} class="max-h-10 max-w-full w-auto h-auto object-contain" />
              </div>
              <!-- Title -->
              <div class="px-4 py-3 flex-1 flex items-center justify-center text-center">
                <p class="text-xs sm:text-[13px] font-bold text-slate-900 group-hover:text-[#0B3D6B] leading-snug line-clamp-2 transition-colors">
                  {portal.name}
                </p>
              </div>
              <!-- Matching Domain Footer Strip -->
              <div class="mt-auto px-4 py-2 border-t border-slate-100 bg-slate-50/50 text-[11px] font-medium text-slate-500 group-hover:text-[#0B3D6B] flex items-center justify-center gap-1.5 transition-colors">
                <span class="truncate">{portal.domain}</span>
                <Icon name="external-link" size={11} strokeWidth={2.2} class="shrink-0" />
              </div>
              <span class="sr-only">(opens in new tab)</span>
            </a>
          ))}
        </div>
      </div>
    </section>

  </div>
  <!-- end page body -->

</Layout>

<script is:inline>
(function () {
  /* ── HERO CAROUSEL (admin-managed timing) ────────────────── */
  var heroSection = document.getElementById('home');
  var heroContainer = document.getElementById('hero-slides');
  var slideEls = heroContainer ? Array.from(heroContainer.children) : [];
  var total = slideEls.length;
  var cur = 0;
  var heroTimer = null;
  var heroMs = parseInt(heroSection && heroSection.dataset.heroDuration, 10);
  if (!heroMs || isNaN(heroMs)) heroMs = 3000;
  var heroAutoplay = !heroSection || heroSection.dataset.heroAutoplay !== 'false';
  var heroIndicators = Array.from(document.querySelectorAll('[data-hero-indicator]'));

  function updateIndicators(activeIndex) {
    if (!heroIndicators || heroIndicators.length === 0) return;
    heroIndicators.forEach(function (ind, idx) {
      if (idx === activeIndex) {
        ind.classList.remove('w-3.5', 'bg-white/50', 'hover:bg-white/85');
        ind.classList.add('w-8', 'bg-white', 'shadow-sm');
        ind.setAttribute('aria-current', 'true');
      } else {
        ind.classList.remove('w-8', 'bg-white', 'shadow-sm');
        ind.classList.add('w-3.5', 'bg-white/50', 'hover:bg-white/85');
        ind.removeAttribute('aria-current');
      }
    });
  }

  function goTo(n) {
    if (total <= 1) return;

    if (slideEls[cur]) {
      slideEls[cur].classList.remove('opacity-100', 'z-10');
      slideEls[cur].classList.add('opacity-0', 'z-0', 'pointer-events-none');
      slideEls[cur].setAttribute('aria-hidden', 'true');
    }

    cur = ((n % total) + total) % total;

    if (slideEls[cur]) {
      var img = slideEls[cur].querySelector('img');
      if (img && img.loading === 'lazy') {
        img.loading = 'eager';
      }
      slideEls[cur].classList.remove('opacity-0', 'z-0', 'pointer-events-none');
      slideEls[cur].classList.add('opacity-100', 'z-10');
      slideEls[cur].removeAttribute('aria-hidden');
    }

    updateIndicators(cur);
  }

  function stopHeroTimer() {
    if (heroTimer) {
      clearInterval(heroTimer);
      heroTimer = null;
    }
  }

  function startHeroTimer() {
    stopHeroTimer();
    if (!heroAutoplay || total <= 1) return;
    heroTimer = setInterval(function () {
      goTo(cur + 1);
    }, heroMs);
  }

  var prev = document.getElementById('hero-prev');
  if (prev) {
    prev.onclick = function (e) {
      if (e) e.preventDefault();
      goTo(cur - 1);
      startHeroTimer();
    };
  }

  var next = document.getElementById('hero-next');
  if (next) {
    next.onclick = function (e) {
      if (e) e.preventDefault();
      goTo(cur + 1);
      startHeroTimer();
    };
  }

  heroIndicators.forEach(function (ind, idx) {
    ind.onclick = function (e) {
      if (e) e.preventDefault();
      goTo(idx);
      startHeroTimer();
    };
  });

  startHeroTimer();

  /* ── OFFICE GALLERY CAROUSEL (Top Section) ───────────────── */
  var oSlides = document.querySelectorAll('.office-slide');
  var oTotal = oSlides.length;
  var oCur = 0, oDots = document.querySelectorAll('[data-office-dot]');
  var oContainer = document.getElementById('office-carousel-container');
  var oMs = parseInt(oContainer && oContainer.dataset.overviewDuration, 10);
  if (!oMs || isNaN(oMs)) oMs = 5000;
  var oAutoplay = !oContainer || oContainer.dataset.overviewAutoplay !== 'false';

  function goToOffice(n) {
    if (oTotal === 0) return;
    if (oSlides[oCur]) {
      oSlides[oCur].classList.replace('opacity-100', 'opacity-0');
      oSlides[oCur].classList.replace('z-10', 'z-0');
    }
    if (oDots[oCur]) {
      oDots[oCur].className = 'w-1.5 h-1.5 transition-all duration-300 bg-white/50';
    }
    oCur = ((n % oTotal) + oTotal) % oTotal;
    if (oSlides[oCur]) {
      oSlides[oCur].classList.replace('opacity-0', 'opacity-100');
      oSlides[oCur].classList.replace('z-0', 'z-10');
    }
    if (oDots[oCur]) {
      oDots[oCur].className = 'w-1.5 h-1.5 transition-all duration-300 bg-white w-3';
    }
  }

  var oPrev = document.getElementById('office-prev');
  if (oPrev) oPrev.onclick = function() { goToOffice(oCur - 1); };
  var oNext = document.getElementById('office-next');
  if (oNext) oNext.onclick = function() { goToOffice(oCur + 1); };
  oDots.forEach(function(d) {
    d.onclick = function() { goToOffice(parseInt(d.dataset.officeDot, 10)); };
  });
  if (oAutoplay && oTotal > 1) {
    setInterval(function() { goToOffice(oCur + 1); }, oMs);
  }

  /* ── PROJECT GALLERY CAROUSEL (About Us Section) ─────────── */
  var pSlides = document.querySelectorAll('.project-slide');
  var pTotal = pSlides.length;
  var pCur = 0, pDots = document.querySelectorAll('[data-project-dot]');

  function goToProject(n) {
    if (pTotal === 0) return;
    if (pSlides[pCur]) {
      pSlides[pCur].classList.replace('opacity-100', 'opacity-0');
      pSlides[pCur].classList.replace('z-10', 'z-0');
    }
    if (pDots[pCur]) {
      pDots[pCur].className = 'w-2 h-2 transition-all duration-300 bg-white/50';
    }
    pCur = ((n % pTotal) + pTotal) % pTotal;
    if (pSlides[pCur]) {
      pSlides[pCur].classList.replace('opacity-0', 'opacity-100');
      pSlides[pCur].classList.replace('z-0', 'z-10');
    }
    if (pDots[pCur]) {
      pDots[pCur].className = 'w-2 h-2 transition-all duration-300 bg-white w-4';
    }
  }

  var pPrev = document.getElementById('project-prev');
  if (pPrev) pPrev.onclick = function() { goToProject(pCur - 1); };
  var pNext = document.getElementById('project-next');
  if (pNext) pNext.onclick = function() { goToProject(pCur + 1); };
  pDots.forEach(function(d) {
    d.onclick = function() { goToProject(parseInt(d.dataset.projectDot, 10)); };
  });
  setInterval(function() { goToProject(pCur + 1); }, 5500);

  /* ── PROJECT FILTER & CATEGORY PREVIEW ───────────────────── */
  var cards = Array.from(document.querySelectorAll('.project-card'));
  var tabBtns = Array.from(document.querySelectorAll('.project-tab'));
  var searchEl = document.getElementById('project-search');
  var projectsGrid = document.getElementById('projects-grid');
  var emptyCategoryEl = document.getElementById('project-empty-category');
  var emptySearchEl = document.getElementById('project-empty-search');
  var viewAllBtn = document.getElementById('project-view-all-btn');
  var projectCountEl = document.getElementById('project-count-text');
  var projectFooterBar = document.getElementById('project-footer-bar');

  var PREVIEW_LIMIT = 6;
  var isExpandedAll = false;

  var categoryNav = {
    'All': {
      text: function() {
        return isExpandedAll 
          ? 'Show Less ↑' 
          : 'View More ↓';
      },
      href: '#projects'
    },
    'Operational': {
      text: function() { return 'View More →'; },
      href: '/our-business/power-stations'
    },
    'Under Construction': {
      text: function() { return 'View More →'; },
      href: '/our-business/construction'
    },
    'Upcoming': {
      text: function() { return 'View More →'; },
      href: '/our-business/under-development'
    }
  };

  var activeTab = 'All';

  // Read URL query param if present (e.g. ?status=operational or ?status=upcoming)
  var urlParams = new URLSearchParams(window.location.search);
  var statusParam = urlParams.get('status');
  if (statusParam) {
    var cleanStatus = statusParam.trim().toLowerCase().replace(/[-_]/g, ' ');
    if (cleanStatus === 'operational') activeTab = 'Operational';
    else if (cleanStatus === 'under construction') activeTab = 'Under Construction';
    else if (cleanStatus === 'upcoming') activeTab = 'Upcoming';
    else if (cleanStatus === 'all') activeTab = 'All';
  }

  function updateTabUI() {
    tabBtns.forEach(function(btn) {
      var isCurrent = btn.dataset.tab === activeTab;
      if (isCurrent) {
        btn.className = 'project-tab px-3.5 py-2 text-sm font-semibold whitespace-nowrap transition-all rounded-md bg-[#0B3D6B] text-white shadow-xs';
        btn.setAttribute('aria-selected', 'true');
      } else {
        btn.className = 'project-tab px-3.5 py-2 text-sm font-semibold whitespace-nowrap transition-all rounded-md text-slate-700 hover:text-slate-900 hover:bg-white/60';
        btn.setAttribute('aria-selected', 'false');
      }
    });

    if (viewAllBtn && categoryNav[activeTab]) {
      viewAllBtn.textContent = categoryNav[activeTab].text();
      viewAllBtn.setAttribute('href', categoryNav[activeTab].href);
      if (activeTab === 'All') {
        viewAllBtn.className = 'h-11 px-5 rounded-md text-sm font-semibold inline-flex items-center justify-center gap-2 whitespace-nowrap transition-colors bg-[#0B3D6B] text-white hover:bg-[#082E52] shadow-xs focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#0B3D6B] cursor-pointer';
      } else {
        viewAllBtn.className = 'h-11 px-5 rounded-md text-sm font-semibold inline-flex items-center justify-center gap-2 whitespace-nowrap transition-colors bg-white text-[#0B3D6B] border border-[#0B3D6B] hover:bg-[#0B3D6B]/5 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#0B3D6B] cursor-pointer';
      }
    }
  }

  function filterProjects() {
    var q = searchEl ? searchEl.value.trim().toLowerCase() : '';

    // Filter projects belonging strictly to active category
    var categoryCards = cards.filter(function(c) {
      return activeTab === 'All' || c.dataset.status === activeTab;
    });

    // Zero records in category: only show category-specific empty state if projects exist overall
    // AND the user actively selected a specific category tab that has 0 matching items (e.g. Under Construction).
    // If all projects count (cards.length) is 0, keep emptyCategoryEl hidden so ONLY the main empty state shows.
    if (cards.length > 0 && categoryCards.length === 0) {
      if (projectsGrid) projectsGrid.style.display = 'none';
      if (emptyCategoryEl) {
        emptyCategoryEl.classList.remove('hidden');
        emptyCategoryEl.style.display = 'block';
      }
      if (emptySearchEl) {
        emptySearchEl.classList.add('hidden');
        emptySearchEl.style.display = 'none';
      }
      if (projectFooterBar) projectFooterBar.style.display = 'none';
      cards.forEach(function(c) { c.style.display = 'none'; });
      return;
    }

    if (emptyCategoryEl) {
      emptyCategoryEl.classList.add('hidden');
      emptyCategoryEl.style.display = 'none';
    }

    // If total projects are 0, do nothing further to prevent interfering with main empty state
    if (cards.length === 0) {
      if (emptyCategoryEl) {
        emptyCategoryEl.classList.add('hidden');
        emptyCategoryEl.style.display = 'none';
      }
      if (emptySearchEl) {
        emptySearchEl.classList.add('hidden');
        emptySearchEl.style.display = 'none';
      }
      return;
    }

    // Match with search query if typed
    var matchedCards = categoryCards.filter(function(c) {
      if (!q) return true;
      var searchContent = c.dataset.search || (c.dataset.name + ' ' + (c.dataset.status || ''));
      return searchContent.toLowerCase().includes(q);
    });

    // Zero matches from search
    if (q && matchedCards.length === 0) {
      if (projectsGrid) projectsGrid.style.display = 'none';
      if (emptySearchEl) emptySearchEl.style.display = 'block';
      if (projectFooterBar) projectFooterBar.style.display = 'none';
      cards.forEach(function(c) { c.style.display = 'none'; });
      return;
    }

    if (emptySearchEl) emptySearchEl.style.display = 'none';
    if (projectsGrid) projectsGrid.style.display = '';
    if (projectFooterBar) projectFooterBar.style.display = '';

    // Show preview count when not searching and not expanded
    var shownCount = 0;
    var shouldLimit = !q && (!isExpandedAll || activeTab !== 'All');

    cards.forEach(function(c) {
      var isMatch = matchedCards.indexOf(c) !== -1;
      if (isMatch) {
        if (shouldLimit && shownCount >= PREVIEW_LIMIT) {
          c.style.display = 'none';
        } else {
          c.style.display = '';
          shownCount++;
        }
      } else {
        c.style.display = 'none';
      }
    });

    var totalCount = q ? matchedCards.length : categoryCards.length;
    if (projectCountEl) {
      projectCountEl.textContent = 'Showing ' + shownCount + ' of ' + totalCount + ' projects';
    }
  }

  if (viewAllBtn) {
    viewAllBtn.onclick = function(e) {
      if (activeTab === 'All') {
        e.preventDefault();
        isExpandedAll = !isExpandedAll;
        updateTabUI();
        filterProjects();
        if (!isExpandedAll) {
          document.getElementById('projects')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      }
    };
  }

  tabBtns.forEach(function(btn) {
    btn.onclick = function() {
      activeTab = btn.dataset.tab;
      isExpandedAll = false;
      updateTabUI();
      filterProjects();
    };
  });

  if (searchEl) {
    searchEl.oninput = filterProjects;
  }

  updateTabUI();
  filterProjects();
})();
</script>

<style is:global>
  /* Hero: responsive height via aspect-ratio, no fixed pixels, no CLS */
  .hero-section {
    aspect-ratio: 16 / 9;
    max-height: 540px;
    width: 100%;
  }
  @media (min-width: 768px) {
    .hero-section {
      aspect-ratio: 21 / 9;
    }
  }
  @media (min-width: 1280px) {
    .hero-section {
      aspect-ratio: 2 / 1;
      min-height: 480px;
    }
  }

  @keyframes marquee-vertical {
    0% {
      transform: translate3d(0, 0, 0);
    }
    100% {
      transform: translate3d(0, -50%, 0);
    }
  }

  .scroll-track {
    display: flex;
    flex-direction: column;
    gap: 12px;
    animation: marquee-vertical var(--marquee-duration, 25s) linear infinite !important;
    will-change: transform;
  }

  .scroll-track:hover {
    animation-play-state: paused !important;
  }


  /* ── HOME TENDERS & NOTIFICATIONS VERTICAL FEED WITH ZEBRA ROWS ── */
  @keyframes feed-vertical {
    0% {
      transform: translate3d(0, 140px, 0);
    }
    100% {
      transform: translate3d(0, calc(140px - 50%), 0);
    }
  }

  .feed-scroll-track {
    display: flex;
    flex-direction: column;
    animation-name: feed-vertical !important;
    animation-duration: var(--scroll-duration, 20s) !important;
    animation-timing-function: linear !important;
    animation-iteration-count: infinite !important;
    will-change: transform;
  }

  .feed-scroll-track:hover {
    animation-play-state: paused !important;
  }

  .feed-row {
    display: block;
    width: 100%;
    padding: 0.75rem 1rem;
    text-align: left;
    text-decoration: none;
    transition: background-color 0.15s ease, color 0.15s ease;
  }

  .feed-row:hover {
    background-color: #EAF4FF !important;
  }

</style>

<script is:inline>
  (function() {
    function ensureFeedRunning() {
      var tracks = document.querySelectorAll('.feed-scroll-track');
      tracks.forEach(function(t) {
        if (document.activeElement && t.contains(document.activeElement)) {
          document.activeElement.blur();
        }
        t.style.animationPlayState = 'running';
      });
    }

    document.addEventListener('astro:page-load', ensureFeedRunning);
    window.addEventListener('pageshow', ensureFeedRunning);
    window.addEventListener('focus', ensureFeedRunning);
    document.addEventListener('visibilitychange', function() {
      if (!document.hidden) {
        ensureFeedRunning();
      }
    });

    // Keyboard users: pause the feed while any link inside it has focus (GIGW)
    document.addEventListener('focusin', function(e) {
      var track = e.target.closest && e.target.closest('.feed-scroll-track, .scroll-track');
      if (track) { track.style.animationPlayState = 'paused'; }
    });
    document.addEventListener('focusout', function(e) {
      var track = e.target.closest && e.target.closest('.feed-scroll-track, .scroll-track');
      if (track && !(track.contains(document.activeElement))) {
        track.style.animationPlayState = 'running';
      }
    });
  })();
</script>

