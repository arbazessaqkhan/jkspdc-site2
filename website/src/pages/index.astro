                  <a href={notif.documentUrl} class="block p-2.5 bg-white border border-slate-200 hover:border-[#0B4F9C]/30 rounded-xl shadow-sm hover:shadow transition-all duration-200 text-left">
                    <h4 class="font-medium text-slate-800 text-[11px] leading-relaxed mb-1.5">{notif.title}</h4>
                    <div class="flex items-center gap-1.5 text-[9px] text-slate-450 font-bold">
                      <span>📅</span>
