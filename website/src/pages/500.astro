---
import Layout from '../layouts/Layout.astro';
---

<Layout 
  title="Server Error (500) - JKSPDC" 
  description="Internal server error encountered on the JKSPDC portal."
>
  <div class="space-y-0 max-w-5xl mx-auto">
    <!-- Premium Page Header Band -->
    <div class="page-header-band animate-fadeInUp">
      <nav class="breadcrumb-trail" aria-label="Breadcrumbs">
        <a href="/">Home</a>
        <span class="separator">/</span>
        <span class="current">500</span>
      </nav>
      <h1>Internal Server Error</h1>
      <p class="page-subtitle">Jammu &amp; Kashmir State Power Development Corporation Limited (JKSPDCL)</p>
    </div>

    <div class="bg-white rounded-xl border border-slate-200 shadow-sm p-8 md:p-12 text-center space-y-6">
      <div class="inline-block bg-red-50 text-red-700 text-6xl font-black px-6 py-3 rounded-full border border-red-200 shadow-inner">
        500
      </div>
      
      <h2 class="text-2xl font-extrabold text-slate-800">Internal Server Error</h2>
      <p class="text-sm text-slate-650 max-w-md mx-auto leading-relaxed">
        The server encountered an internal error or misconfiguration and was unable to complete your request. Please try again later.
      </p>

      <div class="flex justify-center gap-4 pt-2">
        <a href="/" class="btn-primary text-xs">Return Home</a>
        <a href="/about-us/others/contact" class="btn-outline text-xs">Report Issue</a>
      </div>
    </div>
  </div>
</Layout>
