---
import Layout from '../layouts/Layout.astro';
---

<Layout 
  title="Search Results - JKSPDC" 
  description="Search results and page index locator for the JKSPDC portal."
>
  <div class="space-y-6">
    <!-- Breadcrumbs -->
    <nav class="text-xs text-gray-500" aria-label="Breadcrumbs">
      <ol class="flex gap-2">
        <li><a href="/" class="hover:underline">Home</a></li>
        <li>/</li>
        <li><span class="font-semibold text-[#0B4F9C]">Search</span></li>
      </ol>
    </nav>

    <!-- Page Header -->
    <header class="border-b border-gray-200 pb-4">
      <h2 class="text-3xl font-extrabold text-[#0B4F9C]">Search Portal</h2>
      <p class="text-sm text-gray-600 mt-1">Locate records, announcements, and pages across the website.</p>
    </header>

    <!-- Search Form and Results -->
    <div class="space-y-6 max-w-3xl">
      <!-- Search Box -->
      <form id="search-form" class="flex gap-2" onsubmit="return false">
        <div class="flex-grow">
          <label for="search-input" class="sr-only">Search query</label>
          <input 
            type="search" 
            id="search-input" 
            class="form-input w-full text-base" 
            placeholder="Type search terms (e.g., Tenders, CSR)..." 
            required 
            aria-required="true"
          />
        </div>
        <button type="submit" class="btn-primary px-6 font-semibold">Search</button>
      </form>

      <!-- Results Info -->
      <div id="search-status" class="text-sm text-gray-600 font-semibold hidden" role="status"></div>

      <!-- Results Container -->
      <div id="results-list" class="space-y-4" aria-live="polite">
        <!-- JS injected items -->
      </div>
    </div>
  </div>

  <!-- Client-side search index query script -->
  <script>
    interface IndexItem {
      title: string;
      url: string;
      description: string;
    }

    const searchForm = document.getElementById('search-form') as HTMLFormElement;
    const searchInput = document.getElementById('search-input') as HTMLInputElement;
    const searchStatus = document.getElementById('search-status') as HTMLDivElement;
    const resultsList = document.getElementById('results-list') as HTMLDivElement;

    let searchIndex: IndexItem[] = [];

    // Fetch sitemap index
    async function loadIndex() {
      try {
        const response = await fetch('/search-index.json');
        if (response.ok) {
          searchIndex = await response.json();
          
          // Check query parameters immediately
          const params = new URLSearchParams(window.location.search);
          const query = params.get('q');
          if (query) {
            searchInput.value = query;
            performSearch(query);
          }
        }
      } catch (err) {
        console.error('Failed to load search index:', err);
      }
    }

    // Perform filter match
    function performSearch(query: string) {
      const cleanQuery = query.toLowerCase().trim();
      
      if (!cleanQuery) {
        resultsList.innerHTML = '';
        searchStatus.classList.add('hidden');
        return;
      }

      const matches = searchIndex.filter(item => 
        item.title.toLowerCase().includes(cleanQuery) || 
        item.description.toLowerCase().includes(cleanQuery)
      );

      // Render status info
      searchStatus.classList.remove('hidden');
      searchStatus.textContent = `Found ${matches.length} result(s) for "${query}"`;

      if (matches.length === 0) {
        resultsList.innerHTML = `
          <div class="bg-gray-50 border border-gray-200 text-gray-600 rounded-lg p-8 text-center text-sm shadow-sm">
            <p class="font-bold text-gray-800">No matching pages found</p>
            <p class="text-xs text-gray-500 mt-1">Try searching for other terms like "Tenders", "Board", or "CSR".</p>
          </div>
        `;
        return;
      }

      // Render search list
      resultsList.innerHTML = matches.map(item => {
        // Simple highlight function
        const titleRegex = new RegExp(`(${cleanQuery})`, 'gi');
        const highlightedTitle = item.title.replace(titleRegex, '<mark class="bg-yellow-100 text-gray-900 font-semibold px-0.5 rounded">$1</mark>');
        
        const descRegex = new RegExp(`(${cleanQuery})`, 'gi');
        const highlightedDesc = item.description.replace(descRegex, '<mark class="bg-yellow-100 text-gray-900 px-0.5 rounded">$1</mark>');

        return `
          <div class="card-static flex flex-col justify-between hover:border-gray-300 transition-colors">
            <div>
              <h3 class="font-bold text-base text-[#0B4F9C] hover:underline">
                <a href="${item.url}">${highlightedTitle}</a>
              </h3>
              <p class="text-xs text-gray-600 mt-1 leading-relaxed">${highlightedDesc}</p>
            </div>
            <div class="mt-2 text-[10px] text-gray-400 font-semibold tracking-wider">
              PATH: ${item.url}
            </div>
          </div>
        `;
      }).join('');
    }

    // Event listeners
    if (searchForm && searchInput) {
      searchForm.addEventListener('submit', () => {
        const query = searchInput.value.trim();
        performSearch(query);
        // Push state to browser history without reloading
        const cleanQuery = encodeURIComponent(query);
        window.history.replaceState(null, '', `/search?q=${cleanQuery}`);
      });

      searchInput.addEventListener('input', () => {
        const query = searchInput.value.trim();
        performSearch(query);
      });
    }

    // Load sitemap index on startup
    loadIndex();
  </script>
</Layout>
