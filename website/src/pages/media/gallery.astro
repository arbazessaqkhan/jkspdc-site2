---
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';

let galleryItems = [];
let errorMessage = '';

try {
  // Fetch from 127.0.0.1 to avoid local DNS/IPv6 connection failures
  const res = await fetch(`${import.meta.env.PUBLIC_API_BASE}/api/gallery`);
  if (res.ok) {
    galleryItems = await res.json();
  } else {
    errorMessage = 'Failed to load media records from the backend database.';
  }
} catch (e) {
  console.error('Error fetching gallery items:', e);
  errorMessage = 'Connection to administrative database failed. Displaying cached records.';
  galleryItems = [
    {
      id: 'gallery-seed-1',
      title: 'Signing of Implementation Agreement for Execution of Hydroelectric Projects NHPC Ltd. and JKSPDC',
      imageUrl: '/gallery/signing_agreement.png',
      partition: 'Official Events',
    },
    {
      id: 'gallery-seed-2',
      title: 'Retirement Ceremony of Executive Director Civil, JKSPDC',
      imageUrl: '/gallery/retirement_ed_civil.png',
      partition: 'Corporate',
    },
    {
      id: 'gallery-seed-3',
      title: 'Hydroelectric Power Infrastructure & Projects Overview',
      imageUrl: '/gallery/projects_gallery.jpg',
      partition: 'Projects',
    },
    {
      id: 'gallery-seed-4',
      title: 'Baglihar Hydro Electric Project (BHEP) Stage-I & II Dam Site',
      imageUrl: '/projects/bhep-i.jpg',
      partition: 'Projects',
    },
    {
      id: 'gallery-seed-5',
      title: 'Corporate HQ and Administrative Building, Srinagar & Jammu',
      imageUrl: '/slider2.jpg',
      partition: 'Corporate',
    },
    {
      id: 'gallery-seed-6',
      title: 'Official Executive Board Meeting & Review Conference',
      imageUrl: '/slider3.jpg',
      partition: 'Official Events',
    },
  ];
}

const uniquePartitions = [...new Set(galleryItems.map(item => item.partition).filter(Boolean))];

function getImageUrl(url: string) {
  if (!url) return '';
  if (url.startsWith('/uploads/')) {
    return `${import.meta.env.PUBLIC_API_BASE}${url}`;
  }
  return url;
}
---

<Layout 
  title="Photo & Media Gallery - Media" 
  description="Official photo and media gallery of JKSPDC power stations, corporate ceremonies, and infrastructure projects."
>
  <div class="space-y-8 max-w-7xl mx-auto px-4 sm:px-6">
    <!-- Premium Page Header Band -->
    <div class="page-header-band animate-fadeInUp">
      <nav class="breadcrumb-trail" aria-label="Breadcrumbs">
        <a href="/">Home</a>
        <span class="separator">/</span>
        <span>Media Center</span>
        <span class="separator">/</span>
        <span class="current">Gallery</span>
      </nav>
      <h1>Photo &amp; Media Gallery</h1>
      <p class="page-subtitle">Jammu &amp; Kashmir State Power Development Corporation Limited (JKSPDCL)</p>
    </div>

    <div class="animate-fadeInUp delay-200 space-y-6">
      {errorMessage && (
        <div class="mb-4">
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-semibold bg-amber-50 text-amber-800 border border-amber-200 rounded-lg">
            <Icon name="alert-triangle" size={14} class="text-amber-800 shrink-0" />
            <span>{errorMessage}</span>
          </span>
        </div>
      )}

      {galleryItems.length === 0 ? (
        <div class="bg-gray-50 border border-gray-200 text-gray-700 rounded-2xl p-12 text-center text-sm shadow-xs">
          <p class="font-bold text-gray-800 text-base mb-1">No media records found</p>
          <p class="text-xs text-gray-500">Official gallery records are currently being updated by the corporation.</p>
        </div>
      ) : (
        <!-- Main Gallery Container -->
        <div class="space-y-8">
          
          <!-- Filter Tabs & Real-Time Search Bar -->
          <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 pb-4 border-b border-slate-200">
            
            <!-- Category Filter Pills -->
            <div class="flex flex-wrap items-center gap-2" role="tablist" aria-label="Gallery category filters">
              <button 
                type="button"
                role="tab"
                aria-selected="true"
                class="gallery-filter-btn px-4 py-2 rounded-xl text-xs font-bold transition-all bg-[#0B4F9C] text-white shadow-xs border border-[#0B4F9C] cursor-pointer focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#0B4F9C]/50 flex items-center gap-2"
                data-partition="All"
              >
                <span>All Media</span>
                <span class="px-1.5 py-0.5 text-[10px] rounded-full bg-white/20 text-white font-extrabold" id="count-all">{galleryItems.length}</span>
              </button>

              {uniquePartitions.map(partition => {
                const count = galleryItems.filter(item => item.partition === partition).length;
                return (
                  <button 
                    type="button"
                    role="tab"
                    aria-selected="false"
                    class="gallery-filter-btn px-4 py-2 rounded-xl text-xs font-bold transition-all bg-white text-slate-700 hover:bg-slate-50 border border-slate-200 hover:border-slate-300 cursor-pointer focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#0B4F9C]/50 flex items-center gap-2"
                    data-partition={partition}
                  >
                    <span>{partition}</span>
                    <span class="px-1.5 py-0.5 text-[10px] rounded-full bg-slate-100 text-slate-600 font-extrabold">{count}</span>
                  </button>
                );
              })}
            </div>

            <!-- Quick Search Input -->
            <div class="relative w-full md:w-72 shrink-0">
              <input 
                type="text" 
                id="gallery-search" 
                placeholder="Search photos by title or keyword..." 
                autocomplete="off"
                class="w-full text-xs pl-9 pr-3 py-2 bg-white border border-slate-300 rounded-xl text-slate-800 placeholder-slate-400 focus:outline-none focus:border-[#0B4F9C] focus:ring-1 focus:ring-[#0B4F9C] transition-all"
              />
              <Icon name="search" size={16} class="text-slate-400 absolute left-3 top-1/2 -translate-y-1/2 pointer-events-none" />
            </div>
          </div>

          <!-- Professional Large Gallery Grid -->
          <div id="gallery-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8">
            {galleryItems.map((item, idx) => (
              <article 
                class="gallery-item-card group bg-white border border-slate-200/90 rounded-2xl overflow-hidden shadow-xs hover:shadow-xl hover:-translate-y-1.5 transition-all duration-300 flex flex-col cursor-pointer"
                data-partition={item.partition || 'General'}
                data-src={getImageUrl(item.imageUrl)}
                data-title={item.title}
                data-index={idx}
                tabindex="0"
                role="button"
                aria-label={`View photo: ${item.title}`}
              >
                <!-- Large Prominent Photo Preview -->
                <div class="relative w-full h-64 sm:h-72 overflow-hidden bg-slate-100">
                  <img 
                    src={getImageUrl(item.imageUrl)} 
                    alt={item.title} 
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 ease-out"
                    loading="lazy"
                  />
                  
                  <!-- Floating Category Pill -->
                  <div class="absolute top-3.5 left-3.5 z-10 pointer-events-none">
                    <span class="inline-flex items-center gap-1.5 px-3 py-1 text-[11px] font-bold rounded-full bg-white/95 backdrop-blur-md text-[#0B4F9C] shadow-sm border border-slate-100">
                      <span class="w-1.5 h-1.5 rounded-full bg-[#0B4F9C]"></span>
                      {item.partition || 'General'}
                    </span>
                  </div>

                  <!-- Floating Zoom / View Icon -->
                  <div class="absolute top-3.5 right-3.5 w-9 h-9 rounded-full bg-black/40 hover:bg-[#0B4F9C] backdrop-blur-md text-white flex items-center justify-center transition-all duration-200 opacity-90 group-hover:opacity-100 group-hover:scale-105 shadow-sm z-10" aria-hidden="true">
                    <Icon name="zoom-in" size={16} class="text-white" />
                  </div>

                  <!-- Hover Tint -->
                  <div class="absolute inset-0 bg-slate-900/10 opacity-0 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none"></div>
                </div>

                <!-- Structured Card Body -->
                <div class="p-5 sm:p-6 flex flex-col justify-between flex-1 bg-white border-t border-slate-100">
                  <div>
                    <h3 class="text-base sm:text-lg font-bold text-slate-800 group-hover:text-[#0B4F9C] transition-colors leading-snug line-clamp-2">
                      {item.title}
                    </h3>
                  </div>

                  <!-- Card Action Footer -->
                  <div class="mt-4 pt-4 border-t border-slate-100 flex items-center justify-between">
                    <span class="text-xs font-semibold text-slate-400 flex items-center gap-1.5">
                      <Icon name="image" size={16} class="text-slate-400" />
                      <span>JKSPDCL Media</span>
                    </span>
                  </div>
                </div>
              </article>
            ))}
          </div>

          <!-- Empty Search State -->
          <div id="no-gallery-results" class="hidden bg-slate-50 border border-slate-200 text-slate-700 rounded-2xl p-12 text-center shadow-xs">
            <div class="w-12 h-12 rounded-full bg-slate-200 text-slate-500 flex items-center justify-center mx-auto mb-3">
              <Icon name="image" size={24} class="text-slate-500" />
            </div>
            <p class="font-bold text-base text-slate-800">No matching photos found</p>
            <p class="text-xs text-slate-500 mt-1 max-w-sm mx-auto">Try clearing your search query or selecting a different category filter above.</p>
          </div>
          
        </div>
      )}

    </div>
  </div>

  <!-- Accessible Fullscreen Lightbox Modal -->
  <div 
    id="gallery-lightbox" 
    class="fixed inset-0 z-[9999] bg-slate-950/90 backdrop-blur-md hidden items-center justify-center p-4 sm:p-6" 
    role="dialog" 
    aria-modal="true" 
    aria-label="Image viewer"
  >
    <!-- Close button (WCAG compliant touch target) -->
    <button 
      id="lightbox-close" 
      class="absolute top-4 right-4 sm:top-6 sm:right-6 w-11 h-11 rounded-full bg-white/10 hover:bg-white/25 text-white text-2xl flex items-center justify-center transition-colors z-20 cursor-pointer focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white" 
      aria-label="Close image viewer"
    >
      &times;
    </button>

    <!-- Prev button -->
    <button 
      id="lightbox-prev" 
      class="absolute left-3 sm:left-6 top-1/2 -translate-y-1/2 w-12 h-12 rounded-full bg-white/15 hover:bg-white/30 text-white text-2xl flex items-center justify-center transition-all z-20 cursor-pointer shadow-lg focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white" 
      aria-label="Previous photo"
    >
      &#8249;
    </button>

    <!-- Next button -->
    <button 
      id="lightbox-next" 
      class="absolute right-3 sm:right-6 top-1/2 -translate-y-1/2 w-12 h-12 rounded-full bg-white/15 hover:bg-white/30 text-white text-2xl flex items-center justify-center transition-all z-20 cursor-pointer shadow-lg focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white" 
      aria-label="Next photo"
    >
      &#8250;
    </button>

    <!-- Main Lightbox Display Container -->
    <div class="relative max-w-5xl w-full flex flex-col items-center justify-center max-h-[92vh]">
      <div class="relative overflow-hidden rounded-2xl shadow-2xl bg-black/50 flex items-center justify-center border border-white/10">
        <img 
          id="lightbox-img" 
          src="" 
          alt="" 
          class="max-w-[88vw] max-h-[72vh] object-contain rounded-xl select-none" 
        />
      </div>

      <!-- Caption & Metadata Bar -->
      <div id="lightbox-caption" class="mt-4 text-center max-w-2xl px-4 text-white">
        <!-- Rendered via JavaScript -->
      </div>
    </div>
  </div>
</Layout>

<script>
  function initGallery() {
    const filterBtns = document.querySelectorAll('.gallery-filter-btn');
    const galleryCards = document.querySelectorAll('.gallery-item-card');
    const searchInput = document.getElementById('gallery-search') as HTMLInputElement | null;
    const noResults = document.getElementById('no-gallery-results');
    const lightbox = document.getElementById('gallery-lightbox');
    const lightboxImg = document.getElementById('lightbox-img') as HTMLImageElement | null;
    const lightboxCaption = document.getElementById('lightbox-caption');
    const lightboxClose = document.getElementById('lightbox-close');
    const lightboxPrev = document.getElementById('lightbox-prev');
    const lightboxNext = document.getElementById('lightbox-next');

    if (!galleryCards.length) return;

    let activePartition = 'All';
    let searchQuery = '';
    let visibleCards: HTMLElement[] = Array.from(galleryCards) as HTMLElement[];
    let currentGalleryIndex = 0;

    function applyFilters() {
      visibleCards = [];
      const term = searchQuery.toLowerCase().trim();

      galleryCards.forEach(card => {
        const el = card as HTMLElement;
        const partition = el.getAttribute('data-partition') || '';
        const title = (el.getAttribute('data-title') || '').toLowerCase();

        const matchesPartition = (activePartition === 'All' || partition === activePartition);
        const matchesSearch = !term || title.includes(term) || partition.toLowerCase().includes(term);

        if (matchesPartition && matchesSearch) {
          el.style.display = 'flex';
          visibleCards.push(el);
        } else {
          el.style.display = 'none';
        }
      });

      if (noResults) {
        noResults.classList.toggle('hidden', visibleCards.length > 0);
      }
    }

    function openLightbox(index: number) {
      if (!lightbox || visibleCards.length === 0) return;
      currentGalleryIndex = index;
      const targetCard = visibleCards[currentGalleryIndex];
      if (!targetCard) return;

      const src = targetCard.getAttribute('data-src') || '';
      const title = targetCard.getAttribute('data-title') || '';
      const partition = targetCard.getAttribute('data-partition') || 'General';

      if (lightboxImg) {
        lightboxImg.src = src;
        lightboxImg.alt = title;
      }

      if (lightboxCaption) {
        lightboxCaption.innerHTML = `
          <div class="flex items-center justify-center gap-2 mb-2">
            <span class="inline-flex items-center gap-1.5 px-3 py-0.5 text-[11px] uppercase tracking-wider font-extrabold bg-[#0B4F9C] text-white rounded-full shadow-xs">
              ${partition}
            </span>
            <span class="text-xs font-semibold text-slate-300">
              Photo ${currentGalleryIndex + 1} of ${visibleCards.length}
            </span>
          </div>
          <h4 class="text-white text-sm sm:text-base font-bold leading-snug drop-shadow-md">
            ${title}
          </h4>
        `;
      }

      lightbox.classList.remove('hidden');
      lightbox.classList.add('flex');
      document.body.style.overflow = 'hidden';
    }

    function closeLightbox() {
      if (!lightbox) return;
      lightbox.classList.remove('flex');
      lightbox.classList.add('hidden');
      document.body.style.overflow = '';
    }

    // Card click & keyboard interaction (Enter / Space)
    galleryCards.forEach(card => {
      const el = card as HTMLElement;
      el.addEventListener('click', () => {
        const idx = visibleCards.indexOf(el);
        if (idx !== -1) openLightbox(idx);
      });

      el.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          const idx = visibleCards.indexOf(el);
          if (idx !== -1) openLightbox(idx);
        }
      });
    });

    // Lightbox Controls
    if (lightboxClose) lightboxClose.onclick = closeLightbox;
    
    if (lightboxPrev) {
      lightboxPrev.onclick = (e) => {
        e.stopPropagation();
        const len = visibleCards.length;
        if (len > 0) openLightbox((currentGalleryIndex - 1 + len) % len);
      };
    }

    if (lightboxNext) {
      lightboxNext.onclick = (e) => {
        e.stopPropagation();
        const len = visibleCards.length;
        if (len > 0) openLightbox((currentGalleryIndex + 1) % len);
      };
    }

    if (lightbox) {
      lightbox.onclick = (e) => {
        if (e.target === lightbox) closeLightbox();
      };
    }

    document.addEventListener('keydown', (e) => {
      if (lightbox && !lightbox.classList.contains('hidden')) {
        if (e.key === 'Escape') closeLightbox();
        if (e.key === 'ArrowLeft' && lightboxPrev) (lightboxPrev as HTMLElement).click();
        if (e.key === 'ArrowRight' && lightboxNext) (lightboxNext as HTMLElement).click();
      }
    });

    // Partition Buttons
    filterBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        activePartition = btn.getAttribute('data-partition') || 'All';

        filterBtns.forEach(b => {
          b.setAttribute('aria-selected', 'false');
          b.classList.remove('bg-[#0B4F9C]', 'text-white', 'shadow-xs', 'border-[#0B4F9C]');
          b.classList.add('bg-white', 'text-slate-700', 'border-slate-200');
          const badge = b.querySelector('span:last-child');
          if (badge) {
            badge.classList.remove('bg-white/20', 'text-white');
            badge.classList.add('bg-slate-100', 'text-slate-600');
          }
        });

        btn.setAttribute('aria-selected', 'true');
        btn.classList.add('bg-[#0B4F9C]', 'text-white', 'shadow-xs', 'border-[#0B4F9C]');
        btn.classList.remove('bg-white', 'text-slate-700', 'border-slate-200');
        const activeBadge = btn.querySelector('span:last-child');
        if (activeBadge) {
          activeBadge.classList.add('bg-white/20', 'text-white');
          activeBadge.classList.remove('bg-slate-100', 'text-slate-600');
        }

        applyFilters();
      });
    });

    // Search Input
    if (searchInput) {
      searchInput.addEventListener('input', () => {
        searchQuery = searchInput.value;
        applyFilters();
      });
    }

    // URL parameter support (?partition=...)
    const params = new URLSearchParams(window.location.search);
    const initialParam = params.get('partition');
    if (initialParam) {
      const matchBtn = Array.from(filterBtns).find(btn => btn.getAttribute('data-partition') === initialParam);
      if (matchBtn) (matchBtn as HTMLElement).click();
    }
  }

  document.addEventListener('astro:page-load', initGallery);
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initGallery);
  } else {
    initGallery();
  }
</script>

<style>
  .gallery-item-card {
    will-change: transform, box-shadow;
  }
</style>
