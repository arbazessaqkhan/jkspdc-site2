---
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';

let galleryItems = [];
let errorMessage = '';

try {
  // Fetch from 127.0.0.1 to avoid local DNS/IPv6 connection failures
  const res = await fetch('http://127.0.0.1:3000/api/gallery');
  if (res.ok) {
    galleryItems = await res.json();
  } else {
    errorMessage = 'Failed to load media records from the backend database.';
  }
} catch (e) {
  console.error('Error fetching gallery items:', e);
  errorMessage = 'Connection to administrative database failed. Displaying cached records.';
  galleryItems = [
    {
      id: 'gallery-seed-1',
      title: 'Signing of Implementation Agreement NHPC & JKSPDC',
      imageUrl: '/gallery/signing_agreement.png',
      partition: 'Official Events',
    },
    {
      id: 'gallery-seed-2',
      title: 'Retirement Ceremony of Executive Director Civil, JKSPDC',
      imageUrl: '/gallery/retirement_ed_civil.png',
      partition: 'Corporate',
    },
    {
      id: 'gallery-seed-3',
      title: 'Hydroelectric Project Site View',
      imageUrl: '/gallery/projects_gallery.jpg',
      partition: 'Projects',
    },
    {
      id: 'gallery-seed-4',
      title: 'Baglihar Hydroelectric Dam Construction',
      imageUrl: '/slider1.jpg',
      partition: 'Projects',
    },
    {
      id: 'gallery-seed-5',
      title: 'Corporate HQ and Administrative Building',
      imageUrl: '/slider2.jpg',
      partition: 'Corporate',
    },
    {
      id: 'gallery-seed-6',
      title: 'Official Executive Board Meeting',
      imageUrl: '/slider3.jpg',
      partition: 'Official Events',
    },
  ];
}

const uniquePartitions = [...new Set(galleryItems.map(item => item.partition).filter(Boolean))];

function getImageUrl(url: string) {
  if (!url) return '';
  if (url.startsWith('/uploads/')) {
    return `http://127.0.0.1:3000${url}`;
  }
  return url;
}
---

<Layout 
  title="Photo & Video Gallery - Media" 
  description="Photo and video gallery of JKSPDC power stations and corporate events."
>
  <div class="space-y-6">
    <!-- Breadcrumbs -->
    <nav class="text-xs text-gray-500" aria-label="Breadcrumbs">
      <ol class="flex gap-2">
        <li><a href="/" class="hover:underline focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-[#0B4F9C] rounded px-1">Home</a></li>
        <li>/</li>
        <li><span class="text-gray-400">Media Center</span></li>
        <li>/</li>
        <li><span class="font-semibold text-[#0B4F9C]">Gallery</span></li>
      </ol>
    </nav>

    <!-- Page Header -->
    <header class="border-b border-gray-200 pb-4 flex flex-col md:flex-row md:items-end justify-between gap-4">
      <div>
        <h2 class="text-3xl font-extrabold text-[#0B4F9C]">Photo &amp; Media Gallery</h2>
        <p class="text-sm text-gray-600 mt-1 font-medium">Visual showcase of hydroelectric projects, operations, and corporate achievements.</p>
      </div>
      {errorMessage && (
        <span class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-semibold bg-amber-50 text-amber-800 border border-amber-200 rounded-lg">
          ⚠️ {errorMessage}
        </span>
      )}
    </header>

    <!-- Main Full-Width Content -->
    <div class="space-y-6">
      
      {galleryItems.length === 0 ? (
        <div class="bg-gray-50 border border-gray-200 text-gray-700 rounded-xl p-10 text-center text-sm shadow-sm">
          <p class="font-semibold text-gray-800 mb-1">No media records found</p>
          <p class="text-xs text-gray-500">Official gallery records are currently being updated by the corporation.</p>
        </div>
      ) : (
        <!-- Dynamic Filter Tabs & Grid -->
        <div class="space-y-6">
          
          <!-- Dynamic Filter Pills -->
          <div class="flex flex-wrap items-center gap-2 border-b border-gray-100 pb-4">
            <button 
              class="gallery-filter-btn px-4 py-2 rounded-full text-xs font-bold transition-all bg-[#0B4F9C] text-white shadow-sm border border-[#0B4F9C] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#0B4F9C]/50"
              data-partition="All"
            >
              All Media
            </button>
            {uniquePartitions.map(partition => (
              <button 
                class="gallery-filter-btn px-4 py-2 rounded-full text-xs font-bold transition-all bg-white text-slate-600 hover:bg-slate-50 border border-slate-200 hover:border-slate-300 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#0B4F9C]/50"
                data-partition={partition}
              >
                {partition}
              </button>
            ))}
          </div>

          <!-- Responsive Grid Layout -->
          <div id="gallery-grid" class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-5">
            {galleryItems.map(item => (
              <div 
                class="gallery-item-card group relative bg-white border border-slate-200/70 rounded-xl overflow-hidden shadow-sm hover:shadow-lg transition-all duration-300 aspect-[4/3] cursor-pointer"
                data-partition={item.partition || 'General'}
                data-src={getImageUrl(item.imageUrl)}
                data-title={item.title}
              >
                <!-- Image Container -->
                <div class="w-full h-full overflow-hidden bg-slate-50">
                  <img 
                    src={getImageUrl(item.imageUrl)} 
                    alt={item.title} 
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                    loading="lazy"
                  />
                </div>

                <!-- Subtle bottom gradient visible initially for modern UI -->
                <div class="absolute inset-0 bg-gradient-to-t from-slate-900/60 via-transparent to-transparent opacity-85 group-hover:opacity-0 transition-opacity duration-300 flex items-end p-3.5">
                  <p class="text-white text-[11px] font-semibold truncate w-full">{item.title}</p>
                </div>

                <!-- Overlay Gradient -->
                <div class="absolute inset-0 bg-gradient-to-t from-slate-900/95 via-slate-900/40 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex flex-col justify-end p-4">
                  <span class="inline-block self-start text-[9px] font-extrabold uppercase bg-teal-500 text-white px-2 py-0.5 rounded mb-2 tracking-wider shadow-sm">
                    {item.partition || 'General'}
                  </span>
                  <h4 class="text-white text-xs font-bold leading-snug line-clamp-2">
                    {item.title}
                  </h4>
                </div>
                
                <!-- Glassmorphism Zoom Badge -->
                <div class="absolute top-3 right-3 w-8 h-8 rounded-full bg-white/15 backdrop-blur-md border border-white/20 flex items-center justify-center text-white opacity-0 group-hover:opacity-100 transition-all duration-300 transform scale-90 group-hover:scale-100 text-sm">
                  🔍
                </div>
              </div>
            ))}
          </div>
          
        </div>
      )}

    </div>
  </div>

  <!-- Lightbox Overlay for Gallery -->
  <div id="gallery-lightbox" class="fixed inset-0 z-[9999] bg-black/90 backdrop-blur-sm hidden items-center justify-center" role="dialog" aria-modal="true" aria-label="Image viewer">
    <button id="lightbox-close" class="absolute top-4 right-4 w-10 h-10 rounded-full bg-white/10 hover:bg-white/20 text-white text-2xl flex items-center justify-center transition-colors z-10" aria-label="Close">&times;</button>
    <button id="lightbox-prev" class="absolute left-4 top-1/2 -translate-y-1/2 w-10 h-10 rounded-full bg-white/10 hover:bg-white/20 text-white text-xl flex items-center justify-center transition-colors z-10" aria-label="Previous">&#8249;</button>
    <button id="lightbox-next" class="absolute right-4 top-1/2 -translate-y-1/2 w-10 h-10 rounded-full bg-white/10 hover:bg-white/20 text-white text-xl flex items-center justify-center transition-colors z-10" aria-label="Next">&#8250;</button>
    <img id="lightbox-img" src="" alt="" class="max-w-[90vw] max-h-[85vh] object-contain rounded-xl shadow-2xl" />
    <div id="lightbox-caption" class="absolute bottom-6 left-1/2 -translate-x-1/2 text-white text-sm font-semibold bg-black/50 px-4 py-2 rounded-lg backdrop-blur-sm max-w-lg text-center font-sans"></div>
  </div>
</Layout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const filterBtns = document.querySelectorAll('.gallery-filter-btn');
    const galleryItems = document.querySelectorAll('.gallery-item-card');
    const lightbox = document.getElementById('gallery-lightbox');
    const lightboxImg = document.getElementById('lightbox-img') as HTMLImageElement;
    const lightboxCaption = document.getElementById('lightbox-caption');
    const lightboxClose = document.getElementById('lightbox-close');
    const lightboxPrev = document.getElementById('lightbox-prev');
    const lightboxNext = document.getElementById('lightbox-next');

    let visibleItems = Array.from(galleryItems);
    let currentGalleryIndex = 0;

    function getVisibleImages() {
      return visibleItems.map(item => ({
        src: item.getAttribute('data-src') || '',
        title: item.getAttribute('data-title') || '',
        partition: item.getAttribute('data-partition') || ''
      }));
    }

    function openLightbox(index: number) {
      if (!lightbox || visibleItems.length === 0) return;
      currentGalleryIndex = index;
      const images = getVisibleImages();
      const imgData = images[currentGalleryIndex];
      if (lightboxImg) lightboxImg.src = imgData.src;
      if (lightboxCaption) {
        lightboxCaption.innerHTML = `
          <span class="inline-block px-2 py-0.5 text-[9px] uppercase font-extrabold bg-teal-500 text-white rounded mb-1.5">${imgData.partition}</span>
          <p class="text-white text-xs font-bold">${imgData.title}</p>
        `;
      }
      lightbox.classList.remove('hidden');
      lightbox.classList.add('flex');
      document.body.style.overflow = 'hidden';
    }

    function closeLightbox() {
      if (!lightbox) return;
      lightbox.classList.remove('flex');
      lightbox.classList.add('hidden');
      document.body.style.overflow = '';
    }

    function bindItemClicks() {
      visibleItems.forEach((item, idx) => {
        (item as HTMLElement).onclick = () => {
          openLightbox(idx);
        };
      });
    }

    bindItemClicks();

    if (lightboxClose) lightboxClose.onclick = closeLightbox;
    if (lightboxPrev) {
      lightboxPrev.onclick = () => {
        const len = visibleItems.length;
        openLightbox((currentGalleryIndex - 1 + len) % len);
      };
    }
    if (lightboxNext) {
      lightboxNext.onclick = () => {
        const len = visibleItems.length;
        openLightbox((currentGalleryIndex + 1) % len);
      };
    }
    if (lightbox) {
      lightbox.onclick = (e) => {
        if (e.target === lightbox) closeLightbox();
      };
    }
    document.addEventListener('keydown', (e) => {
      if (lightbox && !lightbox.classList.contains('hidden')) {
        if (e.key === 'Escape') closeLightbox();
        if (e.key === 'ArrowLeft' && lightboxPrev) (lightboxPrev as HTMLElement).click();
        if (e.key === 'ArrowRight' && lightboxNext) (lightboxNext as HTMLElement).click();
      }
    });

    filterBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const partition = btn.getAttribute('data-partition');

        // Update active classes
        filterBtns.forEach(b => {
          b.classList.remove('bg-[#0B4F9C]', 'text-white', 'shadow-sm', 'border-[#0B4F9C]');
          b.classList.add('bg-white', 'text-slate-600', 'border-slate-200');
        });
        btn.classList.add('bg-[#0B4F9C]', 'text-white', 'shadow-sm', 'border-[#0B4F9C]');
        btn.classList.remove('bg-white', 'text-slate-600', 'border-slate-200');

        // Filter cards and rebuild visibleItems array
        const temp = [];
        galleryItems.forEach(item => {
          const itemPartition = item.getAttribute('data-partition');
          if (partition === 'All' || itemPartition === partition) {
            (item as HTMLElement).style.display = 'block';
            (item as HTMLElement).style.opacity = '0';
            setTimeout(() => {
              (item as HTMLElement).style.opacity = '1';
            }, 50);
            temp.push(item);
          } else {
            (item as HTMLElement).style.display = 'none';
          }
        });
        visibleItems = temp;
        bindItemClicks();
      });
    });

    // Read and activate initial partition filter from URL search query parameter
    const params = new URLSearchParams(window.location.search);
    const initialPartition = params.get('partition');
    if (initialPartition) {
      const matchBtn = Array.from(filterBtns).find(btn => btn.getAttribute('data-partition') === initialPartition);
      if (matchBtn) {
        (matchBtn as HTMLElement).click();
      }
    }
  });
</script>

<style>
  .gallery-item-card {
    transition: opacity 0.3s ease;
  }
</style>
