---
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';

let downloads = [];

try {
  const res = await fetch('http://localhost:3000/api/policies?category=Downloads');
  if (res.ok) {
    const data = await res.json();
    downloads = data.filter(d => d.status === 'Active');
  }
} catch (e) {
  console.error('Error fetching downloads:', e);
}
---

<Layout 
  title="Downloads - Media" 
  description="Corporate brochures, booklets, and publications of JKSPDC."
>
  <div class="space-y-0">
    <!-- Premium Page Header Band -->
    <div class="page-header-band animate-fadeInUp">
      <nav class="breadcrumb-trail" aria-label="Breadcrumbs">
        <a href="/">Home</a>
        <span class="separator">/</span>
        <span class="current">Downloads</span>
      </nav>
      <h1>Downloads</h1>
      <p class="page-subtitle">Jammu &amp; Kashmir State Power Development Corporation Limited (JKSPDCL)</p>
    </div>

    <!-- Content -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 animate-fadeInUp delay-200">
      <!-- Main Text -->
      <article class="lg:col-span-2 prose-gov">
        {downloads.length === 0 ? (
          <!-- Safety content placeholder -->
          <div class="bg-gray-50 border border-gray-200 text-gray-700 rounded-lg p-6 text-center text-sm shadow-sm">
            <p class="font-semibold text-gray-800 mb-1">Corporate Booklet & Document Downloads Pending Official Approval</p>
            <p class="text-xs text-gray-500">Official media kits and booklet files are currently undergoing review.</p>
            <div class="mt-3 inline-block bg-neutral-200 text-neutral-800 px-3 py-1 rounded text-[10px] font-bold uppercase tracking-wider">
              [Content Pending Approval]
            </div>
          </div>
        ) : (
          downloads.map((doc) => (
            <div class="bg-white border border-gray-200 hover:border-[#9BC2E6] rounded-xl p-5 shadow-sm transition-all duration-200 flex flex-col md:flex-row md:items-center justify-between gap-4">
              <div class="space-y-1.5 max-w-xl">
                <span class="text-[9px] uppercase tracking-wider font-extrabold text-[#0B4F9C] bg-[#0B4F9C]/5 px-2 py-0.5 rounded">
                  Downloads
                </span>
                <h3 class="font-bold text-gray-900 text-base mt-1.5">
                  {doc.title}
                </h3>
                <p class="text-xs text-slate-500 leading-relaxed mt-1">
                  {doc.description || "Official corporate booklets, brochures, and administrative publication attachments."}
                </p>
              </div>
              <div class="shrink-0 flex items-center">
                <a 
                  href={doc.documentUrl} 
                  target="_blank" 
                  rel="noopener noreferrer" 
                  class="w-full md:w-auto inline-flex items-center justify-center gap-2 bg-[#0B4F9C] hover:bg-[#084A8F] text-white font-bold text-xs px-5 py-2.5 rounded transition-all duration-150 shadow-sm cursor-pointer"
                >
                  <Icon name="search" size={13} strokeWidth={2.5} /> View / Download PDF
                </a>
              </div>
            </div>
          ))
        )}
      </article>

      <!-- Sidebar -->
      <aside class="space-y-5 animate-fadeIn delay-300">
        <div class="card-static">
          <h3 class="sidebar-card-title">Media Center</h3>
          <ul class="flex flex-col gap-2 text-xs font-semibold text-[#0B4F9C]">
            <li><a href="/media/press-releases" class="sidebar-link">Press Releases</a></li>
            <li><a href="/media/gallery" class="sidebar-link">Photo & Video Gallery</a></li>
          </ul>
        </div>
      </aside>
    </div>
  </div>
</Layout>
