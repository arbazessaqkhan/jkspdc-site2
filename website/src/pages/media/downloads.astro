---
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import { BACKEND_URL } from '../../utils/api-error';
import { getDocUrl } from '../../utils/sanitizer';

let downloads: any[] = [];

try {
  const res = await fetch(`${BACKEND_URL}/api/downloads`);
  if (res.ok) {
    const dbItems = await res.json();
    if (Array.isArray(dbItems)) {
      const active = dbItems.filter((d: any) => 
        (!d.status || d.status === 'Active') &&
        (!d.category || d.category.toLowerCase() === 'downloads' || d.category.toLowerCase() === 'official forms' || d.category.toLowerCase() === 'e-tendering forms')
      );
      downloads = active;
    }
  }
} catch (e) {
  console.error('Error fetching downloads from backend:', e);
}
---

<Layout 
  title="Downloads - Media" 
  description="Corporate brochures, booklets, official request forms, and publications of JKSPDC."
>
  <div class="space-y-0 w-full">
    <!-- Premium Page Header Band -->
    <div class="page-header-band animate-fadeInUp">
      <nav class="breadcrumb-trail" aria-label="Breadcrumbs">
        <a href="/">Home</a>
        <span class="separator">/</span>
        <span class="current">Downloads</span>
      </nav>
      <h1>Downloads</h1>
      <p class="page-subtitle">Jammu &amp; Kashmir State Power Development Corporation Limited (JKSPDCL)</p>
    </div>

    <!-- Content -->
    <div class="animate-fadeInUp delay-200 mt-6">
      <!-- Main List -->
      <article class="prose-gov space-y-4 w-full">
        {downloads.length === 0 ? (
          <div class="bg-white rounded-xl border border-slate-200/80 shadow-xs p-12 text-center text-slate-500 text-xs font-semibold">
            No official downloads available at this time.
          </div>
        ) : (
          downloads.map((doc) => (
          <div class="bg-white border border-slate-200/80 hover:border-[#BDD7EE] rounded-xl p-5 shadow-xs transition-all duration-200 flex flex-col md:flex-row md:items-center justify-between gap-4">
            <div class="space-y-2 flex-1">
              <span class="text-[9px] uppercase tracking-wider font-extrabold text-[#0B3B60] bg-[#0B3B60]/5 px-2.5 py-1 rounded-sm">
                {doc.category || "Downloads"}
              </span>
              <div class="flex items-start gap-2.5 pt-0.5">
                <div class="w-1 h-5 bg-[#E58A00] rounded-full shrink-0 mt-0.5"></div>
                <h3 class="font-bold text-[#0B3B60] text-base leading-snug">
                  {doc.title}
                </h3>
              </div>
              {doc.description && (
                <p class="text-xs text-slate-500 leading-relaxed pl-3.5">
                  {doc.description}
                </p>
              )}
            </div>
            <div class="shrink-0 flex items-center">
              <a 
                href={getDocUrl(doc.documentUrl)} 
                target="_blank" 
                rel="noopener noreferrer" 
                class="w-full md:w-auto inline-flex items-center justify-center gap-2 bg-[#0B3B60] hover:bg-[#002B49] text-white font-bold text-xs px-5 py-2.5 rounded-lg transition-all duration-150 shadow-xs cursor-pointer"
              >
                <Icon name="file-text" size={14} strokeWidth={2.2} /> View PDF
              </a>
            </div>
          </div>
        )))}
      </article>
    </div>
  </div>
</Layout>
