---
import Layout from '../../layouts/Layout.astro';

let pressReleases = [];
let errorMessage = '';

try {
  const res = await fetch('http://localhost:3000/api/press-releases');
  if (res.ok) {
    pressReleases = await res.json();
    // Sort by publishDate descending (newest first)
    pressReleases.sort((a, b) => new Date(b.publishDate).getTime() - new Date(a.publishDate).getTime());
  } else {
    errorMessage = 'Failed to load press releases.';
  }
} catch (e) {
  errorMessage = 'Failed to connect to the backend server.';
}
---

<Layout 
  title="Press Releases - Media" 
  description="Official press releases and announcements issued by JKSPDC."
>
  <div class="space-y-0">
    <!-- Premium Page Header Band -->
    <div class="page-header-band animate-fadeInUp">
      <nav class="breadcrumb-trail" aria-label="Breadcrumbs">
        <a href="/">Home</a>
        <span class="separator">/</span>
        <span>Media</span>
        <span class="separator">/</span>
        <span class="current">Press Releases</span>
      </nav>
      <h1>Press Releases</h1>
      <p class="page-subtitle">Jammu &amp; Kashmir State Power Development Corporation Limited (JKSPDCL)</p>
    </div>

    <!-- Content -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 animate-fadeInUp delay-200">
      <!-- Main Content -->
      <article class="lg:col-span-2 prose-gov">
        
        {errorMessage && (
          <div class="bg-red-50 border border-red-200 text-red-800 rounded-lg p-4 text-xs font-semibold">
            {errorMessage}
          </div>
        )}

        <div class="space-y-0">
          {pressReleases.length === 0 && !errorMessage ? (
            <div class="text-center py-10 bg-slate-50 border border-slate-200 rounded-xl text-slate-500 text-sm font-medium">
              No press releases posted at the moment.
            </div>
          ) : (
            pressReleases.map((pr) => (
              <div class="bg-white rounded-xl border border-slate-205/85 shadow-sm p-6 space-y-4 hover:shadow-md transition-shadow">
                <div class="flex items-center justify-between text-xs text-slate-400 font-medium">
                  <span>Media Cell, JKSPDCL</span>
                  <time datetime={pr.publishDate}>{new Date(pr.publishDate).toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric' })}</time>
                </div>
                
                <h3 class="text-lg font-bold text-slate-900 leading-snug">{pr.title}</h3>
                
                {pr.imageUrl && (
                  <div class="w-full max-h-72 rounded-lg overflow-hidden bg-slate-100 border border-slate-200 flex items-center justify-center">
                    <img src={pr.imageUrl} alt={pr.title} class="w-full h-full object-cover" />
                  </div>
                )}
                
                <p class="text-sm text-slate-600 leading-relaxed whitespace-pre-wrap">{pr.content}</p>
              </div>
            ))
          )}
        </div>
      </article>

      <!-- Sidebar -->
      <aside class="space-y-5 animate-fadeIn delay-300">
        <div class="card-static">
          <h3 class="sidebar-card-title">Media Center</h3>
          <ul class="flex flex-col gap-2 text-xs font-semibold text-[#0B4F9C]">
            <li><a href="/media/gallery" class="sidebar-link">Photo & Video Gallery</a></li>
            <li><a href="/media/downloads" class="sidebar-link">Downloads Booklet</a></li>
          </ul>
        </div>
      </aside>
    </div>
  </div>
</Layout>
