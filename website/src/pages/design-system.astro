---
import Layout from '../layouts/Layout.astro';
---

<Layout 
  title="Design System & Component Catalog" 
  description="Design guidelines, typography scale, buttons, forms, tables, and alert components for the JKSPDC web portal."
>
  <div class="space-y-0 max-w-5xl mx-auto">
    <!-- Premium Page Header Band -->
    <div class="page-header-band animate-fadeInUp">
      <nav class="breadcrumb-trail" aria-label="Breadcrumbs">
        <a href="/">Home</a>
        <span class="separator">/</span>
        <span class="current">Design System</span>
      </nav>
      <h1>Design System &amp; Component Catalog</h1>
      <p class="page-subtitle">Jammu &amp; Kashmir State Power Development Corporation Limited (JKSPDCL)</p>
    </div>

    <div class="space-y-12">
    <!-- Title & Purpose -->
    <section>
      <p class="text-slate-650 max-w-3xl leading-relaxed">
        This page acts as a living style guide and accessibility audit playground. Use it to verify that all UI elements conform to GIGW 3.0 standards, WCAG 2.2 AA contrast ratios, and keyboard focus patterns.
      </p>
      <div class="mt-4 border-l-4 border-orange-500 bg-orange-50 p-4 rounded text-xs text-orange-800 font-semibold max-w-3xl">
        Compliance Requirement: Body text contrast must be at least 4.5:1. High-visibility blue focus rings must appear on all interactive components.
      </div>
    </section>

    <hr class="border-gray-200" />

    <!-- 1. Color Palette Swatches -->
    <section class="space-y-4">
      <h3 class="text-xl font-bold text-gray-900">1. Color Palette</h3>
      <div class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-5 gap-4">
        <!-- Brand Primary -->
        <div class="bg-white border border-gray-200 rounded p-3 shadow-sm">
          <div class="h-20 bg-[#0B4F9C] rounded mb-2" aria-hidden="true"></div>
          <p class="text-xs font-bold text-gray-800">Brand Primary</p>
          <code class="text-[10px] text-gray-500 block">#0B4F9C</code>
          <span class="text-[10px] bg-blue-100 text-blue-800 font-semibold px-2 py-0.5 rounded mt-1 inline-block">Gov Authority</span>
        </div>
        <!-- Brand Secondary -->
        <div class="bg-white border border-gray-200 rounded p-3 shadow-sm">
          <div class="h-20 bg-[#f15a24] rounded mb-2" aria-hidden="true"></div>
          <p class="text-xs font-bold text-gray-800">Brand Secondary</p>
          <code class="text-[10px] text-gray-500 block">#f15a24</code>
          <span class="text-[10px] bg-orange-100 text-orange-800 font-semibold px-2 py-0.5 rounded mt-1 inline-block">Active State</span>
        </div>
        <!-- Brand Accent -->
        <div class="bg-white border border-gray-200 rounded p-3 shadow-sm">
          <div class="h-20 bg-[#008080] rounded mb-2" aria-hidden="true"></div>
          <p class="text-xs font-bold text-gray-800">Brand Accent</p>
          <code class="text-[10px] text-gray-500 block">#008080</code>
          <span class="text-[10px] bg-teal-100 text-teal-800 font-semibold px-2 py-0.5 rounded mt-1 inline-block">Teal Highlights</span>
        </div>
        <!-- Light Gray -->
        <div class="bg-white border border-gray-200 rounded p-3 shadow-sm">
          <div class="h-20 bg-gray-50 border border-gray-200 rounded mb-2" aria-hidden="true"></div>
          <p class="text-xs font-bold text-gray-800">Neutral Light</p>
          <code class="text-[10px] text-gray-500 block">#f9fafb</code>
          <span class="text-[10px] bg-gray-100 text-gray-800 font-semibold px-2 py-0.5 rounded mt-1 inline-block">Surfaces</span>
        </div>
        <!-- Neutral Dark -->
        <div class="bg-white border border-gray-200 rounded p-3 shadow-sm">
          <div class="h-20 bg-gray-900 rounded mb-2" aria-hidden="true"></div>
          <p class="text-xs font-bold text-gray-800">Neutral Dark</p>
          <code class="text-[10px] text-gray-500 block">#111827</code>
          <span class="text-[10px] bg-gray-200 text-gray-900 font-semibold px-2 py-0.5 rounded mt-1 inline-block">Body Text</span>
        </div>
      </div>
    </section>

    <hr class="border-gray-200" />

    <!-- 2. Typography Scale -->
    <section class="space-y-4">
      <h3 class="text-xl font-bold text-gray-900">2. Typography Hierarchy</h3>
      <div class="bg-white border border-gray-200 rounded-lg p-6 space-y-4 shadow-sm">
        <div>
          <span class="text-[10px] text-gray-400 font-bold block mb-1">H1 Heading (Large Hero / Site Title)</span>
          <h1 class="text-3xl md:text-4xl font-extrabold text-[#0B4F9C] tracking-tight">The Quick Brown Fox Jumps Over the Lazy Dog</h1>
        </div>
        <hr class="border-gray-100" />
        <div>
          <span class="text-[10px] text-gray-400 font-bold block mb-1">H2 Heading (Section Title)</span>
          <h2 class="text-2xl md:text-3xl font-bold text-[#0B4F9C]">The Quick Brown Fox Jumps Over the Lazy Dog</h2>
        </div>
        <hr class="border-gray-100" />
        <div>
          <span class="text-[10px] text-gray-400 font-bold block mb-1">H3 Heading (Card Title)</span>
          <h3 class="text-xl font-bold text-gray-900">The Quick Brown Fox Jumps Over the Lazy Dog</h3>
        </div>
        <hr class="border-gray-100" />
        <div>
          <span class="text-[10px] text-gray-400 font-bold block mb-1">Body Text (Paragraph / General Reading)</span>
          <p class="text-sm md:text-base text-gray-700 leading-relaxed">
            This paragraph represents standard reading text. It has been sized and styled to ensure high readability and GIGW 3.0 contrast requirements. Our primary goal is clean delivery of information.
          </p>
        </div>
      </div>
    </section>

    <hr class="border-gray-200" />

    <!-- 3. Button Component States -->
    <section class="space-y-4">
      <h3 class="text-xl font-bold text-gray-900">3. Button Primitives</h3>
      <div class="bg-white border border-gray-200 rounded-lg p-6 flex flex-wrap gap-4 shadow-sm">
        <div class="flex flex-col gap-2">
          <span class="text-[10px] text-gray-400 font-bold">Primary</span>
          <button class="btn-primary">Submit Form</button>
        </div>
        <div class="flex flex-col gap-2">
          <span class="text-[10px] text-gray-400 font-bold">Secondary Accent</span>
          <button class="btn-secondary">Explore Notices</button>
        </div>
        <div class="flex flex-col gap-2">
          <span class="text-[10px] text-gray-400 font-bold">Outline</span>
          <button class="btn-outline">Download PDF</button>
        </div>
        <div class="flex flex-col gap-2">
          <span class="text-[10px] text-gray-400 font-bold">Disabled State</span>
          <button class="btn-primary" disabled>Saving Details...</button>
        </div>
      </div>
    </section>

    <hr class="border-gray-200" />

    <!-- 4. Card Layout Options -->
    <section class="space-y-4">
      <h3 class="text-xl font-bold text-gray-900">4. Card Components</h3>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <!-- Static Card -->
        <div class="card-static">
          <h4 class="text-lg font-bold text-gray-900 mb-2">Static Information Container</h4>
          <p class="text-sm text-gray-600 leading-relaxed">
            This card container is designed for static items that do not trigger transitions or page redirections.
          </p>
        </div>
        <!-- Interactive Card -->
        <div class="card-interactive">
          <h4 class="text-lg font-bold text-[#0B4F9C] mb-2">Interactive Navigation Container</h4>
          <p class="text-sm text-gray-600 leading-relaxed">
            This container features hover elevations and border shifts, indicating that it is a clickable dashboard card.
          </p>
        </div>
      </div>
    </section>

    <hr class="border-gray-200" />

    <!-- 5. Interactive Form Elements -->
    <section class="space-y-4">
      <h3 class="text-xl font-bold text-gray-900">5. Form Controls</h3>
      <form class="bg-white border border-gray-200 rounded-lg p-6 max-w-2xl shadow-sm space-y-4" onsubmit="return false">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <!-- Text Input -->
          <div class="form-group">
            <label for="sample-name" class="form-label">Full Name <span class="text-red-600" aria-label="Required">*</span></label>
            <input type="text" id="sample-name" class="form-input" placeholder="e.g. John Doe" required />
          </div>
          <!-- Selector -->
          <div class="form-group">
            <label for="sample-subject" class="form-label">Tender Department</label>
            <select id="sample-subject" class="form-select">
              <option value="hydro">Hydro Projects Cell</option>
              <option value="commercial">Commercial Operations</option>
            </select>
          </div>
        </div>
        <!-- Error State Validation -->
        <div class="form-group">
          <label for="sample-email" class="form-label">Email Address</label>
          <input type="email" id="sample-email" class="form-input border-red-500 focus:border-red-500" value="invalid-email-format" />
          <span class="form-error" id="email-error">Please provide a valid official email address.</span>
        </div>
        <!-- Checkbox -->
        <div class="flex items-center gap-2">
          <input type="checkbox" id="sample-check" class="form-checkbox" />
          <label for="sample-check" class="text-xs font-semibold text-gray-700">I agree to the hyperlinking policies.</label>
        </div>
        <button type="submit" class="btn-primary mt-2">Submit Query</button>
      </form>
    </section>

    <hr class="border-gray-200" />

    <!-- 6. Data Tables Listing -->
    <section class="space-y-4">
      <h3 class="text-xl font-bold text-gray-900">6. Tabular Layout (Tenders / Notice Lists)</h3>
      <div class="table-wrapper">
        <table class="table-data" aria-label="Active Tenders Registry">
          <thead>
            <tr>
              <th scope="col">Tender Reference No.</th>
              <th scope="col">Subject / Work Description</th>
              <th scope="col">Closing Date</th>
              <th scope="col">Document Details</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td class="font-semibold text-gray-900">NIT/102-JKSPDC/2026</td>
              <td>Detailed Project Report consultancy services for Hydroelectric Power Stations.</td>
              <td>July 28, 2026</td>
              <td>
                <a href="#" class="text-blue-800 hover:underline font-semibold flex items-center gap-1">
                  📄 Tender_DPR.pdf <span class="text-xs text-gray-500">(1.2 MB)</span>
                </a>
              </td>
            </tr>
            <tr>
              <td class="font-semibold text-gray-900">NIT/103-JKSPDC/2026</td>
              <td>Supply, installation, and commissioning of telemetry equipment.</td>
              <td>August 05, 2026</td>
              <td>
                <a href="#" class="text-blue-800 hover:underline font-semibold flex items-center gap-1">
                  📄 Telemetry_SBD.pdf <span class="text-xs text-gray-500">(890 KB)</span>
                </a>
              </td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>

    <hr class="border-gray-200" />

    <!-- 7. Alert Callout Systems -->
    <section class="space-y-4">
      <h3 class="text-xl font-bold text-gray-900">7. Alert System Notification Banners</h3>
      <div class="space-y-4 max-w-3xl">
        <!-- Success -->
        <div class="alert-success" role="alert">
          <span class="font-extrabold" aria-hidden="true">✔</span>
          <div>
            <strong>Action Completed Successfully:</strong> Your bidding document has been submitted and registered under Audit Log ID #284-JK.
          </div>
        </div>
        <!-- Info -->
        <div class="alert-info" role="alert">
          <span class="font-extrabold" aria-hidden="true">ℹ</span>
          <div>
            <strong>General Information Notice:</strong> Pre-bid conference is scheduled via video conference on July 15, 2026.
          </div>
        </div>
        <!-- Warning -->
        <div class="alert-warning" role="alert">
          <span class="font-extrabold" aria-hidden="true">⚠</span>
          <div>
            <strong>Submission Warning:</strong> Bidding portals will close automatically at 17:00 IST on the closing date. Late entries will be rejected.
          </div>
        </div>
        <!-- Error -->
        <div class="alert-error" role="alert">
          <span class="font-extrabold" aria-hidden="true">✖</span>
          <div>
            <strong>Transaction Error:</strong> Upload failed. The document signature did not match the registered MSME vendor certificate.
          </div>
        </div>
      </div>
    </section>

    </div>
  </div>
</Layout>
