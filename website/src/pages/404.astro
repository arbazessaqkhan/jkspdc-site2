---
import Layout from '../layouts/Layout.astro';
---

<Layout 
  title="Page Not Found (404) - JKSPDC" 
  description="The requested page could not be found on the JKSPDC portal."
>
  <div class="flex flex-col items-center justify-center text-center space-y-6 py-12">
    <div class="bg-red-50 text-red-700 text-6xl font-black px-6 py-3 rounded-full border border-red-200 shadow-inner">
      404
    </div>
    
    <h2 class="text-3xl font-extrabold text-[#003366]">Page Not Found</h2>
    <p class="text-sm text-gray-600 max-w-md leading-relaxed">
      We apologize for the inconvenience. The page you are looking for might have been removed, had its name changed, or is temporarily unavailable.
    </p>

    <div class="flex gap-4">
      <a href="/" class="btn-primary text-xs">Return Home</a>
      <a href="/sitemap" class="btn-outline text-xs">View Sitemap</a>
    </div>
  </div>
</Layout>
