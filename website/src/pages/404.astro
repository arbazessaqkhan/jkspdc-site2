---
import Layout from '../layouts/Layout.astro';
---

<Layout 
  title="Page Not Found (404) - JKSPDC" 
  description="The requested page could not be found on the JKSPDC portal."
>
  <div class="space-y-0 max-w-5xl mx-auto">
    <!-- Premium Page Header Band -->
    <div class="page-header-band animate-fadeInUp">
      <nav class="breadcrumb-trail" aria-label="Breadcrumbs">
        <a href="/">Home</a>
        <span class="separator">/</span>
        <span class="current">404</span>
      </nav>
      <h1>Page Not Found</h1>
      <p class="page-subtitle">Jammu &amp; Kashmir State Power Development Corporation Limited (JKSPDCL)</p>
    </div>

    <div class="bg-white rounded-xl border border-slate-200 shadow-sm p-8 md:p-12 text-center space-y-6">
      <div class="inline-block bg-red-50 text-red-700 text-6xl font-black px-6 py-3 rounded-full border border-red-200 shadow-inner">
        404
      </div>
      
      <h2 class="text-2xl font-extrabold text-slate-800">Page Not Found</h2>
      <p class="text-sm text-slate-600 max-w-md mx-auto leading-relaxed">
        We apologize for the inconvenience. The page you are looking for might have been removed, had its name changed, or is temporarily unavailable.
      </p>

      <div class="flex justify-center gap-4 pt-2">
        <a href="/" class="btn-primary text-xs">Return Home</a>
        <a href="/sitemap" class="btn-outline text-xs">View Sitemap</a>
      </div>
    </div>
  </div>
</Layout>
