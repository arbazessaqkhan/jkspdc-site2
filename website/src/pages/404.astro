---
import Layout from '../layouts/Layout.astro';
---

<Layout 
  title="Page Not Found (404) - JKSPDC" 
  description="The requested page could not be found on the JKSPDC portal."
>
  <div class="space-y-0 max-w-5xl mx-auto">
    <!-- Premium Page Header Band -->
    <div class="page-header-band animate-fadeInUp">
      <nav class="breadcrumb-trail" aria-label="Breadcrumbs">
        <a href="/">Home</a>
        <span class="separator">/</span>
        <span class="current">404</span>
      </nav>
      <h1>Page Not Found</h1>
      <p class="page-subtitle">Jammu &amp; Kashmir State Power Development Corporation Limited (JKSPDCL)</p>
    </div>

    <div class="bg-white rounded-xl border border-slate-200 shadow-sm p-8 md:p-12 text-center space-y-5">
      <div class="inline-block bg-[#0B4F9C]/10 text-[#0B4F9C] text-5xl sm:text-6xl font-black px-7 py-2.5 rounded-2xl border border-[#0B4F9C]/20 tracking-wider shadow-xs">
        404
      </div>
      
      <div>
        <h2 class="text-xl sm:text-2xl font-bold text-slate-800">The requested resource is unavailable</h2>
        <p class="text-xs text-slate-500 font-devanagari mt-1" lang="hi">यह पृष्ठ उपलब्ध नहीं है (Page Not Found)</p>
      </div>

      <p class="text-xs sm:text-sm text-slate-600 max-w-lg mx-auto leading-relaxed">
        We apologize for the inconvenience. The page or document you are trying to access might have been moved, updated, renamed, or is temporarily offline.
      </p>

      <div class="flex flex-wrap justify-center gap-3 pt-2">
        <a href="/" class="btn-primary text-xs">Return Home</a>
        <a href="/sitemap" class="btn-outline text-xs">View Sitemap</a>
        <a href="/about-us/others/contact" class="btn-outline text-xs">Contact Directory</a>
      </div>
    </div>
  </div>
</Layout>
