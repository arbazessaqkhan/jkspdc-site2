---
import Layout from '../../../layouts/Layout.astro';
import Icon from '../../../components/Icon.astro';
---

<Layout 
  title="Vendor Portal - Vendors" 
  description="Official Vendor Registration, E-Tendering Forms, and Information Portal of JKSPDC."
>
  <div class="space-y-0">
    <!-- Premium Page Header Band -->
    <div class="page-header-band animate-fadeInUp">
      <nav class="breadcrumb-trail" aria-label="Breadcrumbs">
        <a href="/">Home</a>
        <span class="separator">/</span>
        <span class="current">Vendor Portal</span>
      </nav>
      <h1>Vendor Portal</h1>
      <p class="page-subtitle">Jammu &amp; Kashmir State Power Development Corporation Limited (JKSPDCL)</p>
    </div>

    <!-- Content -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 animate-fadeInUp delay-200">
      <!-- Main Content -->
      <article class="lg:col-span-2 prose-gov space-y-6">
        <!-- Official Downloadable Forms Card -->
        <div class="bg-white border border-gray-200 rounded-xl p-6 shadow-sm space-y-4">
          <h2 class="text-lg font-bold text-gray-900 border-b border-gray-100 pb-3 flex items-center gap-2">
            <span class="w-2.5 h-2.5 bg-[#0B4F9C] rounded-full inline-block"></span>
            E-Tendering Registration & NIT Request Forms
          </h2>
          <p class="text-xs text-slate-600 leading-relaxed">
            Download official forms required for e-tendering user credential creation on jktenders.gov.in and web portal NIT upload requests.
          </p>

          <div class="space-y-3 pt-2">
            <!-- Form 1 -->
            <div class="bg-slate-50 border border-slate-200 hover:border-[#0B4F9C] rounded-lg p-4 transition-colors flex flex-col sm:flex-row sm:items-center justify-between gap-3">
              <div>
                <span class="text-[9px] uppercase tracking-wider font-extrabold text-[#0B4F9C] bg-[#0B4F9C]/10 px-2 py-0.5 rounded">
                  E-Tendering Form
                </span>
                <h3 class="font-bold text-slate-900 text-sm mt-1">
                  User Creation
                </h3>
                <p class="text-xs text-slate-500 mt-0.5">Requisite form and instructions for user creation and digital signature mapping on jktenders.gov.in.</p>
              </div>
              <a 
                href="/User Creation.pdf" 
                target="_blank" 
                rel="noopener noreferrer" 
                class="shrink-0 inline-flex items-center justify-center gap-2 bg-[#0B4F9C] hover:bg-[#084A8F] text-white font-bold text-xs px-4 py-2 rounded transition-all shadow-sm"
              >
                <Icon name="search" size={13} strokeWidth={2.5} /> View PDF
              </a>
            </div>

            <!-- Form 2 -->
            <div class="bg-slate-50 border border-slate-200 hover:border-[#0B4F9C] rounded-lg p-4 transition-colors flex flex-col sm:flex-row sm:items-center justify-between gap-3">
              <div>
                <span class="text-[9px] uppercase tracking-wider font-extrabold text-[#0B4F9C] bg-[#0B4F9C]/10 px-2 py-0.5 rounded">
                  Official Form
                </span>
                <h3 class="font-bold text-slate-900 text-sm mt-1">
                  NIT Upload Request Form
                </h3>
                <p class="text-xs text-slate-500 mt-0.5">Form required for submitting NIT, e-NIT Gist, Quotations, or Corrigenda for upload to webupdates@jkspdcl.com.</p>
              </div>
              <a 
                href="/NIT Upload Request Form.pdf" 
                target="_blank" 
                rel="noopener noreferrer" 
                class="shrink-0 inline-flex items-center justify-center gap-2 bg-[#0B4F9C] hover:bg-[#084A8F] text-white font-bold text-xs px-4 py-2 rounded transition-all shadow-sm"
              >
                <Icon name="search" size={13} strokeWidth={2.5} /> View PDF
              </a>
            </div>
          </div>
        </div>

        <!-- Safety content placeholder -->
        <div class="bg-gray-50 border border-gray-200 text-gray-700 rounded-lg p-5 text-center text-xs shadow-sm">
          <p class="font-semibold text-gray-800 mb-1">Vendor Portal Automated Sign-Up Interface Pending Approval</p>
          <p class="text-xs text-gray-500">The automated pre-qualification workflow is currently undergoing review.</p>
        </div>
      </article>

      <!-- Sidebar -->
      <aside class="space-y-5 animate-fadeIn delay-300">
        <div class="card-static">
          <h3 class="sidebar-card-title">Vendor Utilities</h3>
          <ul class="flex flex-col gap-2 text-xs font-semibold text-[#0B4F9C]">
            <li><a href="/media/downloads" class="sidebar-link">All Downloads & Forms</a></li>
            <li><a href="/stakeholders/vendors/msme-corner" class="sidebar-link">Startups/MSME Corner</a></li>
            <li><a href="/stakeholders/vendors/tender-bids" class="sidebar-link">Tenders & Bids</a></li>
            <li><a href="/stakeholders/vendors/online-payment" class="sidebar-link">Online Payment Gateway</a></li>
          </ul>
        </div>
      </aside>
    </div>
  </div>
</Layout>
