---
import Layout from '../../../layouts/Layout.astro';
---

<Layout 
  title="Tender & Bids - Vendors" 
  description="Active procurement notices, standard bidding documents, and tenders from JKSPDC."
>
  <div class="space-y-6">
    <!-- Breadcrumbs -->
    <nav class="text-xs text-gray-500" aria-label="Breadcrumbs">
      <ol class="flex gap-2">
        <li><a href="/" class="hover:underline">Home</a></li>
        <li>/</li>
        <li><span class="text-gray-400">Stakeholders</span></li>
        <li>/</li>
        <li><span class="text-gray-400">Vendors</span></li>
        <li>/</li>
        <li><span class="font-semibold text-[#003366]">Tender & Bids</span></li>
      </ol>
    </nav>

    <!-- Page Header -->
    <header class="border-b border-gray-200 pb-4">
      <h2 class="text-3xl font-extrabold text-[#003366]">Tender & Bids</h2>
      <p class="text-sm text-gray-600 mt-1">Official registry of active notices inviting tenders (NIT), pre-bid updates, and corrigenda.</p>
    </header>

    <!-- Content -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
      <!-- Main Content -->
      <article class="lg:col-span-2 space-y-6">
        
        <!-- Table Listing of Tenders -->
        <div class="table-wrapper">
          <table class="table-data" aria-label="Registry of Active Tenders">
            <thead>
              <tr>
                <th scope="col" class="w-1/6">NIT Ref No.</th>
                <th scope="col" class="w-2/5">Description of Work</th>
                <th scope="col" class="w-1/6">Est. Bid Value</th>
                <th scope="col" class="w-1/6">Closing Date</th>
                <th scope="col" class="w-1/6">Tender Documents</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td class="font-semibold text-slate-900">NIT/121/JKSPDCL/2026</td>
                <td>DPR, Engineering, and Construction of 15MW Grid-Connected Solar PV Plant in Jammu.</td>
                <td class="font-medium text-slate-800">Rs. 75.0 Crores</td>
                <td class="font-semibold text-orange-600">15-Aug-2026</td>
                <td>
                  <a href="#" class="inline-flex items-center gap-1 text-blue-700 hover:underline font-semibold" aria-label="Download Tender Document NIT 121 PDF 2.4 Megabytes">
                    📄 SBD_NIT121.pdf <span class="text-[10px] text-slate-400 font-normal">(2.4 MB)</span>
                  </a>
                </td>
              </tr>
              <tr>
                <td class="font-semibold text-slate-900">NIT/122/JKSPDCL/2026</td>
                <td>Supply, Installation, and Commissioning of new Telemetry & SCADA automation systems for Baglihar HEP Stage-II (450MW).</td>
                <td class="font-medium text-slate-800">Rs. 12.5 Crores</td>
                <td class="font-semibold text-orange-600">22-Aug-2026</td>
                <td>
                  <a href="#" class="inline-flex items-center gap-1 text-blue-700 hover:underline font-semibold" aria-label="Download Tender Document NIT 122 PDF 1.8 Megabytes">
                    📄 SCADA_NIT122.pdf <span class="text-[10px] text-slate-400 font-normal">(1.8 MB)</span>
                  </a>
                </td>
              </tr>
              <tr>
                <td class="font-semibold text-slate-900">NIT/123/JKSPDCL/2026</td>
                <td>Detailed appraisal and DPR consultancy services for the proposed 390MW Kirthai-I Hydroelectric Project.</td>
                <td class="font-medium text-slate-800">Rs. 3.2 Crores</td>
                <td class="font-semibold text-orange-600">30-Aug-2026</td>
                <td>
                  <a href="#" class="inline-flex items-center gap-1 text-blue-700 hover:underline font-semibold" aria-label="Download Tender Document NIT 123 PDF 3.1 Megabytes">
                    📄 DPR_Kirthai123.pdf <span class="text-[10px] text-slate-400 font-normal">(3.1 MB)</span>
                  </a>
                </td>
              </tr>
              <tr>
                <td class="font-semibold text-slate-900">NIT/124/JKSPDCL/2026</td>
                <td>Renovation, modernization, and restoration works of the historic 4MW Mohra Hydroelectric Plant.</td>
                <td class="font-medium text-slate-800">Rs. 45.0 Crores</td>
                <td class="font-semibold text-orange-600">10-Sep-2026</td>
                <td>
                  <a href="#" class="inline-flex items-center gap-1 text-blue-700 hover:underline font-semibold" aria-label="Download Tender Document NIT 124 PDF 4.5 Megabytes">
                    📄 Rehab_Mohra124.pdf <span class="text-[10px] text-slate-400 font-normal">(4.5 MB)</span>
                  </a>
                </td>
              </tr>
            </tbody>
          </table>
        </div>

        <div class="bg-blue-50 border border-blue-200 text-blue-800 rounded-lg p-5 text-sm shadow-sm flex items-start gap-3">
          <span class="text-xl">ℹ️</span>
          <div>
            <h4 class="font-bold">Important Instructions to Bidders</h4>
            <p class="text-xs text-blue-700 mt-1 leading-relaxed">
              All bids must be submitted online through the J&K e-Procurement Portal. Physical submissions will not be accepted. Bidders are advised to download standard bidding documents and check for any pre-bid corrigenda before final submission.
            </p>
          </div>
        </div>

      </article>

      <!-- Sidebar -->
      <aside class="space-y-4">
        <div class="card-static">
          <h3 class="font-bold text-gray-900 mb-2 border-b border-gray-100 pb-2">Vendor Utilities</h3>
          <ul class="flex flex-col gap-2 text-xs font-semibold text-[#003366]">
            <li><a href="/stakeholders/vendors/vendor-portal" class="hover:underline block py-1">&rarr; Vendor Portal Log-in</a></li>
            <li><a href="/stakeholders/vendors/online-payment" class="hover:underline block py-1">&rarr; Online Payment</a></li>
            <li><a href="/stakeholders/vendors/clpm-portal" class="hover:underline block py-1">&rarr; CLPM Portal</a></li>
          </ul>
        </div>
      </aside>
    </div>
  </div>
</Layout>
