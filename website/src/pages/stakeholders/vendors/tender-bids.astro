---
import Layout from '../../../layouts/Layout.astro';

let tenders = [];
let errorMessage = '';

try {
  const res = await fetch('http://localhost:3000/api/tenders');
  if (res.ok) {
    tenders = await res.json();
    tenders.sort((a, b) => new Date(b.publishDate).getTime() - new Date(a.publishDate).getTime());
  } else {
    errorMessage = 'Failed to load tenders registry.';
  }
} catch (e) {
  errorMessage = 'Failed to connect to the backend server.';
}
---

<Layout 
  title="Procurement & Tenders Portal" 
  description="Active procurement notices, standard bidding documents, corrigendums, awards, and compliance notices from JKSPDCL."
>
  <div class="space-y-6">
    <!-- Breadcrumbs -->
    <nav class="text-xs text-gray-500" aria-label="Breadcrumbs">
      <ol class="flex gap-2">
        <li><a href="/" class="hover:underline">Home</a></li>
        <li>/</li>
        <li><span class="text-gray-400">Stakeholders</span></li>
        <li>/</li>
        <li><span class="text-gray-400">Vendors</span></li>
        <li>/</li>
        <li><span class="font-semibold text-[#0B4F9C]">Procurement Portal</span></li>
      </ol>
    </nav>

    <!-- Page Header -->
    <header class="border-b border-gray-200 pb-4">
      <h2 class="text-3xl font-extrabold text-[#0B4F9C]">Procurement &amp; Tenders Portal</h2>
      <p class="text-sm text-gray-650 mt-1">Official registry of active notices inviting tenders (NIT), pre-bid updates, award disclosures, and vendor compliance logs.</p>
    </header>

    {errorMessage && (
      <div class="bg-red-50 border border-red-200 text-red-800 rounded-lg p-4 text-xs font-semibold">
        {errorMessage}
      </div>
    )}

    <!-- Lifecycle Phase Tabs (4-Tier Classification) -->
    <div class="border-b border-slate-200">
      <nav class="flex gap-1.5 -mb-px flex-wrap" aria-label="Procurement Phases">
        <button data-tab="live" class="tab-btn active-tab px-4 py-2.5 font-bold text-xs border-b-2 border-[#0B4F9C] text-[#0B4F9C] hover:text-[#084A8F] transition-colors focus:outline-none cursor-pointer">
          1. Live Tenders &amp; Notices
        </button>
        <button data-tab="amendments" class="tab-btn px-4 py-2.5 font-bold text-xs border-b-2 border-transparent text-slate-500 hover:text-[#0B4F9C] hover:border-slate-300 transition-colors focus:outline-none cursor-pointer">
          2. Amendments &amp; Clarifications
        </button>
        <button data-tab="awards" class="tab-btn px-4 py-2.5 font-bold text-xs border-b-2 border-transparent text-slate-500 hover:text-[#0B4F9C] hover:border-slate-300 transition-colors focus:outline-none cursor-pointer">
          3. Awards &amp; Compliance
        </button>
        <button data-tab="portals" class="tab-btn px-4 py-2.5 font-bold text-xs border-b-2 border-transparent text-slate-500 hover:text-[#0B4F9C] hover:border-slate-300 transition-colors focus:outline-none cursor-pointer">
          4. Access &amp; Portals
        </button>
      </nav>
    </div>

    <!-- Active Filters & Search (Only shown for dynamic tabs 1, 2, 3) -->
    <div id="filter-bar" class="bg-slate-50 border border-slate-200 rounded-xl p-4 flex flex-col md:flex-row gap-4 items-center">
      <div class="w-full md:w-1/3 flex flex-col gap-1">
        <label for="work-category" class="text-[10px] font-bold text-slate-500 uppercase tracking-wider">Category of Work</label>
        <select id="work-category" class="w-full form-select text-xs bg-white border-slate-200 rounded-lg py-1.5 focus:ring-[#0B4F9C]">
          <option value="All">All Categories</option>
          <option value="Civil">Civil Works</option>
          <option value="Electro-Mechanical">Electro-Mechanical</option>
          <option value="Hydro">Hydro Projects</option>
          <option value="Solar">Solar Projects</option>
          <option value="IT">IT &amp; Telecom</option>
          <option value="Services">General Services</option>
        </select>
      </div>

      <div class="w-full md:w-1/3 flex flex-col gap-1">
        <label for="location-filter" class="text-[10px] font-bold text-slate-500 uppercase tracking-wider">Geographical Location</label>
        <select id="location-filter" class="w-full form-select text-xs bg-white border-slate-200 rounded-lg py-1.5 focus:ring-[#0B4F9C]">
          <option value="All">All Locations</option>
          <option value="HQ_SRINAGAR">HQ Srinagar</option>
          <option value="HQ_JAMMU">HQ Jammu</option>
          <option value="HEP_BAGLIHAR">HEP Baglihar</option>
          <option value="HEP_LOWER_JHELUM">HEP Lower Jhelum</option>
          <option value="HEP_SAWALKOTE">HEP Sawalkote</option>
        </select>
      </div>

      <div class="w-full md:w-1/3 flex flex-col gap-1">
        <label for="search-input" class="text-[10px] font-bold text-slate-500 uppercase tracking-wider">Search Keyword</label>
        <input id="search-input" type="text" placeholder="Ref No / Subject..." class="w-full form-input text-xs bg-white border-slate-200 rounded-lg py-1.5 focus:ring-[#0B4F9C]" />
      </div>
    </div>

    <!-- Content Sections -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
      
      <!-- Main Lists -->
      <article class="lg:col-span-2 space-y-6">

        <!-- Tab 1 Panel: Live Tenders & Notices -->
        <div id="panel-live" class="tab-panel space-y-4">
          <div class="table-wrapper">
            <table class="table-data" aria-label="Registry of Active Tenders">
              <thead>
                <tr>
                  <th scope="col" class="w-1/4">NIT Ref No.</th>
                  <th scope="col" class="w-2/5">Description of Work</th>
                  <th scope="col" class="w-1/6">File Size</th>
                  <th scope="col" class="w-1/6">Closing Date</th>
                  <th scope="col" class="w-1/6">Documents</th>
                </tr>
              </thead>
              <tbody id="live-tenders-body">
                {tenders.filter(t => t.documentType === 'NIT' || t.documentType === 'NIO').length === 0 ? (
                  <tr>
                    <td colspan="5" class="text-center text-slate-500 py-10 text-xs font-semibold">No active tenders or notices found.</td>
                  </tr>
                ) : (
                  tenders.filter(t => t.documentType === 'NIT' || t.documentType === 'NIO').map((t) => (
                    <tr class="tender-row hover:bg-slate-50/80 transition-colors" data-category={t.workCategory} data-location={t.locationTag}>
                      <td class="font-semibold text-slate-900 font-mono text-xs">{t.referenceNo}</td>
                      <td class="px-4 py-3.5 text-left">
                        <div class="font-bold text-slate-800 text-sm leading-snug">{t.title}</div>
                        {t.description && <div class="text-[10px] text-slate-500 mt-1 font-medium leading-relaxed">{t.description}</div>}
                        <div class="flex items-center gap-1.5 mt-2 flex-wrap">
                          <span class="px-1.5 py-0.5 rounded bg-blue-50 border border-blue-100 text-[#0B4F9C] text-[9px] font-bold uppercase">{t.documentType}</span>
                          <span class="px-1.5 py-0.5 rounded bg-purple-50 border border-purple-100 text-purple-700 text-[9px] font-bold">{t.workCategory}</span>
                          <span class="px-1.5 py-0.5 rounded bg-slate-100 text-slate-600 text-[9px] font-bold uppercase font-mono">{t.locationTag?.replace('HQ_', 'HQ ')}</span>
                        </div>
                      </td>
                      <td class="font-medium text-slate-700 text-xs whitespace-nowrap font-mono">
                        {t.fileSizeBytes ? `${(t.fileSizeBytes / 1024).toFixed(0)} KB` : 'N/A'}
                      </td>
                      <td class="font-semibold text-orange-650 text-xs whitespace-nowrap">
                        {t.closingDate ? new Date(t.closingDate).toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric' }) : '—'}
                      </td>
                      <td class="whitespace-nowrap">
                        <a href={t.documentUrl} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1 text-[#0B4F9C] hover:underline font-bold text-xs" aria-label={`Download Document for ${t.referenceNo}`}>
                          📄 PDF
                        </a>
                      </td>
                    </tr>
                  ))
                )}
              </tbody>
            </table>
          </div>
        </div>

        <!-- Tab 2 Panel: Amendments & Clarifications -->
        <div id="panel-amendments" class="tab-panel hidden space-y-4">
          <div class="table-wrapper">
            <table class="table-data" aria-label="Tender Corrigendums and Addendums">
              <thead>
                <tr>
                  <th scope="col" class="w-1/4">Amendment Ref No.</th>
                  <th scope="col" class="w-2/5">Clarification Subject</th>
                  <th scope="col" class="w-1/6">File Size</th>
                  <th scope="col" class="w-1/6">Issued Date</th>
                  <th scope="col" class="w-1/6">Documents</th>
                </tr>
              </thead>
              <tbody id="corrigendum-body">
                {tenders.filter(t => t.documentType === 'CORRIGENDUM').length === 0 ? (
                  <tr>
                    <td colspan="5" class="text-center text-slate-500 py-10 text-xs font-semibold">No tender corrigendums or addendums found.</td>
                  </tr>
                ) : (
                  tenders.filter(t => t.documentType === 'CORRIGENDUM').map((t) => (
                    <tr class="tender-row hover:bg-slate-50/80 transition-colors" data-category={t.workCategory} data-location={t.locationTag}>
                      <td class="font-semibold text-slate-900 font-mono text-xs">{t.referenceNo}</td>
                      <td class="px-4 py-3.5 text-left">
                        <div class="font-bold text-slate-800 text-sm leading-snug">{t.title}</div>
                        {t.description && <div class="text-[10px] text-slate-500 mt-1 font-medium leading-relaxed">{t.description}</div>}
                        <div class="flex items-center gap-1.5 mt-2 flex-wrap">
                          <span class="px-1.5 py-0.5 rounded bg-amber-50 border border-amber-100 text-amber-705 text-amber-750 text-amber-800 text-[9px] font-bold uppercase font-mono">CORRIGENDUM</span>
                          <span class="px-1.5 py-0.5 rounded bg-purple-50 border border-purple-100 text-purple-700 text-[9px] font-bold">{t.workCategory}</span>
                          <span class="px-1.5 py-0.5 rounded bg-slate-100 text-slate-600 text-[9px] font-bold uppercase font-mono">{t.locationTag?.replace('HQ_', 'HQ ')}</span>
                        </div>
                      </td>
                      <td class="font-medium text-slate-700 text-xs whitespace-nowrap font-mono">
                        {t.fileSizeBytes ? `${(t.fileSizeBytes / 1024).toFixed(0)} KB` : 'N/A'}
                      </td>
                      <td class="font-semibold text-slate-500 text-xs whitespace-nowrap">
                        {new Date(t.publishDate).toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric' })}
                      </td>
                      <td class="whitespace-nowrap">
                        <a href={t.documentUrl} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1 text-[#0B4F9C] hover:underline font-bold text-xs" aria-label={`Download Amendment document for ${t.referenceNo}`}>
                          📄 PDF
                        </a>
                      </td>
                    </tr>
                  ))
                )}
              </tbody>
            </table>
          </div>
        </div>

        <!-- Tab 3 Panel: Awards & Compliance -->
        <div id="panel-awards" class="tab-panel hidden space-y-4">
          <div class="table-wrapper">
            <table class="table-data" aria-label="Contracts Awarded and Debarred Firms List">
              <thead>
                <tr>
                  <th scope="col" class="w-1/4">Reference No.</th>
                  <th scope="col" class="w-2/5">Subject Description</th>
                  <th scope="col" class="w-1/6">Compliance Type</th>
                  <th scope="col" class="w-1/6">Date Published</th>
                  <th scope="col" class="w-1/6">Download</th>
                </tr>
              </thead>
              <tbody id="awards-body">
                {tenders.filter(t => t.documentType === 'CONTRACT_AWARD' || t.documentType === 'BANNED_FIRM').length === 0 ? (
                  <tr>
                    <td colspan="5" class="text-center text-slate-500 py-10 text-xs font-semibold">No awards or debarment compliance notices found.</td>
                  </tr>
                ) : (
                  tenders.filter(t => t.documentType === 'CONTRACT_AWARD' || t.documentType === 'BANNED_FIRM').map((t) => (
                    <tr class="tender-row hover:bg-slate-50/80 transition-colors" data-category={t.workCategory} data-location={t.locationTag}>
                      <td class="font-semibold text-slate-900 font-mono text-xs">{t.referenceNo}</td>
                      <td class="px-4 py-3.5 text-left">
                        <div class="font-bold text-slate-800 text-sm leading-snug">{t.title}</div>
                        {t.description && <div class="text-[10px] text-slate-500 mt-1 font-medium leading-relaxed">{t.description}</div>}
                        <div class="flex items-center gap-1.5 mt-2 flex-wrap">
                          <span class={`px-1.5 py-0.5 rounded text-[9px] font-bold uppercase ${
                            t.documentType === 'CONTRACT_AWARD' ? 'bg-emerald-50 border border-emerald-100 text-emerald-700' : 'bg-red-50 border border-red-100 text-red-700'
                          }`}>
                            {t.documentType === 'CONTRACT_AWARD' ? 'Award Log' : 'Banned Firm'}
                          </span>
                          <span class="px-1.5 py-0.5 rounded bg-purple-50 border border-purple-100 text-purple-700 text-[9px] font-bold">{t.workCategory}</span>
                          <span class="px-1.5 py-0.5 rounded bg-slate-100 text-slate-600 text-[9px] font-bold uppercase font-mono">{t.locationTag?.replace('HQ_', 'HQ ')}</span>
                        </div>
                      </td>
                      <td class="font-semibold text-xs whitespace-nowrap">
                        <span class={t.documentType === 'CONTRACT_AWARD' ? 'text-emerald-700' : 'text-red-700'}>
                          {t.documentType === 'CONTRACT_AWARD' ? 'Award Details' : 'Blacklist'}
                        </span>
                      </td>
                      <td class="font-semibold text-slate-500 text-xs whitespace-nowrap">
                        {new Date(t.publishDate).toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric' })}
                      </td>
                      <td class="whitespace-nowrap">
                        <a href={t.documentUrl} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1 text-[#0B4F9C] hover:underline font-bold text-xs">
                          📄 Download
                        </a>
                      </td>
                    </tr>
                  ))
                )}
              </tbody>
            </table>
          </div>
        </div>

        <!-- Tab 4 Panel: Portals & Navigation -->
        <div id="panel-portals" class="tab-panel hidden space-y-6">
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            
            <div class="card-static flex flex-col justify-between p-6">
              <div>
                <span class="text-[10px] text-[#0B4F9C] font-bold uppercase tracking-wider bg-[#EAF4FF] px-2 py-0.5 rounded border border-[#BDD7EE]/50 inline-block mb-3">eProcurement Services</span>
                <h4 class="font-extrabold text-slate-900 text-base">J&amp;K Government e-Procurement Portal</h4>
                <p class="text-xs text-slate-500 mt-2 leading-relaxed">Direct gateway to register as a contractor, upload online bids, and participate in electronic auctions.</p>
              </div>
              <a href="https://jktenders.gov.in" target="_blank" rel="noopener noreferrer" class="mt-5 inline-flex items-center justify-center py-2.5 bg-[#0B4F9C] hover:bg-[#084A8F] text-[11px] font-bold text-white rounded-lg transition-colors shadow-sm">
                Access jktenders.gov.in &rarr;
              </a>
            </div>

            <div class="card-static flex flex-col justify-between p-6">
              <div>
                <span class="text-[10px] text-green-700 font-bold uppercase tracking-wider bg-green-50 px-2 py-0.5 rounded border border-green-200 inline-block mb-3">GeM Bidding</span>
                <h4 class="font-extrabold text-slate-900 text-base">Government e-Marketplace (GeM)</h4>
                <p class="text-xs text-slate-500 mt-2 leading-relaxed">Direct pathway for supply tenders, standard office furniture, computer accessories, and generic service contracts.</p>
              </div>
              <a href="https://gem.gov.in" target="_blank" rel="noopener noreferrer" class="mt-5 inline-flex items-center justify-center py-2.5 bg-green-700 hover:bg-green-800 text-[11px] font-bold text-white rounded-lg transition-colors shadow-sm">
                Access GeM Portal &rarr;
              </a>
            </div>

            <div class="card-static flex flex-col justify-between p-6 md:col-span-2">
              <div>
                <span class="text-[10px] text-purple-700 font-bold uppercase tracking-wider bg-purple-50 px-2 py-0.5 rounded border border-purple-200 inline-block mb-3">Contractor Login</span>
                <h4 class="font-extrabold text-slate-900 text-base">Tenderer / Vendor Login Dashboard</h4>
                <p class="text-xs text-slate-500 mt-2 leading-relaxed">Secure gateway to access payment reconciliations, performance certificates, and internal vendor alerts.</p>
              </div>
              <a href="/stakeholders/vendors/vendor-portal" class="mt-5 inline-flex items-center justify-center py-2.5 bg-[#08305C] hover:bg-[#062241] text-[11px] font-bold text-white rounded-lg transition-colors shadow-sm">
                Access Vendor Dashboard &rarr;
              </a>
            </div>
          </div>
        </div>

      </article>

      <!-- Sidebar -->
      <aside class="space-y-4" aria-label="Related links">
        <div class="card-static">
          <h3 class="font-bold text-gray-900 mb-2 border-b border-gray-100 pb-2">Vendor Utilities</h3>
          <ul class="flex flex-col gap-2 text-xs font-semibold text-[#0B4F9C]">
            <li><a href="/stakeholders/vendors/vendor-portal" class="hover:underline block py-1">&rarr; Vendor Portal Log-in</a></li>
            <li><a href="/stakeholders/vendors/online-payment" class="hover:underline block py-1">&rarr; Online Payment</a></li>
            <li><a href="/stakeholders/vendors/clpm-portal" class="hover:underline block py-1">&rarr; CLPM Portal</a></li>
          </ul>
        </div>
        
        <div class="bg-blue-50 border border-blue-200 text-blue-800 rounded-lg p-5 text-sm shadow-sm flex items-start gap-3">
          <span class="text-xl" aria-hidden="true">ℹ️</span>
          <div>
            <h4 class="font-bold">Important Bidding Instructions</h4>
            <p class="text-xs text-blue-700 mt-1 leading-relaxed">
              All bids must be submitted online through the J&K e-Procurement Portal. Physical submissions will not be accepted. Bidders are advised to download standard bidding documents and check for corrigenda before final submission.
            </p>
          </div>
        </div>
      </aside>
    </div>
  </div>
</Layout>

<script>
  // Tabs & Search functionality
  document.addEventListener('DOMContentLoaded', () => {
    const tabBtns = document.querySelectorAll('.tab-btn');
    const panels = document.querySelectorAll('.tab-panel');
    const filterBar = document.getElementById('filter-bar');
    
    const catSelect = document.getElementById('work-category') as HTMLSelectElement;
    const locSelect = document.getElementById('location-filter') as HTMLSelectElement;
    const searchInput = document.getElementById('search-input') as HTMLInputElement;

    // Tab Switching
    tabBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const targetTab = btn.getAttribute('data-tab');
        
        // Update active button styles
        tabBtns.forEach(b => {
          b.classList.remove('active-tab', 'border-[#0B4F9C]', 'text-[#0B4F9C]');
          b.classList.add('border-transparent', 'text-slate-500');
        });
        btn.classList.add('active-tab', 'border-[#0B4F9C]', 'text-[#0B4F9C]');
        btn.classList.remove('border-transparent', 'text-slate-500');

        // Toggle panels
        panels.forEach(panel => {
          if (panel.id === `panel-${targetTab}`) {
            panel.classList.remove('hidden');
          } else {
            panel.classList.add('hidden');
          }
        });

        // Hide filter bar for Portals tab
        if (targetTab === 'portals') {
          filterBar?.classList.add('hidden');
        } else {
          filterBar?.classList.remove('hidden');
        }

        // Reset filter inputs on tab switch to show all rows first
        if (catSelect) catSelect.value = 'All';
        if (locSelect) locSelect.value = 'All';
        if (searchInput) searchInput.value = '';
        filterRows();
      });
    });

    // Real-time filtering function
    function filterRows() {
      const selectedCat = catSelect ? catSelect.value : 'All';
      const selectedLoc = locSelect ? locSelect.value : 'All';
      const query = searchInput ? searchInput.value.toLowerCase().trim() : '';

      const activePanel = document.querySelector('.tab-panel:not(.hidden)');
      if (!activePanel) return;

      const rows = activePanel.querySelectorAll('.tender-row');
      
      rows.forEach((row: any) => {
        const cat = row.getAttribute('data-category') || 'Civil';
        const loc = row.getAttribute('data-location') || 'HQ_SRINAGAR';
        const textContent = row.textContent.toLowerCase();

        const matchesCat = selectedCat === 'All' || cat === selectedCat;
        const matchesLoc = selectedLoc === 'All' || loc === selectedLoc;
        const matchesSearch = query === '' || textContent.includes(query);

        if (matchesCat && matchesLoc && matchesSearch) {
          row.classList.remove('hidden');
        } else {
          row.classList.add('hidden');
        }
      });
    }

    // Bind event listeners
    catSelect?.addEventListener('change', filterRows);
    locSelect?.addEventListener('change', filterRows);
    searchInput?.addEventListener('input', filterRows);

    // Hash change handler for external links
    const handleHash = () => {
      const hash = window.location.hash.substring(1);
      if (hash && ['live', 'amendments', 'awards', 'portals'].includes(hash)) {
        const targetBtn = document.querySelector(`[data-tab="${hash}"]`) as HTMLButtonElement;
        if (targetBtn) {
          targetBtn.click();
        }
      }
    };

    // Initial check on load
    handleHash();
    window.addEventListener('hashchange', handleHash);
  });
</script>
