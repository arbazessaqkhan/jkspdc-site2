---
import Layout from '../../../layouts/Layout.astro';
import Icon from '../../../components/Icon.astro';

let tenders = [];
let errorMessage = '';

// Map-grouping tenders variables
let processedTenders = [];
let awardsAndBanned = [];
let recentCorrigendums = [];

try {
  const res = await fetch('http://localhost:3000/api/tenders');
  if (res.ok) {
    tenders = await res.json();
    
    // Process tenders and gather corrigendums for sidebar
    const allCorrigendums: any[] = [];

    tenders.forEach((t: any) => {
      if (t.documentType === 'NIT' || t.documentType === 'NIO' || t.documentType === 'CONTRACT_AWARD' || t.documentType === 'BANNED_FIRM') {
        const corrs = t.corrigendums && Array.isArray(t.corrigendums) ? [...t.corrigendums] : [];
        
        // Sort corrigendums inside the tender chronologically (oldest first)
        corrs.sort((a: any, b: any) => new Date(a.publishDate).getTime() - new Date(b.publishDate).getTime());

        let latestActivityDate = new Date(t.publishDate).getTime();
        let latestCorrigendumTitle = null;

        corrs.forEach((corr: any) => {
          allCorrigendums.push({
            ...corr,
            parentTenderId: t.id,
            parentReferenceNo: t.referenceNo,
            parentTitle: t.title,
          });

          const corrTime = new Date(corr.publishDate).getTime();
          if (corrTime > latestActivityDate) {
            latestActivityDate = corrTime;
            latestCorrigendumTitle = corr.title;
          }
        });

        processedTenders.push({
          ...t,
          corrigendums: corrs,
          latestActivityDate,
          latestCorrigendumTitle,
        });
      }
      
      if (t.documentType === 'CONTRACT_AWARD' || t.documentType === 'BANNED_FIRM') {
        awardsAndBanned.push(t);
      }
    });

    // Sort tenders by latest activity date descending
    processedTenders.sort((a: any, b: any) => b.latestActivityDate - a.latestActivityDate);

    // Sort recent corrigendums by publish date descending
    allCorrigendums.sort((a: any, b: any) => new Date(b.publishDate).getTime() - new Date(a.publishDate).getTime());
    recentCorrigendums = allCorrigendums.slice(0, 5);

    // Also sort awardsAndBanned by publish date desc
    awardsAndBanned.sort((a, b) => new Date(b.publishDate).getTime() - new Date(a.publishDate).getTime());

  } else {
    errorMessage = 'Failed to load tenders registry.';
  }
} catch (e) {
  console.error('Error fetching/processing public tenders:', e);
  errorMessage = 'Failed to connect to the backend server.';
}

const getDocUrl = (url?: string) => {
  if (!url) return '#';
  if (url.startsWith('/uploads/')) {
    return `http://localhost:3000${url}`;
  }
  return url;
};

const tenderYears = Array.from(new Set(processedTenders.map((t: any) => new Date(t.publishDate).getFullYear()))).sort((a: any, b: any) => b - a);

const defaultLocations = [
  'HQ Srinagar',
  'HQ Jammu',
  'HEP Baglihar',
  'HEP Lower Jhelum',
  'HEP Sawalkote',
  'Kirthai HEP Stage-1'
];
const allFilterLocations = Array.from(new Set([
  ...processedTenders.map((t: any) => t.locationTag).filter(Boolean),
  ...defaultLocations
])).sort((a, b) => a.localeCompare(b));
---

<Layout 
  title="Procurement & Tenders Portal" 
  description="Active procurement notices, standard bidding documents, corrigendums, awards, and compliance notices from JKSPDCL."
>
  <div class="space-y-0 max-w-5xl mx-auto">
    <!-- Premium Page Header Band -->
    <div class="page-header-band animate-fadeInUp">
      <nav class="breadcrumb-trail" aria-label="Breadcrumbs">
        <a href="/">Home</a>
        <span class="separator">/</span>
        <span class="current">Tenders</span>
      </nav>
      <h1>Procurement & Tenders Portal</h1>
      <p class="page-subtitle">Jammu &amp; Kashmir State Power Development Corporation Limited (JKSPDCL)</p>
    </div>

    <div class="space-y-8">

    {errorMessage && (
      <div class="bg-red-50 border border-red-200 text-red-800 rounded-lg p-4 text-xs font-semibold">
        {errorMessage}
      </div>
    )}

    <!-- Dynamic Segregation & Filter Bar -->
    <div id="filter-bar" class="bg-slate-50 border border-slate-200 rounded-xl p-5 space-y-4">
      <div class="flex items-center justify-between border-b border-slate-200 pb-3">
        <h3 class="text-xs font-extrabold text-slate-800 uppercase tracking-wider flex items-center gap-2">
          <span>🔍</span> Segregate &amp; Filter Tenders
        </h3>
        <div class="text-xs font-semibold text-slate-500" id="tenders-count-display">
          Showing {processedTenders.length} tender(s)
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <!-- Filter By Project / Location -->
        <div class="flex flex-col gap-1">
          <label for="location-filter" class="text-[10px] font-bold text-slate-500 uppercase tracking-wider">By Project / Location</label>
          <select id="location-filter" class="w-full form-select text-xs bg-white border border-slate-200 rounded-lg py-1.5 focus:ring-2 focus:ring-[#0B4F9C]">
            <option value="All">All Projects &amp; Locations</option>
            {allFilterLocations.map((loc: string) => {
              const label = loc.replace(/^HQ_/i, 'HQ ').replace(/^HEP_/i, 'HEP ').replace(/_/g, ' ');
              return <option value={loc}>{label}</option>;
            })}
          </select>
        </div>

        <!-- Filter By Work Category -->
        <div class="flex flex-col gap-1">
          <label for="work-category" class="text-[10px] font-bold text-slate-500 uppercase tracking-wider">By Work Category</label>
          <select id="work-category" class="w-full form-select text-xs bg-white border border-slate-200 rounded-lg py-1.5 focus:ring-2 focus:ring-[#0B4F9C]">
            <option value="All">All Categories</option>
            <option value="Civil">Civil Works</option>
            <option value="Electro-Mechanical">Electro-Mechanical</option>
            <option value="Hydro">Hydro Projects</option>
            <option value="Solar">Solar Projects</option>
            <option value="IT">IT &amp; Telecom</option>
            <option value="Services">General Services</option>
          </select>
        </div>

        <!-- Filter By Published Year / Date -->
        <div class="flex flex-col gap-1">
          <label for="year-filter" class="text-[10px] font-bold text-slate-500 uppercase tracking-wider">By Published Year</label>
          <select id="year-filter" class="w-full form-select text-xs bg-white border border-slate-200 rounded-lg py-1.5 focus:ring-2 focus:ring-[#0B4F9C]">
            <option value="All">All Years</option>
            {tenderYears.map((yr: any) => (
              <option value={String(yr)}>{yr}</option>
            ))}
          </select>
        </div>

        <!-- Filter By Keyword / Tender ID / NIT No -->
        <div class="flex flex-col gap-1">
          <label for="search-input" class="text-[10px] font-bold text-slate-500 uppercase tracking-wider">By Tender ID / NIT / Keyword</label>
          <input 
            id="search-input" 
            type="text" 
            placeholder="Tender ID, NIT No, Title..." 
            class="w-full form-input text-xs bg-white border border-slate-200 rounded-lg py-1.5 px-3 focus:outline-none focus:ring-2 focus:ring-[#0B4F9C]" 
          />
        </div>
      </div>
    </div>

    <!-- Active vs Archives vs All Status Tabs -->
    <div class="flex items-center justify-between border-b border-slate-200 pb-4 select-none">
      <span class="text-xs font-bold text-slate-600">Status Segregation:</span>
      <div class="flex items-center gap-2">
        <button id="toggle-active" class="px-4 py-1.5 border rounded-md font-bold text-xs bg-[#0D7A87] text-white border-[#0D7A87] cursor-pointer shadow-sm transition-all duration-200">
          Active Tenders
        </button>
        <button id="toggle-archive" class="px-4 py-1.5 border rounded-md font-bold text-xs bg-white text-[#0D7A87] border-[#0D7A87] hover:bg-slate-50 cursor-pointer shadow-sm transition-all duration-200">
          Archives
        </button>
        <button id="toggle-all" class="px-4 py-1.5 border rounded-md font-bold text-xs bg-white text-slate-700 border-slate-300 hover:bg-slate-50 cursor-pointer shadow-sm transition-all duration-200">
          All Statuses
        </button>
      </div>
    </div>

    <!-- Content Sections -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
      
      <!-- Main Tenders List -->
      <article class="lg:col-span-2 space-y-4">
        <div id="tenders-list-container" class="space-y-4">
          {processedTenders.map((tender: any) => (
            <div 
              class="flex flex-col md:flex-row md:items-center justify-between gap-4 p-6 bg-white border border-slate-200 rounded-xl shadow-sm hover:shadow-md hover:-translate-y-0.5 transition-all duration-300 tender-card" 
              data-status={tender.status} 
              data-category={tender.workCategory} 
              data-location={tender.locationTag}
              data-year={new Date(tender.publishDate).getFullYear()}
              data-search-keys={`${(tender.id || '').toLowerCase()} ${(tender.referenceNo || '').toLowerCase()} ${(tender.title || '').toLowerCase()} ${(tender.workCategory || '').toLowerCase()} ${(tender.locationTag || '').toLowerCase()} ${(tender.documentType || '').toLowerCase()} ${(tender.description || '').toLowerCase()} ${(tender.corrigendums || []).map((c: any) => `${c.title} ${c.id || ''}`).join(' ').toLowerCase()}`}
            >
              <div class="space-y-2 text-left flex-1 min-w-0">
                <div>
                  <span class="font-extrabold text-slate-800 text-sm">Tender Title : </span>
                  <span class="text-slate-700 text-sm font-medium leading-relaxed">{tender.title}</span>
                </div>
                <div>
                  <span class="font-extrabold text-slate-800 text-sm">NIT No. : </span>
                  <span class="text-slate-700 text-sm font-semibold font-mono">{tender.referenceNo}</span>
                </div>
                {tender.corrigendums && tender.corrigendums.length > 0 && (
                  <div class="mt-2.5 pt-2.5 border-t border-slate-100">
                    <span class="font-extrabold text-slate-850 text-xs block mb-1">Attached Corrigendums:</span>
                    <div class="flex flex-col gap-1.5">
                      {tender.corrigendums.map((c: any) => (
                        <a 
                          href={`/stakeholders/vendors/tender-details?id=${tender.id}#corrigendum-${c.id}`} 
                          class="text-xs font-bold text-[#0D7A87] hover:underline flex items-center gap-1.5"
                        >
                          <span class="shrink-0">📎</span>
                          <span class="truncate">{c.title}</span>
                        </a>
                      ))}
                    </div>
                  </div>
                )}
                <div>
                  <span class="font-extrabold text-slate-800 text-sm">Location : </span>
                  <span class="text-slate-700 text-sm font-medium">{tender.locationTag?.replace('HQ_', 'HQ ')?.replace('HEP_', 'HEP ')?.replace('_', ' ')}</span>
                </div>
              </div>
              <div class="flex-shrink-0 flex items-center justify-end md:justify-center">
                <a 
                  href={`/stakeholders/vendors/tender-details?id=${tender.id}`} 
                  class="w-full md:w-auto inline-flex items-center justify-center px-6 py-2 border border-[#0D7A87] text-[#0D7A87] hover:bg-[#0D7A87] hover:text-white rounded text-xs font-bold transition-all duration-200 whitespace-nowrap"
                >
                  View More
                </a>
              </div>
            </div>
          ))}

          <!-- Empty State -->
          <div id="empty-state-container" class="hidden text-center py-12 bg-slate-50 border border-slate-200 border-dashed rounded-xl text-slate-400 font-semibold italic text-xs">
            No active or archived tenders found matching the filters.
          </div>
        </div>
      </article>

      <!-- Sidebar -->
      <aside class="space-y-4" aria-label="Related links">
        <div class="card-static">
          <h3 class="font-bold text-gray-900 mb-2 border-b border-gray-100 pb-2">Vendor Utilities</h3>
          <ul class="flex flex-col gap-2 text-xs font-semibold text-[#0B4F9C]">
            <li><a href="/stakeholders/vendors/vendor-portal" class="hover:underline block py-1">&rarr; Vendor Portal Log-in</a></li>
            <li><a href="/stakeholders/vendors/online-payment" class="hover:underline block py-1">&rarr; Online Payment</a></li>
            <li><a href="/stakeholders/vendors/clpm-portal" class="hover:underline block py-1">&rarr; CLPM Portal</a></li>
          </ul>
        </div>

        <div class="card-static">
          <h3 class="font-bold text-gray-900 mb-2 border-b border-gray-100 pb-2 flex items-center gap-1.5">
            <span class="text-[#0D7A87]">📢</span> Recent Corrigenda
          </h3>
          {recentCorrigendums.length === 0 ? (
            <p class="text-slate-400 italic text-[11px]">No recent updates published.</p>
          ) : (
            <ul class="flex flex-col gap-3 text-xs">
              {recentCorrigendums.map((corr: any) => (
                <li class="border-b border-slate-100 pb-2 last:border-0 last:pb-0">
                  <a 
                    href={`/stakeholders/vendors/tender-details?id=${corr.parentTenderId}#corrigendum-${corr.id}`} 
                    class="font-bold text-slate-800 hover:text-[#0B4F9C] hover:underline leading-snug block"
                  >
                    {corr.title}
                  </a>
                  <span class="text-[10px] text-[#0D7A87] font-semibold block mt-0.5 uppercase tracking-wide">
                    Ref: {corr.parentReferenceNo}
                  </span>
                </li>
              ))}
            </ul>
          )}
        </div>
        
        <div class="bg-blue-50 border border-blue-200 text-blue-800 rounded-lg p-5 text-sm shadow-sm flex items-start gap-3">
          <span class="text-xl" aria-hidden="true">ℹ️</span>
          <div>
            <h4 class="font-bold text-xs">Important Bidding Instructions</h4>
            <p class="text-[11px] text-blue-755 mt-1 leading-relaxed">
              All bids must be submitted online through the J&K e-Procurement Portal. Physical submissions will not be accepted. Bidders are advised to download standard bidding documents and check for corrigenda before final submission.
            </p>
          </div>
        </div>
      </aside>
    </div>


  </div>
</Layout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const toggleActive = document.getElementById('toggle-active');
    const toggleArchive = document.getElementById('toggle-archive');
    const toggleAll = document.getElementById('toggle-all');
    
    const catSelect = document.getElementById('work-category') as HTMLSelectElement;
    const locSelect = document.getElementById('location-filter') as HTMLSelectElement;
    const yearSelect = document.getElementById('year-filter') as HTMLSelectElement;
    const searchInput = document.getElementById('search-input') as HTMLInputElement;
    const countDisplay = document.getElementById('tenders-count-display');

    let currentStatusFilter = 'Active'; // Active, Archived, or All

    function setTabStyles(activeTab: string) {
      currentStatusFilter = activeTab;
      
      const activeBtnClass = 'px-4 py-1.5 border rounded-md font-bold text-xs bg-[#0D7A87] text-white border-[#0D7A87] cursor-pointer shadow-sm transition-all duration-200';
      const inactiveBtnClass = 'px-4 py-1.5 border rounded-md font-bold text-xs bg-white text-[#0D7A87] border-[#0D7A87] hover:bg-slate-50 cursor-pointer shadow-sm transition-all duration-200';
      const inactiveAllBtnClass = 'px-4 py-1.5 border rounded-md font-bold text-xs bg-white text-slate-700 border-slate-300 hover:bg-slate-50 cursor-pointer shadow-sm transition-all duration-200';

      if (toggleActive) toggleActive.className = activeTab === 'Active' ? activeBtnClass : inactiveBtnClass;
      if (toggleArchive) toggleArchive.className = activeTab === 'Archived' ? activeBtnClass : inactiveBtnClass;
      if (toggleAll) toggleAll.className = activeTab === 'All' ? activeBtnClass : inactiveAllBtnClass;
      
      filterCards();
    }

    toggleActive?.addEventListener('click', () => setTabStyles('Active'));
    toggleArchive?.addEventListener('click', () => setTabStyles('Archived'));
    toggleAll?.addEventListener('click', () => setTabStyles('All'));

    // Real-time filtering function
    function filterCards() {
      const selectedCat = catSelect ? catSelect.value : 'All';
      const selectedLoc = locSelect ? locSelect.value : 'All';
      const selectedYr = yearSelect ? yearSelect.value : 'All';
      const query = searchInput ? searchInput.value.toLowerCase().trim() : '';

      const cards = document.querySelectorAll('.tender-card');
      let visibleCount = 0;
      
      cards.forEach((card: any) => {
        const status = card.getAttribute('data-status') || 'Active';
        const cat = card.getAttribute('data-category') || 'Civil';
        const loc = card.getAttribute('data-location') || 'HQ_SRINAGAR';
        const yr = card.getAttribute('data-year') || '';
        const searchKeys = card.getAttribute('data-search-keys') || '';

        const matchesTab = currentStatusFilter === 'All' || status === currentStatusFilter;
        const matchesCat = selectedCat === 'All' || cat === selectedCat;
        const matchesLoc = selectedLoc === 'All' || loc === selectedLoc;
        const matchesYr = selectedYr === 'All' || yr === selectedYr;
        const matchesSearch = query === '' || searchKeys.includes(query);

        if (matchesTab && matchesCat && matchesLoc && matchesYr && matchesSearch) {
          card.classList.remove('hidden');
          visibleCount++;
        } else {
          card.classList.add('hidden');
        }
      });

      // Update empty state
      const emptyState = document.getElementById('empty-state-container');
      if (visibleCount === 0) {
        emptyState?.classList.remove('hidden');
      } else {
        emptyState?.classList.add('hidden');
      }

      if (countDisplay) {
        countDisplay.textContent = `Showing ${visibleCount} tender(s)`;
      }
    }

    // Bind event listeners
    catSelect?.addEventListener('change', filterCards);
    locSelect?.addEventListener('change', filterCards);
    yearSelect?.addEventListener('change', filterCards);
    searchInput?.addEventListener('input', filterCards);

    // Initial filter run
    filterCards();
  });
</script>
