---
import Layout from '../../../layouts/Layout.astro';
import Icon from '../../../components/Icon.astro';

let tenders = [];
let errorMessage = '';

// Map-grouping tenders variables
let processedTenders = [];
let awardsAndBanned = [];

try {
  const res = await fetch('http://localhost:3000/api/tenders');
  if (res.ok) {
    tenders = await res.json();
    
    // Group corrigendums under parent tenders and compute latest activity date
    const parentTendersMap = {};
    const corrigendums = [];

    tenders.forEach(t => {
      if (t.documentType === 'NIT' || t.documentType === 'NIO') {
        parentTendersMap[t.id] = {
          ...t,
          corrigendums: [],
          latestActivityDate: new Date(t.publishDate).getTime(),
          latestCorrigendumTitle: null,
        };
      } else if (t.documentType === 'CORRIGENDUM') {
        corrigendums.push(t);
      } else if (t.documentType === 'CONTRACT_AWARD' || t.documentType === 'BANNED_FIRM') {
        awardsAndBanned.push(t);
      }
    });

    // Link corrigendums to parent tenders
    corrigendums.forEach(corr => {
      if (corr.parentTenderId && parentTendersMap[corr.parentTenderId]) {
        const parent = parentTendersMap[corr.parentTenderId];
        parent.corrigendums.push(corr);
        
        const corrTime = new Date(corr.publishDate).getTime();
        if (corrTime > parent.latestActivityDate) {
          parent.latestActivityDate = corrTime;
          parent.latestCorrigendumTitle = corr.title; // e.g. "Corrigendum-I" or "Corrigendum-II"
        }
      }
    });

    // Convert map to list and sort by latest activity date descending
    processedTenders = Object.values(parentTendersMap).sort(
      (a: any, b: any) => b.latestActivityDate - a.latestActivityDate
    );

    // Also sort awardsAndBanned by publish date desc
    awardsAndBanned.sort((a, b) => new Date(b.publishDate).getTime() - new Date(a.publishDate).getTime());

  } else {
    errorMessage = 'Failed to load tenders registry.';
  }
} catch (e) {
  console.error('Error fetching/processing public tenders:', e);
  errorMessage = 'Failed to connect to the backend server.';
}
---

<Layout 
  title="Procurement & Tenders Portal" 
  description="Active procurement notices, standard bidding documents, corrigendums, awards, and compliance notices from JKSPDCL."
>
  <div class="space-y-8">
    <!-- Breadcrumbs -->
    <nav class="text-xs text-gray-500" aria-label="Breadcrumbs">
      <ol class="flex gap-2">
        <li><a href="/" class="hover:underline">Home</a></li>
        <li>/</li>
        <li><span class="text-gray-400">Stakeholders</span></li>
        <li>/</li>
        <li><span class="text-gray-400">Vendors</span></li>
        <li>/</li>
        <li><span class="font-semibold text-[#0B4F9C]">Procurement Portal</span></li>
      </ol>
    </nav>

    <!-- Page Header -->
    <header class="border-b border-gray-200 pb-4">
      <h2 class="text-3xl font-extrabold text-[#0B4F9C]">Procurement &amp; Tenders Portal</h2>
      <p class="text-sm text-gray-650 mt-1">Official registry of active notices inviting tenders (NIT), pre-bid updates, award disclosures, and corrigenda.</p>
    </header>

    {errorMessage && (
      <div class="bg-red-50 border border-red-200 text-red-800 rounded-lg p-4 text-xs font-semibold">
        {errorMessage}
      </div>
    )}

    <!-- Dynamic Filters & Search -->
    <div id="filter-bar" class="bg-slate-50 border border-slate-200 rounded-xl p-4 flex flex-col md:flex-row gap-4 items-center">
      <div class="w-full md:w-1/3 flex flex-col gap-1">
        <label for="work-category" class="text-[10px] font-bold text-slate-500 uppercase tracking-wider">Category of Work</label>
        <select id="work-category" class="w-full form-select text-xs bg-white border-slate-200 rounded-lg py-1.5 focus:ring-[#0B4F9C]">
          <option value="All">All Categories</option>
          <option value="Civil">Civil Works</option>
          <option value="Electro-Mechanical">Electro-Mechanical</option>
          <option value="Hydro">Hydro Projects</option>
          <option value="Solar">Solar Projects</option>
          <option value="IT">IT &amp; Telecom</option>
          <option value="Services">General Services</option>
        </select>
      </div>

      <div class="w-full md:w-1/3 flex flex-col gap-1">
        <label for="location-filter" class="text-[10px] font-bold text-slate-500 uppercase tracking-wider">Geographical Location</label>
        <select id="location-filter" class="w-full form-select text-xs bg-white border-slate-200 rounded-lg py-1.5 focus:ring-[#0B4F9C]">
          <option value="All">All Locations</option>
          <option value="HQ_SRINAGAR">HQ Srinagar</option>
          <option value="HQ_JAMMU">HQ Jammu</option>
          <option value="HEP_BAGLIHAR">HEP Baglihar</option>
          <option value="HEP_LOWER_JHELUM">HEP Lower Jhelum</option>
          <option value="HEP_SAWALKOTE">HEP Sawalkote</option>
        </select>
      </div>

      <div class="w-full md:w-1/3 flex flex-col gap-1">
        <label for="search-input" class="text-[10px] font-bold text-slate-500 uppercase tracking-wider">Search Keyword</label>
        <input id="search-input" type="text" placeholder="Ref No, Title or Corrigenda..." class="w-full form-input text-xs bg-white border-slate-200 rounded-lg py-1.5 focus:ring-[#0B4F9C]" />
      </div>
    </div>

    <!-- Active vs Archives Toggle Buttons (Matching Layout image 1) -->
    <div class="flex items-center justify-between border-b border-slate-200 pb-4 select-none">
      <button id="toggle-active" class="px-5 py-2 border rounded-md font-bold text-xs bg-[#0D7A87] text-white border-[#0D7A87] hover:bg-[#0D7A87]/90 cursor-pointer shadow-sm transition-all duration-200">
        Active Tenders
      </button>
      <button id="toggle-archive" class="px-5 py-2 border rounded-md font-bold text-xs bg-white text-[#0D7A87] border-[#0D7A87] hover:bg-slate-50 cursor-pointer shadow-sm transition-all duration-200">
        Archives
      </button>
    </div>

    <!-- Content Sections -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
      
      <!-- Main Tenders List -->
      <article class="lg:col-span-2 space-y-4">
        <div id="tenders-list-container" class="space-y-4">
          {processedTenders.map((tender: any) => (
            <div 
              class="flex flex-col md:flex-row md:items-center justify-between gap-4 p-6 bg-white border border-slate-200 rounded-xl shadow-sm hover:shadow-md hover:-translate-y-0.5 transition-all duration-300 tender-card" 
              data-status={tender.status} 
              data-category={tender.workCategory} 
              data-location={tender.locationTag} 
              data-search-keys={`${tender.title.toLowerCase()} ${tender.referenceNo.toLowerCase()} ${tender.corrigendums.map(c => c.title.toLowerCase()).join(' ')}`}
            >
              <div class="space-y-2 text-left flex-1 min-w-0">
                <div>
                  <span class="font-extrabold text-slate-800 text-sm">Tender Title : </span>
                  <span class="text-slate-700 text-sm font-medium leading-relaxed">{tender.title}</span>
                </div>
                <div>
                  <span class="font-extrabold text-slate-800 text-sm">NIT No. : </span>
                  <span class="text-slate-700 text-sm font-semibold font-mono">{tender.referenceNo}</span>
                </div>
                {tender.latestCorrigendumTitle && (
                  <div>
                    <span class="font-extrabold text-slate-800 text-sm">Corrigendum Title : </span>
                    <span class="text-[#0D7A87] text-sm font-extrabold">{tender.latestCorrigendumTitle}</span>
                  </div>
                )}
                <div>
                  <span class="font-extrabold text-slate-800 text-sm">Location : </span>
                  <span class="text-slate-700 text-sm font-medium">{tender.locationTag?.replace('HQ_', 'HQ ')?.replace('HEP_', 'HEP ')?.replace('_', ' ')}</span>
                </div>
              </div>
              <div class="flex-shrink-0 flex items-center justify-end md:justify-center">
                <a 
                  href={`/stakeholders/vendors/tender-details?id=${tender.id}`} 
                  class="w-full md:w-auto inline-flex items-center justify-center px-6 py-2 border border-[#0D7A87] text-[#0D7A87] hover:bg-[#0D7A87] hover:text-white rounded text-xs font-bold transition-all duration-200 whitespace-nowrap"
                >
                  View More
                </a>
              </div>
            </div>
          ))}

          <!-- Empty State -->
          <div id="empty-state-container" class="hidden text-center py-12 bg-slate-50 border border-slate-200 border-dashed rounded-xl text-slate-400 font-semibold italic text-xs">
            No active or archived tenders found matching the filters.
          </div>
        </div>
      </article>

      <!-- Sidebar -->
      <aside class="space-y-4" aria-label="Related links">
        <div class="card-static">
          <h3 class="font-bold text-gray-900 mb-2 border-b border-gray-100 pb-2">Vendor Utilities</h3>
          <ul class="flex flex-col gap-2 text-xs font-semibold text-[#0B4F9C]">
            <li><a href="/stakeholders/vendors/vendor-portal" class="hover:underline block py-1">&rarr; Vendor Portal Log-in</a></li>
            <li><a href="/stakeholders/vendors/online-payment" class="hover:underline block py-1">&rarr; Online Payment</a></li>
            <li><a href="/stakeholders/vendors/clpm-portal" class="hover:underline block py-1">&rarr; CLPM Portal</a></li>
          </ul>
        </div>
        
        <div class="bg-blue-50 border border-blue-200 text-blue-800 rounded-lg p-5 text-sm shadow-sm flex items-start gap-3">
          <span class="text-xl" aria-hidden="true">ℹ️</span>
          <div>
            <h4 class="font-bold text-xs">Important Bidding Instructions</h4>
            <p class="text-[11px] text-blue-755 mt-1 leading-relaxed">
              All bids must be submitted online through the J&K e-Procurement Portal. Physical submissions will not be accepted. Bidders are advised to download standard bidding documents and check for corrigenda before final submission.
            </p>
          </div>
        </div>
      </aside>
    </div>

    <!-- Compliance / Awards Logs (keeps feature complete) -->
    <section class="bg-slate-50 border border-slate-200 rounded-2xl p-6 space-y-4">
      <h3 class="font-extrabold text-slate-800 text-base border-b border-slate-200 pb-2 flex items-center gap-2">
        <span>📋</span> Awards, Debarments &amp; Compliance Notices
      </h3>
      <p class="text-xs text-slate-500 leading-relaxed">Official disclosures of debarred vendor registries, contract award details, and public evaluation summaries.</p>
      
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mt-4">
        {awardsAndBanned.length === 0 ? (
          <div class="col-span-2 text-center py-6 text-xs text-slate-400 font-semibold italic">No recent awards or compliance notices published.</div>
        ) : (
          awardsAndBanned.map((item: any) => (
            <div class="p-4 bg-white border border-slate-200 rounded-xl shadow-sm hover:shadow-md transition-all flex flex-col justify-between">
              <div>
                <span class={`px-2 py-0.5 rounded text-[9px] font-bold uppercase ${
                  item.documentType === 'CONTRACT_AWARD' ? 'bg-emerald-50 text-emerald-700 border border-emerald-250' : 'bg-red-50 text-red-700 border border-red-200'
                } border inline-block mb-2`}>
                  {item.documentType === 'CONTRACT_AWARD' ? 'Contract Award' : 'Banned Firm'}
                </span>
                <h4 class="font-bold text-slate-800 text-xs leading-snug">{item.title}</h4>
                <p class="text-[10px] text-slate-450 font-semibold mt-1 font-mono">{item.referenceNo}</p>
              </div>
              <a href={item.documentUrl} target="_blank" rel="noopener noreferrer" class="mt-4 text-[#0B4F9C] hover:underline font-bold text-xs inline-flex items-center gap-1">
                <span>📄 Download Notice</span>
                <span class="text-[10px] text-slate-400">({item.fileSizeBytes ? `${(item.fileSizeBytes / 1024).toFixed(0)} KB` : 'PDF'})</span>
              </a>
            </div>
          ))
        )}
      </div>
    </section>

  </div>
</Layout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const toggleActive = document.getElementById('toggle-active');
    const toggleArchive = document.getElementById('toggle-archive');
    
    const catSelect = document.getElementById('work-category') as HTMLSelectElement;
    const locSelect = document.getElementById('location-filter') as HTMLSelectElement;
    const searchInput = document.getElementById('search-input') as HTMLInputElement;

    // Toggle logic between Active / Archived (matching mockup colors)
    toggleActive?.addEventListener('click', () => {
      toggleActive.className = 'px-5 py-2 border rounded-md font-bold text-xs bg-[#0D7A87] text-white border-[#0D7A87] cursor-pointer shadow-sm transition-all duration-200';
      toggleArchive?.setAttribute('class', 'px-5 py-2 border rounded-md font-bold text-xs bg-white text-[#0D7A87] border-[#0D7A87] hover:bg-slate-50 cursor-pointer shadow-sm transition-all duration-200');
      filterCards();
    });

    toggleArchive?.addEventListener('click', () => {
      toggleArchive.className = 'px-5 py-2 border rounded-md font-bold text-xs bg-[#0D7A87] text-white border-[#0D7A87] cursor-pointer shadow-sm transition-all duration-200';
      toggleActive?.setAttribute('class', 'px-5 py-2 border rounded-md font-bold text-xs bg-white text-[#0D7A87] border-[#0D7A87] hover:bg-slate-50 cursor-pointer shadow-sm transition-all duration-200');
      filterCards();
    });

    // Real-time filtering function
    function filterCards() {
      const activeTab = document.getElementById('toggle-active')?.classList.contains('bg-[#0D7A87]') ? 'Active' : 'Archived';
      const selectedCat = catSelect ? catSelect.value : 'All';
      const selectedLoc = locSelect ? locSelect.value : 'All';
      const query = searchInput ? searchInput.value.toLowerCase().trim() : '';

      const cards = document.querySelectorAll('.tender-card');
      let visibleCount = 0;
      
      cards.forEach((card: any) => {
        const status = card.getAttribute('data-status') || 'Active';
        const cat = card.getAttribute('data-category') || 'Civil';
        const loc = card.getAttribute('data-location') || 'HQ_SRINAGAR';
        const searchKeys = card.getAttribute('data-search-keys') || '';

        const matchesTab = status === activeTab;
        const matchesCat = selectedCat === 'All' || cat === selectedCat;
        const matchesLoc = selectedLoc === 'All' || loc === selectedLoc;
        const matchesSearch = query === '' || searchKeys.includes(query);

        if (matchesTab && matchesCat && matchesLoc && matchesSearch) {
          card.classList.remove('hidden');
          visibleCount++;
        } else {
          card.classList.add('hidden');
        }
      });

      // Update empty state
      const emptyState = document.getElementById('empty-state-container');
      if (visibleCount === 0) {
        emptyState?.classList.remove('hidden');
      } else {
        emptyState?.classList.add('hidden');
      }
    }

    // Bind event listeners
    catSelect?.addEventListener('change', filterCards);
    locSelect?.addEventListener('change', filterCards);
    searchInput?.addEventListener('input', filterCards);

    // Initial filter run
    filterCards();
  });
</script>
