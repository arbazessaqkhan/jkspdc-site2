---
import Layout from '../../../layouts/Layout.astro';
import Icon from '../../../components/Icon.astro';
import { getDocUrl } from '../../../utils/sanitizer';

let tenders = [];

// Map-grouping tenders variables
let processedTenders = [];
let awardsAndBanned = [];
let recentCorrigendums = [];

try {
  const res = await fetch(`${import.meta.env.PUBLIC_API_BASE}/api/tenders`);
  if (res.ok) {
    const rawData = await res.json();
    tenders = Array.isArray(rawData) ? rawData : [];
    
    // Process tenders and gather corrigendums for sidebar
    const allCorrigendums: any[] = [];

    tenders.forEach((t: any) => {
      if (t.documentType === 'NIT' || t.documentType === 'NIO' || t.documentType === 'CONTRACT_AWARD' || t.documentType === 'BANNED_FIRM') {
        const corrs = t.corrigendums && Array.isArray(t.corrigendums) ? [...t.corrigendums] : [];
        
        // Sort corrigendums inside the tender chronologically (oldest first)
        corrs.sort((a: any, b: any) => new Date(a.publishDate).getTime() - new Date(b.publishDate).getTime());

        let latestActivityDate = new Date(t.publishDate).getTime();
        let latestCorrigendumTitle = null;

        corrs.forEach((corr: any) => {
          allCorrigendums.push({
            ...corr,
            parentTenderId: t.id,
            parentReferenceNo: t.referenceNo,
            parentTitle: t.title,
          });

          const corrTime = new Date(corr.publishDate).getTime();
          if (corrTime > latestActivityDate) {
            latestActivityDate = corrTime;
            latestCorrigendumTitle = corr.title;
          }
        });

        processedTenders.push({
          ...t,
          corrigendums: corrs,
          latestActivityDate,
          latestCorrigendumTitle,
        });
      }
      
      if (t.documentType === 'CONTRACT_AWARD' || t.documentType === 'BANNED_FIRM') {
        awardsAndBanned.push(t);
      }
    });

    // Sort tenders by latest activity date descending
    processedTenders.sort((a: any, b: any) => b.latestActivityDate - a.latestActivityDate);

    // Sort recent corrigendums by publish date descending
    allCorrigendums.sort((a: any, b: any) => new Date(b.publishDate).getTime() - new Date(a.publishDate).getTime());
    recentCorrigendums = allCorrigendums.slice(0, 5);

    // Also sort awardsAndBanned by publish date desc
    awardsAndBanned.sort((a, b) => new Date(b.publishDate).getTime() - new Date(a.publishDate).getTime());

  } else {
    console.error('Failed to load tenders registry. Status:', res.status);
  }
} catch (e) {
  console.error('Error fetching/processing public tenders:', e);
}



const tenderYears = Array.from(new Set(processedTenders.map((t: any) => new Date(t.publishDate).getFullYear()))).sort((a: any, b: any) => b - a);

const defaultLocations = [
  'HQ Srinagar',
  'HQ Jammu',
  'HEP Baglihar',
  'HEP Lower Jhelum',
  'HEP Sawalkote',
  'Kirthai HEP Stage-1'
];
const allFilterLocations = Array.from(new Set([
  ...processedTenders.map((t: any) => t.locationTag).filter(Boolean),
  ...defaultLocations
])).sort((a, b) => a.localeCompare(b));
---

<Layout 
  title="Procurement & Tenders Portal" 
  description="Active procurement notices, standard bidding documents, corrigendums, awards, and compliance notices from JKSPDCL."
>
  <div class="space-y-0 max-w-5xl mx-auto">
    <!-- Premium Page Header Band -->
    <div class="page-header-band animate-fadeInUp">
      <nav class="breadcrumb-trail" aria-label="Breadcrumbs">
        <a href="/">Home</a>
        <span class="separator">/</span>
        <span class="current">Tenders</span>
      </nav>
      <h1>Procurement & Tenders Portal</h1>
      <p class="page-subtitle">Jammu &amp; Kashmir State Power Development Corporation Limited (JKSPDCL)</p>
    </div>

    <div class="space-y-8">

    <!-- Dynamic Segregation & Filter Bar -->
    <div id="filter-bar" class="bg-slate-50 border border-slate-200 rounded-xl p-5 space-y-4">
      <div class="flex items-center justify-between border-b border-slate-200 pb-3">
        <h3 class="text-xs font-extrabold text-slate-800 uppercase tracking-wider flex items-center gap-2">
          <Icon name="search" size={14} class="text-[#0B3B60]" />
          <span>Segregate &amp; Filter Tenders</span>
        </h3>
        <div class="text-xs font-semibold text-slate-500" id="tenders-count-display">
          Showing {processedTenders.length} tender(s)
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <!-- Filter By Project / Location -->
        <div class="flex flex-col gap-1">
          <label for="location-filter" class="text-[10px] font-bold text-slate-500 uppercase tracking-wider">By Project / Location</label>
          <select id="location-filter" class="w-full form-select text-xs bg-white border border-slate-200 rounded-lg py-1.5 focus:ring-2 focus:ring-focus">
            <option value="All">All Projects &amp; Locations</option>
            {allFilterLocations.map((loc: string) => {
              const label = loc.replace(/^HQ_/i, 'HQ ').replace(/^HEP_/i, 'HEP ').replace(/_/g, ' ');
              return <option value={loc}>{label}</option>;
            })}
          </select>
        </div>

        <!-- Filter By Work Category -->
        <div class="flex flex-col gap-1">
          <label for="work-category" class="text-[10px] font-bold text-slate-500 uppercase tracking-wider">By Work Category</label>
          <select id="work-category" class="w-full form-select text-xs bg-white border border-slate-200 rounded-lg py-1.5 focus:ring-2 focus:ring-focus">
            <option value="All">All Categories</option>
            <option value="Civil">Civil Works</option>
            <option value="Electro-Mechanical">Electro-Mechanical</option>
            <option value="Hydro">Hydro Projects</option>
            <option value="Solar">Solar Projects</option>
            <option value="IT">IT &amp; Telecom</option>
            <option value="Services">General Services</option>
          </select>
        </div>

        <!-- Filter By Published Year / Date -->
        <div class="flex flex-col gap-1">
          <label for="year-filter" class="text-[10px] font-bold text-slate-500 uppercase tracking-wider">By Published Year</label>
          <select id="year-filter" class="w-full form-select text-xs bg-white border border-slate-200 rounded-lg py-1.5 focus:ring-2 focus:ring-focus">
            <option value="All">All Years</option>
            {tenderYears.map((yr: any) => (
              <option value={String(yr)}>{yr}</option>
            ))}
          </select>
        </div>

        <!-- Filter By Keyword / Tender ID / NIT No -->
        <div class="flex flex-col gap-1">
          <label for="search-input" class="text-[10px] font-bold text-slate-500 uppercase tracking-wider">By Tender ID / NIT / Keyword</label>
          <input 
            id="search-input" 
            type="text" 
            placeholder="Tender ID, NIT No, Title..." 
            class="w-full form-input text-xs bg-white border border-slate-200 rounded-lg py-1.5 px-3 focus:outline-none focus:ring-2 focus:ring-focus" 
          />
        </div>
      </div>
    </div>

    <!-- Active vs Archives vs All Status Tabs -->
    <div class="flex items-center justify-between border-b border-slate-200 pb-4 select-none">
      <span class="text-xs font-bold text-slate-600">Status Segregation:</span>
      <div class="flex items-center gap-2">
        <button id="toggle-active" class="px-4 py-1.5 border rounded-md font-bold text-xs bg-[#0B3B60] text-white border-[#0B3B60] cursor-pointer shadow-sm transition-all duration-200">
          Active Tenders
        </button>
        <button id="toggle-archive" class="px-4 py-1.5 border rounded-md font-bold text-xs bg-white text-[#0B3B60] border-slate-300 hover:bg-slate-50 cursor-pointer shadow-sm transition-all duration-200">
          Archives
        </button>
        <button id="toggle-all" class="px-4 py-1.5 border rounded-md font-bold text-xs bg-white text-slate-700 border-slate-300 hover:bg-slate-50 cursor-pointer shadow-sm transition-all duration-200">
          All Statuses
        </button>
      </div>
    </div>

    <!-- Content Sections: Standardized Data Table -->
    <div class="w-full">
      <article class="w-full">
        <!-- Tenders Table Card (Matching IPP & AGM modules) -->
        <div class="bg-white border border-slate-200 rounded-xl p-6 shadow-xs space-y-4">
          <div class="table-wrapper overflow-x-auto" tabindex="0" role="region" aria-label="Procurement Tenders Data Table">
            <table class="table-data min-w-full text-left" id="tenders-table" style="table-layout: auto;">
              <thead>
                <tr>
                  <th scope="col" class="w-16 text-center">S.No</th>
                  <th scope="col" class="text-left">Tender Title</th>
                  <th scope="col" class="text-left w-52 whitespace-nowrap">NIT No.</th>
                  <th scope="col" class="text-left w-48">Location</th>
                  <th scope="col" class="text-center w-32 whitespace-nowrap">Action</th>
                </tr>
              </thead>
              <tbody id="tenders-table-body">
                {processedTenders.length === 0 ? (
                  <tr>
                    <td colspan="5" class="text-center text-slate-500 py-8 text-xs font-semibold italic">
                      No active or archived tenders recorded.
                    </td>
                  </tr>
                ) : (
                  processedTenders.map((tender: any, idx: number) => {
                  const locationClean = tender.locationTag?.replace(/^HQ_/i, 'HQ ')?.replace(/^HEP_/i, 'HEP ')?.replace(/_/g, ' ') || 'Corporate';
                  return (
                    <tr 
                      class="tender-table-row hover:bg-slate-50/80 transition-colors" 
                      data-status={tender.status} 
                      data-category={tender.workCategory} 
                      data-location={tender.locationTag}
                      data-year={new Date(tender.publishDate).getFullYear()}
                      data-search-keys={`${(tender.id || '').toLowerCase()} ${(tender.referenceNo || '').toLowerCase()} ${(tender.title || '').toLowerCase()} ${(tender.workCategory || '').toLowerCase()} ${(tender.locationTag || '').toLowerCase()} ${(tender.documentType || '').toLowerCase()} ${(tender.description || '').toLowerCase()} ${(tender.corrigendums || []).map((c: any) => `${c.title} ${c.id || ''}`).join(' ').toLowerCase()}`}
                    >
                      <td class="text-center font-bold text-xs text-slate-400 row-idx">{idx + 1}</td>
                      <td class="text-left">
                        <div class="font-bold text-xs sm:text-sm text-slate-900 leading-snug">
                          {tender.title}
                        </div>
                        {tender.corrigendums && tender.corrigendums.length > 0 && (
                          <div class="mt-2 pt-1.5 border-t border-slate-100 flex flex-wrap items-center gap-1.5">
                            <span class="text-[10px] font-bold uppercase tracking-wider text-amber-800 bg-amber-50 px-1.5 py-0.5 rounded border border-amber-200">
                              Corrigenda ({tender.corrigendums.length})
                            </span>
                            {tender.corrigendums.map((c: any) => (
                              <a 
                                href={`/stakeholders/vendors/tender-details?id=${tender.id}#corrigendum-${c.id}`} 
                                class="text-[11px] font-semibold text-[#0B3B60] hover:underline inline-flex items-center gap-1 bg-slate-50 hover:bg-slate-100 px-2 py-0.5 rounded border border-slate-200 transition-colors"
                                title={c.title}
                              >
                                <Icon name="paperclip" size={11} class="shrink-0 text-[#0B3B60]" />
                                <span class="truncate max-w-[200px]">{c.title}</span>
                              </a>
                            ))}
                          </div>
                        )}
                      </td>
                      <td class="text-left font-mono font-semibold text-xs text-slate-700 whitespace-nowrap">
                        {tender.referenceNo}
                      </td>
                      <td class="text-left text-xs font-medium text-slate-600">
                        {locationClean}
                      </td>
                      <td class="text-center whitespace-nowrap">
                        <a 
                          href={`/stakeholders/vendors/tender-details?id=${tender.id}`} 
                          class="inline-flex items-center justify-center px-3.5 py-1.5 border border-[#0B3B60] hover:bg-[#52B5E8] hover:border-[#52B5E8] hover:text-white text-[#0B3B60] rounded text-xs font-bold transition-all shadow-2xs"
                        >
                          View Details
                        </a>
                      </td>
                    </tr>
                  );
                }))}
              </tbody>
            </table>
          </div>

          <!-- Empty State -->
          <div id="empty-state-container" class="hidden text-center py-12 bg-slate-50 border border-slate-200 border-dashed rounded-xl text-slate-500 font-semibold italic text-xs">
            No active or archived tenders found matching your search or filter criteria.
          </div>

          <!-- Pagination Controls (10 items per page) -->
          {processedTenders.length > 0 && (
            <nav id="tenders-pagination" class="flex flex-wrap items-center justify-between gap-3 border-t border-slate-100 pt-3" aria-label="Tenders Pagination">
              <p class="text-[11px] font-medium text-slate-500">
                Showing <strong class="text-slate-700 font-bold" id="tenders-page-from">0</strong>–<strong class="text-slate-700 font-bold" id="tenders-page-to">0</strong> of <strong class="text-slate-700 font-bold" id="tenders-page-total">0</strong> tenders
              </p>
              <div class="flex flex-wrap items-center gap-1.5" id="tenders-page-buttons"></div>
            </nav>
          )}
        </div>
      </article>
    </div>
  </div>
</div>
</Layout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const toggleActive = document.getElementById('toggle-active');
    const toggleArchive = document.getElementById('toggle-archive');
    const toggleAll = document.getElementById('toggle-all');
    
    const catSelect = document.getElementById('work-category') as HTMLSelectElement | null;
    const locSelect = document.getElementById('location-filter') as HTMLSelectElement | null;
    const yearSelect = document.getElementById('year-filter') as HTMLSelectElement | null;
    const searchInput = document.getElementById('search-input') as HTMLInputElement | null;
    const countDisplay = document.getElementById('tenders-count-display');
    const allRows = Array.from(document.querySelectorAll<HTMLTableRowElement>('.tender-table-row'));
    const emptyState = document.getElementById('empty-state-container');
    const paginationNav = document.getElementById('tenders-pagination');
    const pageFromEl = document.getElementById('tenders-page-from');
    const pageToEl = document.getElementById('tenders-page-to');
    const pageTotalEl = document.getElementById('tenders-page-total');
    const pageButtonsEl = document.getElementById('tenders-page-buttons');

    if (!allRows.length) {
      if (paginationNav) paginationNav.style.display = 'none';
      if (countDisplay) countDisplay.textContent = 'Showing 0 tender(s)';
      return;
    }

    let currentStatusFilter = 'Active'; // Active, Archived, or All
    const pageSize = 10;
    let currentPage = 1;
    let matchedRows: HTMLTableRowElement[] = [];

    function setTabStyles(activeTab: string) {
      currentStatusFilter = activeTab;
      
      const activeBtnClass = 'px-4 py-1.5 border rounded-md font-bold text-xs bg-[#0B3B60] text-white border-[#0B3B60] cursor-pointer shadow-sm transition-all duration-200';
      const inactiveBtnClass = 'px-4 py-1.5 border rounded-md font-bold text-xs bg-white text-[#0B3B60] border-slate-300 hover:bg-slate-50 cursor-pointer shadow-sm transition-all duration-200';
      const inactiveAllBtnClass = 'px-4 py-1.5 border rounded-md font-bold text-xs bg-white text-slate-700 border-slate-300 hover:bg-slate-50 cursor-pointer shadow-sm transition-all duration-200';

      if (toggleActive) toggleActive.className = activeTab === 'Active' ? activeBtnClass : inactiveBtnClass;
      if (toggleArchive) toggleArchive.className = activeTab === 'Archived' ? activeBtnClass : inactiveBtnClass;
      if (toggleAll) toggleAll.className = activeTab === 'All' ? activeBtnClass : inactiveAllBtnClass;
      
      applyFilter();
    }

    toggleActive?.addEventListener('click', () => setTabStyles('Active'));
    toggleArchive?.addEventListener('click', () => setTabStyles('Archived'));
    toggleAll?.addEventListener('click', () => setTabStyles('All'));

    function renderPage() {
      const total = matchedRows.length;
      const totalPages = Math.ceil(total / pageSize) || 1;
      if (currentPage > totalPages) currentPage = totalPages;
      if (currentPage < 1) currentPage = 1;

      const startIdx = (currentPage - 1) * pageSize;
      const endIdx = Math.min(startIdx + pageSize, total);

      allRows.forEach((row) => (row.style.display = 'none'));
      matchedRows.forEach((row, idx) => {
        if (idx >= startIdx && idx < endIdx) {
          row.style.display = '';
          const idxCell = row.querySelector('.row-idx');
          if (idxCell) idxCell.textContent = String(idx + 1);
        }
      });

      if (pageFromEl) pageFromEl.textContent = total === 0 ? '0' : String(startIdx + 1);
      if (pageToEl) pageToEl.textContent = String(endIdx);
      if (pageTotalEl) pageTotalEl.textContent = String(total);
      if (countDisplay) countDisplay.textContent = `Showing ${total} tender(s)`;

      if (emptyState) emptyState.classList.toggle('hidden', total > 0);
      if (paginationNav) paginationNav.style.display = total === 0 ? 'none' : 'flex';

      if (!pageButtonsEl) return;
      pageButtonsEl.innerHTML = '';
      if (totalPages <= 1) return;

      const btnBaseClass = 'inline-flex items-center justify-center min-w-8 h-8 px-2.5 rounded-md border text-xs font-semibold transition-colors cursor-pointer select-none';
      const activeClass = `${btnBaseClass} border-[#0B3B60] bg-[#0B3B60] text-white font-bold shadow-2xs`;
      const inactiveClass = `${btnBaseClass} border-slate-200 bg-white text-slate-700 hover:bg-[#EAF4FF] hover:text-[#0B3B60] hover:border-[#BDD7EE]`;
      const disabledClass = `${btnBaseClass} border-slate-200 bg-white text-slate-400 opacity-40 cursor-not-allowed`;

      // Prev
      const prevBtn = document.createElement('button');
      prevBtn.type = 'button';
      prevBtn.innerHTML = '&lsaquo; Prev';
      prevBtn.className = currentPage > 1 ? inactiveClass : disabledClass;
      prevBtn.disabled = currentPage <= 1;
      prevBtn.onclick = () => {
        if (currentPage > 1) {
          currentPage--;
          renderPage();
        }
      };
      pageButtonsEl.appendChild(prevBtn);

      // Windowed pages
      let startP = Math.max(1, currentPage - 2);
      let endP = Math.min(totalPages, startP + 4);
      if (endP - startP < 4) startP = Math.max(1, endP - 4);

      if (startP > 1) {
        pageButtonsEl.appendChild(createPageBtn(1));
        if (startP > 2) {
          const dots = document.createElement('span');
          dots.className = 'inline-flex items-center justify-center min-w-6 h-8 text-xs font-semibold text-slate-400 select-none';
          dots.textContent = '…';
          pageButtonsEl.appendChild(dots);
        }
      }

      for (let p = startP; p <= endP; p++) {
        pageButtonsEl.appendChild(createPageBtn(p));
      }

      if (endP < totalPages) {
        if (endP < totalPages - 1) {
          const dots = document.createElement('span');
          dots.className = 'inline-flex items-center justify-center min-w-6 h-8 text-xs font-semibold text-slate-400 select-none';
          dots.textContent = '…';
          pageButtonsEl.appendChild(dots);
        }
        pageButtonsEl.appendChild(createPageBtn(totalPages));
      }

      // Next
      const nextBtn = document.createElement('button');
      nextBtn.type = 'button';
      nextBtn.innerHTML = 'Next &rsaquo;';
      nextBtn.className = currentPage < totalPages ? inactiveClass : disabledClass;
      nextBtn.disabled = currentPage >= totalPages;
      nextBtn.onclick = () => {
        if (currentPage < totalPages) {
          currentPage++;
          renderPage();
        }
      };
      pageButtonsEl.appendChild(nextBtn);

      function createPageBtn(pageNum: number) {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.textContent = String(pageNum);
        btn.className = pageNum === currentPage ? activeClass : inactiveClass;
        btn.onclick = () => {
          currentPage = pageNum;
          renderPage();
        };
        return btn;
      }
    }

    function applyFilter() {
      const selectedCat = catSelect ? catSelect.value : 'All';
      const selectedLoc = locSelect ? locSelect.value : 'All';
      const selectedYr = yearSelect ? yearSelect.value : 'All';
      const query = searchInput ? searchInput.value.toLowerCase().trim() : '';

      matchedRows = allRows.filter((row) => {
        const status = row.getAttribute('data-status') || 'Active';
        const cat = row.getAttribute('data-category') || 'Civil';
        const loc = row.getAttribute('data-location') || 'HQ_SRINAGAR';
        const yr = row.getAttribute('data-year') || '';
        const searchKeys = row.getAttribute('data-search-keys') || '';

        const matchesTab = currentStatusFilter === 'All' || status === currentStatusFilter;
        const matchesCat = selectedCat === 'All' || cat === selectedCat;
        const matchesLoc = selectedLoc === 'All' || loc === selectedLoc;
        const matchesYr = selectedYr === 'All' || yr === selectedYr;
        const matchesSearch = query === '' || searchKeys.includes(query);

        return matchesTab && matchesCat && matchesLoc && matchesYr && matchesSearch;
      });

      currentPage = 1;
      renderPage();
    }

    catSelect?.addEventListener('change', applyFilter);
    locSelect?.addEventListener('change', applyFilter);
    yearSelect?.addEventListener('change', applyFilter);
    searchInput?.addEventListener('input', applyFilter);

    applyFilter();
  });
</script>
