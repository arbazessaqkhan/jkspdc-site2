---
import Layout from '../../../layouts/Layout.astro';

let tenders = [];
let errorMessage = '';

try {
  const res = await fetch('http://localhost:3000/api/tenders');
  if (res.ok) {
    tenders = await res.json();
    // Sort by publishDate descending (newest first)
    tenders.sort((a, b) => new Date(b.publishDate).getTime() - new Date(a.publishDate).getTime());
  } else {
    errorMessage = 'Failed to load tenders registry.';
  }
} catch (e) {
  errorMessage = 'Failed to connect to the backend server.';
}
---

<Layout 
  title="Tender & Bids - Vendors" 
  description="Active procurement notices, standard bidding documents, and tenders from JKSPDC."
>
  <div class="space-y-6">
    <!-- Breadcrumbs -->
    <nav class="text-xs text-gray-500" aria-label="Breadcrumbs">
      <ol class="flex gap-2">
        <li><a href="/" class="hover:underline">Home</a></li>
        <li>/</li>
        <li><span class="text-gray-400">Stakeholders</span></li>
        <li>/</li>
        <li><span class="text-gray-400">Vendors</span></li>
        <li>/</li>
        <li><span class="font-semibold text-[#0B4F9C]">Tender & Bids</span></li>
      </ol>
    </nav>

    <!-- Page Header -->
    <header class="border-b border-gray-200 pb-4">
      <h2 class="text-3xl font-extrabold text-[#0B4F9C]">Tender & Bids</h2>
      <p class="text-sm text-gray-600 mt-1">Official registry of active notices inviting tenders (NIT), pre-bid updates, and corrigenda.</p>
    </header>

    <!-- Content -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
      <!-- Main Content -->
      <article class="lg:col-span-2 space-y-6">
        
        {errorMessage && (
          <div class="bg-red-50 border border-red-200 text-red-800 rounded-lg p-4 text-xs font-semibold">
            {errorMessage}
          </div>
        )}

        <!-- Table Listing of Tenders -->
        <div class="table-wrapper">
          <table class="table-data" aria-label="Registry of Active Tenders">
            <thead>
              <tr>
                <th scope="col" class="w-1/4">NIT Ref No.</th>
                <th scope="col" class="w-2/5">Description of Work</th>
                <th scope="col" class="w-1/6">File Size</th>
                <th scope="col" class="w-1/6">Closing Date</th>
                <th scope="col" class="w-1/6">Tender Documents</th>
              </tr>
            </thead>
            <tbody>
              {tenders.length === 0 && !errorMessage ? (
                <tr>
                  <td colspan="5" class="text-center text-slate-500 py-10 text-xs font-semibold">
                    No active tenders found.
                  </td>
                </tr>
              ) : (
                tenders.map((t) => (
                  <tr class="hover:bg-slate-50/80 transition-colors">
                    <td class="font-semibold text-slate-900 font-mono text-xs">{t.referenceNo}</td>
                    <td class="px-4 py-3.5 text-left">
                      <div class="font-bold text-slate-800 text-sm leading-snug">{t.title}</div>
                      {t.description && <div class="text-[10px] text-slate-500 mt-1 font-medium leading-relaxed">{t.description}</div>}
                    </td>
                    <td class="font-medium text-slate-700 text-xs whitespace-nowrap">
                      {t.fileSizeBytes ? `${(t.fileSizeBytes / 1024).toFixed(0)} KB` : 'N/A'}
                    </td>
                    <td class="font-semibold text-orange-600 text-xs whitespace-nowrap">
                      {new Date(t.closingDate).toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric' })}
                    </td>
                    <td class="whitespace-nowrap">
                      <a href={t.documentUrl} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1 text-[#0B4F9C] hover:underline font-bold text-xs" aria-label={`Download Tender Document for ${t.referenceNo}`}>
                        📄 Download PDF
                      </a>
                    </td>
                  </tr>
                ))
              )}
            </tbody>
          </table>
        </div>

        <div class="bg-blue-50 border border-blue-200 text-blue-800 rounded-lg p-5 text-sm shadow-sm flex items-start gap-3">
          <span class="text-xl">ℹ️</span>
          <div>
            <h4 class="font-bold">Important Instructions to Bidders</h4>
            <p class="text-xs text-blue-700 mt-1 leading-relaxed">
              All bids must be submitted online through the J&K e-Procurement Portal. Physical submissions will not be accepted. Bidders are advised to download standard bidding documents and check for any pre-bid corrigenda before final submission.
            </p>
          </div>
        </div>

      </article>

      <!-- Sidebar -->
      <aside class="space-y-4">
        <div class="card-static">
          <h3 class="font-bold text-gray-900 mb-2 border-b border-gray-100 pb-2">Vendor Utilities</h3>
          <ul class="flex flex-col gap-2 text-xs font-semibold text-[#0B4F9C]">
            <li><a href="/stakeholders/vendors/vendor-portal" class="hover:underline block py-1">&rarr; Vendor Portal Log-in</a></li>
            <li><a href="/stakeholders/vendors/online-payment" class="hover:underline block py-1">&rarr; Online Payment</a></li>
            <li><a href="/stakeholders/vendors/clpm-portal" class="hover:underline block py-1">&rarr; CLPM Portal</a></li>
          </ul>
        </div>
      </aside>
    </div>
  </div>
</Layout>
