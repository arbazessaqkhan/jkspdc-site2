---
import Layout from '../../../layouts/Layout.astro';
import Icon from '../../../components/Icon.astro';

let agmDocuments: any[] = [];
let errorMessage = '';

const fallbackAgmDocs = [
  { id: 'agm-seed-1', title: 'Notice of AGM for the year 2019 20', documentUrl: '/MoA_AoA.pdf', year: 2020 },
  { id: 'agm-seed-2', title: 'Notice of AGM for the year 2018 19', documentUrl: '/MoA_AoA.pdf', year: 2019 },
  { id: 'agm-seed-3', title: 'Annual Return 2018 19', documentUrl: '/MoA_AoA.pdf', year: 2019 },
  { id: 'agm-seed-4', title: 'Notice of AGM for the year 2017 18', documentUrl: '/MoA_AoA.pdf', year: 2018 },
  { id: 'agm-seed-5', title: 'Annual Return 2017 18', documentUrl: '/MoA_AoA.pdf', year: 2018 },
  { id: 'agm-seed-6', title: 'Notice of AGM for the year 2016 17', documentUrl: '/MoA_AoA.pdf', year: 2017 },
  { id: 'agm-seed-7', title: 'Annual Return 2016 17', documentUrl: '/MoA_AoA.pdf', year: 2017 },
  { id: 'agm-seed-8', title: 'Notice of AGM for the year 2015 16', documentUrl: '/MoA_AoA.pdf', year: 2016 },
  { id: 'agm-seed-9', title: 'Annual Return 2015 16', documentUrl: '/MoA_AoA.pdf', year: 2016 },
  { id: 'agm-seed-10', title: 'Annual Return 2014 15', documentUrl: '/MoA_AoA.pdf', year: 2015 },
  { id: 'agm-seed-11', title: 'Notice of AGM for the year 2013 14', documentUrl: '/MoA_AoA.pdf', year: 2014 },
  { id: 'agm-seed-12', title: 'Notice of AGM for the year 2012 13', documentUrl: '/MoA_AoA.pdf', year: 2013 },
  { id: 'agm-seed-13', title: 'Notice of AGM for the year 2011 12', documentUrl: '/MoA_AoA.pdf', year: 2012 },
];

try {
  const [agmRes, downloadsRes] = await Promise.all([
    fetch('http://localhost:3000/api/public/agm').catch(() => null),
    fetch('http://localhost:3000/api/downloads?category=AGM').catch(() => null),
  ]);

  if (agmRes && agmRes.ok) {
    const agmData = await agmRes.json();
    if (Array.isArray(agmData)) {
      agmDocuments = [...agmDocuments, ...agmData];
    }
  }

  if (downloadsRes && downloadsRes.ok) {
    const dlData = await downloadsRes.json();
    if (Array.isArray(dlData)) {
      const active = dlData.filter((d: any) => 
        (!d.status || d.status === 'Active') && 
        (d.category && d.category.toLowerCase() === 'agm')
      );
      const mapped = active.map((d: any) => ({
        id: d.id,
        title: d.title,
        documentUrl: d.documentUrl,
        meetingDate: d.publishDate || d.createdAt,
        _fromResources: true,
      }));
      agmDocuments = [...agmDocuments, ...mapped];
    }
  }
} catch (e) {
  console.error('Error fetching public AGM documents:', e);
}

// Always merge with official archive documents so the list is complete and authentic
const existingTitles = new Set(agmDocuments.map((d: any) => d.title.trim().toLowerCase()));
const missingFallbacks = fallbackAgmDocs.filter(f => !existingTitles.has(f.title.trim().toLowerCase()));
agmDocuments = [...agmDocuments, ...missingFallbacks];

const getDocUrl = (url?: string) => {
  if (!url) return '#';
  if (url.startsWith('/uploads/')) {
    return `http://localhost:3000${url}`;
  }
  return url;
};
---

<Layout 
  title="Annual General Meetings (AGM) - Investors Corner" 
  description="Annual General Meeting documents, statements, and minutes of Jammu & Kashmir State Power Development Corporation Limited."
>
  <div class="space-y-6">
    <!-- Premium Page Header Band -->
    <div class="page-header-band animate-fadeInUp">
      <nav class="breadcrumb-trail" aria-label="Breadcrumbs">
        <a href="/">Home</a>
        <span class="separator">/</span>
        <span>Investors Corner</span>
        <span class="separator">/</span>
        <span class="current">Annual General Meetings</span>
      </nav>
      <h1>Annual General Meetings (AGM)</h1>
      <p class="page-subtitle">Jammu &amp; Kashmir State Power Development Corporation Limited (JKSPDCL)</p>
    </div>

    {errorMessage && (
      <div class="bg-red-50 border border-red-200 text-red-800 rounded-lg p-4 text-xs font-semibold">
        {errorMessage}
      </div>
    )}

    <!-- Content -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
      
      <!-- Main Content -->
      <article class="lg:col-span-2 space-y-6">

        <!-- AGM Documents Table (Consistent with website tables, without unnecessary meeting link col) -->
        <div class="table-wrapper">
          <table class="table-data min-w-full" role="table" aria-label="Annual General Meeting Documents">
            <thead>
              <tr>
                <th scope="col" class="text-center w-14 sm:w-16">#</th>
                <th scope="col" class="text-left">Annual General Meeting Documents</th>
              </tr>
            </thead>
            <tbody id="agm-table-body">
              {agmDocuments.length === 0 ? (
                <tr id="empty-agm-row">
                  <td colspan="2" class="text-center py-12 text-slate-400 text-xs font-semibold italic">
                    No Annual General Meeting documents uploaded yet.
                  </td>
                </tr>
              ) : (
                agmDocuments.map((agm: any, idx: number) => (
                  <tr 
                    class="agm-row hover:bg-[#EAF4FF] transition-colors group cursor-pointer"
                  >
                    <td class="text-center font-bold text-slate-500 text-xs row-idx">{idx + 1}</td>
                    <td class="text-left py-3.5 px-4">
                      <a 
                        href={getDocUrl(agm.documentUrl)} 
                        target="_blank" 
                        rel="noopener noreferrer"
                        class="flex items-center justify-between gap-4 font-bold text-[#0B4F9C] hover:text-[#084A8F] hover:underline text-xs sm:text-sm leading-snug w-full"
                      >
                        <div class="flex items-center gap-2.5 min-w-0">
                          <Icon name="file-text" size={16} class="text-[#0B4F9C] shrink-0" />
                          <span class="truncate sm:whitespace-normal">{agm.title}</span>
                        </div>
                        <span class="shrink-0 text-[10px] uppercase font-bold tracking-wider px-2 py-0.5 rounded bg-[#EAF4FF] text-[#0B4F9C] border border-[#BDD7EE] group-hover:bg-[#0B4F9C] group-hover:text-white transition-colors">
                          PDF ↗
                        </span>
                      </a>
                    </td>
                  </tr>
                ))
              )}
            </tbody>
          </table>
        </div>
      </article>

      <!-- Sidebar -->
      <aside class="space-y-4">
        <div class="card-static">
          <h3 class="font-bold text-gray-900 mb-2 border-b border-gray-100 pb-2">Investor Corner</h3>
          <ul class="flex flex-col gap-2 text-xs font-semibold text-[#0B4F9C]">
            <li><a href="/notifications" class="hover:underline block py-1">&rarr; Notifications &amp; Circulars</a></li>
            <li><a href="/stakeholders/investors/ipp-projects" class="hover:underline block py-1">&rarr; IPP Projects</a></li>
            <li><a href="/stakeholders/investors/annual-reports" class="hover:underline block py-1">&rarr; Annual Reports</a></li>
            <li><a href="/stakeholders/investors/financial-results" class="hover:underline block py-1">&rarr; Financial Results</a></li>
            <li><a href="/stakeholders/investors/chairman-statement" class="hover:underline block py-1">&rarr; Chairman's Statement</a></li>
            <li><a href="/stakeholders/investors/mou-mop" class="hover:underline block py-1">&rarr; MoUs &amp; MoPs</a></li>
          </ul>
        </div>
      </aside>
    </div>
  </div>
</Layout>
