---
import Layout from '../../../layouts/Layout.astro';
import Icon from '../../../components/Icon.astro';

let notifications: any[] = [];
let errorMessage = '';

try {
  const res = await fetch('http://localhost:3000/api/public/notifications');
  if (res.ok) {
    notifications = await res.json();
  } else {
    errorMessage = 'Failed to load announcements.';
  }
} catch (e) {
  console.error('Error fetching public announcements:', e);
  errorMessage = 'Failed to connect to the server.';
}

// Extract available years for filter
const yearsSet = new Set(notifications.map(n => new Date(n.publishDate).getFullYear()));
const years = Array.from(yearsSet).sort((a, b) => b - a);

const getDocUrl = (url?: string) => {
  if (!url) return '#';
  if (url.startsWith('/uploads/')) {
    return `http://localhost:3000${url}`;
  }
  return url;
};
---

<Layout 
  title="Announcements & Notifications - Investors" 
  description="Official announcements, notifications, circulars, and board meeting intimations of JKSPDC."
>
  <div class="space-y-6">
    <!-- Branded Page Header Band -->
    <div class="-mx-4 sm:-mx-6 lg:-mx-8 -mt-8 mb-2 px-4 sm:px-6 lg:px-8 py-6 bg-gradient-to-r from-[#1B3A6B] to-[#0B4F9C]">
      <nav class="text-xs text-white/70 mb-2" aria-label="Breadcrumbs">
        <ol class="flex gap-2">
          <li><a href="/" class="hover:text-white">Home</a></li>
          <li class="text-white/50">/</li>
          <li><span class="font-semibold text-white">Notifications</span></li>
        </ol>
      </nav>
      <h2 class="text-2xl font-extrabold text-white">Investor Announcements</h2>
      <p class="text-sm text-white/75 mt-1">Official circulars, board meeting intimations, and notifications.</p>
    </div>

    {errorMessage && (
      <div class="bg-red-50 border border-red-200 text-red-800 rounded-lg p-4 text-xs font-semibold">
        {errorMessage}
      </div>
    )}

    <!-- Content -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
      
      <!-- Main Content -->
      <article class="lg:col-span-2 space-y-6">
        
        <!-- Filter Bar -->
        <div class="bg-slate-50 border border-slate-200 rounded-xl p-4 flex items-center justify-between">
          <div class="flex items-center gap-2">
            <label for="year-filter" class="text-xs font-bold text-slate-650">Select Year</label>
            <select id="year-filter" class="form-select text-xs py-1.5 pr-8 pl-3 border-slate-200 rounded bg-white">
              <option value="All">All Years</option>
              {years.map((y: any) => (
                <option value={String(y)}>{y}</option>
              ))}
            </select>
          </div>
          <div class="text-xs text-slate-500 font-semibold" id="count-display">
            Showing {notifications.length} item(s)
          </div>
        </div>

        <!-- Announcements List -->
        <div class="space-y-3" id="notifications-list">
          {notifications.length === 0 ? (
            <div class="bg-gray-50 border border-gray-200 text-gray-700 rounded-lg p-6 text-center text-xs font-semibold italic">
              No announcements or notifications published yet.
            </div>
          ) : (
            notifications.map((notif: any) => (
              <div 
                class="notif-card p-5 bg-white border border-slate-200 rounded-xl shadow-sm hover:shadow-md transition-all duration-200 flex flex-col sm:flex-row sm:items-center justify-between gap-4"
                data-year={new Date(notif.publishDate).getFullYear()}
              >
                <div class="space-y-1.5 flex-1 min-w-0 text-left">
                  <h4 class="font-extrabold text-slate-800 text-sm leading-snug">{notif.title}</h4>
                  <div class="flex items-center gap-3 text-[11px] text-slate-450 font-semibold">
                    <span class="bg-slate-100 px-2 py-0.5 rounded text-slate-600 font-bold uppercase tracking-wider font-mono">
                      {notif.fileName.split('.').pop() || 'PDF'}
                    </span>
                    <span>Uploaded: {formatDate(notif.publishDate)}</span>
                  </div>
                </div>
                
                <div class="shrink-0 flex items-center justify-end sm:justify-center">
                  <a 
                    href={getDocUrl(notif.documentUrl)} 
                    target="_blank" 
                    rel="noopener noreferrer"
                    class="w-full sm:w-auto inline-flex items-center justify-center gap-1.5 px-4 py-2 border border-[#0B4F9C] hover:bg-[#0B4F9C] hover:text-white text-[#0B4F9C] rounded text-xs font-bold transition-all"
                  >
                    <Icon name="file-text" size={12} />
                    <span>View PDF</span>
                  </a>
                </div>
              </div>
            ))
          )}
        </div>
      </article>

      <!-- Sidebar -->
      <aside class="space-y-4">
        <div class="card-static">
          <h3 class="font-bold text-gray-900 mb-2 border-b border-gray-100 pb-2">Investor Corner</h3>
          <ul class="flex flex-col gap-2 text-xs font-semibold text-[#0B4F9C]">
            <li><a href="/stakeholders/investors/financial-results" class="hover:underline block py-1">&rarr; Financial Results</a></li>
            <li><a href="/stakeholders/investors/annual-reports" class="hover:underline block py-1">&rarr; Annual Reports</a></li>
            <li><a href="/stakeholders/investors/chairman-statement" class="hover:underline block py-1">&rarr; Chairman's Statement</a></li>
            <li><a href="/stakeholders/investors/mou-mop" class="hover:underline block py-1">&rarr; MoUs &amp; MoPs</a></li>
          </ul>
        </div>
      </aside>
    </div>
  </div>
</Layout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const filter = document.getElementById('year-filter') as HTMLSelectElement;
    const countDisplay = document.getElementById('count-display');
    const cards = document.querySelectorAll('.notif-card');

    function filterAnnouncements() {
      if (!filter) return;
      const selectedYear = filter.value;
      let visibleCount = 0;

      cards.forEach((card: any) => {
        const year = card.getAttribute('data-year');
        if (selectedYear === 'All' || year === selectedYear) {
          card.classList.remove('hidden');
          visibleCount++;
        } else {
          card.classList.add('hidden');
        }
      });

      if (countDisplay) {
        countDisplay.textContent = `Showing ${visibleCount} item(s)`;
      }
    }

    filter?.addEventListener('change', filterAnnouncements);
    filterAnnouncements();
  });
</script>

<style>
  .form-select {
    border: 1px solid #e2e8f0;
    border-radius: 0.375rem;
    padding: 0.375rem 2rem 0.375rem 0.75rem;
    font-size: 0.75rem;
    cursor: pointer;
  }
  .form-select:focus {
    border-color: #0B4F9C;
    outline: none;
  }
</style>
