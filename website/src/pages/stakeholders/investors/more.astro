---
import Layout from '../../../layouts/Layout.astro';
---

<Layout 
  title="Investor Services - Investors" 
  description="Additional services and information for investors and stakeholders of JKSPDC."
>
  <div class="space-y-6">
    <!-- Breadcrumbs -->
    <nav class="text-xs text-gray-500" aria-label="Breadcrumbs">
      <ol class="flex gap-2">
        <li><a href="/" class="hover:underline">Home</a></li>
        <li>/</li>
        <li><span class="text-gray-400">Investors</span></li>
        <li>/</li>
        <li><span class="font-semibold text-[#0B4F9C]">More</span></li>
      </ol>
    </nav>

    <!-- Page Header -->
    <header class="border-b border-gray-200 pb-4">
      <h2 class="text-3xl font-extrabold text-[#0B4F9C]">Investor Services & Utilities</h2>
      <p class="text-sm text-gray-600 mt-1">Additional resources and disclosures for corporate stakeholders.</p>
    </header>

    <!-- Content -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
      <!-- Main Content -->
      <article class="lg:col-span-2 space-y-4">
        <!-- Safety content placeholder -->
        <div class="bg-gray-50 border border-gray-200 text-gray-700 rounded-lg p-6 text-center text-sm shadow-sm">
          <p class="font-semibold text-gray-800 mb-1">Additional Investor Services Pending Official Approval</p>
          <p class="text-xs text-gray-500">Additional services, compliance registers, and resources are currently undergoing official review.</p>
          <div class="mt-3 inline-block bg-neutral-200 text-neutral-800 px-3 py-1 rounded text-[10px] font-bold uppercase tracking-wider">
            [Content Pending Approval]
          </div>
        </div>
      </article>

      <!-- Sidebar -->
      <aside class="space-y-4">
        <div class="card-static">
          <h3 class="font-bold text-gray-900 mb-2 border-b border-gray-100 pb-2">Investor Corner</h3>
          <ul class="flex flex-col gap-2 text-xs font-semibold text-[#0B4F9C]">
            <li><a href="/stakeholders/investors/annual-reports" class="hover:underline block py-1">&rarr; Annual Reports</a></li>
            <li><a href="/stakeholders/investors/mou-mop" class="hover:underline block py-1">&rarr; MoUs signed with MoP</a></li>
          </ul>
        </div>
      </aside>
    </div>
  </div>
</Layout>
