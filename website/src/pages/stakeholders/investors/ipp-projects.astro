      { name: 'Ratle HEP (IPP Stage)', capacityMw: 850, basin: 'Chenab Basin', location: 'Kishtwar', status: 'JV Transition / Construction', developer: 'Ratle Hydroelectric Power Corp Ltd (RHPCL)', remarks: 'JV Executing Phase I Allotment' },
      { name: 'Parnai Small HEP', capacityMw: 37.5, basin: 'Jhelum Basin (Poonch)', location: 'Poonch', status: 'Under Civil Works', developer: 'State IPP Cell / Allocated IPP', remarks: 'Implementation Agreement Active' },
      { name: 'Sewa-I HEP', capacityMw: 9, basin: 'Ravi Basin', location: 'Kathua', status: 'Operational / IPP Allotment', developer: 'Private IPP Developer', remarks: 'PPA Executed with PDD' }
    ]
