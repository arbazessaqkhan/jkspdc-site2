---
import Layout from '../../../layouts/Layout.astro';
import Icon from '../../../components/Icon.astro';
import { BACKEND_URL } from '../../../utils/api-error';

// Fetch live IPP projects directly from the backend database (same database as Admin portal)
let dbProjects: any[] = [];
try {
  const apiBase = process.env.BACKEND_URL || import.meta.env.PUBLIC_API_BASE || BACKEND_URL;
  const res = await fetch(`${apiBase}/api/ipp-projects`).catch(() => null);
  if (res && res.ok) {
    dbProjects = await res.json();
  }
} catch (e) {
  console.error('Failed to sync IPP projects from backend API:', e);
}

// Generate the 10 phases using live database data
const phasesWithCalculations = Array.from({ length: 10 }, (_, i) => {
  const phaseNum = i + 1;
  const phaseId = `phase-${phaseNum}`;

  let projects: any[] = [];
  if (Array.isArray(dbProjects) && dbProjects.length > 0) {
    projects = dbProjects
      .filter((p: any) => Number(p.phase) === phaseNum)
      .map((p: any) => ({
        id: p.id,
        name: p.name.includes('HEP') || p.name.toLowerCase().includes('hydro') ? p.name : `${p.name} HEP`,
        capacityMw: Number(p.capacityMw) || 0,
        status: p.status || '—',
        location: p.location || '—',
        awardedTo: p.awardedTo || '—',
        basin: p.basin || ''
      }));
  }

  const totalCapacity = projects.reduce((sum: number, p: any) => sum + (Number(p.capacityMw) || 0), 0);
  return {
    id: phaseId,
    phaseNum,
    name: `Phase ${phaseNum}`,
    projectCount: projects.length,
    totalMw: totalCapacity > 0 ? `${totalCapacity} MW` : '0 MW',
    projects
  };
});

// Check if a specific phase is requested via URL search param (e.g. ?phase=phase-3)
const requestedPhaseParam = Astro.url.searchParams.get('phase')?.toLowerCase() || null;
const initialPhase = requestedPhaseParam ? phasesWithCalculations.find(p => p.id === requestedPhaseParam) : null;
---

<Layout 
  title="IPP Projects - Investors Corner" 
  description="Independent Power Producer (IPP) Hydroelectric & Renewable Energy Projects across J&K."
>
  <div class="space-y-0 w-full">
    <!-- Premium Page Header Band -->
    <div class="page-header-band animate-fadeInUp">
      <nav class="breadcrumb-trail" aria-label="Breadcrumbs">
        <a href="/">Home</a>
        <span class="separator">/</span>
        <span>Investors Corner</span>
        <span class="separator">/</span>
        <span class="current">IPP Projects</span>
      </nav>
      <h1>IPP Projects</h1>
      <p class="page-subtitle">Jammu &amp; Kashmir State Power Development Corporation Limited (JKSPDCL)</p>
    </div>

    <!-- Phase Selector Buttons Grid (All 10 Phases Visible at Top) -->
    <section aria-labelledby="phase-selection-heading" class="animate-fadeInUp delay-200 space-y-4">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between border-b border-[#0B3B60]/20 pb-2.5 gap-2">
        <h2 id="phase-selection-heading" class="text-sm font-bold uppercase tracking-wider text-[#0B3B60] flex items-center gap-2">
          <Icon name="briefcase" size={16} strokeWidth={2} />
          Select Project Allotment Phase
        </h2>
        <span class="text-xs font-semibold text-slate-500">
          Click any Phase to view its project table and count
        </span>
      </div>

      <!-- ARIA Tablist for 10 Phases -->
      <div 
        role="tablist" 
        aria-label="IPP Project Allotment Phases" 
        class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-3 sm:gap-4" 
        id="phase-tabs-container"
      >
        {phasesWithCalculations.map((phase) => {
          const isSelected = initialPhase ? initialPhase.id === phase.id : false;
          return (
            <button
              type="button"
              role="tab"
              id={`tab-${phase.id}`}
              aria-controls="ipp-table-section"
              aria-selected={isSelected ? 'true' : 'false'}
              tabindex={isSelected ? '0' : '-1'}
              data-phase-id={phase.id}
              class={`phase-tab-btn group p-4 sm:p-5 rounded-xl border text-center transition-all duration-200 cursor-pointer select-none focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#0B4F9C] focus-visible:ring-offset-2 flex flex-col items-center justify-center min-h-[88px] ${
                isSelected 
                  ? 'border-2 border-[#0B3B60] bg-[#EAF4FF] text-[#0B3B60] shadow-sm ring-1 ring-[#0B4F9C]/20' 
                  : 'border-slate-200 bg-white hover:border-[#0B3B60] hover:bg-slate-50 text-slate-800 shadow-xs'
              }`}
            >
              <span class="text-base sm:text-lg font-extrabold text-[#0B3B60] tracking-wide block transition-colors">
                {phase.name}
              </span>
              <span class="phase-count-subtext text-xs font-semibold text-slate-500 mt-1 block">
                {phase.projectCount > 0 ? `${phase.projectCount} Projects` : '0 Projects'}
              </span>
            </button>
          );
        })}
      </div>
    </section>

    <!-- Invisible Screen Reader Live Announcer for Accessibility -->
    <div id="a11y-announcer" class="sr-only" aria-live="polite" aria-atomic="true"></div>

    <!-- Active Table Card Section (Spaced as in other pages: bg-white border border-slate-200 rounded-xl p-6 shadow-xs space-y-4) -->
    <section 
      id="ipp-table-section" 
      class={`mt-8 animate-fadeIn transition-all duration-200 ${initialPhase ? '' : 'hidden'}`}
      role="region"
      aria-labelledby="active-phase-heading"
    >
      <div class="bg-white border border-slate-200 rounded-xl p-6 shadow-xs space-y-4">
        <!-- Clean Card Header: Title on Left, Count on Right (Matching other tables) -->
        <div class="flex flex-col sm:flex-row sm:items-center justify-between pb-3 border-b border-slate-100 gap-2">
          <h3 id="active-phase-heading" class="text-base sm:text-lg font-bold text-[#0B3B60] flex items-center gap-2">
            <Icon name="clipboard" size={20} class="text-[#0B3B60]" />
            <span id="active-phase-title-text">{initialPhase ? `${initialPhase.name} Projects` : ''}</span>
          </h3>
          <div class="text-xs font-semibold text-slate-500 flex items-center gap-2" id="active-phase-count">
            {initialPhase ? (
              <span>Showing {initialPhase.projectCount} project(s) &bull; Total: {initialPhase.totalMw}</span>
            ) : null}
          </div>
        </div>

        <!-- Projects Table Wrapper: Fixed column widths with <colgroup> so columns never shift position -->
        <div 
          class="table-wrapper is-card-table overflow-x-auto" 
          tabindex="0" 
          role="region" 
          aria-label="IPP Projects Data Table"
        >
          <table class="table-data mobile-cards-table min-w-full text-left" style="table-layout: fixed;">
            <caption class="sr-only" id="table-caption">
              {initialPhase ? `List of IPP projects under ${initialPhase.name}` : 'IPP Projects Table'}
            </caption>
            <colgroup>
              <col style="width: 25%;">
              <col style="width: 25%;">
              <col style="width: 25%;">
              <col style="width: 25%;">
            </colgroup>
            <thead>
              <tr>
                <th scope="col" class="text-left" style="width: 25%;">Project &amp; Location</th>
                <th scope="col" class="text-left" style="width: 25%;">Installed Capacity</th>
                <th scope="col" class="text-left" style="width: 25%;">Status</th>
                <th scope="col" class="text-left" style="width: 25%;">Awarded To</th>
              </tr>
            </thead>
            <tbody id="table-tbody">
              {initialPhase && (
                initialPhase.projects.length > 0 ? (
                  initialPhase.projects.slice(0, 10).map((proj: any) => (
                    <tr>
                      <td class="text-left font-semibold text-slate-800 break-words" style="width: 25%;">
                        <div>{proj.name}</div>
                        <div class="text-slate-500 font-normal text-xs mt-0.5">
                          {proj.location}{proj.basin ? ` • ${proj.basin}` : ''}
                        </div>
                      </td>
                      <td class="text-left font-semibold text-slate-700 whitespace-nowrap" style="width: 25%;" data-label="Capacity">
                        {proj.capacityMw} MW
                      </td>
                      <td class="text-left text-slate-600 break-words" style="width: 25%;" data-label="Status">
                        {proj.status || '—'}
                      </td>
                      <td class="text-left text-slate-600 break-words" style="width: 25%;" data-label="Awarded To">
                        {proj.awardedTo || '—'}
                      </td>
                    </tr>
                  ))
                ) : (
                  <tr>
                    <td colspan="4" class="text-center py-8 text-sm text-slate-500 font-semibold">
                      No projects are registered under this allotment phase yet.
                    </td>
                  </tr>
                )
              )}
            </tbody>
          </table>
        </div>

        <!-- Accessible Pagination Bar (GIGW 3.0 / WCAG 2.2: 10 projects per page) -->
        <nav
          id="ipp-pagination"
          aria-label="IPP Projects Pagination"
          class={`pt-4 border-t border-slate-100 flex flex-col sm:flex-row sm:items-center justify-between gap-3 ${initialPhase && initialPhase.projects.length > 10 ? '' : 'hidden'}`}
        >
          <p id="ipp-page-info" class="text-xs font-medium text-slate-600">
            {initialPhase ? `Showing 1–${Math.min(10, initialPhase.projects.length)} of ${initialPhase.projects.length} projects` : ''}
          </p>
          <div id="ipp-page-buttons" class="flex flex-wrap items-center gap-1.5"></div>
        </nav>
      </div>
    </section>
  </div>

  <!-- Embedded JSON Payload for Instant Client-Side Switch (OWASP safe: escaped to prevent script breakout) -->
  <script id="ipp-phases-json" type="application/json" set:html={JSON.stringify(phasesWithCalculations).replace(/</g, '\\u003c').replace(/>/g, '\\u003e')} />
</Layout>

<script is:inline>
(function() {
  var dataEl = document.getElementById('ipp-phases-json');
  if (!dataEl) return;

  var phases = [];
  try {
    phases = JSON.parse(dataEl.textContent || '[]');
  } catch (e) {
    return;
  }

  var phaseMap = {};
  phases.forEach(function(p) {
    phaseMap[p.id] = p;
  });

  var tabs = Array.from(document.querySelectorAll('.phase-tab-btn'));
  var tableSection = document.getElementById('ipp-table-section');
  var titleTextEl = document.getElementById('active-phase-title-text');
  var countEl = document.getElementById('active-phase-count');
  var tbody = document.getElementById('table-tbody');
  var captionEl = document.getElementById('table-caption');
  var announcer = document.getElementById('a11y-announcer');
  var paginationNav = document.getElementById('ipp-pagination');
  var pageInfoEl = document.getElementById('ipp-page-info');
  var pageBtnsEl = document.getElementById('ipp-page-buttons');
  var PAGE_SIZE = 10;
  var activePhaseId = null;
  var currentPage = 1;

  function renderPagination(phase, pageNum) {
    if (!paginationNav || !pageInfoEl || !pageBtnsEl) return;
    var total = phase.projects.length;
    var totalPages = Math.ceil(total / PAGE_SIZE) || 1;
    if (total <= PAGE_SIZE) {
      paginationNav.classList.add('hidden');
      pageBtnsEl.innerHTML = '';
      return;
    }

    paginationNav.classList.remove('hidden');
    var start = (pageNum - 1) * PAGE_SIZE + 1;
    var end = Math.min(pageNum * PAGE_SIZE, total);
    pageInfoEl.textContent = 'Showing ' + start + '–' + end + ' of ' + total + ' projects (Page ' + pageNum + ' of ' + totalPages + ')';

    var html = '';
    var prevDisabled = pageNum <= 1;
    html += '<button type="button" data-page="' + (pageNum - 1) + '" ' + (prevDisabled ? 'disabled aria-disabled="true"' : '') +
      ' class="ipp-page-btn px-3 py-1.5 rounded text-xs font-semibold border ' +
      (prevDisabled ? 'border-slate-200 text-slate-400 bg-slate-50 cursor-not-allowed' : 'border-slate-300 text-slate-700 bg-white hover:bg-slate-50 cursor-pointer') +
      '" aria-label="Previous page">&lsaquo; Prev</button>';

    for (var p = 1; p <= totalPages; p++) {
      var isCurrent = p === pageNum;
      html += '<button type="button" data-page="' + p + '" ' + (isCurrent ? 'aria-current="page"' : '') +
        ' class="ipp-page-btn min-w-[34px] px-2.5 py-1.5 rounded text-xs font-bold border transition-colors cursor-pointer ' +
        (isCurrent ? 'bg-[#0B3B60] text-white border-[#0B3B60]' : 'bg-white text-slate-700 border-slate-300 hover:bg-slate-50') +
        '" aria-label="Page ' + p + '">' + p + '</button>';
    }

    var nextDisabled = pageNum >= totalPages;
    html += '<button type="button" data-page="' + (pageNum + 1) + '" ' + (nextDisabled ? 'disabled aria-disabled="true"' : '') +
      ' class="ipp-page-btn px-3 py-1.5 rounded text-xs font-semibold border ' +
      (nextDisabled ? 'border-slate-200 text-slate-400 bg-slate-50 cursor-not-allowed' : 'border-slate-300 text-slate-700 bg-white hover:bg-slate-50 cursor-pointer') +
      '" aria-label="Next page">Next &rsaquo;</button>';

    pageBtnsEl.innerHTML = html;
    pageBtnsEl.querySelectorAll('.ipp-page-btn').forEach(function(btn) {
      btn.addEventListener('click', function() {
        var targetPage = parseInt(btn.getAttribute('data-page') || '1', 10);
        if (!btn.disabled && targetPage >= 1 && targetPage <= totalPages) {
          renderPhase(activePhaseId, true, targetPage);
          if (tableSection) tableSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      });
    });
  }

  function renderPhase(phaseId, updateHistory, pageNum) {
    var phase = phaseMap[phaseId];
    if (!phase) return;
    activePhaseId = phaseId;
    var totalPages = Math.ceil(phase.projects.length / PAGE_SIZE) || 1;
    currentPage = Math.min(Math.max(1, parseInt(pageNum || '1', 10)), totalPages);

    // 1. Update tab styling and accessibility states
    tabs.forEach(function(tab) {
      var isSelected = tab.dataset.phaseId === phaseId;
      tab.setAttribute('aria-selected', isSelected ? 'true' : 'false');
      tab.setAttribute('tabindex', isSelected ? '0' : '-1');

      if (isSelected) {
        tab.classList.add('border-2', 'border-[#0B3B60]', 'bg-[#EAF4FF]', 'text-[#0B3B60]', 'shadow-sm', 'ring-1', 'ring-[#0B4F9C]/20');
        tab.classList.remove('border-slate-200', 'bg-white', 'text-slate-800', 'shadow-xs');
      } else {
        tab.classList.remove('border-2', 'border-[#0B3B60]', 'bg-[#EAF4FF]', 'text-[#0B3B60]', 'shadow-sm', 'ring-1', 'ring-[#0B4F9C]/20');
        tab.classList.add('border-slate-200', 'bg-white', 'text-slate-800', 'shadow-xs');
      }
    });

    // 2. Reveal table section
    if (tableSection) {
      tableSection.classList.remove('hidden');
    }

    // 3. Update title and counts
    if (titleTextEl) {
      titleTextEl.textContent = phase.name + ' Projects';
    }
    if (countEl) {
      countEl.innerHTML = 'Showing ' + phase.projectCount + ' project(s) &bull; Total: ' + phase.totalMw;
    }
    if (captionEl) {
      captionEl.textContent = 'List of IPP projects under ' + phase.name + ' (Page ' + currentPage + ' of ' + totalPages + ')';
    }

    // 4. Render Paginated Table Rows (10 per page)
    var startIdx = (currentPage - 1) * PAGE_SIZE;
    var pagedProjects = phase.projects.slice(startIdx, startIdx + PAGE_SIZE);

    if (tbody) {
      if (pagedProjects.length === 0) {
        tbody.innerHTML = '<tr><td colspan="4" class="text-center py-8 text-sm text-slate-500 font-semibold">' +
          'No projects are registered under this allotment phase yet.' +
        '</td></tr>';
      } else {
        var rowsHtml = '';
        pagedProjects.forEach(function(proj) {
          var loc = proj.location || '—';
          if (proj.basin) loc += ' • ' + proj.basin;

          // Equal 25% spacing across all 4 columns, text-left aligned matching standard table design
          rowsHtml += '<tr>' +
            '<td class="text-left font-semibold text-slate-800 break-words" style="width: 25%;">' +
              '<div>' + proj.name + '</div>' +
              '<div class="text-slate-500 font-normal text-xs mt-0.5">' + loc + '</div>' +
            '</td>' +
            '<td class="text-left font-semibold text-slate-700 whitespace-nowrap" style="width: 25%;">' +
              proj.capacityMw + ' MW' +
            '</td>' +
            '<td class="text-left text-slate-600 break-words" style="width: 25%;">' +
              (proj.status || '—') +
            '</td>' +
            '<td class="text-left text-slate-600 break-words" style="width: 25%;">' +
              (proj.awardedTo || '—') +
            '</td>' +
          '</tr>';
        });
        tbody.innerHTML = rowsHtml;
      }
    }

    renderPagination(phase, currentPage);

    // 5. Accessible screen reader announcement
    if (announcer) {
      announcer.textContent = phase.name + ' selected, page ' + currentPage + ' of ' + totalPages + '. ' + phase.projectCount + ' projects listed with total capacity of ' + phase.totalMw + '.';
    }

    // 6. Update URL query parameter
    if (updateHistory !== false) {
      var url = new URL(window.location.href);
      url.searchParams.set('phase', phaseId);
      if (currentPage > 1) {
        url.searchParams.set('page', String(currentPage));
      } else {
        url.searchParams.delete('page');
      }
      window.history.pushState({ phase: phaseId, page: currentPage }, '', url.toString());
    }
  }

  // Bind click & keyboard events
  tabs.forEach(function(tab, index) {
    tab.addEventListener('click', function() {
      renderPhase(tab.dataset.phaseId, true);
    });

    // Arrow navigation & Home/End for WAI-ARIA tablist accessibility
    tab.addEventListener('keydown', function(e) {
      var targetIndex = -1;
      if (e.key === 'ArrowRight' || e.key === 'ArrowDown') {
        targetIndex = (index + 1) % tabs.length;
      } else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') {
        targetIndex = (index - 1 + tabs.length) % tabs.length;
      } else if (e.key === 'Home') {
        targetIndex = 0;
      } else if (e.key === 'End') {
        targetIndex = tabs.length - 1;
      }

      if (targetIndex !== -1) {
        e.preventDefault();
        tabs[targetIndex].focus();
        renderPhase(tabs[targetIndex].dataset.phaseId, true);
      }
    });
  });

  // Handle browser back and forward navigation
  window.addEventListener('popstate', function() {
    var params = new URLSearchParams(window.location.search);
    var pId = params.get('phase');
    if (pId && phaseMap[pId]) {
      renderPhase(pId, false);
    } else {
      // Revert to initial state (no table shown)
      tabs.forEach(function(t) {
        t.setAttribute('aria-selected', 'false');
        t.setAttribute('tabindex', '-1');
        t.classList.remove('border-2', 'border-[#0B3B60]', 'bg-[#EAF4FF]', 'text-[#0B3B60]', 'shadow-sm', 'ring-1', 'ring-[#0B4F9C]/20');
        t.classList.add('border-slate-200', 'bg-white', 'text-slate-800', 'shadow-xs');
      });
      if (tabs[0]) tabs[0].setAttribute('tabindex', '0');
      if (tableSection) tableSection.classList.add('hidden');
    }
  });

  // Initial check on page load if query param exists
  var initialParams = new URLSearchParams(window.location.search);
  var initialPhaseId = initialParams.get('phase');
  var initialPage = parseInt(initialParams.get('page') || '1', 10);
  if (initialPhaseId && phaseMap[initialPhaseId]) {
    renderPhase(initialPhaseId, false, initialPage);
  } else {
    // Make first tab focusable for keyboard users
    if (tabs[0]) tabs[0].setAttribute('tabindex', '0');
  }
})();
</script>
