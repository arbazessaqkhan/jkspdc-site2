      { name: 'Dhauli Ganga Small HEP', capacityMw: 25, basin: 'Ravi Basin', location: 'Kathua', status: 'Implementation Agreement', developer: 'Allotted IPP Developer', remarks: 'Land Acquisition Phase' }
    ]
  },
  { 
