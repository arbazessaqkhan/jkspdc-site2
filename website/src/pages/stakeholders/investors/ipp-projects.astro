    projects: [
      { name: 'Mega Renewable Energy Park Phase-X', capacityMw: 500, basin: 'Multi-Basin', location: 'J&K Region', status: 'Concept & Policy Stage', developer: 'State IPP Cell / Joint Venture', remarks: 'Policy Framework Under Review' }
