      { name: 'Kirthai Stage-II HEP', capacityMw: 930, basin: 'Chenab Basin', location: 'Kishtwar', status: 'DPR Approved', developer: 'Chenab Valley Power Projects (CVPPPL)', remarks: 'Pre-construction Activities' }
