const phase1Data = ippPhases[0];
---

<Layout 
  title="IPP Projects - Investors Corner" 
  description="Independent Power Producer (IPP) Hydroelectric & Renewable Energy Projects across J&K."
>
  <div class="space-y-0 max-w-5xl mx-auto">
    <!-- Premium Page Header Band -->
    <div class="page-header-band animate-fadeInUp">
      <nav class="breadcrumb-trail" aria-label="Breadcrumbs">
        <a href="/">Home</a>
        <span class="separator">/</span>
        <span>Investors Corner</span>
        <span class="separator">/</span>
        <span class="current">IPP Projects</span>
      </nav>
      <h1>IPP Projects</h1>
      <p class="page-subtitle">Jammu &amp; Kashmir State Power Development Corporation Limited (JKSPDCL)</p>
    </div>

    <!-- Phase Selector Buttons Grid (No MW text, Click leads directly inside data behind) -->
    <div class="animate-fadeInUp delay-200 space-y-4">
      <div class="flex items-center justify-between border-b border-[#0B4F9C]/20 pb-2">
        <h2 class="text-sm font-bold uppercase tracking-wider text-[#0B4F9C] flex items-center gap-2">
          <Icon name="briefcase" size={16} strokeWidth={2} />
          Select Project Allotment Phase
        </h2>
        <span class="text-xs font-semibold text-[#0B4F9C]">
          Click any Phase button to open stored details
        </span>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4" id="phase-buttons-container">
        {ippPhases.map((phase) => (
          <a
            href={`/stakeholders/investors/ipp-project-details?phase=${phase.id}`}
            class="phase-card-btn group block p-5 rounded-xl border border-slate-200 hover:border-slate-300 bg-white hover:bg-slate-50 text-center shadow-xs hover:shadow-md transition-all duration-200 cursor-pointer select-none focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#0B4F9C]"
          >
            <span class="text-lg font-extrabold text-[#0B4F9C] group-hover:text-[#073B75] tracking-wide block">
              {phase.name}
            </span>
            <span class="text-xs font-semibold text-slate-500 mt-1 block group-hover:text-[#0B4F9C]">
              Open Phase Data &rarr;
            </span>
          </a>
        ))}
      </div>
    </div>

    <!-- Default Static Phase 1 Overview Register -->
    <div id="phase-detail-card" class="bg-white rounded-xl border border-slate-200 shadow-xs p-6 sm:p-8 space-y-6 animate-fadeIn delay-300">
      <!-- Active Phase Title Banner -->
      <div class="border-b border-slate-200 pb-4 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
        <div>
          <div class="inline-block text-[10px] font-bold uppercase tracking-wider bg-slate-100 text-[#0B4F9C] px-3 py-1 rounded-full mb-1 border border-slate-200">
            Default Allotment Phase Overview
          </div>
          <h2 class="text-xl sm:text-2xl font-extrabold text-[#0B4F9C]">
            {phase1Data.title}
          </h2>
          <p class="text-xs sm:text-sm text-slate-600 font-normal mt-1 leading-relaxed">
            {phase1Data.desc}
          </p>
        </div>
        <div class="flex items-center gap-3 flex-shrink-0">
          <a href={`/stakeholders/investors/ipp-project-details?phase=${phase1Data.id}`} class="bg-[#0B4F9C] hover:bg-[#084A8F] text-white text-xs font-bold px-4 py-2 rounded-lg shadow-xs transition-all flex items-center gap-1.5">
            <span>Explore Phase 1 Full Data</span> &rarr;
          </a>
        </div>
      </div>

      <!-- Static Stored Project Table for Phase 1 -->
      <div class="space-y-4">
        <!-- Select Phase # dropdown matching Image 1 -->
        <div class="flex items-center gap-3 pb-1">
          <label for="select-phase-dropdown" class="text-xs font-bold text-slate-700">Select Phase #</label>
          <select 
            id="select-phase-dropdown" 
            onchange="if(this.value) window.location.href='/stakeholders/investors/ipp-project-details?phase=' + this.value;"
            class="bg-white border border-slate-300 rounded px-2.5 py-1 text-xs font-bold text-slate-800 outline-none focus:ring-2 focus:ring-[#0B4F9C]"
          >
            {ippPhases.map((phase) => (
              <option value={phase.id} selected={phase.id === phase1Data.id}>
                {phase.name.toUpperCase().replace('PHASE ', 'PHASE-')}
              </option>
            ))}
          </select>
        </div>

        <div class="table-wrapper">
          <table class="table-data min-w-full">
            <thead>
              <tr class="bg-[#2D60A6] text-white">
                <th scope="col" class="text-left py-3 px-4 text-xs font-bold">Project</th>
                <th scope="col" class="text-center py-3 px-4 text-xs font-bold whitespace-nowrap">Installed Capacity in MW</th>
                <th scope="col" class="text-left py-3 px-4 text-xs font-bold">Status</th>
                <th scope="col" class="text-left py-3 px-4 text-xs font-bold">Awarded To</th>
              </tr>
              <tr class="bg-[#4176B8] text-white font-extrabold text-center text-xs tracking-wider uppercase">
                <th colspan="4" class="py-2.5 text-center">{phase1Data.name.toUpperCase().replace('PHASE ', 'PHASE-')} PROJECTS</th>
              </tr>
            </thead>
            <tbody>
              {phase1Data.projects.map((proj) => (
                <tr class="hover:bg-slate-50/80 transition-colors border-b border-slate-200">
                  <td class="text-left py-3 px-4 text-xs">
                    <div class="text-slate-800 font-medium">{proj.name}</div>
                    <div class="text-slate-900 font-bold mt-0.5">{proj.location}</div>
                  </td>
                  <td class="text-center font-semibold text-slate-700 text-xs py-3 px-4">{proj.capacityMw}</td>
                  <td class="text-left text-xs text-slate-700 py-3 px-4">{proj.status}</td>
                  <td class="text-left text-xs text-slate-700 py-3 px-4">{proj.developer}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <!-- Information Callout Note -->
        <div class="bg-blue-50/60 border border-blue-200/80 rounded-xl p-4 text-xs text-slate-700 leading-relaxed flex items-start gap-3">
          <Icon name="info" size={18} strokeWidth={2} class="text-[#0B4F9C] flex-shrink-0 mt-0.5" />
          <div>
            <span class="font-bold text-[#0B4F9C] block mb-0.5">Corporate IPP Framework Note:</span>
            Clicking any Phase button above will open the complete stored dataset, developer credentials, and DPR specifications for that specific phase.
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>
