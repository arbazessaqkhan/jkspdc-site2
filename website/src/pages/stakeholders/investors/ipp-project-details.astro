      { name: 'Sewa I Hydroelectric Project', capacityMw: 8, basin: 'Ravi River Basin', location: 'Kathua District', status: 'Non Responsive', developer: '—', loiDate: '—', dprStatus: 'Non Responsive', remarks: 'Non Responsive Bid' },
      { name: 'Erin Hydroelectric Project', capacityMw: 10, basin: 'Jhelum River Basin', location: 'Bandipore District', status: 'No Response', developer: '—', loiDate: '—', dprStatus: 'No Response', remarks: 'No Response.' },
      { name: 'Nihama Hydroelectric Project', capacityMw: 6, basin: 'Jhelum River Basin', location: 'Kulgam District', status: 'LOA Withdrawn', developer: 'Ms Millde East Recycling Company WILL.', loiDate: '—', dprStatus: 'LOA Withdrawn', remarks: 'Bidder Didnot pay upfront Premium. LOA WithdrawnTo be retendered under Phase IV' },
      { name: 'Chenani IV Hydroelectric Project', capacityMw: 7, basin: 'Chenab River Basin', location: 'Udhampur District', status: 'Non Responsive', developer: '—', loiDate: '—', dprStatus: 'Non Responsive', remarks: 'Non Responsive Bid.' },
      { name: 'Bringi Hydroelectric Project', capacityMw: 4, basin: 'Jhelum River Basin', location: 'Anantnag District', status: 'No Response', developer: '—', loiDate: '—', dprStatus: 'No Response', remarks: 'No Response.' }
