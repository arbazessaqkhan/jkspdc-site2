      { name: 'Ans I Hydroelectric Project', capacityMw: 40, basin: 'Chenab River Basin', location: 'Riasi District', status: 'Implementation Agreement', developer: 'Ms Sri Awantika Consortium', loiDate: '—', dprStatus: 'DPR under preparation', remarks: 'In 2012 Implementation agreement was signed and DPR was under prepration. However the IPP has' },
      { name: 'Girjan Ki Gali Hydroelectric Project', capacityMw: 12, basin: 'Chenab River Basin', location: 'Rajaori District', status: 'DPR Preparation', developer: 'Ms Raheja Power Ventures Pvt Ltd', loiDate: '—', dprStatus: 'DPR under preparation', remarks: 'DPR under preparation' },
      { name: 'Patnazi Bunjwa Hydroelectric Project', capacityMw: 21, basin: 'Chenab River Basin', location: 'Kishtwar District', status: 'TEC Accorded', developer: 'Ms Patnazi Power (Energo Group)', loiDate: '—', dprStatus: 'TEC Accorded to DPR', remarks: 'TEC accorded to DPR' }
    ]
  }
};

// Fallback for Phase 4, 6, 7, 8, 9, 10
const activePhaseData = phaseDatabase[phaseParam] || {
  id: phaseParam,
  name: phaseParam.replace('phase-', 'Phase '),
  title: `${phaseParam.replace('phase-', 'Phase ').toUpperCase()} — IPP Project Specifications`,
  subtitle: `Detailed Technical & Investor Information Register for ${phaseParam.replace('phase-', 'Phase ')}`,
  totalMw: '100.0 MW',
  policyRef: 'J&K IPP Policy Guidelines & State Renewable Directives',
  status: 'Allotment & Survey Stage',
  description: `Detailed stored project specifications, capacity allocations, and clearance registers for ${phaseParam.replace('phase-', 'Phase ')} under JKSPDC investor framework.`,
  projects: [
    { name: `IPP Hydro Project Slot ${phaseParam.replace('phase-', '')}.1`, capacityMw: 60, basin: 'Chenab / Jhelum Basin', location: 'J&K Region', status: 'Survey & Investigation', developer: 'Empanelled IPP Developer', loiDate: '2024-01-15', dprStatus: 'Draft DPR Under Preparation', remarks: 'Hydrological data and water availability study active.' },
    { name: `IPP Renewable Project Slot ${phaseParam.replace('phase-', '')}.2`, capacityMw: 40, basin: 'Outer Plains / Indus Basin', location: 'J&K Region', status: 'Implementation Agreement', developer: 'Renewable Energy Partner', loiDate: '2024-06-20', dprStatus: 'Techno-Economic Appraisal', remarks: 'Grid interconnection approval in process.' }
  ]
};
---

<Layout 
  title={`${activePhaseData.name} Details - IPP Projects`} 
  description={activePhaseData.desc}
>
  <div class="space-y-8">
    <!-- Premium Page Header Band -->
    <div class="page-header-band animate-fadeInUp">
      <nav class="breadcrumb-trail" aria-label="Breadcrumbs">
        <a href="/">Home</a>
        <span class="separator">/</span>
        <a href="/stakeholders/investors/ipp-projects">IPP Projects</a>
        <span class="separator">/</span>
        <span class="current">{activePhaseData.name}</span>
      </nav>
      <h1>{activePhaseData.title}</h1>
      <p class="page-subtitle">Jammu &amp; Kashmir State Power Development Corporation Limited (JKSPDCL)</p>
    </div>

    <!-- Inside Details Overview Box (Corporate Theme) -->
    <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-6 sm:p-8 space-y-6 animate-fadeInUp delay-200">
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 border-b border-slate-200 pb-5">
        <div>
          <div class="inline-block text-[10px] font-bold uppercase tracking-wider bg-[#EAF4FF] text-[#0B4F9C] px-3 py-1 rounded-full mb-2 border border-[#BDD7EE]">
            Inside Project Details Register
          </div>
          <h2 class="text-xl sm:text-2xl font-extrabold text-[#0B4F9C]">
            {activePhaseData.subtitle}
          </h2>
          <p class="text-xs sm:text-sm text-slate-600 font-normal mt-1 leading-relaxed max-w-3xl">
            {activePhaseData.description}
          </p>
        </div>
        <div class="flex flex-col sm:flex-row items-start sm:items-center gap-3 flex-shrink-0">
          <span class="bg-[#0B4F9C] text-white font-extrabold text-xs px-3.5 py-2 rounded-lg shadow-xs">
            Total Capacity: {activePhaseData.totalMw}
          </span>
          <a href="/stakeholders/investors/ipp-projects" class="bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-bold px-3.5 py-2 rounded-lg border border-slate-300 transition-colors">
            &larr; Back to All Phases
          </a>
        </div>
      </div>

      <!-- Quick Metrics Grid -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <div class="bg-slate-50 border border-slate-200 rounded-xl p-4">
          <span class="text-[10px] font-bold text-slate-500 uppercase tracking-wider block">Policy Framework</span>
          <span class="text-xs font-extrabold text-[#0B4F9C] mt-1 block">{activePhaseData.policyRef}</span>
        </div>
        <div class="bg-slate-50 border border-slate-200 rounded-xl p-4">
          <span class="text-[10px] font-bold text-slate-500 uppercase tracking-wider block">Execution Status</span>
          <span class="text-xs font-extrabold text-emerald-700 mt-1 block">{activePhaseData.status}</span>
        </div>
        <div class="bg-slate-50 border border-slate-200 rounded-xl p-4">
          <span class="text-[10px] font-bold text-slate-500 uppercase tracking-wider block">Total Allocated Projects</span>
          <span class="text-xs font-extrabold text-slate-800 mt-1 block">{activePhaseData.projects.length} Projects Listed</span>
        </div>
        <div class="bg-slate-50 border border-slate-200 rounded-xl p-4">
          <span class="text-[10px] font-bold text-slate-500 uppercase tracking-wider block">Monitoring Authority</span>
          <span class="text-xs font-extrabold text-[#0B4F9C] mt-1 block">JKSPDC Corporate IPP Cell</span>
        </div>
      </div>

      <!-- Detailed Projects Specification Table -->
      <div class="space-y-4 pt-2">
        <div class="flex items-center justify-between">
          <h3 class="text-sm font-bold text-slate-800 uppercase tracking-wider flex items-center gap-2">
            <Icon name="briefcase" size={16} strokeWidth={2} class="text-[#0B4F9C]" />
            Inside Specifications &amp; Project Allocations ({activePhaseData.name})
          </h3>
        </div>

        <div class="table-wrapper">
          <table class="table-data min-w-full">
            <thead>
              <tr>
                <th scope="col" class="text-left">S.No</th>
                <th scope="col" class="text-left">Project Name</th>
                <th scope="col" class="text-left">River Basin / District</th>
                <th scope="col" class="text-left">Capacity</th>
                <th scope="col" class="text-left">LoI / Allotment Date</th>
                <th scope="col" class="text-left">DPR / Clearance Stage</th>
                <th scope="col" class="text-left">Developer / Allotted IPP</th>
                <th scope="col" class="text-left">Remarks & Status</th>
              </tr>
            </thead>
            <tbody>
              {activePhaseData.projects.map((proj: any, idx: number) => (
                <tr class="hover:bg-slate-50/80 transition-colors">
                  <td class="text-left font-bold text-xs">{idx + 1}</td>
                  <td class="font-bold text-left text-xs text-[#0B4F9C]">{proj.name}</td>
                  <td class="text-left text-xs">{proj.location}<br/><span class="text-[11px] text-slate-500">{proj.basin}</span></td>
                  <td class="font-bold text-slate-800 text-left text-xs">{proj.capacityMw} MW</td>
                  <td class="text-left text-xs font-medium text-slate-600">{proj.loiDate}</td>
                  <td class="text-left text-xs">
                    <span class="inline-block bg-blue-50 text-[#0B4F9C] border border-blue-200 px-2 py-0.5 rounded text-[11px] font-bold">
                      {proj.dprStatus}
                    </span>
                  </td>
                  <td class="text-left text-xs text-slate-700 font-semibold">{proj.developer}</td>
                  <td class="text-left text-xs text-slate-500">{proj.remarks}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</Layout>
