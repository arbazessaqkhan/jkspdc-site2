    policyRef: 'Strategic Hybrid & Clean Energy Policy',
    status: 'No Projects Registered',
    description: 'No projects are currently registered under Phase IX.',
    projects: []
  },
  'phase-10': {
    id: 'phase-10',
    name: 'Phase 10',
    title: 'Phase X — Ultra Mega Renewable Energy Parks',
    subtitle: 'Ultra Mega Renewable & Hydro Energy Parks',
