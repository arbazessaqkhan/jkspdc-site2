    totalMw: '0.0 MW',
    policyRef: 'J&K BOOT IPP Policy Framework Phase IV',
    status: 'No Projects Registered',
    description: 'No projects are currently registered under Phase IV.',
    projects: []
  },
  'phase-5': {
    id: 'phase-5',
    name: 'Phase 5',
    title: 'Phase V — IPP Hydroelectric Projects Allotments',
    subtitle: 'Allotments & DPR Evaluation Status',
    totalMw: '0.0 MW',
    policyRef: 'J&K BOOT IPP Policy Framework Phase V',
