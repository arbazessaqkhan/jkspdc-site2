---
import Layout from '../../../layouts/Layout.astro';
---

<Layout 
  title="CSR Activities Reports - Sustainability" 
  description="Official reports and disclosures of CSR activities executed by JKSPDC."
>
  <div class="space-y-0 max-w-5xl mx-auto">
    <!-- Premium Page Header Band -->
    <div class="page-header-band animate-fadeInUp">
      <nav class="breadcrumb-trail" aria-label="Breadcrumbs">
        <a href="/">Home</a>
        <span class="separator">/</span>
        <span>Sustainability</span>
        <span class="separator">/</span>
        <span class="current">CSR Activities Reports</span>
      </nav>
      <h1>CSR Activities Reports</h1>
      <p class="page-subtitle">Jammu &amp; Kashmir State Power Development Corporation Limited (JKSPDCL)</p>
    </div>

    <!-- Content -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 animate-fadeInUp delay-200">
      <!-- Main Text -->
      <article class="lg:col-span-2 prose-gov">
        <!-- Safety content placeholder -->
        <div class="bg-gray-50 border border-gray-200 text-gray-700 rounded-lg p-6 text-center text-sm shadow-sm">
          <p class="font-semibold text-gray-800 mb-1">CSR Activities Reports Pending Official Approval</p>
          <p class="text-xs text-gray-500">Official statutory registers and audited spend sheets are currently undergoing review.</p>
          <div class="mt-3 inline-block bg-neutral-200 text-neutral-800 px-3 py-1 rounded text-[10px] font-bold uppercase tracking-wider">
            [Content Pending Approval]
          </div>
        </div>
      </article>

      <!-- Sidebar -->
      <aside class="space-y-5 animate-fadeIn delay-300">
        <div class="card-static">
          <h3 class="sidebar-card-title">CSR Portal</h3>
          <ul class="flex flex-col gap-2 text-xs font-semibold text-[#0B4F9C]">
            <li><a href="/sustainability/csr/overview" class="sidebar-link">Overview</a></li>
            <li><a href="/sustainability/csr/plans" class="sidebar-link">Annual CSR Plans</a></li>
          </ul>
        </div>
      </aside>
    </div>
  </div>
</Layout>
