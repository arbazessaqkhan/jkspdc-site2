---
import Layout from '../../../layouts/Layout.astro';
import Icon from '../../../components/Icon.astro';

let csrDocuments = [];

try {
  const res = await fetch('http://localhost:3000/api/policies?category=CSR');
  if (res.ok) {
    const data = await res.json();
    csrDocuments = data.filter(d => d.status === 'Active');
  }
} catch (e) {
  console.error('Error fetching CSR policies:', e);
}

// Fallback to static CSR policy if none exist in the database
if (csrDocuments.length === 0) {
  csrDocuments = [
    {
      id: "fallback-csr",
      title: "Corporate Social Responsibility (CSR) Policy",
      description: "Approved corporate policy statement detailing community development parameters, budget allocations, and regional project selection guidelines.",
      documentUrl: "/JKSPDC CSR Policy.pdf",
      status: "Active"
    }
  ];
}
---

<Layout 
  title="CSR Policy - Sustainability" 
  description="Corporate Social Responsibility (CSR) policy guidelines of JKSPDC."
>
  <div class="space-y-6">
    <!-- Breadcrumbs -->
    <nav class="text-xs text-gray-500" aria-label="Breadcrumbs">
      <ol class="flex gap-2">
        <li><a href="/" class="hover:underline">Home</a></li>
        <li>/</li>
        <li><span class="text-gray-400">About Us</span></li>
        <li>/</li>
        <li><span class="font-semibold text-[#0B4F9C]">CSR Policy</span></li>
      </ol>
    </nav>

    <!-- Page Header -->
    <header class="border-b border-gray-200 pb-4">
      <h2 class="text-3xl font-extrabold text-[#0B4F9C]">CSR Policy</h2>
      <p class="text-sm text-gray-600 mt-1">Official guidelines regulating corporate social responsibility spendings and parameters.</p>
    </header>

    <!-- Content -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
      <!-- Main Text -->
      <article class="lg:col-span-2 space-y-4">
        {csrDocuments.map((doc) => (
          <div class="bg-white border border-[#BDD7EE] hover:border-[#9BC2E6] rounded-xl p-5 shadow-sm transition-all duration-200 flex flex-col md:flex-row md:items-center justify-between gap-4">
            <div class="space-y-1.5 max-w-xl">
              <div class="flex items-center gap-2 flex-wrap">
                <span class="text-[9px] uppercase tracking-wider font-extrabold text-[#0B4F9C] bg-[#0B4F9C]/5 px-2 py-0.5 rounded">
                  Sustainability
                </span>
                <span class="bg-emerald-100 text-emerald-700 text-[9px] font-extrabold uppercase px-2 py-0.5 rounded">
                  Active
                </span>
              </div>
              <h3 class="font-bold text-gray-900 text-base mt-1 flex items-center gap-1.5">
                {doc.title}
              </h3>
              <p class="text-xs text-slate-500 leading-relaxed mt-1">
                {doc.description || "Official community development project declaration and budget parameter statements of the corporation."}
              </p>
            </div>
            
            <div class="shrink-0 flex items-center">
              <a 
                href={doc.documentUrl} 
                target="_blank" 
                rel="noopener noreferrer" 
                class="w-full md:w-auto inline-flex items-center justify-center gap-2 bg-[#0B4F9C] hover:bg-[#084A8F] text-white font-bold text-xs px-5 py-2.5 rounded transition-all duration-150 shadow-sm cursor-pointer"
              >
                <Icon name="search" size={13} strokeWidth={2.5} /> View Policy PDF
              </a>
            </div>
          </div>
        ))}
      </article>

      <!-- Sidebar -->
      <aside class="space-y-4">
        <div class="card-static">
          <h3 class="font-bold text-gray-900 mb-2 border-b border-gray-100 pb-2">CSR Portal</h3>
          <ul class="flex flex-col gap-2 text-xs font-semibold text-[#0B4F9C]">
            <li><a href="/sustainability/csr/overview" class="hover:underline block py-1">&rarr; Overview</a></li>
            <li><a href="/sustainability/csr/communication-policy" class="hover:underline block py-1">&rarr; CSR Communication Policy</a></li>
          </ul>
        </div>
      </aside>
    </div>
  </div>
</Layout>
