---
import Layout from '../../../layouts/Layout.astro';
import Icon from '../../../components/Icon.astro';

function getDocUrl(url?: string) {
  if (!url) return '#';
  if (url.startsWith('/uploads/')) {
    return `${import.meta.env.PUBLIC_API_BASE}${url}`;
  }
  return url;
}

let csrDocuments: any[] = [];

try {
  const res = await fetch(`${import.meta.env.PUBLIC_API_BASE}/api/policies`);
  if (res.ok) {
    const data = await res.json();
    csrDocuments = data.filter((d: any) => 
      d.status === 'Active' && 
      (
        d.category === 'CSR' || 
        (d.title && d.title.toUpperCase().includes('CSR')) || 
        (d.description && d.description.toUpperCase().includes('CSR'))
      )
    );
  }
} catch (e) {
  console.error('Error fetching CSR policies:', e);
}

// Fallback: If no CSR documents in database, keep list empty for admin uploads
---

<Layout 
  title="Corporate Social Responsibility (CSR) - Sustainability" 
  description="Corporate Social Responsibility (CSR) policy, committee disclosures, and board approved projects of JKSPDC."
>
  <div class="space-y-0 max-w-5xl mx-auto">
    <!-- Premium Page Header Band -->
    <div class="page-header-band animate-fadeInUp">
      <nav class="breadcrumb-trail" aria-label="Breadcrumbs">
        <a href="/">Home</a>
        <span class="separator">/</span>
        <span>About Us</span>
        <span class="separator">/</span>
        <span class="current">CSR Policy</span>
      </nav>
      <h1>Corporate Social Responsibility (CSR)</h1>
      <p class="page-subtitle">Jammu &amp; Kashmir State Power Development Corporation Limited (JKSPDCL)</p>
    </div>

    <!-- Content -->
    <div class="animate-fadeInUp delay-200">
      <!-- Main Content Area: CSR Table -->
      <article class="w-full space-y-6">
        
        <!-- Table Header Title (Styled to match screenshot & site theme) -->
        <div class="text-center mb-6">
          <h2 class="text-2xl md:text-3xl font-extrabold text-[#1D63B8] tracking-tight">
            Corporate Social Responsibility (CSR)
          </h2>
        </div>

        <!-- CSR Document Table -->
        <div class="table-wrapper">
          <table class="table-data min-w-full" aria-label="CSR Policy Documents">
            <thead>
              <tr>
                <th scope="col" class="w-12 text-center">#</th>
                <th scope="col">Document Title</th>
                <th scope="col" class="w-44">Category / Type</th>
                <th scope="col" class="w-36 text-center">Action</th>
              </tr>
            </thead>
            <tbody>
              {csrDocuments.length === 0 ? (
                <tr>
                  <td colspan="4" class="text-center text-slate-500 py-10 text-xs italic">
                    No CSR documents currently published. Please check back later.
                  </td>
                </tr>
              ) : (
                csrDocuments.map((doc: any, idx: number) => {
                  const docUrl = getDocUrl(doc.documentUrl);
                  const docType = doc.description || 'Policy';
                  return (
                    <tr class="hover:bg-[#EAF4FF]/80 transition-colors duration-150">
                      <td class="text-center font-bold text-slate-500">{idx + 1}</td>
                      <td class="font-semibold text-slate-900">{doc.title}</td>
                      <td class="text-slate-600 font-medium">{docType}</td>
                      <td class="text-center">
                        <a 
                          href={docUrl} 
                          target="_blank" 
                          rel="noopener noreferrer" 
                          class="inline-flex items-center justify-center gap-1.5 px-3.5 py-1.5 border border-[#0B4F9C] hover:bg-[#0B4F9C] hover:text-white text-[#0B4F9C] rounded text-xs font-bold transition-all"
                        >
                          <Icon name="file-text" size={12} />
                          <span>View PDF</span>
                          <span class="sr-only"> (opens in new tab)</span>
                        </a>
                      </td>
                    </tr>
                  );
                })
              )}
            </tbody>
          </table>
        </div>

      </article>
    </div>
  </div>
</Layout>

