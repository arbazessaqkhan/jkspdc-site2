---
import Layout from '../../../layouts/Layout.astro';
---

<Layout 
  title="CSR Overview - Sustainability" 
  description="Overview of Corporate Social Responsibility (CSR) initiatives at JKSPDC."
>
  <div class="space-y-6">
    <!-- Breadcrumbs -->
    <nav class="text-xs text-gray-500" aria-label="Breadcrumbs">
      <ol class="flex gap-2">
        <li><a href="/" class="hover:underline">Home</a></li>
        <li>/</li>
        <li><span class="text-gray-400">Sustainability</span></li>
        <li>/</li>
        <li><span class="text-gray-400">CSR</span></li>
        <li>/</li>
        <li><span class="font-semibold text-[#003366]">Overview</span></li>
      </ol>
    </nav>

    <!-- Page Header -->
    <header class="border-b border-gray-200 pb-4">
      <h2 class="text-3xl font-extrabold text-[#003366]">CSR Operations Overview</h2>
      <p class="text-sm text-gray-600 mt-1">Introduction to corporate social responsibility, community outreach, and project guidelines.</p>
    </header>

    <!-- Content -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
      <!-- Main Text -->
      <article class="lg:col-span-2 space-y-4">
        <p class="text-sm text-gray-700 leading-relaxed">
          JKSPDC prioritizes local community welfare, infrastructure development, and education around its hydroelectric projects through focused CSR initiatives.
        </p>

        <!-- Safety content placeholder -->
        <div class="bg-gray-50 border border-gray-200 text-gray-700 rounded-lg p-6 text-center text-sm shadow-sm">
          <p class="font-semibold text-gray-800 mb-1">CSR Profile & Statistics Pending Official Approval</p>
          <p class="text-xs text-gray-500">The detailed budget allocations and local development figures are currently undergoing official review.</p>
          <div class="mt-3 inline-block bg-neutral-200 text-neutral-800 px-3 py-1 rounded text-[10px] font-bold uppercase tracking-wider">
            [Content Pending Approval]
          </div>
        </div>
      </article>

      <!-- Sidebar -->
      <aside class="space-y-4">
        <div class="card-static">
          <h3 class="font-bold text-gray-900 mb-2 border-b border-gray-100 pb-2">CSR Portal</h3>
          <ul class="flex flex-col gap-2 text-xs font-semibold text-[#003366]">
            <li><a href="/sustainability/csr/policy" class="hover:underline block py-1">&rarr; CSR Policy</a></li>
            <li><a href="/sustainability/csr/guidelines" class="hover:underline block py-1">&rarr; Guidelines</a></li>
            <li><a href="/sustainability/csr/plans" class="hover:underline block py-1">&rarr; Annual CSR Plan</a></li>
            <li><a href="/sustainability/csr/reports" class="hover:underline block py-1">&rarr; Activities Reports</a></li>
          </ul>
        </div>
      </aside>
    </div>
  </div>
</Layout>
