---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';

function getDocUrl(url?: string) {
  if (!url) return '#';
  if (url.startsWith('/uploads/')) return `http://localhost:3000${url}`;
  return url;
}

let resources: any[] = [];

try {
  const res = await fetch('http://localhost:3000/api/downloads');
  if (res.ok) {
    const data = await res.json();
    resources = data.filter((r: any) => r.status === 'Active' || !r.status);
  }
} catch (e) {
  console.error('Error fetching resources:', e);
}

// Group resources by category
const grouped: Record<string, any[]> = {};
for (const r of resources) {
  const cat = r.category || 'Other';
  if (!grouped[cat]) grouped[cat] = [];
  grouped[cat].push(r);
}
const categoryKeys = Object.keys(grouped).sort();
---

<Layout
  title="Resources - JKSPDCL"
  description="Public resources, official documents, downloads and reference material from JKSPDC."
>
  <div class="space-y-0">

    <!-- Page Header Band -->
    <div class="page-header-band animate-fadeInUp">
      <nav class="breadcrumb-trail" aria-label="Breadcrumbs">
        <a href="/">Home</a>
        <span class="separator">/</span>
        <span class="current">Resources</span>
      </nav>
      <h1>Resources</h1>
      <p class="page-subtitle">Official documents, references, and downloadable resources of JKSPDCL</p>
    </div>

    <!-- Content -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 animate-fadeInUp delay-200">

      <!-- Main Content -->
      <article class="lg:col-span-2 space-y-8">

        {resources.length === 0 ? (
          <div class="bg-white border border-gray-200 rounded-xl p-10 text-center text-slate-400 text-sm">
            <Icon name="folder" size={40} class="mx-auto mb-3 text-slate-300" />
            No resources available at this time.
          </div>
        ) : categoryKeys.length === 0 ? (
          <div class="bg-white border border-gray-200 rounded-xl p-10 text-center text-slate-400 text-sm">
            No resources found.
          </div>
        ) : (
          categoryKeys.map((cat) => (
            <section class="space-y-3">
              <!-- Category Header -->
              <h2 class="text-sm font-extrabold text-[#0B4F9C] uppercase tracking-wider border-b-2 border-[#0B4F9C]/10 pb-2">
                {cat}
              </h2>

              <!-- Documents List -->
              <div class="space-y-2">
                {grouped[cat].map((doc: any, idx: number) => (
                  <div class="bg-white border border-gray-200 hover:border-[#9BC2E6] hover:shadow-sm rounded-lg px-4 py-3 transition-all duration-150 flex items-center gap-3">
                    <!-- Serial No -->
                    <span class="text-xs font-bold text-slate-400 shrink-0 w-6 text-right">{idx + 1}.</span>

                    <!-- PDF Icon -->
                    <span class="text-slate-400 shrink-0">
                      <Icon name="file-text" size={15} class="text-[#0B4F9C]/60" />
                    </span>

                    <!-- Clickable title — opens file in new tab -->
                    <a
                      href={getDocUrl(doc.documentUrl)}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="flex-1 text-xs font-semibold text-slate-800 hover:text-[#0B4F9C] hover:underline underline-offset-2 transition-colors leading-snug cursor-pointer"
                    >
                      {doc.title}
                    </a>
                  </div>
                ))}
              </div>
            </section>
          ))
        )}
      </article>

      <!-- Sidebar -->
      <aside class="space-y-5 animate-fadeIn delay-300">
        <div class="card-static">
          <h3 class="sidebar-card-title">Browse by Category</h3>
          <ul class="flex flex-col gap-1.5">
            {categoryKeys.map((cat) => (
              <li>
                <a
                  href={`#cat-${cat.toLowerCase().replace(/\s+/g, '-')}`}
                  class="flex items-center justify-between text-xs font-semibold text-[#0B4F9C] hover:underline"
                >
                  <span>{cat}</span>
                  <span class="text-[10px] font-bold text-slate-400 bg-slate-100 rounded px-1.5 py-0.5">{grouped[cat].length}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>

        <div class="card-static">
          <h3 class="sidebar-card-title">Quick Links</h3>
          <ul class="flex flex-col gap-2 text-xs font-semibold text-[#0B4F9C]">
            <li><a href="/media/press-releases" class="sidebar-link">Press Releases</a></li>
            <li><a href="/media/gallery" class="sidebar-link">Photo Gallery</a></li>
            <li><a href="/media/downloads" class="sidebar-link">Downloads</a></li>
            <li><a href="/notifications" class="sidebar-link">Notifications</a></li>
          </ul>
        </div>
      </aside>

    </div>
  </div>
</Layout>
