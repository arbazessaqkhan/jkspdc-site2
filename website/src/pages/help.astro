---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';

const faqs = [
  {
    q: "How do I access live tenders and bid documents?",
    a: "Live tenders are listed under Tenders > Live Tenders & Notices. Official e-procurement bidding is hosted on the official J&K government e-tendering portal at jktenders.gov.in."
  },
  {
    q: "Where can I view RTI Proactive Disclosures?",
    a: "Under the RTI menu tab in the top navigation, click on RTI Act (Sec 4) to view designated Public Information Officers (PIOs) and Section 4(1)(b) disclosures."
  },
  {
    q: "How can I adjust the font size or switch to high contrast mode?",
    a: "Use the accessibility controls located in the top header section. Click A- to decrease, A to reset, or A+ to increase text size. Click the Contrast button for high-contrast dark mode."
  },
  {
    q: "Who do I contact for website feedback or accessibility support?",
    a: "You can write to our Web Information Manager at md-jkspdcl@jk.gov.in or contact the IT & Systems Cell at our Srinagar/Jammu headquarters."
  }
];
---

<Layout 
  title="Help & FAQ - JKSPDC Portal" 
  description="Help guide and Frequently Asked Questions (FAQ) for navigating the JKSPDC portal, viewing tenders, and contacting offices."
>
  <div class="space-y-0">
    <!-- Premium Page Header Band -->
    <div class="page-header-band animate-fadeInUp">
      <nav class="breadcrumb-trail" aria-label="Breadcrumbs">
        <a href="/">Home</a>
        <span class="separator">/</span>
        <span class="current">Help</span>
      </nav>
      <h1>Help & Support</h1>
      <p class="page-subtitle">Jammu &amp; Kashmir State Power Development Corporation Limited (JKSPDCL)</p>
    </div>

    <!-- Content -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 animate-fadeInUp delay-200">
      <!-- Main Text -->
      <article class="lg:col-span-2 space-y-6">
        <section class="card-static space-y-4">
          <h2 class="text-xl font-bold text-[#0B4F9C] border-b border-gray-100 pb-2">Frequently Asked Questions</h2>
          <div class="space-y-4">
            {faqs.map((faq, index) => (
              <div class="border-b border-gray-100 pb-4 last:border-0 last:pb-0 space-y-1">
                <h3 class="font-bold text-gray-900 text-sm flex items-start gap-2">
                  <span class="text-[#0B4F9C] font-extrabold">Q{index + 1}.</span> {faq.q}
                </h3>
                <p class="text-xs text-gray-600 pl-6 leading-relaxed">
                  {faq.a}
                </p>
              </div>
            ))}
          </div>
        </section>

        <section class="card-static space-y-4">
          <h2 class="text-xl font-bold text-[#0B4F9C] border-b border-gray-100 pb-2">Viewing Official Documents</h2>
          <p class="text-xs text-gray-700 leading-relaxed">
            Most downloadable documents (such as Tenders, Tariff Orders, and Corporate Policies) on this site are in <strong>Portable Document Format (PDF)</strong>. To view these files, you will need a PDF reader such as Adobe Acrobat Reader (free download) or any modern browser with PDF rendering enabled.
          </p>
        </section>
      </article>

      <!-- Sidebar -->
      <aside class="space-y-5 animate-fadeIn delay-300">
        <div class="card-static">
          <h3 class="sidebar-card-title">Support Links</h3>
          <ul class="flex flex-col gap-2 text-xs font-semibold text-[#0B4F9C]">
            <li><a href="/sitemap" class="sidebar-link">Sitemap</a></li>
            <li><a href="/about-us/others/contact" class="sidebar-link">Contact Directory</a></li>
          </ul>
        </div>

        <div class="card-static">
          <h3 class="sidebar-card-title">Mandatory Policies</h3>
          <ul class="flex flex-col gap-2 text-xs font-semibold text-[#0B4F9C]">
            <li><a href="/policies/accessibility" class="sidebar-link">Accessibility Statement</a></li>
            <li><a href="/policies/privacy" class="sidebar-link">Privacy Policy</a></li>
            <li><a href="/policies/terms" class="sidebar-link">Terms of Use</a></li>
            <li><a href="/policies/hyperlinking" class="sidebar-link">Hyperlinking Policy</a></li>
            <li><a href="/policies/copyright" class="sidebar-link">Copyright Policy</a></li>
          </ul>
        </div>
      </aside>
    </div>
  </div>
</Layout>
