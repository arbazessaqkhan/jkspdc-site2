---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';

const faqs = [
  {
    q: "How do I access live tenders and bid documents?",
    a: "Live tenders are listed under Tenders > Live Tenders & Notices. Official e-procurement bidding is hosted on the official J&K government e-tendering portal at jktenders.gov.in."
  },
  {
    q: "Where can I view RTI Proactive Disclosures?",
    a: "Under the RTI menu tab in the top navigation, click on RTI Act (Sec 4) to view designated Public Information Officers (PIOs) and Section 4(1)(b) disclosures."
  },
  {
    q: "How can I adjust the font size or switch to high contrast mode?",
    a: "Use the accessibility controls located in the top header section. Click A- to decrease, A to reset, or A+ to increase text size. Click the Contrast button for high-contrast dark mode."
  },
  {
    q: "Who do I contact for website feedback or accessibility support?",
    a: "You can write to our Web Information Manager at md-jkspdcl@jk.gov.in or contact the IT & Systems Cell at our Srinagar/Jammu headquarters."
  }
];
---

<Layout 
  title="Help & FAQ - JKSPDC Portal" 
  description="Help guide and Frequently Asked Questions (FAQ) for navigating the JKSPDC portal, viewing tenders, and contacting offices."
>
  <div class="space-y-8">
    <!-- Breadcrumbs -->
    <nav class="text-xs text-slate-500" aria-label="Breadcrumbs">
      <ol class="flex items-center gap-2">
        <li><a href="/" class="hover:underline">Home</a></li>
        <li>/</li>
        <li><span class="font-semibold text-[#0B4F9C]">Help &amp; FAQ</span></li>
      </ol>
    </nav>

    <!-- Header -->
    <header class="border-b border-slate-200 pb-5">
      <h1 class="text-3xl font-extrabold text-[#0B4F9C]">Help &amp; Frequently Asked Questions</h1>
      <p class="text-sm text-slate-650 mt-1">Guide to navigating the portal, downloading official documents, and finding information.</p>
    </header>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
      <!-- Main Content Area -->
      <main class="lg:col-span-2 space-y-6 text-sm text-slate-700 leading-relaxed">
        <section class="bg-white border border-slate-200 rounded-xl p-6 shadow-sm space-y-4">
          <h2 class="text-xl font-bold text-slate-900 border-b border-slate-100 pb-2">Frequently Asked Questions</h2>
          <div class="space-y-4">
            {faqs.map((faq, index) => (
              <div class="border-b border-slate-100 pb-4 last:border-0 last:pb-0 space-y-1">
                <h3 class="font-bold text-slate-900 text-sm flex items-start gap-2">
                  <span class="text-[#0B4F9C] font-extrabold">Q{index + 1}.</span> {faq.q}
                </h3>
                <p class="text-xs text-slate-600 pl-6 leading-relaxed">
                  {faq.a}
                </p>
              </div>
            ))}
          </div>
        </section>

        <section class="bg-white border border-slate-200 rounded-xl p-6 shadow-sm space-y-4">
          <h2 class="text-xl font-bold text-slate-900 border-b border-slate-100 pb-2">Viewing Official Documents</h2>
          <p>
            Most downloadable documents (such as Tenders, Tariff Orders, and Corporate Policies) on this site are in <strong>Portable Document Format (PDF)</strong>. To view these files, you will need a PDF reader such as Adobe Acrobat Reader (free download) or any modern browser with PDF rendering enabled.
          </p>
        </section>
      </main>

      <!-- Sidebar -->
      <aside class="space-y-4">
        <div class="bg-white border border-slate-200 p-5 rounded-xl shadow-sm space-y-2">
          <h3 class="font-bold text-slate-900 text-sm border-b border-slate-100 pb-2">Mandatory Policies</h3>
          <ul class="space-y-2 text-xs font-semibold text-[#0B4F9C]">
            <li><a href="/policies/accessibility" class="hover:underline flex items-center gap-1">&rarr; Accessibility Statement</a></li>
            <li><a href="/policies/privacy" class="hover:underline flex items-center gap-1">&rarr; Privacy Policy</a></li>
            <li><a href="/policies/terms" class="hover:underline flex items-center gap-1">&rarr; Terms of Use</a></li>
            <li><a href="/policies/hyperlinking" class="hover:underline flex items-center gap-1">&rarr; Hyperlinking Policy</a></li>
            <li><a href="/policies/copyright" class="hover:underline flex items-center gap-1">&rarr; Copyright Policy</a></li>
          </ul>
        </div>
      </aside>
    </div>
  </div>
</Layout>
