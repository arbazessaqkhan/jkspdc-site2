---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';

const faqs = [
  {
    q: "How do I access live tenders and bid documents?",
    a: "Live tenders are listed under Tenders > Live Tenders & Notices. Official e-procurement bidding is hosted on the official J&K government e-tendering portal at jktenders.gov.in."
  },
  {
    q: "Where can I view RTI Proactive Disclosures?",
    a: "Under the RTI menu tab in the top navigation, click on RTI Act (Sec 4) to view designated Public Information Officers (PIOs) and Section 4(1)(b) disclosures."
  },
  {
    q: "How can I adjust the font size or switch to high contrast mode?",
    a: "Use the accessibility controls located in the top header section. Click A- to decrease, A to reset, or A+ to increase text size. Click the Contrast button for high-contrast dark mode."
  },
  {
    q: "Who do I contact for website feedback or accessibility support?",
    a: "You can write to our Web Information Manager at md-jkspdcl@jk.gov.in or contact the IT & Systems Cell at our Srinagar/Jammu headquarters."
  }
];
---

<Layout
  title="Help & Support - JKSPDC"
  description="Help and FAQ guide for the JKSPDC official website. Learn how to find tenders, notifications, documents, and use the accessibility features."
>
  <div class="space-y-0 max-w-5xl mx-auto">
    <!-- Page Header Band -->
    <div class="page-header-band animate-fadeInUp">
      <nav class="breadcrumb-trail" aria-label="breadcrumb">
        <a href="/">Home</a>
        <span class="separator" aria-hidden="true">/</span>
        <span class="current">Help</span>
      </nav>
      <h1>Help &amp; Support</h1>
      <p class="page-subtitle">Jammu &amp; Kashmir State Power Development Corporation Limited (JKSPDCL)</p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 animate-fadeInUp delay-200">

      <!-- Main Content -->
      <article class="lg:col-span-2 space-y-5">

        <!-- Introduction -->
        <div class="card-static">
          <h2 class="font-bold text-[#0B4F9C] text-base mb-3 border-b border-gray-100 pb-2">About This Website</h2>
          <p>This is the official website of Jammu &amp; Kashmir State Power Development Corporation Limited (JKSPDCL). This guide will help you find information, use features, and navigate the portal effectively.</p>
        </div>

        <!-- FAQ Section -->
        <div class="card-static">
          <h2 class="font-bold text-[#0B4F9C] text-base mb-4 border-b border-gray-100 pb-2">Frequently Asked Questions (FAQ)</h2>
          <div class="space-y-4" id="faq-accordion">

            <details class="border border-gray-200 rounded-lg overflow-hidden">
              <summary class="p-4 font-semibold text-sm text-gray-800 cursor-pointer hover:bg-gray-50 flex justify-between items-center list-none">
                How do I find current tenders and notices?
                <span aria-hidden="true" class="text-[#0B4F9C] font-bold text-lg leading-none">+</span>
              </summary>
              <div class="p-4 pt-2 text-sm text-gray-700 border-t border-gray-100">
                <p>Current tenders and procurement notices are available at:</p>
                <ul class="mt-2 space-y-1">
                  <li>• <a href="/stakeholders/vendors/tender-bids" class="text-[#0B4F9C] hover:underline">Tenders &amp; Bids</a> — Live tender list with search and filters</li>
                  <li>• <a href="https://jktenders.gov.in" target="_blank" rel="noopener noreferrer" class="text-[#0B4F9C] hover:underline">JK Tenders Portal<span class="sr-only"> (opens in new tab)</span></a> — Official J&amp;K Government tender portal</li>
                </ul>
              </div>
            </details>

            <details class="border border-gray-200 rounded-lg overflow-hidden">
              <summary class="p-4 font-semibold text-sm text-gray-800 cursor-pointer hover:bg-gray-50 flex justify-between items-center list-none">
                Where can I find notifications and official orders?
                <span aria-hidden="true" class="text-[#0B4F9C] font-bold text-lg leading-none">+</span>
              </summary>
              <div class="p-4 pt-2 text-sm text-gray-700 border-t border-gray-100">
                <p>Official notifications, circulars, and office orders are published at <a href="/notifications" class="text-[#0B4F9C] hover:underline">Notifications &amp; Circulars</a>. You can filter by project/topic, year, and search by keyword or document title.</p>
              </div>
            </details>

            <details class="border border-gray-200 rounded-lg overflow-hidden">
              <summary class="p-4 font-semibold text-sm text-gray-800 cursor-pointer hover:bg-gray-50 flex justify-between items-center list-none">
                How do I download documents and reports?
                <span aria-hidden="true" class="text-[#0B4F9C] font-bold text-lg leading-none">+</span>
              </summary>
              <div class="p-4 pt-2 text-sm text-gray-700 border-t border-gray-100">
                <p>Documents, annual reports, and policy PDFs are available in the <a href="/media/downloads" class="text-[#0B4F9C] hover:underline">Downloads</a> section. Most documents are in PDF format and require a PDF viewer. If you cannot open a PDF, download <a href="https://get.adobe.com/reader/" target="_blank" rel="noopener noreferrer" class="text-[#0B4F9C] hover:underline">Adobe Acrobat Reader<span class="sr-only"> (opens in new tab)</span></a> (free).</p>
              </div>
            </details>

            <details class="border border-gray-200 rounded-lg overflow-hidden">
              <summary class="p-4 font-semibold text-sm text-gray-800 cursor-pointer hover:bg-gray-50 flex justify-between items-center list-none">
                How do I use the search feature?
                <span aria-hidden="true" class="text-[#0B4F9C] font-bold text-lg leading-none">+</span>
              </summary>
              <div class="p-4 pt-2 text-sm text-gray-700 border-t border-gray-100">
                <p>The search box is available in the header on all pages. Type a keyword and press Enter or click the search button. Search covers projects, tenders, notifications, and general content. For a specific document type, use the dedicated section (e.g., <a href="/stakeholders/vendors/tender-bids" class="text-[#0B4F9C] hover:underline">Tenders</a> or <a href="/notifications" class="text-[#0B4F9C] hover:underline">Notifications</a>) which have their own advanced filters.</p>
              </div>
            </details>

            <details class="border border-gray-200 rounded-lg overflow-hidden">
              <summary class="p-4 font-semibold text-sm text-gray-800 cursor-pointer hover:bg-gray-50 flex justify-between items-center list-none">
                How do I contact JKSPDC?
                <span aria-hidden="true" class="text-[#0B4F9C] font-bold text-lg leading-none">+</span>
              </summary>
              <div class="p-4 pt-2 text-sm text-gray-700 border-t border-gray-100">
                <p>Visit the <a href="/about-us/others/contact" class="text-[#0B4F9C] hover:underline">Contact Us</a> page for the full directory of offices, phone numbers, and email addresses. You can also use the online enquiry form on that page to send a message directly.</p>
              </div>
            </details>

            <details class="border border-gray-200 rounded-lg overflow-hidden">
              <summary class="p-4 font-semibold text-sm text-gray-800 cursor-pointer hover:bg-gray-50 flex justify-between items-center list-none">
                How do I access RTI (Right to Information) information?
                <span aria-hidden="true" class="text-[#0B4F9C] font-bold text-lg leading-none">+</span>
              </summary>
              <div class="p-4 pt-2 text-sm text-gray-700 border-t border-gray-100">
                <p>RTI disclosures under Section 4 of the RTI Act are available at <a href="/about-us/explore/rti" class="text-[#0B4F9C] hover:underline">RTI Disclosures</a>. For filing RTI applications, please contact the Public Information Officer (PIO) whose details are provided on that page.</p>
              </div>
            </details>

            <details class="border border-gray-200 rounded-lg overflow-hidden">
              <summary class="p-4 font-semibold text-sm text-gray-800 cursor-pointer hover:bg-gray-50 flex justify-between items-center list-none">
                How do I report a problem or give feedback?
                <span aria-hidden="true" class="text-[#0B4F9C] font-bold text-lg leading-none">+</span>
              </summary>
              <div class="p-4 pt-2 text-sm text-gray-700 border-t border-gray-100">
                <p>Use the <a href="#website-feedback" class="text-[#0B4F9C] hover:underline font-semibold">Website Feedback Form</a> below to report broken links, content errors, accessibility issues, or to suggest improvements. For general administrative inquiries or public grievances, please use the <a href="/feedback" class="text-[#0B4F9C] hover:underline font-semibold">Citizen Queries &amp; Feedback Portal</a>.</p>
              </div>
            </details>

          </div>
        </div>

        <!-- Accessibility Features Guide -->
        <div class="card-static">
          <h2 class="font-bold text-[#0B4F9C] text-base mb-3 border-b border-gray-100 pb-2">Using Accessibility Features</h2>
          <div class="space-y-3 text-sm">
            <div>
              <h3 class="font-semibold text-gray-800 mb-1">Font Size</h3>
              <p>Use the <strong>A-</strong> / <strong>A</strong> / <strong>A+</strong> buttons in the accessibility bar at the top of every page to decrease, reset, or increase text size.</p>
            </div>
            <div>
              <h3 class="font-semibold text-gray-800 mb-1">High Contrast Mode</h3>
              <p>Click the <strong>High Contrast</strong> toggle in the accessibility bar to switch to a high contrast display suitable for users with low vision.</p>
            </div>
            <div>
              <h3 class="font-semibold text-gray-800 mb-1">Language</h3>
              <p>Select your preferred language from the language dropdown at the top right. Available languages: English, हिन्दी (Hindi), اردو (Urdu), कॉशुर (Kashmiri), डोगरी (Dogri).</p>
            </div>
            <div>
              <h3 class="font-semibold text-gray-800 mb-1">Keyboard Navigation</h3>
              <p>This website supports full keyboard navigation. Use <kbd class="bg-gray-100 border border-gray-300 rounded px-1.5 py-0.5 text-xs font-mono">Tab</kbd> to navigate, <kbd class="bg-gray-100 border border-gray-300 rounded px-1.5 py-0.5 text-xs font-mono">Enter</kbd> to activate links and buttons, <kbd class="bg-gray-100 border border-gray-300 rounded px-1.5 py-0.5 text-xs font-mono">Escape</kbd> to close menus, and <kbd class="bg-gray-100 border border-gray-300 rounded px-1.5 py-0.5 text-xs font-mono">Skip to Main Content</kbd> (first link) to bypass navigation.</p>
            </div>
            <div>
              <h3 class="font-semibold text-gray-800 mb-1">Screen Readers</h3>
              <p>This website is designed to work with screen readers including NVDA, JAWS, and VoiceOver. All images have descriptive alt text; all form fields have labels; all navigation menus are keyboard-accessible.</p>
            </div>
          </div>
        </div>

        <!-- Browser Compatibility -->
        <div class="card-static">
          <h2 class="font-bold text-[#0B4F9C] text-base mb-3 border-b border-gray-100 pb-2">Browser Compatibility</h2>
          <p class="text-sm">This website is designed to work with modern web browsers. Recommended browsers:</p>
          <ul class="mt-2 space-y-1 text-sm">
            <li>✅ Google Chrome (latest version)</li>
            <li>✅ Mozilla Firefox (latest version)</li>
            <li>✅ Microsoft Edge (latest version)</li>
            <li>✅ Safari (latest version on macOS / iOS)</li>
          </ul>
          <p class="mt-2 text-sm text-gray-600">Enable JavaScript for full functionality including language translation and search autocomplete.</p>
        </div>

        <!-- Website Feedback Form at the end of Help & Support content -->
        <div class="card-static scroll-mt-6" id="website-feedback">
          <div class="flex items-center gap-3 border-b border-gray-100 pb-3 mb-4">
            <div class="w-10 h-10 rounded-lg bg-[#EAF4FF] text-[#0B4F9C] flex items-center justify-center font-bold shrink-0">
              <Icon name="mail" size={22} />
            </div>
            <div>
              <h2 class="font-bold text-[#0B4F9C] text-base">Website Feedback &amp; Issue Report</h2>
              <p class="text-xs text-gray-600 mt-0.5">Share your experience, report website errors, or suggest portal improvements.</p>
            </div>
          </div>

          <!-- Acknowledgement Box (shown after submit) -->
          <div id="website-feedback-ack" class="hidden mb-4 bg-emerald-50 border border-emerald-300 rounded-lg p-4" role="alert">
            <div class="flex items-start gap-2.5">
              <span class="text-emerald-600 text-xl">✅</span>
              <div>
                <h3 class="font-bold text-emerald-800 text-sm">Feedback Received!</h3>
                <p class="text-emerald-700 text-xs mt-0.5">Thank you for helping us improve the website.</p>
                <p class="text-emerald-700 text-xs mt-1 font-mono"><strong>Ref:</strong> <span id="website-feedback-ref"></span></p>
              </div>
            </div>
          </div>

          <!-- Website Feedback Form -->
          <form id="website-feedback-form" class="space-y-4" novalidate>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <!-- Feedback Type -->
              <div class="form-group">
                <label for="wf-type" class="block text-xs font-bold text-slate-700 mb-1">Feedback Type <span class="text-red-600">*</span></label>
                <select id="wf-type" name="feedbackType" class="w-full px-3 py-2 border border-slate-300 rounded text-xs focus:ring-1 focus:ring-[#0B4F9C] focus:border-[#0B4F9C] outline-none bg-white" required>
                  <option value="">-- Select Type --</option>
                  <option value="website_content">Website Content</option>
                  <option value="accessibility">Accessibility Issue</option>
                  <option value="broken_link">Broken Link / Error</option>
                  <option value="document_issue">Document / Download Issue</option>
                  <option value="search_issue">Search Issue</option>
                  <option value="suggestion">Suggestion / Improvement</option>
                  <option value="appreciation">Appreciation</option>
                  <option value="other">Other</option>
                </select>
              </div>

              <!-- Page URL (optional) -->
              <div class="form-group">
                <label for="wf-page-url" class="block text-xs font-bold text-slate-700 mb-1">Page URL <span class="text-gray-400 font-normal">(Optional)</span></label>
                <input type="text" id="wf-page-url" name="pageUrl" placeholder="e.g. /tenders" class="w-full px-3 py-2 border border-slate-300 rounded text-xs focus:ring-1 focus:ring-[#0B4F9C] focus:border-[#0B4F9C] outline-none" />
              </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <!-- Full Name -->
              <div class="form-group">
                <label for="wf-name" class="block text-xs font-bold text-slate-700 mb-1">Full Name <span class="text-red-600">*</span></label>
                <input type="text" id="wf-name" name="name" required placeholder="Your name" class="w-full px-3 py-2 border border-slate-300 rounded text-xs focus:ring-1 focus:ring-[#0B4F9C] focus:border-[#0B4F9C] outline-none" />
              </div>

              <!-- Email -->
              <div class="form-group">
                <label for="wf-email" class="block text-xs font-bold text-slate-700 mb-1">Email Address <span class="text-gray-400 font-normal">(Optional)</span></label>
                <input type="email" id="wf-email" name="email" placeholder="your@email.com" class="w-full px-3 py-2 border border-slate-300 rounded text-xs focus:ring-1 focus:ring-[#0B4F9C] focus:border-[#0B4F9C] outline-none" />
              </div>
            </div>

            <!-- Rating -->
            <div class="form-group">
              <label class="block text-xs font-bold text-slate-700 mb-1">Website Experience Rating</label>
              <div class="flex gap-2 items-center" role="radiogroup" aria-label="Satisfaction rating">
                {[1, 2, 3, 4, 5].map(n => (
                  <label class="cursor-pointer">
                    <input type="radio" name="wf-rating" value={n} class="sr-only wf-rating-input" />
                    <span class="wf-rating-span w-8 h-8 rounded border border-slate-300 flex items-center justify-center text-xs font-bold text-slate-700 hover:border-[#0B4F9C] hover:bg-blue-50 transition-colors">{n}</span>
                  </label>
                ))}
                <span class="text-[11px] text-slate-400 ml-2">(1 = Poor, 5 = Excellent)</span>
              </div>
            </div>

            <!-- Message -->
            <div class="form-group">
              <label for="wf-message" class="block text-xs font-bold text-slate-700 mb-1">Feedback Details <span class="text-red-600">*</span></label>
              <textarea id="wf-message" name="message" required minlength="10" rows="3" placeholder="Describe the issue or suggestion..." class="w-full px-3 py-2 border border-slate-300 rounded text-xs focus:ring-1 focus:ring-[#0B4F9C] focus:border-[#0B4F9C] outline-none resize-y"></textarea>
            </div>

            <div class="flex justify-between items-center pt-1">
              <div id="wf-error" class="hidden text-xs font-semibold text-red-600"></div>
              <button type="submit" id="wf-submit-btn" class="btn-primary text-xs py-2 px-5 cursor-pointer ml-auto">
                Submit Website Feedback
              </button>
            </div>
          </form>
        </div>

      </article>

      <!-- Sidebar -->
      <aside class="space-y-5 animate-fadeIn delay-300">
        <div class="card-static">
          <h3 class="sidebar-card-title">Quick Links</h3>
          <ul class="flex flex-col gap-2 text-xs font-semibold text-[#0B4F9C]">
            <li><a href="#website-feedback" class="sidebar-link">Website Feedback Form</a></li>
            <li><a href="/sitemap" class="sidebar-link">Sitemap</a></li>
            <li><a href="/about-us/others/contact" class="sidebar-link">Contact Directory</a></li>
            <li><a href="/feedback" class="sidebar-link">General Citizen Queries</a></li>
            <li><a href="/accessibility-statement" class="sidebar-link">Accessibility Statement</a></li>
            <li><a href="/about-us/explore/rti" class="sidebar-link">RTI Disclosures</a></li>
          </ul>
        </div>
        <div class="card-static">
          <h3 class="sidebar-card-title">Need More Help?</h3>
          <p class="text-xs text-gray-600 mb-2">If you cannot find what you need, please contact us directly.</p>
          <a href="/about-us/others/contact" class="btn-primary text-xs w-full text-center">Contact Us</a>
        </div>
      </aside>
    </div>
  </div>
</Layout>

<script>
  // Handle website feedback submission inside Help & Support page
  const wfForm = document.getElementById('website-feedback-form') as HTMLFormElement | null;
  const wfSubmitBtn = document.getElementById('wf-submit-btn') as HTMLButtonElement | null;
  const wfAck = document.getElementById('website-feedback-ack') as HTMLDivElement | null;
  const wfRef = document.getElementById('website-feedback-ref') as HTMLSpanElement | null;
  const wfError = document.getElementById('wf-error') as HTMLDivElement | null;

  if (wfForm && wfSubmitBtn) {
    // Rating selector visual interaction
    const ratingInputs = wfForm.querySelectorAll('.wf-rating-input');
    ratingInputs.forEach(input => {
      input.addEventListener('change', () => {
        wfForm.querySelectorAll('.wf-rating-span').forEach(span => {
          span.classList.remove('bg-[#0B4F9C]', 'text-white', 'border-[#0B4F9C]');
        });
        const parentSpan = (input as HTMLElement).nextElementSibling;
        if (parentSpan) {
          parentSpan.classList.add('bg-[#0B4F9C]', 'text-white', 'border-[#0B4F9C]');
        }
      });
    });

    wfForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (wfError) wfError.classList.add('hidden');

      const typeEl = document.getElementById('wf-type') as HTMLSelectElement;
      const nameEl = document.getElementById('wf-name') as HTMLInputElement;
      const emailEl = document.getElementById('wf-email') as HTMLInputElement;
      const pageUrlEl = document.getElementById('wf-page-url') as HTMLInputElement;
      const msgEl = document.getElementById('wf-message') as HTMLTextAreaElement;
      const ratingEl = wfForm.querySelector('input[name="wf-rating"]:checked') as HTMLInputElement | null;

      if (!typeEl.value || !nameEl.value.trim() || !msgEl.value.trim() || msgEl.value.trim().length < 10) {
        if (wfError) {
          wfError.textContent = 'Please fill out all required fields (minimum 10 characters for details).';
          wfError.classList.remove('hidden');
        }
        return;
      }

      wfSubmitBtn.disabled = true;
      wfSubmitBtn.textContent = 'Submitting...';

      const emailVal = emailEl.value.trim();
      const payload = {
        name: nameEl.value.trim(),
        email: emailVal ? emailVal : 'Not provided',
        message: `[WEBSITE FEEDBACK]\n[TYPE: ${typeEl.value}]\n[PAGE: ${pageUrlEl.value.trim() || 'General'}]\n[RATING: ${ratingEl ? ratingEl.value : 'Not rated'}]\n\n${msgEl.value.trim()}`
      };

      try {
        const res = await fetch('/api/contact', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });

        if (!res.ok) {
          const errData = await res.json().catch(() => ({}));
          throw new Error(errData.message || 'Failed to submit feedback to server.');
        }

        const data = await res.json().catch(() => ({}));
        const refNo = data.referenceId 
          ? `JKSPDC-WEB-${data.referenceId.slice(0, 8).toUpperCase()}`
          : `JKSPDC-WEB-${new Date().toISOString().slice(0, 10).replace(/-/g, '')}-${Math.floor(Math.random() * 90000) + 10000}`;

        if (wfRef) wfRef.textContent = refNo;
        wfForm.reset();
        wfForm.querySelectorAll('.wf-rating-span').forEach(span => {
          span.classList.remove('bg-[#0B4F9C]', 'text-white', 'border-[#0B4F9C]');
        });
        if (wfAck) {
          wfAck.classList.remove('hidden');
          wfAck.scrollIntoView({ behavior: 'smooth' });
        }
      } catch (err: any) {
        console.error('Website feedback submission error:', err);
        if (wfError) {
          wfError.textContent = err.message || 'Failed to submit feedback. Please check your connection and try again.';
          wfError.classList.remove('hidden');
          wfError.scrollIntoView({ behavior: 'smooth' });
        }
      } finally {
        wfSubmitBtn.disabled = false;
        wfSubmitBtn.textContent = 'Submit Website Feedback';
      }
    });
  }
</script>
