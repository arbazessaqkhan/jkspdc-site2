      <!-- Quick Portals & Help -->
      <section class="card-static space-y-3">
        <h3 class="font-extrabold text-sm text-[#0B4F9C] border-b border-gray-100 pb-2">Quick Portals & Utilities</h3>
        <ul class="space-y-1.5 text-xs text-gray-700">
          <li><a href="/about-us/explore/policies" class="hover:underline">&rarr; Corporate Policies Directory</a></li>
          <li><a href="/about-us/explore/rti" class="hover:underline">&rarr; RTI Disclosures</a></li>
          <li><a href="/help" class="hover:underline">&rarr; Website Help & FAQs</a></li>
          <li><a href="/admin/login" class="hover:underline">&rarr; Admin Portal Login</a></li>
        </ul>
      </section>

    </div>
