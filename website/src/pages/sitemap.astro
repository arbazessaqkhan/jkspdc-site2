---
import Layout from '../layouts/Layout.astro';
---

<Layout 
  title="Sitemap - JKSPDC" 
  description="Comprehensive sitemap and index of all pages on the JKSPDC website."
>
  <div class="space-y-0 max-w-5xl mx-auto">
    <!-- Premium Page Header Band -->
    <div class="page-header-band animate-fadeInUp">
      <nav class="breadcrumb-trail" aria-label="breadcrumb">
        <a href="/">Home</a>
        <span class="separator" aria-hidden="true">/</span>
        <span class="current">Sitemap</span>
      </nav>
      <h1>Website Sitemap</h1>
      <p class="page-subtitle">Jammu &amp; Kashmir State Power Development Corporation Limited (JKSPDCL)</p>
    </div>

    <!-- Content -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      
      <!-- About Us -->
      <section class="card-static space-y-3">
        <h3 class="font-extrabold text-sm text-[#0B4F9C] border-b border-gray-100 pb-2">About Us</h3>
        <ul class="space-y-1.5 text-xs text-gray-700">
          <li><a href="/about-us/explore/overview" class="hover:underline">&rarr; About Us / Corporate Overview</a></li>
          <li><a href="/about-us/explore/association-memorandum" class="hover:underline">&rarr; MoA &amp; AoA</a></li>
          <li><a href="/about-us/explore/organization-chart" class="hover:underline">&rarr; Organizational Structure</a></li>
          <li><a href="/about-us/management/board" class="hover:underline">&rarr; Board of Directors</a></li>
          <li><a href="/about-us/explore/gstin-registration" class="hover:underline">&rarr; GSTIN Registration Details</a></li>
          <li><a href="/about-us/explore/policies" class="hover:underline">&rarr; Policies</a></li>
          <li><a href="/about-us/others/contact" class="hover:underline">&rarr; Contact Us</a></li>
          <li><a href="/about-us/others/contact#help-support" class="hover:underline">&rarr; Help &amp; Support</a></li>
        </ul>
      </section>

      <!-- Projects -->
      <section class="card-static space-y-3">
        <h3 class="font-extrabold text-sm text-[#0B4F9C] border-b border-gray-100 pb-2">Projects</h3>
        <ul class="space-y-1.5 text-xs text-gray-700">
          <li><a href="/our-business/power-stations" class="hover:underline">&rarr; Operational Projects</a></li>
          <li><a href="/our-business/construction" class="hover:underline">&rarr; Projects Under Construction</a></li>
          <li><a href="/our-business/under-development" class="hover:underline">&rarr; Upcoming Projects</a></li>
          <li><a href="/power-trading" class="hover:underline">&rarr; Power Trading Cell</a></li>
        </ul>
      </section>

      <!-- Tenders & Notifications -->
      <section class="card-static space-y-3">
        <h3 class="font-extrabold text-sm text-[#0B4F9C] border-b border-gray-100 pb-2">Tenders &amp; Notifications</h3>
        <ul class="space-y-1.5 text-xs text-gray-700">
          <li><a href="/stakeholders/vendors/tender-bids" class="hover:underline">&rarr; Live Tenders &amp; Notices</a></li>
          <li><a href="/notifications" class="hover:underline">&rarr; Notifications &amp; Circulars</a></li>
        </ul>
      </section>

      <!-- Investors Corner -->
      <section class="card-static space-y-3">
        <h3 class="font-extrabold text-sm text-[#0B4F9C] border-b border-gray-100 pb-2">Investors Corner</h3>
        <ul class="space-y-1.5 text-xs text-gray-700">
          <li><a href="/stakeholders/investors/agm" class="hover:underline">&rarr; Annual General Meetings</a></li>
          <li><a href="/stakeholders/investors/ipp-projects" class="hover:underline">&rarr; IPP Projects</a></li>
        </ul>
      </section>

      <!-- RTI & Governance -->
      <section class="card-static space-y-3">
        <h3 class="font-extrabold text-sm text-[#0B4F9C] border-b border-gray-100 pb-2">RTI &amp; Governance</h3>
        <ul class="space-y-1.5 text-xs text-gray-700">
          <li><a href="/about-us/explore/rti" class="hover:underline">&rarr; RTI Act (Sec 4)</a></li>
          <li><a href="/sustainability/csr/policy" class="hover:underline">&rarr; CSR Policy</a></li>
        </ul>
      </section>

      <!-- Media -->
      <section class="card-static space-y-3">
        <h3 class="font-extrabold text-sm text-[#0B4F9C] border-b border-gray-100 pb-2">Media</h3>
        <ul class="space-y-1.5 text-xs text-gray-700">
          <li><a href="/media/gallery" class="hover:underline">&rarr; Photo &amp; Video Gallery</a></li>
          <li><a href="/media/downloads" class="hover:underline">&rarr; Downloads</a></li>
        </ul>
      </section>

      <!-- Quick Portals & Utilities -->
      <section class="card-static space-y-3">
        <h3 class="font-extrabold text-sm text-[#0B4F9C] border-b border-gray-100 pb-2">Quick Portals &amp; Utilities</h3>
        <ul class="space-y-1.5 text-xs text-gray-700">
          <li><a href="/help" class="hover:underline">&rarr; Website Help &amp; FAQs</a></li>
          <li><a href="/feedback" class="hover:underline">&rarr; Feedback</a></li>
          <li><a href="/search" class="hover:underline">&rarr; Site Search</a></li>
        </ul>
      </section>

      <!-- Website Policies (GIGW 3.0 Mandatory) -->
      <section class="card-static space-y-3">
        <h3 class="font-extrabold text-sm text-[#0B4F9C] border-b border-gray-100 pb-2">Website Policies</h3>
        <ul class="space-y-1.5 text-xs text-gray-700">
          <li><a href="/terms-conditions" class="hover:underline">&rarr; Terms &amp; Conditions</a></li>
          <li><a href="/privacy-policy" class="hover:underline">&rarr; Privacy Policy</a></li>
          <li><a href="/disclaimer" class="hover:underline">&rarr; Disclaimer</a></li>
          <li><a href="/copyright" class="hover:underline">&rarr; Copyright Policy</a></li>
          <li><a href="/hyperlinking-policy" class="hover:underline">&rarr; Hyperlinking Policy</a></li>
        </ul>
      </section>

    </div>
  </div>
</Layout>
