---
import Layout from '../layouts/Layout.astro';
---

<Layout 
  title="Sitemap - JKSPDC" 
  description="Comprehensive sitemap and index of all pages on the JKSPDC website."
>
  <div class="space-y-0">
    <!-- Premium Page Header Band -->
    <div class="page-header-band animate-fadeInUp">
      <nav class="breadcrumb-trail" aria-label="Breadcrumbs">
        <a href="/">Home</a>
        <span class="separator">/</span>
        <span class="current">Sitemap</span>
      </nav>
      <h1>Website Sitemap</h1>
      <p class="page-subtitle">Jammu &amp; Kashmir State Power Development Corporation Limited (JKSPDCL)</p>
    </div>

    <!-- Content -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      
      <!-- About Us -->
      <section class="card-static space-y-3">
        <h3 class="font-extrabold text-sm text-[#0B4F9C] border-b border-gray-100 pb-2">About Us</h3>
        <ul class="space-y-1.5 text-xs text-gray-700">
          <li><a href="/about-us/explore/overview" class="hover:underline">&rarr; Corporate Overview</a></li>
          <li><a href="/about-us/explore/vision" class="hover:underline">&rarr; Vision Statement</a></li>
          <li><a href="/about-us/explore/mission" class="hover:underline">&rarr; Mission Statement</a></li>
          <li><a href="/about-us/explore/profile" class="hover:underline">&rarr; Corporate Profile</a></li>
          <li><a href="/about-us/explore/objectives" class="hover:underline">&rarr; Main Objectives</a></li>
          <li><a href="/about-us/explore/organization-chart" class="hover:underline">&rarr; Organization Chart</a></li>
          <li><a href="/about-us/explore/roles-responsibility" class="hover:underline">&rarr; Roles & Responsibilities</a></li>
          <li><a href="/about-us/explore/executives-directory" class="hover:underline">&rarr; Senior Executives Directory</a></li>
          <li><a href="/about-us/explore/association-memorandum" class="hover:underline">&rarr; Memorandums of Association</a></li>
          <li><a href="/about-us/management/board" class="hover:underline">&rarr; Board of Directors</a></li>
          <li><a href="/about-us/management/committees" class="hover:underline">&rarr; Committees of Directors</a></li>
          <li><a href="/about-us/others/awards" class="hover:underline">&rarr; Honours & Awards</a></li>
          <li><a href="/about-us/others/contact" class="hover:underline">&rarr; Contact Us</a></li>
        </ul>
      </section>

      <!-- Our Business -->
      <section class="card-static space-y-3">
        <h3 class="font-extrabold text-sm text-[#0B4F9C] border-b border-gray-100 pb-2">Our Business</h3>
        <ul class="space-y-1.5 text-xs text-gray-700">
          <li><a href="/our-business/power-stations" class="hover:underline">&rarr; Operating Power Stations</a></li>
          <li><a href="/our-business/construction" class="hover:underline">&rarr; Projects Under Construction</a></li>
          <li><a href="/our-business/under-development" class="hover:underline">&rarr; Projects Under Development</a></li>
          <li><a href="/our-business/jv-subsidiary-projects" class="hover:underline">&rarr; Joint Venture Projects</a></li>
          <li><a href="/our-business/turnkey" class="hover:underline">&rarr; Deposit / Turnkey Projects</a></li>
          <li><a href="/our-business/consultancy" class="hover:underline">&rarr; Consultancy Services</a></li>
          <li><a href="/our-business/jv-companies" class="hover:underline">&rarr; Joint Venture Companies</a></li>
        </ul>
      </section>

      <!-- Stakeholders & Media -->
      <section class="card-static space-y-3">
        <h3 class="font-extrabold text-sm text-[#0B4F9C] border-b border-gray-100 pb-2">Stakeholders & Media</h3>
        <ul class="space-y-1.5 text-xs text-gray-700 font-semibold text-[#0B4F9C]">
          <li><a href="/stakeholders/investors/chairman-statement" class="hover:underline">&rarr; Chairman's Statement</a></li>
          <li><a href="/stakeholders/investors/financial-results" class="hover:underline">&rarr; Financial Results</a></li>
          <li><a href="/notifications" class="hover:underline">&rarr; Notifications &amp; Circulars</a></li>
          <li><a href="/stakeholders/investors/annual-reports" class="hover:underline">&rarr; Annual Reports</a></li>
          <li><a href="/stakeholders/investors/mou-mop" class="hover:underline">&rarr; MoUs with MoP</a></li>
