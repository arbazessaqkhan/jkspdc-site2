          <li><a href="/stakeholders/vendors/online-payment" class="hover:underline">&rarr; Online Payment Gateway</a></li>
          <li><a href="/stakeholders/vendors/clpm-portal" class="hover:underline">&rarr; CLPM Portal</a></li>
          <li><a href="/media/press-releases" class="hover:underline">&rarr; Press Releases</a></li>
          <li><a href="/media/gallery" class="hover:underline">&rarr; Photo & Video Gallery</a></li>
          <li><a href="/media/downloads" class="hover:underline">&rarr; Publications Downloads</a></li>
        </ul>
      </section>

      <!-- Power Trading Cell -->
      <section class="card-static space-y-3">
        <h3 class="font-extrabold text-sm text-[#0B4F9C] border-b border-gray-100 pb-2">Power Trading Cell</h3>
        <ul class="space-y-1.5 text-xs text-gray-700">
          <li><a href="/power-trading" class="hover:underline">&rarr; Power Trading Cell Disclosures &amp; Tenders</a></li>
        </ul>
      </section>

      <!-- Sustainability & Governance -->
      <section class="card-static space-y-3">
        <h3 class="font-extrabold text-sm text-[#0B4F9C] border-b border-gray-100 pb-2">Sustainability & Governance</h3>
        <ul class="space-y-1.5 text-xs text-gray-700">
          <li><a href="/sustainability/environment/preamble" class="hover:underline">&rarr; Environmental Preamble</a></li>
          <li><a href="/sustainability/environment/key-areas" class="hover:underline">&rarr; Key Focus Areas</a></li>
          <li><a href="/sustainability/environment/six-monthly-reports" class="hover:underline">&rarr; Compliance Reports</a></li>
          <li><a href="/sustainability/environment/rr-initiatives" class="hover:underline">&rarr; R&R Initiatives</a></li>
          <li><a href="/sustainability/environment/events" class="hover:underline">&rarr; Environmental Events</a></li>
          <li><a href="/sustainability/environment/clearance" class="hover:underline">&rarr; Environmental Clearances</a></li>
          <li><a href="/sustainability/environment/policy" class="hover:underline">&rarr; Environment Policy</a></li>
          <li><a href="/sustainability/csr/overview" class="hover:underline">&rarr; CSR Overview</a></li>
          <li><a href="/sustainability/csr/policy" class="hover:underline">&rarr; CSR Policy</a></li>
          <li><a href="/sustainability/csr/plans" class="hover:underline">&rarr; CSR Plans</a></li>
          <li><a href="/sustainability/csr/reports" class="hover:underline">&rarr; CSR Reports</a></li>
