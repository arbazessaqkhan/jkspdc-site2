---
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
---

<Layout 
  title="Terms of Use - JKSPDC Portal" 
  description="Terms of use, conditions, legal disclaimers, and jurisdiction details for accessing JKSPDC portal."
>
  <div class="space-y-0 max-w-5xl mx-auto">
    <!-- Premium Page Header Band -->
    <div class="page-header-band animate-fadeInUp">
      <nav class="breadcrumb-trail" aria-label="Breadcrumbs">
        <a href="/">Home</a>
        <span class="separator">/</span>
        <span>Policies</span>
        <span class="separator">/</span>
        <span class="current">Terms of Use</span>
      </nav>
      <h1>Terms of Use &amp; Disclaimers</h1>
      <p class="page-subtitle">Jammu &amp; Kashmir State Power Development Corporation Limited (JKSPDCL)</p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
      <!-- Main Content Area -->
      <main class="lg:col-span-2 space-y-6 text-sm text-slate-700 leading-relaxed">
        <section class="bg-white border border-slate-200 rounded-xl p-6 shadow-sm space-y-4">
          <h2 class="text-xl font-bold text-slate-900 border-b border-slate-100 pb-2">Website Disclaimer</h2>
          <p>
            This website is designed, developed, and maintained by Jammu &amp; Kashmir State Power Development Corporation Limited (JKSPDCL). Though all efforts have been made to ensure the accuracy and currency of the content on this website, the same should not be construed as a statement of law or used for any legal purposes.
          </p>
        </section>

        <section class="bg-white border border-slate-200 rounded-xl p-6 shadow-sm space-y-4">
          <h2 class="text-xl font-bold text-slate-900 border-b border-slate-100 pb-2">Tenders &amp; Official Notifications</h2>
          <p>
            In case of any ambiguity, difference, or discrepancy between information published on this website and official printed notices or the e-procurement portal (<a href="https://jktenders.gov.in" target="_blank" rel="noopener" class="text-[#0B4F9C] font-semibold underline">jktenders.gov.in</a>), the e-procurement portal and physical tenders issued by JKSPDCL authority shall prevail.
          </p>
        </section>

        <section class="bg-white border border-slate-200 rounded-xl p-6 shadow-sm space-y-4">
          <h2 class="text-xl font-bold text-slate-900 border-b border-slate-100 pb-2">Limitation of Liability</h2>
          <p>
            Under no circumstances will JKSPDCL be liable for any expense, loss, or damage, including, without limitation, indirect or consequential loss or damage, or any expense, loss or damage whatsoever arising from use, or loss of use, of data, arising out of or in connection with the use of this website.
          </p>
        </section>

        <section class="bg-white border border-slate-200 rounded-xl p-6 shadow-sm space-y-4">
          <h2 class="text-xl font-bold text-slate-900 border-b border-slate-100 pb-2">Applicable Law &amp; Jurisdiction</h2>
          <p>
            These terms and conditions shall be governed by and construed in accordance with the laws of India. Any dispute arising under these terms and conditions shall be subject to the exclusive jurisdiction of the Courts of Jammu &amp; Kashmir.
          </p>
        </section>
      </main>

      <!-- Sidebar -->
      <aside class="space-y-4">
        <div class="bg-white border border-slate-200 p-5 rounded-xl shadow-sm space-y-2">
          <h3 class="font-bold text-slate-900 text-sm border-b border-slate-100 pb-2">Policy Navigation</h3>
          <ul class="space-y-2 text-xs font-semibold text-[#0B4F9C]">
            <li><a href="/policies/accessibility" class="hover:underline flex items-center gap-1">&rarr; Accessibility Statement</a></li>
            <li><a href="/policies/privacy" class="hover:underline flex items-center gap-1">&rarr; Privacy Policy</a></li>
            <li><a href="/policies/hyperlinking" class="hover:underline flex items-center gap-1">&rarr; Hyperlinking Policy</a></li>
            <li><a href="/policies/copyright" class="hover:underline flex items-center gap-1">&rarr; Copyright Policy</a></li>
          </ul>
        </div>
      </aside>
    </div>
  </div>
</Layout>
