---
import AdminLayout from '../../layouts/AdminLayout.astro';
import Icon from '../../components/Icon.astro';
import { isAdmin } from '../../utils/roles';
import { parseApiError, BACKEND_URL } from '../../utils/api-error';

// Check authentication
const sessionToken = Astro.cookies.get('admin_session')?.value;
if (!sessionToken) {
  return Astro.redirect('/admin/login');
}

// Role protection: Audit logs are ADMIN-only
const userRole = Astro.locals.user?.role;
if (!isAdmin(userRole)) {
  return Astro.redirect('/admin/dashboard');
}

let errorMessage = '';

// Fetch Audit Logs List
let logs = [];
try {
  const res = await fetch(`${BACKEND_URL}/api/audit-logs`, {
    headers: {
      'Authorization': `Bearer ${sessionToken}`,
    },
  });
  if (res.ok) {
    logs = await res.json();
  } else {
    const apiErr = await parseApiError(res, 'load audit logs');
    if (apiErr.isUnauthorized) {
      return Astro.redirect('/admin/login');
    }
    errorMessage = apiErr.message;
  }
} catch (e) {
  console.error('Error fetching audit logs:', e);
  errorMessage = 'Failed to load audit logs. Unable to communicate with the server.';
}
---

<AdminLayout title="Audit Logs Feed" description="JKSPDCL Security Auditing Console" activeTab="audit-logs">
  <div class="flex flex-col gap-6">
    
    <!-- Page Header -->
    <div class="admin-page-header">
      <div>
        <h1 class="admin-page-title">Security Audit Logs</h1>
        <p class="admin-page-subtitle">Review chronological registry of admin CRUD operations and security events under GIGW 3.0 guidelines.</p>
      </div>
    </div>

    <!-- Alerts -->
    {errorMessage && (
      <div class="p-3 bg-red-50 border border-red-200 text-xs font-semibold text-red-700 rounded flex items-center gap-2" role="alert">
        <Icon name="info" size={14} class="text-red-600 shrink-0" /> {errorMessage}
      </div>
    )}

    <!-- Logs Table -->
    <div class="admin-table-container">
      <table class="admin-table">
        <thead>
          <tr>
            <th scope="col" class="w-12 text-center">#</th>
            <th scope="col" class="w-40 whitespace-nowrap">Timestamp</th>
            <th scope="col" class="min-w-[160px]">Administrator ID</th>
            <th scope="col" class="w-32">Action</th>
            <th scope="col" class="w-32">IP Address</th>
            <th scope="col" class="min-w-[180px] max-w-xs">User Agent</th>
            <th scope="col" class="min-w-[200px] max-w-sm">Details</th>
          </tr>
        </thead>
        <tbody class="text-xs">
          {logs.length === 0 ? (
            <tr>
              <td colspan="7" class="text-center text-slate-500 py-12 text-xs font-semibold italic">
                <Icon name="folder" size={32} class="mx-auto text-slate-300 mb-2" />
                No activity logs found.
              </td>
            </tr>
          ) : (
            logs.map((log: any, idx: number) => (
              <tr key={log.id} class="transition-colors">
                <td class="font-mono text-[11px] text-slate-400 text-center">{idx + 1}</td>
                <td class="whitespace-nowrap font-mono text-[11px] text-slate-500">
                  {new Date(log.timestamp).toLocaleString('en-IN', {
                    day: '2-digit', month: 'short', year: 'numeric',
                    hour: '2-digit', minute: '2-digit', second: '2-digit'
                  })}
                </td>
                <td class="font-bold text-slate-800">{log.action}</td>
                <td class="text-slate-600 font-medium">{log.module}</td>
                <td class="font-mono text-[11px] text-slate-600">{log.ipAddress}</td>
                <td class="text-slate-500 text-xs max-w-xs truncate" title={log.userAgent}>
                  {log.userAgent}
                </td>
                <td class="font-mono text-[11px] text-slate-600 max-w-sm truncate" title={JSON.stringify(log.details)}>
                  {log.details ? JSON.stringify(log.details) : '—'}
                </td>
              </tr>
            ))
          )}
        </tbody>
      </table>
    </div>
  </div>
</AdminLayout>
