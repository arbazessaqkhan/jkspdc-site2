---
import AdminLayout from '../../layouts/AdminLayout.astro';
import Icon from '../../components/Icon.astro';
import { isAdmin } from '../../utils/roles';
import { BACKEND_URL } from '../../utils/api-error';
import { readPageParams, fetchPaged, pageUrl } from '../../utils/pagination';
import PageNav from '../../components/PageNav.astro';

// Check authentication
const sessionToken = Astro.cookies.get('admin_session')?.value;
if (!sessionToken) {
  return Astro.redirect('/admin/login');
}

// Role protection: Audit logs are ADMIN-only
const userRole = Astro.locals.user?.role;
if (!isAdmin(userRole)) {
  return Astro.redirect('/admin/dashboard');
}

let errorMessage = '';

// Fetch Audit Logs List
const { page, pageSize } = readPageParams(Astro.url);
const pagedExtra: Record<string, string | undefined> = {};
let logs: any[] = [];
let pagedTotal = 0;
let pagedLastPage = 1;
try {
  const state = await fetchPaged('/api/audit-logs', { BACKEND_URL, token: sessionToken, page, pageSize, extra: pagedExtra });
  logs = state.rows;
  pagedTotal = state.total;
  pagedLastPage = state.lastPage;
  if (state.error) errorMessage = errorMessage || state.error;
} catch (e) {
  console.error('Error fetching list:', e);
  errorMessage = 'Network failure: Unable to reach backend server.';
}
const pagedState = { rows: logs, total: pagedTotal, page, pageSize, lastPage: pagedLastPage, error: null };

function formatActionLabel(action: string): string {
  const map: Record<string, string> = {
    AUTH_LOGIN_SUCCESS: 'Login Success',
    AUTH_LOGIN_FAILED: 'Login Failed',
    AUTH_LOGIN_PWD_VERIFIED: 'Password Verified',
    MFA_VERIFY_SUCCESS: 'MFA Verified',
    MFA_VERIFY_FAILED: 'MFA Failed',
    MFA_SETUP_COMPLETED: 'MFA Enabled',
    MFA_ENROLL_AUTHORIZED: 'MFA Enrollment Authorized',
    USER_CREATE: 'User Created',
    USER_UPDATE: 'User Updated',
    USER_DELETE: 'User Deleted',
  };
  if (map[action]) return map[action];
  return (action || 'EVENT')
    .replace(/_/g, ' ')
    .toLowerCase()
    .replace(/\b\w/g, (c) => c.toUpperCase());
}

function actionBadgeClass(action: string): string {
  const a = (action || '').toUpperCase();
  if (a.includes('FAILED') || a.includes('DELETE') || a.includes('REVOKED') || a.includes('LOCKED')) {
    return 'bg-red-50 text-red-700 border-red-200';
  }
  if (a.includes('SUCCESS') || a.includes('COMPLETED') || a.includes('CREATE')) {
    return 'bg-emerald-50 text-emerald-700 border-emerald-200';
  }
  if (a.includes('MFA') || a.includes('AUTH')) {
    return 'bg-sky-50 text-sky-800 border-sky-200';
  }
  return 'bg-slate-100 text-slate-700 border-slate-200';
}

function formatDetailsSummary(action: string, raw: any): string {
  if (!raw) return '—';
  let obj: any = raw;
  if (typeof raw === 'string') {
    try {
      obj = JSON.parse(raw);
    } catch {
      return raw.length > 80 ? raw.slice(0, 77) + '…' : raw;
    }
  }
  if (!obj || typeof obj !== 'object') return String(obj);

  const parts: string[] = [];
  if (obj.attempt !== undefined) parts.push(`Attempt #${obj.attempt}`);
  if (obj.mfaRequired === true) parts.push('MFA challenge issued');
  if (obj.method) parts.push(`Via ${obj.method}`);
  if (obj.title) parts.push(obj.title);
  if (obj.referenceNo) parts.push(`Ref: ${obj.referenceNo}`);
  if (obj.name) parts.push(obj.name);
  if (obj.email) parts.push(obj.email);
  if (obj.role) parts.push(`Role: ${obj.role}`);
  if (obj.reason) parts.push(obj.reason);
  if (obj.filename || obj.fileName) parts.push(obj.filename || obj.fileName);

  if (parts.length > 0) return parts.join(' · ');

  const fallback = Object.entries(obj)
    .slice(0, 3)
    .map(([k, v]) => `${k}: ${v}`)
    .join(' · ');
  return fallback || '—';
}

function formatUserAgent(ua: string): string {
  if (!ua || ua === 'unknown') return 'Unknown';
  if (ua.toLowerCase() === 'node') return 'Server SSR';
  const browser = /Edg\//i.test(ua)
    ? 'Edge'
    : /Chrome\//i.test(ua)
      ? 'Chrome'
      : /Firefox\//i.test(ua)
        ? 'Firefox'
        : /Safari\//i.test(ua) && !/Chrome\//i.test(ua)
          ? 'Safari'
          : 'Browser';
  const os = /Windows/i.test(ua)
    ? 'Windows'
    : /Mac OS X|Macintosh/i.test(ua)
      ? 'macOS'
      : /Android/i.test(ua)
        ? 'Android'
        : /iPhone|iPad/i.test(ua)
          ? 'iOS'
          : /Linux/i.test(ua)
            ? 'Linux'
            : '';
  return os ? `${browser} · ${os}` : browser;
}

function formatIp(ip: string): string {
  if (!ip || ip === 'unknown') return '—';
  if (ip === '::1' || ip === '127.0.0.1' || ip === '::ffff:127.0.0.1') return 'localhost';
  return ip.replace(/^::ffff:/, '');
}
---

<AdminLayout title="Audit Logs Feed" description="JKSPDCL Security Auditing Console" activeTab="audit-logs">
  <div class="flex flex-col gap-6">
    
    <!-- Page Header -->
    <div class="admin-page-header">
      <div>
        <h1 class="admin-page-title">Security Audit Logs</h1>
        <p class="admin-page-subtitle">Review chronological registry of admin CRUD operations and security events under GIGW 3.0 guidelines.</p>
      </div>
      <div class="text-xs font-semibold text-slate-500 bg-slate-50 border border-slate-200 px-3 py-1.5 rounded-lg shrink-0 tabular-nums">
        Total Events: <strong class="text-[#0B3B60]">{pagedTotal}</strong>
      </div>
    </div>

    <!-- Alerts -->
    {errorMessage && (
      <div class="p-3 bg-red-50 border border-red-200 text-xs font-semibold text-red-700 rounded flex items-center gap-2" role="alert">
        <Icon name="info" size={14} class="text-red-600 shrink-0" /> {errorMessage}
      </div>
    )}

    <!-- Logs Table -->
    <div class="admin-table-card">
      <div class="admin-table-container">
        <table class="admin-table">
          <thead>
            <tr>
              <th scope="col" class="w-10 text-center">#</th>
              <th scope="col" class="w-44 whitespace-nowrap">Date &amp; Time</th>
              <th scope="col" class="min-w-[160px]">Administrator</th>
              <th scope="col" class="w-40 whitespace-nowrap">Event</th>
              <th scope="col" class="min-w-[200px]">Summary</th>
              <th scope="col" class="w-36 whitespace-nowrap">Device</th>
              <th scope="col" class="w-28 whitespace-nowrap">IP Address</th>
            </tr>
          </thead>
          <tbody class="text-xs">
            {logs.length === 0 ? (
              <tr>
                <td colspan="7" class="text-center text-slate-500 py-12 text-xs font-semibold italic">
                  <Icon name="folder" size={32} class="mx-auto text-slate-300 mb-2" />
                  No activity logs found.
                </td>
              </tr>
            ) : (
              logs.map((log: any, idx: number) => {
                const ts = log.createdAt || log.timestamp;
                const parsedDate = ts ? new Date(ts) : null;
                const formattedTs = parsedDate && !Number.isNaN(parsedDate.getTime())
                  ? parsedDate.toLocaleString('en-IN', {
                      day: '2-digit', month: 'short', year: 'numeric',
                      hour: '2-digit', minute: '2-digit', hour12: true,
                    })
                  : '—';
                const summary = formatDetailsSummary(log.action, log.details);
                return (
                  <tr key={log.id} class="transition-colors">
                    <td class="font-mono text-[11px] text-slate-400 text-center">{(page - 1) * pageSize + idx + 1}</td>
                    <td class="whitespace-nowrap font-mono text-[11px] text-slate-600 tabular-nums">
                      {formattedTs}
                    </td>
                    <td>
                      {log.user ? (
                        <div>
                          <div class="font-bold text-slate-800 leading-tight">{log.user.name}</div>
                          <div class="text-[11px] text-slate-500">{log.user.email}</div>
                        </div>
                      ) : (
                        <span class="font-mono text-[11px] text-slate-500" title={log.userId}>
                          {log.userId && log.userId.length > 16 ? `${log.userId.slice(0, 8)}…` : (log.userId || 'System')}
                        </span>
                      )}
                    </td>
                    <td class="whitespace-nowrap">
                      <span class={`inline-flex items-center px-2 py-0.5 rounded-full text-[11px] font-bold border ${actionBadgeClass(log.action)}`}>
                        {formatActionLabel(log.action)}
                      </span>
                    </td>
                    <td class="text-slate-700 font-medium max-w-xs truncate" title={summary}>
                      {summary}
                    </td>
                    <td class="text-slate-600 text-[11px] font-medium whitespace-nowrap" title={log.userAgent}>
                      {formatUserAgent(log.userAgent)}
                    </td>
                    <td class="font-mono text-[11px] text-slate-500 whitespace-nowrap" title={log.ipAddress}>
                      {formatIp(log.ipAddress)}
                    </td>
                  </tr>
                );
              })
            )}
          </tbody>
        </table>
      </div>

      <PageNav state={pagedState} url={(p: number) => pageUrl(Astro.url, p, pageSize, pagedExtra)} />
    </div>

  </div>
</AdminLayout>
