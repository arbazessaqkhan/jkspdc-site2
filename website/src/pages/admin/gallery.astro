---
import AdminLayout from '../../layouts/AdminLayout.astro';
import Icon from '../../components/Icon.astro';
import { canMutateRoutineContent } from '../../utils/roles';
import { parseApiError, BACKEND_URL } from '../../utils/api-error';

// Check authentication
const sessionToken = Astro.cookies.get('admin_session')?.value;
if (!sessionToken) {
  return Astro.redirect('/admin/login');
}

const userRole = Astro.locals.user?.role;
const canMutate = canMutateRoutineContent(userRole);

let errorMessage = '';
let successMessage = '';

// Handle Delete Action
if (Astro.request.method === 'POST') {
  if (!canMutate) {
    return Astro.redirect('/admin/gallery');
  }
  try {
    const formData = await Astro.request.formData();
    const action = formData.get('_action')?.toString();

    if (action === 'delete') {
      const id = formData.get('id')?.toString();
      if (id) {
        const res = await fetch(`${BACKEND_URL}/api/gallery/${id}`, {
          method: 'DELETE',
          headers: {
            'Authorization': `Bearer ${sessionToken}`,
          },
        });

        if (res.ok) {
          successMessage = 'Gallery item successfully deleted.';
        } else {
          const apiErr = await parseApiError(res, 'delete gallery item');
          if (apiErr.isUnauthorized) {
            return Astro.redirect('/admin/login');
          }
          errorMessage = apiErr.message;
        }
      }
    }
  } catch (e) {
    console.error('Error deleting gallery item:', e);
    errorMessage = 'An error occurred while deleting the gallery item. Check backend service status.';
  }
}

// Fetch Gallery List
let galleryList = [];
try {
  const res = await fetch(`${BACKEND_URL}/api/gallery`);
  if (res.ok) {
    galleryList = await res.json();
  } else {
    const apiErr = await parseApiError(res, 'load gallery items');
    if (apiErr.isUnauthorized) {
      return Astro.redirect('/admin/login');
    }
    errorMessage = apiErr.message;
  }
} catch (e) {
  console.error('Error fetching gallery items:', e);
  errorMessage = 'Failed to load gallery items. Unable to communicate with the server.';
}

function getImageUrl(url: string) {
  if (!url) return '';
  if (url.startsWith('/uploads/')) {
    return `${BACKEND_URL}${url}`;
  }
  return url;
}

// Group gallery items by partition
const groupedGallery: Record<string, any[]> = {};
galleryList.forEach(item => {
  const pName = item.partition || 'General (Uncategorized)';
  if (!groupedGallery[pName]) {
    groupedGallery[pName] = [];
  }
  groupedGallery[pName].push(item);
});
---

<AdminLayout title="Media Gallery Management" description="Manage JKSPDCL Photo Gallery" activeTab="gallery">
  <div class="flex flex-col gap-6">
    
    <!-- Page Header -->
    <div class="admin-page-header">
      <div>
        <h1 class="admin-page-title">Media Gallery Management</h1>
        <p class="admin-page-subtitle">Upload, categorize, and partition official photographs and event cover banners.</p>
      </div>
      {canMutate && (
        <a 
          href="/admin/gallery-form" 
          class="admin-btn admin-btn-primary flex items-center gap-1.5 self-start sm:self-auto cursor-pointer"
        >
          <Icon name="plus" size={14} /> Add Image
        </a>
      )}
    </div>

    <!-- Alerts -->
    {errorMessage && (
      <div class="p-3 bg-red-50 border border-red-200 text-xs font-semibold text-red-700 rounded flex items-center gap-2" role="alert">
        <Icon name="info" size={14} class="text-red-600 shrink-0" /> {errorMessage}
      </div>
    )}
    {successMessage && (
      <div class="p-3 bg-green-50 border border-green-200 text-xs font-semibold text-green-700 rounded flex items-center gap-2" role="alert">
        <Icon name="info" size={14} class="text-green-600 shrink-0" /> {successMessage}
      </div>
    )}

    <!-- Grouped Gallery Container -->
    {galleryList.length === 0 ? (
      <div class="bg-white rounded-lg border border-slate-200 p-12 text-center text-slate-500 font-semibold italic text-xs shadow-xs">
        <Icon name="folder" size={32} class="mx-auto text-slate-300 mb-2" />
        No images published. Click 'Add Image' to upload one.
      </div>
    ) : (
      Object.entries(groupedGallery).map(([partitionName, items]) => (
        <div class="bg-white rounded-lg border border-slate-200 shadow-xs overflow-hidden">
          <!-- Group Header -->
          <div class="bg-slate-50/80 border-b border-slate-200 px-5 py-3 flex items-center justify-between">
            <h2 class="text-xs font-bold text-slate-800 tracking-wide flex items-center gap-2">
              <span class="text-[#0B4F9C] font-black">&rarr;</span>
              <span>{partitionName}</span>
              <span class="admin-badge admin-badge-info ml-1.5">
                {items.length} {items.length === 1 ? 'record' : 'records'}
              </span>
            </h2>
          </div>
          
          <!-- Table for this partition's images -->
          <div class="admin-table-container border-0 rounded-none">
            <table class="admin-table">
              <thead>
                <tr>
                  <th scope="col" class="w-12 text-center">#</th>
                  <th scope="col" class="w-24 text-center">Preview</th>
                  <th scope="col" class="min-w-[280px]">Title / Caption</th>
                  {canMutate && <th scope="col" class="w-28 text-center sticky-col-right">Action</th>}
                </tr>
              </thead>
              <tbody>
                {items.map((item, idx) => (
                  <tr key={item.id} class="transition-colors">
                    <td class="text-center font-bold text-slate-400 text-xs">{idx + 1}</td>
                    <td class="text-center">
                      <img 
                        src={getImageUrl(item.imageUrl)} 
                        alt={item.title} 
                        class="w-16 h-11 object-cover rounded border border-slate-200 shadow-xs mx-auto" 
                        loading="lazy"
                      />
                    </td>
                    <td class="font-bold text-slate-900 text-xs leading-snug">{item.title}</td>
                    {canMutate && (
                      <td class="td-actions sticky-col-right text-center">
                        <div class="admin-action-group justify-center">
                          <a 
                            href={`/admin/gallery-form?id=${item.id}`}
                            class="admin-btn-action"
                            aria-label={`Edit Gallery Item ${item.title}`}
                            title="Edit Image"
                          >
                            <Icon name="pencil" size={13} />
                          </a>
                          <form method="POST" class="inline m-0 p-0" onsubmit="return confirm('Are you sure you want to delete this gallery image?');">
                            <input type="hidden" name="id" value={item.id} />
                            <input type="hidden" name="_action" value="delete" />
                            <button 
                              type="submit" 
                              class="admin-btn-action action-delete"
                              aria-label={`Delete Gallery Item ${item.title}`}
                              title="Delete Image"
                            >
                              <Icon name="trash-2" size={13} />
                            </button>
                          </form>
                        </div>
                      </td>
                    )}
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      ))
    )}

  </div>
</AdminLayout>
