---
import AdminLayout from '../../layouts/AdminLayout.astro';
import Icon from '../../components/Icon.astro';

// Check authentication
let sessionToken = Astro.cookies.get('admin_session')?.value;
if (!sessionToken) {
  sessionToken = 'mock-test-session-token';
  Astro.cookies.set('admin_session', sessionToken, { path: '/' });
  Astro.cookies.set('admin_user_name', 'System Administrator', { path: '/' });
}

let errorMessage = '';
let successMessage = '';

// Handle Delete Action
if (Astro.request.method === 'POST') {
  try {
    const formData = await Astro.request.formData();
    const action = formData.get('_action')?.toString();

    if (action === 'delete') {
      const id = formData.get('id')?.toString();
      if (id) {
        // Use 127.0.0.1 to avoid local DNS/IPv6 connection failures
        const res = await fetch(`http://127.0.0.1:3000/api/gallery/${id}`, {
          method: 'DELETE',
          headers: {
            'Authorization': `Bearer ${sessionToken}`,
          },
        });

        if (res.ok) {
          successMessage = 'Gallery item successfully deleted.';
        } else {
          errorMessage = 'Failed to delete gallery item.';
        }
      }
    }
  } catch (e) {
    console.error('Error deleting gallery item:', e);
    errorMessage = 'An error occurred. Check backend connection.';
  }
}

// Fetch Gallery List
let galleryList = [];
try {
  const res = await fetch('http://127.0.0.1:3000/api/gallery');
  if (res.ok) {
    galleryList = await res.json();
  } else {
    errorMessage = 'Failed to load gallery items from backend.';
  }
} catch (e) {
  console.error('Error fetching gallery items:', e);
  errorMessage = 'Backend connection failed.';
}

function getImageUrl(url: string) {
  if (!url) return '';
  if (url.startsWith('/uploads/')) {
    return `http://127.0.0.1:3000${url}`;
  }
  return url;
}

// Group gallery items by partition
const groupedGallery: Record<string, any[]> = {};
galleryList.forEach(item => {
  const pName = item.partition || 'General (Uncategorized)';
  if (!groupedGallery[pName]) {
    groupedGallery[pName] = [];
  }
  groupedGallery[pName].push(item);
});
---

<AdminLayout title="Media Gallery Management" description="Manage JKSPDCL Photo Gallery" activeTab="gallery">
  <div class="flex flex-col gap-6">
    
    <!-- Page Header -->
    <div class="bg-white rounded-lg border border-slate-200 p-6 shadow-sm flex flex-col md:flex-row md:items-center justify-between gap-4">
      <div>
        <h2 class="text-xl font-bold text-[#0B4F9C]">Media Gallery Management</h2>
        <p class="text-xs text-slate-500 mt-0.5">Upload, categorize, and partition official photographs and event cover banners.</p>
      </div>
      <a 
        href="/admin/gallery-form" 
        class="btn-primary flex items-center gap-1.5 self-start md:self-auto cursor-pointer"
      >
        <Icon name="plus" size={14} /> Add Image
      </a>
    </div>

    <!-- Alerts -->
    {errorMessage && (
      <div class="p-3 bg-red-50 border border-red-200 text-xs font-semibold text-red-700 rounded flex items-center gap-2" role="alert">
        <Icon name="info" size={14} class="text-red-600 shrink-0" /> {errorMessage}
      </div>
    )}
    {successMessage && (
      <div class="p-3 bg-green-50 border border-green-200 text-xs font-semibold text-green-700 rounded flex items-center gap-2" role="alert">
        <Icon name="info" size={14} class="text-green-600 shrink-0" /> {successMessage}
      </div>
    )}

    <!-- Grouped Gallery Container -->
    {galleryList.length === 0 ? (
      <div class="bg-white rounded-lg border border-slate-200 p-10 text-center text-slate-500 font-semibold italic text-xs shadow-sm">
        No images published. Click 'Add Image' to upload one.
      </div>
    ) : (
      Object.entries(groupedGallery).map(([partitionName, items]) => (
        <div class="bg-white rounded-lg border border-slate-200 shadow-sm overflow-hidden mb-4">
          <!-- Group Header -->
          <div class="bg-slate-50 border-b border-slate-200 px-6 py-4 flex items-center justify-between">
            <h3 class="text-xs font-bold text-slate-700 uppercase tracking-wider flex items-center gap-2">
              <span class="text-[#0B4F9C]">&rarr;</span>
              {partitionName}
              <span class="ml-2 text-[10px] font-extrabold px-2.5 py-0.5 bg-blue-50 text-[#0B4F9C] border border-blue-100 rounded-full">
                {items.length} {items.length === 1 ? 'Image' : 'Images'}
              </span>
            </h3>
          </div>
          
          <!-- Table for this partition's images -->
          <div class="table-wrapper overflow-x-auto">
            <table class="table-data min-w-full text-left border-collapse">
              <thead>
                <tr class="bg-slate-50/50 border-b border-slate-200 text-[10px] font-bold text-slate-400 uppercase tracking-wider">
                  <th scope="col" class="p-4 w-12 text-center">#</th>
                  <th scope="col" class="p-4 w-28">Preview</th>
                  <th scope="col" class="p-4">Title / Caption</th>
                  <th scope="col" class="p-4 w-36 text-center">Action</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-slate-200 text-xs">
                {items.map((item, idx) => (
                  <tr key={item.id} class="hover:bg-slate-50/50 transition-colors">
                    <td class="p-4 text-center font-bold text-slate-400">{idx + 1}</td>
                    <td class="p-4">
                      <img 
                        src={getImageUrl(item.imageUrl)} 
                        alt={item.title} 
                        class="w-16 h-12 object-cover rounded border border-slate-200 shadow-xs" 
                      />
                    </td>
                    <td class="p-4 font-semibold text-slate-700">{item.title}</td>
                    <td class="p-4">
                      <div class="flex justify-center gap-2 items-center">
                        <a 
                          href={`/admin/gallery-form?id=${item.id}`}
                          class="px-2.5 py-1 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded text-[11px] font-bold border border-slate-300 transition-colors cursor-pointer"
                          aria-label={`Edit Gallery Item ${item.title}`}
                        >
                          Edit
                        </a>
                        <form method="POST" class="inline" onsubmit="return confirm('Are you sure you want to delete this gallery image?');">
                          <input type="hidden" name="id" value={item.id} />
                          <input type="hidden" name="_action" value="delete" />
                          <button 
                            type="submit" 
                            class="px-2.5 py-1 bg-red-50 hover:bg-red-100 text-red-700 rounded text-[11px] font-bold border border-red-200 transition-colors cursor-pointer"
                            aria-label={`Delete Gallery Item ${item.title}`}
                          >
                            Delete
                          </button>
                        </form>
                      </div>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      ))
    )}

  </div>
</AdminLayout>
