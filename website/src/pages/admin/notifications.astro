---
import AdminLayout from '../../layouts/AdminLayout.astro';
import Icon from '../../components/Icon.astro';

// Check authentication
let sessionToken = Astro.cookies.get('admin_session')?.value;
if (!sessionToken) {
  sessionToken = 'mock-test-session-token';
  Astro.cookies.set('admin_session', sessionToken, { path: '/' });
  Astro.cookies.set('admin_user_name', 'System Administrator', { path: '/' });
}

const url = new URL(Astro.request.url);
let errorMessage = url.searchParams.get('error') || '';
let successMessage = '';

const successAction = url.searchParams.get('success');
if (successAction === 'create') successMessage = 'Notification published successfully.';
if (successAction === 'update') successMessage = 'Notification updated successfully.';
if (successAction === 'delete') successMessage = 'Notification deleted successfully.';

// Handle CRUD operations
if (Astro.request.method === 'POST') {
  try {
    const formData = await Astro.request.formData();
    const action = formData.get('_action')?.toString();

    if (action === 'create') {
      const title = formData.get('title')?.toString();
      const fileName = formData.get('fileName')?.toString();
      const documentUrl = formData.get('documentUrl')?.toString();

      if (!title || !fileName || !documentUrl) {
        return Astro.redirect('/admin/notifications?error=' + encodeURIComponent('All fields including file attachment are required.'));
      } else {
        const res = await fetch('http://localhost:3000/api/notifications', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Authorization': `Bearer ${sessionToken}`,
          },
          body: JSON.stringify({ title, fileName, documentUrl }),
        });

        if (res.ok) {
          return Astro.redirect('/admin/notifications?success=create');
        } else {
          const errData = await res.json().catch(() => ({}));
          return Astro.redirect('/admin/notifications?error=' + encodeURIComponent(errData.message || 'Failed to publish notification.'));
        }
      }
    } else if (action === 'update') {
      const id = formData.get('id')?.toString();
      const title = formData.get('title')?.toString();
      const fileName = formData.get('fileName')?.toString();
      const documentUrl = formData.get('documentUrl')?.toString();

      if (!id || !title || !fileName || !documentUrl) {
        return Astro.redirect('/admin/notifications?error=' + encodeURIComponent('All fields are required to update.'));
      } else {
        const res = await fetch(`http://localhost:3000/api/notifications/${id}`, {
          method: 'PUT',
          headers: {
            'Content-Type': 'application/json',
            'Authorization': `Bearer ${sessionToken}`,
          },
          body: JSON.stringify({ title, fileName, documentUrl }),
        });

        if (res.ok) {
          return Astro.redirect('/admin/notifications?success=update');
        } else {
          const errData = await res.json().catch(() => ({}));
          return Astro.redirect('/admin/notifications?error=' + encodeURIComponent(errData.message || 'Failed to update notification.'));
        }
      }
    } else if (action === 'delete') {
      const id = formData.get('id')?.toString();
      if (id) {
        const res = await fetch(`http://localhost:3000/api/notifications/${id}`, {
          method: 'DELETE',
          headers: {
            'Authorization': `Bearer ${sessionToken}`,
          },
        });

        if (res.ok) {
          return Astro.redirect('/admin/notifications?success=delete');
        } else {
          return Astro.redirect('/admin/notifications?error=' + encodeURIComponent('Failed to delete notification.'));
        }
      }
    }
  } catch (e) {
    console.error('Error handling notification action:', e);
    return Astro.redirect('/admin/notifications?error=' + encodeURIComponent('An error occurred. Check backend service status.'));
  }
}

// Fetch Notifications List
let notifications: any[] = [];
try {
  const res = await fetch('http://localhost:3000/api/notifications');
  if (res.ok) {
    notifications = await res.json();
  } else {
    errorMessage = errorMessage || 'Failed to load notifications from backend.';
  }
} catch (e) {
  console.error('Error fetching notifications:', e);
  errorMessage = errorMessage || 'Backend connection failure.';
}

const currentYear = new Date().getFullYear();
---

<AdminLayout title="Notifications" description="Manage Announcements & Notifications" activeTab="notifications">
  <div class="flex flex-col gap-6">
    
    <!-- Page Header -->
    <div class="bg-white rounded-lg border border-slate-200 p-6 shadow-sm flex flex-col md:flex-row md:items-center justify-between gap-4">
      <div>
        <h2 class="text-xl font-bold text-[#0B4F9C]">Announcements &amp; Notifications</h2>
        <p class="text-xs text-slate-500 mt-0.5">Publish and manage official notifications, public hearings, and circulars.</p>
      </div>
      <button 
        id="btn-add-item"
        class="btn-primary flex items-center gap-1.5 self-start md:self-auto cursor-pointer"
      >
        <Icon name="plus" size={14} /> Add item
      </button>
    </div>

    <!-- Alerts -->
    {errorMessage && (
      <div class="p-3 bg-red-50 border border-red-200 text-xs font-semibold text-red-700 rounded flex items-center gap-2" role="alert">
        <Icon name="info" size={14} class="text-red-600 shrink-0" /> {errorMessage}
      </div>
    )}
    {successMessage && (
      <div class="p-3 bg-green-50 border border-green-200 text-xs font-semibold text-green-700 rounded flex items-center gap-2" role="alert">
        <Icon name="info" size={14} class="text-green-600 shrink-0" /> {successMessage}
      </div>
    )}

    <!-- Filter Bar (Matching screenshot select year / limit) -->
    <div class="bg-white rounded-lg border border-slate-200 p-4 shadow-sm flex flex-wrap gap-4 items-center justify-between">
      <div class="flex items-center gap-4">
        <div class="flex items-center gap-2">
          <label for="year-select" class="text-xs font-bold text-slate-650">Select Year</label>
          <select id="year-select" class="form-select text-xs py-1.5 pr-8 pl-3 border-slate-200 rounded">
            <option value="All">All Years</option>
            <option value="2026" selected>2026</option>
            <option value="2025">2025</option>
            <option value="2024">2024</option>
          </select>
        </div>
      </div>
      <div class="flex items-center gap-2">
        <label for="limit-select" class="text-xs font-bold text-slate-650">Select limit</label>
        <select id="limit-select" class="form-select text-xs py-1.5 pr-8 pl-3 border-slate-200 rounded">
          <option value="10">10</option>
          <option value="25">25</option>
          <option value="50">50</option>
        </select>
      </div>
    </div>

    <!-- Notifications Table -->
    <div class="bg-white rounded-lg border border-slate-200 shadow-sm overflow-hidden">
      <div class="table-wrapper overflow-x-auto">
        <table class="table-data min-w-full text-left border-collapse">
          <thead>
            <tr class="bg-slate-50 border-b border-slate-200 text-xs font-bold text-slate-500 uppercase tracking-wider">
              <th scope="col" class="p-4 w-12 text-center">#</th>
              <th scope="col" class="p-4">Title</th>
              <th scope="col" class="p-4 w-40">Publish Date</th>
              <th scope="col" class="p-4 w-36 text-center">Action</th>
            </tr>
          </thead>
          <tbody id="notifications-table-body" class="divide-y divide-slate-200 text-xs">
            {notifications.length === 0 ? (
              <tr>
                <td colspan="4" class="text-center text-slate-500 py-10 font-semibold italic">
                  No notifications published. Click 'Add item' to create one.
                </td>
              </tr>
            ) : (
              notifications.map((notif: any, idx: number) => (
                <tr 
                  class="hover:bg-slate-50/50 transition-colors notification-row"
                  data-year={new Date(notif.publishDate).getFullYear()}
                  data-notif={JSON.stringify(notif)}
                >
                  <td class="p-4 text-center font-bold text-slate-400 row-index">{idx + 1}</td>
                  <td class="p-4 font-semibold text-slate-800 text-left">
                    <div class="flex flex-col gap-1">
                      <span class="text-sm font-bold text-slate-850 leading-snug">{notif.title}</span>
                      <a href={notif.documentUrl} target="_blank" class="text-[10px] text-[#0B4F9C] hover:underline font-bold font-mono flex items-center gap-1 mt-0.5">
                        <Icon name="download" size={10} />
                        {notif.fileName}
                      </a>
                    </div>
                  </td>
                  <td class="p-4 text-slate-600 font-medium whitespace-nowrap">
                    {new Date(notif.publishDate).toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric' })}
                  </td>
                  <td class="p-4">
                    <div class="flex justify-center gap-2">
                      <button 
                        type="button"
                        class="btn-edit px-2 py-1 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded text-[11px] font-bold border border-slate-300 transition-colors cursor-pointer"
                        data-id={notif.id}
                      >
                        Edit
                      </button>
                      <form method="POST" class="inline" onsubmit="return confirm('Are you sure you want to delete this notification?');">
                        <input type="hidden" name="id" value={notif.id} />
                        <input type="hidden" name="_action" value="delete" />
                        <button 
                          type="submit" 
                          class="px-2 py-1 bg-red-50 hover:bg-red-100 text-red-650 rounded text-[11px] font-bold border border-red-200 transition-colors cursor-pointer"
                        >
                          Delete
                        </button>
                      </form>
                    </div>
                  </td>
                </tr>
              ))
            )}
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <!-- Add/Edit Modal (Matching popup in screenshot) -->
  <div id="modal-container" class="fixed inset-0 z-55 flex items-center justify-center hidden">
    <!-- Dim backdrop -->
    <div id="modal-backdrop" class="absolute inset-0 bg-slate-900/60 backdrop-blur-[2px]"></div>
    
    <!-- Modal Card -->
    <div class="bg-white rounded-lg border border-slate-200 shadow-2xl w-full max-w-lg p-6 relative z-10 animate-fade-in text-left">
      <button 
        type="button" 
        id="btn-close-modal" 
        class="absolute top-4 right-4 text-slate-400 hover:text-slate-600 cursor-pointer focus:outline-none"
        aria-label="Close modal"
      >
        <Icon name="x" size={18} strokeWidth={2.5} />
      </button>

      <h3 id="modal-heading" class="text-sm font-bold text-slate-800 border-b border-slate-100 pb-3 mb-4 uppercase tracking-wider">
        Add Notification
      </h3>

      <form id="notif-form" method="POST" class="space-y-4">
        <input type="hidden" name="id" id="notif-id" />
        <input type="hidden" name="_action" id="notif-action" value="create" />

        <div class="form-group flex flex-col gap-1.5">
          <label for="notif-title" class="text-xs font-bold text-slate-700">Title:</label>
          <input 
            type="text" 
            name="title" 
            id="notif-title" 
            required 
            class="form-input text-xs" 
            placeholder="Enter title" 
          />
        </div>

        <div class="form-group flex flex-col gap-1.5">
          <label for="notif-fileName" class="text-xs font-bold text-slate-700">File Name:</label>
          <input 
            type="text" 
            name="fileName" 
            id="notif-fileName" 
            required 
            class="form-input text-xs" 
            placeholder="Enter file name" 
          />
        </div>

        <!-- File Upload Section (Matching screenshot design) -->
        <div class="form-group flex flex-col gap-1.5">
          <label class="text-xs font-bold text-slate-700">Upload File:</label>
          <div class="flex items-center gap-2 border border-slate-200 rounded p-1 bg-slate-50 relative">
            <button 
              type="button" 
              id="btn-choose-file"
              class="px-3 py-1.5 bg-white border border-slate-300 rounded text-xs font-bold text-slate-700 shadow-sm cursor-pointer hover:bg-slate-50"
            >
              Choose File
            </button>
            <span id="file-label" class="text-xs text-slate-500 font-medium truncate flex-1 pl-1">
              No file chosen
            </span>
            <input 
              type="file" 
              id="modal-file-uploader" 
              class="absolute inset-0 opacity-0 cursor-pointer"
              accept=".pdf,.jpg,.jpeg,.png,.doc,.docx,.xls,.xlsx" 
            />
          </div>
          
          <input type="hidden" name="documentUrl" id="notif-documentUrl" required />
          
          <span id="upload-status" class="text-[10px] text-slate-400 font-semibold mt-1 block">
            PDF, JPG, PNG, DOCX, XLSX (Max 10MB)
          </span>
        </div>

        <!-- Actions -->
        <div class="flex items-center justify-end gap-3 border-t border-slate-100 pt-4 mt-6">
          <button 
            type="button" 
            id="btn-reset-modal" 
            class="px-4 py-2 bg-slate-550 text-white rounded text-xs font-bold hover:bg-slate-600 transition-colors cursor-pointer"
          >
            Reset
          </button>
          <button 
            type="submit" 
            id="btn-submit-modal"
            class="px-5 py-2 bg-blue-600 text-white rounded text-xs font-bold hover:bg-blue-700 transition-colors shadow-md cursor-pointer"
          >
            Submit
          </button>
        </div>
      </form>
    </div>
  </div>

  <script define:vars={{ sessionToken }}>
    const modalContainer = document.getElementById('modal-container');
    const modalBackdrop = document.getElementById('modal-backdrop');
    const btnAdd = document.getElementById('btn-add-item');
    const btnClose = document.getElementById('btn-close-modal');
    const btnReset = document.getElementById('btn-reset-modal');
    const notifForm = document.getElementById('notif-form');
    const fileUploader = document.getElementById('modal-file-uploader');
    const fileLabel = document.getElementById('file-label');
    const btnChoose = document.getElementById('btn-choose-file');
    const uploadStatus = document.getElementById('upload-status');

    // Form inputs
    const notifIdInput = document.getElementById('notif-id');
    const notifActionInput = document.getElementById('notif-action');
    const notifTitleInput = document.getElementById('notif-title');
    const notifFileNameInput = document.getElementById('notif-fileName');
    const notifDocumentUrlInput = document.getElementById('notif-documentUrl');
    const modalHeading = document.getElementById('modal-heading');
    const btnSubmit = document.getElementById('btn-submit-modal');

    // Year and limit filter handling
    const yearSelect = document.getElementById('year-select');
    const limitSelect = document.getElementById('limit-select');

    function applyFilters() {
      const selectedYear = yearSelect.value;
      const selectedLimit = parseInt(limitSelect.value, 10);
      const rows = document.querySelectorAll('.notification-row');

      let visibleCount = 0;

      rows.forEach((row) => {
        const year = row.getAttribute('data-year');
        const matchesYear = selectedYear === 'All' || year === selectedYear;

        if (matchesYear && visibleCount < selectedLimit) {
          row.classList.remove('hidden');
          visibleCount++;
          row.querySelector('.row-index').textContent = visibleCount;
        } else {
          row.classList.add('hidden');
        }
      });
    }

    yearSelect.addEventListener('change', applyFilters);
    limitSelect.addEventListener('change', applyFilters);

    // Initial filter run
    applyFilters();

    // Show/Hide Modal
    function showModal(isEdit = false) {
      modalContainer.classList.remove('hidden');
      if (isEdit) {
        modalHeading.textContent = 'Edit Notification';
        notifActionInput.value = 'update';
        btnSubmit.textContent = 'Update';
      } else {
        modalHeading.textContent = 'Add Notification';
        notifActionInput.value = 'create';
        btnSubmit.textContent = 'Submit';
        resetForm();
      }
    }

    function hideModal() {
      modalContainer.classList.add('hidden');
    }

    btnAdd.addEventListener('click', () => showModal(false));
    btnClose.addEventListener('click', hideModal);
    modalBackdrop.addEventListener('click', hideModal);

    function resetForm() {
      notifIdInput.value = '';
      notifTitleInput.value = '';
      notifFileNameInput.value = '';
      notifDocumentUrlInput.value = '';
      fileLabel.textContent = 'No file chosen';
      fileLabel.classList.remove('text-emerald-700', 'font-bold');
      uploadStatus.textContent = 'PDF, JPG, PNG, DOCX, XLSX (Max 10MB)';
      uploadStatus.className = 'text-[10px] text-slate-400 font-semibold mt-1 block';
    }

    btnReset.addEventListener('click', resetForm);

    // Handle AJAX File Upload
    fileUploader.addEventListener('change', async (event) => {
      const file = event.target.files?.[0];
      if (!file) return;

      fileLabel.textContent = `Uploading ${file.name}...`;
      fileLabel.classList.remove('text-emerald-700', 'font-bold');
      uploadStatus.textContent = 'Uploading to secure asset server...';
      uploadStatus.className = 'text-[10px] text-blue-600 font-semibold mt-1 block animate-pulse';

      const formData = new FormData();
      formData.append('file', file);

      try {
        const response = await fetch('http://localhost:3000/api/upload', {
          method: 'POST',
          headers: {
            'Authorization': `Bearer ${sessionToken}`,
          },
          body: formData,
        });

        if (!response.ok) {
          const errorData = await response.json().catch(() => ({}));
          throw new Error(errorData.message || 'Upload failed');
        }

        const result = await response.json();
        notifDocumentUrlInput.value = result.url;
        fileLabel.textContent = file.name;
        fileLabel.classList.add('text-emerald-700', 'font-bold');
        uploadStatus.textContent = `✓ Uploaded successfully (${Math.round(result.sizeBytes / 1024)} KB)`;
        uploadStatus.className = 'text-[10px] text-emerald-600 font-semibold mt-1 block';
        
        // Auto-fill File Name input if it is empty
        if (!notifFileNameInput.value) {
          notifFileNameInput.value = file.name;
        }
      } catch (error) {
        fileLabel.textContent = 'Upload failed';
        uploadStatus.textContent = `⚠ Upload error: ${error.message}`;
        uploadStatus.className = 'text-[10px] text-red-650 font-bold mt-1 block';
        notifDocumentUrlInput.value = '';
      }
    });

    // Handle Edit Click
    document.querySelectorAll('.btn-edit').forEach((btn) => {
      btn.addEventListener('click', () => {
        const row = btn.closest('.notification-row');
        const notifData = JSON.parse(row.getAttribute('data-notif'));

        notifIdInput.value = notifData.id;
        notifTitleInput.value = notifData.title;
        notifFileNameInput.value = notifData.fileName;
        notifDocumentUrlInput.value = notifData.documentUrl;

        fileLabel.textContent = notifData.fileName;
        fileLabel.classList.add('text-emerald-700', 'font-bold');
        uploadStatus.textContent = 'Attached existing file';
        uploadStatus.className = 'text-[10px] text-emerald-600 font-semibold mt-1 block';

        showModal(true);
      });
    });
  </script>

  <style>
    /* Premium style refinements */
    .btn-primary {
      background-color: #0B4F9C;
      color: white;
      font-size: 0.75rem;
      font-weight: 700;
      padding: 0.5rem 1rem;
      border-radius: 0.5rem;
      transition-property: all;
      box-shadow: 0 4px 6px -1px rgb(0 0 0 / 0.1);
    }
    .btn-primary:hover {
      background-color: #084A8F;
    }
    .form-input {
      border: 1px solid #e2e8f0;
      border-radius: 0.5rem;
      padding: 0.5rem 0.875rem;
      font-size: 0.75rem;
      transition-property: all;
    }
    .form-input:focus {
      border-color: #0B4F9C;
      outline: 2px solid transparent;
      outline-offset: 2px;
    }
    .form-select {
      border: 1px solid #e2e8f0;
      border-radius: 0.25rem;
      padding: 0.375rem 0.625rem;
      font-size: 0.75rem;
      cursor: pointer;
    }
    .form-select:focus {
      border-color: #0B4F9C;
      outline: none;
    }
    .btn-edit {
      transition-property: all;
    }
    @keyframes fadeIn {
      from { opacity: 0; transform: scale(0.95); }
      to { opacity: 1; transform: scale(1); }
    }
    .animate-fade-in {
      animation: fadeIn 0.25s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }
  </style>
</AdminLayout>
