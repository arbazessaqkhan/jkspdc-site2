---
import AdminLayout from '../../layouts/AdminLayout.astro';
import Icon from '../../components/Icon.astro';
import { isAdmin } from '../../utils/roles';
import { parseApiError, BACKEND_URL } from '../../utils/api-error';

// Check authentication
const sessionToken = Astro.cookies.get('admin_session')?.value;
if (!sessionToken) {
  return Astro.redirect('/admin/login');
}

// Role protection: Notifications management is ADMIN-only
const userRole = Astro.locals.user?.role;
if (!isAdmin(userRole)) {
  return Astro.redirect('/admin/dashboard');
}

const url = new URL(Astro.request.url);
let errorMessage = url.searchParams.get('error') || '';
let successMessage = '';

const successAction = url.searchParams.get('success');
if (successAction === 'create') successMessage = 'Notification published successfully.';
if (successAction === 'update') successMessage = 'Notification updated successfully.';
if (successAction === 'delete') successMessage = 'Notification deleted successfully.';

// Handle CRUD operations
if (Astro.request.method === 'POST') {
  try {
    const formData = await Astro.request.formData();
    const action = formData.get('_action')?.toString();

    if (action === 'create') {
      const title = formData.get('title')?.toString();
      const fileName = formData.get('fileName')?.toString();
      const documentUrl = formData.get('documentUrl')?.toString();

      if (!title || !fileName || !documentUrl) {
        return Astro.redirect('/admin/notifications?error=' + encodeURIComponent('All fields including file attachment are required.'));
      } else {
        const res = await fetch(`${BACKEND_URL}/api/notifications`, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Authorization': `Bearer ${sessionToken}`,
          },
          body: JSON.stringify({ title, fileName, documentUrl }),
        });

        if (res.ok) {
          return Astro.redirect('/admin/notifications?success=create');
        } else {
          const apiErr = await parseApiError(res, 'publish notification');
          if (apiErr.isUnauthorized) {
            return Astro.redirect('/admin/login');
          }
          return Astro.redirect('/admin/notifications?error=' + encodeURIComponent(apiErr.message));
        }
      }
    } else if (action === 'update') {
      const id = formData.get('id')?.toString();
      const title = formData.get('title')?.toString();
      const fileName = formData.get('fileName')?.toString();
      const documentUrl = formData.get('documentUrl')?.toString();

      if (!id || !title || !fileName || !documentUrl) {
        return Astro.redirect('/admin/notifications?error=' + encodeURIComponent('All fields are required to update.'));
      } else {
        const res = await fetch(`${BACKEND_URL}/api/notifications/${id}`, {
          method: 'PUT',
          headers: {
            'Content-Type': 'application/json',
            'Authorization': `Bearer ${sessionToken}`,
          },
          body: JSON.stringify({ title, fileName, documentUrl }),
        });

        if (res.ok) {
          return Astro.redirect('/admin/notifications?success=update');
        } else {
          const apiErr = await parseApiError(res, 'update notification');
          if (apiErr.isUnauthorized) {
            return Astro.redirect('/admin/login');
          }
          return Astro.redirect('/admin/notifications?error=' + encodeURIComponent(apiErr.message));
        }
      }
    } else if (action === 'delete') {
      const id = formData.get('id')?.toString();
      if (id) {
        const res = await fetch(`${BACKEND_URL}/api/notifications/${id}`, {
          method: 'DELETE',
          headers: {
            'Authorization': `Bearer ${sessionToken}`,
          },
        });

        if (res.ok) {
          return Astro.redirect('/admin/notifications?success=delete');
        } else {
          const apiErr = await parseApiError(res, 'delete notification');
          if (apiErr.isUnauthorized) {
            return Astro.redirect('/admin/login');
          }
          return Astro.redirect('/admin/notifications?error=' + encodeURIComponent(apiErr.message));
        }
      }
    }
  } catch (e) {
    console.error('Error handling notification action:', e);
    return Astro.redirect('/admin/notifications?error=' + encodeURIComponent('An unexpected error occurred while processing notification. Check backend service status.'));
  }
}

// Fetch Notifications List
let notifications: any[] = [];
try {
  const res = await fetch(`${BACKEND_URL}/api/notifications`);
  if (res.ok) {
    notifications = await res.json();
  } else {
    const apiErr = await parseApiError(res, 'load notifications');
    if (apiErr.isUnauthorized) {
      return Astro.redirect('/admin/login');
    }
    errorMessage = errorMessage || apiErr.message;
  }
} catch (e) {
  console.error('Error fetching notifications:', e);
  errorMessage = errorMessage || 'Failed to load notifications. Unable to communicate with the server.';
}

const currentYear = new Date().getFullYear();
---

<AdminLayout title="Notifications" description="Manage Announcements & Notifications" activeTab="notifications">
  <div class="flex flex-col gap-6">
    
    <!-- Standard Admin Page Header -->
    <div class="admin-page-header">
      <div>
        <h1 class="text-lg font-extrabold text-[#0B4F9C] tracking-tight">Announcements &amp; Notifications</h1>
        <p class="text-xs text-slate-500 mt-0.5">Publish and manage official notifications, circulars, public orders, and recruitment notices.</p>
      </div>
      <button 
        id="btn-add-item"
        class="btn-primary flex items-center gap-1.5 text-xs py-2 px-3.5 self-start md:self-auto cursor-pointer"
      >
        <Icon name="plus" size={13} strokeWidth={2.5} />
        <span>Add Notification</span>
      </button>
    </div>

    <!-- Alerts -->
    {errorMessage && (
      <div class="p-3 bg-red-50 border border-red-200 text-xs font-semibold text-red-700 rounded flex items-center gap-2" role="alert">
        <Icon name="info" size={14} class="text-red-600 shrink-0" /> {errorMessage}
      </div>
    )}
    {successMessage && (
      <div class="p-3 bg-green-50 border border-green-200 text-xs font-semibold text-green-700 rounded flex items-center gap-2" role="alert">
        <Icon name="check" size={14} class="text-green-600 shrink-0" /> {successMessage}
      </div>
    )}

    <!-- Filter & Search Toolbar -->
    <div class="admin-toolbar">
      <div class="flex items-center gap-3 flex-wrap flex-1 min-w-0">
        <div class="relative w-full sm:w-72">
          <input 
            type="text" 
            id="search-notif-input" 
            placeholder="Search notifications..." 
            class="w-full bg-slate-50 border border-slate-300 rounded text-xs text-slate-800 pl-8 pr-3 py-1.5 focus:ring-1 focus:ring-[#0B4F9C] focus:border-[#0B4F9C] outline-none"
          />
          <div class="absolute left-2.5 top-2 text-slate-400">
            <Icon name="search" size={13} />
          </div>
        </div>

        <div class="flex items-center gap-2">
          <label for="year-select" class="text-xs font-bold text-slate-600 shrink-0">Year:</label>
          <select id="year-select" class="bg-slate-50 border border-slate-300 rounded text-xs py-1.5 px-2.5 text-slate-700 outline-none">
            <option value="All">All Years</option>
            <option value="2026" selected>2026</option>
            <option value="2025">2025</option>
            <option value="2024">2024</option>
          </select>
        </div>
      </div>

      <div class="text-xs text-slate-500 font-medium shrink-0">
        Total Notifications: <span id="visible-notif-count" class="font-bold text-slate-800">{notifications.length}</span>
      </div>
    </div>

    <!-- Administrative Data Table -->
    <div class="admin-table-container">
      <table class="table-data min-w-full text-left" id="notifications-data-table">
        <thead>
          <tr>
            <th scope="col" class="w-12 text-center">#</th>
            <th scope="col" class="min-w-[280px]">Notification Title &amp; Attachment</th>
            <th scope="col" class="w-36 whitespace-nowrap">Publish Date</th>
            <th scope="col" class="w-24 text-center whitespace-nowrap">Document</th>
            <th scope="col" class="w-24 text-center whitespace-nowrap sticky-col-right">Action</th>
          </tr>
        </thead>
        <tbody id="notifications-table-body">
          {notifications.length === 0 ? (
            <tr id="empty-notif-row">
              <td colspan="5" class="text-center text-slate-500 py-12 text-xs font-semibold italic">
                No notifications published. Click 'Add Notification' to create one.
              </td>
            </tr>
          ) : (
            notifications.map((notif: any, idx: number) => (
              <tr 
                class="notification-row transition-colors"
                data-year={new Date(notif.publishDate).getFullYear()}
                data-search={notif.title?.toLowerCase() || ''}
                data-notif={JSON.stringify(notif)}
              >
                <td class="text-center font-bold text-slate-400 text-xs row-index">{idx + 1}</td>
                <td class="font-medium text-slate-900 text-left">
                  <div class="flex flex-col gap-1">
                    <span class="text-xs font-bold text-slate-900 leading-snug">{notif.title}</span>
                    {notif.fileName && (
                      <span class="text-[11px] text-slate-500 font-mono flex items-center gap-1.5">
                        <Icon name="file-text" size={11} class="text-slate-400 shrink-0" />
                        <span>{notif.fileName}</span>
                      </span>
                    )}
                  </div>
                </td>
                <td class="text-slate-600 font-medium whitespace-nowrap text-xs">
                  {new Date(notif.publishDate).toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric' })}
                </td>
                <td class="text-center whitespace-nowrap">
                  {notif.documentUrl ? (
                    <a 
                      href={notif.documentUrl} 
                      target="_blank" 
                      rel="noopener noreferrer" 
                      class="admin-btn-action action-download mx-auto"
                      title={`Download ${notif.fileName || 'document'}`}
                      aria-label={`Download ${notif.fileName || 'document'}`}
                    >
                      <Icon name="download" size={13} />
                    </a>
                  ) : (
                    <span class="text-slate-400 text-xs">—</span>
                  )}
                </td>
                <td class="td-actions sticky-col-right">
                  <div class="admin-action-group">
                    <button 
                      type="button"
                      class="btn-edit admin-btn-action"
                      data-id={notif.id}
                      title={`Edit ${notif.title}`}
                      aria-label={`Edit ${notif.title}`}
                    >
                      <Icon name="pencil" size={13} />
                    </button>
                    <form method="POST" class="inline m-0 p-0" onsubmit="return confirm('Are you sure you want to delete this notification?');">
                      <input type="hidden" name="id" value={notif.id} />
                      <input type="hidden" name="_action" value="delete" />
                      <button 
                        type="submit" 
                        class="admin-btn-action action-delete"
                        title={`Delete ${notif.title}`}
                        aria-label={`Delete ${notif.title}`}
                      >
                        <Icon name="trash-2" size={13} />
                      </button>
                    </form>
                  </div>
                </td>
              </tr>
            ))
          )}
          <tr id="no-matching-notif-row" style="display: none;">
            <td colspan="5" class="text-center text-slate-500 py-12 text-xs font-semibold italic">
              No notifications found matching your filter criteria.
            </td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Add/Edit Modal (Matching popup in screenshot) -->
  <div id="modal-container" class="fixed inset-0 z-55 flex items-center justify-center hidden">
    <!-- Dim backdrop -->
    <div id="modal-backdrop" class="absolute inset-0 bg-slate-900/60 backdrop-blur-[2px]"></div>
    
    <!-- Modal Card -->
    <div class="bg-white rounded-lg border border-slate-200 shadow-2xl w-full max-w-lg p-6 relative z-10 animate-fade-in text-left">
      <button 
        type="button" 
        id="btn-close-modal" 
        class="absolute top-4 right-4 text-slate-400 hover:text-slate-600 cursor-pointer focus:outline-none"
        aria-label="Close modal"
      >
        <Icon name="x" size={18} strokeWidth={2.5} />
      </button>

      <h3 id="modal-heading" class="text-sm font-bold text-slate-800 border-b border-slate-100 pb-3 mb-4 uppercase tracking-wider">
        Add Notification
      </h3>

      <form id="notif-form" method="POST" class="space-y-4">
        <input type="hidden" name="id" id="notif-id" />
        <input type="hidden" name="_action" id="notif-action" value="create" />

        <div class="form-group flex flex-col gap-1.5">
          <label for="notif-title" class="text-xs font-bold text-slate-700">Title:</label>
          <input 
            type="text" 
            name="title" 
            id="notif-title" 
            required 
            class="form-input text-xs" 
            placeholder="Enter title" 
          />
        </div>

        <div class="form-group flex flex-col gap-1.5">
          <label for="notif-fileName" class="text-xs font-bold text-slate-700">File Name:</label>
          <input 
            type="text" 
            name="fileName" 
            id="notif-fileName" 
            required 
            class="form-input text-xs" 
            placeholder="Enter file name" 
          />
        </div>

        <!-- File Upload Section (Matching screenshot design) -->
        <div class="form-group flex flex-col gap-1.5">
          <label class="text-xs font-bold text-slate-700">Upload File:</label>
          <div class="flex items-center gap-2 border border-slate-200 rounded p-1 bg-slate-50 relative">
            <button 
              type="button" 
              id="btn-choose-file"
              class="px-3 py-1.5 bg-white border border-slate-300 rounded text-xs font-bold text-slate-700 shadow-sm cursor-pointer hover:bg-slate-50"
            >
              Choose File
            </button>
            <span id="file-label" class="text-xs text-slate-500 font-medium truncate flex-1 pl-1">
              No file chosen
            </span>
            <input 
              type="file" 
              id="modal-file-uploader" 
              class="absolute inset-0 opacity-0 cursor-pointer"
              accept=".pdf,.jpg,.jpeg,.png,.doc,.docx,.xls,.xlsx" 
            />
          </div>
          
          <input type="hidden" name="documentUrl" id="notif-documentUrl" required />
          
          <label class="flex items-center gap-2 p-1.5 bg-amber-50/70 border border-amber-200/80 rounded cursor-pointer hover:bg-amber-50 transition-colors select-none mt-2">
            <input type="checkbox" id="notif-is-important-checkbox" class="w-3.5 h-3.5 rounded text-[#0B4F9C] border-slate-300 focus:ring-[#0B4F9C] cursor-pointer" />
            <span class="text-[11px] font-bold text-amber-900 flex items-center gap-1.5"><Icon name="star" size={12} class="text-amber-600 shrink-0" /> Mark as Important <span class="text-[10px] font-normal text-amber-700">(Allow up to 100 MB)</span></span>
          </label>
          
          <span id="upload-status" class="text-[10px] text-slate-400 font-semibold mt-1 block">
            PDF, JPG, PNG, DOCX, XLSX (Max 20MB / 100MB if Important)
          </span>
        </div>

        <!-- Actions -->
        <div class="flex items-center justify-end gap-3 border-t border-slate-100 pt-4 mt-6">
          <button 
            type="button" 
            id="btn-reset-modal" 
            class="px-4 py-2 bg-slate-550 text-white rounded text-xs font-bold hover:bg-slate-600 transition-colors cursor-pointer"
          >
            Reset
          </button>
          <button 
            type="submit" 
            id="btn-submit-modal"
            class="px-5 py-2 bg-blue-600 text-white rounded text-xs font-bold hover:bg-blue-700 transition-colors shadow-md cursor-pointer"
          >
            Submit
          </button>
        </div>
      </form>
    </div>
  </div>

  <script define:vars={{ sessionToken, backendUrl: BACKEND_URL }}>
    (function() {
      function getElements() {
        return {
          modalContainer: document.getElementById('modal-container'),
          modalBackdrop: document.getElementById('modal-backdrop'),
          btnAdd: document.getElementById('btn-add-item'),
          btnClose: document.getElementById('btn-close-modal'),
          btnReset: document.getElementById('btn-reset-modal'),
          notifForm: document.getElementById('notif-form'),
          fileUploader: document.getElementById('modal-file-uploader'),
          fileLabel: document.getElementById('file-label'),
          btnChoose: document.getElementById('btn-choose-file'),
          uploadStatus: document.getElementById('upload-status'),
          notifIdInput: document.getElementById('notif-id'),
          notifActionInput: document.getElementById('notif-action'),
          notifTitleInput: document.getElementById('notif-title'),
          notifFileNameInput: document.getElementById('notif-fileName'),
          notifDocumentUrlInput: document.getElementById('notif-documentUrl'),
          modalHeading: document.getElementById('modal-heading'),
          btnSubmit: document.getElementById('btn-submit-modal'),
          yearSelect: document.getElementById('year-select'),
          limitSelect: document.getElementById('limit-select'),
        };
      }

      function applyFilters() {
        var els = getElements();
        if (!els.yearSelect || !els.limitSelect) return;
        var selectedYear = els.yearSelect.value;
        var selectedLimit = parseInt(els.limitSelect.value, 10);
        var rows = document.querySelectorAll('.notification-row');
        var emptyRow = document.getElementById('no-matching-notif-row');

        var visibleCount = 0;
        rows.forEach(function(row) {
          var year = row.getAttribute('data-year');
          var matchesYear = selectedYear === 'All' || year === selectedYear;

          if (matchesYear && visibleCount < selectedLimit) {
            row.style.display = '';
            visibleCount++;
            var idxEl = row.querySelector('.row-index');
            if (idxEl) idxEl.textContent = visibleCount;
          } else {
            row.style.display = 'none';
          }
        });

        if (emptyRow) {
          emptyRow.style.display = (visibleCount === 0 && rows.length > 0) ? 'table-row' : 'none';
        }
      }

      function showModal(isEdit) {
        var els = getElements();
        if (!els.modalContainer) return;
        els.modalContainer.classList.remove('hidden');
        if (isEdit) {
          if (els.modalHeading) els.modalHeading.textContent = 'Edit Notification';
          if (els.notifActionInput) els.notifActionInput.value = 'update';
          if (els.btnSubmit) els.btnSubmit.textContent = 'Update';
        } else {
          if (els.modalHeading) els.modalHeading.textContent = 'Add Notification';
          if (els.notifActionInput) els.notifActionInput.value = 'create';
          if (els.btnSubmit) els.btnSubmit.textContent = 'Submit';
          resetForm();
        }
      }

      function hideModal() {
        var els = getElements();
        if (els.modalContainer) els.modalContainer.classList.add('hidden');
      }

      function resetForm() {
        var els = getElements();
        if (els.notifIdInput) els.notifIdInput.value = '';
        if (els.notifTitleInput) els.notifTitleInput.value = '';
        if (els.notifFileNameInput) els.notifFileNameInput.value = '';
        if (els.notifDocumentUrlInput) els.notifDocumentUrlInput.value = '';
        if (els.fileLabel) {
          els.fileLabel.textContent = 'No file chosen';
          els.fileLabel.classList.remove('text-emerald-700', 'font-bold');
        }
        if (els.uploadStatus) {
          els.uploadStatus.textContent = 'PDF, JPG, PNG, DOCX, XLSX (Max 10MB)';
          els.uploadStatus.className = 'text-[10px] text-slate-400 font-semibold mt-1 block';
        }
      }

      // Delegated clicks
      document.addEventListener('click', function(e) {
        var addBtn = e.target.closest('#btn-add-item');
        if (addBtn) {
          e.preventDefault();
          showModal(false);
          return;
        }

        var editBtn = e.target.closest('.btn-edit');
        if (editBtn) {
          e.preventDefault();
          var row = editBtn.closest('.notification-row');
          if (row) {
            try {
              var notifData = JSON.parse(row.getAttribute('data-notif'));
              var els = getElements();
              if (els.notifIdInput) els.notifIdInput.value = notifData.id || '';
              if (els.notifTitleInput) els.notifTitleInput.value = notifData.title || '';
              if (els.notifFileNameInput) els.notifFileNameInput.value = notifData.fileName || '';
              if (els.notifDocumentUrlInput) els.notifDocumentUrlInput.value = notifData.documentUrl || '';
              if (els.fileLabel) {
                els.fileLabel.textContent = notifData.fileName || 'Attached existing file';
                els.fileLabel.classList.add('text-emerald-700', 'font-bold');
              }
              if (els.uploadStatus) {
                els.uploadStatus.textContent = 'Attached existing file';
                els.uploadStatus.className = 'text-[10px] text-emerald-600 font-semibold mt-1 block';
              }
              showModal(true);
            } catch (err) {
              console.error(err);
            }
          }
          return;
        }

        var closeBtn = e.target.closest('#btn-close-modal, #modal-backdrop');
        if (closeBtn) {
          e.preventDefault();
          hideModal();
          return;
        }

        var resetBtn = e.target.closest('#btn-reset-modal');
        if (resetBtn) {
          e.preventDefault();
          resetForm();
          return;
        }
      });

      // Filter change listeners
      document.addEventListener('change', function(e) {
        if (e.target && (e.target.id === 'year-select' || e.target.id === 'limit-select')) {
          applyFilters();
        }

        // File upload
        if (e.target && e.target.id === 'modal-file-uploader') {
          var file = e.target.files && e.target.files[0];
          if (!file) return;

          var els = getElements();
          var isImportant = document.getElementById('notif-is-important-checkbox')?.checked || false;
          var MAX_STANDARD = 20 * 1024 * 1024;
          var MAX_IMPORTANT = 100 * 1024 * 1024;

          if (!isImportant && file.size > MAX_STANDARD) {
            var sizeMB = (file.size / (1024 * 1024)).toFixed(2);
            alert(`File size (${sizeMB} MB) exceeds the standard 20 MB limit.\n\nPlease check "Mark as Important" to allow uploading files up to 100 MB.`);
            e.target.value = '';
            if (els.fileLabel) els.fileLabel.textContent = 'No file chosen';
            return;
          }

          if (file.size > MAX_IMPORTANT) {
            var sizeMB = (file.size / (1024 * 1024)).toFixed(2);
            alert(`File size (${sizeMB} MB) exceeds the maximum allowed limit of 100 MB.`);
            e.target.value = '';
            if (els.fileLabel) els.fileLabel.textContent = 'No file chosen';
            return;
          }

          if (els.fileLabel) {
            els.fileLabel.textContent = `Uploading ${file.name}...`;
            els.fileLabel.classList.remove('text-emerald-700', 'font-bold');
          }
          if (els.uploadStatus) {
            els.uploadStatus.textContent = 'Uploading to secure asset server...';
            els.uploadStatus.className = 'text-[10px] text-blue-600 font-semibold mt-1 block animate-pulse';
          }

          var formData = new FormData();
          formData.append('file', file);
          formData.append('isImportant', isImportant ? 'true' : 'false');

          fetch(`${backendUrl}/api/upload`, {
            method: 'POST',
            headers: { 'Authorization': `Bearer ${sessionToken}` },
            body: formData,
          })
          .then(async function(res) {
            if (!res.ok) {
              if (res.status === 401) {
                window.location.href = '/admin/login';
                return;
              }
              if (res.status === 403) {
                throw new Error('Access Denied: You do not have permission to upload files.');
              }
              const err = await res.json().catch(function() { return {}; });
              throw new Error(err.message || 'Upload failed');
            }
            return res.json();
          })
          .then(function(result) {
            if (els.notifDocumentUrlInput) els.notifDocumentUrlInput.value = result.url;
            if (els.fileLabel) {
              els.fileLabel.textContent = file.name;
              els.fileLabel.classList.add('text-emerald-700', 'font-bold');
            }
            if (els.uploadStatus) {
              els.uploadStatus.textContent = `Uploaded successfully (${Math.round(result.sizeBytes / 1024)} KB)`;
              els.uploadStatus.className = 'text-[10px] text-emerald-600 font-semibold mt-1 block';
            }
            if (els.notifFileNameInput && !els.notifFileNameInput.value) {
              els.notifFileNameInput.value = file.name;
            }
          })
          .catch(function(error) {
            if (els.fileLabel) els.fileLabel.textContent = 'Upload failed';
            if (els.uploadStatus) {
              els.uploadStatus.textContent = `Upload error: ${error.message}`;
              els.uploadStatus.className = 'text-[10px] text-red-650 font-bold mt-1 block';
            }
            if (els.notifDocumentUrlInput) els.notifDocumentUrlInput.value = '';
            e.target.value = '';
          });
        }
      });

      document.addEventListener('astro:page-load', applyFilters);
      applyFilters();
    })();
  </script>

  <style>
    /* Premium style refinements */
    .btn-primary {
      background-color: #0B4F9C;
      color: white;
      font-size: 0.75rem;
