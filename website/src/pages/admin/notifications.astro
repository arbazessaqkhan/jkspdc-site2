---
import AdminLayout from '../../layouts/AdminLayout.astro';
import Icon from '../../components/Icon.astro';
import FileUploader from '../../components/admin/FileUploader.astro';
import { isAdmin } from '../../utils/roles';
import { parseApiError, BACKEND_URL } from '../../utils/api-error';
import { readPageParams, fetchPaged, pageUrl } from '../../utils/pagination';
import PageNav from '../../components/PageNav.astro';

// Check authentication
const sessionToken = Astro.cookies.get('admin_session')?.value;
if (!sessionToken) {
  return Astro.redirect('/admin/login');
}

// Role protection: Notifications management is ADMIN-only
const userRole = Astro.locals.user?.role;
if (!isAdmin(userRole)) {
  return Astro.redirect('/admin/dashboard');
}

const url = new URL(Astro.request.url);
let errorMessage = url.searchParams.get('error') || '';
let successMessage = '';

const successAction = url.searchParams.get('success');
if (successAction === 'create') successMessage = 'Notification published successfully.';
if (successAction === 'update') successMessage = 'Notification updated successfully.';
if (successAction === 'delete') successMessage = 'Notification deleted successfully.';

// Handle CRUD operations
if (Astro.request.method === 'POST') {
  try {
    const formData = await Astro.request.formData();
    const action = formData.get('_action')?.toString();

    if (action === 'create') {
      const title = formData.get('title')?.toString();
      const fileName = formData.get('fileName')?.toString();
      const documentUrl = formData.get('documentUrl')?.toString();
      const fileSizeBytes = formData.get('fileSizeBytes')?.toString();
      const fileFormat = formData.get('fileFormat')?.toString();
      const validTillDate = formData.get('validTillDate')?.toString();
      const status = formData.get('status')?.toString() || 'Active';
      const priority = formData.get('priority')?.toString() || 'Normal';

      if (!title || !fileName || !documentUrl) {
        return Astro.redirect('/admin/notifications?error=' + encodeURIComponent('Title, file name, and attachment are required.'));
      } else {
        const res = await fetch(`${BACKEND_URL}/api/notifications`, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Authorization': `Bearer ${sessionToken}`,
          },
          body: JSON.stringify({
            title,
            fileName,
            documentUrl,
            fileSizeBytes: fileSizeBytes ? parseInt(fileSizeBytes, 10) : undefined,
            fileFormat: fileFormat || undefined,
            validTillDate: validTillDate ? new Date(validTillDate).toISOString() : null,
            status,
            priority,
          }),
        });

        if (res.ok) {
          return Astro.redirect('/admin/notifications?success=create');
        } else {
          const apiErr = await parseApiError(res, 'publish notification');
          if (apiErr.isUnauthorized) {
            return Astro.redirect('/admin/login');
          }
          return Astro.redirect('/admin/notifications?error=' + encodeURIComponent(apiErr.message));
        }
      }
    } else if (action === 'update') {
      const id = formData.get('id')?.toString();
      const title = formData.get('title')?.toString();
      const fileName = formData.get('fileName')?.toString();
      const documentUrl = formData.get('documentUrl')?.toString();
      const fileSizeBytes = formData.get('fileSizeBytes')?.toString();
      const fileFormat = formData.get('fileFormat')?.toString();
      const validTillDate = formData.get('validTillDate')?.toString();
      const status = formData.get('status')?.toString() || 'Active';
      const priority = formData.get('priority')?.toString() || 'Normal';

      if (!id || !title || !fileName || !documentUrl) {
        return Astro.redirect('/admin/notifications?error=' + encodeURIComponent('Title, file name, and attachment are required to update.'));
      } else {
        const res = await fetch(`${BACKEND_URL}/api/notifications/${id}`, {
          method: 'PUT',
          headers: {
            'Content-Type': 'application/json',
            'Authorization': `Bearer ${sessionToken}`,
          },
          body: JSON.stringify({
            title,
            fileName,
            documentUrl,
            fileSizeBytes: fileSizeBytes ? parseInt(fileSizeBytes, 10) : undefined,
            fileFormat: fileFormat || undefined,
            validTillDate: validTillDate ? new Date(validTillDate).toISOString() : null,
            status,
            priority,
          }),
        });

        if (res.ok) {
          return Astro.redirect('/admin/notifications?success=update');
        } else {
          const apiErr = await parseApiError(res, 'update notification');
          if (apiErr.isUnauthorized) {
            return Astro.redirect('/admin/login');
          }
          return Astro.redirect('/admin/notifications?error=' + encodeURIComponent(apiErr.message));
        }
      }
    } else if (action === 'delete') {
      const id = formData.get('id')?.toString();
      if (id) {
        const res = await fetch(`${BACKEND_URL}/api/notifications/${id}`, {
          method: 'DELETE',
          headers: {
            'Authorization': `Bearer ${sessionToken}`,
          },
        });

        if (res.ok) {
          return Astro.redirect('/admin/notifications?success=delete');
        } else {
          const apiErr = await parseApiError(res, 'delete notification');
          if (apiErr.isUnauthorized) {
            return Astro.redirect('/admin/login');
          }
          return Astro.redirect('/admin/notifications?error=' + encodeURIComponent(apiErr.message));
        }
      }
    }
  } catch (e) {
    console.error('Error handling notification action:', e);
    return Astro.redirect('/admin/notifications?error=' + encodeURIComponent('An unexpected error occurred while processing notification. Check backend service status.'));
  }
}

// Fetch Notifications List (server-side search & status filtering)
const searchQuery = Astro.url.searchParams.get('q')?.trim() || '';
const statusFilter = Astro.url.searchParams.get('status')?.trim() || 'All';
const { page, pageSize } = readPageParams(Astro.url);
const pagedExtra: Record<string, string | undefined> = {};
if (searchQuery) pagedExtra.search = searchQuery;
if (statusFilter && statusFilter !== 'All') pagedExtra.status = statusFilter;
let notifications: any[] = [];
let pagedTotal = 0;
let pagedLastPage = 1;
try {
  const state = await fetchPaged('/api/notifications', { BACKEND_URL, page, pageSize, extra: pagedExtra });
  notifications = state.rows;
  pagedTotal = state.total;
  pagedLastPage = state.lastPage;
  if (state.error) errorMessage = errorMessage || state.error;
} catch (e) {
  console.error('Error fetching list:', e);
  errorMessage = 'Network failure: Unable to reach backend server.';
}
const pagedState = { rows: notifications, total: pagedTotal, page, pageSize, lastPage: pagedLastPage, error: null };
---

<AdminLayout title="Notifications" description="Manage Announcements & Notifications" activeTab="notifications">
  <div class="flex flex-col gap-6">
    
    <!-- Standard Admin Page Header -->
    <div class="admin-page-header">
      <div>
        <h1 class="text-lg font-extrabold text-[color:var(--adm-primary)] tracking-tight">Announcements &amp; Notifications</h1>
        <p class="text-xs text-slate-500 mt-0.5">Publish and manage official notifications, circulars, public orders, and recruitment notices.</p>
      </div>
      <button 
        id="btn-add-item"
        class="btn-primary flex items-center gap-1.5 text-xs py-2 px-3.5 self-start md:self-auto cursor-pointer"
      >
        <Icon name="plus" size={13} strokeWidth={2.5} />
        <span>Add Notification</span>
      </button>
    </div>

    <!-- Alerts -->
    {errorMessage && (
      <div class="p-3 bg-red-50 border border-red-200 text-xs font-semibold text-red-700 rounded flex items-center gap-2" role="alert">
        <Icon name="info" size={14} class="text-red-600 shrink-0" /> {errorMessage}
      </div>
    )}
    {successMessage && (
      <div class="p-3 bg-green-50 border border-green-200 text-xs font-semibold text-green-700 rounded flex items-center gap-2" role="alert">
        <Icon name="check" size={14} class="text-green-600 shrink-0" /> {successMessage}
      </div>
    )}

    <!-- Quick Status Filter Tabs (Server-Side) -->
    <div class="flex items-center gap-1.5 border-b border-slate-200 pb-2">
      {[
        { label: 'All', val: 'All' },
        { label: 'Active', val: 'Active' },
        { label: 'Archive', val: 'Archived' },
        { label: 'Draft', val: 'Draft' },
      ].map((t) => {
        const isCurrent = statusFilter === t.val;
        const href = `/admin/notifications?status=${encodeURIComponent(t.val)}${searchQuery ? `&q=${encodeURIComponent(searchQuery)}` : ''}`;
        return (
          <a
            href={href}
            class={`px-3 py-1 rounded text-xs font-bold transition-colors ${isCurrent ? 'bg-[color:var(--adm-primary)] text-white' : 'bg-white text-slate-600 hover:bg-slate-100 border border-slate-200'}`}
          >
            {t.label}
          </a>
        );
      })}
    </div>

    <!-- Filter & Search Toolbar (Server-Side) -->
    <form method="GET" action="/admin/notifications" class="admin-toolbar">
      <input type="hidden" name="status" value={statusFilter} />
      <div class="flex items-center gap-3 flex-wrap flex-1 min-w-0">
        <div class="admin-search-wrapper relative w-full sm:w-72">
          <div class="admin-search-icon">
            <Icon name="search" size={15} strokeWidth={2.2} />
          </div>
          <input 
            type="text" 
            name="q"
            id="search-notif-input" 
            value={searchQuery}
            placeholder="Search notifications..." 
            class="admin-search-input w-full bg-slate-50 border border-slate-300 rounded text-xs text-slate-800 pr-3 py-1.5 focus:ring-1 focus:ring-[color:var(--adm-primary)] focus:border-[color:var(--adm-primary)] outline-none"
          />
        </div>

        <button type="submit" class="px-3 py-1.5 bg-[#0B3D6B] hover:bg-[#082E52] text-white text-xs font-bold rounded cursor-pointer transition-colors">
          Filter
        </button>

        {(searchQuery || statusFilter !== 'All') && (
          <a href="/admin/notifications" class="px-2.5 py-1.5 text-xs font-semibold text-slate-600 hover:text-slate-900 hover:bg-slate-100 rounded transition-colors">
            Reset
          </a>
        )}
      </div>

      <div class="text-xs text-slate-500 font-medium shrink-0">
        Matching Notifications: <span class="font-bold text-slate-800">{pagedTotal}</span>
      </div>
    </form>

    <!-- Administrative Data Table -->
    <div class="admin-table-card">
    <div class="admin-table-container">
      <table class="table-data min-w-full text-left" id="notifications-data-table">
        <thead>
          <tr>
            <th scope="col" class="w-12 text-center">#</th>
            <th scope="col" class="min-w-[280px]">Notification Title &amp; Attachment</th>
            <th scope="col" class="w-36 whitespace-nowrap">Publish Date</th>
            <th scope="col" class="w-24 text-center whitespace-nowrap">Status</th>
            <th scope="col" class="w-24 text-center whitespace-nowrap">Document</th>
            <th scope="col" class="w-24 text-center whitespace-nowrap sticky-col-right">Action</th>
          </tr>
        </thead>
        <tbody id="notifications-table-body">
          {notifications.length === 0 ? (
            <tr id="empty-notif-row">
              <td colspan="6" class="text-center text-slate-500 py-12 text-xs font-semibold italic">
                No notifications published. Click 'Add Notification' to create one.
              </td>
            </tr>
          ) : (
            notifications.map((notif: any, idx: number) => (
              <tr 
                class="notification-row transition-colors"
                data-year={new Date(notif.publishDate).getFullYear()}
                data-status={notif.status || 'Active'}
                data-search={notif.title?.toLowerCase() || ''}
                data-notif={JSON.stringify(notif)}
              >
                <td class="text-center font-bold text-slate-400 text-xs row-index">{(page - 1) * pageSize + idx + 1}</td>
                <td class="font-medium text-slate-900 text-left">
                  <div class="flex flex-col gap-1">
                    <span class="text-xs font-bold text-slate-900 leading-snug">{notif.title}</span>
                    {notif.fileName && (
                      <span class="text-[11px] text-slate-500 font-mono flex items-center gap-1.5">
                        <Icon name="file-text" size={11} class="text-slate-400 shrink-0" />
                        <span>{notif.fileName}</span>
                      </span>
                    )}
                  </div>
                </td>
                <td class="text-slate-600 font-medium whitespace-nowrap text-xs">
                  {new Date(notif.publishDate).toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric' })}
                </td>
                <td class="text-center whitespace-nowrap">
                  <span class={(notif.status === 'Draft') ? 'admin-badge-warning' : (notif.status === 'Archived' || notif.status === 'Archive') ? 'admin-badge-neutral' : 'admin-badge-success'}>
                    {notif.status || 'Active'}
                  </span>
                </td>
                <td class="text-center whitespace-nowrap">
                  {notif.documentUrl ? (
                    <a 
                      href={notif.documentUrl} 
                      target="_blank" 
                      rel="noopener noreferrer" 
                      class="admin-btn-action action-download mx-auto"
                      title={`Download ${notif.fileName || 'document'}`}
                      aria-label={`Download ${notif.fileName || 'document'}`}
                    >
                      <Icon name="download" size={13} />
                    </a>
                  ) : (
                    <span class="text-slate-400 text-xs">—</span>
                  )}
                </td>
                <td class="td-actions sticky-col-right">
                  <div class="admin-action-group">
                    <button 
                      type="button"
                      class="btn-edit admin-btn-action"
                      data-id={notif.id}
                      title={`Edit ${notif.title}`}
                      aria-label={`Edit ${notif.title}`}
                    >
                      <Icon name="pencil" size={13} />
                    </button>
                    <form method="POST" class="inline m-0 p-0" onsubmit="return confirm('Are you sure you want to delete this notification?');">
                      <input type="hidden" name="id" value={notif.id} />
                      <input type="hidden" name="_action" value="delete" />
                      <button 
                        type="submit" 
                        class="admin-btn-action action-delete"
                        title={`Delete ${notif.title}`}
                        aria-label={`Delete ${notif.title}`}
                      >
                        <Icon name="trash-2" size={13} />
                      </button>
                    </form>
                  </div>
                </td>
              </tr>
            ))
          )}
          <tr id="no-matching-notif-row" style="display: none;">
            <td colspan="6" class="text-center text-slate-500 py-12 text-xs font-semibold italic">
              No notifications found matching your filter criteria.
            </td>
          </tr>
        </tbody>
      </table>


    <PageNav state={pagedState} url={(p: number) => pageUrl(Astro.url, p, pageSize, pagedExtra)} />    </div>
    </div>

  </div>

  <!-- Add/Edit Modal (Matching popup in screenshot) -->
  <div id="modal-container" class="fixed inset-0 z-55 flex items-center justify-center p-4 sm:p-6 hidden" role="dialog" aria-modal="true" aria-labelledby="modal-heading">
    <!-- Dim backdrop -->
    <div id="modal-backdrop" class="absolute inset-0 bg-slate-900/60 backdrop-blur-[2px]"></div>
    
    <!-- Modal Card -->
    <div class="bg-white rounded-xl border border-slate-200 shadow-2xl w-full max-w-xl max-h-[90vh] flex flex-col relative z-10 animate-fade-in text-left overflow-hidden">
      <!-- Modal Header (Fixed at top) -->
      <div class="px-6 py-4 border-b border-slate-100 flex items-center justify-between bg-slate-50/90 shrink-0">
        <h3 id="modal-heading" class="text-sm font-bold text-slate-800 uppercase tracking-wider">
          Add Notification
        </h3>
        <button 
          type="button" 
          id="btn-close-modal" 
          class="text-slate-400 hover:text-slate-600 cursor-pointer focus:outline-none p-1 rounded-md transition-colors"
          aria-label="Close modal"
        >
          <Icon name="x" size={18} strokeWidth={2.5} />
        </button>
      </div>

      <!-- Modal Body (Scrollable with max-height) -->
      <form id="notif-form" method="POST" class="overflow-y-auto p-6 space-y-4 flex-1">
        <input type="hidden" name="id" id="notif-id" />
        <input type="hidden" name="_action" id="notif-action" value="create" />

        <div class="form-group flex flex-col gap-1.5">
          <label for="notif-title" class="text-xs font-bold text-slate-700">Title:</label>
          <input 
            type="text" 
            name="title" 
            id="notif-title" 
            required 
            class="form-input text-xs" 
            placeholder="Enter title" 
          />
        </div>

        <div class="form-group flex flex-col gap-1.5">
          <label for="notif-fileName" class="text-xs font-bold text-slate-700">File Name:</label>
          <input 
            type="text" 
            name="fileName" 
            id="notif-fileName" 
            required 
            class="form-input text-xs" 
            placeholder="Enter file name" 
          />
        </div>

        <!-- File Upload Section (Single label via FileUploader) -->
        <div class="form-group flex flex-col gap-1.5">
          <FileUploader
              id="notif-doc"
              label="Upload File"
              required
              variant="document"
              accept=".pdf,.jpg,.jpeg,.png,.doc,.docx,.xls,.xlsx"
              helpText="PDF, JPG, PNG, DOCX, XLSX"
              maxSizeMB={5}
            />
            
            <input type="hidden" name="documentUrl" id="notif-documentUrl" required />
            <input type="hidden" name="fileSizeBytes" id="notif-fileSizeBytes" />
            <input type="hidden" name="fileFormat" id="notif-fileFormat" />
        </div>

        <div class="form-group flex flex-col gap-1.5">
          <label for="notif-validTillDate" class="text-xs font-bold text-slate-700">Valid Till Date: <span class="text-slate-400 font-normal">(Optional)</span></label>
          <input
            type="date"
            name="validTillDate"
            id="notif-validTillDate"
            class="form-input text-xs"
          />
          <span class="text-[10px] text-slate-500">Optional. The notice is removed from the homepage Updates bar after this date if provided.</span>
        </div>

        <div class="form-group flex flex-col gap-1.5">
          <label for="notif-status" class="text-xs font-bold text-slate-700">Status:</label>
          <select name="status" id="notif-status" class="form-input text-xs">
            <option value="Active">Active</option>
            <option value="Draft">Draft</option>
            <option value="Archived">Archive</option>
          </select>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 bg-slate-50 border border-slate-200 rounded-lg p-4">
          <p class="text-[11px] text-slate-600 leading-relaxed">
            This notice is announced in the homepage <span class="font-bold">Updates</span> bar automatically while it is active
            and its valid-till date has not passed. It is never listed twice - the bar always shows what is currently live.
          </p>
          <div class="flex flex-col gap-1">
            <label for="notif-priority" class="text-[11px] font-bold text-slate-700">Priority</label>
            <select name="priority" id="notif-priority" class="form-input text-xs">
              <option value="Normal" selected>Normal</option>
              <option value="Urgent">Urgent (pin to front)</option>
            </select>
            <span class="text-[10px] text-slate-500">Urgent pins this notice to the front of the Updates bar.</span>
          </div>
        </div>

        <!-- Actions (Fixed footer within form) -->
        <div class="flex items-center justify-end gap-3 border-t border-slate-100 pt-4 mt-6">
          <button 
            type="button" 
            id="btn-reset-modal" 
            class="px-4 py-2 bg-slate-550 text-white rounded text-xs font-bold hover:bg-slate-600 transition-colors cursor-pointer"
          >
            Reset
          </button>
          <button 
            type="button" 
            id="btn-draft-modal"
            class="px-4 py-2 bg-amber-600 hover:bg-amber-700 text-white rounded text-xs font-bold transition-colors shadow-xs cursor-pointer"
          >
            Save as Draft
          </button>
          <button 
            type="submit" 
            id="btn-submit-modal"
            class="px-5 py-2 bg-blue-600 text-white rounded text-xs font-bold hover:bg-blue-700 transition-colors shadow-md cursor-pointer"
          >
            Submit
          </button>
        </div>
      </form>
    </div>
  </div>

  <script>
    (function() {
      var currentStatusFilter = 'All';

      // Derive a user-facing file format from an uploaded file name or URL extension
      function detectFileFormat(nameOrUrl) {
        if (!nameOrUrl) return '';
        var clean = String(nameOrUrl).split('?')[0].split('#')[0];
        var base = clean.substring(clean.lastIndexOf('/') + 1);
        var dot = base.lastIndexOf('.');
        if (dot === -1 || dot === base.length - 1) return '';
        return base.substring(dot + 1).toUpperCase();
      }

      // Convert a stored ISO date to the YYYY-MM-DD value required by <input type="date">
      function toDateInputValue(value) {
        if (!value) return '';
        var parsed = new Date(value);
        if (isNaN(parsed.getTime())) return '';
        var month = String(parsed.getMonth() + 1).padStart(2, '0');
        var day = String(parsed.getDate()).padStart(2, '0');
        return parsed.getFullYear() + '-' + month + '-' + day;
      }

      function getElements() {
        return {
          modalContainer: document.getElementById('modal-container'),
          modalBackdrop: document.getElementById('modal-backdrop'),
          btnAdd: document.getElementById('btn-add-item'),
          btnClose: document.getElementById('btn-close-modal'),
          btnReset: document.getElementById('btn-reset-modal'),
          notifForm: document.getElementById('notif-form'),
          fileUploader: document.getElementById('notif-doc-input'),
          fileLabel: document.createElement('span'),
          uploadStatus: document.createElement('span'),
          notifIdInput: document.getElementById('notif-id'),
          notifActionInput: document.getElementById('notif-action'),
          notifTitleInput: document.getElementById('notif-title'),
          notifFileNameInput: document.getElementById('notif-fileName'),
          notifDocumentUrlInput: document.getElementById('notif-documentUrl'),
          notifFileSizeInput: document.getElementById('notif-fileSizeBytes'),
          notifFileFormatInput: document.getElementById('notif-fileFormat'),
          notifValidTillInput: document.getElementById('notif-validTillDate'),
          notifPriorityInput: document.getElementById('notif-priority'),
          notifStatusInput: document.getElementById('notif-status'),
          modalHeading: document.getElementById('modal-heading'),
          btnSubmit: document.getElementById('btn-submit-modal'),
          btnDraft: document.getElementById('btn-draft-modal'),
          yearSelect: document.getElementById('year-select'),
          searchInput: document.getElementById('search-notif-input'),
          visibleCountEl: document.getElementById('visible-notif-count'),
        };
      }

      function applyFilters() {
        var els = getElements();
        var selectedYear = els.yearSelect ? els.yearSelect.value : 'All';
        var searchQuery = els.searchInput ? els.searchInput.value.toLowerCase().trim() : '';
        var rows = document.querySelectorAll('.notification-row');
        var emptyRow = document.getElementById('no-matching-notif-row');

        var visibleCount = 0;
        rows.forEach(function(row) {
          var year = row.getAttribute('data-year') || '';
          var status = row.getAttribute('data-status') || 'Active';
          var searchStr = (row.getAttribute('data-search') || '').toLowerCase();

          var matchesYear = selectedYear === 'All' || year === selectedYear;
          var matchesSearch = !searchQuery || searchStr.includes(searchQuery);
          
          var matchesStatus = true;
          if (currentStatusFilter !== 'All') {
            if (currentStatusFilter === 'Archived' || currentStatusFilter === 'Archive') {
              matchesStatus = (status.toLowerCase() === 'archived' || status.toLowerCase() === 'archive');
            } else {
              matchesStatus = (status.toLowerCase() === currentStatusFilter.toLowerCase());
            }
          }

          if (matchesYear && matchesSearch && matchesStatus) {
            row.style.display = '';
            visibleCount++;
            var idxEl = row.querySelector('.row-index');
            if (idxEl) idxEl.textContent = visibleCount;
          } else {
            row.style.display = 'none';
          }
        });

        if (els.visibleCountEl) {
          els.visibleCountEl.textContent = visibleCount;
        }

        if (emptyRow) {
          emptyRow.style.display = (visibleCount === 0 && rows.length > 0) ? 'table-row' : 'none';
        }
      }

      function showModal(isEdit) {
        var els = getElements();
        if (!els.modalContainer) return;
        els.modalContainer.classList.remove('hidden');
        if (isEdit) {
          if (els.modalHeading) els.modalHeading.textContent = 'Edit Notification';
          if (els.notifActionInput) els.notifActionInput.value = 'update';
          if (els.btnSubmit) els.btnSubmit.textContent = 'Update';
          if (els.btnReset) els.btnReset.style.display = 'none';
        } else {
          if (els.modalHeading) els.modalHeading.textContent = 'Add Notification';
          if (els.notifActionInput) els.notifActionInput.value = 'create';
          if (els.btnSubmit) els.btnSubmit.textContent = 'Submit';
          if (els.notifStatusInput) els.notifStatusInput.value = 'Active';
          if (els.btnReset) {
            els.btnReset.style.display = '';
            els.btnReset.textContent = 'Clear';
          }
          resetForm();
        }
      }

      function hideModal() {
        var els = getElements();
        if (els.modalContainer) els.modalContainer.classList.add('hidden');
      }

      function resetForm() {
        var els = getElements();
        if (els.notifIdInput) els.notifIdInput.value = '';
        if (els.notifTitleInput) els.notifTitleInput.value = '';
        if (els.notifFileNameInput) els.notifFileNameInput.value = '';
        if (els.notifDocumentUrlInput) els.notifDocumentUrlInput.value = '';
        if (els.notifFileSizeInput) els.notifFileSizeInput.value = '';
        if (els.notifFileFormatInput) els.notifFileFormatInput.value = '';
        if (els.notifValidTillInput) els.notifValidTillInput.value = '';
        if (els.notifPriorityInput) els.notifPriorityInput.value = 'Normal';
        if (els.notifStatusInput) els.notifStatusInput.value = 'Active';
        var uploaderZone = document.getElementById('notif-doc-dropzone');
        var uploaderRemove = uploaderZone ? uploaderZone.querySelector('.admin-uploader-file-remove') : null;
        if (uploaderRemove && uploaderZone.classList.contains('has-file')) {
          uploaderRemove.click();
        } else if (els.fileUploader) {
          els.fileUploader.value = '';
          els.fileUploader.dispatchEvent(new CustomEvent('uploader:cleared', { bubbles: true }));
        }
        if (els.fileLabel) {
          els.fileLabel.textContent = 'No file chosen';
          els.fileLabel.classList.remove('text-emerald-700', 'font-bold');
        }
        if (els.uploadStatus) {
          els.uploadStatus.textContent = 'PDF, JPG, PNG, DOCX, XLSX (Max 10MB)';
          els.uploadStatus.className = 'text-[10px] text-slate-400 font-semibold mt-1 block';
        }
      }

      // Delegated clicks
      document.addEventListener('click', function(e) {
        // Status filter tabs
        var statusTab = e.target.closest('.notif-status-tab');
        if (statusTab) {
          e.preventDefault();
          var filterVal = statusTab.getAttribute('data-status') || 'All';
          currentStatusFilter = filterVal;

          document.querySelectorAll('.notif-status-tab').forEach(function(btn) {
            btn.className = 'notif-status-tab px-3 py-1 rounded text-xs font-bold transition-colors bg-white text-slate-600 hover:bg-slate-100 border border-slate-200 cursor-pointer';
          });
          statusTab.className = 'notif-status-tab px-3 py-1 rounded text-xs font-bold transition-colors bg-[color:var(--adm-primary)] text-white cursor-pointer';

          applyFilters();
          return;
        }

        var addBtn = e.target.closest('#btn-add-item');
        if (addBtn) {
          e.preventDefault();
          showModal(false);
          return;
        }

        var editBtn = e.target.closest('.btn-edit');
        if (editBtn) {
          e.preventDefault();
          var row = editBtn.closest('.notification-row');
          if (row) {
            try {
              var notifData = JSON.parse(row.getAttribute('data-notif'));
              var els = getElements();
              if (els.notifIdInput) els.notifIdInput.value = notifData.id || '';
              if (els.notifTitleInput) els.notifTitleInput.value = notifData.title || '';
              if (els.notifFileNameInput) els.notifFileNameInput.value = notifData.fileName || '';
              if (els.notifDocumentUrlInput) els.notifDocumentUrlInput.value = notifData.documentUrl || '';
              if (els.notifFileSizeInput) els.notifFileSizeInput.value = notifData.fileSizeBytes || '';
              if (els.notifFileFormatInput) {
                els.notifFileFormatInput.value = (notifData.fileFormat || '').toUpperCase() || detectFileFormat(notifData.documentUrl || notifData.fileName);
              }
              if (els.notifValidTillInput) els.notifValidTillInput.value = toDateInputValue(notifData.validTillDate);
              if (els.notifPriorityInput) els.notifPriorityInput.value = notifData.priority === 'Urgent' ? 'Urgent' : 'Normal';
              if (els.notifStatusInput) els.notifStatusInput.value = notifData.status || 'Active';

              // Show already uploaded file in the FileUploader dropzone
              var uploaderZone = document.getElementById('notif-doc-dropzone');
              if (uploaderZone && notifData.documentUrl) {
                uploaderZone.classList.add('has-file');
                uploaderZone.classList.remove('is-invalid');
                var displayedName = notifData.fileName || notifData.documentUrl.split('/').pop() || 'Attached File';
                var nameEl = uploaderZone.querySelector('.admin-uploader-file-name');
                if (nameEl) nameEl.textContent = displayedName;
                var sizeEl = uploaderZone.querySelector('.admin-uploader-file-size');
                if (sizeEl) {
                  if (notifData.fileSizeBytes) {
                    var bytes = Number(notifData.fileSizeBytes);
                    sizeEl.textContent = bytes < 1024 * 1024 ? Math.round(bytes / 1024) + ' KB' : (bytes / (1024 * 1024)).toFixed(1) + ' MB';
                  } else {
                    sizeEl.textContent = '';
                  }
                }
              }

              showModal(true);
            } catch (err) {
              console.error(err);
            }
          }
          return;
        }

        // Save as Draft button
        var draftBtn = e.target.closest('#btn-draft-modal');
        if (draftBtn) {
          e.preventDefault();
          var els = getElements();
          if (els.notifStatusInput) els.notifStatusInput.value = 'Draft';
          if (els.notifForm) {
            if (!els.notifTitleInput?.value?.trim()) {
              alert('Please enter a notification title.');
              els.notifTitleInput?.focus();
              return;
            }
            if (!els.notifFileNameInput?.value?.trim()) {
              alert('Please enter a file name.');
              els.notifFileNameInput?.focus();
              return;
            }
            if (!els.notifDocumentUrlInput?.value?.trim()) {
              alert('Please upload a file attachment.');
              return;
            }
            if (!els.notifValidTillInput?.value?.trim()) {
              alert('Please select a Valid Till Date.');
              els.notifValidTillInput?.focus();
              return;
            }
            els.notifForm.submit();
          }
          return;
        }

        var closeBtn = e.target.closest('#btn-close-modal, #modal-backdrop');
        if (closeBtn) {
          e.preventDefault();
          hideModal();
          return;
        }

        var resetBtn = e.target.closest('#btn-reset-modal');
        if (resetBtn) {
          e.preventDefault();
          var els = getElements();
          var hasData = (els.notifTitleInput?.value || '') !== '' ||
            (els.notifFileNameInput?.value || '') !== '' ||
            (els.notifDocumentUrlInput?.value || '') !== '' ||
            (els.notifValidTillInput?.value || '') !== '';
          if (hasData) {
            if (!confirm('Are you sure you want to clear all entered form fields?')) {
              return;
            }
          }
          resetForm();
          return;
        }
      });

      // Filter change listeners
      document.addEventListener('input', function(e) {
        if (e.target && e.target.id === 'search-notif-input') {
          applyFilters();
        }
      });

      document.addEventListener('change', function(e) {
        if (e.target && e.target.id === 'year-select') {
          applyFilters();
        }

        // File upload
        if (e.target && e.target.id === 'notif-doc-input') {
          var file = e.target.files && e.target.files[0];
          if (!file) return;

          var els = getElements();

          if (els.fileLabel) {
            els.fileLabel.textContent = `Uploading ${file.name}...`;
            els.fileLabel.classList.remove('text-emerald-700', 'font-bold');
          }
          if (els.uploadStatus) {
            els.uploadStatus.textContent = 'Uploading to secure asset server...';
            els.uploadStatus.className = 'text-[10px] text-blue-600 font-semibold mt-1 block animate-pulse';
          }

          var formData = new FormData();
          formData.append('file', file);
          formData.append('category', 'notice');

          fetch('/api/admin/upload', {
            method: 'POST',
            body: formData,
          })
          .then(async function(res) {
            if (!res.ok) {
              if (res.status === 401) {
                window.location.href = '/admin/login';
                return;
              }
              if (res.status === 403) {
                throw new Error('Access Denied: You do not have permission to upload files.');
              }
              const err = await res.json().catch(function() { return {}; });
              throw new Error(err.message || 'Upload failed');
            }
            return res.json();
          })
          .then(function(result) {
            if (els.notifDocumentUrlInput) els.notifDocumentUrlInput.value = result.url;
            if (els.notifFileSizeInput) els.notifFileSizeInput.value = result.sizeBytes || '';
            if (els.notifFileFormatInput) els.notifFileFormatInput.value = detectFileFormat(result.originalName || result.url);
            if (els.fileLabel) {
              els.fileLabel.textContent = file.name;
              els.fileLabel.classList.add('text-emerald-700', 'font-bold');
            }
            if (els.uploadStatus) {
              els.uploadStatus.textContent = `Uploaded successfully (${Math.round(result.sizeBytes / 1024)} KB)`;
              els.uploadStatus.className = 'text-[10px] text-emerald-600 font-semibold mt-1 block';
            }
            if (els.notifFileNameInput && !els.notifFileNameInput.value) {
              els.notifFileNameInput.value = file.name;
            }
          })
          .catch(function(error) {
            if (els.fileLabel) els.fileLabel.textContent = 'Upload failed';
            if (els.uploadStatus) {
              els.uploadStatus.textContent = `Upload error: ${error.message}`;
              els.uploadStatus.className = 'text-[10px] text-red-650 font-bold mt-1 block';
            }
            if (els.notifDocumentUrlInput) els.notifDocumentUrlInput.value = '';
            if (els.notifFileSizeInput) els.notifFileSizeInput.value = '';
            if (els.notifFileFormatInput) els.notifFileFormatInput.value = '';
            e.target.value = '';
          });
        }
      });

      document.addEventListener('uploader:cleared', function(e) {
        if (e.target && e.target.id === 'notif-doc-input') {
          var els = getElements();
          if (els.notifDocumentUrlInput) els.notifDocumentUrlInput.value = '';
          if (els.notifFileSizeInput) els.notifFileSizeInput.value = '';
          if (els.notifFileFormatInput) els.notifFileFormatInput.value = '';
        }
      });

      document.addEventListener('astro:page-load', applyFilters);
      applyFilters();
    })();
  </script>

  <style>
    /* Premium style refinements */
    .btn-primary {
      background-color: var(--adm-primary);
      color: white;
      font-size: 0.75rem;
      font-weight: 700;
      padding: 0.5rem 1rem;
      border-radius: 0.5rem;
      transition-property: all;
      box-shadow: 0 4px 6px -1px rgb(0 0 0 / 0.1);
    }
    .btn-primary:hover {
      background-color: var(--adm-primary-dark);
    }
    .form-input {
      border: 1px solid #e2e8f0;
      border-radius: 0.5rem;
      padding: 0.5rem 0.875rem;
      font-size: 0.75rem;
      transition-property: all;
    }
    .form-input:focus {
      border-color: var(--adm-primary);
      outline: 2px solid transparent;
      outline-offset: 2px;
    }
    .form-select {
      border: 1px solid #e2e8f0;
      border-radius: 0.25rem;
      padding: 0.375rem 0.625rem;
      font-size: 0.75rem;
      cursor: pointer;
    }
    .form-select:focus {
      border-color: var(--adm-primary);
      outline: none;
    }
    .btn-edit {
      transition-property: all;
    }
    @keyframes fadeIn {
      from { opacity: 0; transform: scale(0.95); }
      to { opacity: 1; transform: scale(1); }
    }
    .animate-fade-in {
      animation: fadeIn 0.25s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }
  </style>
</AdminLayout>
