---
import AdminLayout from '../../layouts/AdminLayout.astro';
import Icon from '../../components/Icon.astro';
import { isAdmin } from '../../utils/roles';
import { parseApiError, BACKEND_URL } from '../../utils/api-error';

// Check authentication
const sessionToken = Astro.cookies.get('admin_session')?.value;
if (!sessionToken) {
  return Astro.redirect('/admin/login');
}

// Role protection: Board of Directors management is ADMIN-only
const userRole = Astro.locals.user?.role;
if (!isAdmin(userRole)) {
  return Astro.redirect('/admin/dashboard');
}

let errorMessage = '';
let successMessage = '';

// Handle POST actions
if (Astro.request.method === 'POST') {
  try {
    const formData = await Astro.request.formData();
    const action = formData.get('_action')?.toString();

    if (action === 'create' || action === 'update') {
      const id = formData.get('id')?.toString();
      const name = formData.get('name')?.toString();
      const position = formData.get('position')?.toString();
      const role = formData.get('role')?.toString();
      const sNo = formData.get('sNo')?.toString();
      const description = formData.get('description')?.toString();

      if (!name || !position || !role || !sNo) {
        errorMessage = 'Name, Position, Role, and S.No. are required.';
      } else {
        const body = {
          name,
          position,
          role,
          sNo: parseInt(sNo, 10),
          description: description || null,
        };

        let res;
        if (action === 'create') {
          res = await fetch(`${BACKEND_URL}/api/directors`, {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              'Authorization': `Bearer ${sessionToken}`,
            },
            body: JSON.stringify(body),
          });
        } else {
          res = await fetch(`${BACKEND_URL}/api/directors/${id}`, {
            method: 'PUT',
            headers: {
              'Content-Type': 'application/json',
              'Authorization': `Bearer ${sessionToken}`,
            },
            body: JSON.stringify(body),
          });
        }

        if (res.ok) {
          successMessage = `Director successfully ${action === 'create' ? 'added' : 'updated'}.`;
        } else {
          const apiErr = await parseApiError(res, action === 'create' ? 'add director' : 'update director');
          if (apiErr.isUnauthorized) {
            return Astro.redirect('/admin/login');
          }
          errorMessage = apiErr.message;
        }
      }
    } else if (action === 'delete') {
      const id = formData.get('id')?.toString();
      if (id) {
        const res = await fetch(`${BACKEND_URL}/api/directors/${id}`, {
          method: 'DELETE',
          headers: {
            'Authorization': `Bearer ${sessionToken}`,
          },
        });

        if (res.ok) {
          successMessage = 'Director successfully removed.';
        } else {
          const apiErr = await parseApiError(res, 'delete director');
          if (apiErr.isUnauthorized) {
            return Astro.redirect('/admin/login');
          }
          errorMessage = apiErr.message;
        }
      }
    }
  } catch (e) {
    console.error('Error handling director post:', e);
    errorMessage = 'An error occurred while saving the director profile. Check backend service status.';
  }
}

// Fetch list of directors
let directors = [];
try {
  const res = await fetch(`${BACKEND_URL}/api/directors`);
  if (res.ok) {
    directors = await res.json();
    directors.sort((a: any, b: any) => a.sNo - b.sNo);
  } else {
    const apiErr = await parseApiError(res, 'load board of directors');
    if (apiErr.isUnauthorized) {
      return Astro.redirect('/admin/login');
    }
    errorMessage = apiErr.message;
  }
} catch (e) {
  console.error('Error fetching directors:', e);
  errorMessage = 'Failed to load board of directors. Unable to communicate with the server.';
}
---

<AdminLayout title="Board of Directors (BOD)" description="Manage Board of Directors, positions, roles, and serial orders." activeTab="directors">
  <div class="flex flex-col gap-6">
    
    <!-- Standard Admin Page Header -->
    <div class="admin-page-header">
      <div>
        <h1 class="text-lg font-extrabold text-[#0B4F9C] tracking-tight">Board of Directors (BOD)</h1>
        <p class="text-xs text-slate-500 mt-0.5">Manage board members, executive positions, government nominees, and serial ordering.</p>
      </div>
      <button 
        id="open-add-modal" 
        class="btn-primary flex items-center gap-1.5 text-xs py-2 px-3.5 self-start md:self-auto cursor-pointer"
        aria-haspopup="dialog"
      >
        <Icon name="plus" size={13} strokeWidth={2.5} />
        <span>Add Director</span>
      </button>
    </div>

    <!-- Alerts -->
    {errorMessage && (
      <div class="p-3 bg-red-50 border border-red-200 text-xs font-semibold text-red-700 rounded flex items-center gap-2" role="alert">
        <Icon name="info" size={14} class="text-red-600 shrink-0" /> {errorMessage}
      </div>
    )}
    {successMessage && (
      <div class="p-3 bg-green-50 border border-green-200 text-xs font-semibold text-green-700 rounded flex items-center gap-2" role="alert">
        <Icon name="check" size={14} class="text-green-600 shrink-0" /> {successMessage}
      </div>
    )}

    <!-- Administrative Data Table -->
    <div class="admin-table-container">
      <table class="table-data min-w-full text-left">
        <thead>
          <tr>
            <th scope="col" class="w-12 text-center">S.No.</th>
            <th scope="col" class="min-w-[200px]">Director Name</th>
            <th scope="col" class="min-w-[220px]">Position / Designation</th>
            <th scope="col" class="w-36 text-center">Role / Category</th>
            <th scope="col" class="w-24 text-center sticky-col-right">Actions</th>
          </tr>
        </thead>
        <tbody>
          {directors.length === 0 ? (
            <tr>
              <td colspan="5" class="px-6 py-12 text-center text-slate-500 text-xs italic font-semibold">
                No board members found in database. Click "Add Director" to create one.
              </td>
            </tr>
          ) : (
            directors.map((dir: any) => (
              <tr class="transition-colors">
                <td class="text-center text-xs font-bold text-slate-500">{dir.sNo}</td>
                <td>
                  <div class="flex items-center gap-2.5">
                    <div class="w-7 h-7 rounded-full bg-blue-50 border border-blue-200 flex items-center justify-center text-[11px] font-bold text-[#0B4F9C] shrink-0">
                      {dir.name ? dir.name.replace(/Shri\s*|Er\s*|Dr\s*|\(IAS\)/gi, '').trim().charAt(0) : 'D'}
                    </div>
                    <div>
                      <p class="font-bold text-slate-900 text-xs leading-tight">{dir.name}</p>
                      <p class="text-[10px] text-slate-400 mt-0.5">Order: #{dir.sNo}</p>
                    </div>
                  </div>
                </td>
                <td>
                  <span class="font-semibold text-slate-800 text-xs leading-snug block">
                    {dir.position}
                  </span>
                </td>
                <td class="text-center">
                  <span class="admin-badge-info">
                    {dir.role}
                  </span>
                </td>
                <td class="td-actions sticky-col-right">
                  <div class="admin-action-group">
                    <button
                      type="button"
                      class="btn-edit admin-btn-action edit-director-btn cursor-pointer"
                      data-id={dir.id}
                      data-name={dir.name}
                      data-position={dir.position}
                      data-role={dir.role}
                      data-sno={dir.sNo}
                      title={`Edit ${dir.name}`}
                      aria-label={`Edit ${dir.name}`}
                    >
                      <Icon name="pencil" size={13} />
                    </button>
                    <form method="POST" class="inline m-0 p-0" onsubmit="return confirm('Are you sure you want to remove this director?');">
                      <input type="hidden" name="id" value={dir.id} />
                      <input type="hidden" name="_action" value="delete" />
                      <button
                        type="submit"
                        class="admin-btn-action action-delete cursor-pointer"
                        title={`Delete ${dir.name}`}
                        aria-label={`Delete ${dir.name}`}
                      >
                        <Icon name="trash-2" size={13} />
                      </button>
                    </form>
                  </div>
                </td>
              </tr>
            ))
          )}
        </tbody>
      </table>
    </div>

    <!-- Modal for Add / Edit Director -->
    <div id="director-modal" class="fixed inset-0 bg-slate-900/60 backdrop-blur-xs z-50 flex items-center justify-center p-4 hidden">
      <div class="bg-white rounded-xl shadow-2xl border border-slate-200 w-full max-w-lg overflow-hidden animate-fadeInUp">
        <div class="px-6 py-4 border-b border-slate-100 flex items-center justify-between bg-slate-50/80">
          <h3 id="modal-title" class="font-bold text-slate-800 text-sm">Add New Board Director</h3>
          <button type="button" id="close-modal" class="text-slate-400 hover:text-slate-600 p-1 text-base font-bold">
            &times;
          </button>
        </div>
        
        <form method="POST" class="p-6 space-y-4">
          <input type="hidden" name="_action" id="modal-action" value="create" />
          <input type="hidden" name="id" id="modal-id" value="" />

          <div class="grid grid-cols-3 gap-4">
            <div class="col-span-1">
              <label for="sNo" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">
                S.No. <span class="text-red-500">*</span>
              </label>
              <input 
                type="number" 
                name="sNo" 
                id="field-sNo" 
                required 
                min="1" 
                value="1" 
                placeholder="1"
                class="w-full px-3 py-2 text-xs border border-slate-300 rounded-md focus:ring-2 focus:ring-blue-500 focus:outline-none"
              />
            </div>
            <div class="col-span-2">
              <label for="name" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">
                Director Name <span class="text-red-500">*</span>
              </label>
              <input 
                type="text" 
                name="name" 
                id="field-name" 
                required 
                placeholder="e.g. Shri Ashwani Kumar (IAS)" 
                class="w-full px-3 py-2 text-xs border border-slate-300 rounded-md focus:ring-2 focus:ring-blue-500 focus:outline-none"
              />
            </div>
          </div>

          <div>
            <label for="position" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">
              Position / Designation <span class="text-red-500">*</span>
            </label>
            <input 
              type="text" 
              name="position" 
              id="field-position" 
              required 
              placeholder="e.g. Chairman / Executive Director / Managing Director" 
              class="w-full px-3 py-2 text-xs border border-slate-300 rounded-md focus:ring-2 focus:ring-blue-500 focus:outline-none"
            />
          </div>

          <div>
            <label for="role" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">
              Role / Category <span class="text-red-500">*</span>
            </label>
            <input 
              type="text" 
              name="role" 
              id="field-role" 
              required 
              placeholder="e.g. Additional Chief Secretary, Power Development Department" 
              class="w-full px-3 py-2 text-xs border border-slate-300 rounded-md focus:ring-2 focus:ring-blue-500 focus:outline-none"
            />
          </div>


          <div class="pt-4 border-t border-slate-100 flex items-center justify-end gap-2">
            <button 
              type="button" 
              id="cancel-modal" 
              class="px-4 py-2 text-xs font-semibold text-slate-600 hover:bg-slate-100 rounded-md transition-colors"
            >
              Cancel
            </button>
            <button 
              type="submit" 
              class="px-4 py-2 text-xs font-semibold text-white bg-blue-600 hover:bg-blue-700 rounded-md shadow-sm transition-colors"
            >
              Save Director
            </button>
          </div>
        </form>
      </div>
    </div>

  </div>
</AdminLayout>

<script is:inline>
  function initDirectors() {
    var modal = document.getElementById('director-modal');
    var openBtn = document.getElementById('open-add-modal');
    var closeBtn = document.getElementById('close-modal');
    var cancelBtn = document.getElementById('cancel-modal');
    
    var modalTitle = document.getElementById('modal-title');
    var modalAction = document.getElementById('modal-action');
    var modalId = document.getElementById('modal-id');

    var fieldName = document.getElementById('field-name');
    var fieldPosition = document.getElementById('field-position');
    var fieldRole = document.getElementById('field-role');
    var fieldSNo = document.getElementById('field-sNo');

    function showModal(isEdit, data) {
      if (!modal) return;
      if (isEdit && data) {
        modalTitle.textContent = 'Edit Board Director';
        modalAction.value = 'update';
        modalId.value = data.id || '';
        fieldName.value = data.name || '';
        fieldPosition.value = data.position || '';
        fieldRole.value = data.role || '';
        fieldSNo.value = data.sno || 1;
      } else {
        modalTitle.textContent = 'Add New Board Director';
        modalAction.value = 'create';
        modalId.value = '';
        fieldName.value = '';
        fieldPosition.value = '';
        fieldRole.value = '';
        fieldSNo.value = 1;
      }
      modal.classList.remove('hidden');
    }

    function hideModal() {
      if (modal) modal.classList.add('hidden');
    }

    if (openBtn) openBtn.onclick = function() { showModal(false); };
    if (closeBtn) closeBtn.onclick = hideModal;
    if (cancelBtn) cancelBtn.onclick = hideModal;

    document.querySelectorAll('.edit-director-btn').forEach(function(btn) {
      btn.onclick = function() {
        var data = {
          id: btn.dataset.id,
          name: btn.dataset.name,
          position: btn.dataset.position,
          role: btn.dataset.role,
          sno: btn.dataset.sno,
          description: btn.dataset.description
        };
        showModal(true, data);
      };
    });
  }

  document.addEventListener('astro:page-load', initDirectors);
  initDirectors();
</script>
