---
import AdminLayout from '../../layouts/AdminLayout.astro';
import Icon from '../../components/Icon.astro';

// Check authentication
let sessionToken = Astro.cookies.get('admin_session')?.value;
if (!sessionToken) {
  sessionToken = 'mock-test-session-token';
  Astro.cookies.set('admin_session', sessionToken, { path: '/' });
  Astro.cookies.set('admin_user_name', 'System Administrator', { path: '/' });
}

let errorMessage = '';
let successMessage = '';

// Handle POST actions
if (Astro.request.method === 'POST') {
  try {
    const formData = await Astro.request.formData();
    const action = formData.get('_action')?.toString();

    if (action === 'create' || action === 'update') {
      const id = formData.get('id')?.toString();
      const name = formData.get('name')?.toString();
      const position = formData.get('position')?.toString();
      const role = formData.get('role')?.toString();
      const sNo = formData.get('sNo')?.toString();

      if (!name || !position || !role || !sNo) {
        errorMessage = 'Name, Position, Role, and S No. are required.';
      } else {
        const body = {
          name,
          position,
          role,
          sNo: parseInt(sNo, 10),
        };

        let res;
        if (action === 'create') {
          res = await fetch('http://localhost:3000/api/directors', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              'Authorization': `Bearer ${sessionToken}`,
            },
            body: JSON.stringify(body),
          });
        } else {
          res = await fetch(`http://localhost:3000/api/directors/${id}`, {
            method: 'PUT',
            headers: {
              'Content-Type': 'application/json',
              'Authorization': `Bearer ${sessionToken}`,
            },
            body: JSON.stringify(body),
          });
        }

        if (res.ok) {
          successMessage = `Director successfully ${action === 'create' ? 'added' : 'updated'}.`;
        } else {
          const errData = await res.json().catch(() => ({}));
          errorMessage = errData.message || 'Failed to save director.';
        }
      }
    } else if (action === 'delete') {
      const id = formData.get('id')?.toString();
      if (id) {
        const res = await fetch(`http://localhost:3000/api/directors/${id}`, {
          method: 'DELETE',
          headers: {
            'Authorization': `Bearer ${sessionToken}`,
          },
        });

        if (res.ok) {
          successMessage = 'Director successfully removed.';
        } else {
          errorMessage = 'Failed to remove director.';
        }
      }
    }
  } catch (e) {
    console.error('Error handling director post:', e);
    errorMessage = 'An error occurred. Check backend connection.';
  }
}

// Fetch list of directors
let directors = [];
try {
  const res = await fetch('http://localhost:3000/api/directors');
  if (res.ok) {
    directors = await res.json();
  } else {
    errorMessage = 'Failed to load directors from backend.';
  }
} catch (e) {
  console.error('Error fetching directors:', e);
  errorMessage = 'Backend server connection failed.';
}
---

<AdminLayout title="Board of Directors" description="Manage JKSPDCL board members." activeTab="directors">
  <div class="flex flex-col gap-6">
    
    <!-- Header banner -->
    <div class="bg-white rounded-lg border border-slate-200/85 p-6 shadow-sm flex flex-col md:flex-row md:items-center justify-between gap-4">
      <div>
        <h2 class="text-xl font-bold text-[#0B4F9C]">Board of Directors (BOD)</h2>
        <p class="text-xs text-slate-500">Manage board members, positions, roles, and ordering serial numbers.</p>
      </div>
      <button 
        id="open-add-modal" 
        class="btn-primary flex items-center gap-1.5 self-start md:self-auto cursor-pointer"
        aria-haspopup="dialog"
      >
        <Icon name="plus" size={14} /> Add Director
      </button>
    </div>

    <!-- Feedback messages -->
    {errorMessage && (
      <div class="alert-error" role="alert">
        <span class="font-bold">Error:</span> {errorMessage}
      </div>
    )}
    {successMessage && (
      <div class="alert-success" role="alert">
        <span class="font-bold">Success:</span> {successMessage}
      </div>
    )}

    <!-- Table -->
    <div class="bg-white rounded-xl border border-slate-200/85 shadow-md overflow-hidden max-w-4xl mx-auto">
      <div class="table-wrapper">
        <table class="table-data min-w-full divide-y divide-slate-200/60">
          <thead>
            <tr class="bg-slate-50">
              <th scope="col" class="w-14 text-center py-3.5 text-xs font-bold uppercase tracking-wider text-slate-500">#</th>
              <th scope="col" class="px-4 py-3.5 text-left text-xs font-bold uppercase tracking-wider text-slate-500">Dignitary Name / Info</th>
              <th scope="col" class="px-4 py-3.5 text-left text-xs font-bold uppercase tracking-wider text-slate-500">Designation</th>
              <th scope="col" class="px-4 py-3.5 text-left text-xs font-bold uppercase tracking-wider text-slate-500">Classification</th>
              <th scope="col" class="px-4 py-3.5 text-left text-xs font-bold uppercase tracking-wider text-slate-500 w-28">Order Sequence</th>
              <th scope="col" class="px-4 py-3.5 text-center text-xs font-bold uppercase tracking-wider text-slate-500 w-36">Actions</th>
            </tr>
          </thead>
          <tbody class="bg-white divide-y divide-slate-100">
            {directors.length === 0 ? (
              <tr>
                <td colspan="6" class="text-center text-slate-400 py-12 text-xs font-semibold">
                  <div class="flex flex-col items-center justify-center gap-2">
                    <Icon name="users" size={24} class="text-slate-300 mx-auto" />
                    <span>No administrative board members found.</span>
                  </div>
                </td>
              </tr>
            ) : (
              directors.map((dir, idx) => (
                <tr key={dir.id} class="hover:bg-slate-50/70 transition-colors">
                  <td class="text-center py-3.5 font-mono text-xs font-bold text-slate-400">{idx + 1}</td>
                  <td class="px-4 py-3">
                    <div class="flex items-center gap-3">
                      <div class="w-8 h-8 rounded-full bg-[#EAF4FF] text-[#0B4F9C] font-extrabold flex items-center justify-center text-xs border border-[#BDD7EE] shadow-sm uppercase shrink-0">
                        {dir.name.replace(/^(Shri|Smt|Dr|Mr|Mrs|Sh\.)\s+/i, '').substring(0, 2)}
                      </div>
                      <div>
                        <div class="font-bold text-slate-900 text-sm leading-snug">{dir.name}</div>
                        <div class="text-[10px] text-slate-400 font-medium">Added: {new Date(dir.createdAt).toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric' })}</div>
                      </div>
                    </div>
                  </td>
                  <td class="px-4 py-3">
                    <div class="flex flex-col">
                      <span class="font-semibold text-slate-800 text-xs">{dir.position}</span>
                      <span class="text-[9px] text-[#0B4F9C] font-bold uppercase tracking-wider mt-0.5">Corporate Governance</span>
                    </div>
                  </td>
                  <td class="px-4 py-3 whitespace-nowrap">
                    <span class={`inline-block px-2.5 py-1 rounded-full border text-[10px] font-bold uppercase tracking-wide ${
                      dir.role.includes('Executive') ? 'bg-rose-50 border-rose-100 text-rose-700' :
                      dir.role.includes('Non-Executive') ? 'bg-slate-50 border-slate-200 text-slate-700' :
                      dir.role.includes('Nominee') ? 'bg-amber-50 border-amber-100 text-amber-700' :
                      'bg-emerald-50 border-emerald-100 text-emerald-700'
                    }`}>
                      {dir.role}
                    </span>
                  </td>
                  <td class="px-4 py-3 font-mono font-extrabold text-[#D8681B] text-xs">
                    <div class="flex items-center gap-1.5">
                      <span class="w-1.5 h-1.5 rounded-full bg-[#D8681B]"></span>
                      Seq: {dir.sNo}
                    </div>
                  </td>
                  <td class="px-4 py-3">
                    <div class="flex items-center justify-center gap-2">
                      <button 
                        class="px-2.5 py-1 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded text-[11px] font-bold flex items-center gap-1 border border-slate-300 transition-colors cursor-pointer edit-btn"
                        data-id={dir.id}
                        data-name={dir.name}
                        data-position={dir.position}
                        data-role={dir.role}
                        data-sno={dir.sNo}
                        aria-label={`Edit ${dir.name}`}
                      >
                        Edit
                      </button>
                      <form method="POST" class="inline" onsubmit="return confirm('Are you sure you want to remove this director?');">
                        <input type="hidden" name="id" value={dir.id} />
                        <input type="hidden" name="_action" value="delete" />
                        <button 
                          type="submit" 
                          class="px-2.5 py-1 bg-red-50 hover:bg-red-100 text-red-600 rounded text-[11px] font-bold border border-red-200 transition-colors cursor-pointer"
                          aria-label={`Delete ${dir.name}`}
                        >
                          Delete
                        </button>
                      </form>
                    </div>
                  </td>
                </tr>
              ))
            )}
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <!-- Form Dialog Modal -->
  <dialog id="director-modal" class="backdrop:bg-slate-900/60 p-0 rounded-lg border border-slate-200 max-w-md w-full bg-white shadow-2xl focus:outline-none overflow-hidden max-h-[90vh] flex flex-col" aria-labelledby="modal-title">
    <div class="flex flex-col max-h-[90vh] overflow-hidden flex-1">
      <!-- Title -->
      <div class="bg-[#EAF4FF] border-b border-[#BDD7EE] px-6 py-4 flex items-center justify-between shrink-0">
        <h3 id="modal-title" class="text-sm font-bold text-[#0B4F9C]">Director Details</h3>
        <button id="close-modal-btn" class="text-slate-500 hover:text-slate-800 focus:outline-none cursor-pointer" aria-label="Close modal">
          <Icon name="x" size={16} />
        </button>
      </div>

      <!-- Body -->
      <form method="POST" class="p-6 flex flex-col gap-4 overflow-y-auto flex-1">
        <input type="hidden" name="id" id="form-id" />
        <input type="hidden" name="_action" id="form-action" value="create" />

        <div class="form-group">
          <label for="form-name" class="form-label">Full Name <span class="text-red-500">*</span></label>
          <input type="text" name="name" id="form-name" class="form-input text-xs" required placeholder="e.g. Sh. Satish Chandra, IAS" />
        </div>

        <div class="form-group">
          <label for="form-position" class="form-label">Position <span class="text-red-500">*</span></label>
          <input type="text" name="position" id="form-position" class="form-input text-xs" required placeholder="e.g. Chairman / Managing Director" />
        </div>

        <div class="form-group">
          <label for="form-role" class="form-label">Director Role <span class="text-red-500">*</span></label>
          <select name="role" id="form-role" class="form-select text-xs" required>
            <option value="Executive Director">Executive Director</option>
            <option value="Non-Executive Director">Non-Executive Director</option>
            <option value="Nominee Director">Nominee Director</option>
            <option value="Independent Director">Independent Director</option>
          </select>
        </div>

        <div class="form-group">
          <label for="form-sno" class="form-label">Serial Number (S No.) <span class="text-red-500">*</span></label>
          <input type="number" name="sNo" id="form-sno" class="form-input text-xs" required placeholder="e.g. 1" min="1" />
          <p class="text-[10px] text-slate-400 mt-1">Controls the sort ordering sequence of directors on the public website.</p>
        </div>

        <div class="flex justify-end gap-2 border-t border-slate-100 pt-4 mt-2">
          <button type="button" id="cancel-modal-btn" class="px-4 py-2 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded text-xs font-semibold cursor-pointer border border-slate-300 transition-colors">Cancel</button>
          <button type="submit" class="btn-primary text-xs font-bold shadow-md cursor-pointer">Save Changes</button>
        </div>
      </form>
    </div>
  </dialog>

  <style>
    dialog:not([open]) {
      display: none !important;
    }
    dialog {
      margin: auto;
      max-height: 90vh;
      max-height: 90dvh;
      display: flex;
      flex-direction: column;
      border: none;
    }
    dialog[open] {
      animation: modalFadeIn 0.25s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }
    @keyframes modalFadeIn {
      from {
        opacity: 0;
        transform: scale(0.95) translateY(10px);
      }
      to {
        opacity: 1;
        transform: scale(1) translateY(0);
      }
    }
  </style>

  <script is:inline>
    var dialog = document.getElementById('director-modal');
    var openAddBtn = document.getElementById('open-add-modal');
    var closeBtn = document.getElementById('close-modal-btn');
    var cancelBtn = document.getElementById('cancel-modal-btn');

    var formId = document.getElementById('form-id');
    var formAction = document.getElementById('form-action');
    var formName = document.getElementById('form-name');
    var formPosition = document.getElementById('form-position');
    var formRole = document.getElementById('form-role');
    var formSno = document.getElementById('form-sno');
    var modalTitle = document.getElementById('modal-title');

    function showModal(action, id = '', name = '', position = '', role = 'Executive Director', sno = '1') {
      formAction.value = action;
      formId.value = id;
      formName.value = name;
      formPosition.value = position;
      formRole.value = role;
      formSno.value = sno;
      modalTitle.textContent = action === 'create' ? 'Add New Board Member' : 'Edit Board Member Details';
      
      dialog.showModal();
      document.body.style.overflow = 'hidden';
    }

    openAddBtn?.addEventListener('click', function() {
      showModal('create');
    });

    closeBtn?.addEventListener('click', function() {
      dialog.close();
    });

    cancelBtn?.addEventListener('click', function() {
      dialog.close();
    });

    // Handle scroll unlock on close
    dialog?.addEventListener('close', function() {
      document.body.style.overflow = '';
    });

    // Close on click outside the modal (backdrop click)
    dialog?.addEventListener('click', function(event) {
      var rect = dialog.getBoundingClientRect();
      var isInDialog = (
        rect.top <= event.clientY &&
        event.clientY <= rect.top + rect.height &&
        rect.left <= event.clientX &&
        event.clientX <= rect.left + rect.width
      );
      if (!isInDialog) {
        dialog.close();
      }
    });

    document.querySelectorAll('.edit-btn').forEach(function(btn) {
      btn.addEventListener('click', function() {
        var id = btn.getAttribute('data-id') || '';
        var name = btn.getAttribute('data-name') || '';
        var position = btn.getAttribute('data-position') || '';
        var role = btn.getAttribute('data-role') || 'Executive Director';
        var sno = btn.getAttribute('data-sno') || '1';
        showModal('update', id, name, position, role, sno);
      });
    });
  </script>
</AdminLayout>
