---
import AdminLayout from '../../layouts/AdminLayout.astro';
import Icon from '../../components/Icon.astro';

// Check authentication
let sessionToken = Astro.cookies.get('admin_session')?.value;
if (!sessionToken) {
  sessionToken = 'mock-test-session-token';
  Astro.cookies.set('admin_session', sessionToken, { path: '/' });
  Astro.cookies.set('admin_user_name', 'System Administrator', { path: '/' });
}

let errorMessage = '';
let successMessage = '';

// Handle POST actions
if (Astro.request.method === 'POST') {
  try {
    const formData = await Astro.request.formData();
    const action = formData.get('_action')?.toString();

    if (action === 'create' || action === 'update') {
      const id = formData.get('id')?.toString();
      const name = formData.get('name')?.toString();
      const position = formData.get('position')?.toString();
      const role = formData.get('role')?.toString();
      const sNo = formData.get('sNo')?.toString();
      const description = formData.get('description')?.toString();

      if (!name || !position || !role || !sNo) {
        errorMessage = 'Name, Position, Role, and S.No. are required.';
      } else {
        const body = {
          name,
          position,
          role,
          sNo: parseInt(sNo, 10),
          description: description || null,
        };

        let res;
        if (action === 'create') {
          res = await fetch('http://localhost:3000/api/directors', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              'Authorization': `Bearer ${sessionToken}`,
            },
            body: JSON.stringify(body),
          });
        } else {
          res = await fetch(`http://localhost:3000/api/directors/${id}`, {
            method: 'PUT',
            headers: {
              'Content-Type': 'application/json',
              'Authorization': `Bearer ${sessionToken}`,
            },
            body: JSON.stringify(body),
          });
        }

        if (res.ok) {
          successMessage = `Director successfully ${action === 'create' ? 'added' : 'updated'}.`;
        } else {
          const errData = await res.json().catch(() => ({}));
          errorMessage = errData.message || 'Failed to save director.';
        }
      }
    } else if (action === 'delete') {
      const id = formData.get('id')?.toString();
      if (id) {
        const res = await fetch(`http://localhost:3000/api/directors/${id}`, {
          method: 'DELETE',
          headers: {
            'Authorization': `Bearer ${sessionToken}`,
          },
        });

        if (res.ok) {
          successMessage = 'Director successfully removed.';
        } else {
          errorMessage = 'Failed to remove director.';
        }
      }
    }
  } catch (e) {
    console.error('Error handling director post:', e);
    errorMessage = 'An error occurred. Check backend connection.';
  }
}

// Fetch list of directors
let directors = [];
try {
  const res = await fetch('http://localhost:3000/api/directors');
  if (res.ok) {
    directors = await res.json();
    directors.sort((a: any, b: any) => a.sNo - b.sNo);
  } else {
    errorMessage = 'Failed to load board of directors from backend.';
  }
} catch (e) {
  console.error('Error fetching directors:', e);
  errorMessage = 'Backend server connection failed.';
}
---

<AdminLayout title="Board of Directors (BOD)" description="Manage Board of Directors, positions, roles, and serial orders." activeTab="directors">
  <div class="flex flex-col gap-6">
    
    <!-- Header banner -->
    <div class="bg-white rounded-lg border border-slate-200/85 p-6 shadow-sm flex flex-col md:flex-row md:items-center justify-between gap-4">
      <div>
        <h2 class="text-xl font-bold text-[#0B4F9C]">Board of Directors (BOD)</h2>
        <p class="text-xs text-slate-500">Manage individuals, positions, roles, and serial numbers (S.No. for ordering).</p>
      </div>
      <button 
        id="open-add-modal" 
        class="btn-primary flex items-center gap-1.5 self-start md:self-auto cursor-pointer"
        aria-haspopup="dialog"
      >
        <Icon name="plus" size={14} /> Add Director
      </button>
    </div>

    <!-- Feedback messages -->
    {errorMessage && (
      <div class="alert-error" role="alert">
        <span class="font-bold">Error:</span> {errorMessage}
      </div>
    )}
    {successMessage && (
      <div class="alert-success" role="alert">
        <span class="font-bold">Success:</span> {successMessage}
      </div>
    )}

    <!-- Table -->
    <div class="bg-white rounded-xl border border-slate-200/85 shadow-md overflow-hidden max-w-5xl mx-auto w-full">
      <div class="table-wrapper">
        <table class="table-data min-w-full divide-y divide-slate-200/60">
          <thead>
            <tr class="bg-slate-50">
              <th scope="col" class="w-16 text-center py-3.5 text-xs font-bold uppercase tracking-wider text-slate-500">S.No.</th>
              <th scope="col" class="px-4 py-3.5 text-left text-xs font-bold uppercase tracking-wider text-slate-500">Director Name</th>
              <th scope="col" class="px-4 py-3.5 text-left text-xs font-bold uppercase tracking-wider text-slate-500">Position / Designation</th>
              <th scope="col" class="px-4 py-3.5 text-left text-xs font-bold uppercase tracking-wider text-slate-500">Role / Category</th>
              <th scope="col" class="px-4 py-3.5 text-center text-xs font-bold uppercase tracking-wider text-slate-500 w-36">Actions</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100 bg-white">
            {directors.length === 0 ? (
              <tr>
                <td colspan="5" class="px-6 py-12 text-center text-slate-400 text-xs italic">
                  No board members found in database. Click "Add Director" to create one.
                </td>
              </tr>
            ) : (
              directors.map((dir: any) => (
                <tr class="hover:bg-slate-50/80 transition-colors">
                  <td class="py-4 text-center text-xs font-bold text-slate-700 bg-slate-50/50">{dir.sNo}</td>
                  <td class="px-4 py-4">
                    <div class="flex items-center gap-3">
                      <div class="w-8 h-8 rounded-full bg-blue-50 border border-blue-200 flex items-center justify-center text-xs font-extrabold text-[#0B4F9C] shrink-0">
                        {dir.name ? dir.name.replace(/Shri\s*|Er\s*|Dr\s*|\(IAS\)/gi, '').trim().charAt(0) : 'D'}
                      </div>
                      <div>
                        <p class="font-bold text-slate-800 text-xs">{dir.name}</p>
                        <p class="text-[10px] text-slate-400 mt-0.5">S.No: {dir.sNo}</p>
                      </div>
                    </div>
                  </td>
                  <td class="px-4 py-4">
                    <span class="inline-block px-2.5 py-1 text-xs font-semibold text-slate-800 bg-slate-100 rounded border border-slate-200">
                      {dir.position}
                    </span>
                  </td>
                  <td class="px-4 py-4">
                    <span class="inline-block px-2.5 py-1 text-[11px] font-bold text-[#0B4F9C] bg-blue-50 rounded-full border border-blue-200">
                      {dir.role}
                    </span>
                  </td>
                  <td class="px-4 py-4 text-center">
                    <div class="flex items-center justify-center gap-2">
                      <button
                        type="button"
                        class="btn-edit cursor-pointer edit-director-btn px-2.5 py-1 text-xs font-semibold text-slate-700 bg-slate-100 hover:bg-slate-200 rounded border border-slate-300"
                        data-id={dir.id}
                        data-name={dir.name}
                        data-position={dir.position}
                        data-role={dir.role}
                        data-sno={dir.sNo}
                        data-description={dir.description || ''}
                      >
                        Edit
                      </button>
                      <form method="POST" class="inline-block" onsubmit="return confirm('Are you sure you want to delete this director?');">
                        <input type="hidden" name="_action" value="delete" />
                        <input type="hidden" name="id" value={dir.id} />
                        <button
                          type="submit"
                          class="btn-delete cursor-pointer px-2.5 py-1 text-xs font-semibold text-red-600 bg-red-50 hover:bg-red-100 rounded border border-red-200"
                        >
                          Delete
                        </button>
                      </form>
                    </div>
                  </td>
                </tr>
              ))
            )}
          </tbody>
        </table>
      </div>
    </div>

    <!-- Modal for Add / Edit Director -->
    <div id="director-modal" class="fixed inset-0 bg-slate-900/60 backdrop-blur-xs z-50 flex items-center justify-center p-4 hidden">
      <div class="bg-white rounded-xl shadow-2xl border border-slate-200 w-full max-w-lg overflow-hidden animate-fadeInUp">
        <div class="px-6 py-4 border-b border-slate-100 flex items-center justify-between bg-slate-50/80">
          <h3 id="modal-title" class="font-bold text-slate-800 text-sm">Add New Board Director</h3>
          <button type="button" id="close-modal" class="text-slate-400 hover:text-slate-600 p-1 text-base font-bold">
            &times;
          </button>
        </div>
        
        <form method="POST" class="p-6 space-y-4">
          <input type="hidden" name="_action" id="modal-action" value="create" />
          <input type="hidden" name="id" id="modal-id" value="" />

          <div class="grid grid-cols-3 gap-4">
            <div class="col-span-1">
              <label for="sNo" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">
                S.No. <span class="text-red-500">*</span>
              </label>
              <input 
                type="number" 
                name="sNo" 
                id="field-sNo" 
                required 
                min="1" 
                value="1" 
                placeholder="1"
                class="w-full px-3 py-2 text-xs border border-slate-300 rounded-md focus:ring-2 focus:ring-blue-500 focus:outline-none"
              />
            </div>
            <div class="col-span-2">
              <label for="name" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">
                Director Name <span class="text-red-500">*</span>
              </label>
              <input 
                type="text" 
                name="name" 
                id="field-name" 
                required 
                placeholder="e.g. Shri Ashwani Kumar (IAS)" 
                class="w-full px-3 py-2 text-xs border border-slate-300 rounded-md focus:ring-2 focus:ring-blue-500 focus:outline-none"
              />
            </div>
          </div>

          <div>
            <label for="position" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">
              Position / Designation <span class="text-red-500">*</span>
            </label>
            <input 
              type="text" 
              name="position" 
              id="field-position" 
              required 
              placeholder="e.g. Chairman / Executive Director / Managing Director" 
              class="w-full px-3 py-2 text-xs border border-slate-300 rounded-md focus:ring-2 focus:ring-blue-500 focus:outline-none"
            />
          </div>

          <div>
            <label for="role" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">
              Role / Category <span class="text-red-500">*</span>
            </label>
            <input 
              type="text" 
              name="role" 
              id="field-role" 
              required 
              placeholder="e.g. Additional Chief Secretary, Power Development Department" 
              class="w-full px-3 py-2 text-xs border border-slate-300 rounded-md focus:ring-2 focus:ring-blue-500 focus:outline-none"
            />
          </div>

          <div>
            <label for="description" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">
              Additional Details (Optional)
            </label>
            <textarea 
              name="description" 
              id="field-description" 
              rows="2" 
              placeholder="Optional notes or background information..." 
              class="w-full px-3 py-2 text-xs border border-slate-300 rounded-md focus:ring-2 focus:ring-blue-500 focus:outline-none"
            ></textarea>
          </div>

          <div class="pt-4 border-t border-slate-100 flex items-center justify-end gap-2">
            <button 
              type="button" 
              id="cancel-modal" 
              class="px-4 py-2 text-xs font-semibold text-slate-600 hover:bg-slate-100 rounded-md transition-colors"
            >
              Cancel
            </button>
            <button 
              type="submit" 
              class="px-4 py-2 text-xs font-semibold text-white bg-blue-600 hover:bg-blue-700 rounded-md shadow-sm transition-colors"
            >
              Save Director
            </button>
          </div>
        </form>
      </div>
    </div>

  </div>
</AdminLayout>

<script is:inline>
  (function() {
    var modal = document.getElementById('director-modal');
    var openBtn = document.getElementById('open-add-modal');
    var closeBtn = document.getElementById('close-modal');
    var cancelBtn = document.getElementById('cancel-modal');
    
    var modalTitle = document.getElementById('modal-title');
    var modalAction = document.getElementById('modal-action');
    var modalId = document.getElementById('modal-id');

    var fieldName = document.getElementById('field-name');
    var fieldPosition = document.getElementById('field-position');
    var fieldRole = document.getElementById('field-role');
    var fieldSNo = document.getElementById('field-sNo');
    var fieldDescription = document.getElementById('field-description');

    function showModal(isEdit, data) {
      if (!modal) return;
      if (isEdit && data) {
        modalTitle.textContent = 'Edit Board Director';
        modalAction.value = 'update';
        modalId.value = data.id || '';
        fieldName.value = data.name || '';
        fieldPosition.value = data.position || '';
        fieldRole.value = data.role || '';
        fieldSNo.value = data.sno || 1;
        fieldDescription.value = data.description || '';
      } else {
        modalTitle.textContent = 'Add New Board Director';
        modalAction.value = 'create';
        modalId.value = '';
        fieldName.value = '';
        fieldPosition.value = '';
        fieldRole.value = '';
        fieldSNo.value = 1;
        fieldDescription.value = '';
      }
      modal.classList.remove('hidden');
    }

    function hideModal() {
      if (modal) modal.classList.add('hidden');
    }

    if (openBtn) openBtn.addEventListener('click', function() { showModal(false); });
    if (closeBtn) closeBtn.addEventListener('click', hideModal);
    if (cancelBtn) cancelBtn.addEventListener('click', hideModal);

    document.querySelectorAll('.edit-director-btn').forEach(function(btn) {
      btn.addEventListener('click', function() {
        var data = {
          id: btn.dataset.id,
          name: btn.dataset.name,
          position: btn.dataset.position,
          role: btn.dataset.role,
          sno: btn.dataset.sno,
          description: btn.dataset.description
        };
        showModal(true, data);
      });
    });
  })();
</script>
