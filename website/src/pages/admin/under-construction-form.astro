---
import AdminLayout from '../../layouts/AdminLayout.astro';
import Icon from '../../components/Icon.astro';
import FileUploader from '../../components/admin/FileUploader.astro';
import { isAdmin } from '../../utils/roles';
import { parseApiError, BACKEND_URL } from '../../utils/api-error';

// Check authentication
const sessionToken = Astro.cookies.get('admin_session')?.value;
if (!sessionToken) {
  return Astro.redirect('/admin/login');
}

// Role protection: Projects mutation is ADMIN-only
const userRole = Astro.locals.user?.role;
if (!isAdmin(userRole)) {
  return Astro.redirect('/admin/under-construction');
}

let errorMessage = '';
let successMessage = '';

// Check if we are in Edit Mode
const editId = Astro.url.searchParams.get('id')?.toString();
let projectData = {
  id: '',
  name: '',
  type: 'Hydroelectric',
  configuration: '',
  designEnergy: '',
  commissionedDate: '',
  capacityMw: '',
  description: '',
  salientFeatures: '',
  sector: 'State',
  basin: 'Chenab',
  location: 'J&K Region',
  status: 'Under Construction',
  documentUrl: '',
};

if (editId) {
  try {
    const res = await fetch(`${BACKEND_URL}/api/projects/${editId}`);
    if (res.ok) {
      const data = await res.json();
      projectData = {
        id: data.id || '',
        name: data.name || '',
        type: data.type || 'Hydroelectric',
        configuration: data.configuration || '',
        designEnergy: data.designEnergy !== null && data.designEnergy !== undefined ? data.designEnergy.toString() : '',
        commissionedDate: data.commissionedDate ? new Date(data.commissionedDate).toISOString().split('T')[0] : '',
        capacityMw: data.capacityMw !== null && data.capacityMw !== undefined ? data.capacityMw.toString() : '',
        description: data.description || '',
        salientFeatures: data.salientFeatures || '',
        sector: data.sector || 'State',
        basin: data.basin || 'Chenab',
        location: data.location || 'J&K Region',
        status: data.status || 'Under Construction',
        documentUrl: data.documentUrl || '',
      };
    } else {
      const apiErr = await parseApiError(res, 'load project details for editing');
      if (apiErr.isUnauthorized) {
        return Astro.redirect('/admin/login');
      }
      errorMessage = apiErr.message;
    }
  } catch (e) {
    console.error('Error fetching project for edit:', e);
    errorMessage = 'Network failure: Unable to connect to the backend server.';
  }
}

function getProjectPhotoPreviewUrl(name: string, docUrl?: string | null): string {
  if (docUrl && docUrl.trim() !== '') {
    if (BACKEND_URL && docUrl.startsWith(`${BACKEND_URL}/uploads/`)) return docUrl;
    if (docUrl.startsWith('/uploads/')) return `${BACKEND_URL}${docUrl}`;
    return docUrl;
  }
  if (!name) return '';
  const slug = name.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
  if (slug === 'ganderbal' || slug === 'ushp-i' || slug === 'sewa-iii') {
    return `/projects/${slug}.png`;
  }
  if (['bhaderwah', 'bhep-i', 'bhep-ii', 'chep-i', 'chep-ii', 'chep-iii', 'karnah', 'ljhp', 'mhep-pahalgam', 'ushp-ii', 'ushp-ll'].includes(slug)) {
    return `/projects/${slug}.jpg`;
  }
  return '';
}

const existingPhotoUrl = getProjectPhotoPreviewUrl(projectData.name, projectData.documentUrl);

// Handle Form Submission
if (Astro.request.method === 'POST') {
  try {
    const formData = await Astro.request.formData();
    const id = formData.get('id')?.toString();
    const name = formData.get('name')?.toString();
    const type = formData.get('type')?.toString() || 'Hydroelectric';
    const configuration = formData.get('configuration')?.toString();
    const designEnergy = formData.get('designEnergy')?.toString();
    const commissionedDate = formData.get('commissionedDate')?.toString();
    const capacityMw = formData.get('capacityMw')?.toString();
    const description = formData.get('description')?.toString();
    const salientFeatures = formData.get('salientFeatures')?.toString();
    const sector = formData.get('sector')?.toString();
    const basin = formData.get('basin')?.toString();
    const location = formData.get('location')?.toString() || 'J&K Region';
    const documentUrl = formData.get('documentUrl')?.toString();

    // Preserve entered values if validation fails
    projectData = {
      id: id || '',
      name: name || '',
      type,
      configuration: configuration || '',
      designEnergy: designEnergy || '',
      commissionedDate: commissionedDate || '',
      capacityMw: capacityMw || '',
      description: description || '',
      salientFeatures: salientFeatures || '',
      sector: sector || 'State',
      basin: basin || 'Chenab',
      location,
      status: 'Under Construction',
      documentUrl: documentUrl || '',
    };

    if (!name || !capacityMw) {
      errorMessage = 'Project Name and Capacity are required fields.';
    } else {
      const body = {
        name,
        type,
        capacityMw: parseFloat(capacityMw),
        status: 'Under Construction',
        location,
        configuration: configuration || null,
        designEnergy: designEnergy ? parseFloat(designEnergy) : null,
        commissionedDate: commissionedDate ? new Date(commissionedDate).toISOString() : null,
        sector: sector || 'State',
        basin: basin || 'Chenab',
        description: description || null,
        salientFeatures: salientFeatures || null,
        documentUrl: (documentUrl && BACKEND_URL && documentUrl.startsWith(`${BACKEND_URL}/uploads/`))
          ? documentUrl.replace(BACKEND_URL, '')
          : (documentUrl || null),
      };

      let apiRes;
      if (id) {
        apiRes = await fetch(`${BACKEND_URL}/api/projects/${id}`, {
          method: 'PUT',
          headers: {
            'Content-Type': 'application/json',
            'Authorization': `Bearer ${sessionToken}`,
          },
          body: JSON.stringify(body),
        });
      } else {
        apiRes = await fetch(`${BACKEND_URL}/api/projects`, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Authorization': `Bearer ${sessionToken}`,
          },
          body: JSON.stringify(body),
        });
      }

      if (apiRes.ok) {
        return Astro.redirect('/admin/under-construction?success=' + encodeURIComponent(`Project "${name}" saved successfully.`));
      } else {
        const apiErr = await parseApiError(apiRes, id ? 'update construction project' : 'create construction project');
        if (apiErr.isUnauthorized) {
          return Astro.redirect('/admin/login');
        }
        errorMessage = apiErr.message;
      }
    }
  } catch (e) {
    console.error('Error saving project:', e);
    errorMessage = 'Network failure: Unable to communicate with the backend server.';
  }
}
---

<AdminLayout title={editId ? "Edit Project Under Construction" : "Add Project Under Construction"} description="Create or update JKSPDCL projects under construction." activeTab="construction">
  <div class="flex flex-col gap-6 max-w-4xl mx-auto w-full">
    <!-- Header -->
    <div class="flex items-center justify-between">
      <div>
        <h1 class="text-xl font-extrabold text-[color:var(--adm-primary)] tracking-tight">
          {editId ? 'Edit Project Under Construction' : 'Add Project Under Construction'}
        </h1>
        <p class="text-xs text-slate-500 mt-1">
          Enter project specifications, construction milestones, and technical parameters.
        </p>
      </div>
      <a href="/admin/under-construction" class="admin-btn admin-btn-secondary text-xs">
        &larr; Back to Projects
      </a>
    </div>

    <!-- Feedback alerts -->
    {errorMessage && (
      <div class="alert-error" role="alert">
        <span class="font-bold">Error:</span> {errorMessage}
      </div>
    )}

    <!-- Form container -->
    <form method="POST" class="bg-white rounded-lg border border-slate-200 shadow-sm p-6 lg:p-8 flex flex-col gap-6">
      <input type="hidden" name="id" value={projectData.id} />

      <!-- Section: General Details -->
      <div>
        <h3 class="text-xs font-bold text-[color:var(--adm-primary)] uppercase tracking-wider border-b border-slate-100 pb-2 mb-4">
          General Specifications
        </h3>
        
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div class="form-group">
            <label for="name" class="form-label">Name of Project <span class="text-red-500">*</span></label>
            <input type="text" name="name" id="name" value={projectData.name} class="form-input text-xs" required placeholder="e.g. Parnai Hydroelectric Project" />
          </div>

          <div class="form-group">
            <label for="type" class="form-label">Type / Scheme</label>
            <input type="text" name="type" id="type" value={projectData.type} class="form-input text-xs" placeholder="e.g. Run-of-River, Storage" />
          </div>

          <div class="form-group">
            <label for="capacityMw" class="form-label">Installed Capacity in MW <span class="text-red-500">*</span></label>
            <input type="number" step="0.01" name="capacityMw" id="capacityMw" value={projectData.capacityMw} class="form-input text-xs" required placeholder="e.g. 37.50" />
          </div>

          <div class="form-group">
            <label for="configuration" class="form-label">Configuration (Units)</label>
            <input type="text" name="configuration" id="configuration" value={projectData.configuration} class="form-input text-xs" placeholder="e.g. 3x12.5 MW" />
          </div>

          <div class="form-group">
            <label for="designEnergy" class="form-label">Estimated Design Energy (MU)</label>
            <input type="number" step="0.01" name="designEnergy" id="designEnergy" value={projectData.designEnergy} class="form-input text-xs" placeholder="e.g. 144.50" />
          </div>

          <div class="form-group">
            <label for="commissionedDate" class="form-label">Targeted COD / Date</label>
            <input type="date" name="commissionedDate" id="commissionedDate" value={projectData.commissionedDate} class="form-input text-xs" />
          </div>

          <div class="form-group">
            <label for="sector" class="form-label">Ownership Sector</label>
            <select name="sector" id="sector" class="form-select text-xs">
              <option value="State" selected={projectData.sector === 'State'}>State Sector</option>
              <option value="JV" selected={projectData.sector === 'JV'}>Joint Venture (JV)</option>
            </select>
          </div>

          <div class="form-group">
            <label for="basin" class="form-label">River Basin</label>
            <select name="basin" id="basin" class="form-select text-xs">
              <option value="Chenab" selected={projectData.basin === 'Chenab'}>Chenab Basin</option>
              <option value="Jhelum" selected={projectData.basin === 'Jhelum'}>Jhelum Basin</option>
              <option value="Ravi" selected={projectData.basin === 'Ravi'}>Ravi Basin</option>
              <option value="Indus" selected={projectData.basin === 'Indus'}>Indus Basin</option>
            </select>
          </div>

          <div class="form-group">
            <label for="location" class="form-label">District / Location</label>
            <input type="text" name="location" id="location" value={projectData.location} class="form-input text-xs" placeholder="e.g. Poonch District, UT of J&K" />
          </div>

          <!-- Project Photograph Upload with Preview & Red X -->
          <div class="form-group col-span-1 md:col-span-2">
            <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-2">
              Project Photograph (Image Upload &amp; Preview)
            </label>
            <div class="p-4 bg-slate-50 border border-slate-200 rounded-xl">
              <FileUploader
                id="project-image"
                label="Project Photograph"
                variant="image"
                accept="image/jpeg,image/png,image/webp,image/gif"
                helpText="Supported formats: JPG, PNG, WEBP. Max size: 10 MB."
                maxSizeMB={10}
                existingUrl={existingPhotoUrl}
              />
              <input type="hidden" name="documentUrl" id="documentUrl" value={projectData.documentUrl || (existingPhotoUrl && !(BACKEND_URL && existingPhotoUrl.startsWith(BACKEND_URL)) ? existingPhotoUrl : '')} />
            </div>
          </div>
        </div>
      </div>

      <!-- Section: Detailed Descriptions -->
      <div>
        <h3 class="text-xs font-bold text-[color:var(--adm-primary)] uppercase tracking-wider border-b border-slate-100 pb-2 mb-4">
          Detailed Content &amp; Salient Features
        </h3>
        
        <div class="flex flex-col gap-6">
          <div class="space-y-1.5">
            <label class="block text-xs font-bold text-slate-800 uppercase tracking-wider">
              About Project (Description)
            </label>
            <input type="hidden" name="description" id="field-description" value={projectData.description || ''} />
            <div data-rich-editor="field-description" data-placeholder="Detailed background, river scheme overview, project site location, scope of work..." class="bg-white rounded-lg border border-slate-300 h-44 max-h-44 overflow-hidden text-xs"></div>
          </div>

          <div class="space-y-1.5">
            <label class="block text-xs font-bold text-slate-800 uppercase tracking-wider">
              Salient Features (Details / Technical Specifications)
            </label>
            <input type="hidden" name="salientFeatures" id="field-salientFeatures" value={projectData.salientFeatures || ''} />
            <div data-rich-editor="field-salientFeatures" data-placeholder="Salient features including dam dimensions, reservoir stretch, water conductor, powerhouse details, appraisal milestones..." class="bg-white rounded-lg border border-slate-300 h-56 max-h-56 overflow-hidden text-xs"></div>
          </div>
        </div>
      </div>

      <!-- Save controls -->
      <div class="flex justify-end gap-3 border-t border-slate-100 pt-6 mt-2">
        <a href="/admin/under-construction" class="admin-btn admin-btn-secondary">Cancel</a>
        <button type="submit" class="admin-btn admin-btn-primary cursor-pointer">
          {editId ? 'Update Project' : 'Create Project'}
        </button>
      </div>
    </form>
  </div>

  <script define:vars={{ sessionToken, backendUrl: BACKEND_URL }}>
    // Unified uploader: 'project-image-input' fires 'change' after validated selection.
    const documentUrlInput = document.getElementById('documentUrl');
    const imageFileInput = document.getElementById('project-image-input');

    function removePhoto() {
      if (documentUrlInput) documentUrlInput.value = '';
      if (imageFileInput) imageFileInput.value = '';
    }

    imageFileInput?.addEventListener('change', async (event) => {
      const file = event.target?.files?.[0];
      if (!file) return;

      const formData = new FormData();
      formData.append('file', file);

      try {
        const response = await fetch(`${backendUrl}/api/upload`, {
          method: 'POST',
          headers: {
            'Authorization': `Bearer ${sessionToken}`,
          },
          body: formData,
        });

        if (!response.ok) {
          if (response.status === 401) {
            window.location.href = '/admin/login';
            return;
          }
          if (response.status === 403) {
            alert('Access Denied: You do not have permission to upload files.');
            removePhoto();
            return;
          }
          const err = await response.json().catch(() => ({}));
          throw new Error(err.message || 'Upload failed');
        }

        const result = await response.json();
        const serverUrl = (backendUrl && result.url.startsWith(`${backendUrl}/uploads/`))
          ? result.url.replace(backendUrl, '')
          : result.url;

        if (documentUrlInput) documentUrlInput.value = serverUrl;
        const previewImg = document.getElementById('project-image-preview-img');
        if (previewImg) {
          previewImg.src = serverUrl.startsWith('/uploads/') ? `${backendUrl}${serverUrl}` : serverUrl;
          previewImg.classList.remove('invisible');
        }
      } catch (err) {
        alert(`Upload error: ${err.message}`);
        removePhoto();
      }
    });

    imageFileInput?.addEventListener('uploader:cleared', () => {
      if (documentUrlInput) documentUrlInput.value = '';
    });
  </script>
</AdminLayout>
