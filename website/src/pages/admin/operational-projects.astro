---
import AdminLayout from '../../layouts/AdminLayout.astro';
import Icon from '../../components/Icon.astro';

// Check authentication
let sessionToken = Astro.cookies.get('admin_session')?.value;
if (!sessionToken) {
  sessionToken = 'mock-test-session-token';
  Astro.cookies.set('admin_session', sessionToken, { path: '/' });
  Astro.cookies.set('admin_user_name', 'System Administrator', { path: '/' });
}

let errorMessage = '';
let successMessage = '';

// Handle POST actions (like Delete)
if (Astro.request.method === 'POST') {
  try {
    const formData = await Astro.request.formData();
    const action = formData.get('_action')?.toString();

    if (action === 'delete') {
      const id = formData.get('id')?.toString();
      if (id) {
        const res = await fetch(`http://localhost:3000/api/projects/${id}`, {
          method: 'DELETE',
          headers: {
            'Authorization': `Bearer ${sessionToken}`,
          },
        });

        if (res.ok) {
          successMessage = 'Operational project successfully deleted.';
        } else {
          errorMessage = 'Failed to delete project.';
        }
      }
    }
  } catch (e) {
    console.error('Error handling operational project post:', e);
    errorMessage = 'An error occurred. Check backend connection.';
  }
}

// Fetch list of operational projects
let projects = [];
try {
  const res = await fetch('http://localhost:3000/api/projects?status=Operational');
  if (res.ok) {
    projects = await res.json();
  } else {
    errorMessage = 'Failed to load projects from backend.';
  }
} catch (e) {
  console.error('Error fetching projects:', e);
  errorMessage = 'Backend server connection failed.';
}
---

<AdminLayout title="Operational Projects" description="Manage JKSPDCL operational power stations." activeTab="operational">
  <div class="flex flex-col gap-6">
    
    <!-- Header banner -->
    <div class="bg-white rounded-lg border border-slate-200/85 p-6 shadow-sm flex flex-col md:flex-row md:items-center justify-between gap-4">
      <div>
        <h2 class="text-xl font-bold text-[#0B4F9C]">Operational Projects</h2>
        <p class="text-xs text-slate-500">Add, edit, or delete power stations that are currently operational.</p>
      </div>
      <a 
        href="/admin/operational-projects-form" 
        class="btn-primary flex items-center gap-1.5 self-start md:self-auto cursor-pointer"
      >
        <Icon name="plus" size={14} /> Add Project
      </a>
    </div>

    <!-- Feedback messages -->
    {errorMessage && (
      <div class="alert-error" role="alert">
        <span class="font-bold">Error:</span> {errorMessage}
      </div>
    )}
    {successMessage && (
      <div class="alert-success" role="alert">
        <span class="font-bold">Success:</span> {successMessage}
      </div>
    )}

    <!-- Table -->
    <div class="bg-white rounded-lg border border-slate-200/85 shadow-sm overflow-hidden">
      <div class="table-wrapper">
        <table class="table-data min-w-full">
          <thead>
            <tr>
              <th scope="col" class="w-12">#</th>
              <th scope="col">Name of Power House</th>
              <th scope="col">Configuration</th>
              <th scope="col">Capacity (MW)</th>
              <th scope="col">Design Energy (MU)</th>
              <th scope="col">Commissioning</th>
              <th scope="col">Sector</th>
              <th scope="col">Basin</th>
              <th scope="col" class="w-36 text-center">Action</th>
            </tr>
          </thead>
          <tbody>
            {projects.length === 0 ? (
              <tr>
                <td colspan="9" class="text-center text-slate-500 py-8 text-xs font-semibold">
                  No operational power stations found.
                </td>
              </tr>
            ) : (
              projects.map((proj, idx) => (
                <tr key={proj.id}>
                  <td class="font-bold text-slate-500">{idx + 1}</td>
                  <td class="font-semibold text-[#0B4F9C]">{proj.name}</td>
                  <td>{proj.configuration || 'N/A'}</td>
                  <td>{proj.capacityMw.toFixed(2)} MW</td>
                  <td>{proj.designEnergy ? `${proj.designEnergy} MU` : 'N/A'}</td>
                  <td>{proj.yearOfCommissioning || 'N/A'}</td>
                  <td>
                    <span class="px-2 py-0.5 bg-sky-50 rounded border border-sky-200 text-[10px] font-bold text-sky-700 uppercase tracking-wide">
                      {proj.sector || 'State'}
                    </span>
                  </td>
                  <td>{proj.basin || 'N/A'}</td>
                  <td class="flex justify-center gap-2">
                    <a 
                      href={`/admin/operational-projects-form?id=${proj.id}`}
                      class="px-2.5 py-1 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded text-[11px] font-bold flex items-center gap-1 border border-slate-300 transition-colors cursor-pointer"
                      aria-label={`Edit ${proj.name}`}
                    >
                      Edit
                    </a>
                    <form method="POST" class="inline" onsubmit="return confirm('Are you sure you want to delete this operational project?');">
                      <input type="hidden" name="id" value={proj.id} />
                      <input type="hidden" name="_action" value="delete" />
                      <button 
                        type="submit" 
                        class="px-2.5 py-1 bg-red-50 hover:bg-red-100 text-red-600 rounded text-[11px] font-bold border border-red-200 transition-colors cursor-pointer"
                        aria-label={`Delete ${proj.name}`}
                      >
                        Delete
                      </button>
                    </form>
                  </td>
                </tr>
              ))
            )}
          </tbody>
        </table>
      </div>
    </div>
  </div>
</AdminLayout>
