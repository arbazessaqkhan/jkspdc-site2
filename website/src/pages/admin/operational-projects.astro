---
import AdminLayout from '../../layouts/AdminLayout.astro';
import Icon from '../../components/Icon.astro';
import { isAdmin } from '../../utils/roles';
import { parseApiError, BACKEND_URL } from '../../utils/api-error';

// Check authentication
const sessionToken = Astro.cookies.get('admin_session')?.value;
if (!sessionToken) {
  return Astro.redirect('/admin/login');
}

const userRole = Astro.locals.user?.role;
const userIsAdmin = isAdmin(userRole);

let errorMessage = '';
let successMessage = '';

// Handle POST actions (like Delete) (ADMIN ONLY)
if (Astro.request.method === 'POST') {
  if (!userIsAdmin) {
    return Astro.redirect('/admin/operational-projects');
  }
  try {
    const formData = await Astro.request.formData();
    const action = formData.get('_action')?.toString();

    if (action === 'delete') {
      const id = formData.get('id')?.toString();
      if (id) {
        const res = await fetch(`${BACKEND_URL}/api/projects/${id}`, {
          method: 'DELETE',
          headers: {
            'Authorization': `Bearer ${sessionToken}`,
          },
        });

        if (res.ok) {
          successMessage = 'Operational project successfully deleted.';
        } else {
          const apiErr = await parseApiError(res, 'delete operational project');
          if (apiErr.isUnauthorized) {
            return Astro.redirect('/admin/login');
          }
          errorMessage = apiErr.message;
        }
      }
    }
  } catch (e) {
    console.error('Error handling operational project post:', e);
    errorMessage = 'Network failure: Unable to communicate with backend service.';
  }
}

// Fetch list of operational projects
let projects = [];
try {
  const res = await fetch(`${BACKEND_URL}/api/projects?status=Operational`);
  if (res.ok) {
    projects = await res.json();
  } else {
    const apiErr = await parseApiError(res, 'load operational projects');
    if (apiErr.isUnauthorized) {
      return Astro.redirect('/admin/login');
    }
    errorMessage = apiErr.message;
  }
} catch (e) {
  console.error('Error fetching projects:', e);
  errorMessage = 'Network failure: Unable to reach backend server.';
}
---

<AdminLayout title="Operational Projects" description="Manage JKSPDCL operational power stations." activeTab="operational">
  <div class="flex flex-col gap-5">
    
    <!-- Standard Admin Page Header -->
    <div class="admin-page-header">
      <div>
        <h1 class="text-lg font-extrabold text-[color:var(--adm-primary)] tracking-tight">Operational Projects</h1>
        <p class="text-xs text-slate-500 mt-0.5">Manage operational hydro-electric power stations across Jammu, Kashmir, and Ladakh basins.</p>
      </div>
      {userIsAdmin && (
        <a 
          href="/admin/operational-projects-form" 
          class="btn-primary flex items-center gap-1.5 text-xs py-2 px-3.5 self-start md:self-auto cursor-pointer"
        >
          <Icon name="plus" size={13} strokeWidth={2.5} />
          <span>Add Project</span>
        </a>
      )}
    </div>

    <!-- Alerts -->
    {errorMessage && (
      <div class="p-3 bg-red-50 border border-red-200 text-xs font-semibold text-red-700 rounded flex items-center gap-2" role="alert">
        <Icon name="info" size={14} class="text-red-600 shrink-0" /> {errorMessage}
      </div>
    )}
    {successMessage && (
      <div class="p-3 bg-green-50 border border-green-200 text-xs font-semibold text-green-700 rounded flex items-center gap-2" role="alert">
        <Icon name="check" size={14} class="text-green-600 shrink-0" /> {successMessage}
      </div>
    )}

    <!-- Search & Filter Toolbar -->
    <div class="admin-toolbar">
      <div class="flex items-center gap-3 flex-wrap flex-1 min-w-0">
        <div class="relative w-full sm:w-72">
          <input 
            type="text" 
            id="search-projects-input" 
            placeholder="Search power house, basin, configuration..." 
            class="w-full bg-slate-50 border border-slate-300 rounded text-xs text-slate-800 pl-8 pr-3 py-1.5 focus:ring-1 focus:ring-[color:var(--adm-primary)] focus:border-[color:var(--adm-primary)] outline-none"
          />
          <div class="absolute left-2.5 top-2 text-slate-400">
            <Icon name="search" size={13} />
          </div>
        </div>
        
        <div class="flex items-center gap-2">
          <label for="filter-sector-select" class="text-xs font-bold text-slate-600 shrink-0">Sector:</label>
          <select id="filter-sector-select" class="bg-slate-50 border border-slate-300 rounded text-xs py-1.5 px-2.5 text-slate-700 outline-none">
            <option value="All">All Sectors</option>
            <option value="State">State Sector</option>
            <option value="JV">Joint Venture (JV)</option>
          </select>
        </div>
      </div>

      <div class="text-xs text-slate-500 font-medium shrink-0">
        Showing <span id="visible-projects-count" class="font-bold text-slate-800">{projects.length}</span> of <span class="font-bold text-slate-800">{projects.length}</span> stations
      </div>
    </div>

    <!-- Administrative Data Table -->
    <div class="admin-table-card">
    <div class="admin-table-container">
      <table class="table-data min-w-full text-left" id="operational-table">
        <thead>
          <tr>
            <th scope="col" class="w-12 text-center">#</th>
            <th scope="col" class="min-w-[200px]">Name of Power House</th>
            <th scope="col" class="w-28 whitespace-nowrap">Configuration</th>
            <th scope="col" class="w-32 whitespace-nowrap text-right">Capacity (MW)</th>
            <th scope="col" class="w-32 whitespace-nowrap text-right">Design Energy</th>
            <th scope="col" class="w-28 text-center whitespace-nowrap">Commissioned</th>
            <th scope="col" class="w-24 text-center whitespace-nowrap">Sector</th>
            <th scope="col" class="w-24 text-center whitespace-nowrap">Basin</th>
            {userIsAdmin && (
              <th scope="col" class="w-24 text-center whitespace-nowrap sticky-col-right">Action</th>
            )}
          </tr>
        </thead>
        <tbody id="operational-tbody">
          {projects.length === 0 ? (
            <tr id="empty-projects-row">
              <td colspan={userIsAdmin ? 9 : 8} class="text-center text-slate-500 py-12 text-xs font-semibold italic">
                No operational power stations found.
              </td>
            </tr>
          ) : (
            projects.map((proj, idx) => (
              <tr 
                key={proj.id}
                class="project-row transition-colors"
                data-sector={proj.sector || 'State'}
                data-search={`${proj.name} ${proj.configuration || ''} ${proj.sector || ''} ${proj.basin || ''}`.toLowerCase()}
              >
                <td class="font-bold text-slate-400 text-center text-xs row-idx">{idx + 1}</td>
                <td class="font-bold text-slate-900 text-xs">{proj.name}</td>
                <td class="text-slate-600 font-medium text-xs whitespace-nowrap">{proj.configuration || '—'}</td>
                <td class="font-extrabold text-[color:var(--adm-primary)] whitespace-nowrap text-right text-xs">
                  {proj.capacityMw.toFixed(2)} <span class="text-[10px] text-slate-400 font-normal">MW</span>
                </td>
                <td class="whitespace-nowrap font-medium text-slate-700 text-right text-xs">
                  {proj.designEnergy ? `${proj.designEnergy} MU` : '—'}
                </td>
                <td class="whitespace-nowrap text-slate-600 font-medium text-center text-xs">{proj.yearOfCommissioning || '—'}</td>
                <td class="text-center">
                  <span class="admin-badge-info">
                    {proj.sector || 'State'}
                  </span>
                </td>
                <td class="text-slate-700 font-medium text-center text-xs">{proj.basin || '—'}</td>
                {userIsAdmin && (
                  <td class="td-actions sticky-col-right">
                    <div class="admin-action-group">
                      <a 
                        href={`/admin/operational-projects-form?id=${proj.id}`}
                        class="admin-btn-action"
                        title={`Edit ${proj.name}`}
                        aria-label={`Edit ${proj.name}`}
                      >
                        <Icon name="pencil" size={13} />
                      </a>
                      <form method="POST" class="inline m-0 p-0" onsubmit="return confirm('Are you sure you want to delete this operational project?');">
                        <input type="hidden" name="id" value={proj.id} />
                        <input type="hidden" name="_action" value="delete" />
                        <button 
                          type="submit" 
                          class="admin-btn-action action-delete"
                          title={`Delete ${proj.name}`}
                          aria-label={`Delete ${proj.name}`}
                        >
                          <Icon name="trash-2" size={13} />
                        </button>
                      </form>
                    </div>
                  </td>
                )}
              </tr>
            ))
          )}
          <tr id="no-matching-row" style="display: none;">
            <td colspan={userIsAdmin ? 9 : 8} class="text-center text-slate-500 py-12 text-xs font-semibold italic">
              No operational power stations found matching your search or filter criteria.
            </td>
          </tr>
        </tbody>
      </table>
    </div>
    </div>

  </div>

  <script is:inline>
    function setupOperationalFilters() {
      var searchInput = document.getElementById('search-projects-input');
      var sectorSelect = document.getElementById('filter-sector-select');
      var countEl = document.getElementById('visible-projects-count');
      var emptyRow = document.getElementById('no-matching-row');

      if (!searchInput || !sectorSelect) return;

      function filterProjects() {
        var query = (searchInput.value || '').toLowerCase().trim();
        var selectedSector = (sectorSelect.value || 'All').toLowerCase().trim();
        var rows = document.querySelectorAll('.project-row');
        var visible = 0;

        rows.forEach(function(row) {
          var rowData = (row.getAttribute('data-search') || '').toLowerCase();
          var rowSector = (row.getAttribute('data-sector') || '').toLowerCase().trim();

          var matchesQuery = !query || rowData.includes(query);
          
          var matchesSector = false;
          if (selectedSector === 'all') {
            matchesSector = true;
          } else if (selectedSector === 'state') {
            matchesSector = rowSector === 'state' || rowSector.includes('state');
          } else if (selectedSector === 'jv') {
            matchesSector = rowSector === 'jv' || rowSector.includes('jv') || rowSector.includes('joint venture');
          } else {
            matchesSector = rowSector === selectedSector;
          }

          if (matchesQuery && matchesSector) {
            row.style.display = '';
            visible++;
            var idxEl = row.querySelector('.row-idx');
            if (idxEl) idxEl.textContent = visible.toString();
          } else {
            row.style.display = 'none';
          }
        });

        if (countEl) countEl.textContent = visible.toString();
        if (emptyRow) {
          emptyRow.style.display = (visible === 0 && rows.length > 0) ? 'table-row' : 'none';
        }
      }

      searchInput.oninput = filterProjects;
      sectorSelect.onchange = filterProjects;

      filterProjects();
    }

    document.addEventListener('astro:page-load', setupOperationalFilters);
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', setupOperationalFilters);
    } else {
      setupOperationalFilters();
    }
  </script>
</AdminLayout>
