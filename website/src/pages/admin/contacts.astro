---
import AdminLayout from '../../layouts/AdminLayout.astro';
import Icon from '../../components/Icon.astro';
import { isAdmin } from '../../utils/roles';
import { parseApiError, BACKEND_URL } from '../../utils/api-error';

// Check authentication
const sessionToken = Astro.cookies.get('admin_session')?.value;
if (!sessionToken) {
  return Astro.redirect('/admin/login');
}

const userRole = Astro.locals.user?.role;
const userIsAdmin = isAdmin(userRole);

let errorMessage = '';
let successMessage = '';

// Handle Delete Inquiry (ADMIN ONLY)
if (Astro.request.method === 'POST') {
  if (!userIsAdmin) {
    return Astro.redirect('/admin/contacts');
  }
  try {
    const formData = await Astro.request.formData();
    const action = formData.get('_action')?.toString();

    if (action === 'delete') {
      const id = formData.get('id')?.toString();
      if (id) {
        const res = await fetch(`${BACKEND_URL}/api/contact/${id}`, {
          method: 'DELETE',
          headers: {
            'Authorization': `Bearer ${sessionToken}`,
          },
        });

        if (res.ok) {
          successMessage = 'Submission successfully deleted.';
        } else {
          const apiErr = await parseApiError(res, 'delete contact submission');
          if (apiErr.isUnauthorized) {
            return Astro.redirect('/admin/login');
          }
          errorMessage = apiErr.message;
        }
      }
    }
  } catch (e) {
    console.error('Error deleting contact submission:', e);
    errorMessage = 'An error occurred while deleting the submission. Check backend service status.';
  }
}

// Fetch Contacts List
let submissions: any[] = [];
try {
  const res = await fetch(`${BACKEND_URL}/api/contact`, {
    headers: {
      'Authorization': `Bearer ${sessionToken}`,
    },
  });
  if (res.ok) {
    submissions = await res.json();
  } else {
    const apiErr = await parseApiError(res, 'load contact submissions');
    if (apiErr.isUnauthorized) {
      return Astro.redirect('/admin/login');
    }
    errorMessage = apiErr.message;
  }
} catch (e) {
  console.error('Error fetching contact submissions:', e);
  errorMessage = 'Failed to load contact submissions. Unable to communicate with the server.';
}

// Parse Submissions
function parseSubmission(sub: any) {
  const raw = sub.message || '';
  const isWebsiteFeedback = raw.includes('[WEBSITE FEEDBACK]');
  const isCitizenInquiry = !isWebsiteFeedback && (raw.includes('[CATEGORY:') || raw.includes('[SUBJECT:'));

  let type = '';
  let page = '';
  let rating = '';
  let category = '';
  let subject = '';
  let phone = '';
  let cleanDetails = raw;

  if (isWebsiteFeedback) {
    const typeMatch = raw.match(/\[TYPE:\s*([^\]]+)\]/i);
    const pageMatch = raw.match(/\[PAGE:\s*([^\]]+)\]/i);
    const ratingMatch = raw.match(/\[RATING:\s*([^\]]+)\]/i);

    if (typeMatch) type = typeMatch[1].trim();
    if (pageMatch) page = pageMatch[1].trim();
    if (ratingMatch) rating = ratingMatch[1].trim();

    cleanDetails = raw
      .replace(/\[WEBSITE FEEDBACK\]/gi, '')
      .replace(/\[TYPE:[^\]]+\]/gi, '')
      .replace(/\[PAGE:[^\]]+\]/gi, '')
      .replace(/\[RATING:[^\]]+\]/gi, '')
      .trim();
  } else if (isCitizenInquiry) {
    const catMatch = raw.match(/\[CATEGORY:\s*([^\]]+)\]/i);
    const subjMatch = raw.match(/\[SUBJECT:\s*([^\]]+)\]/i);
    const phoneMatch = raw.match(/\[PHONE:\s*([^\]]+)\]/i);

    if (catMatch) category = catMatch[1].trim();
    if (subjMatch) subject = subjMatch[1].trim();
    if (phoneMatch) phone = phoneMatch[1].trim();

    cleanDetails = raw
      .replace(/\[CATEGORY:[^\]]+\]/gi, '')
      .replace(/\[SUBJECT:[^\]]+\]/gi, '')
      .replace(/\[PHONE:[^\]]+\]/gi, '')
      .trim();
  }

  const kind = isWebsiteFeedback ? 'website' : isCitizenInquiry ? 'citizen' : 'general';

  return {
    ...sub,
    kind,
    isWebsiteFeedback,
    isCitizenInquiry,
    type,
    page,
    rating,
    category,
    subject,
    phone,
    cleanDetails: cleanDetails || raw,
  };
}

const parsedSubmissions = submissions.map(parseSubmission);
const websiteFeedbackCount = parsedSubmissions.filter(s => s.isWebsiteFeedback).length;
const citizenInquiryCount = parsedSubmissions.filter(s => s.isCitizenInquiry).length;
const totalCount = parsedSubmissions.length;
---

<AdminLayout title="Feedbacks & Inquiries" description="Manage Website Feedback and Citizen Inquiries" activeTab="contacts">
  <div class="flex flex-col gap-6">
    
    <!-- Page Header -->
    <div class="admin-page-header">
      <div>
        <div class="flex items-center gap-2 mb-1">
          <h1 class="admin-page-title">Feedbacks &amp; Citizen Inquiries</h1>
          <span class="admin-badge admin-badge-info">
            {totalCount} Total
          </span>
        </div>
        <p class="admin-page-subtitle">
          Review, filter, and respond to portal website user feedback, bug reports, and official citizen inquiries.
        </p>
      </div>
    </div>

    <!-- Toolbar: Search & Filter Tabs -->
    <div class="admin-toolbar flex-wrap">
      <div class="flex flex-wrap items-center gap-2">
        <button 
          type="button" 
          data-filter="all" 
          data-active="true"
          class="filter-tab px-3 py-1.5 rounded text-xs font-semibold border cursor-pointer select-none"
        >
          All Submissions ({totalCount})
        </button>

        <button 
          type="button" 
          data-filter="website" 
          data-active="false"
          class="filter-tab px-3 py-1.5 rounded text-xs font-semibold border cursor-pointer select-none"
        >
          Website Feedback ({websiteFeedbackCount})
        </button>

        <button 
          type="button" 
          data-filter="citizen" 
          data-active="false"
          class="filter-tab px-3 py-1.5 rounded text-xs font-semibold border cursor-pointer select-none"
        >
          Citizen Inquiries ({citizenInquiryCount})
        </button>
      </div>

      <!-- Quick Search -->
      <div class="relative w-full sm:w-64">
        <input 
          type="text" 
          id="search-input" 
          placeholder="Search name, email, subject..." 
          class="w-full bg-white border border-slate-300 rounded text-xs text-slate-800 pl-8 pr-3 py-1.5 focus:ring-1 focus:ring-[#0B4F9C] focus:border-[#0B4F9C] outline-none"
        />
        <div class="absolute left-2.5 top-2 text-slate-400">
          <Icon name="search" size={13} />
        </div>
      </div>
    </div>

    <!-- Alerts -->
    {errorMessage && (
      <div class="p-3 bg-red-50 border border-red-200 text-xs font-semibold text-red-700 rounded flex items-center gap-2" role="alert">
        <Icon name="info" size={14} class="text-red-600 shrink-0" /> {errorMessage}
      </div>
    )}
    {successMessage && (
      <div class="p-3 bg-green-50 border border-green-200 text-xs font-semibold text-green-700 rounded flex items-center gap-2" role="alert">
        <Icon name="info" size={14} class="text-green-600 shrink-0" /> {successMessage}
      </div>
    )}

    <!-- Administrative Data Table -->
    <div class="admin-table-container">
      <table class="admin-table min-w-full" id="contacts-table">
        <thead>
          <tr>
            <th scope="col" class="w-12 text-center">#</th>
            <th scope="col" class="w-32">Category</th>
            <th scope="col" class="min-w-[200px]">Submitter Info</th>
            <th scope="col" class="min-w-[280px]">Subject &amp; Message</th>
            <th scope="col" class="w-32 whitespace-nowrap">Submitted</th>
            <th scope="col" class="w-28 text-center sticky-col-right">Action</th>
          </tr>
        </thead>
        <tbody id="contacts-table-body">
          {parsedSubmissions.length === 0 ? (
            <tr id="empty-row">
              <td colspan="6" class="text-center py-12 text-slate-500 text-xs font-semibold italic">
                No inquiries or feedback submissions found.
              </td>
            </tr>
          ) : (
            parsedSubmissions.map((sub, idx) => {
              const hasEmail = sub.email && sub.email !== 'Not provided' && sub.email.includes('@');
              const searchContent = `${sub.name} ${sub.email} ${sub.phone || ''} ${sub.subject || ''} ${sub.cleanDetails || ''} ${sub.type || ''} ${sub.category || ''}`.toLowerCase();
              return (
                <tr 
                  key={sub.id} 
                  data-kind={sub.kind}
                  data-search={searchContent}
                  class="submission-row transition-colors"
                >
                  <td class="text-center font-bold text-slate-400 text-xs row-index">{totalCount - idx}</td>
                  
                  <td>
                    {sub.isWebsiteFeedback ? (
                      <div class="flex flex-col gap-1 items-start">
                        <span class="admin-badge admin-badge-success">Feedback</span>
                        {sub.type && <span class="text-[10px] text-slate-600 font-semibold">{sub.type}</span>}
                        {sub.rating && sub.rating !== 'Not rated' && (
                          <span class="text-[10px] text-amber-800 font-bold flex items-center gap-1"><Icon name="star" size={10} class="text-amber-600 shrink-0" /> {sub.rating}/5</span>
                        )}
                      </div>
                    ) : sub.isCitizenInquiry ? (
                      <div class="flex flex-col gap-1 items-start">
                        <span class="admin-badge admin-badge-info">Inquiry</span>
                        {sub.category && <span class="text-[10px] text-slate-600 font-semibold">{sub.category}</span>}
                      </div>
                    ) : (
                      <span class="admin-badge admin-badge-neutral">General</span>
                    )}
                  </td>

                  <td>
                    <div class="flex flex-col">
                      <span class="font-bold text-slate-900 text-xs leading-snug">{sub.name}</span>
                      {hasEmail ? (
                        <span class="text-xs text-[#0B4F9C] font-mono mt-0.5">{sub.email}</span>
                      ) : (
                        <span class="text-[11px] text-slate-400 italic mt-0.5">No email</span>
                      )}
                      {sub.phone && sub.phone !== 'Not provided' && (
                        <span class="text-[10px] text-slate-500 font-mono mt-0.5">Ph: {sub.phone}</span>
                      )}
                    </div>
                  </td>

                  <td>
                    <div class="flex flex-col gap-0.5 max-w-md">
                      {sub.subject && (
                        <span class="font-bold text-xs text-slate-900 leading-snug">{sub.subject}</span>
                      )}
                      {sub.page && (
                        <span class="text-[10px] text-[#0B4F9C] font-mono">Page: {sub.page}</span>
                      )}
                      <p class="text-xs text-slate-600 line-clamp-2 leading-relaxed">
                        {sub.cleanDetails}
                      </p>
                    </div>
                  </td>

                  <td class="whitespace-nowrap text-xs text-slate-600 font-medium">
                    {new Date(sub.createdAt).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' })}
                    <span class="block text-[10px] text-slate-400">{new Date(sub.createdAt).toLocaleTimeString('en-IN', { hour: '2-digit', minute: '2-digit' })}</span>
                  </td>

                  <td class="td-actions sticky-col-right text-center">
                    <div class="admin-action-group justify-center">
                      <button 
                        type="button" 
                        class="admin-btn-action btn-view-submission"
                        data-submission={JSON.stringify(sub)}
                        aria-label="View Full Submission"
                        title="View Full Submission"
                      >
                        <Icon name="eye" size={13} />
                      </button>

                      {hasEmail ? (
                        <a 
                          href={`mailto:${sub.email}?subject=${encodeURIComponent(sub.isWebsiteFeedback ? `RE: JKSPDCL Website Feedback (${sub.type || 'General'})` : `RE: JKSPDCL Portal Inquiry (${sub.subject || 'General'})`)}`}
                          class="admin-btn-action"
                          aria-label="Reply via Email"
                          title="Reply via Email"
                        >
                          <Icon name="mail" size={13} />
                        </a>
                      ) : null}

                      {userIsAdmin && (
                        <form method="POST" class="inline m-0 p-0" onsubmit="return confirm('Are you sure you want to delete this submission?');">
                          <input type="hidden" name="id" value={sub.id} />
                          <input type="hidden" name="_action" value="delete" />
                          <button 
                            type="submit" 
                            class="admin-btn-action action-delete"
                            aria-label="Delete Submission"
                            title="Delete Submission"
                          >
                            <Icon name="trash-2" size={13} />
                          </button>
                        </form>
                      )}
                    </div>
                  </td>
                </tr>
              );
            })
          )}
          <tr id="no-matching-contacts-row" style="display: none;">
            <td colspan="6" class="text-center py-12 text-slate-500 text-xs font-semibold italic">
              No inquiries or feedback submissions found matching your search or filter criteria.
            </td>
          </tr>
        </tbody>
      </table>
    </div>

    <!-- Detail View Modal -->
    <div id="detail-modal" class="fixed inset-0 z-50 bg-slate-900/60 backdrop-blur-xs flex items-center justify-center p-4 hidden">
      <div class="bg-white rounded-2xl border border-slate-200 shadow-2xl w-full max-w-lg max-h-[90vh] flex flex-col overflow-hidden animate-fadeInUp">
        <div class="px-6 py-4 border-b border-slate-200 flex items-center justify-between bg-slate-50/70 shrink-0">
          <div class="flex items-center gap-2">
            <span id="modal-badge"></span>
            <h3 class="text-base font-extrabold text-[#0B4F9C] tracking-tight">Submission Details</h3>
          </div>
          <button type="button" id="modal-close-btn" class="w-8 h-8 rounded-lg text-slate-400 hover:text-slate-700 hover:bg-slate-200 flex items-center justify-center text-lg font-bold cursor-pointer transition-colors">&times;</button>
        </div>

        <div class="p-6 flex flex-col gap-4 overflow-y-auto text-xs text-slate-700 leading-relaxed">
          <div class="grid grid-cols-2 gap-3 bg-slate-50 p-3.5 rounded-xl border border-slate-200">
            <div>
              <span class="text-[10px] uppercase font-bold text-slate-400 block">Submitter Name</span>
              <span id="modal-name" class="font-extrabold text-slate-900 text-sm"></span>
            </div>
            <div>
              <span class="text-[10px] uppercase font-bold text-slate-400 block">Email Address</span>
              <span id="modal-email" class="font-mono text-[#0B4F9C] font-semibold"></span>
            </div>
            <div>
              <span class="text-[10px] uppercase font-bold text-slate-400 block">Phone</span>
              <span id="modal-phone" class="font-mono text-slate-800"></span>
            </div>
            <div>
              <span class="text-[10px] uppercase font-bold text-slate-400 block">Date &amp; Time</span>
              <span id="modal-date" class="text-slate-700 font-semibold"></span>
            </div>
          </div>

          <div id="modal-meta-row" class="flex flex-wrap gap-2"></div>

          <div>
            <span class="text-[10px] uppercase font-bold text-slate-400 block mb-1">Message Content</span>
            <div id="modal-message" class="bg-white border border-slate-200 rounded-xl p-4 text-slate-900 font-normal whitespace-pre-wrap leading-relaxed shadow-inner"></div>
          </div>
        </div>

        <div class="px-6 py-3 border-t border-slate-200 flex items-center justify-between bg-slate-50/70 shrink-0">
          <span id="modal-ip" class="text-[10px] font-mono text-slate-400"></span>
          <div class="flex items-center gap-2">
            <a id="modal-reply-btn" href="#" class="px-4 py-2 bg-[#0B4F9C] hover:bg-[#084A8F] text-white text-xs font-bold rounded-lg transition-colors inline-flex items-center gap-1.5">
              <Icon name="mail" size={13} /> Reply via Email
            </a>
            <button type="button" id="modal-dismiss-btn" class="px-4 py-2 bg-slate-200 hover:bg-slate-300 text-slate-700 text-xs font-bold rounded-lg transition-colors cursor-pointer">
              Close
            </button>
          </div>
        </div>
      </div>
    </div>

  </div>
</AdminLayout>

<style>
  .filter-tab {
    transition: all 0.15s ease-in-out;
  }
  .filter-tab[data-active="true"] {
    background-color: #0B4F9C !important;
    color: #ffffff !important;
    border-color: #0B4F9C !important;
    box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.05);
  }
  .filter-tab[data-active="true"]:hover {
    background-color: #083b75 !important;
    color: #ffffff !important;
    border-color: #083b75 !important;
  }
  .filter-tab[data-active="false"] {
    background-color: #ffffff !important;
    color: #334155 !important;
    border-color: #e2e8f0 !important;
  }
  .filter-tab[data-active="false"]:hover {
    background-color: #f1f5f9 !important;
    color: #0B4F9C !important;
    border-color: #cbd5e1 !important;
  }
</style>

<script is:inline>
  function initContactsPage() {
    var tabs = document.querySelectorAll('.filter-tab');
    var rows = document.querySelectorAll('.submission-row');
    var searchInput = document.getElementById('search-input');
    var modal = document.getElementById('detail-modal');
    var modalClose = document.getElementById('modal-close-btn');
    var modalDismiss = document.getElementById('modal-dismiss-btn');

    var currentFilter = 'all';

    function applyFilterAndSearch() {
      var query = searchInput ? searchInput.value.toLowerCase().trim() : '';
      var visibleCount = 0;
      var emptyRow = document.getElementById('no-matching-contacts-row');

      rows.forEach(function(row) {
        var kind = row.getAttribute('data-kind') || '';
        var searchData = row.getAttribute('data-search') || '';

        var matchesFilter = (currentFilter === 'all' || kind === currentFilter);
        var matchesQuery = !query || searchData.includes(query);

        if (matchesFilter && matchesQuery) {
          row.style.display = '';
          visibleCount++;
          var indexCell = row.querySelector('.row-index');
          if (indexCell) indexCell.textContent = visibleCount.toString();
        } else {
          row.style.display = 'none';
        }
      });

      if (emptyRow) {
        emptyRow.style.display = (visibleCount === 0 && rows.length > 0) ? 'table-row' : 'none';
      }
    }

    tabs.forEach(function(tab) {
      tab.addEventListener('click', function() {
        tabs.forEach(function(t) { t.setAttribute('data-active', 'false'); });
        tab.setAttribute('data-active', 'true');
        currentFilter = tab.getAttribute('data-filter') || 'all';
        applyFilterAndSearch();
      });
    });

    if (searchInput) {
      searchInput.addEventListener('input', applyFilterAndSearch);
    }

    // Modal view handlers
    document.querySelectorAll('.btn-view-submission').forEach(function(btn) {
      btn.addEventListener('click', function() {
        var dataStr = btn.getAttribute('data-submission');
        if (!dataStr) return;
        try {
          var sub = JSON.parse(dataStr);
          document.getElementById('modal-name').textContent = sub.name || '—';
          document.getElementById('modal-email').textContent = sub.email || '—';
          document.getElementById('modal-phone').textContent = sub.phone || '—';
          document.getElementById('modal-date').textContent = new Date(sub.createdAt).toLocaleString('en-IN');
          document.getElementById('modal-message').textContent = sub.cleanDetails || sub.message || '—';
          document.getElementById('modal-ip').textContent = sub.ipAddress ? ('IP: ' + sub.ipAddress) : '';

          var metaContainer = document.getElementById('modal-meta-row');
          metaContainer.innerHTML = '';
          if (sub.isWebsiteFeedback) {
            if (sub.type) {
              metaContainer.innerHTML += '<span class="admin-badge-success">Type: ' + sub.type + '</span>';
            }
            if (sub.page) {
              metaContainer.innerHTML += '<span class="admin-badge-neutral">Page: ' + sub.page + '</span>';
            }
            if (sub.rating && sub.rating !== 'Not rated') {
              metaContainer.innerHTML += '<span class="admin-badge-warning">Rating: ' + sub.rating + ' / 5</span>';
            }
          } else if (sub.isCitizenInquiry) {
            if (sub.category) {
              metaContainer.innerHTML += '<span class="admin-badge-info">Category: ' + sub.category + '</span>';
            }
            if (sub.subject) {
              metaContainer.innerHTML += '<span class="admin-badge-neutral">Subject: ' + sub.subject + '</span>';
            }
          }

          var replyBtn = document.getElementById('modal-reply-btn');
          if (sub.email && sub.email.includes('@')) {
            replyBtn.href = 'mailto:' + sub.email + '?subject=RE: JKSPDCL Portal Submission';
            replyBtn.style.display = 'inline-flex';
          } else {
            replyBtn.style.display = 'none';
          }

          modal.classList.remove('hidden');
        } catch (e) {
          console.error('Error opening submission modal:', e);
        }
      });
    });

    function closeModal() {
      if (modal) modal.classList.add('hidden');
    }

    if (modalClose) modalClose.onclick = closeModal;
    if (modalDismiss) modalDismiss.onclick = closeModal;
    if (modal) {
      modal.onclick = function(e) {
        if (e.target === modal) closeModal();
      };
    }
    window.addEventListener('keydown', function(e) {
      if (e.key === 'Escape') closeModal();
    });
  }

  document.addEventListener('astro:page-load', initContactsPage);
  initContactsPage();
</script>
