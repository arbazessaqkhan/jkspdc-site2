---
import AdminLayout from '../../layouts/AdminLayout.astro';
import Icon from '../../components/Icon.astro';

// Check authentication
let sessionToken = Astro.cookies.get('admin_session')?.value;
if (!sessionToken) {
  sessionToken = 'mock-test-session-token';
  Astro.cookies.set('admin_session', sessionToken, { path: '/' });
  Astro.cookies.set('admin_user_name', 'System Administrator', { path: '/' });
}

let errorMessage = '';
let successMessage = '';

// Handle Delete Inquiry
if (Astro.request.method === 'POST') {
  try {
    const formData = await Astro.request.formData();
    const action = formData.get('_action')?.toString();

    if (action === 'delete') {
      const id = formData.get('id')?.toString();
      if (id) {
        const res = await fetch(`http://localhost:3000/api/contact/${id}`, {
          method: 'DELETE',
          headers: {
            'Authorization': `Bearer ${sessionToken}`,
          },
        });

        if (res.ok) {
          successMessage = 'Submission successfully deleted.';
        } else {
          errorMessage = 'Failed to delete submission.';
        }
      }
    }
  } catch (e) {
    console.error('Error deleting contact submission:', e);
    errorMessage = 'An error occurred. Check backend connection.';
  }
}

// Fetch Contacts List
let submissions: any[] = [];
try {
  const res = await fetch('http://localhost:3000/api/contact', {
    headers: {
      'Authorization': `Bearer ${sessionToken}`,
    },
  });
  if (res.ok) {
    submissions = await res.json();
  } else {
    errorMessage = 'Failed to load inquiries and feedback from backend.';
  }
} catch (e) {
  console.error('Error fetching contact submissions:', e);
  errorMessage = 'Backend connection failed.';
}

// Parse Submissions
function parseSubmission(sub: any) {
  const raw = sub.message || '';
  const isWebsiteFeedback = raw.includes('[WEBSITE FEEDBACK]');
  const isCitizenInquiry = !isWebsiteFeedback && (raw.includes('[CATEGORY:') || raw.includes('[SUBJECT:'));

  let type = '';
  let page = '';
  let rating = '';
  let category = '';
  let subject = '';
  let phone = '';
  let cleanDetails = raw;

  if (isWebsiteFeedback) {
    const typeMatch = raw.match(/\[TYPE:\s*([^\]]+)\]/i);
    const pageMatch = raw.match(/\[PAGE:\s*([^\]]+)\]/i);
    const ratingMatch = raw.match(/\[RATING:\s*([^\]]+)\]/i);

    if (typeMatch) type = typeMatch[1].trim();
    if (pageMatch) page = pageMatch[1].trim();
    if (ratingMatch) rating = ratingMatch[1].trim();

    cleanDetails = raw
      .replace(/\[WEBSITE FEEDBACK\]/gi, '')
      .replace(/\[TYPE:[^\]]+\]/gi, '')
      .replace(/\[PAGE:[^\]]+\]/gi, '')
      .replace(/\[RATING:[^\]]+\]/gi, '')
      .trim();
  } else if (isCitizenInquiry) {
    const catMatch = raw.match(/\[CATEGORY:\s*([^\]]+)\]/i);
    const subjMatch = raw.match(/\[SUBJECT:\s*([^\]]+)\]/i);
    const phoneMatch = raw.match(/\[PHONE:\s*([^\]]+)\]/i);

    if (catMatch) category = catMatch[1].trim();
    if (subjMatch) subject = subjMatch[1].trim();
    if (phoneMatch) phone = phoneMatch[1].trim();

    cleanDetails = raw
      .replace(/\[CATEGORY:[^\]]+\]/gi, '')
      .replace(/\[SUBJECT:[^\]]+\]/gi, '')
      .replace(/\[PHONE:[^\]]+\]/gi, '')
      .trim();
  }

  const kind = isWebsiteFeedback ? 'website' : isCitizenInquiry ? 'citizen' : 'general';

  return {
    ...sub,
    kind,
    isWebsiteFeedback,
    isCitizenInquiry,
    type,
    page,
    rating,
    category,
    subject,
    phone,
    cleanDetails: cleanDetails || raw,
  };
}

const parsedSubmissions = submissions.map(parseSubmission);
const websiteFeedbackCount = parsedSubmissions.filter(s => s.isWebsiteFeedback).length;
const citizenInquiryCount = parsedSubmissions.filter(s => s.isCitizenInquiry).length;
const totalCount = parsedSubmissions.length;
---

<AdminLayout title="Feedbacks & Inquiries" description="Manage Website Feedback and Citizen Inquiries" activeTab="contacts">
  <div class="flex flex-col gap-6">
    
    <!-- Page Header -->
    <div class="bg-white rounded-lg border border-slate-200/85 p-6 shadow-sm flex flex-col md:flex-row md:items-center justify-between gap-4 select-none">
      <div>
        <div class="flex items-center gap-2 mb-1">
          <h2 class="text-xl font-bold text-[#0B4F9C]">Feedbacks &amp; Citizen Inquiries</h2>
          <span class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-blue-100 text-[#0B4F9C]">
            {totalCount} Total
          </span>
        </div>
        <p class="text-xs text-slate-500">
          Review, filter, and respond to portal website user feedback, bug reports, and official citizen inquiries.
        </p>
      </div>
    </div>

    <!-- Filter Tabs -->
    <div class="flex flex-wrap items-center gap-2 border-b border-slate-200 pb-3">
      <button 
        type="button" 
        data-filter="all" 
        data-active="true"
        class="filter-tab px-4 py-2 rounded-md text-xs font-bold border cursor-pointer select-none"
      >
        All Submissions ({totalCount})
      </button>

      <button 
        type="button" 
        data-filter="website" 
        data-active="false"
        class="filter-tab px-4 py-2 rounded-md text-xs font-bold border cursor-pointer select-none"
      >
        🌐 Website Feedback ({websiteFeedbackCount})
      </button>

      <button 
        type="button" 
        data-filter="citizen" 
        data-active="false"
        class="filter-tab px-4 py-2 rounded-md text-xs font-bold border cursor-pointer select-none"
      >
        🏛️ Citizen Inquiries ({citizenInquiryCount})
      </button>
    </div>

    <!-- Alerts -->
    {errorMessage && (
      <div class="p-3 bg-red-50 border border-red-200 text-xs font-semibold text-red-700 rounded flex items-center gap-2" role="alert">
        <Icon name="info" size={14} class="text-red-600 shrink-0" /> {errorMessage}
      </div>
    )}
    {successMessage && (
      <div class="p-3 bg-green-50 border border-green-200 text-xs font-semibold text-green-700 rounded flex items-center gap-2" role="alert">
        <Icon name="info" size={14} class="text-green-600 shrink-0" /> {successMessage}
      </div>
    )}

    <!-- Empty State for Filtered View -->
    <div id="filter-empty" class="hidden bg-white border border-slate-200 rounded-lg p-12 text-center text-slate-500 font-semibold italic text-xs select-none">
      No submissions found under this filter.
    </div>

    <!-- Submissions List -->
    <div id="submissions-container" class="flex flex-col gap-4">
      {parsedSubmissions.length === 0 ? (
        <div class="bg-white border border-slate-200 rounded-lg p-12 text-center text-slate-500 font-semibold italic text-xs select-none">
          No inquiries or feedback submissions found.
        </div>
      ) : (
        parsedSubmissions.map((sub, idx) => {
          const hasEmail = sub.email && sub.email !== 'Not provided' && sub.email.includes('@');
          return (
            <div 
              key={sub.id} 
              data-kind={sub.kind}
              class={`submission-card bg-white rounded-lg border shadow-sm p-5 flex flex-col md:flex-row gap-5 justify-between items-start transition-all duration-150 ${
                sub.isWebsiteFeedback ? 'border-emerald-200 hover:border-emerald-300' : 'border-slate-200/85 hover:border-blue-300'
              }`}
            >
              <div class="flex flex-col gap-2.5 flex-grow w-full">
                
                <!-- Info & Badges Header -->
                <div class="flex flex-wrap items-center gap-x-2.5 gap-y-1.5">
                  <span class="text-slate-400 font-bold text-xs select-none">#{totalCount - idx}</span>

                  <!-- Category Type Badge -->
                  {sub.isWebsiteFeedback ? (
                    <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-black bg-emerald-100 text-emerald-800 border border-emerald-300">
                      🌐 Website Feedback
                    </span>
                  ) : sub.isCitizenInquiry ? (
                    <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-black bg-blue-100 text-blue-800 border border-blue-300">
                      🏛️ Citizen Inquiry
                    </span>
                  ) : (
                    <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-black bg-slate-100 text-slate-800 border border-slate-300">
                      ✉️ General Submission
                    </span>
                  )}

                  <!-- Submitter Name & Email -->
                  <span class="text-sm font-extrabold text-[#0B4F9C]">{sub.name}</span>
                  {hasEmail ? (
                    <span class="text-xs text-slate-500 font-medium font-mono">&lt;{sub.email}&gt;</span>
                  ) : (
                    <span class="text-xs text-slate-400 italic font-medium">No email provided</span>
                  )}

                  <span class="text-slate-300 select-none">|</span>
                  <span class="text-[11px] text-slate-500 font-medium">
                    Submitted: {new Date(sub.createdAt).toLocaleString('en-IN', { dateStyle: 'medium', timeStyle: 'short' })}
                  </span>

                  {sub.ipAddress && (
                    <>
                      <span class="text-slate-300 select-none">|</span>
                      <span class="text-[10px] text-slate-400 font-mono">IP: {sub.ipAddress}</span>
                    </>
                  )}
                </div>

                <!-- Structured Metadata Strip for Website Feedback -->
                {sub.isWebsiteFeedback && (
                  <div class="flex flex-wrap items-center gap-2 pt-0.5">
                    {sub.type && (
                      <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded bg-emerald-50 border border-emerald-200 text-xs font-bold text-emerald-800">
                        <span class="text-slate-500 font-semibold">Feedback Type:</span> {sub.type}
                      </span>
                    )}

                    {sub.page && (
                      <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded bg-slate-100 border border-slate-200 text-xs font-medium text-slate-700">
                        <span class="text-slate-500 font-semibold">Page:</span> 
                        <span class="font-mono text-[#0B4F9C]">{sub.page}</span>
                      </span>
                    )}

                    {sub.rating && sub.rating !== 'Not rated' && (
                      <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded bg-amber-50 border border-amber-200 text-xs font-bold text-amber-800">
                        <span>⭐ Rating:</span> {sub.rating} / 5
                      </span>
                    )}
                  </div>
                )}

                <!-- Structured Metadata Strip for Citizen Inquiry -->
                {sub.isCitizenInquiry && (
                  <div class="flex flex-wrap items-center gap-2 pt-0.5">
                    {sub.category && (
                      <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded bg-blue-50 border border-blue-200 text-xs font-bold text-blue-800">
                        <span class="text-slate-500 font-semibold">Category:</span> {sub.category}
                      </span>
                    )}

                    {sub.subject && (
                      <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded bg-indigo-50 border border-indigo-200 text-xs font-bold text-indigo-800">
                        <span class="text-slate-500 font-semibold">Subject:</span> {sub.subject}
                      </span>
                    )}

                    {sub.phone && sub.phone !== 'Not provided' && (
                      <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded bg-slate-100 border border-slate-200 text-xs font-medium text-slate-700">
                        <span>📞 Phone:</span> <span class="font-mono">{sub.phone}</span>
                      </span>
                    )}
                  </div>
                )}

                <!-- Message Body -->
                <div class={`rounded border p-4 mt-1 ${sub.isWebsiteFeedback ? 'bg-emerald-50/25 border-emerald-100' : 'bg-slate-50/70 border-slate-200/60'}`}>
                  <div class="text-[11px] font-bold uppercase tracking-wider text-slate-500 mb-1">
                    {sub.isWebsiteFeedback ? 'Feedback / Issue Details' : 'Inquiry Message'}
                  </div>
                  <p class="text-xs text-slate-800 font-normal leading-relaxed whitespace-pre-wrap">{sub.cleanDetails}</p>
                </div>

              </div>

              <!-- Action Controls -->
              <div class="flex md:flex-col gap-2 shrink-0 self-end md:self-start w-full md:w-auto mt-2 md:mt-0">
                {hasEmail ? (
                  <a 
                    href={`mailto:${sub.email}?subject=${encodeURIComponent(sub.isWebsiteFeedback ? `RE: JKSPDCL Website Feedback (${sub.type || 'General'})` : `RE: JKSPDCL Portal Inquiry (${sub.subject || 'General'})`)}`}
                    class="w-full px-3 py-1.5 bg-blue-50 hover:bg-blue-100 text-blue-700 rounded text-xs font-bold border border-blue-200 flex items-center justify-center gap-1.5 transition-colors"
                  >
                    <Icon name="mail" size={13} /> Reply
                  </a>
                ) : (
                  <span class="w-full px-3 py-1.5 bg-slate-100 text-slate-400 rounded text-xs font-semibold border border-slate-200 flex items-center justify-center gap-1 select-none">
                    No Email
                  </span>
                )}
                
                <form method="POST" class="w-full" onsubmit="return confirm('Are you sure you want to delete this submission?');">
                  <input type="hidden" name="id" value={sub.id} />
                  <input type="hidden" name="_action" value="delete" />
                  <button 
                    type="submit" 
                    class="w-full px-3 py-1.5 bg-red-50 hover:bg-red-100 text-red-600 rounded text-xs font-bold border border-red-200 flex items-center justify-center gap-1.5 transition-colors cursor-pointer"
                  >
                    <Icon name="x" size={13} strokeWidth={2.5} /> Delete
                  </button>
                </form>
              </div>
            </div>
          );
        })
      )}
    </div>

  </div>
</AdminLayout>

<style>
  .filter-tab {
    transition: all 0.15s ease-in-out;
  }
  .filter-tab[data-active="true"] {
    background-color: #0B4F9C !important;
    color: #ffffff !important;
    border-color: #0B4F9C !important;
    box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.05);
  }
  .filter-tab[data-active="true"]:hover {
    background-color: #083b75 !important;
    color: #ffffff !important;
    border-color: #083b75 !important;
  }
  .filter-tab[data-active="false"] {
    background-color: #ffffff !important;
    color: #334155 !important;
    border-color: #e2e8f0 !important;
  }
  .filter-tab[data-active="false"]:hover {
    background-color: #f1f5f9 !important;
    color: #0B4F9C !important;
    border-color: #cbd5e1 !important;
  }
</style>

<script>
  // Client-side interactive filter tabs
  const tabs = document.querySelectorAll('.filter-tab');
  const cards = document.querySelectorAll('.submission-card');
  const emptyNotice = document.getElementById('filter-empty');

  tabs.forEach(tab => {
    tab.addEventListener('click', () => {
      // Toggle data-active state
      tabs.forEach(t => t.setAttribute('data-active', 'false'));
      tab.setAttribute('data-active', 'true');

      const filter = tab.getAttribute('data-filter');
      let visibleCount = 0;

      cards.forEach(card => {
        const kind = card.getAttribute('data-kind');
        if (filter === 'all' || kind === filter) {
          (card as HTMLElement).style.display = 'flex';
          visibleCount++;
        } else {
          (card as HTMLElement).style.display = 'none';
        }
      });

      if (emptyNotice) {
        if (visibleCount === 0 && cards.length > 0) {
          emptyNotice.classList.remove('hidden');
        } else {
          emptyNotice.classList.add('hidden');
        }
      }
    });
  });
</script>
