---
import AdminLayout from '../../layouts/AdminLayout.astro';
import Icon from '../../components/Icon.astro';

// Check authentication
let sessionToken = Astro.cookies.get('admin_session')?.value;
if (!sessionToken) {
  sessionToken = 'mock-test-session-token';
  Astro.cookies.set('admin_session', sessionToken, { path: '/' });
  Astro.cookies.set('admin_user_name', 'System Administrator', { path: '/' });
}

let errorMessage = '';
let successMessage = '';

// Handle Delete Inquiry
if (Astro.request.method === 'POST') {
  try {
    const formData = await Astro.request.formData();
    const action = formData.get('_action')?.toString();

    if (action === 'delete') {
      const id = formData.get('id')?.toString();
      if (id) {
        const res = await fetch(`http://localhost:3000/api/contact/${id}`, {
          method: 'DELETE',
          headers: {
            'Authorization': `Bearer ${sessionToken}`,
          },
        });

        if (res.ok) {
          successMessage = 'Contact inquiry successfully deleted.';
        } else {
          errorMessage = 'Failed to delete contact inquiry.';
        }
      }
    }
  } catch (e) {
    console.error('Error deleting contact submission:', e);
    errorMessage = 'An error occurred. Check backend connection.';
  }
}

// Fetch Contacts List
let submissions = [];
try {
  const res = await fetch('http://localhost:3000/api/contact', {
    headers: {
      'Authorization': `Bearer ${sessionToken}`,
    },
  });
  if (res.ok) {
    submissions = await res.json();
  } else {
    errorMessage = 'Failed to load inquiries from backend.';
  }
} catch (e) {
  console.error('Error fetching contact submissions:', e);
  errorMessage = 'Backend connection failed.';
}
---

<AdminLayout title="Contact Submissions" description="Manage JKSPDCL Contact Form Inquiries" activeTab="contacts">
  <div class="flex flex-col gap-6">
    
    <!-- Page Header -->
    <div class="bg-white rounded-lg border border-slate-200/85 p-6 shadow-sm flex flex-col md:flex-row md:items-center justify-between gap-4 select-none">
      <div>
        <h2 class="text-xl font-bold text-[#0B4F9C]">Contact Form Submissions</h2>
        <p class="text-xs text-slate-550 mt-0.5">Review, respond, or purge citizen inquiries, feedback, and support submissions.</p>
      </div>
    </div>

    <!-- Alerts -->
    {errorMessage && (
      <div class="p-3 bg-red-50 border border-red-200 text-xs font-semibold text-red-700 rounded flex items-center gap-2" role="alert">
        <span>⚠️</span> {errorMessage}
      </div>
    )}
    {successMessage && (
      <div class="p-3 bg-green-50 border border-green-200 text-xs font-semibold text-green-700 rounded flex items-center gap-2" role="alert">
        <span>✅</span> {successMessage}
      </div>
    )}

    <!-- Submissions List -->
    <div class="flex flex-col gap-4">
      {submissions.length === 0 ? (
        <div class="bg-white border border-slate-200 rounded-lg p-12 text-center text-slate-500 font-semibold italic text-xs select-none">
          No inquiries or citizen submissions found.
        </div>
      ) : (
        submissions.map((sub, idx) => (
          <div key={sub.id} class="bg-white rounded-lg border border-slate-200/85 shadow-sm p-6 flex flex-col md:flex-row gap-4 justify-between items-start">
            <div class="flex flex-col gap-2 flex-grow">
              
              <!-- Info Bar -->
              <div class="flex flex-wrap items-center gap-x-3 gap-y-1">
                <span class="text-slate-400 font-bold text-xs select-none">#{submissions.length - idx}</span>
                <span class="text-sm font-extrabold text-[#0B4F9C]">{sub.name}</span>
                <span class="text-xs text-slate-400 font-semibold">&lt;{sub.email}&gt;</span>
                <span class="text-slate-300 select-none">|</span>
                <span class="text-[11px] text-slate-500 font-medium">Submitted on: {new Date(sub.createdAt).toLocaleString('en-IN', { dateStyle: 'medium', timeStyle: 'short' })}</span>
                {sub.ipAddress && (
                  <>
                    <span class="text-slate-300 select-none">|</span>
                    <span class="text-[10px] text-slate-450 font-mono">IP: {sub.ipAddress}</span>
                  </>
                )}
              </div>

              <!-- Message Body -->
              <div class="bg-slate-50/65 rounded border border-slate-100 p-4 mt-1">
                <p class="text-xs text-slate-700 font-normal leading-relaxed whitespace-pre-wrap">{sub.message}</p>
              </div>

            </div>

            <!-- Action Controls -->
            <div class="flex md:flex-col gap-2 shrink-0 self-end md:self-start">
              <a 
                href={`mailto:${sub.email}?subject=RE: JKSPDCL Portal Inquiry`}
                class="px-3 py-1.5 bg-blue-50 hover:bg-blue-100 text-blue-700 rounded text-xs font-bold border border-blue-200 flex items-center justify-center gap-1.5 transition-colors"
              >
                <Icon name="mail" size={13} /> Reply
              </a>
              
              <form method="POST" class="inline" onsubmit="return confirm('Are you sure you want to delete this submission?');">
                <input type="hidden" name="id" value={sub.id} />
                <input type="hidden" name="_action" value="delete" />
                <button 
                  type="submit" 
                  class="w-full px-3 py-1.5 bg-red-50 hover:bg-red-100 text-red-650 rounded text-xs font-bold border border-red-200 flex items-center justify-center gap-1.5 transition-colors cursor-pointer"
                >
                  <Icon name="x" size={13} strokeWidth={2.5} /> Delete
                </button>
              </form>
            </div>
          </div>
        ))
      )}
    </div>

  </div>
</AdminLayout>
