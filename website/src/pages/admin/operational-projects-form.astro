---
import AdminLayout from '../../layouts/AdminLayout.astro';
import FileUploader from '../../components/admin/FileUploader.astro';
import Icon from '../../components/Icon.astro';
import { isAdmin } from '../../utils/roles';
import { parseApiError, BACKEND_URL } from '../../utils/api-error';

// Check authentication
const sessionToken = Astro.cookies.get('admin_session')?.value;
if (!sessionToken) {
  return Astro.redirect('/admin/login');
}

// Role protection: Projects mutation is ADMIN-only
const userRole = Astro.locals.user?.role;
if (!isAdmin(userRole)) {
  return Astro.redirect('/admin/operational-projects');
}

let errorMessage = '';
let successMessage = '';

// Check if we are in Edit Mode
const editId = Astro.url.searchParams.get('id')?.toString();
let projectData = {
  id: '',
  name: '',
  configuration: '',
  designEnergy: '',
  yearOfCommissioning: '',
  capacityMw: '',
  description: '',
  salientFeatures: '',
  sector: 'State',
  basin: 'Chenab',
  documentUrl: '',
};

if (editId) {
  try {
    const res = await fetch(`${BACKEND_URL}/api/projects/${editId}`);
    if (res.ok) {
      const data = await res.json();
      projectData = {
        id: data.id || '',
        name: data.name || '',
        configuration: data.configuration || '',
        designEnergy: data.designEnergy !== null ? data.designEnergy.toString() : '',
        yearOfCommissioning: data.yearOfCommissioning !== null ? data.yearOfCommissioning.toString() : '',
        capacityMw: data.capacityMw !== null ? data.capacityMw.toString() : '',
        description: data.description || '',
        salientFeatures: data.salientFeatures || '',
        sector: data.sector || 'State',
        basin: data.basin || 'Chenab',
        documentUrl: data.documentUrl || '',
      };
    } else {
      const apiErr = await parseApiError(res, 'load project details for editing');
      if (apiErr.isUnauthorized) {
        return Astro.redirect('/admin/login');
      }
      errorMessage = apiErr.message;
    }
  } catch (e) {
    console.error('Error fetching project for edit:', e);
    errorMessage = 'Network failure: Unable to connect to the backend server.';
  }
}

function getProjectPhotoPreviewUrl(name: string, docUrl?: string | null): string {
  if (docUrl && docUrl.trim() !== '') {
    // Always return the full backend URL for uploaded files so the <img> preview loads correctly
    if (BACKEND_URL && docUrl.startsWith(`${BACKEND_URL}/uploads/`)) return docUrl;
    if (docUrl.startsWith('/uploads/')) return `${BACKEND_URL}${docUrl}`;
    return docUrl;
  }
  if (!name) return '';
  const slug = name.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
  if (slug === 'ganderbal' || slug === 'ushp-i' || slug === 'sewa-iii') {
    return `/projects/${slug}.png`;
  }
  if (['bhaderwah', 'bhep-i', 'bhep-ii', 'chep-i', 'chep-ii', 'chep-iii', 'karnah', 'ljhp', 'mhep-pahalgam', 'ushp-ii', 'ushp-ll'].includes(slug)) {
    return `/projects/${slug}.jpg`;
  }
  return '';
}

const existingPhotoUrl = getProjectPhotoPreviewUrl(projectData.name, projectData.documentUrl);

// Handle Form Submission
if (Astro.request.method === 'POST') {
  try {
    const formData = await Astro.request.formData();
    const id = formData.get('id')?.toString();
    const name = formData.get('name')?.toString();
    const configuration = formData.get('configuration')?.toString();
    const designEnergy = formData.get('designEnergy')?.toString();
    const yearOfCommissioning = formData.get('yearOfCommissioning')?.toString();
    const capacityMw = formData.get('capacityMw')?.toString();
    const description = formData.get('description')?.toString();
    const salientFeatures = formData.get('salientFeatures')?.toString();
    const sector = formData.get('sector')?.toString();
    const basin = formData.get('basin')?.toString();
    const documentUrl = formData.get('documentUrl')?.toString();

    // Populate data back to form to preserve inputs in case of validation error (GIGW mandate)
    projectData = {
      id: id || '',
      name: name || '',
      configuration: configuration || '',
      designEnergy: designEnergy || '',
      yearOfCommissioning: yearOfCommissioning || '',
      capacityMw: capacityMw || '',
      description: description || '',
      salientFeatures: salientFeatures || '',
      sector: sector || 'State',
      basin: basin || 'Chenab',
      documentUrl: documentUrl || '',
    };

    if (!name || !capacityMw) {
      errorMessage = 'Project Name and Installed Capacity are required.';
    } else {
      const body = {
        name,
        type: 'Hydroelectric',
        capacityMw: parseFloat(capacityMw),
        status: 'Operational',
        location: 'J&K Region', // Default location
        configuration: configuration || null,
        designEnergy: designEnergy ? parseFloat(designEnergy) : null,
        yearOfCommissioning: yearOfCommissioning ? parseInt(yearOfCommissioning, 10) : null,
        sector: sector || 'State',
        basin: basin || 'Chenab',
        description: description || null,
        salientFeatures: salientFeatures || null,
        documentUrl: (documentUrl && BACKEND_URL && documentUrl.startsWith(`${BACKEND_URL}/uploads/`))
          ? documentUrl.replace(BACKEND_URL, '')
          : (documentUrl || null),
      };

      const url = id 
        ? `${BACKEND_URL}/api/projects/${id}` 
        : `${BACKEND_URL}/api/projects`;
      
      const method = id ? 'PUT' : 'POST';

      const res = await fetch(url, {
        method,
        headers: {
          'Content-Type': 'application/json',
          'Authorization': `Bearer ${sessionToken}`,
        },
        body: JSON.stringify(body),
      });

      if (res.ok) {
        return Astro.redirect('/admin/operational-projects');
      } else {
        const apiErr = await parseApiError(res, id ? 'update operational project' : 'register operational project');
        if (apiErr.isUnauthorized) {
          return Astro.redirect('/admin/login');
        }
        errorMessage = apiErr.message;
      }
    }
  } catch (e) {
    console.error('Error saving operational project:', e);
    errorMessage = 'Network failure: Unable to communicate with the backend server.';
  }
}
---

<AdminLayout 
  title={editId ? `Edit Operational Project: ${projectData.name}` : 'Add Operational Project'} 
  description="Configure operational specifications, river basin, sector, and capacity attributes." 
  activeTab="operational"
>
  <div class="flex flex-col gap-5">
    
    <!-- Standard Admin Page Header -->
    <div class="admin-page-header">
      <div>
        <h1 class="text-lg font-extrabold text-[color:var(--adm-primary)] tracking-tight">
          {editId ? `Edit ${projectData.name}` : 'Register Power Station'}
        </h1>
        <p class="text-xs text-slate-500 mt-0.5">
          Configure operational specifications, river basin, sector, and capacity attributes.
        </p>
      </div>
      <a 
        href="/admin/operational-projects"
        class="admin-btn admin-btn-secondary text-xs py-2 px-3.5 flex items-center gap-1.5"
      >
        <span>&larr; Back to Projects</span>
      </a>
    </div>

    <!-- Alerts -->
    {errorMessage && (
      <div class="p-3 bg-red-50 border border-red-200 text-xs font-semibold text-red-700 rounded flex items-center gap-2" role="alert">
        <Icon name="info" size={14} class="text-red-600 shrink-0" /> {errorMessage}
      </div>
    )}

    <!-- Form Container -->
    <form method="POST" id="operational-project-form" class="space-y-6">
      <input type="hidden" name="id" value={projectData.id} />

      <div class="admin-form-card">
        <div class="admin-form-card-header">
          General Specifications
        </div>
        <div class="admin-form-card-body grid grid-cols-1 md:grid-cols-2 gap-4">
          
          <div class="form-group">
            <label for="name" class="form-label">Name of Power House <span class="text-red-500">*</span></label>
            <input type="text" name="name" id="name" value={projectData.name} class="form-input text-xs" required placeholder="e.g. Baglihar Hydroelectric Project" />
          </div>

          <div class="form-group">
            <label for="configuration" class="form-label">Configuration</label>
            <input type="text" name="configuration" id="configuration" value={projectData.configuration} class="form-input text-xs" placeholder="e.g. 3x150MW" />
          </div>

          <div class="form-group">
            <label for="capacityMw" class="form-label">Installed Capacity in MW <span class="text-red-500">*</span></label>
            <input type="number" step="0.01" name="capacityMw" id="capacityMw" value={projectData.capacityMw} class="form-input text-xs" required placeholder="e.g. 900.00" />
          </div>

          <div class="form-group">
            <label for="designEnergy" class="form-label">Design Energy (MU)</label>
            <input type="number" step="0.01" name="designEnergy" id="designEnergy" value={projectData.designEnergy} class="form-input text-xs" placeholder="e.g. 2600.00" />
          </div>

          <div class="form-group">
            <label for="yearOfCommissioning" class="form-label">Year of Commissioning</label>
            <input type="number" name="yearOfCommissioning" id="yearOfCommissioning" value={projectData.yearOfCommissioning} class="form-input text-xs" placeholder="e.g. 2008" />
          </div>

          <div class="form-group">
            <label for="sector" class="form-label">Sector</label>
            <select name="sector" id="sector" class="form-select text-xs">
              <option value="State" selected={projectData.sector === 'State'}>State Sector</option>
              <option value="JV" selected={projectData.sector === 'JV'}>Joint Venture (JV)</option>
            </select>
          </div>

          <div class="form-group">
            <label for="basin" class="form-label">River Basin</label>
            <select name="basin" id="basin" class="form-select text-xs">
              <option value="Chenab" selected={projectData.basin === 'Chenab'}>Chenab Basin</option>
              <option value="Jhelum" selected={projectData.basin === 'Jhelum'}>Jhelum Basin</option>
              <option value="Ravi" selected={projectData.basin === 'Ravi'}>Ravi Basin</option>
              <option value="Indus" selected={projectData.basin === 'Indus'}>Indus Basin</option>
            </select>
          </div>

          <div class="form-group col-span-1 md:col-span-2">
            <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-2">
              Project Photograph (Image Upload &amp; Preview)
            </label>
            <div class="p-4 bg-slate-50 border border-slate-200 rounded-xl">
              <FileUploader
                id="project-image"
                label="Project Photograph"
                variant="image"
                accept="image/jpeg,image/png,image/webp,image/gif"
                helpText="Supported formats: JPG, PNG, WEBP. Max size: 10 MB."
                maxSizeMB={10}
                existingUrl={existingPhotoUrl}
              />
              <input type="hidden" name="documentUrl" id="documentUrl" value={projectData.documentUrl || (existingPhotoUrl && !(BACKEND_URL && existingPhotoUrl.startsWith(BACKEND_URL)) ? existingPhotoUrl : '')} />
            </div>
          </div>
        </div>
      </div>

      <!-- Section: Detailed Descriptions -->
      <div>
        <h3 class="text-xs font-bold text-[color:var(--adm-primary)] uppercase tracking-wider border-b border-slate-100 pb-2 mb-4">Detailed Content</h3>
        
        <div class="flex flex-col gap-6">
          <div class="space-y-1.5">
            <label class="block text-xs font-bold text-slate-800 uppercase tracking-wider">
              About Project (Description)
            </label>
            <input type="hidden" name="description" id="field-description" value={projectData.description || ''} />
            <div data-rich-editor="field-description" data-placeholder="Detailed description of the project history, site, operational status..." class="bg-white rounded-lg border border-slate-300 h-44 max-h-44 overflow-hidden text-xs"></div>
          </div>

          <div class="space-y-1.5">
            <label class="block text-xs font-bold text-slate-800 uppercase tracking-wider">
              Salient Features (Details / Summary)
            </label>
            <input type="hidden" name="salientFeatures" id="field-salientFeatures" value={projectData.salientFeatures || ''} />
            <div data-rich-editor="field-salientFeatures" data-placeholder="Salient features including water conductor system, dam specs, powerhouse specifics..." class="bg-white rounded-lg border border-slate-300 h-56 max-h-56 overflow-hidden text-xs"></div>
          </div>
        </div>
      </div>

      <!-- Save controls -->
      <div class="flex justify-end gap-3 border-t border-slate-100 pt-6 mt-2">
        <a href="/admin/operational-projects" class="admin-btn admin-btn-secondary">Cancel</a>
        <button type="submit" class="admin-btn admin-btn-primary cursor-pointer">
          {editId ? 'Update Power Station' : 'Create Power Station'}
        </button>
      </div>
    </form>
  </div>

  <script define:vars={{ sessionToken, backendUrl: BACKEND_URL }}>
    // Unified uploader: 'project-image-input' (validated by shared controller)
    // fires 'change' here; we upload and store the returned URL.
    const documentUrlInput = document.getElementById('documentUrl');
    const imageFileInput = document.getElementById('project-image-input');

    function removePhoto() {
      if (documentUrlInput) documentUrlInput.value = '';
      if (imageFileInput) imageFileInput.value = '';
    }

    imageFileInput?.addEventListener('change', async (event) => {
      const file = event.target?.files?.[0];
      if (!file) return;

      const formData = new FormData();
      formData.append('file', file);

      try {
        const response = await fetch(`${backendUrl}/api/upload`, {
          method: 'POST',
          headers: {
            'Authorization': `Bearer ${sessionToken}`,
          },
          body: formData,
        });

        if (!response.ok) {
          if (response.status === 401) {
            window.location.href = '/admin/login';
            return;
          }
          if (response.status === 403) {
            alert('Access Denied: You do not have permission to upload files.');
            removePhoto();
            return;
          }
          const err = await response.json().catch(() => ({}));
          throw new Error(err.message || 'Upload failed');
        }

        const result = await response.json();
        const serverUrl = (backendUrl && result.url.startsWith(`${backendUrl}/uploads/`))
          ? result.url.replace(backendUrl, '')
          : result.url;
        // Store relative URL in hidden input for form submission
        if (documentUrlInput) documentUrlInput.value = serverUrl;
        // Reflect the uploaded (not local) URL into the shared preview
        const previewImg = document.getElementById('project-image-preview-img');
        if (previewImg) {
          previewImg.src = serverUrl.startsWith('/uploads/') ? `${backendUrl}${serverUrl}` : serverUrl;
        }
      } catch (err) {
        alert(`Upload error: ${err.message}`);
        removePhoto();
      }
    });

    // Remove action from the unified uploader
    imageFileInput?.addEventListener('uploader:cleared', () => {
      if (documentUrlInput) documentUrlInput.value = '';
    });
  </script>
</AdminLayout>
