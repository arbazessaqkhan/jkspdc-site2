---
import '../../styles/global.css';
import Icon from '../../components/Icon.astro';

let errorMessage = '';
const preferredLang = 'en';

if (Astro.request.method === 'POST') {
  try {
    const data = await Astro.request.formData();
    const email = data.get('email')?.toString();
    const password = data.get('password')?.toString();

    if (!email || !password) {
      errorMessage = 'Email and password are required.';
    } else {
      // Send login request to NestJS backend
      const response = await fetch('http://localhost:3000/api/auth/login', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email, password }),
      });

      if (!response.ok) {
        const errData = await response.json().catch(() => ({}));
        errorMessage = errData.message || 'Invalid email or password.';
      } else {
        const sessionData = await response.json();
        
        // Set the secure cookie
        Astro.cookies.set('admin_session', sessionData.token, {
          path: '/',
          httpOnly: true,
          secure: false, // set to true in production with HTTPS
          sameSite: 'lax',
          maxAge: 60 * 60 * 2, // 2 hours
        });

        // Store user info in cookies (non-sensitive) so Astro can read it on next request
        Astro.cookies.set('admin_user_name', sessionData.user.name, {
          path: '/',
          httpOnly: false,
          maxAge: 60 * 60 * 2,
        });

        return Astro.redirect('/admin/dashboard');
      }
    }
  } catch (error) {
    console.error('Error logging in:', error);
    errorMessage = 'An error occurred during login. Please ensure the backend server is running.';
  }
}

// Redirect to dashboard if session cookie is already present
const sessionToken = Astro.cookies.get('admin_session')?.value;
if (sessionToken) {
  return Astro.redirect('/admin/dashboard');
}

const currentYear = new Date().getFullYear();
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login | JKSPDCL Administrative Portal</title>
    <meta name="description" content="Administrative login page for the Jammu & Kashmir State Power Development Corporation Limited." />
    <meta name="robots" content="noindex, nofollow" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <link rel="icon" type="image/png" href="/logo.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

    <style is:global>
      .high-contrast,
      .high-contrast * {
        background-color: #000000 !important;
        background-image: none !important;
        color: #ffff00 !important;
        border-color: #ffff00 !important;
        box-shadow: none !important;
      }
      .high-contrast input {
        border: 2px solid #ffff00 !important;
        background: black !important;
        color: #ffff00 !important;
      }
      .high-contrast button {
        background-color: #ffff00 !important;
        color: #000000 !important;
        font-weight: bold !important;
        text-decoration: none !important;
      }
      .high-contrast button:hover {
        background-color: #333333 !important;
        color: #ffffff !important;
      }
      *:focus-visible {
        outline: 3px solid #106EE9;
        outline-offset: 2px;
      }
    </style>
    <script is:inline>
      function toggleHighContrast() {
        var html = document.documentElement;
        var isDark = html.classList.toggle('high-contrast');
        try {
          localStorage.setItem('high-contrast', isDark ? 'true' : 'false');
        } catch (e) {}
      }

      (function() {
        try {
          var savedContrast = localStorage.getItem('high-contrast');
          if (savedContrast === 'true') {
            document.documentElement.classList.add('high-contrast');
          }
        } catch (e) {}
      })();
    </script>
  </head>
  <body class="min-h-screen flex flex-col bg-slate-50 text-slate-800 font-sans transition-colors duration-150">
    <a href="#main-login-content" class="absolute top-[-100px] left-0 bg-[#0B4F9C] text-white p-3 z-50 focus:top-0 focus:outline-none">Skip to Content</a>

    <!-- Top utility accessibility bar -->
    <div class="bg-[#083B73] text-slate-100 text-xs py-2 select-none">
      <div class="max-w-4xl mx-auto px-4 flex justify-between items-center">
        <span class="font-bold tracking-wide uppercase">JKSPDCL Official Portal</span>
        <button class="flex items-center gap-1.5 px-2 py-0.5 bg-[#0B4F9C]/40 hover:bg-[#0B4F9C]/60 rounded text-[10px] font-semibold text-white cursor-pointer" onclick="toggleHighContrast()" aria-label="Toggle High Contrast Mode">
          <Icon name="contrast" size={12} strokeWidth={2} /> Contrast
        </button>
      </div>
    </div>

    <!-- Login Content -->
    <main id="main-login-content" class="flex-grow flex items-center justify-center px-4 py-16" tabindex="-1">
      <div class="w-full max-w-md bg-white rounded-lg border border-slate-200 shadow-xl p-8 flex flex-col gap-6 relative overflow-hidden">
        
        <!-- Header -->
        <div class="text-center flex flex-col items-center gap-2">
          <img src="/logo.png" alt="JKSPDCL Logo" class="h-16 w-auto object-contain mb-1" />
          <h1 class="text-xl font-bold text-[#0B4F9C]">Administrative Sign In</h1>
          <p class="text-xs text-slate-500 font-medium">Jammu &amp; Kashmir State Power Development Corporation Limited</p>
        </div>

        <!-- Alert messages -->
        {errorMessage && (
          <div class="p-3 bg-red-50 text-red-700 rounded border border-red-200 text-xs font-semibold flex items-start gap-2" role="alert">
            <span class="text-red-500 shrink-0 font-bold">⚠️</span>
            <span>{errorMessage}</span>
          </div>
        )}

        <!-- Form -->
        <form method="POST" class="flex flex-col gap-4">
          <div class="flex flex-col gap-1.5">
            <label for="email" class="text-xs font-bold text-slate-700">Official Email ID <span class="text-red-500">*</span></label>
            <input 
              type="email" 
              name="email" 
              id="email" 
              placeholder="e.g. admin@jkspdc.co.in" 
              class="w-full text-xs px-3 py-2.5 rounded border border-slate-350 bg-white focus:border-[#0B4F9C] focus:outline-none transition-colors"
              required 
              autocomplete="email"
            />
          </div>

          <div class="flex flex-col gap-1.5">
            <label for="password" class="text-xs font-bold text-slate-700">Secure Password <span class="text-red-500">*</span></label>
            <input 
              type="password" 
              name="password" 
              id="password" 
              placeholder="••••••••" 
              class="w-full text-xs px-3 py-2.5 rounded border border-slate-350 bg-white focus:border-[#0B4F9C] focus:outline-none transition-colors"
              required 
              autocomplete="current-password"
            />
          </div>

          <button 
            type="submit" 
            class="w-full bg-[#0B4F9C] hover:bg-[#084A8F] text-white py-2.5 rounded text-xs font-bold shadow-md cursor-pointer transition-colors mt-2"
          >
            Authenticate Credentials
          </button>
        </form>

        <div class="border-t border-slate-100 pt-4 text-center">
          <a href="/" class="text-xs text-[#0B4F9C] hover:underline font-semibold flex items-center justify-center gap-1.5">
            &larr; Back to Public Portal
          </a>
        </div>
      </div>
    </main>

    <!-- Footer -->
    <footer class="bg-[#083B73] text-slate-300 py-6 text-xs text-center border-t border-slate-700 select-none">
      <div class="max-w-4xl mx-auto px-4">
        <p>&copy; {currentYear} Jammu &amp; Kashmir State Power Development Corporation Limited. Administrative Session.</p>
        <p class="text-[10px] text-slate-400 mt-1">GIGW 3.0 &amp; WCAG 2.2 Level AA Compliant Interface.</p>
      </div>
    </footer>
  </body>
</html>
