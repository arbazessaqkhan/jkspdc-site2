---
import AdminLayout from '../../layouts/AdminLayout.astro';
import Icon from '../../components/Icon.astro';

// Check authentication
let sessionToken = Astro.cookies.get('admin_session')?.value;
if (!sessionToken) {
  sessionToken = 'mock-test-session-token';
  Astro.cookies.set('admin_session', sessionToken, { path: '/' });
  Astro.cookies.set('admin_user_name', 'System Administrator', { path: '/' });
}

let errorMessage = '';
let successMessage = '';

// Handle POST actions
if (Astro.request.method === 'POST') {
  try {
    const formData = await Astro.request.formData();
    const action = formData.get('_action')?.toString();

    if (action === 'create' || action === 'update') {
      const id = formData.get('id')?.toString();
      const name = formData.get('name')?.toString();
      const position = formData.get('position')?.toString();
      const subTitle = formData.get('subTitle')?.toString();
      const role = formData.get('role')?.toString();
      const sNo = formData.get('sNo')?.toString();
      const imageUrl = formData.get('imageUrl')?.toString();
      const iasBatch = formData.get('iasBatch')?.toString();
      const education = formData.get('education')?.toString();
      const officeLocation = formData.get('officeLocation')?.toString();
      const description = formData.get('description')?.toString();
      const keyResponsibilities = formData.get('keyResponsibilities')?.toString();

      if (!name || !position || !role || !sNo) {
        errorMessage = 'Name, Designation, Role, and S No. are required.';
      } else {
        const body = {
          name,
          position,
          subTitle: subTitle || null,
          role,
          sNo: parseInt(sNo, 10),
          imageUrl: imageUrl || null,
          iasBatch: iasBatch || null,
          education: education || null,
          officeLocation: officeLocation || null,
          description: description || null,
          keyResponsibilities: keyResponsibilities || null,
        };

        let res;
        if (action === 'create') {
          res = await fetch('http://localhost:3000/api/dignitaries', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              'Authorization': `Bearer ${sessionToken}`,
            },
            body: JSON.stringify(body),
          });
        } else {
          res = await fetch(`http://localhost:3000/api/dignitaries/${id}`, {
            method: 'PUT',
            headers: {
              'Content-Type': 'application/json',
              'Authorization': `Bearer ${sessionToken}`,
            },
            body: JSON.stringify(body),
          });
        }

        if (res.ok) {
          successMessage = `Dignitary successfully ${action === 'create' ? 'added' : 'updated'}.`;
        } else {
          const errData = await res.json().catch(() => ({}));
          errorMessage = errData.message || 'Failed to save dignitary.';
        }
      }
    } else if (action === 'delete') {
      const id = formData.get('id')?.toString();
      if (id) {
        const res = await fetch(`http://localhost:3000/api/dignitaries/${id}`, {
          method: 'DELETE',
          headers: {
            'Authorization': `Bearer ${sessionToken}`,
          },
        });

        if (res.ok) {
          successMessage = 'Dignitary successfully removed.';
        } else {
          errorMessage = 'Failed to remove dignitary.';
        }
      }
    }
  } catch (e) {
    console.error('Error handling dignitary post:', e);
    errorMessage = 'An error occurred. Check backend connection.';
  }
}

// Fetch list of dignitaries
let dignitaries = [];
try {
  const res = await fetch('http://localhost:3000/api/dignitaries');
  if (res.ok) {
    dignitaries = await res.json();
    dignitaries.sort((a: any, b: any) => a.sNo - b.sNo);
  } else {
    errorMessage = 'Failed to load dignitaries from backend.';
  }
} catch (e) {
  console.error('Error fetching dignitaries:', e);
  errorMessage = 'Backend server connection failed.';
}
---

<AdminLayout title="Dignitaries Management" description="Manage JKSPDCL state dignitaries and corporate leadership profiles." activeTab="dignitaries">
  <div class="flex flex-col gap-6">
    
    <!-- Header banner -->
    <div class="bg-white rounded-lg border border-slate-200/85 p-6 shadow-sm flex flex-col md:flex-row md:items-center justify-between gap-4">
      <div>
        <h2 class="text-xl font-bold text-[#0B4F9C]">JKSPDCL Dignitaries Management</h2>
        <p class="text-xs text-slate-500">Add, edit, or remove state dignitaries. Configured profiles automatically generate public profile pages.</p>
      </div>
      <button 
        id="open-add-modal" 
        class="btn-primary flex items-center gap-1.5 self-start md:self-auto cursor-pointer"
        aria-haspopup="dialog"
      >
        <Icon name="plus" size={14} /> Add New Dignitary
      </button>
    </div>

    <!-- Feedback messages -->
    {errorMessage && (
      <div class="alert-error" role="alert">
        <span class="font-bold">Error:</span> {errorMessage}
      </div>
    )}
    {successMessage && (
      <div class="alert-success" role="alert">
        <span class="font-bold">Success:</span> {successMessage}
      </div>
    )}

    <!-- Table -->
    <div class="bg-white rounded-xl border border-slate-200/85 shadow-md overflow-hidden max-w-6xl mx-auto w-full">
      <div class="table-wrapper">
        <table class="table-data min-w-full divide-y divide-slate-200/60">
          <thead>
            <tr class="bg-slate-50">
              <th scope="col" class="w-14 text-center py-3.5 text-xs font-bold uppercase tracking-wider text-slate-500">#</th>
              <th scope="col" class="px-4 py-3.5 text-left text-xs font-bold uppercase tracking-wider text-slate-500">Dignitary Photo &amp; Name</th>
              <th scope="col" class="px-4 py-3.5 text-left text-xs font-bold uppercase tracking-wider text-slate-500">Designation &amp; Subtitle</th>
              <th scope="col" class="px-4 py-3.5 text-left text-xs font-bold uppercase tracking-wider text-slate-500">Classification Badge</th>
              <th scope="col" class="px-4 py-3.5 text-left text-xs font-bold uppercase tracking-wider text-slate-500">Service &amp; Qualifications</th>
              <th scope="col" class="px-4 py-3.5 text-center text-xs font-bold uppercase tracking-wider text-slate-500 w-36">Actions</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100 bg-white">
            {dignitaries.length === 0 ? (
              <tr>
                <td colspan="6" class="px-6 py-12 text-center text-slate-400 text-xs italic">
                  No dignitaries found in database. Click "Add New Dignitary" to add one.
                </td>
              </tr>
            ) : (
              dignitaries.map((dig: any) => {
                const initials = dig.name
                  ? dig.name
                      .replace(/Shri\s*|Smt\s*|Dr\s*|Er\s*|\(IAS\)/gi, '')
                      .trim()
                      .split(' ')
                      .map((n: string) => n[0])
                      .join('')
                      .toUpperCase()
                      .slice(0, 2)
                  : 'DG';

                return (
                  <tr class="hover:bg-slate-50/80 transition-colors">
                    <td class="py-4 text-center text-xs font-bold text-slate-600">{dig.sNo}</td>
                    <td class="px-4 py-4">
                      <div class="flex items-center gap-3">
                        {dig.imageUrl ? (
                          <img src={dig.imageUrl} alt={dig.name} class="w-10 h-10 rounded-full object-cover object-top border border-slate-200 shrink-0" />
                        ) : (
                          <div class="w-10 h-10 rounded-full bg-slate-100 border border-slate-200 flex items-center justify-center text-xs font-extrabold text-[#0B4F9C] shrink-0">
                            {initials}
                          </div>
                        )}
                        <div>
                          <p class="font-bold text-slate-800 text-xs">{dig.name}</p>
                          <p class="text-[10px] text-slate-400 mt-0.5">S.No: {dig.sNo}</p>
                        </div>
                      </div>
                    </td>
                    <td class="px-4 py-4 max-w-xs">
                      <p class="text-xs text-slate-700 leading-snug font-bold">{dig.position}</p>
                      {dig.subTitle && <p class="text-[11px] text-slate-500 mt-0.5 font-medium">{dig.subTitle}</p>}
                    </td>
                    <td class="px-4 py-4">
                      <span class="inline-block px-2.5 py-1 text-[10px] font-extrabold tracking-wide uppercase rounded-full bg-emerald-50 text-emerald-700 border border-emerald-200">
                        {dig.role}
                      </span>
                    </td>
                    <td class="px-4 py-4 text-xs text-slate-600">
                      <p class="font-semibold text-slate-700">{dig.iasBatch || '—'}</p>
                      <p class="text-[10px] text-slate-400">{dig.education || '—'}</p>
                    </td>
                    <td class="px-4 py-4 text-center">
                      <div class="flex items-center justify-center gap-2">
                        <button
                          type="button"
                          class="btn-edit cursor-pointer edit-dignitary-btn px-2.5 py-1 text-xs font-semibold text-slate-700 bg-slate-100 hover:bg-slate-200 rounded border border-slate-300"
                          data-id={dig.id}
                          data-name={dig.name}
                          data-position={dig.position}
                          data-subtitle={dig.subTitle || ''}
                          data-role={dig.role}
                          data-sno={dig.sNo}
                          data-imageurl={dig.imageUrl || ''}
                          data-iasbatch={dig.iasBatch || ''}
                          data-education={dig.education || ''}
                          data-officelocation={dig.officeLocation || ''}
                          data-description={dig.description || ''}
                          data-keyresponsibilities={dig.keyResponsibilities || ''}
                        >
                          Edit
                        </button>
                        <form method="POST" class="inline-block" onsubmit="return confirm('Are you sure you want to delete this dignitary?');">
                          <input type="hidden" name="_action" value="delete" />
                          <input type="hidden" name="id" value={dig.id} />
                          <button
                            type="submit"
                            class="btn-delete cursor-pointer px-2.5 py-1 text-xs font-semibold text-red-600 bg-red-50 hover:bg-red-100 rounded border border-red-200"
                          >
                            Delete
                          </button>
                        </form>
                      </div>
                    </td>
                  </tr>
                );
              })
            )}
          </tbody>
        </table>
      </div>
    </div>

    <!-- Modal for Add / Edit Dignitary -->
    <div id="dignitary-modal" class="fixed inset-0 bg-slate-900/60 backdrop-blur-xs z-50 flex items-center justify-center p-4 hidden">
      <div class="bg-white rounded-xl shadow-2xl border border-slate-200 w-full max-w-2xl overflow-hidden animate-fadeInUp my-6 max-h-[90vh] flex flex-col">
        <div class="px-6 py-4 border-b border-slate-100 flex items-center justify-between bg-slate-50/80 shrink-0">
          <h3 id="modal-title" class="font-bold text-slate-800 text-sm">Add New Dignitary</h3>
          <button type="button" id="close-modal" class="text-slate-400 hover:text-slate-600 p-1 text-base font-bold">
            &times;
          </button>
        </div>
        
        <form method="POST" class="p-6 space-y-4 overflow-y-auto flex-1">
          <input type="hidden" name="_action" id="modal-action" value="create" />
          <input type="hidden" name="id" id="modal-id" value="" />

          <div class="grid grid-cols-3 gap-4">
            <div>
              <label for="sNo" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">
                Serial Order (S.No) <span class="text-red-500">*</span>
              </label>
              <input 
                type="number" 
                name="sNo" 
                id="field-sNo" 
                required 
                min="1" 
                value="1" 
                class="w-full px-3 py-2 text-xs border border-slate-300 rounded-md focus:ring-2 focus:ring-blue-500 focus:outline-none"
              />
            </div>
            <div class="col-span-2">
              <label for="name" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">
                Dignitary Full Name <span class="text-red-500">*</span>
              </label>
              <input 
                type="text" 
                name="name" 
                id="field-name" 
                required 
                placeholder="e.g. Shri Ashwani Kumar (IAS)" 
                class="w-full px-3 py-2 text-xs border border-slate-300 rounded-md focus:ring-2 focus:ring-blue-500 focus:outline-none"
              />
            </div>
          </div>

          <div class="grid grid-cols-2 gap-4">
            <div>
              <label for="position" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">
                Designation / Title <span class="text-red-500">*</span>
              </label>
              <input 
                type="text" 
                name="position" 
                id="field-position" 
                required 
                placeholder="e.g. Financial Commissioner (ACS)" 
                class="w-full px-3 py-2 text-xs border border-slate-300 rounded-md focus:ring-2 focus:ring-blue-500 focus:outline-none"
              />
            </div>
            <div>
              <label for="subTitle" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">
                Department / Sub-title
              </label>
              <input 
                type="text" 
                name="subTitle" 
                id="field-subTitle" 
                placeholder="e.g. Power Development Department, J&K" 
                class="w-full px-3 py-2 text-xs border border-slate-300 rounded-md focus:ring-2 focus:ring-blue-500 focus:outline-none"
              />
            </div>
          </div>

          <div class="grid grid-cols-2 gap-4">
            <div>
              <label for="role" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">
                Classification Badge <span class="text-red-500">*</span>
              </label>
              <input 
                type="text" 
                name="role" 
                id="field-role" 
                required 
                placeholder="e.g. CHAIRMAN / HONORABLE LIEUTENANT GOVERNOR" 
                class="w-full px-3 py-2 text-xs border border-slate-300 rounded-md focus:ring-2 focus:ring-blue-500 focus:outline-none"
              />
            </div>
            <div>
              <label for="imageUrl" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">
                Photo URL / Asset Path
              </label>
              <input 
                type="text" 
                name="imageUrl" 
                id="field-imageUrl" 
                placeholder="e.g. /dignitaries/ashwani_kumar.png" 
                class="w-full px-3 py-2 text-xs border border-slate-300 rounded-md focus:ring-2 focus:ring-blue-500 focus:outline-none"
              />
            </div>
          </div>

          <div class="grid grid-cols-3 gap-4">
            <div>
              <label for="iasBatch" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">
                IAS Batch / Cadre
              </label>
              <input 
                type="text" 
                name="iasBatch" 
                id="field-iasBatch" 
                placeholder="e.g. 1992 (AGMUT Cadre)" 
                class="w-full px-3 py-2 text-xs border border-slate-300 rounded-md focus:ring-2 focus:ring-blue-500 focus:outline-none"
              />
            </div>
            <div>
              <label for="education" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">
                Education
              </label>
              <input 
                type="text" 
                name="education" 
                id="field-education" 
                placeholder="e.g. B.E. (Elec.), M.A. (Duke)" 
                class="w-full px-3 py-2 text-xs border border-slate-300 rounded-md focus:ring-2 focus:ring-blue-500 focus:outline-none"
              />
            </div>
            <div>
              <label for="officeLocation" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">
                Office Location
              </label>
              <input 
                type="text" 
                name="officeLocation" 
                id="field-officeLocation" 
                placeholder="e.g. Civil Secretariat, J&K" 
                class="w-full px-3 py-2 text-xs border border-slate-300 rounded-md focus:ring-2 focus:ring-blue-500 focus:outline-none"
              />
            </div>
          </div>

          <div>
            <label for="description" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">
              Biography / Official Description (Rich Text Editor)
            </label>
            <input type="hidden" name="description" id="field-description" value="" />
            <div data-rich-editor="field-description" data-placeholder="Detailed biographical paragraphs (supports bold, lists, headings)..." class="bg-white rounded-md border border-slate-300 min-h-[140px] text-xs"></div>
          </div>

          <div>
            <label for="keyResponsibilities" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">
              Key Responsibilities &amp; Portfolio (Rich Text Editor)
            </label>
            <input type="hidden" name="keyResponsibilities" id="field-keyResponsibilities" value="" />
            <div data-rich-editor="field-keyResponsibilities" data-placeholder="Key responsibilities and bullet points..." class="bg-white rounded-md border border-slate-300 min-h-[120px] text-xs"></div>
          </div>

          <div class="pt-4 border-t border-slate-100 flex items-center justify-end gap-2 shrink-0">
            <button 
              type="button" 
              id="cancel-modal" 
              class="px-4 py-2 text-xs font-semibold text-slate-600 hover:bg-slate-100 rounded-md transition-colors"
            >
              Cancel
            </button>
            <button 
              type="submit" 
              class="px-4 py-2 text-xs font-semibold text-white bg-blue-600 hover:bg-blue-700 rounded-md shadow-sm transition-colors"
            >
              Save Dignitary Profile
            </button>
          </div>
        </form>
      </div>
    </div>

  </div>
</AdminLayout>

<script is:inline>
  (function() {
    function getElements() {
      return {
        modal: document.getElementById('dignitary-modal'),
        modalTitle: document.getElementById('modal-title'),
        modalAction: document.getElementById('modal-action'),
        modalId: document.getElementById('modal-id'),
        fieldName: document.getElementById('field-name'),
        fieldPosition: document.getElementById('field-position'),
        fieldSubTitle: document.getElementById('field-subTitle'),
        fieldRole: document.getElementById('field-role'),
        fieldSNo: document.getElementById('field-sNo'),
        fieldImageUrl: document.getElementById('field-imageUrl'),
        fieldIasBatch: document.getElementById('field-iasBatch'),
        fieldEducation: document.getElementById('field-education'),
        fieldOfficeLocation: document.getElementById('field-officeLocation'),
        fieldDescription: document.getElementById('field-description'),
        fieldKeyResponsibilities: document.getElementById('field-keyResponsibilities')
      };
    }

    function showModal(isEdit, data) {
      var els = getElements();
      if (!els.modal) return;

      if (isEdit && data) {
        if (els.modalTitle) els.modalTitle.textContent = 'Edit Dignitary Profile';
        if (els.modalAction) els.modalAction.value = 'update';
        if (els.modalId) els.modalId.value = data.id || '';
        if (els.fieldName) els.fieldName.value = data.name || '';
        if (els.fieldPosition) els.fieldPosition.value = data.position || '';
        if (els.fieldSubTitle) els.fieldSubTitle.value = data.subtitle || '';
        if (els.fieldRole) els.fieldRole.value = data.role || '';
        if (els.fieldSNo) els.fieldSNo.value = data.sno || 1;
        if (els.fieldImageUrl) els.fieldImageUrl.value = data.imageurl || '';
        if (els.fieldIasBatch) els.fieldIasBatch.value = data.iasbatch || '';
        if (els.fieldEducation) els.fieldEducation.value = data.education || '';
        if (els.fieldOfficeLocation) els.fieldOfficeLocation.value = data.officelocation || '';
        if (els.fieldDescription) els.fieldDescription.value = data.description || '';
        if (els.fieldKeyResponsibilities) els.fieldKeyResponsibilities.value = data.keyresponsibilities || '';
      } else {
        if (els.modalTitle) els.modalTitle.textContent = 'Add New Dignitary Profile';
        if (els.modalAction) els.modalAction.value = 'create';
        if (els.modalId) els.modalId.value = '';
        if (els.fieldName) els.fieldName.value = '';
        if (els.fieldPosition) els.fieldPosition.value = '';
        if (els.fieldSubTitle) els.fieldSubTitle.value = '';
        if (els.fieldRole) els.fieldRole.value = '';
        if (els.fieldSNo) els.fieldSNo.value = 1;
        if (els.fieldImageUrl) els.fieldImageUrl.value = '';
        if (els.fieldIasBatch) els.fieldIasBatch.value = '';
        if (els.fieldEducation) els.fieldEducation.value = '';
        if (els.fieldOfficeLocation) els.fieldOfficeLocation.value = '';
        if (els.fieldDescription) els.fieldDescription.value = '';
        if (els.fieldKeyResponsibilities) els.fieldKeyResponsibilities.value = '';
      }

      els.modal.classList.remove('hidden');
      if (window.initQuillRichEditors) setTimeout(window.initQuillRichEditors, 50);
    }

    function hideModal() {
      var modal = document.getElementById('dignitary-modal');
      if (modal) modal.classList.add('hidden');
    }

    document.addEventListener('click', function(e) {
      var addBtn = e.target.closest('#open-add-modal');
      if (addBtn) {
        e.preventDefault();
        showModal(false);
        return;
      }

      var editBtn = e.target.closest('.edit-dignitary-btn');
      if (editBtn) {
        e.preventDefault();
        var data = {
          id: editBtn.dataset.id,
          name: editBtn.dataset.name,
          position: editBtn.dataset.position,
          subtitle: editBtn.dataset.subtitle,
          role: editBtn.dataset.role,
          sno: editBtn.dataset.sno,
          imageurl: editBtn.dataset.imageurl,
          iasbatch: editBtn.dataset.iasbatch,
          education: editBtn.dataset.education,
          officelocation: editBtn.dataset.officelocation,
          description: editBtn.dataset.description,
          keyresponsibilities: editBtn.dataset.keyresponsibilities
        };
        showModal(true, data);
        return;
      }

      var closeBtn = e.target.closest('#close-modal, #cancel-modal');
      if (closeBtn) {
        e.preventDefault();
        hideModal();
        return;
      }

      var modal = document.getElementById('dignitary-modal');
      if (modal && e.target === modal) {
        hideModal();
      }
    });
  })();
</script>
