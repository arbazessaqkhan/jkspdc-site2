---
import AdminLayout from '../../layouts/AdminLayout.astro';
import Icon from '../../components/Icon.astro';
import FileUploader from '../../components/admin/FileUploader.astro';
import { isAdmin } from '../../utils/roles';
import { parseApiError, BACKEND_URL } from '../../utils/api-error';
import { readPageParams, fetchPaged, pageUrl } from '../../utils/pagination';
import PageNav from '../../components/PageNav.astro';

// Check authentication
const sessionToken = Astro.cookies.get('admin_session')?.value;
if (!sessionToken) {
  return Astro.redirect('/admin/login');
}

// Role protection: Dignitaries management is ADMIN-only
const userRole = Astro.locals.user?.role;
if (!isAdmin(userRole)) {
  return Astro.redirect('/admin/dashboard');
}

let errorMessage = '';
let successMessage = '';

// Handle POST actions
if (Astro.request.method === 'POST') {
  try {
    const formData = await Astro.request.formData();
    const action = formData.get('_action')?.toString();

    if (action === 'create' || action === 'update') {
      const id = formData.get('id')?.toString();
      const name = formData.get('name')?.toString();
      const position = formData.get('position')?.toString();
      const subTitle = formData.get('subTitle')?.toString();
      const role = formData.get('role')?.toString();
      const sNo = formData.get('sNo')?.toString();
      const imageUrl = formData.get('imageUrl')?.toString();
      const iasBatch = formData.get('iasBatch')?.toString();
      const education = formData.get('education')?.toString();
      const officeLocation = formData.get('officeLocation')?.toString();
      const description = formData.get('description')?.toString();
      const keyResponsibilities = formData.get('keyResponsibilities')?.toString();

      if (!name || !position || !sNo) {
        errorMessage = 'Name, Designation, and S No. are required.';
      } else {
        const body = {
          name,
          position,
          subTitle: subTitle || null,
          role: role || position || 'OFFICIAL DIGNITARY',
          sNo: parseInt(sNo, 10),
          imageUrl: imageUrl || null,
          iasBatch: iasBatch || null,
          education: education || null,
          officeLocation: officeLocation || null,
          description: description || null,
          keyResponsibilities: keyResponsibilities || null,
        };

        let res;
        if (action === 'create') {
          res = await fetch(`${BACKEND_URL}/api/dignitaries`, {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              'Authorization': `Bearer ${sessionToken}`,
            },
            body: JSON.stringify(body),
          });
        } else {
          res = await fetch(`${BACKEND_URL}/api/dignitaries/${id}`, {
            method: 'PUT',
            headers: {
              'Content-Type': 'application/json',
              'Authorization': `Bearer ${sessionToken}`,
            },
            body: JSON.stringify(body),
          });
        }

        if (res.ok) {
          successMessage = `Dignitary profile successfully ${action === 'create' ? 'added' : 'updated'}.`;
        } else {
          const apiErr = await parseApiError(res, action === 'create' ? 'add dignitary' : 'update dignitary');
          if (apiErr.isUnauthorized) {
            return Astro.redirect('/admin/login');
          }
          errorMessage = apiErr.message;
        }
      }
    } else if (action === 'delete') {
      const id = formData.get('id')?.toString();
      if (id) {
        const res = await fetch(`${BACKEND_URL}/api/dignitaries/${id}`, {
          method: 'DELETE',
          headers: {
            'Authorization': `Bearer ${sessionToken}`,
          },
        });

        if (res.ok) {
          successMessage = 'Dignitary successfully removed.';
        } else {
          const apiErr = await parseApiError(res, 'delete dignitary');
          if (apiErr.isUnauthorized) {
            return Astro.redirect('/admin/login');
          }
          errorMessage = apiErr.message;
        }
      }
    }
  } catch (e) {
    console.error('Error handling dignitary post:', e);
    errorMessage = 'An error occurred while saving the dignitary profile. Check backend service status.';
  }
}

// Fetch list of dignitaries
const { page, pageSize } = readPageParams(Astro.url);
const pagedExtra: Record<string, string | undefined> = {};
let dignitaries: any[] = [];
let pagedTotal = 0;
let pagedLastPage = 1;
try {
  const state = await fetchPaged('/api/dignitaries', { BACKEND_URL, page, pageSize, extra: pagedExtra });
  dignitaries = state.rows;
  pagedTotal = state.total;
  pagedLastPage = state.lastPage;
  if (state.error) errorMessage = errorMessage || state.error;
} catch (e) {
  console.error('Error fetching list:', e);
  errorMessage = 'Network failure: Unable to reach backend server.';
}
const pagedState = { rows: dignitaries, total: pagedTotal, page, pageSize, lastPage: pagedLastPage, error: null };---

<AdminLayout title="Dignitaries Management" description="Manage JKSPDCL state dignitaries and corporate leadership profiles." activeTab="dignitaries">
  <div class="flex flex-col gap-6 max-w-6xl mx-auto w-full">

    <!-- Feedback messages -->
    {errorMessage && (
      <div class="alert-error" role="alert">
        <span class="font-bold">Error:</span> {errorMessage}
      </div>
    )}
    {successMessage && (
      <div class="alert-success" role="alert">
        <span class="font-bold">Success:</span> {successMessage}
      </div>
    )}

    <!-- VIEW 1: TABLE VIEW -->
    <div id="dignitaries-table-view" class="flex flex-col gap-5">
      
      <!-- Standard Admin Page Header -->
      <div class="admin-page-header">
        <div>
          <h1 class="text-lg font-extrabold text-[color:var(--adm-primary)] tracking-tight">Dignitaries Management</h1>
          <p class="text-xs text-slate-500 mt-0.5">Manage state dignitaries, ministers, and top leadership profiles displayed across the portal.</p>
        </div>
        <button 
          id="open-add-form-btn" 
          type="button"
          class="btn-primary flex items-center gap-1.5 text-xs py-2 px-3.5 self-start md:self-auto cursor-pointer"
        >
          <Icon name="plus" size={13} strokeWidth={2.5} />
          <span>Add New Dignitary</span>
        </button>
      </div>

      <!-- Administrative Data Table -->
      <div class="admin-table-card">
      <div class="admin-table-container">
        <table class="table-data min-w-full text-left">
          <thead>
            <tr>
              <th scope="col" class="w-12 text-center">S.No</th>
              <th scope="col" class="min-w-[190px]">Dignitary</th>
              <th scope="col" class="min-w-[220px]">Designation &amp; Subtitle</th>
              <th scope="col" class="w-32 text-center">Classification</th>
              <th scope="col" class="w-44">Service &amp; Qualifications</th>
              <th scope="col" class="w-24 text-center sticky-col-right">Actions</th>
            </tr>
          </thead>
          <tbody>
            {dignitaries.length === 0 ? (
              <tr>
                <td colspan="6" class="px-6 py-12 text-center text-slate-500 text-xs italic font-semibold">
                  No dignitaries found in database. Click "Add New Dignitary" to add one.
                </td>
              </tr>
            ) : (
              dignitaries.map((dig: any) => {
                const initials = dig.name
                  ? dig.name
                      .replace(/Shri\s*|Smt\s*|Dr\s*|Er\s*|\(IAS\)/gi, '')
                      .trim()
                      .split(' ')
                      .map((n: string) => n[0])
                      .join('')
                      .toUpperCase()
                      .slice(0, 2)
                  : 'DG';

                return (
                  <tr class="transition-colors">
                    <td class="text-center text-xs font-bold text-slate-500">{dig.sNo}</td>
                    <td>
                      <div class="flex items-center gap-2.5">
                        {dig.imageUrl ? (
                          <img src={dig.imageUrl} alt={dig.name} class="w-8 h-8 rounded-full object-cover object-top border border-slate-200 shrink-0" />
                        ) : (
                          <div class="w-8 h-8 rounded-full bg-slate-100 border border-slate-200 flex items-center justify-center text-[11px] font-bold text-[color:var(--adm-primary)] shrink-0">
                            {initials}
                          </div>
                        )}
                        <div class="min-w-0">
                          <p class="font-bold text-slate-900 text-xs leading-tight">{dig.name}</p>
                          <p class="text-[10px] text-slate-400 mt-0.5">Order: {dig.sNo}</p>
                        </div>
                      </div>
                    </td>
                    <td class="max-w-xs">
                      <p class="text-xs text-slate-800 leading-snug font-bold">{dig.position}</p>
                      {dig.subTitle && <p class="text-[11px] text-slate-500 mt-0.5 font-medium">{dig.subTitle}</p>}
                    </td>
                    <td class="text-center">
                      <span class="admin-badge-success">
                        {dig.role || dig.position}
                      </span>
                    </td>
                    <td class="text-xs text-slate-600">
                      <p class="font-semibold text-slate-700">{dig.iasBatch || '—'}</p>
                      <p class="text-[10px] text-slate-400">{dig.education || '—'}</p>
                    </td>
                    <td class="td-actions sticky-col-right">
                      <div class="admin-action-group">
                        <button
                          type="button"
                          class="edit-dignitary-btn admin-btn-action cursor-pointer"
                          data-id={dig.id}
                          data-name={dig.name}
                          data-position={dig.position}
                          data-subtitle={dig.subTitle || ''}
                          data-role={dig.role || ''}
                          data-sno={dig.sNo}
                          data-imageurl={dig.imageUrl || ''}
                          data-iasbatch={dig.iasBatch || ''}
                          data-education={dig.education || ''}
                          data-officelocation={dig.officeLocation || ''}
                          data-description={dig.description || ''}
                          data-keyresponsibilities={dig.keyResponsibilities || ''}
                          title={`Edit ${dig.name}`}
                          aria-label={`Edit ${dig.name}`}
                        >
                          <Icon name="pencil" size={13} />
                        </button>
                        <form method="POST" class="inline m-0 p-0" onsubmit="return confirm('Are you sure you want to delete this dignitary?');">
                          <input type="hidden" name="_action" value="delete" />
                          <input type="hidden" name="id" value={dig.id} />
                          <button
                            type="submit"
                            class="admin-btn-action action-delete cursor-pointer"
                            title={`Delete ${dig.name}`}
                            aria-label={`Delete ${dig.name}`}
                          >
                            <Icon name="trash-2" size={13} />
                          </button>
                        </form>
                      </div>
                    </td>
                  </tr>
                );
              })
            )}
          </tbody>
          </table>


    <PageNav state={pagedState} url={(p: number) => pageUrl(Astro.url, p, pageSize, pagedExtra)} />      </div>
      </div>

    </div>

    <!-- VIEW 2: DEDICATED IN-PAGE FORM VIEW (Hidden by default) -->
    <div id="dignitary-form-view" class="hidden flex-col gap-6">
      
      <!-- Back Navigation Bar -->
      <div class="bg-white rounded-xl border border-slate-200 p-6 shadow-xs flex items-center justify-between gap-4">
        <div>
          <h2 id="form-view-title" class="text-xl font-bold text-[color:var(--adm-primary)]">Add New Dignitary Profile</h2>
          <p class="text-xs text-slate-500 mt-1">Fill in official details below. Fields marked with (<span class="text-red-500 font-bold">*</span>) are required.</p>
        </div>
        <button 
          id="back-to-list-btn" 
          type="button"
          class="flex items-center gap-2 cursor-pointer px-4 py-2 text-xs font-semibold text-slate-700 bg-slate-100 hover:bg-slate-200 rounded-lg border border-slate-300 transition-colors"
        >
          &larr; Back to Dignitaries List
        </button>
      </div>

      <!-- Main Form Card -->
      <div class="bg-white rounded-xl border border-slate-200 shadow-md p-8">
        <form method="POST" class="space-y-6">
          <input type="hidden" name="_action" id="form-action" value="create" />
          <input type="hidden" name="id" id="form-id" value="" />

          <!-- Row 1: The ONLY 3 Required Fields -->
          <div class="grid grid-cols-1 md:grid-cols-4 gap-6 p-4 bg-blue-50/40 rounded-xl border border-blue-100">
            <div>
              <label for="field-sNo" class="block text-xs font-bold text-slate-800 uppercase tracking-wider mb-1.5">
                Serial Order (S.No) <span class="text-red-500">*</span>
              </label>
              <input 
                type="number" 
                name="sNo" 
                id="field-sNo" 
                required 
                min="1" 
                value="1" 
                class="w-full px-3.5 py-2.5 text-xs bg-white border border-slate-300 rounded-lg focus:border-blue-400 focus:ring-1 focus:ring-blue-400/50 focus:outline-none font-bold"
              />
            </div>
            <div class="md:col-span-2">
              <label for="field-name" class="block text-xs font-bold text-slate-800 uppercase tracking-wider mb-1.5">
                Dignitary Full Name <span class="text-red-500">*</span>
              </label>
              <input 
                type="text" 
                name="name" 
                id="field-name" 
                required 
                placeholder="e.g. Shri Ashwani Kumar (IAS)" 
                class="w-full px-3.5 py-2.5 text-xs bg-white border border-slate-300 rounded-lg focus:border-blue-400 focus:ring-1 focus:ring-blue-400/50 focus:outline-none font-semibold"
              />
            </div>
            <div>
              <label for="field-position" class="block text-xs font-bold text-slate-800 uppercase tracking-wider mb-1.5">
                Designation / Title <span class="text-red-500">*</span>
              </label>
              <input 
                type="text" 
                name="position" 
                id="field-position" 
                required 
                placeholder="e.g. Financial Commissioner (ACS)" 
                class="w-full px-3.5 py-2.5 text-xs bg-white border border-slate-300 rounded-lg focus:border-blue-400 focus:ring-1 focus:ring-blue-400/50 focus:outline-none font-semibold"
              />
            </div>
          </div>

          <!-- Row 2: Optional Department & Badge -->
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div>
              <label for="field-subTitle" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5">
                Department / Sub-title (Optional)
              </label>
              <input 
                type="text" 
                name="subTitle" 
                id="field-subTitle" 
                placeholder="e.g. Power Development Department, J&K" 
                class="w-full px-3.5 py-2.5 text-xs border border-slate-300 rounded-lg focus:border-blue-400 focus:ring-1 focus:ring-blue-400/50 focus:outline-none"
              />
            </div>
            <div>
              <label for="field-role" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5">
                Classification Badge (Optional)
              </label>
              <input 
                type="text" 
                name="role" 
                id="field-role" 
                placeholder="e.g. CHAIRMAN / HONORABLE LIEUTENANT GOVERNOR" 
                class="w-full px-3.5 py-2.5 text-xs border border-slate-300 rounded-lg focus:border-blue-400 focus:ring-1 focus:ring-blue-400/50 focus:outline-none"
              />
            </div>
          </div>

          <!-- Row 3: Photo Upload from System & Real-Time Preview -->
          <div class="p-5 bg-slate-50/80 rounded-xl border border-slate-200">
            <label class="block text-xs font-bold text-slate-800 uppercase tracking-wider mb-3">
              Dignitary Photo (System Upload &amp; Real-time Preview)
            </label>
            <div class="flex flex-col sm:flex-row items-center gap-6">
              <!-- Live Image Avatar Preview -->
              <div class="shrink-0 flex flex-col items-center gap-1.5">
                <div class="w-28 h-28 rounded-full overflow-hidden bg-slate-100 border-4 border-[color:var(--adm-border)] shadow-sm relative flex items-center justify-center">
                  <img id="image-preview-img" src="" alt="Preview" class="w-full h-full object-cover object-top hidden" />
                  <div id="image-preview-fallback" class="w-full h-full bg-slate-200 flex items-center justify-center">
                    <Icon name="user" size={48} class="text-slate-400" />
                  </div>
                </div>
                <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider">Live Preview</span>
              </div>

              <!-- Unified Image Uploader -->
              <div class="flex-1 w-full space-y-3">
                <input type="hidden" name="imageUrl" id="field-imageUrl" value="" />
                <FileUploader
                  id="dignitary-photo"
                  label="Photo"
                  variant="image"
                  accept="image/*"
                  helpText="Portrait image (JPG, PNG, WEBP). Max size: 10 MB."
                  maxSizeMB={10}
                />
              </div>
            </div>
          </div>

          <!-- Row 4: Service Credentials -->
          <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            <div>
              <label for="field-iasBatch" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5">
                IAS Batch / Cadre (Optional)
              </label>
              <input 
                type="text" 
                name="iasBatch" 
                id="field-iasBatch" 
                placeholder="e.g. 1992 (AGMUT Cadre)" 
                class="w-full px-3.5 py-2.5 text-xs border border-slate-300 rounded-lg focus:border-blue-400 focus:ring-1 focus:ring-blue-400/50 focus:outline-none"
              />
            </div>
            <div>
              <label for="field-education" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5">
                Education (Optional)
              </label>
              <input 
                type="text" 
                name="education" 
                id="field-education" 
                placeholder="e.g. B.E. (Elec.), M.A. (Duke)" 
                class="w-full px-3.5 py-2.5 text-xs border border-slate-300 rounded-lg focus:border-blue-400 focus:ring-1 focus:ring-blue-400/50 focus:outline-none"
              />
            </div>
            <div>
              <label for="field-officeLocation" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5">
                Office Location (Optional)
              </label>
              <input 
                type="text" 
                name="officeLocation" 
                id="field-officeLocation" 
                placeholder="e.g. Civil Secretariat, J&K" 
                class="w-full px-3.5 py-2.5 text-xs border border-slate-300 rounded-lg focus:border-blue-400 focus:ring-1 focus:ring-blue-400/50 focus:outline-none"
              />
            </div>
          </div>

          <!-- Row 5: Rich Text Biography -->
          <div class="space-y-1.5">
            <label class="block text-xs font-bold text-slate-800 uppercase tracking-wider">
              Biography / Official Description (Rich Text Editor)
            </label>
            <input type="hidden" name="description" id="field-description" value="" />
            <div data-rich-editor="field-description" data-placeholder="Detailed biographical paragraphs (supports bold, headings, bullet lists)..." class="bg-white rounded-lg border border-slate-300 h-40 max-h-40 overflow-hidden text-xs"></div>
          </div>

          <!-- Row 6: Rich Text Key Responsibilities -->
          <div class="space-y-1.5">
            <label class="block text-xs font-bold text-slate-800 uppercase tracking-wider">
              Key Responsibilities &amp; Portfolio (Rich Text Editor)
            </label>
            <input type="hidden" name="keyResponsibilities" id="field-keyResponsibilities" value="" />
            <div data-rich-editor="field-keyResponsibilities" data-placeholder="Key responsibilities and bullet points..." class="bg-white rounded-lg border border-slate-300 h-40 max-h-40 overflow-hidden text-xs"></div>
          </div>

          <!-- Form Buttons -->
          <div class="pt-6 border-t border-slate-200 flex items-center justify-end gap-3">
            <button 
              type="button" 
              id="cancel-form-btn" 
              class="px-5 py-2.5 text-xs font-bold text-slate-600 bg-slate-100 hover:bg-slate-200 rounded-lg transition-colors cursor-pointer"
            >
              Cancel
            </button>
            <button 
              type="submit" 
              class="px-6 py-2.5 text-xs font-bold text-white bg-blue-600 hover:bg-blue-700 rounded-lg shadow-md transition-colors cursor-pointer"
            >
              Save Dignitary Profile
            </button>
          </div>
        </form>
      </div>

    </div>

  </div>
</AdminLayout>

<script is:inline>
  (function() {
    function getElements() {
      return {
        tableView: document.getElementById('dignitaries-table-view'),
        formView: document.getElementById('dignitary-form-view'),
        formTitle: document.getElementById('form-view-title'),
        formAction: document.getElementById('form-action'),
        formId: document.getElementById('form-id'),
        fieldName: document.getElementById('field-name'),
        fieldPosition: document.getElementById('field-position'),
        fieldSubTitle: document.getElementById('field-subTitle'),
        fieldRole: document.getElementById('field-role'),
        fieldSNo: document.getElementById('field-sNo'),
        fieldImageUrl: document.getElementById('field-imageUrl'),
        fieldImageFile: document.getElementById('dignitary-photo-input'),
        fileChosenText: document.getElementById('file-chosen-text'),
        clearPhotoBtn: document.getElementById('clear-photo-btn'),
        previewImg: document.getElementById('image-preview-img'),
        previewFallback: document.getElementById('image-preview-fallback'),
        fieldIasBatch: document.getElementById('field-iasBatch'),
        fieldEducation: document.getElementById('field-education'),
        fieldOfficeLocation: document.getElementById('field-officeLocation'),
        fieldDescription: document.getElementById('field-description'),
        fieldKeyResponsibilities: document.getElementById('field-keyResponsibilities')
      };
    }

    function updateLivePreview(url) {
      var els = getElements();
      if (!els.previewImg || !els.previewFallback) return;
      if (url && url.trim().length > 0) {
        els.previewImg.src = url.trim();
        els.previewImg.classList.remove('hidden');
        els.previewFallback.classList.add('hidden');
        if (els.clearPhotoBtn) els.clearPhotoBtn.classList.remove('hidden');
      } else {
        // No image: hide img, show blank person silhouette placeholder
        els.previewImg.src = '';
        els.previewImg.classList.add('hidden');
        els.previewFallback.classList.remove('hidden');
        if (els.clearPhotoBtn) els.clearPhotoBtn.classList.add('hidden');
      }
    }

    function openFormView(isEdit, data) {
      var els = getElements();
      if (!els.tableView || !els.formView) return;

      if (isEdit && data) {
        if (els.formTitle) els.formTitle.textContent = 'Edit Dignitary Profile';
        if (els.formAction) els.formAction.value = 'update';
        if (els.formId) els.formId.value = data.id || '';
        if (els.fieldName) els.fieldName.value = data.name || '';
        if (els.fieldPosition) els.fieldPosition.value = data.position || '';
        if (els.fieldSubTitle) els.fieldSubTitle.value = data.subtitle || '';
        if (els.fieldRole) els.fieldRole.value = data.role || '';
        if (els.fieldSNo) els.fieldSNo.value = data.sno || 1;
        if (els.fieldImageUrl) els.fieldImageUrl.value = data.imageurl || '';
        if (els.fieldIasBatch) els.fieldIasBatch.value = data.iasbatch || '';
        if (els.fieldEducation) els.fieldEducation.value = data.education || '';
        if (els.fieldOfficeLocation) els.fieldOfficeLocation.value = data.officelocation || '';
        if (els.fieldDescription) els.fieldDescription.value = data.description || '';
        if (els.fieldKeyResponsibilities) els.fieldKeyResponsibilities.value = data.keyresponsibilities || '';
        
        if (els.fileChosenText) {
          els.fileChosenText.textContent = data.imageurl ? 'Photo loaded' : 'No photo uploaded.';
        }
        updateLivePreview(data.imageurl);
      } else {
        if (els.formTitle) els.formTitle.textContent = 'Add New Dignitary Profile';
        if (els.formAction) els.formAction.value = 'create';
        if (els.formId) els.formId.value = '';
        if (els.fieldName) els.fieldName.value = '';
        if (els.fieldPosition) els.fieldPosition.value = '';
        if (els.fieldSubTitle) els.fieldSubTitle.value = '';
        if (els.fieldRole) els.fieldRole.value = '';
        if (els.fieldSNo) els.fieldSNo.value = 1;
        if (els.fieldImageUrl) els.fieldImageUrl.value = '';
        if (els.fieldIasBatch) els.fieldIasBatch.value = '';
        if (els.fieldEducation) els.fieldEducation.value = '';
        if (els.fieldOfficeLocation) els.fieldOfficeLocation.value = '';
        if (els.fieldDescription) els.fieldDescription.value = '';
        if (els.fieldKeyResponsibilities) els.fieldKeyResponsibilities.value = '';
        
        if (els.fileChosenText) {
          els.fileChosenText.textContent = 'No image file selected. Click above to upload a photo from your computer.';
        }
        updateLivePreview('');
      }

      els.tableView.classList.add('hidden');
      els.formView.classList.remove('hidden');
      window.scrollTo({ top: 0, behavior: 'smooth' });

      if (window.initQuillRichEditors) {
        setTimeout(window.initQuillRichEditors, 50);
      }
    }

    function closeFormView() {
      var els = getElements();
      if (els.formView) els.formView.classList.add('hidden');
      if (els.tableView) els.tableView.classList.remove('hidden');
    }

    // Global Click Event Delegation
    document.addEventListener('click', function(e) {
      var addBtn = e.target.closest('#open-add-form-btn');
      if (addBtn) {
        e.preventDefault();
        openFormView(false);
        return;
      }

      var editBtn = e.target.closest('.edit-dignitary-btn');
      if (editBtn) {
        e.preventDefault();
        var data = {
          id: editBtn.dataset.id,
          name: editBtn.dataset.name,
          position: editBtn.dataset.position,
          subtitle: editBtn.dataset.subtitle,
          role: editBtn.dataset.role,
          sno: editBtn.dataset.sno,
          imageurl: editBtn.dataset.imageurl,
          iasbatch: editBtn.dataset.iasbatch,
          education: editBtn.dataset.education,
          officelocation: editBtn.dataset.officelocation,
          description: editBtn.dataset.description,
          keyresponsibilities: editBtn.dataset.keyresponsibilities
        };
        openFormView(true, data);
        return;
      }

      var backBtn = e.target.closest('#back-to-list-btn, #cancel-form-btn');
      if (backBtn) {
        e.preventDefault();
        closeFormView();
        return;
      }

    });

    // File input listener for image upload & base64 conversion
    document.addEventListener('change', function(e) {
      if (e.target && e.target.id === 'dignitary-photo-input') {
        var file = e.target.files[0];
        var els = getElements();
        if (file) {
          var reader = new FileReader();
          reader.onload = function(evt) {
            if (els.fieldImageUrl) els.fieldImageUrl.value = evt.target.result;
            updateLivePreview(evt.target.result);
          };
          reader.readAsDataURL(file);
        }
      }
    });

    // Unified uploader remove action
    document.addEventListener('uploader:cleared', function(e) {
      if (e.target && e.target.id === 'dignitary-photo-input') {
        var els = getElements();
        if (els.fieldImageUrl) els.fieldImageUrl.value = '';
        updateLivePreview('');
      }
    });

  })();
</script>
