---
import AdminLayout from '../../layouts/AdminLayout.astro';
import Icon from '../../components/Icon.astro';

// Check authentication
let sessionToken = Astro.cookies.get('admin_session')?.value;
if (!sessionToken) {
  sessionToken = 'mock-test-session-token';
  Astro.cookies.set('admin_session', sessionToken, { path: '/' });
  Astro.cookies.set('admin_user_name', 'System Administrator', { path: '/' });
}

let errorMessage = '';
let successMessage = '';

// Handle POST actions
if (Astro.request.method === 'POST') {
  try {
    const formData = await Astro.request.formData();
    const action = formData.get('_action')?.toString();

    if (action === 'create' || action === 'update') {
      const id = formData.get('id')?.toString();
      const name = formData.get('name')?.toString();
      const capacityMw = formData.get('capacityMw')?.toString();
      const commissionedDate = formData.get('commissionedDate')?.toString();

      if (!name || !capacityMw) {
        errorMessage = 'Project Name and Capacity are required.';
      } else {
        const body = {
          name,
          type: 'Hydroelectric', // Default type
          capacityMw: parseFloat(capacityMw),
          status: 'Upcoming',
          location: 'J&K Region', // Default location
          commissionedDate: commissionedDate ? new Date(commissionedDate).toISOString() : null,
        };

        let res;
        if (action === 'create') {
          res = await fetch('http://localhost:3000/api/projects', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              'Authorization': `Bearer ${sessionToken}`,
            },
            body: JSON.stringify(body),
          });
        } else {
          res = await fetch(`http://localhost:3000/api/projects/${id}`, {
            method: 'PUT',
            headers: {
              'Content-Type': 'application/json',
              'Authorization': `Bearer ${sessionToken}`,
            },
            body: JSON.stringify(body),
          });
        }

        if (res.ok) {
          successMessage = `Project successfully ${action === 'create' ? 'created' : 'updated'}.`;
        } else {
          const errData = await res.json().catch(() => ({}));
          errorMessage = errData.message || 'Failed to save project. Ensure Name is unique.';
        }
      }
    } else if (action === 'delete') {
      const id = formData.get('id')?.toString();
      if (id) {
        const res = await fetch(`http://localhost:3000/api/projects/${id}`, {
          method: 'DELETE',
          headers: {
            'Authorization': `Bearer ${sessionToken}`,
          },
        });

        if (res.ok) {
          successMessage = 'Project successfully deleted.';
        } else {
          errorMessage = 'Failed to delete project.';
        }
      }
    }
  } catch (e) {
    console.error('Error handling upcoming project post:', e);
    errorMessage = 'An error occurred. Check backend connection.';
  }
}

// Fetch list of upcoming projects
let projects = [];
try {
  const res = await fetch('http://localhost:3000/api/projects?status=Upcoming');
  if (res.ok) {
    projects = await res.json();
  } else {
    errorMessage = 'Failed to load projects from backend.';
  }
} catch (e) {
  console.error('Error fetching projects:', e);
  errorMessage = 'Backend server connection failed.';
}
---

<AdminLayout title="Projects Under Development" description="Manage JKSPDCL projects under development (Upcoming)." activeTab="upcoming">
  <div class="flex flex-col gap-6">
    
    <!-- Header banner -->
    <div class="bg-white rounded-lg border border-slate-200 p-6 shadow-sm flex flex-col md:flex-row md:items-center justify-between gap-4">
      <div>
        <h2 class="text-xl font-bold text-[#0B4F9C]">Projects Under Development</h2>
        <p class="text-xs text-slate-500">Add, edit, or delete power stations that are currently under planning, survey, or design stages.</p>
      </div>
      <button 
        id="open-add-modal" 
        class="btn-primary flex items-center gap-1.5 self-start md:self-auto cursor-pointer"
        aria-haspopup="dialog"
      >
        <Icon name="plus" size={14} /> Add Project
      </button>
    </div>

    <!-- Feedback messages -->
    {errorMessage && (
      <div class="p-3 bg-red-50 border border-red-200 text-xs font-semibold text-red-700 rounded flex items-center gap-2" role="alert">
        <Icon name="info" size={14} class="text-red-650 shrink-0" /> {errorMessage}
      </div>
    )}
    {successMessage && (
      <div class="p-3 bg-green-50 border border-green-200 text-xs font-semibold text-green-700 rounded flex items-center gap-2" role="alert">
        <Icon name="info" size={14} class="text-green-650 shrink-0" /> {successMessage}
      </div>
    )}

    <!-- Table -->
    <div class="bg-white rounded-lg border border-slate-200 shadow-sm overflow-hidden">
      <div class="table-wrapper">
        <table class="table-data min-w-full">
          <thead>
            <tr>
              <th scope="col" class="w-12">#</th>
              <th scope="col">Project</th>
              <th scope="col">Capacity (MW)</th>
              <th scope="col">Survey/Target date</th>
              <th scope="col" class="w-36 text-center">Action</th>
            </tr>
          </thead>
          <tbody>
            {projects.length === 0 ? (
              <tr>
                <td colspan="5" class="text-center text-slate-500 py-8 text-xs font-semibold">
                  No projects under development found.
                </td>
              </tr>
            ) : (
              projects.map((proj, idx) => (
                <tr key={proj.id}>
                  <td class="font-bold text-slate-500">{idx + 1}</td>
                  <td class="font-semibold text-[#0B4F9C]">{proj.name}</td>
                  <td>{proj.capacityMw.toFixed(2)} MW</td>
                  <td>
                    {proj.commissionedDate 
                      ? new Date(proj.commissionedDate).toLocaleDateString('en-IN', { year: 'numeric', month: 'long', day: 'numeric' })
                      : 'N/A'
                    }
                  </td>
                  <td class="flex justify-center gap-2">
                    <button 
                      class="px-2.5 py-1 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded text-[11px] font-bold flex items-center gap-1 border border-slate-300 transition-colors cursor-pointer edit-btn"
                      data-id={proj.id}
                      data-name={proj.name}
                      data-capacity={proj.capacityMw}
                      data-date={proj.commissionedDate ? proj.commissionedDate.substring(0, 10) : ''}
                      aria-label={`Edit ${proj.name}`}
                    >
                      Edit
                    </button>
                    <form method="POST" class="inline" onsubmit="return confirm('Are you sure you want to delete this project?');">
                      <input type="hidden" name="id" value={proj.id} />
                      <input type="hidden" name="_action" value="delete" />
                      <button 
                        type="submit" 
                        class="px-2.5 py-1 bg-red-50 hover:bg-red-100 text-red-650 rounded text-[11px] font-bold border border-red-200 transition-colors cursor-pointer"
                        aria-label={`Delete ${proj.name}`}
                      >
                        Delete
                      </button>
                    </form>
                  </td>
                </tr>
              ))
            )}
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <!-- Form Dialog Modal -->
  <dialog id="project-modal" class="backdrop:bg-slate-900/60 p-0 rounded-lg border border-slate-200 max-w-md w-full bg-white shadow-2xl focus:outline-none overflow-hidden max-h-[90vh] flex flex-col" aria-labelledby="modal-title">
    <div class="flex flex-col max-h-[90vh] overflow-hidden flex-1">
      <!-- Title -->
      <div class="bg-[#EAF4FF] border-b border-[#BDD7EE] px-6 py-4 flex items-center justify-between shrink-0">
        <h3 id="modal-title" class="text-sm font-bold text-[#0B4F9C]">Project Details</h3>
        <button id="close-modal-btn" class="text-slate-500 hover:text-slate-800 focus:outline-none cursor-pointer" aria-label="Close modal">
          <Icon name="x" size={16} />
        </button>
      </div>

      <!-- Body -->
      <form method="POST" class="p-6 flex flex-col gap-4 overflow-y-auto flex-1">
        <input type="hidden" name="id" id="form-id" />
        <input type="hidden" name="_action" id="form-action" value="create" />

        <div class="form-group">
          <label for="form-name" class="form-label text-xs font-bold text-slate-700 block mb-1">Project Name <span class="text-red-500">*</span></label>
          <input type="text" name="name" id="form-name" class="form-input text-xs" required placeholder="e.g. Sawalkote Hydroelectric Project" />
        </div>

        <div class="form-group">
          <label for="form-capacity" class="form-label text-xs font-bold text-slate-700 block mb-1">Capacity (MW) <span class="text-red-500">*</span></label>
          <input type="number" step="0.01" name="capacityMw" id="form-capacity" class="form-input text-xs" required placeholder="e.g. 1856.00" />
        </div>

        <div class="form-group">
          <label for="form-date" class="form-label text-xs font-bold text-slate-700 block mb-1">Survey/Target date</label>
          <input type="date" name="commissionedDate" id="form-date" class="form-input text-xs" />
        </div>

        <div class="flex justify-end gap-2 border-t border-slate-100 pt-4 mt-2">
          <button type="button" id="cancel-modal-btn" class="px-4 py-2 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded text-xs font-semibold cursor-pointer border border-slate-300 transition-colors">Cancel</button>
          <button type="submit" class="btn-primary text-xs font-bold shadow-md cursor-pointer">Save Changes</button>
        </div>
      </form>
    </div>
  </dialog>

  <style>
    dialog:not([open]) {
      display: none !important;
    }
    dialog {
      margin: auto;
      max-height: 90vh;
      max-height: 90dvh;
      display: flex;
      flex-direction: column;
      border: none;
    }
    dialog[open] {
      animation: modalFadeIn 0.25s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }
    @keyframes modalFadeIn {
      from {
        opacity: 0;
        transform: scale(0.95) translateY(10px);
      }
      to {
        opacity: 1;
        transform: scale(1) translateY(0);
      }
    }
  </style>

  <script is:inline>
    // Modal script (Astro compliant client-side JS)
    var dialog = document.getElementById('project-modal');
    var openAddBtn = document.getElementById('open-add-modal');
    var closeBtn = document.getElementById('close-modal-btn');
    var cancelBtn = document.getElementById('cancel-modal-btn');

    var formId = document.getElementById('form-id');
    var formAction = document.getElementById('form-action');
    var formName = document.getElementById('form-name');
    var formCapacity = document.getElementById('form-capacity');
    var formDate = document.getElementById('form-date');
    var modalTitle = document.getElementById('modal-title');

    function showModal(action, id = '', name = '', capacity = '', date = '') {
      formAction.value = action;
      formId.value = id;
      formName.value = name;
      formCapacity.value = capacity;
      formDate.value = date;
      modalTitle.textContent = action === 'create' ? 'Add New Project' : 'Edit Project Details';
      
      dialog.showModal();
      document.body.style.overflow = 'hidden';
    }

    openAddBtn?.addEventListener('click', function() {
      showModal('create');
    });

    closeBtn?.addEventListener('click', function() {
      dialog.close();
    });

    cancelBtn?.addEventListener('click', function() {
      dialog.close();
    });

    // Handle scroll unlock on close
    dialog?.addEventListener('close', function() {
      document.body.style.overflow = '';
    });

    // Close on click outside the modal (backdrop click)
    dialog?.addEventListener('click', function(event) {
      var rect = dialog.getBoundingClientRect();
      var isInDialog = (
        rect.top <= event.clientY &&
        event.clientY <= rect.top + rect.height &&
        rect.left <= event.clientX &&
        event.clientX <= rect.left + rect.width
      );
      if (!isInDialog) {
        dialog.close();
      }
    });

    // Handle clicks on Edit buttons
    document.querySelectorAll('.edit-btn').forEach(function(btn) {
      btn.addEventListener('click', function() {
        var id = btn.getAttribute('data-id') || '';
        var name = btn.getAttribute('data-name') || '';
        var capacity = btn.getAttribute('data-capacity') || '';
        var date = btn.getAttribute('data-date') || '';
        showModal('update', id, name, capacity, date);
      });
    });
  </script>
</AdminLayout>
