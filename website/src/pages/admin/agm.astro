---
import AdminLayout from '../../layouts/AdminLayout.astro';
import Icon from '../../components/Icon.astro';
import FileUploader from '../../components/admin/FileUploader.astro';
import { isAdmin } from '../../utils/roles';
import { parseApiError, BACKEND_URL } from '../../utils/api-error';
import { readPageParams, fetchPaged, pageUrl } from '../../utils/pagination';
import PageNav from '../../components/PageNav.astro';

// Check authentication
const sessionToken = Astro.cookies.get('admin_session')?.value;
if (!sessionToken) {
  return Astro.redirect('/admin/login');
}

const userRole = Astro.locals.user?.role;
const userIsAdmin = isAdmin(userRole);

const url = new URL(Astro.request.url);
let errorMessage = url.searchParams.get('error') || '';
let successMessage = '';

const successAction = url.searchParams.get('success');
if (successAction === 'create') successMessage = 'AGM document published successfully.';
if (successAction === 'update') successMessage = 'AGM document updated successfully.';
if (successAction === 'delete') successMessage = 'AGM document deleted successfully.';

// Handle CRUD operations (ADMIN ONLY)
if (Astro.request.method === 'POST') {
  if (!userIsAdmin) {
    return Astro.redirect('/admin/agm');
  }
  try {
    const formData = await Astro.request.formData();
    const action = formData.get('_action')?.toString();

    if (action === 'create') {
      const title = formData.get('title')?.toString();
      const meetingDate = formData.get('meetingDate')?.toString();
      const fileName = formData.get('fileName')?.toString();
      const documentUrl = formData.get('documentUrl')?.toString();

      if (!title || !meetingDate || !fileName || !documentUrl) {
        return Astro.redirect('/admin/agm?error=' + encodeURIComponent('All fields including file attachment and meeting date are required.'));
      } else {
        const res = await fetch(`${BACKEND_URL}/api/agm`, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Authorization': `Bearer ${sessionToken}`,
          },
          body: JSON.stringify({ title, meetingDate, fileName, documentUrl }),
        });

        if (res.ok) {
          return Astro.redirect('/admin/agm?success=create');
        } else {
          const apiErr = await parseApiError(res, 'publish AGM document');
          if (apiErr.isUnauthorized) {
            return Astro.redirect('/admin/login');
          }
          return Astro.redirect('/admin/agm?error=' + encodeURIComponent(apiErr.message));
        }
      }
    } else if (action === 'update') {
      const id = formData.get('id')?.toString();
      const title = formData.get('title')?.toString();
      const meetingDate = formData.get('meetingDate')?.toString();
      const fileName = formData.get('fileName')?.toString();
      const documentUrl = formData.get('documentUrl')?.toString();

      if (!id || !title || !meetingDate || !fileName || !documentUrl) {
        return Astro.redirect('/admin/agm?error=' + encodeURIComponent('All fields are required to update.'));
      } else {
        const res = await fetch(`${BACKEND_URL}/api/agm/${id}`, {
          method: 'PUT',
          headers: {
            'Content-Type': 'application/json',
            'Authorization': `Bearer ${sessionToken}`,
          },
          body: JSON.stringify({ title, meetingDate, fileName, documentUrl }),
        });

        if (res.ok) {
          return Astro.redirect('/admin/agm?success=update');
        } else {
          const apiErr = await parseApiError(res, 'update AGM document');
          if (apiErr.isUnauthorized) {
            return Astro.redirect('/admin/login');
          }
          return Astro.redirect('/admin/agm?error=' + encodeURIComponent(apiErr.message));
        }
      }
    } else if (action === 'delete') {
      const id = formData.get('id')?.toString();
      if (id) {
        const res = await fetch(`${BACKEND_URL}/api/agm/${id}`, {
          method: 'DELETE',
          headers: {
            'Authorization': `Bearer ${sessionToken}`,
          },
        });

        if (res.ok) {
          return Astro.redirect('/admin/agm?success=delete');
        } else {
          const apiErr = await parseApiError(res, 'delete AGM document');
          if (apiErr.isUnauthorized) {
            return Astro.redirect('/admin/login');
          }
          return Astro.redirect('/admin/agm?error=' + encodeURIComponent(apiErr.message));
        }
      }
    }
  } catch (e) {
    console.error('Error handling AGM document action:', e);
    return Astro.redirect('/admin/agm?error=' + encodeURIComponent('An unexpected error occurred while processing the AGM request. Check backend service status.'));
  }
}

// Fetch AGM Documents List
const { page, pageSize } = readPageParams(Astro.url);
const pagedExtra: Record<string, string | undefined> = {  };
let agmDocuments: any[] = [];
let pagedTotal = 0;
let pagedLastPage = 1;
try {
  const state = await fetchPaged('/api/agm', { BACKEND_URL, page, pageSize, extra: pagedExtra });
  agmDocuments = state.rows;
  pagedTotal = state.total;
  pagedLastPage = state.lastPage;
  if (state.error) errorMessage = errorMessage || state.error;
} catch (e) {
  console.error('Error fetching AGM documents:', e);
  errorMessage = errorMessage || 'Failed to load AGM documents. Unable to communicate with the server.';
}
const pagedState = { rows: agmDocuments, total: pagedTotal, page, pageSize, lastPage: pagedLastPage, error: null };
// Extract available years for filter
const yearsSet = new Set(agmDocuments.map(a => new Date(a.meetingDate).getFullYear()));
const years = Array.from(yearsSet).sort((a: any, b: any) => b - a);
---

<AdminLayout title="Annual General Meetings (AGM)" description="Manage AGM Documents" activeTab="agm">
  <div class="flex flex-col gap-6">
    
    <!-- Page Header -->
    <div class="admin-page-header">
      <div>
        <h1 class="admin-page-title">Annual General Meetings (AGM)</h1>
        <p class="admin-page-subtitle">Upload, edit, and manage AGM documents, minutes, and related PDF records.</p>
      </div>
      {userIsAdmin && (
        <button 
          id="btn-add-item"
          class="admin-btn admin-btn-primary flex items-center gap-1.5 self-start sm:self-auto cursor-pointer"
        >
          <Icon name="plus" size={14} /> Add AGM Document
        </button>
      )}
    </div>

    <!-- Alerts -->
    {errorMessage && (
      <div class="p-3 bg-red-50 border border-red-200 text-xs font-semibold text-red-700 rounded flex items-center gap-2" role="alert">
        <Icon name="info" size={14} class="text-red-600 shrink-0" /> {errorMessage}
      </div>
    )}
    {successMessage && (
      <div class="p-3 bg-green-50 border border-green-200 text-xs font-semibold text-green-700 rounded flex items-center gap-2" role="alert">
        <Icon name="info" size={14} class="text-green-600 shrink-0" /> {successMessage}
      </div>
    )}

    <!-- Filter Bar -->
    <div class="admin-toolbar flex-wrap">
      <div class="flex items-center gap-3">
        <label for="year-select" class="text-xs font-semibold text-slate-700">Filter Year:</label>
        <select id="year-select" class="form-select text-xs py-1.5 pr-8 pl-2.5 border-slate-300 rounded bg-white font-medium text-slate-700 focus:border-[color:var(--adm-primary)] focus:ring-1 focus:ring-[color:var(--adm-primary)]">
          <option value="All">All Years</option>
          {years.map((y) => (
            <option value={String(y)}>{y}</option>
          ))}
        </select>
      </div>
      <div class="flex items-center gap-3">
        <label for="limit-select" class="text-xs font-semibold text-slate-700">Records Limit:</label>
        <select id="limit-select" class="form-select text-xs py-1.5 pr-8 pl-2.5 border-slate-300 rounded bg-white font-medium text-slate-700 focus:border-[color:var(--adm-primary)] focus:ring-1 focus:ring-[color:var(--adm-primary)]">
          <option value="10">10 records</option>
          <option value="25">25 records</option>
          <option value="50">50 records</option>
        </select>
      </div>
    </div>

    <!-- Administrative Data Table -->
    <div class="admin-table-card">
    <div class="admin-table-container">
      <table class="admin-table">
        <thead>
          <tr>
            <th scope="col" class="w-12 text-center">#</th>
            <th scope="col" class="min-w-[280px]">Title &amp; Document Link</th>
            <th scope="col" class="w-40 whitespace-nowrap">Meeting Date</th>
            {userIsAdmin && (
              <th scope="col" class="w-28 text-center sticky-col-right">Action</th>
            )}
          </tr>
        </thead>
        <tbody id="agm-table-body">
          {agmDocuments.length === 0 ? (
            <tr>
              <td colspan={userIsAdmin ? 4 : 3} class="text-center text-slate-500 py-12 text-xs font-semibold italic">
                No AGM documents published. Click 'Add AGM Document' to create one.
              </td>
            </tr>
          ) : (
            agmDocuments.map((agm: any, idx: number) => (
              <tr 
                class="agm-row transition-colors"
                data-year={new Date(agm.meetingDate).getFullYear()}
                data-agm={JSON.stringify(agm)}
              >
                <td class="text-center font-bold text-slate-400 text-xs row-index">{idx + 1}</td>
                <td class="font-bold text-slate-900 text-left">
                  <div class="flex flex-col gap-1">
                    <span class="text-xs font-bold text-slate-900 leading-snug">{agm.title}</span>
                    <a href={agm.documentUrl} target="_blank" class="text-[11px] text-[color:var(--adm-primary)] hover:underline font-semibold flex items-center gap-1 mt-0.5" title="Download Document">
                      <Icon name="download" size={11} class="text-[color:var(--adm-primary)]" />
                      <span>{agm.fileName}</span>
                    </a>
                  </div>
                </td>
                <td class="text-slate-600 font-medium whitespace-nowrap text-xs">
                  {new Date(agm.meetingDate).toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric' })}
                </td>
                {userIsAdmin && (
                  <td class="td-actions sticky-col-right text-center">
                    <div class="admin-action-group">
                      <button 
                        type="button" 
                        class="btn-edit admin-btn-action"
                        data-id={agm.id}
                        title={`Edit ${agm.title}`}
                        aria-label={`Edit ${agm.title}`}
                      >
                        <Icon name="pencil" size={13} />
                      </button>
                      <form method="POST" class="inline m-0 p-0" onsubmit="return confirm('Are you sure you want to delete this AGM document?');">
                        <input type="hidden" name="id" value={agm.id} />
                        <input type="hidden" name="_action" value="delete" />
                        <button 
                          type="submit" 
                          class="admin-btn-action action-delete"
                          title={`Delete ${agm.title}`}
                          aria-label={`Delete ${agm.title}`}
                        >
                          <Icon name="trash-2" size={13} />
                        </button>
                      </form>
                    </div>
                  </td>
                )}
              </tr>
            ))
          )}
          <tr id="no-matching-agm-row" style="display: none;">
            <td colspan={userIsAdmin ? 4 : 3} class="text-center text-slate-500 py-12 text-xs font-semibold italic">
              No AGM documents found matching your filter criteria.
            </td>
          </tr>
        </tbody>
      </table>


    <PageNav state={pagedState} url={(p: number) => pageUrl(Astro.url, p, pageSize, pagedExtra)} />    </div>
    </div>

  </div>

  <!-- Add/Edit Modal -->
  {userIsAdmin && (
    <div id="modal-container" class="fixed inset-0 z-55 flex items-center justify-center hidden">
    <!-- Dim backdrop -->
    <div id="modal-backdrop" class="absolute inset-0 bg-slate-900/60 backdrop-blur-[2px]"></div>
    
    <!-- Modal Card -->
    <div class="bg-white rounded-lg border border-slate-200 shadow-2xl w-full max-w-lg p-6 relative z-10 animate-fade-in text-left">
      <button 
        type="button" 
        id="btn-close-modal" 
        class="absolute top-4 right-4 text-slate-400 hover:text-slate-600 cursor-pointer focus:outline-none"
        aria-label="Close modal"
      >
        <Icon name="x" size={18} strokeWidth={2.5} />
      </button>

      <h3 id="modal-heading" class="text-sm font-bold text-slate-800 border-b border-slate-100 pb-3 mb-4 uppercase tracking-wider">
        Add AGM Document
      </h3>

      <form id="agm-form" method="POST" class="space-y-4">
        <input type="hidden" name="id" id="agm-id" />
        <input type="hidden" name="_action" id="agm-action" value="create" />

        <div class="form-group flex flex-col gap-1.5">
          <label for="agm-title" class="text-xs font-bold text-slate-700">Title:</label>
          <input 
            type="text" 
            name="title" 
            id="agm-title" 
            required 
            class="form-input text-xs" 
            placeholder="e.g., 25th Annual General Meeting Statement" 
          />
        </div>

        <div class="form-group flex flex-col gap-1.5">
          <label for="agm-meetingDate" class="text-xs font-bold text-slate-700">Meeting Date:</label>
          <input 
            type="date" 
            name="meetingDate" 
            id="agm-meetingDate" 
            required 
            class="form-input text-xs" 
          />
        </div>

        <div class="form-group flex flex-col gap-1.5">
          <label for="agm-fileName" class="text-xs font-bold text-slate-700">File Name:</label>
          <input 
            type="text" 
            name="fileName" 
            id="agm-fileName" 
            required 
            class="form-input text-xs" 
            placeholder="Enter file display name" 
          />
        </div>

        <!-- File Upload Section -->
        <div class="form-group flex flex-col gap-1.5">
          <label class="text-xs font-bold text-slate-700">Upload PDF Document:</label>
          <FileUploader
              id="agm-doc"
              label="Upload PDF Document"
              required
              variant="document"
              accept=".pdf"
              helpText="PDF Document (Max 20MB / 100MB if Important)"
              important
            />
            
            <input type="hidden" name="documentUrl" id="agm-documentUrl" required />
        </div>

        <!-- Actions -->
        <div class="flex items-center justify-end gap-3 border-t border-slate-100 pt-4 mt-6">
          <button 
            type="button" 
            id="btn-reset-modal" 
            class="px-4 py-2 bg-slate-550 text-white rounded text-xs font-bold hover:bg-slate-600 transition-colors cursor-pointer"
          >
            Reset
          </button>
          <button 
            type="submit" 
            id="btn-submit-modal"
            class="px-5 py-2 bg-blue-600 text-white rounded text-xs font-bold hover:bg-blue-700 transition-colors shadow-md cursor-pointer"
          >
            Submit
          </button>
        </div>
      </form>
    </div>
  </div>
  )}

  <script define:vars={{ sessionToken, backendUrl: BACKEND_URL }}>
    (function() {
      function getElements() {
        return {
          modalContainer: document.getElementById('modal-container'),
          modalBackdrop: document.getElementById('modal-backdrop'),
          btnAdd: document.getElementById('btn-add-item'),
          btnClose: document.getElementById('btn-close-modal'),
          btnReset: document.getElementById('btn-reset-modal'),
          agmForm: document.getElementById('agm-form'),
          fileUploader: document.getElementById('agm-doc-input'),
          fileLabel: document.createElement('span'),
          uploadStatus: document.createElement('span'),
          agmIdInput: document.getElementById('agm-id'),
          agmActionInput: document.getElementById('agm-action'),
          agmTitleInput: document.getElementById('agm-title'),
          agmMeetingDateInput: document.getElementById('agm-meetingDate'),
          agmFileNameInput: document.getElementById('agm-fileName'),
          agmDocumentUrlInput: document.getElementById('agm-documentUrl'),
          modalHeading: document.getElementById('modal-heading'),
          btnSubmit: document.getElementById('btn-submit-modal'),
          yearSelect: document.getElementById('year-select'),
          limitSelect: document.getElementById('limit-select'),
        };
      }

      function applyFilters() {
        var els = getElements();
        if (!els.yearSelect || !els.limitSelect) return;
        var selectedYear = els.yearSelect.value;
        var selectedLimit = parseInt(els.limitSelect.value, 10);
        var rows = document.querySelectorAll('.agm-row');
        var emptyRow = document.getElementById('no-matching-agm-row');

        var visibleCount = 0;
        rows.forEach(function(row) {
          var year = row.getAttribute('data-year');
          var matchesYear = selectedYear === 'All' || year === selectedYear;

          if (matchesYear && visibleCount < selectedLimit) {
            row.style.display = '';
            visibleCount++;
            var idxEl = row.querySelector('.row-index');
            if (idxEl) idxEl.textContent = visibleCount;
          } else {
            row.style.display = 'none';
          }
        });

        if (emptyRow) {
          emptyRow.style.display = (visibleCount === 0 && rows.length > 0) ? 'table-row' : 'none';
        }
      }

      function showModal(isEdit) {
        var els = getElements();
        if (!els.modalContainer) return;
        els.modalContainer.classList.remove('hidden');
        if (isEdit) {
          if (els.modalHeading) els.modalHeading.textContent = 'Edit AGM Document';
          if (els.agmActionInput) els.agmActionInput.value = 'update';
          if (els.btnSubmit) els.btnSubmit.textContent = 'Update';
        } else {
          if (els.modalHeading) els.modalHeading.textContent = 'Add AGM Document';
          if (els.agmActionInput) els.agmActionInput.value = 'create';
          if (els.btnSubmit) els.btnSubmit.textContent = 'Submit';
          resetForm();
        }
      }

      function hideModal() {
        var els = getElements();
        if (els.modalContainer) els.modalContainer.classList.add('hidden');
      }

      function resetForm() {
        var els = getElements();
        if (els.agmIdInput) els.agmIdInput.value = '';
        if (els.agmTitleInput) els.agmTitleInput.value = '';
        if (els.agmMeetingDateInput) els.agmMeetingDateInput.value = '';
        if (els.agmFileNameInput) els.agmFileNameInput.value = '';
        if (els.agmDocumentUrlInput) els.agmDocumentUrlInput.value = '';
        if (els.fileLabel) {
          els.fileLabel.textContent = 'No file chosen';
          els.fileLabel.classList.remove('text-emerald-700', 'font-bold');
        }
        if (els.uploadStatus) {
          els.uploadStatus.textContent = 'PDF Document only (Max 10MB)';
          els.uploadStatus.className = 'text-[10px] text-slate-400 font-semibold mt-1 block';
        }
      }

      // Delegated clicks
      document.addEventListener('click', function(e) {
        var addBtn = e.target.closest('#btn-add-item');
        if (addBtn) {
          e.preventDefault();
          showModal(false);
          return;
        }

        var editBtn = e.target.closest('.btn-edit');
        if (editBtn) {
          e.preventDefault();
          var row = editBtn.closest('.agm-row');
          if (row) {
            try {
              var agmData = JSON.parse(row.getAttribute('data-agm'));
              var els = getElements();
              if (els.agmIdInput) els.agmIdInput.value = agmData.id || '';
              if (els.agmTitleInput) els.agmTitleInput.value = agmData.title || '';

              if (agmData.meetingDate && els.agmMeetingDateInput) {
                var dateObj = new Date(agmData.meetingDate);
                var yyyy = dateObj.getFullYear();
                var mm = String(dateObj.getMonth() + 1).padStart(2, '0');
                var dd = String(dateObj.getDate()).padStart(2, '0');
                els.agmMeetingDateInput.value = `${yyyy}-${mm}-${dd}`;
              }

              if (els.agmFileNameInput) els.agmFileNameInput.value = agmData.fileName || '';
              if (els.agmDocumentUrlInput) els.agmDocumentUrlInput.value = agmData.documentUrl || '';
              if (els.fileLabel) {
                els.fileLabel.textContent = agmData.fileName || 'Attached existing file';
                els.fileLabel.classList.add('text-emerald-700', 'font-bold');
              }
              if (els.uploadStatus) {
                els.uploadStatus.textContent = 'Attached existing file';
                els.uploadStatus.className = 'text-[10px] text-emerald-600 font-semibold mt-1 block';
              }
              showModal(true);
            } catch (err) {
              console.error(err);
            }
          }
          return;
        }

        var closeBtn = e.target.closest('#btn-close-modal, #modal-backdrop');
        if (closeBtn) {
          e.preventDefault();
          hideModal();
          return;
        }

        var resetBtn = e.target.closest('#btn-reset-modal');
        if (resetBtn) {
          e.preventDefault();
          resetForm();
          return;
        }
      });

      // Filter and upload change listeners
      document.addEventListener('change', function(e) {
        if (e.target && (e.target.id === 'year-select' || e.target.id === 'limit-select')) {
          applyFilters();
        }

        if (e.target && e.target.id === 'agm-doc-input') {
          var file = e.target.files && e.target.files[0];
          if (!file) return;

          var els = getElements();
          var isImportant = document.getElementById('agm-doc-important')?.checked || false;
          var MAX_STANDARD = 20 * 1024 * 1024;
          var MAX_IMPORTANT = 100 * 1024 * 1024;

          if (!isImportant && file.size > MAX_STANDARD) {
            var sizeMB = (file.size / (1024 * 1024)).toFixed(2);
            alert(`File size (${sizeMB} MB) exceeds the standard 20 MB limit.\n\nPlease check "Mark as Important" to allow uploading files up to 100 MB.`);
            e.target.value = '';
            if (els.fileLabel) els.fileLabel.textContent = 'No file chosen';
            return;
          }

          if (file.size > MAX_IMPORTANT) {
            var sizeMB = (file.size / (1024 * 1024)).toFixed(2);
            alert(`File size (${sizeMB} MB) exceeds the maximum allowed limit of 100 MB.`);
            e.target.value = '';
            if (els.fileLabel) els.fileLabel.textContent = 'No file chosen';
            return;
          }

          if (els.fileLabel) {
            els.fileLabel.textContent = `Uploading ${file.name}...`;
            els.fileLabel.classList.remove('text-emerald-700', 'font-bold');
          }
          if (els.uploadStatus) {
            els.uploadStatus.textContent = 'Uploading to secure asset server...';
            els.uploadStatus.className = 'text-[10px] text-blue-600 font-semibold mt-1 block animate-pulse';
          }

          var formData = new FormData();
          formData.append('file', file);
          formData.append('isImportant', isImportant ? 'true' : 'false');

          fetch(`${backendUrl}/api/upload`, {
            method: 'POST',
            headers: { 'Authorization': `Bearer ${sessionToken}` },
            body: formData,
          })
          .then(async function(res) {
            if (!res.ok) {
              if (res.status === 401) {
                window.location.href = '/admin/login';
                return;
              }
              if (res.status === 403) {
                throw new Error('Access Denied: You do not have permission to upload files.');
              }
              const err = await res.json().catch(function() { return {}; });
              throw new Error(err.message || 'Upload failed');
            }
            return res.json();
          })
          .then(function(result) {
            if (els.agmDocumentUrlInput) els.agmDocumentUrlInput.value = result.url;
            if (els.fileLabel) {
              els.fileLabel.textContent = file.name;
              els.fileLabel.classList.add('text-emerald-700', 'font-bold');
            }
            if (els.uploadStatus) {
              els.uploadStatus.textContent = `Uploaded successfully (${Math.round(result.sizeBytes / 1024)} KB)`;
              els.uploadStatus.className = 'text-[10px] text-emerald-600 font-semibold mt-1 block';
            }
            if (els.agmFileNameInput && !els.agmFileNameInput.value) {
              els.agmFileNameInput.value = file.name;
            }
          })
          .catch(function(error) {
            if (els.fileLabel) els.fileLabel.textContent = 'Upload failed';
            if (els.uploadStatus) {
              els.uploadStatus.textContent = `Upload error: ${error.message}`;
              els.uploadStatus.className = 'text-[10px] text-red-650 font-bold mt-1 block';
            }
            if (els.agmDocumentUrlInput) els.agmDocumentUrlInput.value = '';
            e.target.value = '';
          });
        }
      });

      document.addEventListener('astro:page-load', applyFilters);
      applyFilters();
    })();
  </script>

  <style>
    .btn-primary {
      background-color: var(--adm-primary);
      color: white;
      font-size: 0.75rem;
      font-weight: 700;
      padding: 0.5rem 1rem;
      border-radius: 0.5rem;
      transition-property: all;
      box-shadow: 0 4px 6px -1px rgb(0 0 0 / 0.1);
    }
    .btn-primary:hover {
      background-color: var(--adm-primary-dark);
    }
    .form-input {
      border: 1px solid #e2e8f0;
      border-radius: 0.5rem;
      padding: 0.5rem 0.875rem;
      font-size: 0.75rem;
      transition-property: all;
    }
    .form-input:focus {
      border-color: var(--adm-primary);
      outline: 2px solid transparent;
      outline-offset: 2px;
    }
    .form-select {
      border: 1px solid #e2e8f0;
