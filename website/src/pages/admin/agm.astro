---
import AdminLayout from '../../layouts/AdminLayout.astro';
import Icon from '../../components/Icon.astro';

// Check authentication
let sessionToken = Astro.cookies.get('admin_session')?.value;
if (!sessionToken) {
  sessionToken = 'mock-test-session-token';
  Astro.cookies.set('admin_session', sessionToken, { path: '/' });
  Astro.cookies.set('admin_user_name', 'System Administrator', { path: '/' });
}

const url = new URL(Astro.request.url);
let errorMessage = url.searchParams.get('error') || '';
let successMessage = '';

const successAction = url.searchParams.get('success');
if (successAction === 'create') successMessage = 'AGM document published successfully.';
if (successAction === 'update') successMessage = 'AGM document updated successfully.';
if (successAction === 'delete') successMessage = 'AGM document deleted successfully.';

// Handle CRUD operations
if (Astro.request.method === 'POST') {
  try {
    const formData = await Astro.request.formData();
    const action = formData.get('_action')?.toString();

    if (action === 'create') {
      const title = formData.get('title')?.toString();
      const meetingDate = formData.get('meetingDate')?.toString();
      const fileName = formData.get('fileName')?.toString();
      const documentUrl = formData.get('documentUrl')?.toString();

      if (!title || !meetingDate || !fileName || !documentUrl) {
        return Astro.redirect('/admin/agm?error=' + encodeURIComponent('All fields including file attachment and meeting date are required.'));
      } else {
        const res = await fetch('http://localhost:3000/api/agm', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Authorization': `Bearer ${sessionToken}`,
          },
          body: JSON.stringify({ title, meetingDate, fileName, documentUrl }),
        });

        if (res.ok) {
          return Astro.redirect('/admin/agm?success=create');
        } else {
          const errData = await res.json().catch(() => ({}));
          return Astro.redirect('/admin/agm?error=' + encodeURIComponent(errData.message || 'Failed to publish AGM document.'));
        }
      }
    } else if (action === 'update') {
      const id = formData.get('id')?.toString();
      const title = formData.get('title')?.toString();
      const meetingDate = formData.get('meetingDate')?.toString();
      const fileName = formData.get('fileName')?.toString();
      const documentUrl = formData.get('documentUrl')?.toString();

      if (!id || !title || !meetingDate || !fileName || !documentUrl) {
        return Astro.redirect('/admin/agm?error=' + encodeURIComponent('All fields are required to update.'));
      } else {
        const res = await fetch(`http://localhost:3000/api/agm/${id}`, {
          method: 'PUT',
          headers: {
            'Content-Type': 'application/json',
            'Authorization': `Bearer ${sessionToken}`,
          },
          body: JSON.stringify({ title, meetingDate, fileName, documentUrl }),
        });

        if (res.ok) {
          return Astro.redirect('/admin/agm?success=update');
        } else {
          const errData = await res.json().catch(() => ({}));
          return Astro.redirect('/admin/agm?error=' + encodeURIComponent(errData.message || 'Failed to update AGM document.'));
        }
      }
    } else if (action === 'delete') {
      const id = formData.get('id')?.toString();
      if (id) {
        const res = await fetch(`http://localhost:3000/api/agm/${id}`, {
          method: 'DELETE',
          headers: {
            'Authorization': `Bearer ${sessionToken}`,
          },
        });

        if (res.ok) {
          return Astro.redirect('/admin/agm?success=delete');
        } else {
          return Astro.redirect('/admin/agm?error=' + encodeURIComponent('Failed to delete AGM document.'));
        }
      }
    }
  } catch (e) {
    console.error('Error handling AGM document action:', e);
    return Astro.redirect('/admin/agm?error=' + encodeURIComponent('An error occurred. Check backend service status.'));
  }
}

// Fetch AGM Documents List
let agmDocuments: any[] = [];
try {
  const res = await fetch('http://localhost:3000/api/agm');
  if (res.ok) {
    agmDocuments = await res.json();
  } else {
    errorMessage = errorMessage || 'Failed to load AGM documents from backend.';
  }
} catch (e) {
  console.error('Error fetching AGM documents:', e);
  errorMessage = errorMessage || 'Backend connection failure.';
}

const currentYear = new Date().getFullYear();
// Extract available years for filter
const yearsSet = new Set(agmDocuments.map(a => new Date(a.meetingDate).getFullYear()));
const years = Array.from(yearsSet).sort((a: any, b: any) => b - a);
---

<AdminLayout title="Annual General Meetings (AGM)" description="Manage AGM Documents" activeTab="agm">
  <div class="flex flex-col gap-6">
    
    <!-- Page Header -->
    <div class="bg-white rounded-lg border border-slate-200 p-6 shadow-sm flex flex-col md:flex-row md:items-center justify-between gap-4">
      <div>
        <h2 class="text-xl font-bold text-[#0B4F9C]">Annual General Meetings (AGM)</h2>
        <p class="text-xs text-slate-500 mt-0.5">Upload, edit, and manage AGM documents, minutes, and related PDF files.</p>
      </div>
      <button 
        id="btn-add-item"
        class="btn-primary flex items-center gap-1.5 self-start md:self-auto cursor-pointer"
      >
        <Icon name="plus" size={14} /> Add AGM Document
      </button>
    </div>

    <!-- Alerts -->
    {errorMessage && (
      <div class="p-3 bg-red-50 border border-red-200 text-xs font-semibold text-red-700 rounded flex items-center gap-2" role="alert">
        <Icon name="info" size={14} class="text-red-600 shrink-0" /> {errorMessage}
      </div>
    )}
    {successMessage && (
      <div class="p-3 bg-green-50 border border-green-200 text-xs font-semibold text-green-700 rounded flex items-center gap-2" role="alert">
        <Icon name="info" size={14} class="text-green-600 shrink-0" /> {successMessage}
      </div>
    )}

    <!-- Filter Bar -->
    <div class="bg-white rounded-lg border border-slate-200 p-4 shadow-sm flex flex-wrap gap-4 items-center justify-between">
      <div class="flex items-center gap-4">
        <div class="flex items-center gap-2">
          <label for="year-select" class="text-xs font-bold text-slate-650">Select Year</label>
          <select id="year-select" class="form-select text-xs py-1.5 pr-8 pl-3 border-slate-200 rounded">
            <option value="All">All Years</option>
            {years.map((y) => (
              <option value={String(y)}>{y}</option>
            ))}
          </select>
        </div>
      </div>
      <div class="flex items-center gap-2">
        <label for="limit-select" class="text-xs font-bold text-slate-650">Select limit</label>
        <select id="limit-select" class="form-select text-xs py-1.5 pr-8 pl-3 border-slate-200 rounded">
          <option value="10">10</option>
          <option value="25">25</option>
          <option value="50">50</option>
        </select>
      </div>
    </div>

    <!-- AGM Documents Table -->
    <div class="bg-white rounded-lg border border-slate-200 shadow-sm overflow-hidden">
      <div class="table-wrapper overflow-x-auto">
        <table class="table-data min-w-full text-left border-collapse">
          <thead>
            <tr class="bg-slate-50 border-b border-slate-200 text-xs font-bold text-slate-500 uppercase tracking-wider">
              <th scope="col" class="p-4 w-12 text-center">#</th>
              <th scope="col" class="p-4">Title</th>
              <th scope="col" class="p-4 w-40">Meeting Date</th>
              <th scope="col" class="p-4 w-36 text-center">Action</th>
            </tr>
          </thead>
          <tbody id="agm-table-body" class="divide-y divide-slate-200 text-xs">
            {agmDocuments.length === 0 ? (
              <tr>
                <td colspan="4" class="text-center text-slate-500 py-10 font-semibold italic">
                  No AGM documents published. Click 'Add AGM Document' to create one.
                </td>
              </tr>
            ) : (
              agmDocuments.map((agm: any, idx: number) => (
                <tr 
                  class="hover:bg-slate-50/50 transition-colors agm-row"
                  data-year={new Date(agm.meetingDate).getFullYear()}
                  data-agm={JSON.stringify(agm)}
                >
                  <td class="p-4 text-center font-bold text-slate-400 row-index">{idx + 1}</td>
                  <td class="p-4 font-semibold text-slate-800 text-left">
                    <div class="flex flex-col gap-1">
                      <span class="text-sm font-bold text-slate-850 leading-snug">{agm.title}</span>
                      <a href={agm.documentUrl} target="_blank" class="text-[10px] text-[#0B4F9C] hover:underline font-bold font-mono flex items-center gap-1 mt-0.5">
                        <Icon name="download" size={10} />
                        {agm.fileName}
                      </a>
                    </div>
                  </td>
                  <td class="p-4 text-slate-600 font-medium whitespace-nowrap">
                    {new Date(agm.meetingDate).toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric' })}
                  </td>
                  <td class="p-4">
                    <div class="flex justify-center gap-2">
                      <button 
                        type="button"
                        class="btn-edit px-2 py-1 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded text-[11px] font-bold border border-slate-300 transition-colors cursor-pointer"
                        data-id={agm.id}
                      >
                        Edit
                      </button>
                      <form method="POST" class="inline" onsubmit="return confirm('Are you sure you want to delete this AGM document?');">
                        <input type="hidden" name="id" value={agm.id} />
                        <input type="hidden" name="_action" value="delete" />
                        <button 
                          type="submit" 
                          class="px-2 py-1 bg-red-50 hover:bg-red-100 text-red-650 rounded text-[11px] font-bold border border-red-200 transition-colors cursor-pointer"
                        >
                          Delete
                        </button>
                      </form>
                    </div>
                  </td>
                </tr>
              ))
            )}
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <!-- Add/Edit Modal -->
  <div id="modal-container" class="fixed inset-0 z-55 flex items-center justify-center hidden">
    <!-- Dim backdrop -->
    <div id="modal-backdrop" class="absolute inset-0 bg-slate-900/60 backdrop-blur-[2px]"></div>
    
    <!-- Modal Card -->
    <div class="bg-white rounded-lg border border-slate-200 shadow-2xl w-full max-w-lg p-6 relative z-10 animate-fade-in text-left">
      <button 
        type="button" 
        id="btn-close-modal" 
        class="absolute top-4 right-4 text-slate-400 hover:text-slate-600 cursor-pointer focus:outline-none"
        aria-label="Close modal"
      >
        <Icon name="x" size={18} strokeWidth={2.5} />
      </button>

      <h3 id="modal-heading" class="text-sm font-bold text-slate-800 border-b border-slate-100 pb-3 mb-4 uppercase tracking-wider">
        Add AGM Document
      </h3>

      <form id="agm-form" method="POST" class="space-y-4">
        <input type="hidden" name="id" id="agm-id" />
        <input type="hidden" name="_action" id="agm-action" value="create" />

        <div class="form-group flex flex-col gap-1.5">
          <label for="agm-title" class="text-xs font-bold text-slate-700">Title:</label>
          <input 
            type="text" 
            name="title" 
            id="agm-title" 
            required 
            class="form-input text-xs" 
            placeholder="e.g., 25th Annual General Meeting Statement" 
          />
        </div>

        <div class="form-group flex flex-col gap-1.5">
          <label for="agm-meetingDate" class="text-xs font-bold text-slate-700">Meeting Date:</label>
          <input 
            type="date" 
            name="meetingDate" 
            id="agm-meetingDate" 
            required 
            class="form-input text-xs" 
          />
        </div>

        <div class="form-group flex flex-col gap-1.5">
          <label for="agm-fileName" class="text-xs font-bold text-slate-700">File Name:</label>
          <input 
            type="text" 
            name="fileName" 
            id="agm-fileName" 
            required 
            class="form-input text-xs" 
            placeholder="Enter file display name" 
          />
        </div>

        <!-- File Upload Section -->
        <div class="form-group flex flex-col gap-1.5">
          <label class="text-xs font-bold text-slate-700">Upload PDF Document:</label>
          <div class="flex items-center gap-2 border border-slate-200 rounded p-1 bg-slate-50 relative">
            <button 
              type="button" 
              id="btn-choose-file"
              class="px-3 py-1.5 bg-white border border-slate-300 rounded text-xs font-bold text-slate-700 shadow-sm cursor-pointer hover:bg-slate-50"
            >
              Choose File
            </button>
            <span id="file-label" class="text-xs text-slate-500 font-medium truncate flex-1 pl-1">
              No file chosen
            </span>
            <input 
              type="file" 
              id="modal-file-uploader" 
              class="absolute inset-0 opacity-0 cursor-pointer"
              accept=".pdf" 
            />
          </div>
          
          <input type="hidden" name="documentUrl" id="agm-documentUrl" required />
          
          <span id="upload-status" class="text-[10px] text-slate-400 font-semibold mt-1 block">
            PDF Document only (Max 10MB)
          </span>
        </div>

        <!-- Actions -->
        <div class="flex items-center justify-end gap-3 border-t border-slate-100 pt-4 mt-6">
          <button 
            type="button" 
            id="btn-reset-modal" 
            class="px-4 py-2 bg-slate-550 text-white rounded text-xs font-bold hover:bg-slate-600 transition-colors cursor-pointer"
          >
            Reset
          </button>
          <button 
            type="submit" 
            id="btn-submit-modal"
            class="px-5 py-2 bg-blue-600 text-white rounded text-xs font-bold hover:bg-blue-700 transition-colors shadow-md cursor-pointer"
          >
            Submit
          </button>
        </div>
      </form>
    </div>
  </div>

  <script define:vars={{ sessionToken }}>
    const modalContainer = document.getElementById('modal-container');
    const modalBackdrop = document.getElementById('modal-backdrop');
    const btnAdd = document.getElementById('btn-add-item');
    const btnClose = document.getElementById('btn-close-modal');
    const btnReset = document.getElementById('btn-reset-modal');
    const agmForm = document.getElementById('agm-form');
    const fileUploader = document.getElementById('modal-file-uploader');
    const fileLabel = document.getElementById('file-label');
    const uploadStatus = document.getElementById('upload-status');

    // Form inputs
    const agmIdInput = document.getElementById('agm-id');
    const agmActionInput = document.getElementById('agm-action');
    const agmTitleInput = document.getElementById('agm-title');
    const agmMeetingDateInput = document.getElementById('agm-meetingDate');
    const agmFileNameInput = document.getElementById('agm-fileName');
    const agmDocumentUrlInput = document.getElementById('agm-documentUrl');
    const modalHeading = document.getElementById('modal-heading');
    const btnSubmit = document.getElementById('btn-submit-modal');

    // Year and limit filter handling
    const yearSelect = document.getElementById('year-select');
    const limitSelect = document.getElementById('limit-select');

    function applyFilters() {
      const selectedYear = yearSelect.value;
      const selectedLimit = parseInt(limitSelect.value, 10);
      const rows = document.querySelectorAll('.agm-row');

      let visibleCount = 0;

      rows.forEach((row) => {
        const year = row.getAttribute('data-year');
        const matchesYear = selectedYear === 'All' || year === selectedYear;

        if (matchesYear && visibleCount < selectedLimit) {
          row.classList.remove('hidden');
          visibleCount++;
          row.querySelector('.row-index').textContent = visibleCount;
        } else {
          row.classList.add('hidden');
        }
      });
    }

    if (yearSelect) yearSelect.addEventListener('change', applyFilters);
    if (limitSelect) limitSelect.addEventListener('change', applyFilters);

    // Initial filter run
    applyFilters();

    // Show/Hide Modal
    function showModal(isEdit = false) {
      modalContainer.classList.remove('hidden');
      if (isEdit) {
        modalHeading.textContent = 'Edit AGM Document';
        agmActionInput.value = 'update';
        btnSubmit.textContent = 'Update';
      } else {
        modalHeading.textContent = 'Add AGM Document';
        agmActionInput.value = 'create';
        btnSubmit.textContent = 'Submit';
        resetForm();
      }
    }

    function hideModal() {
      modalContainer.classList.add('hidden');
    }

    if (btnAdd) btnAdd.addEventListener('click', () => showModal(false));
    if (btnClose) btnClose.addEventListener('click', hideModal);
    if (modalBackdrop) modalBackdrop.addEventListener('click', hideModal);

    function resetForm() {
      agmIdInput.value = '';
      agmTitleInput.value = '';
      agmMeetingDateInput.value = '';
      agmFileNameInput.value = '';
      agmDocumentUrlInput.value = '';
      fileLabel.textContent = 'No file chosen';
      fileLabel.classList.remove('text-emerald-700', 'font-bold');
      uploadStatus.textContent = 'PDF Document only (Max 10MB)';
      uploadStatus.className = 'text-[10px] text-slate-400 font-semibold mt-1 block';
    }

    if (btnReset) btnReset.addEventListener('click', resetForm);

    // Handle AJAX File Upload
    if (fileUploader) {
      fileUploader.addEventListener('change', async (event) => {
        const file = event.target.files?.[0];
        if (!file) return;

        fileLabel.textContent = `Uploading ${file.name}...`;
        fileLabel.classList.remove('text-emerald-700', 'font-bold');
        uploadStatus.textContent = 'Uploading to secure asset server...';
        uploadStatus.className = 'text-[10px] text-blue-600 font-semibold mt-1 block animate-pulse';

        const formData = new FormData();
        formData.append('file', file);

        try {
          const response = await fetch('http://localhost:3000/api/upload', {
            method: 'POST',
            headers: {
              'Authorization': `Bearer ${sessionToken}`,
            },
            body: formData,
          });

          if (!response.ok) {
            const errorData = await response.json().catch(() => ({}));
            throw new Error(errorData.message || 'Upload failed');
          }

          const result = await response.json();
          agmDocumentUrlInput.value = result.url;
          fileLabel.textContent = file.name;
          fileLabel.classList.add('text-emerald-700', 'font-bold');
          uploadStatus.textContent = `✓ Uploaded successfully (${Math.round(result.sizeBytes / 1024)} KB)`;
          uploadStatus.className = 'text-[10px] text-emerald-600 font-semibold mt-1 block';
          
          // Auto-fill File Name input if it is empty
          if (!agmFileNameInput.value) {
            agmFileNameInput.value = file.name;
          }
        } catch (error) {
          fileLabel.textContent = 'Upload failed';
          uploadStatus.textContent = `⚠ Upload error: ${error.message}`;
          uploadStatus.className = 'text-[10px] text-red-650 font-bold mt-1 block';
          agmDocumentUrlInput.value = '';
        }
      });
    }

    // Handle Edit Click
    document.querySelectorAll('.btn-edit').forEach((btn) => {
      btn.addEventListener('click', () => {
        const row = btn.closest('.agm-row');
        const agmData = JSON.parse(row.getAttribute('data-agm'));

        agmIdInput.value = agmData.id;
        agmTitleInput.value = agmData.title;
        
        // Format date to YYYY-MM-DD for date input
        const dateObj = new Date(agmData.meetingDate);
        const yyyy = dateObj.getFullYear();
        const mm = String(dateObj.getMonth() + 1).padStart(2, '0');
        const dd = String(dateObj.getDate()).padStart(2, '0');
        agmMeetingDateInput.value = `${yyyy}-${mm}-${dd}`;
        
        agmFileNameInput.value = agmData.fileName;
        agmDocumentUrlInput.value = agmData.documentUrl;

        fileLabel.textContent = agmData.fileName;
        fileLabel.classList.add('text-emerald-700', 'font-bold');
        uploadStatus.textContent = 'Attached existing file';
        uploadStatus.className = 'text-[10px] text-emerald-600 font-semibold mt-1 block';

        showModal(true);
      });
    });
  </script>

  <style>
    .btn-primary {
      background-color: #0B4F9C;
      color: white;
      font-size: 0.75rem;
      font-weight: 700;
      padding: 0.5rem 1rem;
      border-radius: 0.5rem;
      transition-property: all;
      box-shadow: 0 4px 6px -1px rgb(0 0 0 / 0.1);
    }
    .btn-primary:hover {
      background-color: #084A8F;
    }
    .form-input {
      border: 1px solid #e2e8f0;
      border-radius: 0.5rem;
      padding: 0.5rem 0.875rem;
      font-size: 0.75rem;
      transition-property: all;
    }
    .form-input:focus {
      border-color: #0B4F9C;
      outline: 2px solid transparent;
      outline-offset: 2px;
    }
    .form-select {
      border: 1px solid #e2e8f0;
      border-radius: 0.25rem;
      padding: 0.375rem 0.625rem;
      font-size: 0.75rem;
      cursor: pointer;
    }
    .form-select:focus {
      border-color: #0B4F9C;
      outline: none;
    }
    .btn-edit {
      transition-property: all;
    }
    @keyframes fadeIn {
      from { opacity: 0; transform: scale(0.95); }
      to { opacity: 1; transform: scale(1); }
    }
    .animate-fade-in {
      animation: fadeIn 0.25s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }
  </style>
</AdminLayout>
