---
import AdminLayout from '../../layouts/AdminLayout.astro';
import Icon from '../../components/Icon.astro';
import { isAdmin } from '../../utils/roles';
import { parseApiError, BACKEND_URL } from '../../utils/api-error';

// Check authentication
const sessionToken = Astro.cookies.get('admin_session')?.value;
if (!sessionToken) {
  return Astro.redirect('/admin/login');
}

// Role protection: Policies mutation is ADMIN-only
const userRole = Astro.locals.user?.role;
if (!isAdmin(userRole)) {
  return Astro.redirect('/admin/policies');
}

let errorMessage = '';
const editId = Astro.url.searchParams.get('id')?.toString();

let docData = {
  id: '',
  title: '',
  description: '',
  category: 'CSR',
  documentUrl: '',
  status: 'Active',
};

// Fetch data if editing
if (editId) {
  try {
    const res = await fetch(`${BACKEND_URL}/api/policies/${editId}`);
    if (res.ok) {
      const data = await res.json();
      docData = {
        id: data.id || '',
        title: data.title || '',
        description: data.description || '',
        category: 'CSR',
        documentUrl: data.documentUrl || '',
        status: data.status || 'Active',
      };
    } else {
      const apiErr = await parseApiError(res, 'load policy details');
      if (apiErr.isUnauthorized) {
        return Astro.redirect('/admin/login');
      }
      errorMessage = apiErr.message;
    }
  } catch (e) {
    console.error('Error fetching policy details:', e);
    errorMessage = 'Network failure: Unable to reach backend server.';
  }
}

// Handle Form Submit
if (Astro.request.method === 'POST') {
  try {
    const formData = await Astro.request.formData();
    const id = formData.get('id')?.toString();
    const title = formData.get('title')?.toString();
    const description = formData.get('description')?.toString();
    const documentUrl = formData.get('documentUrl')?.toString();
    const status = formData.get('status')?.toString();
    const category = 'CSR';

    // Preserve values
    docData = {
      id: id || '',
      title: title || '',
      description: description || '',
      category: 'CSR',
      documentUrl: documentUrl || '',
      status: status || 'Active',
    };

    if (!title || !documentUrl) {
      errorMessage = 'Title and Document File are required.';
    } else {
      const body = {
        title,
        description: description || null,
        category,
        documentUrl,
        status: status || 'Active',
      };

      const url = id 
        ? `${BACKEND_URL}/api/policies/${id}` 
        : `${BACKEND_URL}/api/policies`;
      const method = id ? 'PUT' : 'POST';

      const res = await fetch(url, {
        method,
        headers: {
          'Content-Type': 'application/json',
          'Authorization': `Bearer ${sessionToken}`,
        },
        body: JSON.stringify(body),
      });

      if (res.ok) {
        return Astro.redirect('/admin/policies');
      } else {
        const apiErr = await parseApiError(res, id ? 'update policy document' : 'save policy document');
        if (apiErr.isUnauthorized) {
          return Astro.redirect('/admin/login');
        }
        errorMessage = apiErr.message;
      }
    }
  } catch (error) {
    console.error('Error saving document:', error);
    errorMessage = 'Network failure: Unable to communicate with backend service.';
  }
}
---

<AdminLayout title={editId ? "Edit CSR Document" : "Add CSR Document"} description="Manage JKSPDCL CSR Documents" activeTab="policies">
  <div class="flex flex-col gap-6">
    
    <!-- Breadcrumbs / Back button -->
    <div class="admin-page-header">
      <div>
        <h1 class="admin-page-title">
          {editId ? "Edit CSR Document" : "Add CSR Document"}
        </h1>
        <p class="admin-page-subtitle">Configure CSR policy documentation, guidelines, and PDF attachments.</p>
      </div>
      <a href="/admin/policies" class="admin-btn admin-btn-secondary">
        &larr; Back to Policies
      </a>
    </div>

    <!-- Error Alert -->
    {errorMessage && (
      <div class="p-4 bg-red-50 border-l-4 border-red-500 rounded text-xs text-red-800 font-semibold shadow-sm flex items-start gap-2.5" role="alert">
        <Icon name="info" size={16} class="text-red-600 shrink-0 mt-0.5" />
        <span>{errorMessage}</span>
      </div>
    )}

    <!-- Form card -->
    <form method="POST" class="bg-white border border-slate-200 rounded-xl shadow-sm overflow-hidden flex flex-col" id="doc-form">
      <input type="hidden" name="id" id="id" value={docData.id} />
      
      <div class="p-6 md:p-8 space-y-6 flex-grow">
        <!-- Hidden: category is always CSR -->
        <input type="hidden" name="category" value="CSR" />

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">

          <!-- Status selection -->
          <div class="form-group flex flex-col gap-1.5 col-span-1 md:col-span-2">
            <label for="status" class="text-xs font-bold text-slate-700">Status <span class="text-red-500">*</span></label>
            <select name="status" id="status" class="form-input text-xs" required>
              <option value="Active" selected={docData.status === 'Active'}>Active (Visible)</option>
              <option value="Archived" selected={docData.status === 'Archived'}>Archived (Hidden)</option>
            </select>
          </div>

          <!-- Document Title -->
          <div class="form-group flex flex-col gap-1.5 col-span-1 md:col-span-2">
            <label for="title" class="text-xs font-bold text-slate-700">Document Title / Headline <span class="text-red-500">*</span></label>
            <input 
              type="text" 
              name="title" 
              id="title" 
              class="form-input text-xs" 
              placeholder="e.g. Whistle Blower Policy Charter" 
              value={docData.title} 
              required 
            />
          </div>

          <!-- Document Type / Description -->
          <div class="form-group flex flex-col gap-1.5 col-span-1 md:col-span-2">
            <label for="description" class="text-xs font-bold text-slate-700">Document Type / Category Tag <span class="text-slate-400 font-normal">(e.g. Policy, Committee, Projects, Reports, Plans)</span></label>
            <input 
              type="text" 
              name="description" 
              id="description" 
              class="form-input text-xs" 
              placeholder="e.g. Policy, Committee, Projects, Reports, or Plans" 
              value={docData.description} 
              list="doc-type-options"
            />
            <datalist id="doc-type-options">
              <option value="Policy">Policy</option>
              <option value="Committee">Committee</option>
              <option value="Projects">Projects</option>
              <option value="Reports">Reports</option>
              <option value="Plans">Plans</option>
            </datalist>
          </div>

          <!-- File Upload Section -->
          <div class="form-group flex flex-col gap-1.5 col-span-1 md:col-span-2">
            <label class="text-xs font-bold text-slate-700">Attach Document File <span class="text-red-500">*</span></label>
            <div id="upload-container" class="border-2 border-dashed border-slate-300 hover:border-blue-400 rounded-lg p-6 bg-slate-50 flex flex-col items-center justify-center gap-2 hover:bg-blue-50/20 transition-all cursor-pointer relative">
              <input type="file" id="file-uploader" class="absolute inset-0 opacity-0 cursor-pointer" accept=".pdf,.jpg,.jpeg,.png,.doc,.docx,.xls,.xlsx" />
              <Icon name="upload" size={24} class="text-slate-400" />
              <span class="text-xs text-slate-600 font-semibold" id="upload-status-text">Click to choose or drag document file here</span>
              <span class="text-[10px] text-slate-450">PDF, JPG, PNG, DOCX (Max 20MB / 100MB if Important)</span>
            </div>

            <label class="flex items-center gap-2 p-2 bg-amber-50/70 border border-amber-200/80 rounded-lg cursor-pointer hover:bg-amber-50 transition-colors select-none mt-1">
              <input type="checkbox" id="is-important-checkbox" class="w-4 h-4 rounded text-[color:var(--adm-primary)] border-slate-300 focus:ring-[color:var(--adm-primary)] cursor-pointer" />
              <span class="text-xs font-bold text-amber-900 flex items-center gap-1.5"><Icon name="star" size={13} class="text-amber-600 shrink-0" /> Mark as Important <span class="text-[10px] font-normal text-amber-700">(Allow up to 100 MB)</span></span>
            </label>
            
            <!-- Uploaded file details -->
            <div id="attached-file-info" class={`p-3 bg-emerald-50 border border-emerald-200 text-xs text-emerald-800 rounded flex items-center justify-between gap-2 mt-2 ${docData.documentUrl ? '' : 'hidden'}`}>
              <div class="flex items-center gap-2 min-w-0">
                <Icon name="info" size={16} class="text-emerald-600 shrink-0" />
                <span class="font-semibold truncate" id="attached-filename">
                  {docData.documentUrl ? docData.documentUrl.substring(docData.documentUrl.lastIndexOf('/') + 1) : 'No file attached'}
                </span>
              </div>
              {docData.documentUrl && (
                <a href={docData.documentUrl} target="_blank" class="text-emerald-700 hover:text-emerald-900 underline font-bold shrink-0">
                  View File
                </a>
              )}
            </div>
            
            <input type="hidden" name="documentUrl" id="documentUrl" value={docData.documentUrl} />
          </div>

        </div>
      </div>

      <!-- Action Buttons -->
      <div class="bg-slate-50 border-t border-slate-200 px-6 py-4 flex items-center justify-end gap-3 shrink-0">
        <a 
          href="/admin/policies" 
          class="admin-btn admin-btn-secondary"
        >
          Cancel
        </a>
        <button 
          type="submit" 
          id="submit-btn" 
          class="admin-btn admin-btn-primary cursor-pointer"
        >
          {editId ? "Update Document" : "Save Document"}
        </button>
      </div>

    </form>
  </div>
</AdminLayout>

<script is:inline define:vars={{ backendUrl: BACKEND_URL }}>
  (function() {
    // Delegated click handler on upload container to ensure file input triggers
    document.addEventListener('click', function(e) {
      var container = e.target.closest('#upload-container');
      if (container) {
        var uploader = document.getElementById('file-uploader');
        if (uploader && e.target !== uploader) {
          uploader.click();
        }
      }
    });

    // Delegated change handler on document so uploading works instantly on any navigation without page refresh
    document.addEventListener('change', async function(e) {
      if (e.target && e.target.id === 'file-uploader') {
        var file = e.target.files && e.target.files[0];
        if (!file) return;

        var uploadContainer = document.getElementById('upload-container');
        var uploadStatusText = document.getElementById('upload-status-text');
        var documentUrlInput = document.getElementById('documentUrl');
        var attachedFileInfo = document.getElementById('attached-file-info');
        var attachedFilename = document.getElementById('attached-filename');
        var submitBtn = document.getElementById('submit-btn');

        var isImportant = (document.getElementById('is-important-checkbox') && document.getElementById('is-important-checkbox').checked) || false;
        var MAX_STANDARD = 20 * 1024 * 1024;
        var MAX_IMPORTANT = 100 * 1024 * 1024;

        if (!isImportant && file.size > MAX_STANDARD) {
          var sizeMB = (file.size / (1024 * 1024)).toFixed(2);
          alert('File size (' + sizeMB + ' MB) exceeds the standard 20 MB limit.\n\nPlease check "Mark as Important" to allow uploading files up to 100 MB.');
          e.target.value = '';
          return;
        }

        if (file.size > MAX_IMPORTANT) {
          var sizeMB = (file.size / (1024 * 1024)).toFixed(2);
          alert('File size (' + sizeMB + ' MB) exceeds the maximum allowed limit of 100 MB.');
          e.target.value = '';
          return;
        }

        if (submitBtn) { submitBtn.disabled = true; submitBtn.textContent = 'Uploading…'; }
        if (uploadStatusText) uploadStatusText.textContent = 'Uploading ' + file.name + '…';
        if (uploadContainer) uploadContainer.classList.add('opacity-60', 'pointer-events-none');

        var formData = new FormData();
        formData.append('file', file);
        formData.append('isImportant', isImportant ? 'true' : 'false');

        var authToken = (document.cookie.match(/admin_session=([^;]+)/) || [])[1] || '';

        try {
          var response = await fetch((backendUrl || '') + '/api/upload', {
            method: 'POST',
            headers: {
              'Authorization': 'Bearer ' + authToken,
            },
            body: formData,
          });

          if (!response.ok) {
            if (response.status === 401) {
              window.location.href = '/admin/login';
              return;
            }
            if (response.status === 403) {
              alert('Access Denied: You do not have permission to upload files.');
              return;
            }
            var errorData = await response.json().catch(function() { return {}; });
            throw new Error(errorData.message || 'Upload failed');
          }

          var result = await response.json();

          // Update input
          if (documentUrlInput) documentUrlInput.value = result.url;

          // Update UI
          if (uploadStatusText) uploadStatusText.textContent = 'Change attached file';
          if (attachedFileInfo) {
            attachedFileInfo.classList.remove('hidden');
            if (attachedFilename) attachedFilename.textContent = result.filename || file.name;

            var viewLink = attachedFileInfo.querySelector('a');
            if (!viewLink) {
              viewLink = document.createElement('a');
              viewLink.target = '_blank';
              viewLink.rel = 'noopener noreferrer';
              viewLink.className = 'text-emerald-700 hover:text-emerald-900 underline font-bold shrink-0';
              viewLink.textContent = 'View File';
              attachedFileInfo.appendChild(viewLink);
            }
            var fullFileUrl = result.url.startsWith('/uploads/') ? ((backendUrl || '') + result.url) : result.url;
            viewLink.href = fullFileUrl;
          }

        } catch (error) {
          alert('Upload failed: ' + error.message);
          if (uploadStatusText) uploadStatusText.textContent = 'Click to choose or drag document file here';
          if (documentUrlInput) documentUrlInput.value = '';
        } finally {
          if (submitBtn) {
            submitBtn.disabled = false;
            var editId = document.getElementById('id') ? document.getElementById('id').value : '';
            submitBtn.textContent = editId ? 'Update Document' : 'Save Document';
          }
          if (uploadContainer) uploadContainer.classList.remove('opacity-60', 'pointer-events-none');
        }
      }
    });
  })();
</script>
