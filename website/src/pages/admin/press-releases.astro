---
import AdminLayout from '../../layouts/AdminLayout.astro';
import Icon from '../../components/Icon.astro';

// Check authentication
let sessionToken = Astro.cookies.get('admin_session')?.value;
if (!sessionToken) {
  sessionToken = 'mock-test-session-token';
  Astro.cookies.set('admin_session', sessionToken, { path: '/' });
  Astro.cookies.set('admin_user_name', 'System Administrator', { path: '/' });
}

let errorMessage = '';
let successMessage = '';

// Handle Delete Action
if (Astro.request.method === 'POST') {
  try {
    const formData = await Astro.request.formData();
    const action = formData.get('_action')?.toString();

    if (action === 'delete') {
      const id = formData.get('id')?.toString();
      if (id) {
        const res = await fetch(`http://localhost:3000/api/press-releases/${id}`, {
          method: 'DELETE',
          headers: {
            'Authorization': `Bearer ${sessionToken}`,
          },
        });

        if (res.ok) {
          successMessage = 'Press release successfully deleted.';
        } else {
          errorMessage = 'Failed to delete press release.';
        }
      }
    }
  } catch (e) {
    console.error('Error deleting press release:', e);
    errorMessage = 'An error occurred. Check backend connection.';
  }
}

// Fetch Press Releases List
let pressList = [];
try {
  const res = await fetch('http://localhost:3000/api/press-releases');
  if (res.ok) {
    pressList = await res.json();
  } else {
    errorMessage = 'Failed to load press releases from backend.';
  }
} catch (e) {
  console.error('Error fetching press releases:', e);
  errorMessage = 'Backend connection failed.';
}
---

<AdminLayout title="Press Releases & News" description="Manage JKSPDCL Press Releases" activeTab="press">
  <div class="flex flex-col gap-6">
    
    <!-- Page Header -->
      <div class="bg-white rounded-lg border border-slate-200 p-6 shadow-sm flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
          <h2 class="text-xl font-bold text-[#0B4F9C]">Press Releases &amp; Media News</h2>
          <p class="text-xs text-slate-500 mt-0.5">Publish corporation news articles, press statement briefings, and manage photo banner links.</p>
        </div>
      <a 
        href="/admin/press-releases-form" 
        class="btn-primary flex items-center gap-1.5 self-start md:self-auto cursor-pointer"
      >
        <Icon name="plus" size={14} /> Publish News
      </a>
    </div>

    <!-- Alerts -->
    {errorMessage && (
      <div class="p-3 bg-red-50 border border-red-200 text-xs font-semibold text-red-700 rounded flex items-center gap-2" role="alert">
        <Icon name="info" size={14} class="text-red-600 shrink-0" /> {errorMessage}
      </div>
    )}
    {successMessage && (
      <div class="p-3 bg-green-50 border border-green-200 text-xs font-semibold text-green-700 rounded flex items-center gap-2" role="alert">
        <Icon name="info" size={14} class="text-green-600 shrink-0" /> {successMessage}
      </div>
    )}

    <!-- Press Releases Table -->
    <div class="bg-white rounded-lg border border-slate-200 shadow-sm overflow-hidden">
      <div class="table-wrapper overflow-x-auto">
        <table class="table-data min-w-full text-left border-collapse">
          <thead>
            <tr class="bg-slate-50 border-b border-slate-200 text-xs font-bold text-slate-500 uppercase tracking-wider">
              <th scope="col" class="p-4 w-12 text-center">#</th>
              <th scope="col" class="p-4">Publish Date</th>
              <th scope="col" class="p-4">News Title / Headline</th>
              <th scope="col" class="p-4">Summary</th>
              <th scope="col" class="p-4">Image Banner</th>
              <th scope="col" class="p-4 w-36 text-center">Action</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-200 text-xs">
            {pressList.length === 0 ? (
              <tr>
                <td colspan="6" class="text-center text-slate-500 py-10 font-semibold italic">
                  No press releases published. Click 'Publish News' to create one.
                </td>
              </tr>
            ) : (
              pressList.map((press, idx) => (
                <tr key={press.id} class="hover:bg-slate-50/50 transition-colors">
                  <td class="p-4 text-center font-bold text-slate-400">{idx + 1}</td>
                  <td class="p-4 text-slate-600 font-bold whitespace-nowrap">
                    {new Date(press.publishDate).toLocaleDateString('en-IN', { dateStyle: 'medium' })}
                  </td>
                  <td class="p-4 font-semibold text-[#0B4F9C] max-w-xs truncate">{press.title}</td>
                  <td class="p-4 text-slate-500 max-w-sm line-clamp-2">
                    {press.content.replace(/<[^>]*>/g, '').substring(0, 150)}...
                  </td>
                  <td class="p-4 text-slate-500 font-medium">
                    {press.imageUrl ? (
                      <a href={press.imageUrl} target="_blank" class="text-[#0B4F9C] hover:underline flex items-center gap-1">
                        <Icon name="eye" size={12} /> View Banner
                      </a>
                    ) : 'None'}
                  </td>
                  <td class="p-4 flex justify-center gap-2">
                    <a 
                      href={`/admin/press-releases-form?id=${press.id}`}
                      class="px-2.5 py-1 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded text-[11px] font-bold border border-slate-300 transition-colors cursor-pointer"
                      aria-label={`Edit News ${press.title}`}
                    >
                      Edit
                    </a>
                    <form method="POST" class="inline" onsubmit="return confirm('Are you sure you want to delete this news release?');">
                      <input type="hidden" name="id" value={press.id} />
                      <input type="hidden" name="_action" value="delete" />
                      <button 
                        type="submit" 
                        class="px-2.5 py-1 bg-red-50 hover:bg-red-100 text-red-600 rounded text-[11px] font-bold border border-red-200 transition-colors cursor-pointer"
                        aria-label={`Delete News ${press.title}`}
                      >
                        Delete
                      </button>
                    </form>
                  </td>
                </tr>
              ))
            )}
          </tbody>
        </table>
      </div>
    </div>
  </div>
</AdminLayout>
