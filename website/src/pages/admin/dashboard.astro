---
import AdminLayout from '../../layouts/AdminLayout.astro';
import Icon from '../../components/Icon.astro';
import type { Stats } from './types';

function asArray<T>(value: unknown): T[] {
  if (Array.isArray(value)) return value as T[];
  if (value && typeof value === 'object' && 'value' in value && Array.isArray((value as { value: unknown }).value)) {
    return (value as { value: T[] }).value;
  }
  return [];
}

const sessionToken = Astro.cookies.get('admin_session')?.value || '';

const stats: Stats = {
  operationalCount: 0,
  constructionCount: 0,
  upcomingCount: 0,
  directorsCount: 0,
  dignitariesCount: 0,
  tendersCount: 0,
  notificationsCount: 0,
  downloadsCount: 0,
  agmCount: 0,
  policiesCount: 0,
  galleryCount: 0,
  inquiriesCount: 0,
  usersCount: 0,
  logsCount: 0,
  officialContactsCount: 0,
  subOfficesCount: 0,
  ippCount: 0,
};

let errorMessage = '';

const formattedDate = new Date().toLocaleDateString('en-GB', {
  weekday: 'long',
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});

async function fetchJson<T>(url: string, options?: RequestInit): Promise<T | null> {
  try {
    const res = await fetch(url, options);
    if (!res.ok) return null;
    return (await res.json()) as T;
  } catch {
    return null;
  }
}

try {
  const [
    projectsData,
    directorsData,
    dignitariesData,
    tendersData,
    notificationsData,
    downloadsData,
    agmData,
    policiesData,
    galleryData,
    officialContactsData,
    subOfficesData,
    submissionsData,
    logsData,
    usersData,
    ippProjectsData,
  ] = await Promise.all([
    fetchJson<unknown>('http://localhost:3000/api/projects'),
    fetchJson<unknown>('http://localhost:3000/api/directors'),
    fetchJson<unknown>('http://localhost:3000/api/dignitaries'),
    fetchJson<unknown>('http://localhost:3000/api/tenders'),
    fetchJson<unknown>('http://localhost:3000/api/notifications'),
    fetchJson<unknown>('http://localhost:3000/api/downloads'),
    fetchJson<unknown>('http://localhost:3000/api/agm'),
    fetchJson<unknown>('http://localhost:3000/api/policies'),
    fetchJson<unknown>('http://localhost:3000/api/gallery'),
    fetchJson<unknown>('http://localhost:3000/api/official-contacts'),
    fetchJson<unknown>('http://localhost:3000/api/contact-sub-offices'),
    sessionToken ? fetchJson<unknown>('http://localhost:3000/api/contact', { headers: { Authorization: `Bearer ${sessionToken}` } }) : null,
    sessionToken ? fetchJson<unknown>('http://localhost:3000/api/audit-logs', { headers: { Authorization: `Bearer ${sessionToken}` } }) : null,
    sessionToken ? fetchJson<unknown>('http://localhost:3000/api/users', { headers: { Authorization: `Bearer ${sessionToken}` } }) : null,
    fetchJson<unknown>('http://localhost:3000/api/ipp-projects'),
  ]);

  const projectArray = asArray<{ id?: string; status?: string }>(projectsData);
  stats.operationalCount = projectArray.filter((p) => p.status === 'Operational').length;
  stats.constructionCount = projectArray.filter((p) => p.status === 'Under Construction').length;
  stats.upcomingCount = projectArray.filter((p) => p.status === 'Upcoming' || p.status === 'Under Development').length;
  stats.directorsCount = asArray(directorsData).length;
  stats.dignitariesCount = asArray(dignitariesData).length;
  stats.tendersCount = asArray<{ status?: string }>(tendersData).filter((t) => t.status === 'Active').length;
  stats.notificationsCount = asArray(notificationsData).length;
  stats.downloadsCount = asArray(downloadsData).length;
  stats.agmCount = asArray(agmData).length;
  stats.policiesCount = asArray(policiesData).length;
  stats.galleryCount = asArray(galleryData).length;
  stats.officialContactsCount = asArray(officialContactsData).length;
  stats.subOfficesCount = asArray(subOfficesData).length;
  stats.inquiriesCount = asArray(submissionsData).length;
  stats.usersCount = asArray(usersData).length;
  stats.logsCount = asArray(logsData).length;
  stats.ippCount = asArray(ippProjectsData).length;
} catch (e) {
  console.error('Error fetching dashboard statistics:', e);
  errorMessage = 'Failed to retrieve latest portal statistics. Ensure the backend REST service is online.';
}

const adminUserName = Astro.cookies.get('admin_user_name')?.value || 'System Administrator';

interface ModuleCard {
  title: string;
  count: number | string;
  unit: string;
  href: string;
  icon: string;
}

interface ModuleGroup {
  title: string;
  modules: ModuleCard[];
}

const moduleGroups: ModuleGroup[] = [
  {
    title: 'Projects & Infrastructure',
    modules: [
      {
        title: 'Operational Projects',
        count: stats.operationalCount,
        unit: 'Active Projects',
        href: '/admin/operational-projects',
        icon: 'zap',
      },
      {
        title: 'Under Construction',
        count: stats.constructionCount,
        unit: 'In Execution',
        href: '/admin/under-construction',
        icon: 'hardhat',
      },
      {
        title: 'Projects Under Development',
        count: stats.upcomingCount ?? 0,
        unit: 'In Pipeline',
        href: '/admin/upcoming-projects',
        icon: 'rocket',
      },
      {
        title: 'IPP Projects',
        count: stats.ippCount ?? 0,
        unit: 'Allotted Projects',
        href: '/admin/ipp-projects',
        icon: 'building',
      },
    ],
  },
  {
    title: 'Tenders & Procurement',
    modules: [
      {
        title: 'Tenders & Bids',
        count: stats.tendersCount,
        unit: 'Active Tenders',
        href: '/admin/tenders',
        icon: 'file-text',
      },
    ],
  },
  {
    title: 'Corporate Governance',
    modules: [
      {
        title: 'Dignitaries',
        count: stats.dignitariesCount ?? 0,
        unit: 'Profiles',
        href: '/admin/dignitaries',
        icon: 'award',
      },
      {
        title: 'Board of Directors',
        count: stats.directorsCount ?? 0,
        unit: 'Board Members',
        href: '/admin/board-of-directors',
        icon: 'users',
      },
      {
        title: 'AGM Documents',
        count: stats.agmCount ?? 0,
        unit: 'Documents',
        href: '/admin/agm',
        icon: 'scroll-text',
      },
      {
        title: 'Notifications',
        count: stats.notificationsCount ?? 0,
        unit: 'Notifications',
        href: '/admin/notifications',
        icon: 'bell',
      },
    ],
  },
  {
    title: 'Media, Publications & Resources',
    modules: [
      {
        title: 'Media Gallery',
        count: stats.galleryCount ?? 0,
        unit: 'Photo Albums',
        href: '/admin/gallery',
        icon: 'image',
      },
      {
        title: 'Downloads & Resources',
        count: stats.downloadsCount ?? 0,
        unit: 'Documents',
        href: '/admin/resources',
        icon: 'download',
      },
      {
        title: 'Corporate Policies & CSR',
        count: stats.policiesCount ?? 0,
        unit: 'Policies',
        href: '/admin/policies',
        icon: 'file-text',
      },
    ],
  },
  {
    title: 'Contact Directory',
    modules: [
      {
        title: 'Official Contacts',
        count: stats.officialContactsCount ?? 0,
        unit: 'Key Contacts',
        href: '/admin/official-contacts',
        icon: 'phone',
      },
      {
        title: 'Contact Sub-Offices',
        count: stats.subOfficesCount ?? 0,
        unit: 'Field Offices',
        href: '/admin/contact-sub-offices',
        icon: 'map-pin',
      },
    ],
  },
  {
    title: 'Citizen Services & Administration',
    modules: [
      {
        title: 'Public Inquiries & Feedback',
        count: stats.inquiriesCount ?? 0,
        unit: 'Inquiries',
        href: '/admin/contacts',
        icon: 'mail',
      },
      {
        title: 'User Accounts & Roles',
        count: stats.usersCount ?? 0,
        unit: 'Users',
        href: '/admin/users',
        icon: 'shield-check',
      },
      {
        title: 'System Audit Logs',
        count: stats.logsCount ?? 0,
        unit: 'Audit Events',
        href: '/admin/audit-logs',
        icon: 'scroll-text',
      },
      {
        title: 'Site Settings',
        count: 1,
        unit: 'Configured',
        href: '/admin/site-settings',
        icon: 'settings',
      },
    ],
  },
];
---

<AdminLayout title="Dashboard" description="JKSPDCL Administrative Control Panel Dashboard" activeTab="dashboard">
  <div class="flex flex-col gap-6 max-w-7xl">
    
    <!-- Dashboard Header -->
    <div class="admin-page-header">
      <div>
        <div class="flex items-center gap-2">
          <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 animate-pulse"></span>
          <h1 class="admin-page-title">Welcome back, {adminUserName}</h1>
        </div>
        <p class="admin-page-subtitle">{formattedDate} &mdash; Administrative control &amp; module status overview for the JKSPDC web portal.</p>
      </div>
      <div class="flex items-center gap-2 self-start sm:self-auto">
        <span class="admin-badge admin-badge-success">
          Console Status: Online
        </span>
      </div>
    </div>

    {errorMessage && (
      <div class="p-3 bg-red-50 border border-red-200 rounded text-xs text-red-700 font-semibold flex items-center gap-2" role="alert">
        <Icon name="info" size={14} class="text-red-600 shrink-0" />
        <span>{errorMessage}</span>
      </div>
    )}

    <!-- Module Groups with Compact Module Count Cards -->
    <div class="flex flex-col gap-6">
      {moduleGroups.map((group) => (
        <section class="flex flex-col gap-2.5" aria-label={group.title}>
          <div class="flex items-center gap-2 pb-1.5 border-b border-slate-200">
            <span class="w-1.5 h-3.5 bg-[#0B4F9C] rounded-xs"></span>
            <h2 class="text-xs font-bold text-slate-800 uppercase tracking-wider">
              {group.title}
            </h2>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-3.5">
            {group.modules.map((mod) => (
              <a 
                href={mod.href}
                class="group bg-white rounded-lg border border-slate-200 hover:border-[#0B4F9C] hover:shadow-xs p-4 flex flex-col justify-between min-h-[128px] transition-all duration-150 focus:outline-none focus:ring-1 focus:ring-[#0B4F9C] focus:border-[#0B4F9C]"
                aria-label={`Open ${mod.title} - ${mod.count} ${mod.unit}`}
              >
                <!-- Top Row: Icon & Module Name -->
                <div class="flex items-start gap-2.5 min-w-0">
                  <div class="w-8 h-8 rounded bg-slate-50 text-[#0B4F9C] border border-slate-200 flex items-center justify-center shrink-0 group-hover:bg-[#0B4F9C] group-hover:text-white group-hover:border-[#0B4F9C] transition-colors duration-150">
                    <Icon name={mod.icon} size={15} strokeWidth={2} />
                  </div>
                  <div class="min-w-0 flex-1 pt-0.5">
                    <h3 class="text-xs font-bold text-slate-800 leading-snug group-hover:text-[#0B4F9C] transition-colors break-normal">
                      {mod.title}
                    </h3>
                  </div>
                </div>

                <!-- Bottom Row: Count + Label + Action -->
                <div class="mt-3 pt-2.5 border-t border-slate-100 flex items-end justify-between gap-2">
                  <div class="min-w-0">
                    <div class="text-2xl font-black text-slate-900 tracking-tight leading-none">
                      {mod.count}
                    </div>
                    <div class="text-[11px] font-medium text-slate-500 mt-1 leading-tight whitespace-nowrap">
                      {mod.unit}
                    </div>
                  </div>
                  <span class="text-xs font-bold text-[#0B4F9C] group-hover:text-[#073B75] inline-flex items-center gap-1 group-hover:translate-x-0.5 transition-transform duration-150 shrink-0">
                    <span>Manage</span>
                    <Icon name="arrow-right" size={11} strokeWidth={2.5} />
                  </span>
                </div>
              </a>
            ))}
          </div>
        </section>
      ))}
    </div>

  </div>
</AdminLayout>
