];
---

<AdminLayout title="Dashboard" description="JKSPDCL Administrative Control Panel Dashboard" activeTab="dashboard">
  <div class="flex flex-col gap-6">
    
    <!-- Welcome Header Banner -->
    <div class="bg-gradient-to-r from-blue-50/90 via-white to-[#EAF4FF]/50 rounded-xl border border-blue-200/90 border-t-3 border-t-[#0B4F9C] p-6 shadow-xs flex flex-col md:flex-row md:items-center justify-between gap-4">
      <div>
        <div class="flex items-center gap-2">
          <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 ring-4 ring-emerald-100 animate-pulse"></span>
          <h1 class="text-xl font-extrabold text-[#0B4F9C] tracking-tight">Welcome back, {adminUserName}</h1>
        </div>
        <p class="text-xs text-slate-700 font-medium mt-1">{formattedDate} &mdash; Administrative control &amp; content management hub for the JKSPDC web portal.</p>
      </div>
      <div class="flex items-center gap-2 self-start md:self-auto">
        <span class="text-[11px] font-bold text-[#0B4F9C] bg-white px-3.5 py-1.5 rounded-lg border border-[#BDD7EE] shadow-2xs flex items-center gap-1.5">
          <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
          Console Status: <span class="text-emerald-700 font-extrabold">Online</span>
        </span>
      </div>
    </div>

    {errorMessage && (
      <div class="p-4 bg-amber-50 border-l-4 border-amber-500 rounded-lg text-xs text-amber-800 font-semibold shadow-xs flex items-start gap-2.5" role="alert">
        <Icon name="info" size={16} class="text-amber-600 shrink-0 mt-0.5" />
        <div class="flex flex-col gap-0.5">
          <span>Backend Notification:</span>
          <span class="text-[11px] font-normal text-amber-700">{errorMessage}</span>
        </div>
      </div>
    )}

    <!-- Top Executive Overview KPI Cards (High-Level Operational Status) -->
    <div class="grid grid-cols-2 sm:grid-cols-3 xl:grid-cols-6 gap-4">
      {statCards.map((card) => (
        <a 
          href={card.href} 
          class={`group rounded-xl border p-4 shadow-xs hover:shadow-md transition-all duration-200 flex flex-col justify-between min-h-[148px] relative overflow-hidden ${card.bg} ${card.border}`}
        >
          <!-- Top Accent Bar -->
          <div class={`absolute top-0 inset-x-0 h-1.5 ${card.topBar}`}></div>

          <!-- Top Row: Icon Badge & Category Tag -->
          <div class="flex items-center justify-between gap-2 pt-0.5">
            <div class={`w-10 h-10 rounded-xl flex items-center justify-center shadow-xs shrink-0 ${card.iconBg} group-hover:scale-105 transition-transform duration-200`}>
              <Icon name={card.icon} size={18} strokeWidth={2.2} />
            </div>
            <span class={`text-[10px] font-extrabold uppercase tracking-wider px-2 py-0.5 rounded-md border shadow-2xs ${card.badgeBg}`}>
              {card.badge}
            </span>
          </div>

          <!-- Middle Row: Big Metric Count & Full-Width Label -->
          <div class="my-2">
            <div class="text-2xl font-black text-slate-900 tracking-tight leading-none group-hover:translate-x-0.5 transition-transform">
              {card.count}
            </div>
            <div class={`text-[11px] font-black uppercase tracking-wider mt-1 truncate ${card.textColor}`} title={card.label}>
              {card.label}
            </div>
          </div>

          <!-- Bottom Row: Clean Action Bar -->
          <div class="pt-2 border-t border-slate-200/70 flex items-center justify-between text-[11px] font-bold text-slate-700 group-hover:text-slate-900 transition-colors">
            <span>Manage</span>
            <Icon name="arrow-right" size={12} class="group-hover:translate-x-1 transition-transform duration-200" strokeWidth={2.5} />
          </div>
        </a>
      ))}
    </div>

    <!-- REAL-TIME ENTERPRISE STATISTICS & OPERATIONAL INTELLIGENCE -->
    <section class="bg-white rounded-2xl border border-slate-200/90 shadow-sm p-6 flex flex-col gap-6 relative overflow-hidden" aria-label="Enterprise Operational Statistics">
      
      <!-- Top Section Header with Title & Live Telemetry Badge & Toggle -->
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-slate-100 pb-4">
        <div>
          <div class="flex items-center gap-2">
            <div class="w-8 h-8 rounded-lg bg-[#EAF4FF] text-[#0B4F9C] flex items-center justify-center font-bold shrink-0">
              <Icon name="bar-chart" size={16} strokeWidth={2.5} />
            </div>
            <div>
              <h2 class="text-sm font-black text-[#0B4F9C] uppercase tracking-wider">
                Enterprise Statistics &amp; Operational Analytics
              </h2>
              <p class="text-xs text-slate-500 font-medium">Real-time analytical telemetry synthesized directly from live JKSPDC corporate databases</p>
            </div>
          </div>
        </div>
        
        <div class="flex items-center gap-3">
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-[11px] font-bold bg-emerald-50 text-emerald-700 border border-emerald-200 shadow-2xs">
            <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
            Live DB Telemetry
          </span>
          <button 
            id="toggle-stats-panel-btn"
            type="button"
            class="text-[11px] font-bold text-slate-600 hover:text-[#0B4F9C] bg-slate-100 hover:bg-slate-200 px-3 py-1.5 rounded-lg border border-slate-200 cursor-pointer transition-colors select-none"
          >
            <span id="stats-toggle-label">Hide Statistics</span>
          </button>
        </div>
      </div>

      <!-- Main 3-Pillar Analytics Grid -->
      <div id="stats-panel-content" class="grid grid-cols-1 lg:grid-cols-3 gap-6">

        <!-- PILLAR 1: Hydro Generation & Capacity Portfolio -->
        <div class="bg-slate-50/70 rounded-xl border border-slate-200/80 p-5 flex flex-col justify-between gap-5 relative group hover:border-[#0B4F9C]/50 transition-colors">
          <div class="flex flex-col gap-3">
            <div class="flex items-center justify-between">
              <span class="text-xs font-black text-[#0B4F9C] uppercase tracking-wide flex items-center gap-1.5">
                <Icon name="zap" size={14} class="text-[#0B4F9C]" strokeWidth={2.5} /> Hydro Power Capacity
              </span>
              <span class="text-[10px] font-bold px-2 py-0.5 rounded bg-blue-100 text-[#0B4F9C] border border-blue-200">
                {rawProjects.length} Stations
              </span>
            </div>

            <!-- Big Stat Figures -->
            <div class="grid grid-cols-2 gap-3 bg-white p-3.5 rounded-xl border border-slate-200 shadow-2xs">
              <div>
                <span class="text-[10px] font-bold text-slate-500 uppercase tracking-wider block">Total Monitored</span>
                <span class="text-xl font-black text-slate-900 tracking-tight">{totalCapacityMw.toLocaleString('en-IN', { maximumFractionDigits: 1 })} <span class="text-xs font-bold text-slate-500">MW</span></span>
              </div>
              <div>
                <span class="text-[10px] font-bold text-slate-500 uppercase tracking-wider block">Design Potential</span>
                <span class="text-xl font-black text-[#0B4F9C] tracking-tight">{totalDesignEnergyMu.toLocaleString('en-IN', { maximumFractionDigits: 1 })} <span class="text-xs font-bold text-slate-500">MU</span></span>
              </div>
            </div>

            <!-- Proportional Portfolio Progress Bar -->
            <div class="flex flex-col gap-1.5 pt-1">
              <div class="flex justify-between text-[11px] font-bold">
                <span class="text-[#0B4F9C] flex items-center gap-1">
                  <span class="w-2 h-2 rounded-full bg-[#0B4F9C]"></span> Operational ({operationalCapacityMw.toLocaleString('en-IN', { maximumFractionDigits: 1 })} MW)
                </span>
                <span class="text-amber-700 flex items-center gap-1">
                  <span class="w-2 h-2 rounded-full bg-amber-500"></span> Pipeline ({pipelineCapacityMw.toLocaleString('en-IN', { maximumFractionDigits: 1 })} MW)
                </span>
              </div>
              <div class="h-2.5 w-full bg-slate-200 rounded-full overflow-hidden flex shadow-inner">
                <div class="bg-[#0B4F9C] h-full transition-all duration-500" style={`width: ${operationalPct}%`} title={`Operational: ${operationalPct}%`}></div>
                <div class="bg-amber-500 h-full transition-all duration-500" style={`width: ${pipelinePct}%`} title={`Pipeline: ${pipelinePct}%`}></div>
              </div>
              <div class="flex justify-between text-[10px] text-slate-500 font-semibold px-0.5">
                <span>{operationalPct}% Commissioned</span>
                <span>{pipelinePct}% Development Pipeline</span>
              </div>
            </div>

            <!-- Basin Allocation Breakdown -->
            <div class="flex flex-col gap-2 pt-2 border-t border-slate-200/80">
              <span class="text-[10px] font-extrabold text-slate-500 uppercase tracking-wider">River Basin Distribution</span>
              <div class="flex flex-col gap-2">
                {basinStats.map((basin) => (
                  <div class="flex flex-col gap-1">
                    <div class="flex justify-between text-[11px] font-semibold text-slate-700">
                      <span class="font-bold text-slate-900 truncate">{basin.name} ({basin.count})</span>
                      <span>{basin.mw} MW <span class="text-slate-400 font-normal">({basin.pct}%)</span></span>
                    </div>
                    <div class="h-1.5 w-full bg-slate-200 rounded-full overflow-hidden">
                      <div class="bg-blue-600 h-full rounded-full" style={`width: ${basin.pct}%`}></div>
                    </div>
                  </div>
                ))}
              </div>
            </div>
          </div>

          <a href="/admin/operational-projects" class="inline-flex items-center justify-between text-xs font-bold text-[#0B4F9C] hover:text-[#084A8F] pt-2 border-t border-slate-200 group-hover:translate-x-0.5 transition-all">
            <span>Explore Hydro Generating Stations</span>
            <Icon name="arrow-right" size={12} strokeWidth={2.5} />
          </a>
        </div>

        <!-- PILLAR 2: Procurement & Tendering Analytics -->
        <div class="bg-slate-50/70 rounded-xl border border-slate-200/80 p-5 flex flex-col justify-between gap-5 relative group hover:border-violet-500/50 transition-colors">
          <div class="flex flex-col gap-3">
            <div class="flex items-center justify-between">
              <span class="text-xs font-black text-violet-800 uppercase tracking-wide flex items-center gap-1.5">
                <Icon name="file-text" size={14} class="text-violet-700" strokeWidth={2.5} /> Procurement &amp; Bids
              </span>
              <span class="text-[10px] font-bold px-2 py-0.5 rounded bg-violet-100 text-violet-900 border border-violet-200">
                {rawTenders.length} Total NITs
              </span>
            </div>

            <!-- Big Stat Figures -->
            <div class="grid grid-cols-2 gap-3 bg-white p-3.5 rounded-xl border border-slate-200 shadow-2xs">
              <div>
                <span class="text-[10px] font-bold text-slate-500 uppercase tracking-wider block">Live Active Bids</span>
                <span class="text-xl font-black text-violet-700 tracking-tight">{stats.tendersCount} <span class="text-xs font-bold text-slate-500">Active</span></span>
              </div>
              <div>
                <span class="text-[10px] font-bold text-slate-500 uppercase tracking-wider block">Closed / Archived</span>
                <span class="text-xl font-black text-slate-700 tracking-tight">{Math.max(0, rawTenders.length - stats.tendersCount)} <span class="text-xs font-bold text-slate-500">Bids</span></span>
              </div>
            </div>

            <!-- Work Category Breakdown -->
            <div class="flex flex-col gap-2 pt-2 border-t border-slate-200/80">
              <span class="text-[10px] font-extrabold text-slate-500 uppercase tracking-wider">Tender Work Categories</span>
              <div class="flex flex-col gap-2">
                {tenderCatStats.length > 0 ? (
                  tenderCatStats.map((cat) => (
                    <div class="flex flex-col gap-1">
                      <div class="flex justify-between text-[11px] font-semibold text-slate-700">
                        <span class="font-bold text-slate-900">{cat.category}</span>
                        <span>{cat.count} NITs <span class="text-slate-400 font-normal">({cat.pct}%)</span></span>
                      </div>
                      <div class="h-1.5 w-full bg-slate-200 rounded-full overflow-hidden">
                        <div class="bg-violet-600 h-full rounded-full" style={`width: ${cat.pct}%`}></div>
                      </div>
                    </div>
                  ))
                ) : (
                  <p class="text-xs text-slate-400 italic">No category data available</p>
                )}
              </div>
            </div>

            <!-- Fast Status Badges -->
            <div class="p-3 bg-white rounded-lg border border-slate-200 flex items-center justify-between text-xs">
              <span class="text-slate-600 font-medium">Bidding Status</span>
              <span class="text-emerald-700 font-bold flex items-center gap-1.5">
                <span class="w-2 h-2 rounded-full bg-emerald-500"></span> All Active NITs Current
              </span>
            </div>
          </div>

          <a href="/admin/tenders" class="inline-flex items-center justify-between text-xs font-bold text-violet-700 hover:text-violet-900 pt-2 border-t border-slate-200 group-hover:translate-x-0.5 transition-all">
            <span>Manage Tender Notices &amp; Bids</span>
            <Icon name="arrow-right" size={12} strokeWidth={2.5} />
          </a>
        </div>

        <!-- PILLAR 3: Corporate Governance & Digital Records -->
        <div class="bg-slate-50/70 rounded-xl border border-slate-200/80 p-5 flex flex-col justify-between gap-5 relative group hover:border-emerald-500/50 transition-colors">
          <div class="flex flex-col gap-3">
            <div class="flex items-center justify-between">
              <span class="text-xs font-black text-emerald-800 uppercase tracking-wide flex items-center gap-1.5">
                <Icon name="shield-check" size={14} class="text-emerald-700" strokeWidth={2.5} /> Compliance &amp; Records
              </span>
              <span class="text-[10px] font-bold px-2 py-0.5 rounded bg-emerald-100 text-emerald-900 border border-emerald-200">
                100% GIGW 3.0
              </span>
            </div>

            <!-- Big Stat Figures -->
            <div class="grid grid-cols-2 gap-3 bg-white p-3.5 rounded-xl border border-slate-200 shadow-2xs">
              <div>
                <span class="text-[10px] font-bold text-slate-500 uppercase tracking-wider block">Published Records</span>
                <span class="text-xl font-black text-emerald-700 tracking-tight">{totalCorporateDocs} <span class="text-xs font-bold text-slate-500">Docs</span></span>
              </div>
              <div>
                <span class="text-[10px] font-bold text-slate-500 uppercase tracking-wider block">Security Events</span>
                <span class="text-xl font-black text-slate-900 tracking-tight">{stats.logsCount || 0} <span class="text-xs font-bold text-slate-500">Logged</span></span>
              </div>
            </div>

            <!-- Document Category Registry Breakdown -->
            <div class="flex flex-col gap-1.5 pt-2 border-t border-slate-200/80">
              <span class="text-[10px] font-extrabold text-slate-500 uppercase tracking-wider mb-0.5">Mandatory Corporate Registers</span>
              <div class="grid grid-cols-2 gap-2">
                {docBreakdown.map((item) => (
                  <a href={item.href} class="p-2 bg-white rounded-lg border border-slate-200 hover:border-[#0B4F9C] flex items-center justify-between transition-colors shadow-2xs">
                    <span class="text-[11px] font-bold text-slate-700 truncate pr-1" title={item.label}>{item.label}</span>
                    <span class="text-xs font-black text-[#0B4F9C] shrink-0 bg-blue-50 px-1.5 py-0.5 rounded">{item.count}</span>
                  </a>
                ))}
              </div>
            </div>

            <!-- Citizen Inquiries Status -->
            <div class="p-3 bg-white rounded-lg border border-slate-200 flex items-center justify-between text-xs">
              <span class="text-slate-600 font-medium">Citizen Inquiries</span>
              <span class="font-bold text-[#0B4F9C] flex items-center gap-1.5">
                <Icon name="mail" size={12} class="text-[#0B4F9C]" />
                {stats.inquiriesCount || 0} Submissions
              </span>
            </div>
          </div>

          <a href="/admin/site-settings" class="inline-flex items-center justify-between text-xs font-bold text-emerald-700 hover:text-emerald-900 pt-2 border-t border-slate-200 group-hover:translate-x-0.5 transition-all">
            <span>Corporate Compliance &amp; Settings</span>
            <Icon name="arrow-right" size={12} strokeWidth={2.5} />
          </a>
        </div>

      </div>
    </section>

    <!-- Complete Portal Modules Directory (Categorized & Non-Redundant) -->
    <div class="flex flex-col gap-6">
      <div class="flex items-center justify-between border-b border-slate-200 pb-2">
        <div>
          <h2 class="text-sm font-extrabold text-[#0B4F9C] uppercase tracking-wider flex items-center gap-2">
            <Icon name="landmark" size={16} class="text-[#0B4F9C]" /> All Portal Modules &amp; Management Hub
          </h2>
          <p class="text-xs text-slate-500 mt-0.5">Direct administrative access to all portal services, content managers, and governance registers.</p>
        </div>
      </div>

      {moduleGroups.map((group) => (
        <div class="bg-white rounded-xl border border-slate-200/90 shadow-xs p-5 flex flex-col gap-4">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-1 border-b border-slate-100 pb-2.5">
            <div>
              <h3 class="text-xs font-bold text-slate-900 uppercase tracking-wide flex items-center gap-2">
                <span class="w-1.5 h-3.5 bg-[#0B4F9C] rounded-xs"></span>
                {group.title}
              </h3>
              <p class="text-[11px] text-slate-500 font-medium ml-3.5">{group.subtitle}</p>
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-3.5">
            {group.modules.map((mod) => (
              <div class="group border border-slate-200/90 hover:border-[#0B4F9C] rounded-xl p-4 bg-slate-50/40 hover:bg-white transition-all duration-200 shadow-2xs hover:shadow-xs flex flex-col justify-between gap-3">
                <div class="flex items-start gap-3">
                  <div class={`w-10 h-10 rounded-xl flex items-center justify-center shrink-0 shadow-xs group-hover:scale-105 transition-transform ${mod.iconBg}`}>
                    <Icon name={mod.icon} size={18} strokeWidth={2.2} />
                  </div>
                  <div class="flex-1 min-w-0">
                    <div class="flex items-center justify-between gap-1">
                      <h4 class="text-xs font-bold text-slate-900 group-hover:text-[#0B4F9C] transition-colors truncate" title={mod.title}>
                        {mod.title}
                      </h4>
                      {mod.count && (
                        <span class="text-[10px] font-extrabold bg-white border border-slate-200 px-1.5 py-0.5 rounded text-slate-700 shrink-0">
                          {mod.count}
                        </span>
                      )}
                    </div>
                    <p class="text-[11px] text-slate-500 font-normal leading-relaxed mt-1 line-clamp-2" title={mod.desc}>
                      {mod.desc}
                    </p>
                  </div>
                </div>

                <div class="flex items-center justify-between gap-2 pt-2.5 border-t border-slate-200/70 text-[11px]">
                  <a 
                    href={mod.href} 
                    class="font-bold text-[#0B4F9C] hover:underline inline-flex items-center gap-1 group-hover:translate-x-0.5 transition-transform"
                  >
                    Manage Module <Icon name="arrow-right" size={11} strokeWidth={2.5} />
                  </a>

                  {mod.addHref && (
                    <a 
                      href={mod.addHref} 
                      class="text-[10px] font-extrabold px-2 py-0.5 rounded bg-blue-50 hover:bg-blue-100 text-[#0B4F9C] border border-blue-200 transition-colors"
                    >
                      {mod.addLabel || '+ Add'}
                    </a>
                  )}
                </div>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>

    <!-- Bottom Grids: Recent Inquiries & System Activities -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
      
      <!-- Recent Public Inquiries -->
      <div class="bg-white border border-slate-200/90 rounded-xl shadow-xs p-6 flex flex-col gap-4">
        <div class="flex items-center justify-between border-b border-slate-100 pb-3">
          <h3 class="text-xs font-bold text-slate-700 uppercase tracking-wider flex items-center gap-2">
            <Icon name="mail" size={14} class="text-[#0B4F9C]" /> Recent Public Inquiries
          </h3>
          <a href="/admin/contacts" class="text-xs text-[#0B4F9C] font-bold hover:underline inline-flex items-center gap-1">
            View All <Icon name="arrow-right" size={11} />
          </a>
        </div>

        <div class="flex flex-col gap-3">
          {recentInquiries.length === 0 ? (
            <p class="text-xs text-slate-400 italic py-8 text-center font-medium">No recent citizen inquiries found.</p>
          ) : (
            recentInquiries.map((inq) => (
              <div key={inq.id ?? `${inq.email ?? 'inquiry'}-${inq.createdAt ?? ''}`} class="p-3.5 border border-slate-200/80 rounded-lg bg-slate-50/50 hover:bg-slate-50 transition-colors flex flex-col gap-1.5">
                <div class="flex justify-between items-start gap-2">
                  <span class="text-xs font-bold text-[#0B4F9C]">{inq.name}</span>
                  <span class="text-[10px] text-slate-500 font-semibold bg-white px-2 py-0.5 rounded border border-slate-200">
                    {toDateOrNull(inq.createdAt)?.toLocaleDateString('en-IN', { dateStyle: 'short' }) ?? ''}
                  </span>
                </div>
                <p class="text-[11px] text-slate-500 font-medium">{inq.email}</p>
                <p class="text-xs text-slate-600 leading-relaxed font-normal mt-0.5 border-t border-slate-200/60 pt-1.5 line-clamp-2">
                  {inq.message}
                </p>
              </div>
            ))
          )}
        </div>
      </div>

      <!-- Recent System Activities -->
      <div class="bg-white border border-slate-200/90 rounded-xl shadow-xs p-6 flex flex-col gap-4">
        <div class="flex items-center justify-between border-b border-slate-100 pb-3">
          <h3 class="text-xs font-bold text-slate-700 uppercase tracking-wider flex items-center gap-2">
            <Icon name="scroll-text" size={14} class="text-[#0B4F9C]" /> Recent System Activities
          </h3>
          <a href="/admin/audit-logs" class="text-xs text-[#0B4F9C] font-bold hover:underline inline-flex items-center gap-1">
            All Logs <Icon name="arrow-right" size={11} />
          </a>
        </div>

        <div class="flex flex-col gap-3">
          {recentLogs.length === 0 ? (
            <p class="text-xs text-slate-400 italic py-8 text-center font-medium">No administrative activity logged yet.</p>
          ) : (
            recentLogs.map((log) => (
              <div key={log.id ?? `${log.action ?? 'log'}-${log.createdAt ?? ''}`} class="p-3.5 border border-slate-200/80 rounded-lg bg-slate-50/50 hover:bg-slate-50 transition-colors flex gap-3.5 items-center">
                <div class="w-8 h-8 rounded-lg bg-slate-100 border border-slate-200 text-[#0B4F9C] flex items-center justify-center shrink-0">
                  <Icon name="scroll-text" size={15} />
                </div>
                <div class="flex flex-col flex-1 gap-0.5">
                  <div class="flex justify-between items-start gap-2">
                    <span class="text-xs font-bold text-slate-800 tracking-wide uppercase">{log.action}</span>
                    <span class="text-[10px] text-slate-500 font-semibold bg-white px-2 py-0.5 rounded border border-slate-200">
                      {toDateOrNull(log.createdAt)?.toLocaleTimeString('en-IN', { hour: '2-digit', minute: '2-digit' }) ?? ''}
                    </span>
                  </div>
                  <span class="text-[11px] font-medium text-slate-500">IP: {log.ipAddress}</span>
                  {log.details !== undefined && log.details !== null && (
                    <span class="text-[11px] text-slate-500 italic mt-0.5 line-clamp-1 border-t border-slate-200/60 pt-1">
                      {typeof log.details === 'string' ? log.details : JSON.stringify(log.details)}
                    </span>
                  )}
                </div>
              </div>
            ))
          )}
        </div>
      </div>

    </div>

  </div>

  <script is:inline>
    function initStatsPanelToggle() {
      var btn = document.getElementById('toggle-stats-panel-btn');
      var content = document.getElementById('stats-panel-content');
      var label = document.getElementById('stats-toggle-label');
      if (!btn || !content || !label) return;

      var isHidden = localStorage.getItem('admin_stats_hidden') === 'true';
      if (isHidden) {
        content.classList.add('hidden');
        label.textContent = 'Show Statistics';
      } else {
        content.classList.remove('hidden');
        label.textContent = 'Hide Statistics';
      }

      btn.onclick = function() {
        var hiddenNow = content.classList.toggle('hidden');
        label.textContent = hiddenNow ? 'Show Statistics' : 'Hide Statistics';
        try {
          localStorage.setItem('admin_stats_hidden', hiddenNow ? 'true' : 'false');
        } catch (e) {}
      };
    }

    document.addEventListener('astro:page-load', initStatsPanelToggle);
    initStatsPanelToggle();
  </script>
</AdminLayout>
