      },
      {
        title: 'Corporate Policies, CSR, MoA / AoA & Downloads',
        desc: 'Corporate governance policies, CSR initiatives, MoA/AoA, and general downloads',
        count: `${stats.policiesCount} Documents`,
        href: '/admin/policies',
        addHref: '/admin/policies-form',
        addLabel: '+ Add Document',
        icon: 'file-text',
        color: 'text-slate-700',
