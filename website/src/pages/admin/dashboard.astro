---
import AdminLayout from '../../layouts/AdminLayout.astro';
import Icon from '../../components/Icon.astro';
import type { Stats, ProjectDto, DirectorDto, TenderDto, ContactSubmissionDto, AuditLogDto } from './types';

function asArray<T>(value: unknown): T[] {
  return Array.isArray(value) ? (value as T[]) : [];
}

function toDateOrNull(value: unknown): Date | null {
  if (typeof value !== 'string') return null;
  const d = new Date(value);
  return Number.isNaN(d.getTime()) ? null : d;
}

const sessionToken = Astro.cookies.get('admin_session')?.value || '';

const stats: Stats = {
  operationalCount: 0,
  constructionCount: 0,
  upcomingCount: 0,
  directorsCount: 0,
  dignitariesCount: 0,
  tendersCount: 0,
  notificationsCount: 0,
  downloadsCount: 0,
  agmCount: 0,
  policiesCount: 0,
  galleryCount: 0,
  inquiriesCount: 0,
  usersCount: 0,
  logsCount: 0,
};

let recentInquiries: ContactSubmissionDto[] = [];
let recentLogs: AuditLogDto[] = [];
let errorMessage = '';

const formattedDate = new Date().toLocaleDateString('en-GB', {
  weekday: 'long',
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});

async function fetchJson<T>(url: string, options?: RequestInit): Promise<T | null> {
  try {
    const res = await fetch(url, options);
    if (!res.ok) return null;
    return (await res.json()) as T;
  } catch {
    return null;
  }
}

let projectsData: unknown = [];
let tendersData: unknown = [];

try {
  let directorsData: unknown = [];
  let dignitariesData: unknown = [];
  let notificationsData: unknown = [];
  let downloadsData: unknown = [];
  let agmData: unknown = [];
  let policiesData: unknown = [];
  let galleryData: unknown = [];
  let submissionsData: unknown = [];
  let logsData: unknown = [];
  let usersData: unknown = [];

  [
    projectsData,
    directorsData,
    dignitariesData,
    tendersData,
    notificationsData,
    downloadsData,
    agmData,
    policiesData,
    galleryData,
    submissionsData,
    logsData,
    usersData
  ] = await Promise.all([
    fetchJson<unknown>('http://localhost:3000/api/projects'),
    fetchJson<unknown>('http://localhost:3000/api/directors'),
    fetchJson<unknown>('http://localhost:3000/api/dignitaries'),
    fetchJson<unknown>('http://localhost:3000/api/tenders'),
    fetchJson<unknown>('http://localhost:3000/api/notifications'),
    fetchJson<unknown>('http://localhost:3000/api/downloads'),
    fetchJson<unknown>('http://localhost:3000/api/agm'),
    fetchJson<unknown>('http://localhost:3000/api/policies'),
    fetchJson<unknown>('http://localhost:3000/api/gallery'),
    sessionToken ? fetchJson<unknown>('http://localhost:3000/api/contact', { headers: { Authorization: `Bearer ${sessionToken}` } }) : null,
    sessionToken ? fetchJson<unknown>('http://localhost:3000/api/audit-logs', { headers: { Authorization: `Bearer ${sessionToken}` } }) : null,
    sessionToken ? fetchJson<unknown>('http://localhost:3000/api/users', { headers: { Authorization: `Bearer ${sessionToken}` } }) : null,
  ]);

  const projectArray = asArray<{ id?: string; status?: string }>(projectsData);
  stats.operationalCount = projectArray.filter((p) => p.status === 'Operational').length;
  stats.constructionCount = projectArray.filter((p) => p.status === 'Under Construction').length;
  stats.upcomingCount = projectArray.filter((p) => p.status === 'Under Development').length;
  stats.directorsCount = asArray(directorsData).length;
  stats.dignitariesCount = asArray(dignitariesData).length;
  stats.tendersCount = asArray<{ status?: string }>(tendersData).filter((t) => t.status === 'Active').length;
  stats.notificationsCount = asArray(notificationsData).length;
  stats.downloadsCount = asArray(downloadsData).length;
  stats.agmCount = asArray(agmData).length;
  stats.policiesCount = asArray(policiesData).length;
  stats.galleryCount = asArray(galleryData).length;
  stats.inquiriesCount = asArray(submissionsData).length;
  stats.usersCount = asArray(usersData).length;
  stats.logsCount = asArray(logsData).length;

  if (submissionsData) {
    recentInquiries = asArray<ContactSubmissionDto>(submissionsData).slice(0, 5);
  }
  if (logsData) {
    recentLogs = asArray<AuditLogDto>(logsData).slice(0, 5);
  }
} catch (e) {
  console.error('Error fetching dashboard statistics:', e);
  errorMessage = 'Failed to retrieve latest portal statistics. Ensure the backend REST service is online.';
}

interface ProjectRecord {
  id?: string;
  name?: string;
  type?: string;
  capacityMw?: number;
  status?: string;
  location?: string;
  designEnergy?: number;
  basin?: string;
  sector?: string;
}

interface TenderRecord {
  id?: string;
  referenceNo?: string;
  title?: string;
  status?: string;
  workCategory?: string;
  locationTag?: string;
  publishDate?: string;
  closingDate?: string;
}

// 1. Hydro & Energy Analytics (Real Live Data)
const rawProjects = asArray<ProjectRecord>(projectsData);
let totalCapacityMw = 0;
let operationalCapacityMw = 0;
let pipelineCapacityMw = 0;
let totalDesignEnergyMu = 0;
const basinMap: Record<string, { mw: number; count: number }> = {};

rawProjects.forEach((p) => {
  const mw = Number(p.capacityMw) || 0;
  const energy = Number(p.designEnergy) || 0;
  totalCapacityMw += mw;
  totalDesignEnergyMu += energy;

  if (p.status === 'Operational') {
    operationalCapacityMw += mw;
  } else {
    pipelineCapacityMw += mw;
  }

  let rawBasin = (p.basin || 'Other Basins').trim();
  if (rawBasin === 'Chenab') rawBasin = 'Chenab Basin';
  if (rawBasin === 'Jhelum' || rawBasin === 'Jhelum River') rawBasin = 'Jhelum River Basin';
  if (rawBasin === 'Ravi') rawBasin = 'Ravi Basin';
  if (!basinMap[rawBasin]) basinMap[rawBasin] = { mw: 0, count: 0 };
  basinMap[rawBasin].mw += mw;
  basinMap[rawBasin].count += 1;
});

const operationalPct = totalCapacityMw > 0 ? Math.round((operationalCapacityMw / totalCapacityMw) * 100) : 0;
const pipelinePct = totalCapacityMw > 0 ? (100 - operationalPct) : 0;

const basinStats = Object.entries(basinMap)
  .map(([basin, data]) => ({
    name: basin,
    mw: Math.round(data.mw * 10) / 10,
    count: data.count,
    pct: totalCapacityMw > 0 ? Math.round((data.mw / totalCapacityMw) * 100) : 0,
  }))
  .sort((a, b) => b.mw - a.mw);

// 2. Tenders & Procurement Analytics (Real Live Data)
const rawTenders = asArray<TenderRecord>(tendersData);
const tenderCategories: Record<string, number> = {};
rawTenders.forEach((t) => {
  const cat = t.workCategory || 'General Civil';
  tenderCategories[cat] = (tenderCategories[cat] || 0) + 1;
});
const tenderCatStats = Object.entries(tenderCategories)
  .map(([cat, count]) => ({
    category: cat,
    count,
    pct: rawTenders.length > 0 ? Math.round((count / rawTenders.length) * 100) : 0,
  }))
  .sort((a, b) => b.count - a.count);

// 3. Corporate Documentation & Compliance Health (Real Live Data)
const totalCorporateDocs = 
  (stats.downloadsCount || 0) +
  (stats.agmCount || 0) +
  (stats.policiesCount || 0) +
  (stats.notificationsCount || 0);

const docBreakdown = [
  { label: 'AGM Notices & Filings', count: stats.agmCount || 0, href: '/admin/agm' },
  { label: 'Orders & Circulars', count: stats.notificationsCount || 0, href: '/admin/notifications' },
  { label: 'Corporate Policies, CSR, MoA/AoA & Downloads', count: stats.policiesCount || 0, href: '/admin/policies' },
];

const adminUserName = Astro.cookies.get('admin_user_name')?.value || 'System Administrator';

// Top High-Level Executive Summary Cards
const statCards = [
  {
    label: 'Operational Hydro',
    badge: 'Live',
    count: stats.operationalCount,
    href: '/admin/operational-projects',
    icon: 'zap',
    bg: 'bg-gradient-to-br from-blue-50/90 via-white to-blue-100/40',
    border: 'border-blue-200 hover:border-[#0B4F9C]',
    topBar: 'bg-[#0B4F9C]',
    iconBg: 'bg-[#0B4F9C] text-white',
    badgeBg: 'bg-blue-100 text-[#0B4F9C] border-blue-200',
    textColor: 'text-[#0B4F9C]',
  },
  {
    label: 'Projects Pipeline',
    badge: 'Pipeline',
    count: stats.constructionCount + (stats.upcomingCount || 0),
    href: '/admin/under-construction',
    icon: 'hardhat',
    bg: 'bg-gradient-to-br from-amber-50/90 via-white to-orange-100/40',
    border: 'border-amber-200 hover:border-amber-500',
    topBar: 'bg-amber-500',
    iconBg: 'bg-amber-500 text-white',
    badgeBg: 'bg-amber-100 text-amber-900 border-amber-200',
    textColor: 'text-amber-800',
  },
  {
    label: 'Active Tenders',
    badge: 'Bids',
    count: stats.tendersCount,
    href: '/admin/tenders',
    icon: 'file-text',
    bg: 'bg-gradient-to-br from-violet-50/90 via-white to-purple-100/40',
    border: 'border-violet-200 hover:border-violet-600',
    topBar: 'bg-violet-600',
    iconBg: 'bg-violet-600 text-white',
    badgeBg: 'bg-violet-100 text-violet-900 border-violet-200',
    textColor: 'text-violet-800',
  },
  {
    label: 'AGM Documents',
    badge: 'Investors',
    count: stats.agmCount || 0,
    href: '/admin/agm',
    icon: 'scroll-text',
    bg: 'bg-gradient-to-br from-cyan-50/90 via-white to-sky-100/40',
    border: 'border-cyan-200 hover:border-cyan-600',
    topBar: 'bg-cyan-600',
    iconBg: 'bg-cyan-600 text-white',
    badgeBg: 'bg-cyan-100 text-cyan-900 border-cyan-200',
    textColor: 'text-cyan-800',
  },
  {
    label: 'Notifications',
    badge: 'Orders',
    count: stats.notificationsCount,
    href: '/admin/notifications',
    icon: 'bell',
    bg: 'bg-gradient-to-br from-emerald-50/90 via-white to-teal-100/40',
    border: 'border-emerald-200 hover:border-emerald-600',
    topBar: 'bg-emerald-600',
    iconBg: 'bg-emerald-600 text-white',
    badgeBg: 'bg-emerald-100 text-emerald-900 border-emerald-200',
    textColor: 'text-emerald-800',
  },
  {
    label: 'Public Inquiries',
    badge: 'Feedback',
    count: stats.inquiriesCount,
    href: '/admin/contacts',
    icon: 'mail',
    bg: 'bg-gradient-to-br from-indigo-50/90 via-white to-blue-100/40',
    border: 'border-indigo-200 hover:border-indigo-600',
    topBar: 'bg-indigo-600',
    iconBg: 'bg-indigo-600 text-white',
    badgeBg: 'bg-indigo-100 text-indigo-900 border-indigo-200',
    textColor: 'text-indigo-800',
  },
];

// All Modules Directory (Comprehensive, Categorized & Non-Redundant)
const moduleGroups = [
  {
    title: 'Projects & Infrastructure',
    subtitle: 'Power generation, ongoing execution & project development pipeline',
    modules: [
      {
        title: 'Operational Projects',
        desc: 'Active power stations, capacity, design energy & basins',
        count: `${stats.operationalCount} Active`,
        href: '/admin/operational-projects',
        addHref: '/admin/operational-projects-form',
        addLabel: '+ Add Station',
        icon: 'zap',
        color: 'text-[#0B4F9C]',
        iconBg: 'bg-blue-100 text-[#0B4F9C]',
      },
      {
        title: 'Under Construction',
        desc: 'Hydro projects in active civil & electrical execution',
        count: `${stats.constructionCount} Active`,
        href: '/admin/under-construction',
        icon: 'hardhat',
        color: 'text-amber-700',
        iconBg: 'bg-amber-100 text-amber-700',
      },
      {
