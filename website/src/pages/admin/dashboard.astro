---
import AdminLayout from '../../layouts/AdminLayout.astro';
import Icon from '../../components/Icon.astro';
import { isAdmin } from '../../utils/roles';
import { BACKEND_URL } from '../../utils/api-error';

function asArray<T>(value: unknown): T[] {
  if (Array.isArray(value)) return value as T[];
  if (value && typeof value === 'object') {
    const v = value as Record<string, unknown>;
    if (Array.isArray(v.data)) return v.data as T[];
    if (Array.isArray(v.value)) return v.value as T[];
  }
  return [];
}

const sessionToken = Astro.cookies.get('admin_session')?.value;
if (!sessionToken) {
  return Astro.redirect('/admin/login');
}

const user = Astro.locals.user;
const userRole = (user?.role || 'VIEWER').toUpperCase();
const userIsAdmin = isAdmin(userRole);

const formattedDate = new Date().toLocaleDateString('en-GB', {
  weekday: 'long',
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});

async function fetchJson<T>(url: string, options?: RequestInit): Promise<T | null> {
  try {
    const res = await fetch(url, options);
    if (!res.ok) return null;
    return (await res.json()) as T;
  } catch {
    return null;
  }
}

interface ActiveAdminInfo {
  name: string;
  email: string;
  lastActiveAt: string;
}

interface SystemTelemetry {
  uptimeSeconds: number;
  memoryMb: number;
  dbConnected: boolean;
  dbLatencyMs: number;
  totalUsers: number;
  mfaEnabledUsers: number;
  activeAdminsCount: number;
  activeAdmins: ActiveAdminInfo[];
  auditEvents24h: number;
  serverTime: string;
}

interface Summary {
  kpis: {
    operationalProjects: number;
    openTenders: number;
    pendingApplications: number;
    totalCapacityMw?: number;
    deltas: {
      operationalProjects: number;
      openTenders: number;
      pendingApplications: number;
    };
  };
  projectStages: { operational: number; underConstruction: number; upcoming: number };
  tenderPipeline: {
    open: number; closingSoon: number; closed: number;
    nearestClosing: { id: string; title: string; referenceNo: string; closingDate: string | null } | null;
  };
  activitySeries: { date: string; count: number }[];
  system?: SystemTelemetry;
}

let summary: Summary | null = null;
let errorMessage = '';
let initialLatencyMs = 0;

let activeTenders: { id: string; referenceNo: string; title: string; closingDate: string | null }[] = [];
let pendingApplications: { id: string; name: string; email: string; createdAt: string }[] = [];
interface AuditItem { action: string; details: string | null; createdAt: string; userName?: string | null; }
let recentActivity: AuditItem[] = [];

if (userIsAdmin) {
  const start = performance.now();
  const [summaryRes, tendersRes, submissionsRes, logsRes] = await Promise.all([
    fetchJson<Summary>(`${BACKEND_URL}/api/dashboard-summary`, { headers: { Authorization: `Bearer ${sessionToken}` } }),
    fetchJson<unknown>(`${BACKEND_URL}/api/tenders?status=Active&pageSize=25`, { headers: { Authorization: `Bearer ${sessionToken}` } }),
    fetchJson<unknown>(`${BACKEND_URL}/api/contact?pageSize=15`, { headers: { Authorization: `Bearer ${sessionToken}` } }),
    fetchJson<unknown>(`${BACKEND_URL}/api/audit-logs?pageSize=20`, { headers: { Authorization: `Bearer ${sessionToken}` } }),
  ]);
  initialLatencyMs = Math.max(1, Math.round(performance.now() - start));
  summary = summaryRes;
  if (!summary) {
    errorMessage = 'Could not load dashboard metrics. Ensure the backend REST service is online.';
  }
  activeTenders = asArray<{ id: string; referenceNo?: string; title?: string; closingDate?: string | null }>(tendersRes)
    .filter((t) => !t.closingDate || new Date(t.closingDate).getTime() > Date.now())
    .sort((a, b) => new Date(a.closingDate || '2999-12-31').getTime() - new Date(b.closingDate || '2999-12-31').getTime())
    .slice(0, 6) as typeof activeTenders;
  pendingApplications = asArray<{ id: string; name?: string; email?: string; createdAt?: string }>(submissionsRes).slice(0, 6) as typeof pendingApplications;
  recentActivity = asArray<{ action?: string; details?: string | null; createdAt?: string; user?: { name?: string } | null }>(logsRes).slice(0, 10).map((l) => ({
    action: l.action || 'EVENT',
    details: l.details || null,
    createdAt: l.createdAt || '',
    userName: l.user?.name || null,
  }));
}

function relativeTime(iso: string): string {
  if (!iso) return '';
  const then = new Date(iso).getTime();
  if (Number.isNaN(then)) return '';
  const diff = Date.now() - then;
  const mins = Math.floor(diff / 60000);
  if (mins < 1) return 'just now';
  if (mins < 60) return `${mins}m ago`;
  const hours = Math.floor(mins / 60);
  if (hours < 24) return `${hours}h ago`;
  const days = Math.floor(hours / 24);
  if (days < 30) return `${days}d ago`;
  return new Date(iso).toLocaleDateString('en-GB', { day: 'numeric', month: 'short' });
}

function prettyAction(action: string): string {
  return action.replace(/_/g, ' ').toLowerCase().replace(/\b\w/g, (c) => c.toUpperCase());
}

function detailLabel(details: string | null, userName?: string | null): string {
  const parts: string[] = [];
  if (userName) parts.push(userName);
  if (details) {
    try {
      const d = JSON.parse(details);
      if (d.attempt !== undefined) parts.push(`Attempt #${d.attempt}`);
      else if (d.mfaRequired === true) parts.push('MFA challenge issued');
      else if (d.title || d.name || d.referenceNo || d.email) {
        parts.push(d.title || d.name || d.referenceNo || d.email);
      }
    } catch {
      parts.push(details);
    }
  }
  return parts.join(' · ');
}

function daysUntil(iso: string | null): number | null {
  if (!iso) return null;
  const t = new Date(iso).getTime();
  if (Number.isNaN(t)) return null;
  return Math.ceil((t - Date.now()) / 86400000);
}

function fmtDate(iso: string | null): string {
  if (!iso) return '—';
  const d = new Date(iso);
  if (Number.isNaN(d.getTime())) return '—';
  return d.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
}

function formatUptime(sec: number): string {
  if (!sec || sec < 0) return '—';
  const h = Math.floor(sec / 3600);
  const m = Math.floor((sec % 3600) / 60);
  if (h > 0) return `${h}h ${m}m`;
  return `${m}m ${sec % 60}s`;
}

function urgencyBadge(iso: string | null): { cls: string; label: string } {
  const d = daysUntil(iso);
  if (d === null || d < 0) return { cls: '', label: '' };
  if (d <= 3) return { cls: 'dash-urgency-red', label: `in ${d}d` };
  if (d <= 7) return { cls: 'dash-urgency-amber', label: `in ${d}d` };
  return { cls: '', label: '' };
}

const adminUserName = user?.name || userRole;
const series = summary?.activitySeries || [];
const seriesMax = Math.max(...series.map((s) => s.count), 1);
const seriesTotal = series.reduce((acc, s) => acc + s.count, 0);
const sys = summary?.system;
---

<AdminLayout title="Live Dashboard Monitor" description="JKSPDCL Real-Time Administrative Control Panel & Telemetry Monitor" activeTab="dashboard">
  <div class="flex flex-col gap-4 max-w-7xl">

    <!-- Row 1: Slim 44px Telemetry & Command Strip -->
    <div class="bg-white border border-[#D8E0E8] rounded-md px-3.5 py-2 flex flex-wrap items-center justify-between gap-2 min-h-[44px]">
      <div class="flex items-center gap-2.5 flex-wrap text-xs">
        <span id="live-status-pill" class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded text-[11px] font-bold uppercase tracking-wider bg-[#ECFDF5] text-[#047857] border border-emerald-200">
          <span id="live-status-dot" class="w-1.5 h-1.5 rounded-full bg-emerald-600 animate-pulse"></span>
          <span id="live-status-text">LIVE · 10s</span>
        </span>
        <span class="font-bold text-[#0B2545]">{adminUserName}</span>
        <span class="text-slate-300 hidden sm:inline">|</span>
        <span class="text-[11px] text-slate-500 hidden sm:inline">{formattedDate}</span>
      </div>

      <!-- Live Telemetry & Controls -->
      <div class="flex flex-wrap items-center gap-2">
        <a
          href="/admin/users"
          id="mon-active-admins-pill"
          class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded bg-[#ECFDF5] border border-emerald-200 text-[11px] font-bold text-[#047857] tabular-nums hover:bg-emerald-100 transition-colors"
          title={sys?.activeAdmins?.length ? `Active: ${sys.activeAdmins.map((a) => a.name).join(', ')}` : 'Active administrator sessions'}
        >
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-600 animate-pulse"></span>
          <span id="mon-active-admins">{sys?.activeAdminsCount ?? 1} {(sys?.activeAdminsCount ?? 1) === 1 ? 'Admin' : 'Admins'} Live</span>
        </a>

        <div class="inline-flex flex-wrap items-center gap-x-2.5 gap-y-1 px-2.5 py-1 rounded bg-[#F4F6F9] border border-[#D8E0E8] text-[11px] font-semibold text-slate-600 tabular-nums">
          <span>Synced: <strong id="mon-synced-at" class="text-[#0B2545]">just now</strong></span>
          <span class="text-slate-300">|</span>
          <span>API: <strong id="mon-api-lat" class="text-[#047857]">{initialLatencyMs} ms</strong></span>
          <span class="text-slate-300">|</span>
          <span>DB: <strong id="mon-db-lat" class="text-[#047857]">{sys?.dbLatencyMs ?? '—'} ms</strong></span>
        </div>

        <button
          id="mon-toggle-live"
          type="button"
          class="inline-flex items-center gap-1 px-2.5 py-1 rounded border border-[#D8E0E8] bg-white hover:bg-[#F4F6F9] text-[11px] font-bold text-slate-700 cursor-pointer transition-colors"
          aria-pressed="true"
        >
          <span id="mon-toggle-label">Pause</span>
        </button>

        <button
          id="mon-refresh-now"
          type="button"
          class="inline-flex items-center gap-1 px-2.5 py-1 rounded bg-[#0B2545] hover:bg-[#071A33] text-white text-[11px] font-bold cursor-pointer transition-colors"
        >
          <Icon name="refresh-cw" size={12} id="mon-refresh-icon" />
          <span>Refresh</span>
        </button>
      </div>
    </div>

    {errorMessage && (
      <div class="p-3 bg-[#FEF2F2] border border-red-200 rounded-md text-xs text-[#B91C1C] font-semibold flex items-center gap-2" role="alert">
        <Icon name="info" size={15} class="text-[#B91C1C] shrink-0" />
        <span>{errorMessage}</span>
      </div>
    )}

    {userIsAdmin && summary && (
    <div class="flex flex-col gap-4">

      <!-- ══ 1. INTERACTIVE KPI STRIP (4 Institutional Telemetry Tiles) ══ -->
      <section class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-3.5" aria-label="Interactive key metrics">
        <!-- Operational Projects -->
        <a href="/admin/operational-projects" class="group bg-white border border-[#D8E0E8] hover:border-[#0B2545]/50 rounded-md p-4 transition-colors flex flex-col justify-between gap-2.5">
          <div class="flex items-start justify-between gap-2">
            <div>
              <span class="text-[11px] font-bold uppercase tracking-wider text-slate-500">Operational Assets</span>
              <div class="flex items-baseline gap-2 mt-1">
                <span id="kpi-op-projects" class="text-2xl font-extrabold text-[#0B2545] tabular-nums">{summary.kpis.operationalProjects}</span>
                <span id="kpi-cap-mw" class="text-[11px] font-bold text-[#047857] bg-[#ECFDF5] border border-emerald-200 px-2 py-0.5 rounded tabular-nums">
                  {summary.kpis.totalCapacityMw ?? 0} MW
                </span>
              </div>
            </div>
            <span class="w-8 h-8 rounded bg-[#F4F6F9] border border-[#D8E0E8] text-[#0B2545] group-hover:bg-[#0B2545] group-hover:text-white flex items-center justify-center transition-colors shrink-0">
              <Icon name="zap" size={16} />
            </span>
          </div>
          <div class="flex items-center justify-between text-[11px] font-semibold text-slate-500 pt-2 border-t border-slate-100">
            <span id="kpi-op-delta">+{summary.kpis.deltas?.operationalProjects ?? 0} this week</span>
            <span class="text-[#0B2545] group-hover:translate-x-0.5 transition-transform">Manage &rarr;</span>
          </div>
        </a>

        <!-- Open Tenders -->
        <a href="/admin/tenders" class="group bg-white border border-[#D8E0E8] hover:border-[#0B2545]/50 rounded-md p-4 transition-colors flex flex-col justify-between gap-2.5">
          <div class="flex items-start justify-between gap-2">
            <div>
              <span class="text-[11px] font-bold uppercase tracking-wider text-slate-500">Active Tenders</span>
              <div class="flex items-baseline gap-2 mt-1">
                <span id="kpi-open-tenders" class="text-2xl font-extrabold text-[#0B2545] tabular-nums">{summary.tenderPipeline.open}</span>
                <span id="kpi-closing-soon" class="text-[11px] font-bold text-[#B45309] bg-[#FFFBEB] border border-amber-200 px-2 py-0.5 rounded tabular-nums">
                  {summary.tenderPipeline.closingSoon} closing ≤7d
                </span>
              </div>
            </div>
            <span class="w-8 h-8 rounded bg-[#F4F6F9] border border-[#D8E0E8] text-[#0B2545] group-hover:bg-[#0B2545] group-hover:text-white flex items-center justify-center transition-colors shrink-0">
              <Icon name="file-text" size={16} />
            </span>
          </div>
          <div class="flex items-center justify-between text-[11px] font-semibold text-slate-500 pt-2 border-t border-slate-100">
            <span id="kpi-tender-nearest" class="truncate max-w-[170px] text-[#B91C1C]">
              {summary.tenderPipeline.nearestClosing ? `Closes ${fmtDate(summary.tenderPipeline.nearestClosing.closingDate)}` : 'No urgent deadlines'}
            </span>
            <span class="text-[#0B2545] group-hover:translate-x-0.5 transition-transform shrink-0">Registry &rarr;</span>
          </div>
        </a>

        <!-- Pending Inquiries -->
        <a href="/admin/contacts" class="group bg-white border border-[#D8E0E8] hover:border-[#0B2545]/50 rounded-md p-4 transition-colors flex flex-col justify-between gap-2.5">
          <div class="flex items-start justify-between gap-2">
            <div>
              <span class="text-[11px] font-bold uppercase tracking-wider text-slate-500">Inquiries (7d)</span>
              <div class="flex items-baseline gap-2 mt-1">
                <span id="kpi-pending-apps" class="text-2xl font-extrabold text-[#0B2545] tabular-nums">{summary.kpis.pendingApplications}</span>
                <span class="text-xs font-semibold text-slate-500">submissions</span>
              </div>
            </div>
            <span class="w-8 h-8 rounded bg-[#F4F6F9] border border-[#D8E0E8] text-[#0B2545] group-hover:bg-[#0B2545] group-hover:text-white flex items-center justify-center transition-colors shrink-0">
              <Icon name="mail" size={16} />
            </span>
          </div>
          <div class="flex items-center justify-between text-[11px] font-semibold text-slate-500 pt-2 border-t border-slate-100">
            <span id="kpi-apps-delta">Prev week: {summary.kpis.deltas?.pendingApplications ?? 0}</span>
            <span class="text-[#0B2545] group-hover:translate-x-0.5 transition-transform">Open Inbox &rarr;</span>
          </div>
        </a>

        <!-- Security & MFA Posture -->
        <a href="/admin/users" class="group bg-white border border-[#D8E0E8] hover:border-[#0B2545]/50 rounded-md p-4 transition-colors flex flex-col justify-between gap-2.5">
          <div class="flex items-start justify-between gap-2">
            <div>
              <span class="text-[11px] font-bold uppercase tracking-wider text-slate-500">MFA Security Posture</span>
              <div class="flex items-baseline gap-2 mt-1">
                <span id="kpi-mfa-coverage" class="text-2xl font-extrabold text-[#0B2545] tabular-nums">
                  {sys ? `${sys.mfaEnabledUsers}/${sys.totalUsers}` : '—'}
                </span>
                <span class="text-[11px] font-bold text-[#1D4ED8] bg-blue-50 border border-blue-200 px-2 py-0.5 rounded">
                  Enrolled
                </span>
              </div>
            </div>
            <span class="w-8 h-8 rounded bg-[#F4F6F9] border border-[#D8E0E8] text-[#0B2545] group-hover:bg-[#0B2545] group-hover:text-white flex items-center justify-center transition-colors shrink-0">
              <Icon name="shield-check" size={16} />
            </span>
          </div>
          <div class="flex items-center justify-between text-[11px] font-semibold text-slate-500 pt-2 border-t border-slate-100">
            <span id="kpi-audit-24h">{sys?.auditEvents24h ?? 0} audit events (24h)</span>
            <span class="text-[#0B2545] group-hover:translate-x-0.5 transition-transform">Accounts &rarr;</span>
          </div>
        </a>
      </section>

      <!-- ══ 2. INTERACTIVE TELEMETRY CHARTS & PORTFOLIO HEALTH ══ -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-4 items-stretch">
        <!-- Left 7 cols: Interactive 14-Day Activity SVG Chart -->
        <section class="lg:col-span-7 bg-white border border-[#D8E0E8] rounded-md p-4 sm:p-5 flex flex-col justify-between" aria-label="14-day administrative activity monitor">
          <div class="flex flex-wrap items-center justify-between gap-2 mb-3">
            <div>
              <h2 class="text-xs font-bold uppercase tracking-wider text-[#0B2545]">14-Day Administrative Activity</h2>
              <p class="text-[11px] text-slate-500 mt-0.5">Hover any point or bar to inspect daily audit volume</p>
            </div>
            <span id="chart-readout" class="inline-flex items-center px-2.5 py-1 rounded bg-[#F4F6F9] border border-[#D8E0E8] text-xs font-bold text-[#0B2545] tabular-nums">
              14d Total: {seriesTotal} events
            </span>
          </div>

          {(() => {
            const w = 560;
            const h = 150;
            const padL = 28;
            const padR = 10;
            const padT = 12;
            const padB = 22;
            const plotW = w - padL - padR;
            const plotH = h - padT - padB;
            const yMax = Math.max(seriesMax, 4);
            const midVal = Math.round(yMax / 2);
            const pts = series.map((pt, i) => {
              const x = padL + (series.length > 1 ? (i / (series.length - 1)) * plotW : plotW / 2);
              const y = padT + plotH - (pt.count / yMax) * plotH;
              const shortDate = new Date(pt.date).toLocaleDateString('en-GB', { day: 'numeric', month: 'short' });
              return { x, y, count: pt.count, shortDate };
            });
            const linePath = pts.map((p, i) => `${i === 0 ? 'M' : 'L'}${p.x.toFixed(1)},${p.y.toFixed(1)}`).join(' ');
            const areaPath = pts.length
              ? `${linePath} L${pts[pts.length - 1].x.toFixed(1)},${(padT + plotH).toFixed(1)} L${pts[0].x.toFixed(1)},${(padT + plotH).toFixed(1)} Z`
              : '';
            return (
              <div id="activity-svg-wrap" class="relative w-full">
                <svg id="activity-svg-chart" viewBox={`0 0 ${w} ${h}`} class="w-full h-40 overflow-visible" role="img" aria-label="14-day administrative activity chart">
                  <defs>
                    <linearGradient id="dashAreaGrad" x1="0" y1="0" x2="0" y2="1">
                      <stop offset="0%" stop-color="#0B2545" stop-opacity="0.22" />
                      <stop offset="100%" stop-color="#0B2545" stop-opacity="0.01" />
                    </linearGradient>
                  </defs>
                  <!-- Horizontal Gridlines & Y-Axis Ticks -->
                  <line x1={padL} y1={padT} x2={w - padR} y2={padT} stroke="#E2E8F0" stroke-dasharray="3 3" />
                  <text x={padL - 6} y={padT + 3} text-anchor="end" class="fill-slate-400 text-[9px] font-mono">{yMax}</text>
                  <line x1={padL} y1={padT + plotH / 2} x2={w - padR} y2={padT + plotH / 2} stroke="#E2E8F0" stroke-dasharray="3 3" />
                  <text x={padL - 6} y={padT + plotH / 2 + 3} text-anchor="end" class="fill-slate-400 text-[9px] font-mono">{midVal}</text>
                  <line x1={padL} y1={padT + plotH} x2={w - padR} y2={padT + plotH} stroke="#CBD5E1" />
                  <text x={padL - 6} y={padT + plotH + 3} text-anchor="end" class="fill-slate-400 text-[9px] font-mono">0</text>

                  {/* Area + Line */}
                  {areaPath && <path d={areaPath} fill="url(#dashAreaGrad)" />}
                  {linePath && <path d={linePath} fill="none" stroke="#0B2545" stroke-width="2" stroke-linejoin="round" stroke-linecap="round" />}

                  {/* Interactive Data Points */}
                  {pts.map((p, idx) => (
                    <g class="chart-pt-group cursor-pointer" data-date={p.shortDate} data-count={String(p.count)} tabindex="0" aria-label={`${p.shortDate}: ${p.count} events`}>
                      <rect x={p.x - 14} y={padT} width="28" height={plotH} fill="transparent" />
                      <circle cx={p.x} cy={p.y} r="3.5" class="fill-white stroke-[#0B2545] transition-all" stroke-width="2" />
                      {(idx === 0 || idx === Math.floor(pts.length / 2) || idx === pts.length - 1) && (
                        <text x={p.x} y={h - 4} text-anchor={idx === 0 ? 'start' : idx === pts.length - 1 ? 'end' : 'middle'} class="fill-slate-400 text-[9.5px] font-semibold">
                          {idx === pts.length - 1 ? 'Today' : p.shortDate}
                        </text>
                      )}
                    </g>
                  ))}
                </svg>
              </div>
            );
          })()}
        </section>

        <!-- Right 5 cols: Generation Portfolio & System Health -->
        <section class="lg:col-span-5 bg-white border border-[#D8E0E8] rounded-md p-4 sm:p-5 flex flex-col justify-between gap-4" aria-label="System health and portfolio pipelines">
          <div>
            <div class="flex items-center justify-between gap-2 mb-3">
              <h2 class="text-xs font-bold uppercase tracking-wider text-[#0B2545]">System &amp; Infrastructure Health</h2>
              <a href="/admin/audit-logs" class="text-[11px] font-bold text-[#1D4ED8] hover:underline">Audit Feed &rarr;</a>
            </div>
            <div class="grid grid-cols-1 min-[380px]:grid-cols-2 gap-2 text-xs">
              <div class="p-2.5 rounded bg-[#F4F6F9] border border-[#D8E0E8] flex items-center justify-between">
                <span class="text-slate-600 font-medium">API Status</span>
                <span id="sys-api-status" class="font-bold text-[#047857] inline-flex items-center gap-1"><span class="w-1.5 h-1.5 rounded-full bg-emerald-600"></span> Online</span>
              </div>
              <div class="p-2.5 rounded bg-[#F4F6F9] border border-[#D8E0E8] flex items-center justify-between">
                <span class="text-slate-600 font-medium">PostgreSQL</span>
                <span id="sys-db-status" class="font-bold text-[#047857] tabular-nums">{sys?.dbLatencyMs ?? '—'} ms</span>
              </div>
              <div class="p-2.5 rounded bg-[#F4F6F9] border border-[#D8E0E8] flex items-center justify-between">
                <span class="text-slate-600 font-medium">Uptime</span>
                <span id="sys-uptime" class="font-bold text-[#0B2545] tabular-nums">{sys ? formatUptime(sys.uptimeSeconds) : '—'}</span>
              </div>
              <div class="p-2.5 rounded bg-[#F4F6F9] border border-[#D8E0E8] flex items-center justify-between">
                <span class="text-slate-600 font-medium">Memory RSS</span>
                <span id="sys-memory" class="font-bold text-[#0B2545] tabular-nums">{sys ? `${sys.memoryMb} MB` : '—'}</span>
              </div>
            </div>
          </div>

          <!-- Project Stage Breakdown -->
          <div class="pt-3 border-t border-slate-100">
            <div class="flex items-center justify-between text-[11px] font-bold uppercase tracking-wider text-[#0B2545] mb-2">
              <span>Generation Portfolio Stages</span>
              <span class="text-[11px] font-bold text-[#047857] tabular-nums">{summary.kpis.totalCapacityMw ?? 0} MW Active</span>
            </div>
            {(() => {
              const st = summary.projectStages;
              const total = st.operational + st.underConstruction + st.upcoming;
              const seg = (v: number) => (total > 0 ? `${(v / total) * 100}%` : '0%');
              return (
                <div>
                  <div class="dash-segbar" role="img" aria-label={`${st.operational} operational, ${st.underConstruction} under construction, ${st.upcoming} upcoming`}>
                    <span id="seg-op" class="dash-seg dash-seg-op" style={`width:${seg(st.operational)}`}></span>
                    <span id="seg-uc" class="dash-seg dash-seg-uc" style={`width:${seg(st.underConstruction)}`}></span>
                    <span id="seg-up" class="dash-seg dash-seg-up" style={`width:${seg(st.upcoming)}`}></span>
                  </div>
                  <div class="flex flex-wrap gap-x-4 gap-y-1 mt-2 text-[11px] font-semibold">
                    <a id="leg-op" class="dash-legend dash-legend-op" href="/admin/operational-projects">Operational · {st.operational}</a>
                    <a id="leg-uc" class="dash-legend dash-legend-uc" href="/admin/under-construction">Under Construction · {st.underConstruction}</a>
                    <a id="leg-up" class="dash-legend dash-legend-up" href="/admin/upcoming-projects">Upcoming · {st.upcoming}</a>
                  </div>
                </div>
              );
            })()}
          </div>
        </section>
      </div>

      <!-- ══ 3. BALANCED ACTION QUEUE & LIVE AUDIT TIMELINE ══ -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-4 items-stretch">
        <!-- Left 6 cols: Tabbed Procurement & Citizen Inquiries Queue -->
        <section class="lg:col-span-6 dash-panel overflow-hidden flex flex-col" aria-label="Procurement and inquiries queue">
          <div class="dash-panel-header bg-[#F4F6F9] flex-wrap">
            <div class="flex items-center gap-1.5" role="tablist" aria-label="Dashboard queues">
              <button
                type="button"
                id="tab-btn-tenders"
                role="tab"
                aria-selected="true"
                class="dash-queue-tab px-2.5 py-1 rounded text-xs font-bold bg-[#0B2545] text-white cursor-pointer transition-colors"
                data-tab="tenders"
              >
                Closing Soon <span id="tenders-count-badge" class="ml-1 px-1.5 py-0.2 rounded bg-white/20 text-[10px] tabular-nums">{activeTenders.length} of {summary.tenderPipeline.open}</span>
              </button>
              <button
                type="button"
                id="tab-btn-inquiries"
                role="tab"
                aria-selected="false"
                class="dash-queue-tab px-2.5 py-1 rounded text-xs font-bold bg-white text-slate-600 border border-[#D8E0E8] hover:bg-slate-50 cursor-pointer transition-colors"
                data-tab="inquiries"
              >
                Public Inquiries <span id="inquiries-count-badge" class="ml-1 px-1.5 py-0.2 rounded bg-slate-100 text-slate-700 text-[10px] tabular-nums">{pendingApplications.length}</span>
              </button>
            </div>
            <div class="flex items-center gap-2">
              <a href="/admin/tenders?action=new" class="text-[11px] font-bold px-2 py-1 rounded bg-[#0B2545] text-white hover:bg-[#071A33] transition-colors">+ New</a>
              <a id="queue-view-all" href="/admin/tenders" class="dash-panel-link">View all <Icon name="arrow-right" size={11} strokeWidth={2.5} /></a>
            </div>
          </div>

          <!-- Tab 1: Closing Soon Tenders -->
          <div id="live-tenders-body" class="overflow-x-auto flex-1">
            {activeTenders.length === 0 ? (
              <div class="admin-empty-state py-10">
                <p class="text-xs text-[color:var(--adm-muted)] font-medium">No active tenders with open deadlines.</p>
              </div>
            ) : (
              <table class="dash-minitable w-full">
                <thead>
                  <tr><th scope="col">Tender</th><th scope="col" class="w-32 whitespace-nowrap">Closes</th><th scope="col" class="w-14 text-right whitespace-nowrap">Action</th></tr>
                </thead>
                <tbody>
                  {activeTenders.map((t) => {
                    const badge = urgencyBadge(t.closingDate);
                    return (
                      <tr>
                        <td class="max-w-0 w-full">
                          <span class="block text-xs font-bold text-slate-800 truncate">{t.title}</span>
                          <span class="block text-[11px] text-[color:var(--adm-muted)] font-mono truncate">{t.referenceNo}</span>
                        </td>
                        <td class="whitespace-nowrap tabular-nums">
                          <span class="text-xs font-semibold text-slate-700">{fmtDate(t.closingDate)}</span>
                          {badge.cls && <span class={`dash-urgency ${badge.cls}`}>{badge.label}</span>}
                        </td>
                        <td class="text-right whitespace-nowrap">
                          <a href={`/admin/tenders?edit=${t.id}`} class="dash-panel-link">Edit</a>
                        </td>
                      </tr>
                    );
                  })}
                </tbody>
              </table>
            )}
          </div>

          <!-- Tab 2: Public Inquiries (hidden by default) -->
          <div id="live-inquiries-body" class="overflow-x-auto flex-1 hidden">
            {pendingApplications.length === 0 ? (
              <div class="admin-empty-state py-10">
                <p class="text-xs text-[color:var(--adm-muted)] font-medium">Inbox is clear — no pending public inquiries.</p>
              </div>
            ) : (
              <table class="dash-minitable w-full">
                <thead>
                  <tr><th scope="col">From</th><th scope="col" class="w-24 whitespace-nowrap">Received</th><th scope="col" class="w-16 text-right whitespace-nowrap">Action</th></tr>
                </thead>
                <tbody>
                  {pendingApplications.map((a) => (
                    <tr>
                      <td class="max-w-0 w-full">
                        <span class="block text-xs font-bold text-slate-800 truncate">{a.name}</span>
                        <span class="block text-[11px] text-[color:var(--adm-muted)] font-medium truncate">{a.email}</span>
                      </td>
                      <td class="whitespace-nowrap"><span class="text-xs font-semibold text-slate-700">{relativeTime(a.createdAt)}</span></td>
                      <td class="text-right whitespace-nowrap"><a href="/admin/contacts" class="dash-panel-link">Open</a></td>
                    </tr>
                  ))}
                </tbody>
              </table>
            )}
          </div>
        </section>

        <!-- Right 6 cols: Live Security & Activity Feed -->
        <section class="lg:col-span-6 dash-panel overflow-hidden flex flex-col" aria-label="Live administrative activity">
          <div class="dash-panel-header bg-[#F4F6F9]">
            <h2 class="dash-panel-title"><Icon name="zap" size={14} /> Live Activity Feed</h2>
            <a href="/admin/audit-logs" class="dash-panel-link">Full log <Icon name="arrow-right" size={11} strokeWidth={2.5} /></a>
          </div>
          <div id="live-activity-body" class="flex-1">
            {recentActivity.length === 0 ? (
              <div class="admin-empty-state py-10">
                <p class="text-xs text-[color:var(--adm-muted)] font-medium">No activity recorded yet.</p>
              </div>
            ) : (
              <ol class="dash-timeline" aria-label="Recent administrative actions">
                {recentActivity.slice(0, 6).map((item) => {
                  const sub = detailLabel(item.details, item.userName);
                  return (
                  <li class="dash-timeline-item">
                    <span class="dash-timeline-dot" aria-hidden="true"></span>
                    <div class="min-w-0">
                      <p class="text-xs font-bold text-slate-800">{prettyAction(item.action)}</p>
                      {sub && (
                        <p class="text-[11px] text-[color:var(--adm-muted)] font-medium truncate">{sub}</p>
                      )}
                    </div>
                    <span class="dash-timeline-time tabular-nums">{relativeTime(item.createdAt)}</span>
                  </li>
                  );
                })}
              </ol>
            )}
          </div>
        </section>
      </div>

    </div>
    )}

  </div>
</AdminLayout>

<script is:inline>
(function () {
  var isLive = true;
  var timer = null;
  var POLL_MS = 10000;

  var toggleBtn = document.getElementById('mon-toggle-live');
  var toggleLabel = document.getElementById('mon-toggle-label');
  var refreshBtn = document.getElementById('mon-refresh-now');
  var refreshIcon = document.getElementById('mon-refresh-icon');
  var statusPill = document.getElementById('live-status-pill');
  var statusDot = document.getElementById('live-status-dot');
  var statusText = document.getElementById('live-status-text');
  var readout = document.getElementById('chart-readout');

  function escapeHtml(s) {
    return String(s || '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
  }

  function relTime(iso) {
    if (!iso) return '';
    var then = new Date(iso).getTime();
    if (isNaN(then)) return '';
    var mins = Math.floor((Date.now() - then) / 60000);
    if (mins < 1) return 'just now';
    if (mins < 60) return mins + 'm ago';
    var hrs = Math.floor(mins / 60);
    if (hrs < 24) return hrs + 'h ago';
    return Math.floor(hrs / 24) + 'd ago';
  }

  function fmtDate(iso) {
    if (!iso) return '—';
    var d = new Date(iso);
    if (isNaN(d.getTime())) return '—';
    return d.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
  }

  function fmtUptime(sec) {
    if (!sec || sec < 0) return '—';
    var h = Math.floor(sec / 3600);
    var m = Math.floor((sec % 3600) / 60);
    return h > 0 ? h + 'h ' + m + 'm' : m + 'm ' + (sec % 60) + 's';
  }

  function prettyAction(a) {
    return String(a || 'EVENT').replace(/_/g, ' ').toLowerCase().replace(/\b\w/g, function (c) { return c.toUpperCase(); });
  }

  function detailLabel(details, userName) {
    var parts = [];
    if (userName) parts.push(userName);
    if (details) {
      try {
        var d = JSON.parse(details);
        if (d.attempt !== undefined) parts.push('Attempt #' + d.attempt);
        else if (d.mfaRequired === true) parts.push('MFA challenge issued');
        else if (d.title || d.name || d.referenceNo || d.email) {
          parts.push(d.title || d.name || d.referenceNo || d.email);
        }
      } catch (e) {
        parts.push(String(details));
      }
    }
    return parts.join(' · ');
  }

  function bindChartHover(total) {
    var pts = document.querySelectorAll('#activity-svg-chart .chart-pt-group');
    pts.forEach(function (pt) {
      pt.onmouseenter = pt.onfocus = function () {
        var c = pt.querySelector('circle');
        if (c) c.setAttribute('r', '5');
        if (readout) readout.textContent = pt.getAttribute('data-date') + ': ' + pt.getAttribute('data-count') + ' events';
      };
      pt.onmouseleave = pt.onblur = function () {
        var c = pt.querySelector('circle');
        if (c) c.setAttribute('r', '3.5');
        if (readout) readout.textContent = '14d Total: ' + total + ' events';
      };
    });
  }
  bindChartHover(Number((readout && readout.textContent.match(/\d+/g) || [0, 0])[1] || 0));

  // Queue tabs (Closing Soon Tenders <-> Public Inquiries)
  var queueTabs = document.querySelectorAll('.dash-queue-tab');
  var tendersBody = document.getElementById('live-tenders-body');
  var inquiriesBody = document.getElementById('live-inquiries-body');
  var queueViewAll = document.getElementById('queue-view-all');
  queueTabs.forEach(function (tab) {
    tab.addEventListener('click', function () {
      var target = tab.getAttribute('data-tab');
      queueTabs.forEach(function (t) {
        var active = t === tab;
        t.setAttribute('aria-selected', active ? 'true' : 'false');
        t.className = active
          ? 'dash-queue-tab px-2.5 py-1 rounded text-xs font-bold bg-[#0B2545] text-white cursor-pointer transition-colors'
          : 'dash-queue-tab px-2.5 py-1 rounded text-xs font-bold bg-white text-slate-600 border border-[#D8E0E8] hover:bg-slate-50 cursor-pointer transition-colors';
      });
      if (tendersBody && inquiriesBody) {
        if (target === 'inquiries') {
          tendersBody.classList.add('hidden');
          inquiriesBody.classList.remove('hidden');
          if (queueViewAll) queueViewAll.setAttribute('href', '/admin/contacts');
        } else {
          inquiriesBody.classList.add('hidden');
          tendersBody.classList.remove('hidden');
          if (queueViewAll) queueViewAll.setAttribute('href', '/admin/tenders');
        }
      }
    });
  });

  async function pollMonitor() {
    if (refreshIcon) refreshIcon.classList.add('animate-spin');
    try {
      var res = await fetch('/api/admin/live-monitor', { cache: 'no-store' });
      if (!res.ok) return;
      var data = await res.json();
      if (!data || !data.summary) return;

      var s = data.summary;
      var sys = s.system || {};

      var setText = function (id, val) {
        var el = document.getElementById(id);
        if (el) el.textContent = val;
      };

      setText('mon-synced-at', new Date().toLocaleTimeString('en-GB', { hour12: false }));
      setText('mon-api-lat', data.apiLatencyMs + ' ms');
      setText('mon-db-lat', (sys.dbLatencyMs || '—') + ' ms');
      var liveCount = typeof sys.activeAdminsCount === 'number' ? sys.activeAdminsCount : 1;
      setText('mon-active-admins', liveCount + (liveCount === 1 ? ' Admin Live' : ' Admins Live'));
      var livePill = document.getElementById('mon-active-admins-pill');
      if (livePill && Array.isArray(sys.activeAdmins) && sys.activeAdmins.length > 0) {
        livePill.title = 'Active: ' + sys.activeAdmins.map(function (a) { return a.name; }).join(', ');
      }

      setText('kpi-op-projects', String(s.kpis.operationalProjects));
      setText('kpi-cap-mw', (s.kpis.totalCapacityMw || 0) + ' MW');
      setText('kpi-op-delta', '+' + (s.kpis.deltas ? s.kpis.deltas.operationalProjects : 0) + ' this week');
      setText('kpi-open-tenders', String(s.tenderPipeline.open));
      setText('kpi-closing-soon', s.tenderPipeline.closingSoon + ' closing ≤7d');
      setText('kpi-tender-nearest', s.tenderPipeline.nearestClosing ? 'Closes ' + fmtDate(s.tenderPipeline.nearestClosing.closingDate) : 'No urgent deadlines');
      setText('kpi-pending-apps', String(s.kpis.pendingApplications));
      setText('kpi-apps-delta', 'Prev week: ' + (s.kpis.deltas ? s.kpis.deltas.pendingApplications : 0));
      setText('kpi-mfa-coverage', (sys.mfaEnabledUsers || 0) + '/' + (sys.totalUsers || 0));
      setText('kpi-audit-24h', (sys.auditEvents24h || 0) + ' audit events (24h)');

      setText('sys-db-status', (sys.dbLatencyMs || '—') + ' ms');
      setText('sys-uptime', fmtUptime(sys.uptimeSeconds));
      setText('sys-memory', (sys.memoryMb || 0) + ' MB');

      var st = s.projectStages;
      var totalProj = st.operational + st.underConstruction + st.upcoming;
      if (totalProj > 0) {
        var segOp = document.getElementById('seg-op');
        var segUc = document.getElementById('seg-uc');
        var segUp = document.getElementById('seg-up');
        if (segOp) segOp.style.width = ((st.operational / totalProj) * 100) + '%';
        if (segUc) segUc.style.width = ((st.underConstruction / totalProj) * 100) + '%';
        if (segUp) segUp.style.width = ((st.upcoming / totalProj) * 100) + '%';
      }
      setText('leg-op', 'Operational · ' + st.operational);
      setText('leg-uc', 'Under Construction · ' + st.underConstruction);
      setText('leg-up', 'Upcoming · ' + st.upcoming);

      // Update 14-day SVG chart
      var svgChart = document.getElementById('activity-svg-chart');
      if (svgChart && Array.isArray(s.activitySeries) && s.activitySeries.length > 0) {
        var max = Math.max.apply(null, s.activitySeries.map(function (x) { return x.count; }).concat([4]));
        var mid = Math.round(max / 2);
        var totalEv = s.activitySeries.reduce(function (a, b) { return a + b.count; }, 0);
        var w = 560, h = 150, padL = 28, padR = 10, padT = 12, padB = 22;
        var plotW = w - padL - padR, plotH = h - padT - padB;
        var len = s.activitySeries.length;
        var pts = s.activitySeries.map(function (pt, i) {
          var x = padL + (len > 1 ? (i / (len - 1)) * plotW : plotW / 2);
          var y = padT + plotH - (pt.count / max) * plotH;
          var sd = new Date(pt.date).toLocaleDateString('en-GB', { day: 'numeric', month: 'short' });
          return { x: x, y: y, count: pt.count, sd: sd };
        });
        var lp = pts.map(function (p, i) { return (i === 0 ? 'M' : 'L') + p.x.toFixed(1) + ',' + p.y.toFixed(1); }).join(' ');
        var ap = lp + ' L' + pts[pts.length - 1].x.toFixed(1) + ',' + (padT + plotH).toFixed(1) + ' L' + pts[0].x.toFixed(1) + ',' + (padT + plotH).toFixed(1) + ' Z';
        svgChart.innerHTML =
          '<defs><linearGradient id="dashAreaGrad" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="#0B2545" stop-opacity="0.22"/><stop offset="100%" stop-color="#0B2545" stop-opacity="0.01"/></linearGradient></defs>' +
          '<line x1="' + padL + '" y1="' + padT + '" x2="' + (w - padR) + '" y2="' + padT + '" stroke="#E2E8F0" stroke-dasharray="3 3"/>' +
          '<text x="' + (padL - 6) + '" y="' + (padT + 3) + '" text-anchor="end" class="fill-slate-400 text-[9px] font-mono">' + max + '</text>' +
          '<line x1="' + padL + '" y1="' + (padT + plotH / 2) + '" x2="' + (w - padR) + '" y2="' + (padT + plotH / 2) + '" stroke="#E2E8F0" stroke-dasharray="3 3"/>' +
          '<text x="' + (padL - 6) + '" y="' + (padT + plotH / 2 + 3) + '" text-anchor="end" class="fill-slate-400 text-[9px] font-mono">' + mid + '</text>' +
          '<line x1="' + padL + '" y1="' + (padT + plotH) + '" x2="' + (w - padR) + '" y2="' + (padT + plotH) + '" stroke="#CBD5E1"/>' +
          '<text x="' + (padL - 6) + '" y="' + (padT + plotH + 3) + '" text-anchor="end" class="fill-slate-400 text-[9px] font-mono">0</text>' +
          '<path d="' + ap + '" fill="url(#dashAreaGrad)"/>' +
          '<path d="' + lp + '" fill="none" stroke="#0B2545" stroke-width="2" stroke-linejoin="round" stroke-linecap="round"/>' +
          pts.map(function (p, idx) {
            var lbl = '';
            if (idx === 0 || idx === Math.floor(pts.length / 2) || idx === pts.length - 1) {
              var anc = idx === 0 ? 'start' : (idx === pts.length - 1 ? 'end' : 'middle');
              lbl = '<text x="' + p.x + '" y="' + (h - 4) + '" text-anchor="' + anc + '" class="fill-slate-400 text-[9.5px] font-semibold">' + (idx === pts.length - 1 ? 'Today' : escapeHtml(p.sd)) + '</text>';
            }
            return '<g class="chart-pt-group cursor-pointer" data-date="' + escapeHtml(p.sd) + '" data-count="' + p.count + '" tabindex="0" aria-label="' + escapeHtml(p.sd) + ': ' + p.count + ' events"><rect x="' + (p.x - 14) + '" y="' + padT + '" width="28" height="' + plotH + '" fill="transparent"/><circle cx="' + p.x + '" cy="' + p.y + '" r="3.5" class="fill-white stroke-[#0B2545] transition-all" stroke-width="2"/>' + lbl + '</g>';
          }).join('');
        if (readout) readout.textContent = '14d Total: ' + totalEv + ' events';
        bindChartHover(totalEv);
      }

      // Update Live Activity Feed
      var actBody = document.getElementById('live-activity-body');
      if (actBody && Array.isArray(data.recentActivity)) {
        if (data.recentActivity.length === 0) {
          actBody.innerHTML = '<div class="admin-empty-state py-10"><p class="text-xs text-[color:var(--adm-muted)] font-medium">No activity recorded yet.</p></div>';
        } else {
          actBody.innerHTML = '<ol class="dash-timeline" aria-label="Recent administrative actions">' +
            data.recentActivity.slice(0, 6).map(function (item) {
              var lbl = detailLabel(item.details, item.userName);
              return '<li class="dash-timeline-item"><span class="dash-timeline-dot" aria-hidden="true"></span><div class="min-w-0"><p class="text-xs font-bold text-slate-800">' + escapeHtml(prettyAction(item.action)) + '</p>' +
                (lbl ? '<p class="text-[11px] text-[color:var(--adm-muted)] font-medium truncate">' + escapeHtml(lbl) + '</p>' : '') +
                '</div><span class="dash-timeline-time">' + escapeHtml(relTime(item.createdAt)) + '</span></li>';
            }).join('') + '</ol>';
        }
      }

      // Update Active Tenders count (reconciled X of Y)
      setText('tenders-count-badge', (data.activeTenders || []).length + ' of ' + s.tenderPipeline.open);
      setText('inquiries-count-badge', String((data.pendingApplications || []).length));
    } catch (e) {
      // ignore transient network errors
    } finally {
      if (refreshIcon) refreshIcon.classList.remove('animate-spin');
    }
  }

  function startLoop() {
    if (timer) clearInterval(timer);
    if (isLive) timer = setInterval(pollMonitor, POLL_MS);
  }

  if (toggleBtn) {
    toggleBtn.addEventListener('click', function () {
      isLive = !isLive;
      toggleBtn.setAttribute('aria-pressed', isLive ? 'true' : 'false');
      if (toggleLabel) toggleLabel.textContent = isLive ? 'Pause' : 'Resume';
      if (statusText) statusText.textContent = isLive ? 'LIVE · 10s' : 'PAUSED';
      if (statusPill) {
        statusPill.className = isLive
          ? 'inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[11px] font-bold uppercase tracking-wider bg-emerald-50 text-emerald-700 border border-emerald-200'
          : 'inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[11px] font-bold uppercase tracking-wider bg-amber-50 text-amber-800 border border-amber-200';
      }
      if (statusDot) {
        statusDot.className = isLive ? 'w-2 h-2 rounded-full bg-emerald-500 animate-pulse' : 'w-2 h-2 rounded-full bg-amber-500';
      }
      startLoop();
    });
  }

  if (refreshBtn) {
    refreshBtn.addEventListener('click', pollMonitor);
  }

  startLoop();
})();
</script>
