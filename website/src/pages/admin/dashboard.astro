---
import AdminLayout from '../../layouts/AdminLayout.astro';
import Icon from '../../components/Icon.astro';
import { isAdmin } from '../../utils/roles';
import { BACKEND_URL } from '../../utils/api-error';

function asArray<T>(value: unknown): T[] {
  if (Array.isArray(value)) return value as T[];
  if (value && typeof value === 'object') {
    const v = value as Record<string, unknown>;
    if (Array.isArray(v.data)) return v.data as T[];
    if (Array.isArray(v.value)) return v.value as T[];
  }
  return [];
}

const sessionToken = Astro.cookies.get('admin_session')?.value;
if (!sessionToken) {
  return Astro.redirect('/admin/login');
}

const user = Astro.locals.user;
const userRole = (user?.role || 'VIEWER').toUpperCase();
const userIsAdmin = isAdmin(userRole);

const formattedDate = new Date().toLocaleDateString('en-GB', {
  weekday: 'long',
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});

async function fetchJson<T>(url: string, options?: RequestInit): Promise<T | null> {
  try {
    const res = await fetch(url, options);
    if (!res.ok) return null;
    return (await res.json()) as T;
  } catch {
    return null;
  }
}

interface Summary {
  kpis: { operationalProjects: number; openTenders: number; pendingApplications: number };
  projectStages: { operational: number; underConstruction: number; upcoming: number };
  tenderPipeline: {
    open: number; closingSoon: number; closed: number;
    nearestClosing: { id: string; title: string; referenceNo: string; closingDate: string | null } | null;
  };
  activitySeries: { date: string; count: number }[];
}

let summary: Summary | null = null;
let errorMessage = '';

// Raw data for actionable panels
let activeTenders: { id: string; referenceNo: string; title: string; closingDate: string | null }[] = [];
let pendingApplications: { id: string; name: string; email: string; createdAt: string }[] = [];
interface AuditItem { action: string; details: string | null; createdAt: string; user?: { name?: string } | null }
let recentActivity: AuditItem[] = [];

if (userIsAdmin) {
  const [summaryRes, tendersRes, submissionsRes, logsRes] = await Promise.all([
    fetchJson<Summary>(`${BACKEND_URL}/api/dashboard-summary`, { headers: { Authorization: `Bearer ${sessionToken}` } }),
    fetchJson<unknown>(`${BACKEND_URL}/api/tenders?status=Active&pageSize=50`, { headers: { Authorization: `Bearer ${sessionToken}` } }),
    fetchJson<unknown>(`${BACKEND_URL}/api/contact?pageSize=50`, { headers: { Authorization: `Bearer ${sessionToken}` } }),
    fetchJson<unknown>(`${BACKEND_URL}/api/audit-logs?pageSize=20`, { headers: { Authorization: `Bearer ${sessionToken}` } }),
  ]);
  summary = summaryRes;
  if (!summary) {
    errorMessage = 'Could not load dashboard metrics. Ensure the backend REST service is online.';
  }
  activeTenders = asArray<{ id: string; referenceNo?: string; title?: string; closingDate?: string | null }>(tendersRes)
    .filter((t) => !t.closingDate || new Date(t.closingDate).getTime() > Date.now())
    .sort((a, b) => new Date(a.closingDate || '2999-12-31').getTime() - new Date(b.closingDate || '2999-12-31').getTime())
    .slice(0, 5) as typeof activeTenders;
  pendingApplications = asArray<{ id: string; name?: string; email?: string; createdAt?: string }>(submissionsRes).slice(0, 5) as typeof pendingApplications;
  recentActivity = asArray<{ action?: string; details?: string | null; createdAt?: string }>(logsRes).slice(0, 8).map((l) => ({
    action: l.action || 'EVENT',
    details: l.details || null,
    createdAt: l.createdAt || '',
  }));
}

function relativeTime(iso: string): string {
  if (!iso) return '';
  const then = new Date(iso).getTime();
  if (Number.isNaN(then)) return '';
  const diff = Date.now() - then;
  const mins = Math.floor(diff / 60000);
  if (mins < 1) return 'just now';
  if (mins < 60) return `${mins} min ago`;
  const hours = Math.floor(mins / 60);
  if (hours < 24) return `${hours} hour${hours === 1 ? '' : 's'} ago`;
  const days = Math.floor(hours / 24);
  if (days < 30) return `${days} day${days === 1 ? '' : 's'} ago`;
  return new Date(iso).toLocaleDateString('en-GB', { day: 'numeric', month: 'short' });
}

function prettyAction(action: string): string {
  return action.replace(/_/g, ' ').toLowerCase().replace(/\b\w/g, (c) => c.toUpperCase());
}

function detailLabel(details: string | null): string {
  if (!details) return '';
  try {
    const d = JSON.parse(details);
    return d.title || d.name || d.referenceNo || d.email || '';
  } catch {
    return details;
  }
}

function daysUntil(iso: string | null): number | null {
  if (!iso) return null;
  const t = new Date(iso).getTime();
  if (Number.isNaN(t)) return null;
  return Math.ceil((t - Date.now()) / 86400000);
}

function fmtDate(iso: string | null): string {
  if (!iso) return '—';
  const d = new Date(iso);
  if (Number.isNaN(d.getTime())) return '—';
  return d.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
}

// 14-day sparkline path from activitySeries (inline SVG, no chart lib)
function sparkline(series: { date: string; count: number }[]): { path: string; area: string; max: number } {
  const counts = series.map((p) => p.count);
  const max = Math.max(...counts, 1);
  const w = 120, h = 32, n = Math.max(counts.length, 2);
  const pts = counts.map((c, i) => {
    const x = (i / (n - 1)) * w;
    const y = h - (c / max) * (h - 4) - 2;
    return `${x.toFixed(1)},${y.toFixed(1)}`;
  });
  const path = `M${pts.join(' L')}`;
  const area = `${path} L${w},${h} L0,${h} Z`;
  return { path, area, max };
}

function urgencyBadge(iso: string | null): { cls: string; label: string } {
  const d = daysUntil(iso);
  if (d === null || d < 0) return { cls: '', label: '' };
  if (d <= 3) return { cls: 'dash-urgency-red', label: `in ${d}d` };
  if (d <= 7) return { cls: 'dash-urgency-amber', label: `in ${d}d` };
  return { cls: '', label: '' };
}

const adminUserName = user?.name || userRole;
---

<AdminLayout title="Dashboard" description="JKSPDCL Administrative Control Panel Dashboard" activeTab="dashboard">
  <div class="flex flex-col gap-6 max-w-7xl">

    <!-- Dashboard Header -->
    <div class="admin-page-header">
      <div>
        <div class="flex items-center gap-2">
          <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 animate-pulse"></span>
          <h1 class="admin-page-title">Welcome back, {adminUserName}</h1>
        </div>
        <p class="admin-page-subtitle">{formattedDate} &mdash; Operational overview &amp; items needing your attention.</p>
      </div>
      <div class="flex items-center gap-2 self-start sm:self-auto">
        <span class="admin-badge admin-badge-success">Console Status: Online</span>
      </div>
    </div>

    {errorMessage && (
      <div class="p-3 bg-red-50 border border-red-200 rounded text-xs text-red-700 font-semibold flex items-center gap-2" role="alert">
        <Icon name="info" size={14} class="text-red-600 shrink-0" />
        <span>{errorMessage}</span>
      </div>
    )}

    {userIsAdmin && summary && (
    <div class="dashboard-layout">

      <!-- ══ ZONE A · Executive Overview ══ -->
      <section class="dash-zone dash-zone-a flex flex-col gap-5" aria-label="Executive overview">
        <div class="dash-panel p-5">
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-5">
            <!-- KPI: Operational projects -->
            <div class="dash-kpi">
              <div class="flex items-start justify-between gap-3">
                <div>
                  <p class="dash-kpi-label">Operational Projects</p>
                  <p class="dash-kpi-value">{summary.kpis.operationalProjects}</p>
                  <p class="dash-kpi-delta">+{summary.kpis.deltas.operationalProjects} added this week</p>
                </div>
                <span class="dash-kpi-icon"><Icon name="zap" size={18} /></span>
              </div>
              <svg class="dash-spark" viewBox="0 0 120 32" preserveAspectRatio="none" aria-hidden="true">
                <path d={sparkline(summary.activitySeries).area} class="dash-spark-area" />
                <path d={sparkline(summary.activitySeries).path} class="dash-spark-line" />
              </svg>
            </div>
            <!-- KPI: Open tenders -->
            <div class="dash-kpi">
              <div class="flex items-start justify-between gap-3">
                <div>
                  <p class="dash-kpi-label">Open Tenders</p>
                  <p class="dash-kpi-value">{summary.tenderPipeline.open}</p>
                  <p class="dash-kpi-delta">+{summary.kpis.deltas.openTenders} published this week</p>
                </div>
                <span class="dash-kpi-icon"><Icon name="file-text" size={18} /></span>
              </div>
              {summary.tenderPipeline.nearestClosing ? (
                <p class="dash-kpi-callout dash-kpi-callout-danger">
                  <Icon name="clock" size={12} strokeWidth={2.5} />
                  {summary.tenderPipeline.nearestClosing.referenceNo} closes {fmtDate(summary.tenderPipeline.nearestClosing.closingDate)}
                </p>
              ) : (
                <p class="dash-kpi-callout">No upcoming closing dates</p>
              )}
            </div>
            <!-- KPI: Pending inquiries -->
            <div class="dash-kpi">
              <div class="flex items-start justify-between gap-3">
                <div>
                  <p class="dash-kpi-label">Pending Inquiries</p>
                  <p class="dash-kpi-value">{summary.kpis.pendingApplications}</p>
                  <p class="dash-kpi-delta">+{summary.kpis.deltas.pendingApplications} received this week</p>
                </div>
                <span class="dash-kpi-icon"><Icon name="mail" size={18} /></span>
              </div>
              <a href="/admin/contacts" class="dash-panel-link mt-auto">Review inbox <Icon name="arrow-right" size={11} strokeWidth={2.5} /></a>
            </div>
          </div>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-5">
          <!-- Project stage segmented bar -->
          <div class="dash-panel p-5">
            <div class="flex items-center justify-between gap-3 mb-3">
              <h3 class="dash-panel-title">Project portfolio by stage</h3>
            </div>
            {(() => {
              const st = summary.projectStages;
              const total = st.operational + st.underConstruction + st.upcoming;
              const seg = (v: number) => (total > 0 ? `${(v / total) * 100}%` : '0%');
              return (
                <div>
                  <div class="dash-segbar" role="img" aria-label={`${st.operational} operational, ${st.underConstruction} under construction, ${st.upcoming} upcoming of ${total} projects`}>
                    <span class="dash-seg dash-seg-op" style={`width:${seg(st.operational)}`} title={`Operational: ${st.operational}`}></span>
                    <span class="dash-seg dash-seg-uc" style={`width:${seg(st.underConstruction)}`} title={`Under Construction: ${st.underConstruction}`}></span>
                    <span class="dash-seg dash-seg-up" style={`width:${seg(st.upcoming)}`} title={`Upcoming: ${st.upcoming}`}></span>
                  </div>
                  <div class="flex flex-wrap gap-x-5 gap-y-1.5 mt-3 text-xs font-semibold">
                    <a class="dash-legend dash-legend-op" href="/admin/operational-projects">Operational · {st.operational}</a>
                    <a class="dash-legend dash-legend-uc" href="/admin/under-construction">Under Construction · {st.underConstruction}</a>
                    <a class="dash-legend dash-legend-up" href="/admin/upcoming-projects">Upcoming · {st.upcoming}</a>
                  </div>
                </div>
              );
            })()}
          </div>

          <!-- Tender pipeline stacked bar -->
          <div class="dash-panel p-5">
            <div class="flex items-center justify-between gap-3 mb-3">
              <h3 class="dash-panel-title">Tender pipeline</h3>
              <a href="/admin/tenders" class="dash-panel-link">View all <Icon name="arrow-right" size={11} strokeWidth={2.5} /></a>
            </div>
            {(() => {
              const tp = summary.tenderPipeline;
              const total = tp.open + tp.closingSoon + tp.closed;
              const seg = (v: number) => (total > 0 ? `${(v / total) * 100}%` : '0%');
              return (
                <div>
                  <div class="dash-segbar" role="img" aria-label={`${tp.open} open, ${tp.closingSoon} closing within 7 days, ${tp.closed} closed`}>
                    <span class="dash-seg dash-seg-open" style={`width:${seg(tp.open)}`} title={`Open: ${tp.open}`}></span>
                    <span class="dash-seg dash-seg-soon" style={`width:${seg(tp.closingSoon)}`} title={`Closing ≤7 days: ${tp.closingSoon}`}></span>
                    <span class="dash-seg dash-seg-closed" style={`width:${seg(tp.closed)}`} title={`Closed: ${tp.closed}`}></span>
                  </div>
                  <div class="flex flex-wrap gap-x-5 gap-y-1.5 mt-3 text-xs font-semibold">
                    <span class="dash-legend dash-legend-open">Open · {tp.open}</span>
                    <span class="dash-legend dash-legend-soon">Closing ≤7 days · {tp.closingSoon}</span>
                    <span class="dash-legend dash-legend-closed">Closed · {tp.closed}</span>
                  </div>
                </div>
              );
            })()}
          </div>
        </div>
      </section>

      <!-- ══ ZONE B · Actionable Panels ══ -->
      <div class="dash-zone-b flex flex-col gap-5" role="list" aria-label="Actionable panels">
        <!-- Active tenders mini-table -->
        <section class="dash-panel" aria-label="Active tenders by deadline">
          <div class="dash-panel-header">
            <h2 class="dash-panel-title"><Icon name="file-text" size={14} /> Active tenders <span class="dash-panel-count">{activeTenders.length}</span></h2>
            <a href="/admin/tenders" class="dash-panel-link">View all <Icon name="arrow-right" size={11} strokeWidth={2.5} /></a>
          </div>
          {activeTenders.length === 0 ? (
            <div class="admin-empty-state py-6">
              <p class="text-xs text-[color:var(--adm-muted)] font-medium">No active tenders with open deadlines.</p>
            </div>
          ) : (
            <table class="dash-minitable">
              <thead>
                <tr><th scope="col">Tender</th><th scope="col">Closes</th><th scope="col" class="text-right">Action</th></tr>
              </thead>
              <tbody>
                {activeTenders.map((t) => {
                  const badge = urgencyBadge(t.closingDate);
                  return (
                    <tr>
                      <td>
                        <span class="block text-xs font-bold text-slate-800 truncate max-w-xs">{t.title}</span>
                        <span class="block text-[11px] text-[color:var(--adm-muted)] font-medium">{t.referenceNo}</span>
                      </td>
                      <td>
                        <span class="text-xs font-semibold text-slate-700 whitespace-nowrap">{fmtDate(t.closingDate)}</span>
                        {badge.cls && <span class={`dash-urgency ${badge.cls}`}>{badge.label}</span>}
                      </td>
                      <td class="text-right">
                        <a href={`/admin/tenders?edit=${t.id}`} class="dash-panel-link">Edit</a>
                      </td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
          )}
        </section>

        <!-- Pending inquiries mini-table -->
        <section class="dash-panel" aria-label="Latest public inquiries">
          <div class="dash-panel-header">
            <h2 class="dash-panel-title"><Icon name="mail" size={14} /> Latest inquiries <span class="dash-panel-count">{pendingApplications.length}</span></h2>
            <a href="/admin/contacts" class="dash-panel-link">View all <Icon name="arrow-right" size={11} strokeWidth={2.5} /></a>
          </div>
          {pendingApplications.length === 0 ? (
            <div class="admin-empty-state py-6">
              <p class="text-xs text-[color:var(--adm-muted)] font-medium">Inbox is clear — no pending public inquiries.</p>
            </div>
          ) : (
            <table class="dash-minitable">
              <thead>
                <tr><th scope="col">From</th><th scope="col">Received</th><th scope="col" class="text-right">Action</th></tr>
              </thead>
              <tbody>
                {pendingApplications.map((a) => (
                  <tr>
                    <td>
                      <span class="block text-xs font-bold text-slate-800">{a.name}</span>
                      <span class="block text-[11px] text-[color:var(--adm-muted)] font-medium truncate max-w-xs">{a.email}</span>
                    </td>
                    <td><span class="text-xs font-semibold text-slate-700 whitespace-nowrap">{relativeTime(a.createdAt)}</span></td>
                    <td class="text-right"><a href="/admin/contacts" class="dash-panel-link">Open</a></td>
                  </tr>
                ))}
              </tbody>
            </table>
          )}
        </section>
      </div>

      <!-- ══ ZONE C · Activity Rail ══ -->
      <aside class="dash-zone-c flex flex-col gap-5" aria-label="Live activity and system health">
        <!-- Activity timeline -->
        <section class="dash-panel" aria-label="Recent administrative activity">
          <div class="dash-panel-header">
            <h2 class="dash-panel-title"><Icon name="zap" size={14} /> Live activity</h2>
            <a href="/admin/audit-logs" class="dash-panel-link">All logs <Icon name="arrow-right" size={11} strokeWidth={2.5} /></a>
          </div>
          {recentActivity.length === 0 ? (
            <div class="admin-empty-state py-6">
              <p class="text-xs text-[color:var(--adm-muted)] font-medium">No activity recorded yet.</p>
            </div>
          ) : (
            <ol class="dash-timeline" aria-label="Recent administrative actions grouped by day">
              {(() => {
                const todayKey = new Date().toDateString();
                let currentGroup = '';
                return recentActivity.map((item) => {
                  const dayKey = new Date(item.createdAt);
                  const groupLabel = Number.isNaN(dayKey.getTime())
                    ? ''
                    : dayKey.toDateString() === todayKey ? 'Today' : 'Earlier this week';
                  const showGroup = groupLabel !== currentGroup;
                  currentGroup = groupLabel;
                  return (
                    <Fragment>
                      {showGroup && groupLabel && <li class="dash-timeline-day">{groupLabel}</li>}
                      <li class="dash-timeline-item">
                        <span class="dash-timeline-dot" aria-hidden="true"></span>
                        <div class="min-w-0">
                          <p class="text-xs font-bold text-slate-800">{prettyAction(item.action)}</p>
                          {detailLabel(item.details) && (
                            <p class="text-[11px] text-[color:var(--adm-muted)] font-medium truncate">{detailLabel(item.details)}</p>
                          )}
                        </div>
                        <span class="dash-timeline-time">{relativeTime(item.createdAt)}</span>
                      </li>
                    </Fragment>
                  );
                });
              })()}
            </ol>
          )}
        </section>

        <!-- System health -->
        <section class="dash-panel p-4" aria-label="System health">
          <h2 class="dash-panel-title mb-3"><Icon name="gear" size={14} /> System health</h2>
          <ul class="flex flex-col gap-2 text-xs font-semibold">
            <li class="flex items-center justify-between">
              <span class="text-slate-600">API service</span>
              <span class="dash-health dash-health-ok"><span class="dash-health-dot"></span> Online</span>
            </li>
            <li class="flex items-center justify-between">
              <span class="text-slate-600">Database</span>
              <span class={`dash-health ${summary ? 'dash-health-ok' : 'dash-health-bad'}`}><span class="dash-health-dot"></span> {summary ? 'Connected' : 'Unreachable'}</span>
            </li>
            <li class="flex items-center justify-between">
              <span class="text-slate-600">Storage</span>
              <span class="dash-health dash-health-ok"><span class="dash-health-dot"></span> Available</span>
            </li>
          </ul>
        </section>

        <!-- Quick actions -->
        <section class="dash-panel p-4" aria-label="Quick actions">
          <h2 class="dash-panel-title mb-3">Quick actions</h2>
          <div class="grid grid-cols-3 gap-2">
            <a href="/admin/tenders?action=new" class="dash-quick" aria-label="Publish new tender">
              <Icon name="plus" size={16} /><span>Tender</span>
            </a>
            <a href="/admin/operational-projects?action=new" class="dash-quick" aria-label="Add new project">
              <Icon name="zap" size={16} /><span>Project</span>
            </a>
            <a href="/admin/resources?action=new" class="dash-quick" aria-label="Upload resource">
              <Icon name="upload" size={16} /><span>Upload</span>
            </a>
          </div>
        </section>
      </aside>

    </div>
    )}

  </div>
</AdminLayout>
