    modules: [
      {
        title: 'Tenders & Bids',
        desc: 'Manage NITs, RFPs, work categories & attach corrigenda',
        count: `${stats.tendersCount} Active Bids`,
        href: '/admin/tenders',
        addHref: '/admin/tenders-form',
        addLabel: '+ Publish NIT',
        icon: 'file-text',
        color: 'text-violet-700',
        iconBg: 'bg-violet-100 text-violet-700',
      },
    ],
  },
  {
    title: 'Corporate Governance & Legal',
    subtitle: 'Leadership, statutory filings & official circulars',
    modules: [
      {
        title: 'Dignitaries',
        desc: 'Profiles, portfolios & bios for Hon\'ble LG, CM, Minister, MD',
        count: `${stats.dignitariesCount} Profiles`,
        href: '/admin/dignitaries',
        icon: 'award',
        color: 'text-amber-700',
        iconBg: 'bg-amber-100 text-amber-700',
      },
      {
        title: 'Board of Directors',
        desc: 'Official Board members, roles, executive appointments',
        count: `${stats.directorsCount} Members`,
        href: '/admin/board-of-directors',
        icon: 'users',
        color: 'text-emerald-700',
        iconBg: 'bg-emerald-100 text-emerald-700',
      },
      {
        title: 'AGM Documents',
        desc: 'Annual General Meeting reports, notices & proxy filings',
        count: `${stats.agmCount} Documents`,
        href: '/admin/agm',
        icon: 'scroll-text',
        color: 'text-cyan-700',
        iconBg: 'bg-cyan-100 text-cyan-700',
      },
      {
        title: 'Notifications & Circulars',
        desc: 'Official government circulars, office orders & gazette orders',
        count: `${stats.notificationsCount} Orders`,
        href: '/admin/notifications',
        icon: 'bell',
        color: 'text-rose-700',
        iconBg: 'bg-rose-100 text-rose-700',
      },
    ],
