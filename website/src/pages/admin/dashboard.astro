---
import AdminLayout from '../../layouts/AdminLayout.astro';
import Icon from '../../components/Icon.astro';
import type { Stats, ProjectDto, DirectorDto, TenderDto, CareerDto, ContactSubmissionDto, AuditLogDto } from './types';

function asArray<T>(value: unknown): T[] {
  return Array.isArray(value) ? (value as T[]) : [];
}

function toDateOrNull(value: unknown): Date | null {
  if (typeof value !== 'string') return null;
  const d = new Date(value);
  return Number.isNaN(d.getTime()) ? null : d;
}

let sessionToken = Astro.cookies.get('admin_session')?.value || '';

let stats: Stats = {
  operationalCount: 0,
  constructionCount: 0,
  directorsCount: 0,
  tendersCount: 0,
  careersCount: 0,
  pressCount: 0,
};

let recentInquiries: ContactSubmissionDto[] = [];
let recentLogs: AuditLogDto[] = [];
let errorMessage = '';

const formattedDate = new Date().toLocaleDateString('en-GB', {
  weekday: 'long',
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});

async function fetchJson<T>(url: string, options?: RequestInit): Promise<T | null> {
  const res = await fetch(url, options);
  if (!res.ok) return null;
  return (await res.json()) as T;
}

try {
  const projects = await fetchJson<unknown>('http://localhost:3000/api/projects');
  const projectArray = asArray<ProjectDto>(projects);
  stats.operationalCount = projectArray.filter((p) => p.status === 'Operational').length;
  stats.constructionCount = projectArray.filter((p) => p.status === 'Under Construction').length;

  const directors = await fetchJson<unknown>('http://localhost:3000/api/directors');
  stats.directorsCount = asArray<DirectorDto>(directors).length;

  const tenders = await fetchJson<unknown>('http://localhost:3000/api/tenders');
  stats.tendersCount = asArray<TenderDto>(tenders).filter((t) => t.status === 'Active').length;

  const careers = await fetchJson<unknown>('http://localhost:3000/api/careers');
  stats.careersCount = asArray<CareerDto>(careers).filter((c) => c.status === 'Active').length;

  const press = await fetchJson<unknown>('http://localhost:3000/api/press-releases');
  stats.pressCount = asArray<unknown>(press).length;

  if (sessionToken) {
    const submissions = await fetchJson<unknown>('http://localhost:3000/api/contact', {
      headers: { Authorization: `Bearer ${sessionToken}` },
    });
    recentInquiries = asArray<ContactSubmissionDto>(submissions).slice(0, 5);
  }

  if (sessionToken) {
    const logs = await fetchJson<unknown>('http://localhost:3000/api/audit-logs', {
      headers: { Authorization: `Bearer ${sessionToken}` },
    });
    recentLogs = asArray<AuditLogDto>(logs).slice(0, 5);
  }
} catch (e) {
  console.error('Error fetching dashboard statistics:', e);
  errorMessage = 'Failed to retrieve latest portal statistics. Ensure the backend REST service is online.';
}

const adminUserName = Astro.cookies.get('admin_user_name')?.value || 'System Administrator';
---

<AdminLayout title="Dashboard" description="JKSPDCL Administrative Control Panel Dashboard" activeTab="dashboard">
  <div class="flex flex-col gap-8">
    
    <div class="flex flex-col gap-1.5 border-b border-slate-200 pb-5">
      <h1 class="text-2xl font-extrabold text-slate-900 tracking-tight">Welcome back, {adminUserName}</h1>
      <p class="text-xs text-slate-600 font-medium">{formattedDate} &mdash; Here is a summary of what is happening on the JKSPDC portal.</p>
    </div>

    {errorMessage && (
      <div class="p-4 bg-amber-50 border-l-4 border-amber-500 rounded text-xs text-amber-800 font-semibold shadow-sm flex items-start gap-2.5" role="alert">
        <Icon name="info" size={16} class="text-amber-600 shrink-0 mt-0.5" />
        <div class="flex flex-col gap-0.5">
          <span>Backend Offline Notification:</span>
          <span class="text-[11px] font-normal text-amber-700">{errorMessage}</span>
        </div>
      </div>
    )}

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-6 gap-5">
      
      <div class="bg-gradient-to-br from-blue-500 to-indigo-600 rounded-xl p-4 text-white shadow-lg shadow-blue-500/10 flex items-center justify-between group transition-all">
        <div class="flex flex-col gap-1">
          <span class="text-[10px] font-bold uppercase tracking-widest text-blue-100">Operational</span>
          <span class="text-2xl font-black">{stats.operationalCount}</span>
          <a href="/admin/operational-projects" class="text-[10px] text-blue-200 hover:underline font-bold mt-1 inline-flex items-center gap-0.5">Manage <Icon name="arrow-right" size={10} /></a>
        </div>
        <div class="p-2.5 bg-white/10 rounded-lg text-white">
          <Icon name="zap" size={24} />
        </div>
      </div>

      <div class="bg-gradient-to-br from-orange-500 to-amber-600 rounded-xl p-4 text-white shadow-lg shadow-orange-500/10 flex items-center justify-between group transition-all">
        <div class="flex flex-col gap-1">
          <span class="text-[10px] font-bold uppercase tracking-widest text-orange-100">Construction</span>
          <span class="text-2xl font-black">{stats.constructionCount}</span>
          <a href="/admin/under-construction" class="text-[10px] text-orange-200 hover:underline font-bold mt-1 inline-flex items-center gap-0.5">Manage <Icon name="arrow-right" size={10} /></a>
        </div>
        <div class="p-2.5 bg-white/10 rounded-lg text-white">
          <Icon name="hardhat" size={24} />
        </div>
      </div>

      <div class="bg-gradient-to-br from-emerald-500 to-teal-600 rounded-xl p-4 text-white shadow-lg shadow-emerald-500/10 flex items-center justify-between group transition-all">
        <div class="flex flex-col gap-1">
          <span class="text-[10px] font-bold uppercase tracking-widest text-emerald-100">Board Members</span>
          <span class="text-2xl font-black">{stats.directorsCount}</span>
          <a href="/admin/board-of-directors" class="text-[10px] text-emerald-200 hover:underline font-bold mt-1 inline-flex items-center gap-0.5">Manage <Icon name="arrow-right" size={10} /></a>
        </div>
        <div class="p-2.5 bg-white/10 rounded-lg text-white">
          <Icon name="users" size={24} />
        </div>
      </div>

      <div class="bg-gradient-to-br from-violet-500 to-purple-600 rounded-xl p-4 text-white shadow-lg shadow-violet-500/10 flex items-center justify-between group transition-all">
        <div class="flex flex-col gap-1">
          <span class="text-[10px] font-bold uppercase tracking-widest text-violet-100">Active Tenders</span>
          <span class="text-2xl font-black">{stats.tendersCount}</span>
          <a href="/admin/tenders" class="text-[10px] text-violet-200 hover:underline font-bold mt-1 inline-flex items-center gap-0.5">Manage <Icon name="arrow-right" size={10} /></a>
        </div>
        <div class="p-2.5 bg-white/10 rounded-lg text-white">
          <Icon name="file-text" size={24} />
        </div>
      </div>

      <div class="bg-gradient-to-br from-pink-500 to-rose-600 rounded-xl p-4 text-white shadow-lg shadow-pink-500/10 flex items-center justify-between group transition-all">
        <div class="flex flex-col gap-1">
          <span class="text-[10px] font-bold uppercase tracking-widest text-pink-100">Careers Open</span>
          <span class="text-2xl font-black">{stats.careersCount}</span>
          <a href="/admin/careers" class="text-[10px] text-pink-200 hover:underline font-bold mt-1 inline-flex items-center gap-0.5">Manage <Icon name="arrow-right" size={10} /></a>
        </div>
        <div class="p-2.5 bg-white/10 rounded-lg text-white">
          <Icon name="briefcase" size={24} />
        </div>
      </div>

      <div class="bg-gradient-to-br from-rose-500 to-red-600 rounded-xl p-4 text-white shadow-lg shadow-rose-500/10 flex items-center justify-between group transition-all">
        <div class="flex flex-col gap-1">
          <span class="text-[10px] font-bold uppercase tracking-widest text-rose-100">Press Articles</span>
          <span class="text-2xl font-black">{stats.pressCount}</span>
          <a href="/admin/press-releases" class="text-[10px] text-rose-200 hover:underline font-bold mt-1 inline-flex items-center gap-0.5">Manage <Icon name="arrow-right" size={10} /></a>
        </div>
        <div class="p-2.5 bg-white/10 rounded-lg text-white">
          <Icon name="newspaper" size={24} />
        </div>
      </div>

    </div>

    <div class="bg-white rounded-xl border border-slate-200 shadow-sm p-6 flex flex-col gap-4">
      <h3 class="text-xs font-bold text-slate-400 uppercase tracking-widest border-b border-slate-100 pb-2.5 flex items-center gap-2">
        <Icon name="zap" size={14} class="text-amber-500" /> Administrative Quick Actions
      </h3>
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-4">
        
        <a href="/admin/board-of-directors" class="border border-slate-200 hover:border-blue-500 rounded-lg p-4 flex flex-col items-center justify-center text-center gap-2 group transition-colors bg-slate-50/50 hover:bg-blue-50/30">
          <div class="p-2.5 bg-blue-50 text-blue-600 rounded-full group-hover:scale-110 transition-transform">
            <Icon name="users" size={18} />
          </div>
          <span class="text-[11px] font-bold text-slate-700">Manage Board</span>
        </a>

        <a href="/admin/operational-projects-form" class="border border-slate-200 hover:border-orange-500 rounded-lg p-4 flex flex-col items-center justify-center text-center gap-2 group transition-colors bg-slate-50/50 hover:bg-orange-50/30">
          <div class="p-2.5 bg-orange-50 text-orange-600 rounded-full group-hover:scale-110 transition-transform">
            <Icon name="plus" size={18} />
          </div>
          <span class="text-[11px] font-bold text-slate-700">Add Power Station</span>
        </a>

        <a href="/admin/tenders" class="border border-slate-200 hover:border-violet-500 rounded-lg p-4 flex flex-col items-center justify-center text-center gap-2 group transition-colors bg-slate-50/50 hover:bg-violet-50/30">
          <div class="p-2.5 bg-violet-50 text-violet-600 rounded-full group-hover:scale-110 transition-transform">
            <Icon name="file-text" size={18} />
          </div>
          <span class="text-[11px] font-bold text-slate-700">Manage Tenders</span>
        </a>

        <a href="/admin/careers" class="border border-slate-200 hover:border-pink-500 rounded-lg p-4 flex flex-col items-center justify-center text-center gap-2 group transition-colors bg-slate-50/50 hover:bg-pink-50/30">
          <div class="p-2.5 bg-pink-50 text-pink-600 rounded-full group-hover:scale-110 transition-transform">
            <Icon name="briefcase" size={18} />
          </div>
          <span class="text-[11px] font-bold text-slate-700">Manage Careers</span>
        </a>

        <a href="/admin/press-releases" class="border border-slate-200 hover:border-rose-500 rounded-lg p-4 flex flex-col items-center justify-center text-center gap-2 group transition-colors bg-slate-50/50 hover:bg-rose-50/30">
          <div class="p-2.5 bg-rose-50 text-rose-600 rounded-full group-hover:scale-110 transition-transform">
            <Icon name="newspaper" size={18} />
          </div>
          <span class="text-[11px] font-bold text-slate-700">Press Releases</span>
        </a>

        <a href="/admin/contacts" class="border border-slate-200 hover:border-emerald-500 rounded-lg p-4 flex flex-col items-center justify-center text-center gap-2 group transition-colors bg-slate-50/50 hover:bg-emerald-50/30">
          <div class="p-2.5 bg-emerald-50 text-emerald-600 rounded-full group-hover:scale-110 transition-transform">
            <Icon name="mail" size={18} />
          </div>
          <span class="text-[11px] font-bold text-slate-700">View Inquiries</span>
        </a>

      </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
      
      <div class="bg-white border border-slate-200 rounded-xl shadow-sm p-6 flex flex-col gap-4">
        <div class="flex items-center justify-between border-b border-slate-100 pb-3">
          <h3 class="text-xs font-bold text-slate-400 uppercase tracking-widest flex items-center gap-2">
            <Icon name="mail" size={14} class="text-blue-500" /> Recent Public Inquiries
          </h3>
          <a href="/admin/contacts" class="text-[10px] text-blue-600 font-bold hover:underline">View All <Icon name="arrow-right" size={10} /></a>
        </div>

        <div class="flex flex-col gap-3.5">
          {recentInquiries.length === 0 ? (
            <p class="text-xs text-slate-400 italic py-6 text-center font-medium">No recent citizen inquiries found.</p>
          ) : (
            recentInquiries.map((inq) => (
              <div key={inq.id ?? `${inq.email ?? 'inquiry'}-${inq.createdAt ?? ''}`} class="p-3 border border-slate-100 rounded-lg bg-slate-50/60 hover:bg-slate-50 transition-colors flex flex-col gap-1.5">
                <div class="flex justify-between items-start gap-2">
                  <span class="text-xs font-bold text-[#0B4F9C]">{inq.name}</span>
                  <span class="text-[10px] text-slate-500 font-semibold">{toDateOrNull(inq.createdAt)?.toLocaleDateString('en-IN', { dateStyle: 'short' }) ?? ''}</span>
                </div>
                <p class="text-[10px] text-slate-500 font-semibold">{inq.email}</p>
                <p class="text-xs text-slate-600 leading-relaxed font-normal mt-1 border-t border-slate-100/80 pt-1.5 line-clamp-2">
                  {inq.message}
                </p>
              </div>
            ))
          )}
        </div>
      </div>

      <div class="bg-white border border-slate-200 rounded-xl shadow-sm p-6 flex flex-col gap-4">
        <div class="flex items-center justify-between border-b border-slate-100 pb-3">
          <h3 class="text-xs font-bold text-slate-400 uppercase tracking-widest flex items-center gap-2">
            <Icon name="scroll-text" size={14} class="text-purple-500" /> Recent System Activities
          </h3>
          <a href="/admin/audit-logs" class="text-[10px] text-purple-600 font-bold hover:underline">All Logs <Icon name="arrow-right" size={10} /></a>
        </div>

        <div class="flex flex-col gap-3.5">
          {recentLogs.length === 0 ? (
            <p class="text-xs text-slate-400 italic py-6 text-center font-medium">No administrative activity logged yet.</p>
          ) : (
            recentLogs.map((log) => (
              <div key={log.id ?? `${log.action ?? 'log'}-${log.createdAt ?? ''}`} class="p-3 border border-slate-100 rounded-lg bg-slate-50/60 hover:bg-slate-50 transition-colors flex gap-3.5 items-center">
                <div class="p-2 bg-purple-50 text-purple-600 rounded">
                  <Icon name="scroll-text" size={14} />
                </div>
                <div class="flex flex-col flex-1 gap-0.5">
                  <div class="flex justify-between items-start gap-2">
                    <span class="text-xs font-bold text-slate-700 uppercase tracking-wider">{log.action}</span>
                    <span class="text-[10px] text-slate-400 font-semibold">
                      {toDateOrNull(log.createdAt)?.toLocaleTimeString('en-IN', { hour: '2-digit', minute: '2-digit' }) ?? ''}
                    </span>
                  </div>
                  <span class="text-[10px] font-semibold text-slate-500">IP: {log.ipAddress}</span>
                  {log.details !== undefined && log.details !== null && (
                    <span class="text-[10px] text-slate-400 italic mt-0.5 line-clamp-1 border-t border-slate-100/80 pt-1">
                      {typeof log.details === 'string' ? log.details : JSON.stringify(log.details)}
                    </span>
                  )}
                </div>
              </div>
            ))
          )}
        </div>
      </div>

    </div>

  </div>
</AdminLayout>
