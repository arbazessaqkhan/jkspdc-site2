---
import AdminLayout from '../../layouts/AdminLayout.astro';
import Icon from '../../components/Icon.astro';
import type { Stats, ProjectDto, DirectorDto, TenderDto, CareerDto, ContactSubmissionDto, AuditLogDto } from './types';

function asArray<T>(value: unknown): T[] {
  return Array.isArray(value) ? (value as T[]) : [];
}

function toDateOrNull(value: unknown): Date | null {
  if (typeof value !== 'string') return null;
  const d = new Date(value);
  return Number.isNaN(d.getTime()) ? null : d;
}

let sessionToken = Astro.cookies.get('admin_session')?.value || '';

let stats: Stats = {
  operationalCount: 0,
  constructionCount: 0,
  directorsCount: 0,
  tendersCount: 0,
  careersCount: 0,
  pressCount: 0,
};

let recentInquiries: ContactSubmissionDto[] = [];
let recentLogs: AuditLogDto[] = [];
let errorMessage = '';

const formattedDate = new Date().toLocaleDateString('en-GB', {
  weekday: 'long',
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});

async function fetchJson<T>(url: string, options?: RequestInit): Promise<T | null> {
  const res = await fetch(url, options);
  if (!res.ok) return null;
  return (await res.json()) as T;
}

try {
  const projects = await fetchJson<unknown>('http://localhost:3000/api/projects');
  const projectArray = asArray<ProjectDto>(projects);
  stats.operationalCount = projectArray.filter((p) => p.status === 'Operational').length;
  stats.constructionCount = projectArray.filter((p) => p.status === 'Under Construction').length;

  const directors = await fetchJson<unknown>('http://localhost:3000/api/directors');
  stats.directorsCount = asArray<DirectorDto>(directors).length;

  const tenders = await fetchJson<unknown>('http://localhost:3000/api/tenders');
  stats.tendersCount = asArray<TenderDto>(tenders).filter((t) => t.status === 'Active').length;

  const careers = await fetchJson<unknown>('http://localhost:3000/api/careers');
  stats.careersCount = asArray<CareerDto>(careers).filter((c) => c.status === 'Active').length;

  const press = await fetchJson<unknown>('http://localhost:3000/api/press-releases');
  stats.pressCount = asArray<unknown>(press).length;

  if (sessionToken) {
    const submissions = await fetchJson<unknown>('http://localhost:3000/api/contact', {
      headers: { Authorization: `Bearer ${sessionToken}` },
    });
    recentInquiries = asArray<ContactSubmissionDto>(submissions).slice(0, 5);
  }

  if (sessionToken) {
    const logs = await fetchJson<unknown>('http://localhost:3000/api/audit-logs', {
      headers: { Authorization: `Bearer ${sessionToken}` },
    });
    recentLogs = asArray<AuditLogDto>(logs).slice(0, 5);
  }
} catch (e) {
  console.error('Error fetching dashboard statistics:', e);
  errorMessage = 'Failed to retrieve latest portal statistics. Ensure the backend REST service is online.';
}

const adminUserName = Astro.cookies.get('admin_user_name')?.value || 'System Administrator';

const statCards = [
  {
    label: 'Operational',
    badge: 'Live',
    count: stats.operationalCount,
    href: '/admin/operational-projects',
    icon: 'zap',
    bg: 'bg-gradient-to-br from-blue-50/90 via-white to-blue-100/40',
    border: 'border-blue-200 hover:border-[#0B4F9C]',
    topBar: 'bg-[#0B4F9C]',
    iconBg: 'bg-[#0B4F9C] text-white',
    badgeBg: 'bg-blue-100 text-[#0B4F9C] border-blue-200',
    textColor: 'text-[#0B4F9C]',
  },
  {
    label: 'Construction',
    badge: 'Active',
    count: stats.constructionCount,
    href: '/admin/under-construction',
    icon: 'hardhat',
    bg: 'bg-gradient-to-br from-amber-50/90 via-white to-orange-100/40',
    border: 'border-amber-200 hover:border-amber-500',
    topBar: 'bg-amber-500',
    iconBg: 'bg-amber-500 text-white',
    badgeBg: 'bg-amber-100 text-amber-900 border-amber-200',
    textColor: 'text-amber-800',
  },
  {
    label: 'Board Members',
    badge: 'Official',
    count: stats.directorsCount,
    href: '/admin/board-of-directors',
    icon: 'users',
    bg: 'bg-gradient-to-br from-emerald-50/90 via-white to-teal-100/40',
    border: 'border-emerald-200 hover:border-emerald-600',
    topBar: 'bg-emerald-600',
    iconBg: 'bg-emerald-600 text-white',
    badgeBg: 'bg-emerald-100 text-emerald-900 border-emerald-200',
    textColor: 'text-emerald-800',
  },
  {
    label: 'Active Tenders',
    badge: 'Bids',
    count: stats.tendersCount,
    href: '/admin/tenders',
    icon: 'file-text',
    bg: 'bg-gradient-to-br from-violet-50/90 via-white to-purple-100/40',
    border: 'border-violet-200 hover:border-violet-600',
    topBar: 'bg-violet-600',
    iconBg: 'bg-violet-600 text-white',
    badgeBg: 'bg-violet-100 text-violet-900 border-violet-200',
    textColor: 'text-violet-800',
  },
  {
    label: 'Careers Open',
    badge: 'Open',
    count: stats.careersCount,
    href: '/admin/careers',
    icon: 'briefcase',
    bg: 'bg-gradient-to-br from-sky-50/90 via-white to-cyan-100/40',
    border: 'border-sky-200 hover:border-sky-600',
    topBar: 'bg-sky-600',
    iconBg: 'bg-sky-600 text-white',
    badgeBg: 'bg-sky-100 text-sky-900 border-sky-200',
    textColor: 'text-sky-800',
  },
  {
    label: 'Press Articles',
    badge: 'News',
    count: stats.pressCount,
    href: '/admin/press-releases',
    icon: 'newspaper',
    bg: 'bg-gradient-to-br from-indigo-50/90 via-white to-blue-100/40',
    border: 'border-indigo-200 hover:border-indigo-600',
    topBar: 'bg-indigo-600',
    iconBg: 'bg-indigo-600 text-white',
    badgeBg: 'bg-indigo-100 text-indigo-900 border-indigo-200',
    textColor: 'text-indigo-800',
  },
];

const quickActions = [
  { label: 'Manage Board', href: '/admin/board-of-directors', icon: 'users', bg: 'bg-emerald-50/80 hover:bg-emerald-100/80 border-emerald-200 hover:border-emerald-500', iconBg: 'bg-emerald-600 text-white' },
  { label: 'Add Power Station', href: '/admin/operational-projects-form', icon: 'plus', bg: 'bg-amber-50/80 hover:bg-amber-100/80 border-amber-200 hover:border-amber-500', iconBg: 'bg-amber-500 text-white' },
  { label: 'Manage Tenders', href: '/admin/tenders', icon: 'file-text', bg: 'bg-violet-50/80 hover:bg-violet-100/80 border-violet-200 hover:border-violet-500', iconBg: 'bg-violet-600 text-white' },
  { label: 'Manage Careers', href: '/admin/careers', icon: 'briefcase', bg: 'bg-sky-50/80 hover:bg-sky-100/80 border-sky-200 hover:border-sky-500', iconBg: 'bg-sky-600 text-white' },
  { label: 'Press Releases', href: '/admin/press-releases', icon: 'newspaper', bg: 'bg-indigo-50/80 hover:bg-indigo-100/80 border-indigo-200 hover:border-indigo-500', iconBg: 'bg-indigo-600 text-white' },
  { label: 'View Inquiries', href: '/admin/contacts', icon: 'mail', bg: 'bg-blue-50/80 hover:bg-blue-100/80 border-blue-200 hover:border-[#0B4F9C]', iconBg: 'bg-[#0B4F9C] text-white' },
];
---

<AdminLayout title="Dashboard" description="JKSPDCL Administrative Control Panel Dashboard" activeTab="dashboard">
  <div class="flex flex-col gap-6">
    
    <!-- Welcome Header Banner -->
    <div class="bg-gradient-to-r from-blue-50/90 via-white to-[#EAF4FF]/50 rounded-xl border border-blue-200/90 border-t-3 border-t-[#0B4F9C] p-6 shadow-xs flex flex-col md:flex-row md:items-center justify-between gap-4">
      <div>
        <div class="flex items-center gap-2">
          <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 ring-4 ring-emerald-100 animate-pulse"></span>
          <h1 class="text-xl font-extrabold text-[#0B4F9C] tracking-tight">Welcome back, {adminUserName}</h1>
        </div>
        <p class="text-xs text-slate-700 font-medium mt-1">{formattedDate} &mdash; Administrative summary of the JKSPDC web portal.</p>
      </div>
      <div class="flex items-center gap-2 self-start md:self-auto">
        <span class="text-[11px] font-bold text-[#0B4F9C] bg-white px-3.5 py-1.5 rounded-lg border border-[#BDD7EE] shadow-2xs">
          Console Status: <span class="text-emerald-700 font-extrabold">Online</span>
        </span>
      </div>
    </div>

    {errorMessage && (
      <div class="p-4 bg-amber-50 border-l-4 border-amber-500 rounded-lg text-xs text-amber-800 font-semibold shadow-xs flex items-start gap-2.5" role="alert">
        <Icon name="info" size={16} class="text-amber-600 shrink-0 mt-0.5" />
        <div class="flex flex-col gap-0.5">
          <span>Backend Offline Notification:</span>
          <span class="text-[11px] font-normal text-amber-700">{errorMessage}</span>
        </div>
      </div>
    )}

    <!-- Creative, Uniform & Proportional Executive Metric Cards -->
    <div class="grid grid-cols-2 sm:grid-cols-3 xl:grid-cols-6 gap-4">
      {statCards.map((card) => (
        <a 
          href={card.href} 
          class={`group rounded-xl border p-4 shadow-xs hover:shadow-md transition-all duration-200 flex flex-col justify-between min-h-[148px] relative overflow-hidden ${card.bg} ${card.border}`}
        >
          <!-- Top Accent Bar -->
          <div class={`absolute top-0 inset-x-0 h-1.5 ${card.topBar}`}></div>

          <!-- Top Row: Icon Badge & Category Tag -->
          <div class="flex items-center justify-between gap-2 pt-0.5">
            <div class={`w-10 h-10 rounded-xl flex items-center justify-center shadow-xs shrink-0 ${card.iconBg} group-hover:scale-105 transition-transform duration-200`}>
              <Icon name={card.icon} size={18} strokeWidth={2.2} />
            </div>
            <span class={`text-[10px] font-extrabold uppercase tracking-wider px-2 py-0.5 rounded-md border shadow-2xs ${card.badgeBg}`}>
              {card.badge}
            </span>
          </div>

          <!-- Middle Row: Big Metric Count & Full-Width Label -->
          <div class="my-2">
            <div class="text-2xl font-black text-slate-900 tracking-tight leading-none group-hover:translate-x-0.5 transition-transform">
              {card.count}
            </div>
            <div class={`text-[11px] font-black uppercase tracking-wider mt-1 truncate ${card.textColor}`} title={card.label}>
              {card.label}
            </div>
          </div>

          <!-- Bottom Row: Clean Action Bar -->
          <div class="pt-2 border-t border-slate-200/70 flex items-center justify-between text-[11px] font-bold text-slate-700 group-hover:text-slate-900 transition-colors">
            <span>Manage</span>
            <Icon name="arrow-right" size={12} class="group-hover:translate-x-1 transition-transform duration-200" strokeWidth={2.5} />
          </div>
        </a>
      ))}
    </div>

    <!-- Administrative Quick Actions (Unified Corporate Design) -->
    <div class="bg-white rounded-xl border border-slate-200/90 shadow-xs p-6 flex flex-col gap-4">
      <div class="flex items-center justify-between border-b border-slate-100 pb-3">
        <h3 class="text-xs font-bold text-[#0B4F9C] uppercase tracking-wider flex items-center gap-2">
          <Icon name="zap" size={14} class="text-[#0B4F9C]" /> Administrative Quick Actions
        </h3>
        <span class="text-[11px] text-slate-500 font-semibold hidden sm:inline">Frequent portal operations</span>
      </div>
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3">
        {quickActions.map((action) => (
          <a 
            href={action.href} 
            class={`group border rounded-xl p-4 flex flex-col items-center justify-center text-center gap-2.5 transition-all duration-200 hover:shadow-sm min-h-[110px] ${action.bg}`}
          >
            <div class={`w-11 h-11 rounded-xl flex items-center justify-center group-hover:scale-105 transition-all duration-200 shadow-xs ${action.iconBg}`}>
              <Icon name={action.icon} size={19} strokeWidth={2.2} />
            </div>
            <span class="text-xs font-black text-slate-800 group-hover:text-slate-900 transition-colors leading-snug">{action.label}</span>
          </a>
        ))}
      </div>
    </div>

    <!-- Bottom Grids: Recent Inquiries & System Activities -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
      
      <!-- Recent Citizen Inquiries -->
      <div class="bg-white border border-slate-200/90 rounded-xl shadow-xs p-6 flex flex-col gap-4">
        <div class="flex items-center justify-between border-b border-slate-100 pb-3">
          <h3 class="text-xs font-bold text-slate-700 uppercase tracking-wider flex items-center gap-2">
            <Icon name="mail" size={14} class="text-[#0B4F9C]" /> Recent Public Inquiries
          </h3>
          <a href="/admin/contacts" class="text-xs text-[#0B4F9C] font-bold hover:underline inline-flex items-center gap-1">
            View All <Icon name="arrow-right" size={11} />
          </a>
        </div>

        <div class="flex flex-col gap-3">
          {recentInquiries.length === 0 ? (
            <p class="text-xs text-slate-400 italic py-8 text-center font-medium">No recent citizen inquiries found.</p>
          ) : (
            recentInquiries.map((inq) => (
              <div key={inq.id ?? `${inq.email ?? 'inquiry'}-${inq.createdAt ?? ''}`} class="p-3.5 border border-slate-200/80 rounded-lg bg-slate-50/50 hover:bg-slate-50 transition-colors flex flex-col gap-1.5">
                <div class="flex justify-between items-start gap-2">
                  <span class="text-xs font-bold text-[#0B4F9C]">{inq.name}</span>
                  <span class="text-[10px] text-slate-500 font-semibold bg-white px-2 py-0.5 rounded border border-slate-200">
                    {toDateOrNull(inq.createdAt)?.toLocaleDateString('en-IN', { dateStyle: 'short' }) ?? ''}
                  </span>
                </div>
                <p class="text-[11px] text-slate-500 font-medium">{inq.email}</p>
                <p class="text-xs text-slate-600 leading-relaxed font-normal mt-0.5 border-t border-slate-200/60 pt-1.5 line-clamp-2">
                  {inq.message}
                </p>
              </div>
            ))
          )}
        </div>
      </div>

      <!-- Recent System Activities -->
      <div class="bg-white border border-slate-200/90 rounded-xl shadow-xs p-6 flex flex-col gap-4">
        <div class="flex items-center justify-between border-b border-slate-100 pb-3">
          <h3 class="text-xs font-bold text-slate-700 uppercase tracking-wider flex items-center gap-2">
            <Icon name="scroll-text" size={14} class="text-[#0B4F9C]" /> Recent System Activities
          </h3>
          <a href="/admin/audit-logs" class="text-xs text-[#0B4F9C] font-bold hover:underline inline-flex items-center gap-1">
            All Logs <Icon name="arrow-right" size={11} />
          </a>
        </div>

        <div class="flex flex-col gap-3">
          {recentLogs.length === 0 ? (
            <p class="text-xs text-slate-400 italic py-8 text-center font-medium">No administrative activity logged yet.</p>
          ) : (
            recentLogs.map((log) => (
              <div key={log.id ?? `${log.action ?? 'log'}-${log.createdAt ?? ''}`} class="p-3.5 border border-slate-200/80 rounded-lg bg-slate-50/50 hover:bg-slate-50 transition-colors flex gap-3.5 items-center">
                <div class="w-8 h-8 rounded-lg bg-slate-100 border border-slate-200 text-[#0B4F9C] flex items-center justify-center shrink-0">
                  <Icon name="scroll-text" size={15} />
                </div>
                <div class="flex flex-col flex-1 gap-0.5">
                  <div class="flex justify-between items-start gap-2">
                    <span class="text-xs font-bold text-slate-800 tracking-wide uppercase">{log.action}</span>
                    <span class="text-[10px] text-slate-500 font-semibold bg-white px-2 py-0.5 rounded border border-slate-200">
                      {toDateOrNull(log.createdAt)?.toLocaleTimeString('en-IN', { hour: '2-digit', minute: '2-digit' }) ?? ''}
                    </span>
                  </div>
                  <span class="text-[11px] font-medium text-slate-500">IP: {log.ipAddress}</span>
                  {log.details !== undefined && log.details !== null && (
                    <span class="text-[11px] text-slate-500 italic mt-0.5 line-clamp-1 border-t border-slate-200/60 pt-1">
                      {typeof log.details === 'string' ? log.details : JSON.stringify(log.details)}
                    </span>
                  )}
                </div>
              </div>
            ))
          )}
        </div>
      </div>

    </div>

  </div>
</AdminLayout>
