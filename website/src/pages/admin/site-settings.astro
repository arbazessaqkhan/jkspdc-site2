---
import AdminLayout from '../../layouts/AdminLayout.astro';
import Icon from '../../components/Icon.astro';

let settings: any[] = [];
let errorMessage = '';
const sessionToken = Astro.cookies.get('admin_session')?.value || '';

try {
  const res = await fetch('http://localhost:3000/api/site-settings');
  if (res.ok) settings = await res.json();
} catch (e) {
  errorMessage = 'Could not load site settings.';
}

// Build settings map with defaults
const defaultSettings = [
  { key: 'site_name', label: 'Site Name', group: 'General', defaultValue: 'JKSPDC', type: 'text' },
  { key: 'site_tagline', label: 'Site Tagline', group: 'General', defaultValue: 'Jammu & Kashmir State Power Development Corporation', type: 'text' },
  { key: 'footer_text', label: 'Footer Text', group: 'General', defaultValue: '© 2025 JKSPDCL. All Rights Reserved.', type: 'text' },
  { key: 'contact_phone', label: 'Phone Number', group: 'Contact Info', defaultValue: '+91-194-2506126', type: 'text' },
  { key: 'contact_email', label: 'Email Address', group: 'Contact Info', defaultValue: 'md.jkspdc@gmail.com', type: 'text' },
  { key: 'contact_address', label: 'Office Address', group: 'Contact Info', defaultValue: 'Corporate Headquarters, Bemina, Srinagar, J&K - 190018', type: 'textarea' },
  { key: 'contact_fax', label: 'Fax Number', group: 'Contact Info', defaultValue: '+91-194-2506129', type: 'text' },
  { key: 'social_twitter', label: 'Twitter/X URL', group: 'Social Media', defaultValue: '', type: 'url' },
  { key: 'social_facebook', label: 'Facebook URL', group: 'Social Media', defaultValue: '', type: 'url' },
  { key: 'social_youtube', label: 'YouTube URL', group: 'Social Media', defaultValue: '', type: 'url' },
  { key: 'social_instagram', label: 'Instagram URL', group: 'Social Media', defaultValue: '', type: 'url' },
  { key: 'ticker_text', label: 'Scrolling Ticker Text', group: 'Homepage', defaultValue: 'Welcome to JKSPDC Official Portal', type: 'textarea' },
  { key: 'marquee_enabled', label: 'Enable Marquee/Ticker', group: 'Homepage', defaultValue: 'true', type: 'toggle' },
  { key: 'maintenance_mode', label: 'Maintenance Mode', group: 'System', defaultValue: 'false', type: 'toggle' },
  { key: 'analytics_id', label: 'Google Analytics ID', group: 'System', defaultValue: '', type: 'text' },
];

const settingsMap = new Map(settings.map((s: any) => [s.key, s.value]));
const groups = [...new Set(defaultSettings.map(s => s.group))];
---

<AdminLayout title="Site Settings" description="Global website configuration and settings" activeTab="site-settings">
  <div class="flex flex-col gap-6">
    <div class="flex items-center justify-between border-b border-slate-200 pb-5">
      <div>
        <h1 class="text-2xl font-extrabold text-slate-900 tracking-tight">Site Settings</h1>
        <p class="text-xs text-slate-600 font-medium mt-1">Configure global website settings — contact info, social links, footer text, and system preferences.</p>
      </div>
      <button id="save-all-btn" class="flex items-center gap-2 px-5 py-2.5 bg-blue-600 text-white text-xs font-bold rounded-lg hover:bg-blue-700 shadow-md transition-colors cursor-pointer">
        <Icon name="check" size={14} /> Save All Settings
      </button>
    </div>

    {errorMessage && (
      <div class="p-4 bg-amber-50 border-l-4 border-amber-500 rounded text-xs text-amber-800 font-semibold" role="alert">
        <Icon name="info" size={14} class="inline text-amber-600 mr-1" /> {errorMessage}
      </div>
    )}

    <!-- Settings Groups -->
    <div class="flex flex-col gap-6">
      {groups.map((group) => (
        <div class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden">
          <div class="px-6 py-3.5 bg-slate-50 border-b border-slate-200 flex items-center gap-2">
            <Icon name="settings" size={14} class="text-blue-600" />
            <h3 class="text-xs font-bold text-slate-700 uppercase tracking-wider">{group}</h3>
          </div>
          <div class="p-6 flex flex-col gap-5">
            {defaultSettings.filter(s => s.group === group).map((setting) => {
              const currentValue = settingsMap.get(setting.key) ?? setting.defaultValue;
              return (
                <div class="flex flex-col gap-1.5">
                  <label class="text-[11px] font-bold text-slate-600 uppercase tracking-wider">{setting.label}</label>
                  {setting.type === 'textarea' ? (
                    <textarea class="setting-input w-full px-4 py-2.5 border border-slate-300 rounded-lg text-sm focus:ring-2 focus:ring-blue-500 focus:outline-none resize-y" rows="3" data-key={setting.key}>{currentValue}</textarea>
                  ) : setting.type === 'toggle' ? (
                    <div class="flex items-center gap-3">
                      <label class="relative inline-flex items-center cursor-pointer">
                        <input type="checkbox" class="setting-toggle sr-only peer" data-key={setting.key} checked={currentValue === 'true'} />
                        <div class="w-11 h-6 bg-slate-200 peer-focus:ring-4 peer-focus:ring-blue-100 rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-slate-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-blue-600"></div>
                      </label>
                      <span class="text-xs text-slate-500">{currentValue === 'true' ? 'Enabled' : 'Disabled'}</span>
                    </div>
                  ) : (
                    <input type={setting.type === 'url' ? 'url' : 'text'} class="setting-input w-full px-4 py-2.5 border border-slate-300 rounded-lg text-sm focus:ring-2 focus:ring-blue-500 focus:outline-none" value={currentValue} data-key={setting.key} />
                  )}
                </div>
              );
            })}
          </div>
        </div>
      ))}
    </div>
  </div>
</AdminLayout>

<script is:inline>
(function() {
  function getToken() { var m = document.cookie.match(/admin_session=([^;]+)/); return m ? m[1] : ''; }

  document.getElementById('save-all-btn').addEventListener('click', function() {
    var token = getToken();
    if (!token) { alert('Not authenticated.'); return; }

    var promises = [];

    // Collect all text/textarea inputs
    document.querySelectorAll('.setting-input').forEach(function(input) {
      var key = input.dataset.key;
      var value = input.value;
      promises.push(
        fetch('http://localhost:3000/api/site-settings/' + key, {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json', Authorization: 'Bearer ' + token },
          body: JSON.stringify({ value: value }),
        })
      );
    });

    // Collect all toggle inputs
    document.querySelectorAll('.setting-toggle').forEach(function(input) {
      var key = input.dataset.key;
      var value = input.checked ? 'true' : 'false';
      promises.push(
        fetch('http://localhost:3000/api/site-settings/' + key, {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json', Authorization: 'Bearer ' + token },
          body: JSON.stringify({ value: value }),
        })
      );
    });

    Promise.all(promises)
      .then(function(results) {
        var allOk = results.every(function(r) { return r.ok; });
        if (allOk) {
          alert('All settings saved successfully!');
          window.location.reload();
        } else {
          alert('Some settings failed to save. Please try again.');
        }
      })
      .catch(function() { alert('Network error. Please try again.'); });
  });
})();
</script>
