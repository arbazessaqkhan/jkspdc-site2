---
import AdminLayout from '../../layouts/AdminLayout.astro';
import Icon from '../../components/Icon.astro';
import { isAdmin } from '../../utils/roles';
import { parseApiError, BACKEND_URL } from '../../utils/api-error';

let settings: any[] = [];
let errorMessage = '';
const sessionToken = Astro.cookies.get('admin_session')?.value;
if (!sessionToken) {
  return Astro.redirect('/admin/login');
}

// Role protection: Site Settings is ADMIN-only
const userRole = Astro.locals.user?.role;
if (!isAdmin(userRole)) {
  return Astro.redirect('/admin/dashboard');
}

try {
  const res = await fetch(`${BACKEND_URL}/api/site-settings`);
  if (res.ok) {
    settings = await res.json();
  } else {
    const apiErr = await parseApiError(res, 'load site settings');
    if (apiErr.isUnauthorized) {
      return Astro.redirect('/admin/login');
    }
    errorMessage = apiErr.message;
  }
} catch (e) {
  console.error('Error fetching site settings:', e);
  errorMessage = 'Failed to load site settings. Unable to communicate with the server.';
}

// Build settings map with defaults
const defaultSettings = [
  { key: 'site_name', label: 'Site Name', group: 'General', defaultValue: 'JKSPDC', type: 'text' },
  { key: 'site_tagline', label: 'Site Tagline', group: 'General', defaultValue: 'Jammu & Kashmir State Power Development Corporation', type: 'text' },
  { key: 'footer_text', label: 'Footer Text', group: 'General', defaultValue: '© 2025 JKSPDCL. All Rights Reserved.', type: 'text' },
  { key: 'contact_phone', label: 'Phone Number', group: 'Contact Info', defaultValue: '+91-194-2506126', type: 'text' },
  { key: 'contact_email', label: 'Email Address', group: 'Contact Info', defaultValue: 'md-jkspdcl[at]jk[dot]gov[dot]in', type: 'text' },
  { key: 'contact_address', label: 'Office Address', group: 'Contact Info', defaultValue: 'Corporate Headquarters, Bemina, Srinagar, J&K - 190018', type: 'textarea' },
  { key: 'contact_fax', label: 'Fax Number', group: 'Contact Info', defaultValue: '+91-194-2506129', type: 'text' },
  { key: 'social_twitter', label: 'Twitter/X URL', group: 'Social Media', defaultValue: '', type: 'url' },
  { key: 'social_facebook', label: 'Facebook URL', group: 'Social Media', defaultValue: '', type: 'url' },
  { key: 'social_youtube', label: 'YouTube URL', group: 'Social Media', defaultValue: '', type: 'url' },
  { key: 'social_instagram', label: 'Instagram URL', group: 'Social Media', defaultValue: '', type: 'url' },
  { key: 'ticker_text', label: 'Scrolling Ticker Text', group: 'Homepage', defaultValue: 'Welcome to JKSPDC Official Portal', type: 'textarea' },
  { key: 'marquee_enabled', label: 'Enable Marquee/Ticker', group: 'Homepage', defaultValue: 'true', type: 'toggle' },
  { key: 'maintenance_mode', label: 'Maintenance Mode', group: 'System', defaultValue: 'false', type: 'toggle' },
  { key: 'analytics_id', label: 'Google Analytics ID', group: 'System', defaultValue: '', type: 'text' },
];

const settingsMap = new Map(settings.map((s: any) => [s.key, s.value]));
const groups = [...new Set(defaultSettings.map(s => s.group))];
---

<AdminLayout title="Site Settings" description="Global website configuration and settings" activeTab="site-settings">
  <div class="flex flex-col gap-6">
    <!-- Page Header -->
    <div class="admin-page-header">
      <div>
        <h1 class="admin-page-title">Site Settings &amp; Preferences</h1>
        <p class="admin-page-subtitle">Configure global portal parameters — corporate contact details, social links, footer notices, and system flags.</p>
      </div>
      <button id="save-all-btn" class="admin-btn admin-btn-primary flex items-center gap-2 self-start sm:self-auto cursor-pointer">
        <Icon name="check" size={14} /> Save All Settings
      </button>
    </div>

    {errorMessage && (
      <div class="p-3 bg-red-50 border border-red-200 text-xs font-semibold text-red-700 rounded flex items-center gap-2" role="alert">
        <Icon name="info" size={14} class="text-red-600 shrink-0" /> {errorMessage}
      </div>
    )}

    <!-- Settings Groups -->
    <div class="flex flex-col gap-6">
      {groups.map((group) => (
        <div class="bg-white rounded-lg border border-slate-200 shadow-xs overflow-hidden">
          <div class="px-5 py-3 bg-slate-50/80 border-b border-slate-200 flex items-center gap-2">
            <Icon name="settings" size={14} class="text-[#0B4F9C]" />
            <h2 class="text-xs font-bold text-slate-800 uppercase tracking-wider">{group}</h2>
          </div>
          <div class="p-5 flex flex-col gap-4">
            {defaultSettings.filter(s => s.group === group).map((setting) => {
              const currentValue = settingsMap.get(setting.key) ?? setting.defaultValue;
              return (
                <div class="flex flex-col gap-1">
                  <label class="text-xs font-semibold text-slate-700">{setting.label}</label>
                  {setting.type === 'textarea' ? (
                    <textarea class="setting-input w-full px-3 py-2 border border-slate-300 rounded text-xs text-slate-800 focus:ring-1 focus:ring-[#0B4F9C] focus:border-[#0B4F9C] focus:outline-none resize-y" rows="3" data-key={setting.key}>{currentValue}</textarea>
                  ) : setting.type === 'toggle' ? (
                    <div class="flex items-center gap-3 mt-1">
                      <label class="relative inline-flex items-center cursor-pointer">
                        <input type="checkbox" class="setting-toggle sr-only peer" data-key={setting.key} checked={currentValue === 'true'} />
                        <div class="w-10 h-5 bg-slate-300 peer-focus:ring-2 peer-focus:ring-[#0B4F9C]/30 rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-slate-300 after:border after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:bg-[#0B4F9C]"></div>
                      </label>
                      <span class="text-xs text-slate-600 font-medium">{currentValue === 'true' ? 'Enabled' : 'Disabled'}</span>
                    </div>
                  ) : (
                    <input type={setting.type === 'url' ? 'url' : 'text'} class="setting-input w-full px-3 py-2 border border-slate-300 rounded text-xs text-slate-800 focus:ring-1 focus:ring-[#0B4F9C] focus:border-[#0B4F9C] focus:outline-none" value={currentValue} data-key={setting.key} />
                  )}
                </div>
              );
            })}
          </div>
        </div>
      ))}
    </div>
  </div>
</AdminLayout>

<script is:inline define:vars={{ backendUrl: BACKEND_URL }}>
(function() {
  function getToken() { var m = document.cookie.match(/admin_session=([^;]+)/); return m ? m[1] : ''; }

  document.getElementById('save-all-btn').addEventListener('click', function() {
    var token = getToken();
    if (!token) { alert('Not authenticated.'); return; }

    var promises = [];

    // Collect all text/textarea inputs
    document.querySelectorAll('.setting-input').forEach(function(input) {
      var key = input.dataset.key;
      var value = input.value;
      promises.push(
        fetch((backendUrl || '') + '/api/site-settings/' + key, {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json', Authorization: 'Bearer ' + token },
          body: JSON.stringify({ value: value }),
        })
      );
    });

    // Collect all toggle inputs
    document.querySelectorAll('.setting-toggle').forEach(function(input) {
      var key = input.dataset.key;
      var value = input.checked ? 'true' : 'false';
      promises.push(
        fetch((backendUrl || '') + '/api/site-settings/' + key, {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json', Authorization: 'Bearer ' + token },
          body: JSON.stringify({ value: value }),
        })
      );
    });

    Promise.all(promises)
      .then(async function(results) {
        var unauth = results.find(function(r) { return r.status === 401; });
        if (unauth) {
          window.location.href = '/admin/login';
          return;
        }
        var forbidden = results.find(function(r) { return r.status === 403; });
        if (forbidden) {
          alert('Access Denied: You do not have permission to modify site settings.');
          return;
        }
        var allOk = results.every(function(r) { return r.ok; });
        if (allOk) {
          alert('All settings saved successfully!');
          window.location.reload();
        } else {
          var firstFail = results.find(function(r) { return !r.ok; });
          if (firstFail && firstFail.status >= 500) {
            alert('A server error occurred while trying to save site settings. Please try again later.');
          } else {
            var errData = firstFail ? await firstFail.json().catch(function() { return {}; }) : {};
            alert(errData.message || 'Failed to save some site settings.');
          }
        }
      })
      .catch(function() { alert('Network error. Unable to communicate with backend server.'); });
  });
})();
</script>
