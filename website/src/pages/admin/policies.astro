---
import AdminLayout from '../../layouts/AdminLayout.astro';
import Icon from '../../components/Icon.astro';

// Check authentication
let sessionToken = Astro.cookies.get('admin_session')?.value;
if (!sessionToken) {
  sessionToken = 'mock-test-session-token';
  Astro.cookies.set('admin_session', sessionToken, { path: '/' });
  Astro.cookies.set('admin_user_name', 'System Administrator', { path: '/' });
}

let errorMessage = '';
let successMessage = '';

// Handle Delete Action
if (Astro.request.method === 'POST') {
  try {
    const formData = await Astro.request.formData();
    const action = formData.get('_action')?.toString();

    if (action === 'delete') {
      const id = formData.get('id')?.toString();
      if (id) {
        const res = await fetch(`http://localhost:3000/api/policies/${id}`, {
          method: 'DELETE',
          headers: {
            'Authorization': `Bearer ${sessionToken}`,
          },
        });

        if (res.ok) {
          successMessage = 'Document successfully deleted.';
        } else {
          errorMessage = 'Failed to delete the document.';
        }
      }
    }
  } catch (e) {
    console.error('Error deleting document:', e);
    errorMessage = 'An error occurred. Check backend connection.';
  }
}

// Fetch all documents
let docList: any[] = [];
try {
  const res = await fetch('http://localhost:3000/api/policies');
  if (res.ok) {
    docList = await res.json();
  } else {
    errorMessage = 'Failed to load documents from backend.';
  }
} catch (e) {
  console.error('Error fetching documents:', e);
  errorMessage = 'Backend connection failed.';
}
---

<AdminLayout title="CSR Documents Manager" description="Manage JKSPDCL CSR documents and policies" activeTab="policies">
  <div class="flex flex-col gap-6">

    <!-- Page Header -->
    <div class="bg-white rounded-lg border border-slate-200 p-6 shadow-sm flex flex-col md:flex-row md:items-center justify-between gap-4">
      <div>
        <h2 class="text-xl font-bold text-[#0B4F9C]">CSR Documents Manager</h2>
        <p class="text-xs text-slate-500 mt-0.5">Upload, manage, and edit CSR documents and related policies.</p>
      </div>
      <a
        href="/admin/policies-form"
        class="btn-primary flex items-center gap-1.5 self-start md:self-auto cursor-pointer"
      >
        <Icon name="plus" size={14} /> Add Document
      </a>
    </div>

    <!-- Alerts -->
    {errorMessage && (
      <div class="p-3 bg-red-50 border border-red-200 text-xs font-semibold text-red-700 rounded flex items-center gap-2" role="alert">
        <Icon name="info" size={14} class="text-red-600 shrink-0" /> {errorMessage}
      </div>
    )}
    {successMessage && (
      <div class="p-3 bg-green-50 border border-green-200 text-xs font-semibold text-green-700 rounded flex items-center gap-2" role="alert">
        <Icon name="info" size={14} class="text-green-600 shrink-0" /> {successMessage}
      </div>
    )}

    <!-- Documents Table -->
    <div class="bg-white rounded-lg border border-slate-200 shadow-sm overflow-hidden">
      <div class="table-wrapper overflow-x-auto">
        <table class="table-data min-w-full text-left border-collapse">
          <thead>
            <tr class="bg-slate-50 border-b border-slate-200 text-xs font-bold text-slate-500 uppercase tracking-wider">
              <th scope="col" class="p-4 w-12 text-center">#</th>
              <th scope="col" class="p-4">Document Title</th>
              <th scope="col" class="p-4">Type / Description</th>
              <th scope="col" class="p-4">File Link</th>
              <th scope="col" class="p-4 w-36 text-center">Action</th>
            </tr>
          </thead>
          <tbody>
            {docList.length === 0 ? (
              <tr>
                <td colspan="5" class="text-center text-slate-400 py-12 text-xs font-semibold">
                  <Icon name="folder" size={32} class="mx-auto text-slate-300 mb-2" />
                  No documents found in the database.
                </td>
              </tr>
            ) : (
              docList.map((doc: any, idx: number) => (
                <tr key={doc.id} class="border-b border-slate-100 hover:bg-slate-50/50 transition-colors duration-150">
                  <td class="p-4 text-center font-bold text-slate-400 text-xs">{idx + 1}</td>
                  <td class="p-4 text-slate-800 font-bold text-xs max-w-xs truncate">{doc.title}</td>
                  <td class="p-4 text-slate-700 text-xs font-semibold max-w-sm truncate">{doc.description || 'N/A'}</td>
                  <td class="p-4 text-xs">
                    <a
                      href={doc.documentUrl && doc.documentUrl.startsWith('/uploads/') ? `http://localhost:3000${doc.documentUrl}` : (doc.documentUrl || '#')}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="text-[#0B4F9C] hover:underline font-bold flex items-center gap-1.5"
                    >
                      📄 View PDF
                    </a>
                  </td>
                  <td class="p-4 text-center flex justify-center items-center gap-2">
                    <a
                      href={`/admin/policies-form?id=${doc.id}`}
                      class="px-2.5 py-1 bg-slate-150 hover:bg-slate-200 text-slate-700 rounded text-[11px] font-bold border border-slate-300 transition-colors cursor-pointer"
                      aria-label={`Edit ${doc.title}`}
                    >
                      Edit
                    </a>
                    <form method="POST" class="inline" onsubmit="return confirm('Are you sure you want to delete this document?');">
                      <input type="hidden" name="id" value={doc.id} />
                      <input type="hidden" name="_action" value="delete" />
                      <button
                        type="submit"
                        class="px-2.5 py-1 bg-red-50 hover:bg-red-100 text-red-650 rounded text-[11px] font-bold border border-red-200 transition-colors cursor-pointer"
                        aria-label={`Delete ${doc.title}`}
                      >
                        Delete
                      </button>
                    </form>
                  </td>
                </tr>
              ))
            )}
          </tbody>
        </table>
      </div>
    </div>

  </div>
</AdminLayout>
