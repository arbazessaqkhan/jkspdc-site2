---
import AdminLayout from '../../layouts/AdminLayout.astro';
import Icon from '../../components/Icon.astro';

// Check authentication
let sessionToken = Astro.cookies.get('admin_session')?.value;
if (!sessionToken) {
  sessionToken = 'mock-test-session-token';
  Astro.cookies.set('admin_session', sessionToken, { path: '/' });
  Astro.cookies.set('admin_user_name', 'System Administrator', { path: '/' });
}

let errorMessage = '';
let successMessage = '';

// Handle Delete Action
if (Astro.request.method === 'POST') {
  try {
    const formData = await Astro.request.formData();
    const action = formData.get('_action')?.toString();

    if (action === 'delete') {
      const id = formData.get('id')?.toString();
      if (id) {
        const res = await fetch(`http://localhost:3000/api/policies/${id}`, {
          method: 'DELETE',
          headers: {
            'Authorization': `Bearer ${sessionToken}`,
          },
        });

        if (res.ok) {
          successMessage = 'Document successfully deleted.';
        } else {
          errorMessage = 'Failed to delete the document.';
        }
      }
    }
  } catch (e) {
    console.error('Error deleting document:', e);
    errorMessage = 'An error occurred. Check backend connection.';
  }
}

// Fetch all documents
let docList: any[] = [];
try {
  const res = await fetch('http://localhost:3000/api/policies');
  if (res.ok) {
    docList = await res.json();
  } else {
    errorMessage = 'Failed to load documents from backend.';
  }
} catch (e) {
  console.error('Error fetching documents:', e);
  errorMessage = 'Backend connection failed.';
}
---

<AdminLayout title="CSR Documents Manager" description="Manage JKSPDCL CSR documents and policies" activeTab="policies">
  <div class="flex flex-col gap-6">

    <!-- Page Header -->
    <div class="admin-page-header">
      <div>
        <h1 class="admin-page-title">CSR Documents &amp; Policies</h1>
        <p class="admin-page-subtitle">Upload, manage, and edit CSR policy records and related documents.</p>
      </div>
      <a
        href="/admin/policies-form"
        class="admin-btn admin-btn-primary flex items-center gap-1.5 self-start sm:self-auto cursor-pointer"
      >
        <Icon name="plus" size={14} /> Add Document
      </a>
    </div>

    <!-- Alerts -->
    {errorMessage && (
      <div class="p-3 bg-red-50 border border-red-200 text-xs font-semibold text-red-700 rounded flex items-center gap-2" role="alert">
        <Icon name="info" size={14} class="text-red-600 shrink-0" /> {errorMessage}
      </div>
    )}
    {successMessage && (
      <div class="p-3 bg-green-50 border border-green-200 text-xs font-semibold text-green-700 rounded flex items-center gap-2" role="alert">
        <Icon name="info" size={14} class="text-green-600 shrink-0" /> {successMessage}
      </div>
    )}

    <!-- Administrative Data Table -->
    <div class="admin-table-container">
      <table class="admin-table">
        <thead>
          <tr>
            <th scope="col" class="w-12 text-center">#</th>
            <th scope="col" class="min-w-[260px]">Document Title</th>
            <th scope="col" class="min-w-[240px]">Type / Description</th>
            <th scope="col" class="w-24 text-center">File</th>
            <th scope="col" class="w-28 text-center sticky-col-right">Action</th>
          </tr>
        </thead>
        <tbody>
          {docList.length === 0 ? (
            <tr>
              <td colspan="5" class="text-center text-slate-500 py-12 text-xs font-semibold italic">
                <Icon name="folder" size={32} class="mx-auto text-slate-300 mb-2" />
                No documents found in the database.
              </td>
            </tr>
          ) : (
            docList.map((doc: any, idx: number) => (
              <tr key={doc.id} class="transition-colors">
                <td class="text-center font-bold text-slate-400 text-xs">{idx + 1}</td>
                <td class="text-slate-900 font-bold text-xs leading-snug">{doc.title}</td>
                <td class="text-slate-600 text-xs font-normal leading-relaxed">{doc.description || '—'}</td>
                <td class="text-center whitespace-nowrap">
                  <a
                    href={doc.documentUrl && doc.documentUrl.startsWith('/uploads/') ? `http://localhost:3000${doc.documentUrl}` : (doc.documentUrl || '#')}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="admin-btn-action action-download inline-flex"
                    aria-label={`View PDF for ${doc.title}`}
                    title="View PDF"
                  >
                    <Icon name="file-text" size={13} />
                  </a>
                </td>
                <td class="td-actions sticky-col-right text-center">
                  <div class="admin-action-group justify-center">
                    <a
                      href={`/admin/policies-form?id=${doc.id}`}
                      class="admin-btn-action"
                      aria-label={`Edit ${doc.title}`}
                      title="Edit Document"
                    >
                      <Icon name="pencil" size={13} />
                    </a>
                    <form method="POST" class="inline m-0 p-0" onsubmit="return confirm('Are you sure you want to delete this document?');">
                      <input type="hidden" name="id" value={doc.id} />
                      <input type="hidden" name="_action" value="delete" />
                      <button
                        type="submit"
                        class="admin-btn-action action-delete"
                        aria-label={`Delete ${doc.title}`}
                        title="Delete Document"
                      >
                        <Icon name="trash-2" size={13} />
                      </button>
                    </form>
                  </div>
                </td>
              </tr>
            ))
          )}
        </tbody>
      </table>
    </div>

  </div>
</AdminLayout>
