---
import AdminLayout from '../../layouts/AdminLayout.astro';
import Icon from '../../components/Icon.astro';
import FileUploader from '../../components/admin/FileUploader.astro';
import { isAdmin } from '../../utils/roles';
import { parseApiError, BACKEND_URL } from '../../utils/api-error';

// Check authentication
const sessionToken = Astro.cookies.get('admin_session')?.value;
if (!sessionToken) {
  return Astro.redirect('/admin/login');
}

// Tenders mutation is ADMIN ONLY
const userRole = Astro.locals.user?.role;
if (!isAdmin(userRole)) {
  return Astro.redirect('/admin/tenders');
}

let errorMessage = '';
const editId = Astro.url.searchParams.get('id')?.toString();

// Fetch live projects from backend database
let databaseProjects: any[] = [];
try {
  const pRes = await fetch(`${BACKEND_URL}/api/projects`);
  if (pRes.ok) {
    databaseProjects = await pRes.json();
  }
} catch (e) {
  console.error('Error fetching projects from database for tenders form:', e);
}

// Group projects from database by status
const operationalDbProjects = databaseProjects
  .filter((p: any) => (p.status || '').toLowerCase() === 'operational')
  .map((p: any) => ({
    name: p.name,
    label: `${p.name}${p.capacityMw ? ` (${p.capacityMw} MW)` : ''}${p.location ? ` - ${p.location}` : ''}`,
  }));

const upcomingDbProjects = databaseProjects
  .filter((p: any) => (p.status || '').toLowerCase() !== 'operational')
  .map((p: any) => ({
    name: p.name,
    label: `${p.name}${p.capacityMw ? ` (${p.capacityMw} MW - ${p.status || 'Project'})` : ''}${p.location ? ` - ${p.location}` : ''}`,
  }));

const projectCategories = [
  {
    category: 'Headquarters & Corporate Offices',
    items: [
      { name: 'HQ Srinagar', label: 'HQ Srinagar' },
      { name: 'HQ Jammu', label: 'HQ Jammu' },
    ]
  },
  ...(operationalDbProjects.length > 0 ? [{
    category: 'Operational Projects (Database)',
    items: operationalDbProjects
  }] : []),
  ...(upcomingDbProjects.length > 0 ? [{
    category: 'Upcoming / Other Projects (Database)',
    items: upcomingDbProjects
  }] : [])
];

const allLocationOptions = Array.from(new Set([
  'HQ Srinagar',
  'HQ Jammu',
  'HQ_SRINAGAR',
  'HQ_JAMMU',
  ...databaseProjects.map((p: any) => p.name),
  ...operationalDbProjects.map((p: any) => p.name),
  ...upcomingDbProjects.map((p: any) => p.name),
  ...operationalDbProjects.map((p: any) => p.label),
  ...upcomingDbProjects.map((p: any) => p.label),
]));

let tenderData = {
  id: '',
  referenceNo: '',
  title: '',
  description: '',
  documentType: 'NIT',
  workCategory: 'Civil',
  locationTag: 'HQ_SRINAGAR',
  closingDate: '',
  bidOpeningDate: '',
  documentUrl: '',
  fileSizeBytes: '',
  status: 'Active',
  corrigendums: [] as any[],
};

// Fetch data if editing
if (editId) {
  try {
    const res = await fetch(`${BACKEND_URL}/api/tenders/${editId}`);
    if (res.ok) {
      const data = await res.json();
      tenderData = {
        id: data.id || '',
        referenceNo: data.referenceNo || '',
        title: data.title || '',
        description: data.description || '',
        documentType: data.documentType || 'NIT',
        workCategory: data.workCategory || 'Civil',
        locationTag: data.locationTag || 'HQ_SRINAGAR',
        closingDate: data.closingDate ? data.closingDate.substring(0, 10) : '',
        bidOpeningDate: data.bidOpeningDate ? data.bidOpeningDate.substring(0, 10) : '',
        documentUrl: data.documentUrl || '',
        fileSizeBytes: data.fileSizeBytes !== null ? data.fileSizeBytes.toString() : '',
        status: data.status || 'Active',
        corrigendums: data.corrigendums || [],
      };
    } else {
      const apiErr = await parseApiError(res, 'load tender details');
      if (apiErr.isUnauthorized) {
        return Astro.redirect('/admin/login');
      }
      errorMessage = apiErr.message;
    }
  } catch (e) {
    console.error('Error fetching tender details:', e);
    errorMessage = 'Network failure: Unable to reach backend server.';
  }
}

// Handle Form Submit
if (Astro.request.method === 'POST') {
  try {
    const formData = await Astro.request.formData();
    const id = formData.get('id')?.toString();
    const referenceNo = formData.get('referenceNo')?.toString();
    const title = formData.get('title')?.toString();
    const description = formData.get('description')?.toString();
    const documentType = formData.get('documentType')?.toString();
    const workCategory = formData.get('workCategory')?.toString();
    const locationTag = formData.get('locationTag')?.toString();
    const closingDate = formData.get('closingDate')?.toString();
    const bidOpeningDate = formData.get('bidOpeningDate')?.toString();
    const documentUrl = formData.get('documentUrl')?.toString();
    const fileSizeBytes = formData.get('fileSizeBytes')?.toString();
    const status = formData.get('status')?.toString();
    const corrigendumsRaw = formData.get('corrigendums')?.toString() || '[]';
    let corrigendums = [];
    try {
      corrigendums = JSON.parse(corrigendumsRaw);
    } catch (e) {
      console.error('Failed to parse corrigendums:', e);
    }

    // Preserve values
    tenderData = {
      id: id || '',
      referenceNo: referenceNo || '',
      title: title || '',
      description: description || '',
      documentType: documentType || 'NIT',
      workCategory: workCategory || 'Civil',
      locationTag: locationTag || 'HQ_SRINAGAR',
      closingDate: closingDate || '',
      bidOpeningDate: bidOpeningDate || '',
      documentUrl: documentUrl || '',
      fileSizeBytes: fileSizeBytes || '',
      status: status || 'Active',
      corrigendums,
    };

    if (!referenceNo || !title || !documentUrl) {
      errorMessage = 'Reference No, Title, and Document URL are required.';
    } else {
      const body = {
        referenceNo,
        title,
        description: description || null,
        documentType: documentType || 'NIT',
        workCategory: workCategory || 'Civil',
        locationTag: locationTag || 'HQ_SRINAGAR',
        closingDate: closingDate ? new Date(closingDate).toISOString() : null,
        bidOpeningDate: bidOpeningDate ? new Date(bidOpeningDate).toISOString() : null,
        documentUrl,
        fileSizeBytes: fileSizeBytes ? parseInt(fileSizeBytes, 10) : 0,
        status,
        corrigendums,
      };

      const url = id 
        ? `${BACKEND_URL}/api/tenders/${id}` 
        : `${BACKEND_URL}/api/tenders`;
      const method = id ? 'PUT' : 'POST';

      const res = await fetch(url, {
        method,
        headers: {
          'Content-Type': 'application/json',
          'Authorization': `Bearer ${sessionToken}`,
        },
        body: JSON.stringify(body),
      });

      if (res.ok) {
        return Astro.redirect('/admin/tenders');
      } else {
        const apiErr = await parseApiError(res, id ? 'update tender posting' : 'publish tender posting');
        if (apiErr.isUnauthorized) {
          return Astro.redirect('/admin/login');
        }
        errorMessage = apiErr.message;
      }
    }
  } catch (error) {
    console.error('Error saving tender:', error);
    errorMessage = 'Network failure: Unable to communicate with backend service.';
  }
}
---

<AdminLayout title={editId ? "Edit Tender" : "Publish Tender"} description="Manage JKSPDCL Tenders" activeTab="tenders">
  <div class="flex flex-col gap-6">
    
    <!-- Top breadcrumbs and back link -->
    <div class="admin-page-header">
      <div>
        <h1 class="admin-page-title">
          {editId ? 'Modify Tender Posting' : 'Register Tender Posting'}
        </h1>
        <p class="admin-page-subtitle">Configure tender specifications, deadlines, documents, and corrigendum attachments.</p>
      </div>
      <a href="/admin/tenders" class="admin-btn admin-btn-secondary">
        &larr; Back to Tenders
      </a>
    </div>

    <!-- Error notice -->
    {errorMessage && (
      <div class="p-3 bg-red-50 border border-red-200 text-xs font-semibold text-red-700 rounded flex items-center gap-2" role="alert">
        <Icon name="info" size={14} class="text-red-600 shrink-0" /> {errorMessage}
      </div>
    )}

    <!-- Form -->
    <form method="POST" class="bg-white rounded-lg border border-slate-200 shadow-sm p-6 lg:p-8 flex flex-col gap-6">
      <input type="hidden" name="id" value={tenderData.id} />

      <!-- Section: Specifications -->
      <div>
        <h3 class="text-xs font-bold text-[color:var(--adm-primary)] uppercase tracking-wider border-b border-slate-100 pb-2 mb-4">Tender Specifications</h3>
        
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div class="form-group flex flex-col gap-1.5">
            <label for="referenceNo" class="text-xs font-bold text-slate-700">Tender Reference Number <span class="text-red-500">*</span></label>
            <input type="text" name="referenceNo" id="referenceNo" value={tenderData.referenceNo} class="form-input text-xs" required placeholder="e.g. ENIT No. 05 of 2026" />
          </div>

          <div class="form-group flex flex-col gap-1.5">
            <label for="title" class="text-xs font-bold text-slate-700">Tender Title / Subject <span class="text-red-500">*</span></label>
            <input type="text" name="title" id="title" value={tenderData.title} class="form-input text-xs" required placeholder="e.g. Renovation of Lower Jhelum Power House Canal Gates" />
          </div>

          <div class="form-group flex flex-col gap-1.5">
            <label for="documentType" class="text-xs font-bold text-slate-700">Document Type <span class="text-red-500">*</span></label>
            <select name="documentType" id="documentType" class="form-select text-xs" required>
              <option value="NIT" selected={tenderData.documentType === 'NIT'}>Notice Inviting Tender (NIT)</option>
              <option value="NIO" selected={tenderData.documentType === 'NIO'}>Notice Inviting Offers (NIO)</option>
              <option value="CONTRACT_AWARD" selected={tenderData.documentType === 'CONTRACT_AWARD'}>Award of Tender/Contract</option>
              <option value="BANNED_FIRM" selected={tenderData.documentType === 'BANNED_FIRM'}>List of Banned Firms</option>
            </select>
          </div>

          <div class="form-group flex flex-col gap-1.5">
            <label for="workCategory" class="text-xs font-bold text-slate-700">Work Category <span class="text-red-500">*</span></label>
            <select name="workCategory" id="workCategory" class="form-select text-xs" required>
              <option value="Civil" selected={tenderData.workCategory === 'Civil'}>Civil Works</option>
              <option value="Electro-Mechanical" selected={tenderData.workCategory === 'Electro-Mechanical'}>Electro-Mechanical</option>
              <option value="Hydro" selected={tenderData.workCategory === 'Hydro'}>Hydro Projects</option>
              <option value="Solar" selected={tenderData.workCategory === 'Solar'}>Solar Projects</option>
              <option value="Power Trading" selected={tenderData.workCategory === 'Power Trading'}>Power Trading</option>
              <option value="IT" selected={tenderData.workCategory === 'IT'}>IT & Telecom</option>
              <option value="Services" selected={tenderData.workCategory === 'Services'}>General Services</option>
            </select>
          </div>

          <div class="form-group flex flex-col gap-1.5">
            <div class="flex items-center justify-between">
              <label for="locationTag" class="text-xs font-bold text-slate-700">
                Geographical Location / Project <span class="text-red-500">*</span>
              </label>
              <span class="text-[10px] text-slate-400 font-semibold">Select or write manually</span>
            </div>

            <div class="space-y-1.5">
              <!-- Quick Select from Database Projects -->
              <select id="quick-location-select" class="form-select text-xs bg-slate-50 border-slate-300 font-semibold text-slate-700 hover:bg-slate-100 transition-colors cursor-pointer">
                <option value="">-- Quick Select from Database Projects ({databaseProjects.length} projects + HQ) --</option>
                {projectCategories.map((cat) => (
                  <optgroup label={cat.category}>
                    {cat.items.map((item) => (
                      <option value={item.name} selected={tenderData.locationTag === item.name}>{item.label}</option>
                    ))}
                  </optgroup>
                ))}
              </select>

              <!-- Manual Text Input with Datalist Autocomplete -->
              <div class="relative">
                <input 
                  type="text" 
                  name="locationTag" 
                  id="locationTag" 
                  value={tenderData.locationTag} 
                  list="locations-datalist" 
                  class="form-input text-xs font-medium w-full bg-white" 
                  placeholder="e.g. BHEP I, Kirthai HEP Stage-1, HQ Srinagar, or type custom location..." 
                  required 
                />
                <datalist id="locations-datalist">
                  {allLocationOptions.map((opt) => (
                    <option value={opt} />
                  ))}
                </datalist>
              </div>
            </div>
            <p class="text-[10px] text-slate-400 flex items-center gap-1.5 mt-1">
              <Icon name="lightbulb" size={12} class="text-amber-500 shrink-0" />
              <span>Choose from database projects above or type any custom project/office location manually.</span>
            </p>
          </div>

          <div class="form-group flex flex-col gap-1.5">
            <label for="closingDate" class="text-xs font-bold text-slate-700">Closing Date (Bid Submission Deadline)</label>
            <input type="date" name="closingDate" id="closingDate" value={tenderData.closingDate} class="form-input text-xs" />
          </div>

          <div class="form-group flex flex-col gap-1.5">
            <label for="bidOpeningDate" class="text-xs font-bold text-slate-700">Bid Opening Date</label>
            <input type="date" name="bidOpeningDate" id="bidOpeningDate" value={tenderData.bidOpeningDate} class="form-input text-xs" />
          </div>

          <div class="form-group flex flex-col gap-1.5">
            <label for="status" class="text-xs font-bold text-slate-700">Tender Status</label>
            <select name="status" id="status" class="form-select text-xs">
              <option value="Active" selected={tenderData.status === 'Active'}>Active (Open for Bidding)</option>
              <option value="Archived" selected={tenderData.status === 'Archived'}>Archived (Expired / Evaluated)</option>
              <option value="Cancelled" selected={tenderData.status === 'Cancelled'}>Cancelled (Annulled)</option>
            </select>
          </div>

          <div class="form-group flex flex-col gap-1.5 col-span-1 md:col-span-2">
            <FileUploader
              id="tender-doc"
              label="Tender Document Attachment"
              required
              variant="document"
              accept=".pdf,.jpg,.jpeg,.png,.doc,.docx,.xls,.xlsx"
              helpText="PDF, JPG, PNG, DOCX, XLSX (Max 20MB / 100MB if Important)"
              important
              existingUrl={tenderData.documentUrl}
            />
            {tenderData.documentUrl && (
              <div class={`p-3 bg-emerald-50 border border-emerald-200 text-xs text-emerald-800 rounded flex items-center justify-between gap-2 mt-2`}>
                <div class="flex items-center gap-2 min-w-0">
                  <Icon name="info" size={16} class="text-emerald-600 shrink-0" />
                  <span class="font-semibold truncate">
                    {tenderData.documentUrl.substring(tenderData.documentUrl.lastIndexOf('/') + 1)}
                  </span>
                  {tenderData.fileSizeBytes && (
                    <span class="text-emerald-600 shrink-0">({Math.round(parseInt(tenderData.fileSizeBytes, 10) / 1024)} KB)</span>
                  )}
                </div>
                <a href={tenderData.documentUrl} target="_blank" class="text-emerald-700 hover:text-emerald-900 underline font-bold shrink-0">
                  View File
                </a>
              </div>
            )}
            <input type="hidden" name="documentUrl" id="documentUrl" value={tenderData.documentUrl} />
            <input type="hidden" name="fileSizeBytes" id="fileSizeBytes" value={tenderData.fileSizeBytes} />
          </div>
        </div>
      </div>

      <input type="hidden" name="corrigendums" id="corrigendums-input" value={JSON.stringify(tenderData.corrigendums)} />

      <!-- Section: Corrigendums -->
      <div class="border-t border-slate-200 pt-6 mt-2">
        <div class="flex items-center justify-between border-b border-slate-100 pb-2 mb-4">
          <h3 class="text-xs font-bold text-[color:var(--adm-primary)] uppercase tracking-wider">Corrigendums &amp; Amendments</h3>
          <button type="button" id="btn-show-add-corr" class="px-2.5 py-1.5 border border-[color:var(--adm-primary)] text-[color:var(--adm-primary)] hover:bg-[color:var(--adm-primary)] hover:text-white rounded text-[11px] font-bold transition-all flex items-center gap-1.5 cursor-pointer">
            + Add Corrigendum / Amendment
          </button>
        </div>
        
        <!-- List of existing corrigendums -->
        <div id="corrigendums-list" class="space-y-3 mb-6">
          <!-- Dynamically populated by JS -->
        </div>

        <!-- Add corrigendum inline form (hidden by default) -->
        <div id="corr-add-form" class="bg-slate-50 border border-slate-200 rounded-lg p-4 space-y-4 hidden">
          <div class="flex items-center justify-between border-b border-slate-200 pb-1.5 mb-2">
            <h4 class="text-xs font-bold text-slate-700">Add New Corrigendum</h4>
            <button type="button" id="btn-cancel-add-corr" class="text-[10px] font-bold text-slate-400 hover:text-red-500 cursor-pointer">
              Cancel
            </button>
          </div>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div class="form-group flex flex-col gap-1.5 md:col-span-2">
              <label for="corr-title" class="text-xs font-bold text-slate-650">Corrigendum Title / Details</label>
              <input type="text" id="corr-title" class="form-input text-xs" placeholder="e.g. Corrigendum-I: Extension of time for submission" />
            </div>

            <div class="form-group flex flex-col gap-1.5">
              <label for="corr-extendedClosing" class="text-xs font-bold text-slate-650">Extended Closing Date (Optional)</label>
              <input type="date" id="corr-extendedClosing" class="form-input text-xs" />
            </div>

            <div class="form-group flex flex-col gap-1.5">
              <label for="corr-extendedOpening" class="text-xs font-bold text-slate-650">Extended Bid Opening Date (Optional)</label>
              <input type="date" id="corr-extendedOpening" class="form-input text-xs" />
            </div>

            <div class="form-group flex flex-col gap-1.5 md:col-span-2">
              <FileUploader
                id="corr-doc"
                label="Attach Corrigendum File"
                variant="document"
                accept=".pdf,.jpg,.jpeg,.png,.doc,.docx,.xls,.xlsx"
                helpText="PDF, JPG, PNG, DOCX, XLSX (Max 20MB / 100MB if Important)"
                important
              />
              <input type="hidden" id="corr-file-url" />
              <input type="hidden" id="corr-file-size" />
            </div>
          </div>
          <button type="button" id="btn-add-corr" class="btn-primary text-xs py-1.5 px-3 self-start cursor-pointer mt-2">
            Confirm Add
          </button>
        </div>
      </div>

      <!-- Section: Descriptions -->
      <div class="flex flex-col gap-1.5">
        <label for="description" class="text-xs font-bold text-slate-700">Detailed Description / Salient Highlights</label>
        <textarea name="description" id="description" rows="5" class="admin-input" placeholder="Add further specifications, scope of work, EM deposit, or pre-qualification details here...">{tenderData.description}</textarea>
      </div>

      <!-- Actions -->
      <div class="flex justify-end gap-3 border-t border-slate-100 pt-6 mt-2">
        <a href="/admin/tenders" class="admin-btn admin-btn-secondary">Cancel</a>
        <button type="submit" class="admin-btn admin-btn-primary cursor-pointer">
          {editId ? 'Update Tender' : 'Publish Tender'}
        </button>
      </div>
    </form>
  </div>

  <script define:vars={{ sessionToken, backendUrl: BACKEND_URL }}>
    // Quick Location Selector Sync
    const quickLocationSelect = document.getElementById('quick-location-select');
    const locationTagInput = document.getElementById('locationTag');
    if (quickLocationSelect && locationTagInput) {
      quickLocationSelect.addEventListener('change', (e) => {
        if (e.target.value) {
          locationTagInput.value = e.target.value;
          locationTagInput.focus();
        }
      });
    }

    const fileUploader = document.getElementById('tender-doc-input');
                    const documentUrlInput = document.getElementById('documentUrl');
    const fileSizeBytesInput = document.getElementById('fileSizeBytes');
    const uploadContainer = document.getElementById('tender-doc-dropzone');
    const submitBtn = document.querySelector('button[type="submit"]');
    let isUploading = false;

    // Client-side upload error banner
    let uploadErrorBanner = null;
    function showUploadError(msg) {
      if (!uploadErrorBanner) {
        uploadErrorBanner = document.createElement('div');
        uploadErrorBanner.className = 'p-3 bg-red-50 border border-red-200 text-xs font-semibold text-red-700 rounded flex items-center gap-2 mt-2';
        uploadContainer.parentNode.insertBefore(uploadErrorBanner, uploadContainer.nextSibling);
      }
      uploadErrorBanner.textContent = msg;
      uploadErrorBanner.style.display = 'flex';
    }
    function clearUploadError() {
      if (uploadErrorBanner) uploadErrorBanner.style.display = 'none';
    }

    // Prevent form submission when file not yet uploaded
    document.querySelector('form').addEventListener('submit', (e) => {
      if (isUploading) {
        e.preventDefault();
        alert('Please wait — file upload is still in progress.');
        return;
      }
      if (!documentUrlInput.value) {
        e.preventDefault();
        showUploadError('Please attach a Tender Document before publishing.');
        uploadContainer.scrollIntoView({ behavior: 'smooth', block: 'center' });
      }
    });

    // Corrigendums JS management
    const corrigendumsInput = document.getElementById('corrigendums-input');
    let corrigendums = [];
    try {
      corrigendums = JSON.parse(corrigendumsInput.value || '[]');
    } catch (e) {
      corrigendums = [];
    }

    const corrigendumsList = document.getElementById('corrigendums-list');
    const corrTitle = document.getElementById('corr-title');
    const corrExtendedClosing = document.getElementById('corr-extendedClosing');
    const corrExtendedOpening = document.getElementById('corr-extendedOpening');
    const corrFileUrl = document.getElementById('corr-file-url');
    const corrFileSize = document.getElementById('corr-file-size');
    const corrFileUploader = document.getElementById('corr-doc-input');
    const btnAddCorr = document.getElementById('btn-add-corr');

    // Toggle button elements
    const corrAddForm = document.getElementById('corr-add-form');
    const btnShowAddCorr = document.getElementById('btn-show-add-corr');
    const btnCancelAddCorr = document.getElementById('btn-cancel-add-corr');

    btnShowAddCorr?.addEventListener('click', () => {
      corrAddForm?.classList.remove('hidden');
      btnShowAddCorr?.classList.add('hidden');
    });

    btnCancelAddCorr?.addEventListener('click', () => {
      resetCorrForm();
      corrAddForm?.classList.add('hidden');
      btnShowAddCorr?.classList.remove('hidden');
    });

    function resetCorrForm() {
      if (corrTitle) corrTitle.value = '';
      if (corrFileUrl) corrFileUrl.value = '';
      if (corrFileSize) corrFileSize.value = '';
      if (corrExtendedClosing) corrExtendedClosing.value = '';
      if (corrExtendedOpening) corrExtendedOpening.value = '';
      if (corrFileUploader) { corrFileUploader.value = ''; corrFileUploader.dispatchEvent(new CustomEvent('uploader:cleared', { bubbles: true })); }
    }

    function renderCorrigendums() {
      if (!corrigendumsList) return;
      corrigendumsList.innerHTML = '';
      if (corrigendums.length === 0) {
        corrigendumsList.innerHTML = '<div class="text-slate-450 italic text-xs font-semibold py-2">No corrigendums added yet.</div>';
        return;
      }

      corrigendums.forEach((corr, index) => {
        const item = document.createElement('div');
        item.className = 'flex items-center justify-between p-3 bg-slate-50 border border-slate-200 rounded-lg text-xs gap-4';
        
        const info = document.createElement('div');
        info.className = 'flex-1 min-w-0';
        
        let datesText = '';
        if (corr.extendedClosingDate) datesText += ` | Extended Closing: ${corr.extendedClosingDate}`;
        if (corr.extendedBidOpeningDate) datesText += ` | Extended Opening: ${corr.extendedBidOpeningDate}`;

        const filename = corr.documentUrl.substring(corr.documentUrl.lastIndexOf('/') + 1);

        info.innerHTML = `
          <div class="font-bold text-slate-800 truncate">${corr.title}</div>
          <div class="text-slate-500 font-medium mt-0.5">
            File: <a href="${corr.documentUrl}" target="_blank" class="text-[color:var(--adm-primary)] hover:underline font-bold">${filename}</a> (${Math.round(corr.fileSizeBytes / 1024)} KB)${datesText}
          </div>
        `;
        
        const actions = document.createElement('div');
        const btnDelete = document.createElement('button');
        btnDelete.type = 'button';
        btnDelete.className = 'px-2 py-1 bg-red-50 hover:bg-red-100 text-red-650 rounded text-[10px] font-bold border border-red-200 transition-colors cursor-pointer';
        btnDelete.textContent = 'Remove';
        btnDelete.addEventListener('click', () => {
          corrigendums.splice(index, 1);
          if (corrigendumsInput) corrigendumsInput.value = JSON.stringify(corrigendums);
          renderCorrigendums();
        });
        
        actions.appendChild(btnDelete);
        item.appendChild(info);
        item.appendChild(actions);
        corrigendumsList.appendChild(item);
      });
    }

    renderCorrigendums();

    btnAddCorr?.addEventListener('click', () => {
      const title = corrTitle ? corrTitle.value.trim() : '';
      const url = corrFileUrl ? corrFileUrl.value : '';
      const size = corrFileSize ? parseInt(corrFileSize.value, 10) : 0;

      if (!title) {
        alert('Please enter corrigendum details.');
        return;
      }
      if (!url) {
        alert('Please attach a document for the corrigendum.');
        return;
      }

      const newCorr = {
        id: Math.random().toString(36).substring(2, 15),
        title,
        publishDate: new Date().toISOString(),
        documentUrl: url,
        fileSizeBytes: size || 0,
        extendedClosingDate: corrExtendedClosing ? (corrExtendedClosing.value || null) : null,
        extendedBidOpeningDate: corrExtendedOpening ? (corrExtendedOpening.value || null) : null
      };

      corrigendums.push(newCorr);
      if (corrigendumsInput) corrigendumsInput.value = JSON.stringify(corrigendums);
      
      resetCorrForm();
      corrAddForm?.classList.add('hidden');
      btnShowAddCorr?.classList.remove('hidden');

      renderCorrigendums();
    });

    fileUploader?.addEventListener('change', async (event) => {
      const file = event.target?.files?.[0];
      if (!file) return;

      clearUploadError();
      isUploading = true;
      if (submitBtn) { submitBtn.disabled = true; submitBtn.textContent = 'Uploading…'; }
      if (uploadContainer) uploadContainer.classList.add('opacity-60', 'pointer-events-none');

      const isImportant = document.getElementById('tender-doc-important')?.checked || false;
      const formData = new FormData();
      formData.append('file', file);
      formData.append('isImportant', isImportant ? 'true' : 'false');

      try {
        const response = await fetch(`${backendUrl}/api/upload`, {
          method: 'POST',
          headers: {
            'Authorization': `Bearer ${sessionToken}`,
          },
          body: formData,
        });

        if (!response.ok) {
          if (response.status === 401) {
            window.location.href = '/admin/login';
            return;
          }
          if (response.status === 403) {
            alert('Access Denied: You do not have permission to upload files.');
            return;
          }
          const errorData = await response.json().catch(() => ({}));
          throw new Error(errorData.message || `Upload failed (HTTP ${response.status})`);
        }

        const result = await response.json();
        if (documentUrlInput) documentUrlInput.value = result.url;
        if (fileSizeBytesInput) fileSizeBytesInput.value = result.sizeBytes;
      } catch (error) {
        showUploadError(`Upload failed: ${error.message}. Please try again.`);
        if (documentUrlInput) documentUrlInput.value = '';
        if (fileUploader) fileUploader.value = '';
      } finally {
        isUploading = false;
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.textContent = document.getElementById('id')?.value ? 'Update Tender' : 'Publish Tender';
        }
        if (uploadContainer) uploadContainer.classList.remove('opacity-60', 'pointer-events-none');
      }
    });

    // Remove action on unified uploader clears stored URL + size
    fileUploader?.addEventListener('uploader:cleared', () => {
      if (documentUrlInput) documentUrlInput.value = '';
      if (fileSizeBytesInput) fileSizeBytesInput.value = '';
    });

    // Corrigendum uploader (unified component)
    const corrFileUploader = document.getElementById('corr-doc-input');
    corrFileUploader?.addEventListener('change', async (event) => {
      const file = event.target?.files?.[0];
      if (!file) return;

      const isImportant = document.getElementById('corr-doc-important')?.checked || false;
      const formData = new FormData();
      formData.append('file', file);
      formData.append('isImportant', isImportant ? 'true' : 'false');

      try {
        const response = await fetch(`${backendUrl}/api/upload`, {
          method: 'POST',
          headers: { 'Authorization': `Bearer ${sessionToken}` },
          body: formData,
        });

        if (!response.ok) {
          if (response.status === 401) { window.location.href = '/admin/login'; return; }
          if (response.status === 403) { alert('Access Denied: You do not have permission to upload files.'); return; }
          const errorData = await response.json().catch(() => ({}));
          throw new Error(errorData.message || 'Upload failed');
        }

        const result = await response.json();
        if (corrFileUrl) corrFileUrl.value = result.url;
        if (corrFileSize) corrFileSize.value = result.sizeBytes;
      } catch (error) {
        alert(`Upload error: ${error.message}`);
        if (corrFileUploader) corrFileUploader.value = '';
      }
    });

    corrFileUploader?.addEventListener('uploader:cleared', () => {
      if (corrFileUrl) corrFileUrl.value = '';
      if (corrFileSize) corrFileSize.value = '';
    });
  </script>
</AdminLayout>
