---
import AdminLayout from '../../layouts/AdminLayout.astro';
import Icon from '../../components/Icon.astro';
import { isAdmin } from '../../utils/roles';
import { parseApiError, BACKEND_URL } from '../../utils/api-error';

// Check authentication
const sessionToken = Astro.cookies.get('admin_session')?.value;
if (!sessionToken) {
  return Astro.redirect('/admin/login');
}

// Role protection: User management is ADMIN-only
const userRole = Astro.locals.user?.role;
if (!isAdmin(userRole)) {
  return Astro.redirect('/admin/dashboard');
}

let errorMessage = '';
const editId = Astro.url.searchParams.get('id')?.toString();

let userData = {
  id: '',
  name: '',
  email: '',
  role: 'EDITOR',
  isActive: true,
};

// Fetch data if editing
if (editId) {
  try {
    const res = await fetch(`${BACKEND_URL}/api/users/${editId}`, {
      headers: { 'Authorization': `Bearer ${sessionToken}` }
    });
    if (res.ok) {
      const data = await res.json();
      userData = {
        id: data.id || '',
        name: data.name || '',
        email: data.email || '',
        role: data.role || 'EDITOR',
        isActive: data.isActive !== undefined ? data.isActive : true,
      };
    } else {
      const apiErr = await parseApiError(res, 'load user account details');
      if (apiErr.isUnauthorized) {
        return Astro.redirect('/admin/login');
      }
      errorMessage = apiErr.message;
    }
  } catch (e) {
    console.error('Error fetching user details:', e);
    errorMessage = 'Failed to load user account details. Check backend service status.';
  }
}

// Handle Form Submit
if (Astro.request.method === 'POST') {
  try {
    const formData = await Astro.request.formData();
    const id = formData.get('id')?.toString();
    const name = formData.get('name')?.toString();
    const email = formData.get('email')?.toString();
    const password = formData.get('password')?.toString();
    const role = formData.get('role')?.toString();
    const isActive = formData.get('isActive')?.toString() === 'true';

    // Preserve values
    userData = {
      id: id || '',
      name: name || '',
      email: email || '',
      role: role || 'EDITOR',
      isActive: isActive,
    };

    if (!name || !email || (!id && !password)) {
      errorMessage = 'Name, Email, and Password (for new users) are required.';
    } else {
      const body: any = {
        name,
        email,
        role,
        isActive,
      };
      if (password) {
        body.password = password;
      }

      const url = id 
        ? `${BACKEND_URL}/api/users/${id}` 
        : `${BACKEND_URL}/api/users`;
      const method = id ? 'PUT' : 'POST';

      const res = await fetch(url, {
        method,
        headers: {
          'Content-Type': 'application/json',
          'Authorization': `Bearer ${sessionToken}`,
        },
        body: JSON.stringify(body),
      });

      if (res.ok) {
        return Astro.redirect('/admin/users');
      } else {
        const apiErr = await parseApiError(res, 'save user account');
        if (apiErr.isUnauthorized) {
          return Astro.redirect('/admin/login');
        }
        errorMessage = apiErr.message;
      }
    }
  } catch (error) {
    console.error('Error saving user:', error);
    errorMessage = 'An unexpected error occurred while saving the user account. Check backend service status.';
  }
}
---

<AdminLayout title={editId ? "Modify Account" : "Register Account"} description="Manage JKSPDCL Admin Users" activeTab="users">
  <div class="flex flex-col gap-6">
    
    <!-- Top breadcrumbs and back link -->
    <div class="admin-page-header">
      <div>
        <h1 class="admin-page-title">
          {editId ? 'Modify Console User' : 'Register Console User'}
        </h1>
        <p class="admin-page-subtitle">Configure administrative login credentials, access permissions, and role assignments.</p>
      </div>
      <a href="/admin/users" class="admin-btn admin-btn-secondary">
        &larr; Back to Users
      </a>
    </div>

    <!-- Error notice -->
    {errorMessage && (
      <div class="p-3 bg-red-50 border border-red-200 text-xs font-semibold text-red-700 rounded flex items-center gap-2" role="alert">
        <Icon name="alert-triangle" size={14} class="text-red-600 shrink-0" />
        <span>{errorMessage}</span>
      </div>
    )}

    <!-- Form -->
    <form method="POST" class="bg-white rounded-lg border border-slate-200 shadow-sm p-6 lg:p-8 flex flex-col gap-6">
      <input type="hidden" name="id" value={userData.id} />

      <!-- Section: Specifications -->
      <div>
        <h3 class="text-xs font-bold text-[#0B4F9C] uppercase tracking-wider border-b border-slate-100 pb-2 mb-4">Credentials &amp; Permissions</h3>
        
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div class="form-group flex flex-col gap-1.5">
            <label for="name" class="text-xs font-bold text-slate-700">Full Name <span class="text-red-500">*</span></label>
            <input type="text" name="name" id="name" value={userData.name} class="form-input text-xs" required placeholder="e.g. Sh. Aniket Dev" />
          </div>

          <div class="form-group flex flex-col gap-1.5">
            <label for="email" class="text-xs font-bold text-slate-700">Official Email Address <span class="text-red-500">*</span></label>
            <input type="email" name="email" id="email" value={userData.email} class="form-input text-xs" required placeholder="e.g. aniket.dev@jkspdc.co.in" />
          </div>

          <div class="form-group flex flex-col gap-1.5">
            <label for="password" class="text-xs font-bold text-slate-700">
              Secure Password {editId ? '(Leave empty to keep existing)' : <span class="text-red-500">*</span>}
            </label>
            <input 
              type="password" 
              name="password" 
              id="password" 
              class="form-input text-xs" 
              required={!editId} 
              placeholder="••••••••" 
              minlength="6"
            />
          </div>

          <div class="form-group flex flex-col gap-1.5">
            <label for="role" class="text-xs font-bold text-slate-700">Access Role</label>
            <select name="role" id="role" class="form-select text-xs">
              <option value="ADMIN" selected={userData.role === 'ADMIN'}>ADMIN (Full Control)</option>
              <option value="EDITOR" selected={userData.role === 'EDITOR'}>EDITOR (CRUD on Content)</option>
              <option value="VIEWER" selected={userData.role === 'VIEWER'}>VIEWER (Read-Only)</option>
            </select>
          </div>

          <div class="form-group flex flex-col gap-1.5">
            <label for="isActive" class="text-xs font-bold text-slate-700">Status</label>
            <select name="isActive" id="isActive" class="form-select text-xs">
              <option value="true" selected={userData.isActive === true}>Active (Authorized to Sign In)</option>
              <option value="false" selected={userData.isActive === false}>Inactive (Suspended Account)</option>
            </select>
          </div>
        </div>
      </div>

      <!-- Actions -->
      <div class="flex justify-end gap-3 border-t border-slate-100 pt-6 mt-2">
        <a href="/admin/users" class="admin-btn admin-btn-secondary">Cancel</a>
        <button type="submit" class="admin-btn admin-btn-primary cursor-pointer">
          {editId ? 'Update Account' : 'Register Account'}
        </button>
      </div>
    </form>
  </div>
</AdminLayout>
