---
import AdminLayout from '../../layouts/AdminLayout.astro';
import Icon from '../../components/Icon.astro';

let pages: any[] = [];
let errorMessage = '';

// Define all editable pages grouped by category
const pageCategories = [
  {
    name: 'About Us',
    pages: [
      { slug: 'about-us/overview', label: 'Corporate Overview' },
      { slug: 'about-us/mission', label: 'Mission' },
      { slug: 'about-us/vision', label: 'Vision' },
      { slug: 'about-us/objectives', label: 'Objectives' },
      { slug: 'about-us/profile', label: 'Company Profile' },
      { slug: 'about-us/organization-chart', label: 'Organization Chart' },
      { slug: 'about-us/roles-responsibility', label: 'Roles & Responsibilities' },
      { slug: 'about-us/ethics-code', label: 'Ethics Code / Vigilance' },
      { slug: 'about-us/association-memorandum', label: 'Memorandum of Association' },
      { slug: 'about-us/gstin-registration', label: 'GSTIN Registration' },
      { slug: 'about-us/committees', label: 'Board Committees' },
      { slug: 'about-us/awards', label: 'Awards & Recognition' },
      { slug: 'about-us/contact', label: 'Contact Information' },
    ],
  },
  {
    name: 'Investors',
    pages: [
      { slug: 'investors/financial-results', label: 'Financial Results' },
      { slug: 'investors/annual-reports', label: 'Annual Reports' },
      { slug: 'investors/chairman-statement', label: 'Chairman Statement' },
      { slug: 'investors/mou-mop', label: 'MoU with MoP' },
      { slug: 'investors/ipp-projects', label: 'IPP Projects' },
    ],
  },
  {
    name: 'CSR & Sustainability',
    pages: [
      { slug: 'csr/overview', label: 'CSR Overview' },
      { slug: 'csr/policy', label: 'CSR Policy' },
      { slug: 'csr/plans', label: 'CSR Plans' },
      { slug: 'csr/reports', label: 'CSR Reports' },
      { slug: 'csr/guidelines', label: 'CSR Guidelines' },
      { slug: 'csr/project-selection', label: 'Project Selection Criteria' },
      { slug: 'csr/formats', label: 'CSR Formats' },
      { slug: 'csr/awards', label: 'CSR Awards' },
      { slug: 'csr/communication-policy', label: 'Communication Policy' },
    ],
  },
  {
    name: 'Environment',
    pages: [
      { slug: 'environment/preamble', label: 'Environment Preamble' },
      { slug: 'environment/policy', label: 'Environment Policy' },
      { slug: 'environment/key-areas', label: 'Key Focus Areas' },
      { slug: 'environment/clearance', label: 'Environmental Clearances' },
      { slug: 'environment/events', label: 'Environment Events' },
      { slug: 'environment/rr-initiatives', label: 'R&R Initiatives' },
      { slug: 'environment/six-monthly-reports', label: 'Six Monthly Reports' },
    ],
  },
  {
    name: 'ESG',
    pages: [
      { slug: 'esg/policies', label: 'ESG Policies' },
      { slug: 'esg/sustainability-report', label: 'Sustainability Report' },
    ],
  },
  {
    name: 'Power Trading',
    pages: [
      { slug: 'power-trading', label: 'Power Trading Cell' },
    ],
  },
];

const sessionToken = Astro.cookies.get('admin_session')?.value || '';

try {
  const res = await fetch('http://localhost:3000/api/page-content', {
    headers: sessionToken ? { Authorization: `Bearer ${sessionToken}` } : {},
  });
  if (res.ok) {
    pages = await res.json();
  }
} catch (e) {
  errorMessage = 'Could not load page content data. Ensure backend is running.';
}

// Build a lookup map for existing pages
const existingPages = new Map(pages.map((p: any) => [p.pageSlug, p]));
---

<AdminLayout title="Page Editor" description="Edit static website page content" activeTab="page-editor">
  <div class="flex flex-col gap-6">
    <div class="flex flex-col gap-1.5 border-b border-slate-200 pb-5">
      <h1 class="text-2xl font-extrabold text-slate-900 tracking-tight">Page Content Editor</h1>
      <p class="text-xs text-slate-600 font-medium">Edit static pages across the website. Click any page to modify its title, content, and metadata.</p>
    </div>

    {errorMessage && (
      <div class="p-4 bg-amber-50 border-l-4 border-amber-500 rounded text-xs text-amber-800 font-semibold" role="alert">
        <Icon name="info" size={14} class="inline text-amber-600 mr-1" /> {errorMessage}
      </div>
    )}

    <!-- Page Categories -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
      {pageCategories.map((category) => (
        <div class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden">
          <div class="px-5 py-3.5 bg-slate-50 border-b border-slate-200 flex items-center gap-2">
            <Icon name="folder" size={14} class="text-blue-600" />
            <h3 class="text-xs font-bold text-slate-700 uppercase tracking-wider">{category.name}</h3>
            <span class="ml-auto text-[10px] font-bold text-slate-400 bg-slate-200 px-2 py-0.5 rounded-full">{category.pages.length} pages</span>
          </div>
          <div class="divide-y divide-slate-100">
            {category.pages.map((page) => {
              const existing = existingPages.get(page.slug);
              return (
                <button
                  class="page-edit-btn w-full flex items-center justify-between px-5 py-3 hover:bg-blue-50/50 transition-colors text-left group cursor-pointer"
                  data-slug={page.slug}
                  data-label={page.label}
                  data-title={existing?.title || ''}
                  data-content={existing?.content || ''}
                  data-meta={existing?.metaDesc || ''}
                >
                  <div class="flex items-center gap-3">
                    <div class={`w-2 h-2 rounded-full ${existing ? 'bg-emerald-500' : 'bg-slate-300'}`}></div>
                    <span class="text-xs font-semibold text-slate-700 group-hover:text-blue-700 transition-colors">{page.label}</span>
                  </div>
                  <div class="flex items-center gap-2">
                    <span class={`text-[10px] font-bold px-2 py-0.5 rounded-full ${existing ? 'bg-emerald-100 text-emerald-700' : 'bg-slate-100 text-slate-400'}`}>
                      {existing ? 'Customized' : 'Default'}
                    </span>
                    <Icon name="pencil" size={12} class="text-slate-400 group-hover:text-blue-600 transition-colors" />
                  </div>
                </button>
              );
            })}
          </div>
        </div>
      ))}
    </div>

    <!-- Edit Modal (hidden by default) -->
    <div id="page-edit-modal" class="fixed inset-0 bg-black/50 z-[100] hidden flex items-center justify-center p-4">
      <div class="bg-white rounded-2xl shadow-2xl w-full max-w-3xl max-h-[90vh] flex flex-col overflow-hidden">
        <div class="px-6 py-4 border-b border-slate-200 flex items-center justify-between bg-slate-50">
          <div>
            <h3 id="modal-title" class="text-sm font-extrabold text-slate-900">Edit Page</h3>
            <p id="modal-slug" class="text-[10px] text-slate-400 font-mono mt-0.5"></p>
          </div>
          <button id="modal-close" class="p-2 text-slate-400 hover:text-red-600 hover:bg-red-50 rounded-lg transition-colors cursor-pointer">
            <Icon name="x" size={18} />
          </button>
        </div>
        <div class="flex-1 overflow-y-auto p-6 flex flex-col gap-5">
          <div>
            <label class="text-[11px] font-bold text-slate-600 uppercase tracking-wider mb-1.5 block">Page Title</label>
            <input id="edit-title" type="text" class="w-full px-4 py-2.5 border border-slate-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500" placeholder="Enter page title..." />
          </div>
          <div>
            <label class="text-[11px] font-bold text-slate-600 uppercase tracking-wider mb-1.5 block">Meta Description (SEO)</label>
            <input id="edit-meta" type="text" class="w-full px-4 py-2.5 border border-slate-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500" placeholder="Brief SEO description..." />
          </div>
          <div class="flex-1">
            <label class="text-[11px] font-bold text-slate-600 uppercase tracking-wider mb-1.5 block">Page Content (HTML)</label>
            <textarea id="edit-content" class="w-full px-4 py-3 border border-slate-300 rounded-lg text-sm font-mono focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 min-h-[300px] resize-y" placeholder="Enter HTML content..." rows="15"></textarea>
          </div>
        </div>
        <div class="px-6 py-4 border-t border-slate-200 flex items-center justify-between bg-slate-50">
          <button id="modal-reset" class="px-4 py-2 text-xs font-bold text-red-600 border border-red-200 rounded-lg hover:bg-red-50 transition-colors cursor-pointer">
            Reset to Default
          </button>
          <div class="flex items-center gap-3">
            <button id="modal-cancel" class="px-4 py-2 text-xs font-bold text-slate-600 border border-slate-200 rounded-lg hover:bg-slate-100 transition-colors cursor-pointer">Cancel</button>
            <button id="modal-save" class="px-6 py-2 text-xs font-bold text-white bg-blue-600 rounded-lg hover:bg-blue-700 shadow-md transition-colors cursor-pointer">Save Changes</button>
          </div>
        </div>
      </div>
    </div>
  </div>
</AdminLayout>

<script is:inline>
(function() {
  var modal = document.getElementById('page-edit-modal');
  var titleInput = document.getElementById('edit-title');
  var metaInput = document.getElementById('edit-meta');
  var contentInput = document.getElementById('edit-content');
  var modalTitle = document.getElementById('modal-title');
  var modalSlug = document.getElementById('modal-slug');
  var currentSlug = '';

  function getToken() {
    var match = document.cookie.match(/admin_session=([^;]+)/);
    return match ? match[1] : '';
  }

  // Open modal
  document.querySelectorAll('.page-edit-btn').forEach(function(btn) {
    btn.addEventListener('click', function() {
      currentSlug = btn.dataset.slug;
      modalTitle.textContent = 'Edit: ' + btn.dataset.label;
      modalSlug.textContent = 'Slug: ' + currentSlug;
      titleInput.value = btn.dataset.title || btn.dataset.label;
      metaInput.value = btn.dataset.meta || '';
      contentInput.value = btn.dataset.content || '';
      modal.classList.remove('hidden');
    });
  });

  // Close modal
  document.getElementById('modal-close').addEventListener('click', function() {
    modal.classList.add('hidden');
  });
  document.getElementById('modal-cancel').addEventListener('click', function() {
    modal.classList.add('hidden');
  });
  modal.addEventListener('click', function(e) {
    if (e.target === modal) modal.classList.add('hidden');
  });

  // Save
  document.getElementById('modal-save').addEventListener('click', function() {
    var token = getToken();
    if (!token) { alert('Not authenticated. Please log in.'); return; }
    fetch('http://localhost:3000/api/page-content/' + currentSlug, {
      method: 'PUT',
      headers: { 'Content-Type': 'application/json', Authorization: 'Bearer ' + token },
      body: JSON.stringify({
        title: titleInput.value,
        content: contentInput.value,
        metaDesc: metaInput.value,
      }),
    })
    .then(function(res) {
      if (res.ok) {
        alert('Page saved successfully!');
        window.location.reload();
      } else {
        alert('Failed to save. Please try again.');
      }
    })
    .catch(function() { alert('Network error. Please try again.'); });
  });

  // Reset
  document.getElementById('modal-reset').addEventListener('click', function() {
    if (!confirm('Reset this page to default content? This will delete any custom content.')) return;
    var token = getToken();
    fetch('http://localhost:3000/api/page-content/' + currentSlug, {
      method: 'DELETE',
      headers: { Authorization: 'Bearer ' + token },
    })
    .then(function(res) {
      if (res.ok) {
        alert('Page reset to default.');
        window.location.reload();
      } else {
        alert('Failed to reset. Page may already be using default content.');
      }
    })
    .catch(function() { alert('Network error.'); });
  });
})();
</script>
