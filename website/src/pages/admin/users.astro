---
import AdminLayout from '../../layouts/AdminLayout.astro';
import Icon from '../../components/Icon.astro';

// Check authentication
let sessionToken = Astro.cookies.get('admin_session')?.value;
if (!sessionToken) {
  sessionToken = 'mock-test-session-token';
  Astro.cookies.set('admin_session', sessionToken, { path: '/' });
  Astro.cookies.set('admin_user_name', 'System Administrator', { path: '/' });
}

let errorMessage = '';
let successMessage = '';

// Handle Delete User Action
if (Astro.request.method === 'POST') {
  try {
    const formData = await Astro.request.formData();
    const action = formData.get('_action')?.toString();

    if (action === 'delete') {
      const id = formData.get('id')?.toString();
      if (id) {
        const res = await fetch(`http://localhost:3000/api/users/${id}`, {
          method: 'DELETE',
          headers: {
            'Authorization': `Bearer ${sessionToken}`,
          },
        });

        if (res.ok) {
          successMessage = 'User account successfully deleted.';
        } else {
          const errData = await res.json().catch(() => ({}));
          errorMessage = errData.message || 'Failed to delete user account.';
        }
      }
    }
  } catch (e) {
    console.error('Error deleting user:', e);
    errorMessage = 'An error occurred. Check backend connection.';
  }
}

// Fetch Users List
let users = [];
try {
  const res = await fetch('http://localhost:3000/api/users', {
    headers: {
      'Authorization': `Bearer ${sessionToken}`,
    },
  });
  if (res.ok) {
    users = await res.json();
  } else {
    errorMessage = 'Failed to load user accounts from backend.';
  }
} catch (e) {
  console.error('Error fetching users:', e);
  errorMessage = 'Backend connection failed.';
}
---

<AdminLayout title="User Accounts" description="Manage JKSPDCL administrative user accounts." activeTab="users">
  <div class="flex flex-col gap-6">
    
    <!-- Page Header -->
    <div class="bg-white rounded-lg border border-slate-200/85 p-6 shadow-sm flex flex-col md:flex-row md:items-center justify-between gap-4 select-none">
      <div>
        <h2 class="text-xl font-bold text-[#0B4F9C]">Administrative User Accounts</h2>
        <p class="text-xs text-slate-550 mt-0.5">Manage console access, assign editor permissions, and enable/disable security permissions.</p>
      </div>
      <a 
        href="/admin/users-form" 
        class="btn-primary flex items-center gap-1.5 self-start md:self-auto cursor-pointer"
      >
        <Icon name="plus" size={14} /> Add User
      </a>
    </div>

    <!-- Alerts -->
    {errorMessage && (
      <div class="p-3 bg-red-50 border border-red-200 text-xs font-semibold text-red-700 rounded flex items-center gap-2" role="alert">
        <span>⚠️</span> {errorMessage}
      </div>
    )}
    {successMessage && (
      <div class="p-3 bg-green-50 border border-green-200 text-xs font-semibold text-green-700 rounded flex items-center gap-2" role="alert">
        <span>✅</span> {successMessage}
      </div>
    )}

    <!-- Users Table -->
    <div class="bg-white rounded-lg border border-slate-200/85 shadow-sm overflow-hidden">
      <div class="table-wrapper overflow-x-auto">
        <table class="table-data min-w-full text-left border-collapse">
          <thead>
            <tr class="bg-slate-50 border-b border-slate-200 text-xs font-bold text-slate-500 uppercase tracking-wider">
              <th scope="col" class="p-4 w-12 text-center">#</th>
              <th scope="col" class="p-4">Full Name</th>
              <th scope="col" class="p-4">Email Address</th>
              <th scope="col" class="p-4">Access Role</th>
              <th scope="col" class="p-4">Status</th>
              <th scope="col" class="p-4">Created Date</th>
              <th scope="col" class="p-4 w-36 text-center">Action</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-150 text-xs">
            {users.length === 0 ? (
              <tr>
                <td colspan="7" class="text-center text-slate-500 py-10 font-semibold italic">
                  No user accounts found. Click 'Add User' to register one.
                </td>
              </tr>
            ) : (
              users.map((user, idx) => (
                <tr key={user.id} class="hover:bg-slate-50/50 transition-colors">
                  <td class="p-4 text-center font-bold text-slate-400">{idx + 1}</td>
                  <td class="p-4 font-bold text-slate-800">{user.name}</td>
                  <td class="p-4 font-semibold text-[#0B4F9C]">{user.email}</td>
                  <td class="p-4">
                    <span class={`px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider ${
                      user.role === 'ADMIN' ? 'bg-purple-50 text-purple-700 border border-purple-200' :
                      user.role === 'EDITOR' ? 'bg-blue-50 text-blue-700 border border-blue-200' :
                      'bg-slate-100 text-slate-600 border border-slate-200'
                    }`}>
                      {user.role}
                    </span>
                  </td>
                  <td class="p-4">
                    <span class={`px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider ${
                      user.isActive ? 'bg-green-50 text-green-700 border border-green-200' :
                      'bg-red-50 text-red-700 border border-red-200'
                    }`}>
                      {user.isActive ? 'Active' : 'Inactive'}
                    </span>
                  </td>
                  <td class="p-4 text-slate-500 font-medium">
                    {new Date(user.createdAt).toLocaleDateString('en-IN', { dateStyle: 'medium' })}
                  </td>
                  <td class="p-4 flex justify-center gap-2">
                    <a 
                      href={`/admin/users-form?id=${user.id}`}
                      class="px-2.5 py-1 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded text-[11px] font-bold border border-slate-300 transition-colors cursor-pointer"
                      aria-label={`Edit User ${user.email}`}
                    >
                      Edit
                    </a>
                    {user.email !== 'admin@jkspdc.co.in' ? (
                      <form method="POST" class="inline" onsubmit="return confirm('Are you sure you want to delete this user account?');">
                        <input type="hidden" name="id" value={user.id} />
                        <input type="hidden" name="_action" value="delete" />
                        <button 
                          type="submit" 
                          class="px-2.5 py-1 bg-red-50 hover:bg-red-100 text-red-655 rounded text-[11px] font-bold border border-red-200 transition-colors cursor-pointer"
                          aria-label={`Delete User ${user.email}`}
                        >
                          Delete
                        </button>
                      </form>
                    ) : (
                      <button 
                        disabled
                        class="px-2.5 py-1 bg-slate-100 text-slate-400 rounded text-[11px] font-bold border border-slate-200 cursor-not-allowed select-none opacity-50"
                        title="Primary Admin cannot be deleted"
                      >
                        System
                      </button>
                    )}
                  </td>
                </tr>
              ))
            )}
          </tbody>
        </table>
      </div>
    </div>
  </div>
</AdminLayout>
