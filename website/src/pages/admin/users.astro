---
import AdminLayout from '../../layouts/AdminLayout.astro';
import Icon from '../../components/Icon.astro';
import { isAdmin } from '../../utils/roles';
import { parseApiError, BACKEND_URL } from '../../utils/api-error';
import { readPageParams, fetchPaged, pageUrl } from '../../utils/pagination';
import PageNav from '../../components/PageNav.astro';

// Check authentication
const sessionToken = Astro.cookies.get('admin_session')?.value;
if (!sessionToken) {
  return Astro.redirect('/admin/login');
}

// Role protection: User management is ADMIN-only
const userRole = Astro.locals.user?.role;
if (!isAdmin(userRole)) {
  return Astro.redirect('/admin/dashboard');
}

let errorMessage = '';
let successMessage = '';
let issuedEnrollmentCode = '';
let issuedExpiresAt = '';
if (Astro.url.searchParams.get('saved') === 'true') {
  successMessage = 'User account successfully saved.';
}

// Handle Actions (Delete User, Reset MFA)
if (Astro.request.method === 'POST') {
  try {
    const formData = await Astro.request.formData();
    const action = formData.get('_action')?.toString();

    if (action === 'delete') {
      const id = formData.get('id')?.toString();
      if (id) {
        const res = await fetch(`${BACKEND_URL}/api/users/${id}`, {
          method: 'DELETE',
          headers: {
            'Authorization': `Bearer ${sessionToken}`,
          },
        });

        if (res.ok) {
          successMessage = 'User account successfully deleted.';
        } else {
          const apiErr = await parseApiError(res, 'delete user account');
          if (apiErr.isUnauthorized) {
            return Astro.redirect('/admin/login');
          }
          errorMessage = apiErr.message;
        }
      }
    } else if (action === 'reset-mfa') {
      const id = formData.get('id')?.toString();
      const currentPassword = formData.get('currentPassword')?.toString() || '';
      const totpCode = formData.get('totpCode')?.toString() || '';
      const reason = formData.get('reason')?.toString() || '';

      if (id) {
        const res = await fetch(`${BACKEND_URL}/api/users/${id}/reset-mfa`, {
          method: 'POST',
          headers: {
            'Authorization': `Bearer ${sessionToken}`,
            'Content-Type': 'application/json',
          },
          body: JSON.stringify({ currentPassword, totpCode, reason }),
        });

        if (res.ok) {
          const resData = await res.json().catch(() => ({}));
          successMessage = resData.message || 'Single-use MFA Enrolment Code issued.';
          issuedEnrollmentCode = resData.enrollmentCode || '';
          issuedExpiresAt = resData.expiresAt || '';
        } else {
          const apiErr = await parseApiError(res, 'reset user MFA');
          if (apiErr.isUnauthorized) {
            return Astro.redirect('/admin/login');
          }
          errorMessage = apiErr.message;
        }
      }
    }
  } catch (e) {
    console.error('Error processing user action:', e);
    errorMessage = 'An error occurred while processing the request. Check backend service status.';
  }
}

// Fetch Users List
const { page, pageSize } = readPageParams(Astro.url);
const pagedExtra: Record<string, string | undefined> = {};
let users: any[] = [];
let pagedTotal = 0;
let pagedLastPage = 1;
try {
  const state = await fetchPaged('/api/users', { BACKEND_URL, token: sessionToken, page, pageSize, extra: pagedExtra });
  users = state.rows;
  pagedTotal = state.total;
  pagedLastPage = state.lastPage;
  if (state.error) errorMessage = errorMessage || state.error;
} catch (e) {
  console.error('Error fetching list:', e);
  errorMessage = 'Network failure: Unable to reach backend server.';
}
const pagedState = { rows: users, total: pagedTotal, page, pageSize, lastPage: pagedLastPage, error: null };---

<AdminLayout title="User Accounts" description="Manage JKSPDCL administrative user accounts." activeTab="users">
  <div class="flex flex-col gap-6">
    
    <!-- Page Header -->
    <div class="admin-page-header">
      <div>
        <h1 class="admin-page-title">Administrative User Accounts</h1>
        <p class="admin-page-subtitle">Manage console access, assign editor permissions, and maintain administrator accounts.</p>
      </div>
      <a 
        href="/admin/users-form" 
        class="admin-btn admin-btn-primary flex items-center gap-1.5 self-start sm:self-auto cursor-pointer"
      >
        <Icon name="plus" size={14} /> Add User
      </a>
    </div>

    <!-- Alerts -->
    {errorMessage && (
      <div class="p-3 bg-red-50 border border-red-200 text-xs font-semibold text-red-700 rounded flex items-center gap-2" role="alert">
        <Icon name="info" size={14} class="text-red-600 shrink-0" /> {errorMessage}
      </div>
      <script is:inline define:vars={{ msg: errorMessage }}>
        alert('Action Failed: ' + msg);
      </script>
    )}
    {successMessage && (
      <div class="p-4 bg-emerald-50 border border-emerald-200 text-xs text-emerald-900 rounded-lg flex flex-col gap-2" role="alert">
        <div class="flex items-center gap-2 font-semibold">
          <Icon name="check-circle" size={15} class="text-emerald-600 shrink-0" />
          <span>{successMessage}</span>
        </div>
        {issuedEnrollmentCode && (
          <div class="mt-1 p-3 bg-white border border-emerald-200 rounded-md flex flex-col sm:flex-row sm:items-center justify-between gap-3">
            <div>
              <span class="text-[10px] font-bold uppercase tracking-wider text-slate-500 block">Single-Use Enrolment Code (Shown Once)</span>
              <code class="text-sm font-mono font-extrabold text-[#0B3D6B] tracking-wider select-all">{issuedEnrollmentCode}</code>
              {issuedExpiresAt && (
                <span class="text-[11px] text-slate-500 ml-2">(Expires: {new Date(issuedExpiresAt).toLocaleString('en-IN')})</span>
              )}
            </div>
            <button
              type="button"
              onclick={`navigator.clipboard.writeText('${issuedEnrollmentCode}').then(() => { this.textContent = 'Copied!'; })`}
              class="px-3 py-1.5 bg-[#0B3D6B] hover:bg-[#082E52] text-white text-xs font-bold rounded cursor-pointer shrink-0"
            >
              Copy Code
            </button>
          </div>
        )}
      </div>
    )}

    <!-- Administrative Data Table -->
    <div class="admin-table-card">
    <div class="admin-table-container">
      <table class="admin-table">
        <thead>
          <tr>
            <th scope="col" class="w-12 text-center">#</th>
            <th scope="col" class="min-w-[180px]">Full Name</th>
            <th scope="col" class="min-w-[220px]">Email Address</th>
            <th scope="col" class="w-28">Access Role</th>
            <th scope="col" class="w-24">Status</th>
            <th scope="col" class="w-32 text-center">MFA Security</th>
            <th scope="col" class="w-36">Created Date</th>
            <th scope="col" class="w-32 text-center sticky-col-right">Action</th>
          </tr>
        </thead>
        <tbody>
          {users.length === 0 ? (
            <tr>
              <td colspan="8" class="text-center text-slate-500 py-12 text-xs font-semibold italic">
                <Icon name="folder" size={32} class="mx-auto text-slate-300 mb-2" />
                No user accounts found. Click 'Add User' to register one.
              </td>
            </tr>
          ) : (
            users.map((user: any, idx: number) => (
              <tr key={user.id} class="transition-colors">
                <td class="text-center font-bold text-slate-400 text-xs">{(page - 1) * pageSize + idx + 1}</td>
                <td class="font-bold text-slate-900 text-xs">{user.name}</td>
                <td class="font-medium text-[color:var(--adm-primary)] font-mono text-xs">{user.email}</td>
                <td>
                  <span class={`admin-badge ${user.role === 'ADMIN' ? 'admin-badge-info' : 'admin-badge-neutral'}`}>
                    {user.role}
                  </span>
                </td>
                <td>
                  <span class={`admin-badge ${user.isActive ? 'admin-badge-success' : 'admin-badge-danger'}`}>
                    {user.isActive ? 'Active' : 'Inactive'}
                  </span>
                </td>
                <td class="text-center">
                  {user.mfaEnabled ? (
                    <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10px] font-bold bg-emerald-50 text-emerald-700 border border-emerald-200">
                      <Icon name="shield" size={11} class="text-emerald-600" /> Active
                    </span>
                  ) : user.role === 'ADMIN' || user.role === 'EDITOR' ? (
                    <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10px] font-bold bg-amber-50 text-amber-700 border border-amber-200">
                      <Icon name="clock" size={11} class="text-amber-600" /> Enrolment Req.
                    </span>
                  ) : (
                    <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10px] font-medium bg-slate-100 text-slate-600 border border-slate-200">
                      Optional
                    </span>
                  )}
                </td>
                <td class="text-slate-600 text-xs font-medium whitespace-nowrap">
                  {new Date(user.createdAt).toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric' })}
                </td>
                <td class="td-actions sticky-col-right text-center">
                  <div class="admin-action-group justify-center">
                    <a 
                      href={`/admin/users-form?id=${user.id}`}
                      class="admin-btn-action"
                      aria-label={`Edit User ${user.email}`}
                      title="Edit User"
                    >
                      <Icon name="pencil" size={13} />
                    </a>
                    {(user.role === 'ADMIN' || user.role === 'EDITOR') && (
                      <button
                        type="button"
                        class="admin-btn-action text-amber-600 hover:text-amber-800 hover:bg-amber-50 cursor-pointer"
                        aria-label={`${user.mfaEnabled ? 'Reset MFA' : 'Issue Enrolment Code'} for ${user.email}`}
                        title={user.mfaEnabled ? 'Reset MFA (Requires Step-Up Verification)' : 'Issue / Re-issue Enrolment Code'}
                        onclick={`openResetMfaModal('${user.id}', '${user.email}', '${user.name.replace(/'/g, "\\'")}', ${user.mfaEnabled ? 'true' : 'false'})`}
                      >
                        <Icon name="key" size={13} />
                      </button>
                    )}
                    {user.email !== 'admin@jkspdc.co.in' ? (
                      <form method="POST" class="inline m-0 p-0" onsubmit="return confirm('Are you sure you want to delete this user account?');">
                        <input type="hidden" name="id" value={user.id} />
                        <input type="hidden" name="_action" value="delete" />
                        <button 
                          type="submit" 
                          class="admin-btn-action action-delete"
                          aria-label={`Delete User ${user.email}`}
                          title="Delete User"
                        >
                          <Icon name="trash-2" size={13} />
                        </button>
                      </form>
                    ) : (
                      <button 
                        disabled
                        class="admin-btn-action opacity-40 cursor-not-allowed text-slate-400"
                        title="Primary Admin account cannot be deleted"
                        aria-label="System Protected Admin"
                      >
                        <Icon name="lock" size={13} />
                      </button>
                    )}
                  </div>
                </td>
              </tr>
            ))
          )}
        </tbody>
      </table>


    <PageNav state={pagedState} url={(p: number) => pageUrl(Astro.url, p, pageSize, pagedExtra)} />    </div>
    </div>

    <!-- Step-Up Re-Authentication Modal for Resetting MFA -->
    <dialog id="reset-mfa-dialog" class="backdrop:bg-slate-900/60 p-0 rounded-2xl shadow-2xl border border-slate-200 max-w-md w-full m-auto">
      <div class="p-6 bg-white flex flex-col gap-4">
        <div class="flex justify-between items-center border-b border-slate-100 pb-3">
          <div class="flex items-center gap-2 text-amber-700">
            <Icon name="shield-alert" size={20} />
            <h3 class="font-bold text-sm text-slate-800">Administrator Step-Up Verification</h3>
          </div>
          <button type="button" onclick="document.getElementById('reset-mfa-dialog').close()" class="text-slate-400 hover:text-slate-600 text-lg">&times;</button>
        </div>

        <p class="text-xs text-slate-600">
          <span id="modal-mfa-action-desc">Resetting MFA for</span> <strong id="modal-target-user" class="font-semibold text-slate-800"></strong> will revoke active sessions and generate a fresh single-use enrolment code.
        </p>

        <form method="POST" class="flex flex-col gap-3">
          <input type="hidden" name="_action" value="reset-mfa" />
          <input type="hidden" name="id" id="modal-user-id" value="" />

          <div class="flex flex-col gap-1">
            <label for="currentPassword" class="text-xs font-bold text-slate-700">Your Administrator Password <span class="text-red-500">*</span></label>
            <input type="password" name="currentPassword" id="currentPassword" required class="form-input text-xs w-full bg-slate-50 border border-slate-300 rounded-lg p-2.5 focus:bg-white focus:ring-2 focus:ring-focus outline-none" placeholder="••••••••••••" autocomplete="current-password" />
          </div>

          <div class="flex flex-col gap-1">
            <label for="totpCode" class="text-xs font-bold text-slate-700">Your 6-Digit Authenticator TOTP <span class="text-red-500">*</span></label>
            <input type="text" name="totpCode" id="totpCode" required maxlength="6" pattern="[0-9]{6}" class="form-input font-mono text-center tracking-widest text-sm font-bold w-full bg-slate-50 border border-slate-300 rounded-lg p-2.5 focus:bg-white focus:ring-2 focus:ring-focus outline-none" placeholder="000000" autocomplete="one-time-code" />
          </div>

          <div class="flex flex-col gap-1">
            <label for="reason" class="text-xs font-bold text-slate-700">Administrative Justification / Reason <span class="text-red-500">*</span></label>
            <input type="text" name="reason" id="reason" required minlength="5" class="form-input text-xs w-full bg-slate-50 border border-slate-300 rounded-lg p-2.5 focus:bg-white focus:ring-2 focus:ring-focus outline-none" placeholder="e.g. Lost device; approved by Director" />
          </div>

          <div class="flex justify-end gap-2 pt-2 border-t border-slate-100 mt-2">
            <button type="button" onclick="document.getElementById('reset-mfa-dialog').close()" class="px-3.5 py-2 text-xs font-semibold text-slate-600 hover:bg-slate-100 rounded-lg cursor-pointer">Cancel</button>
            <button type="submit" class="px-4 py-2 text-xs font-bold text-white bg-amber-700 hover:bg-amber-800 rounded-lg shadow-sm cursor-pointer flex items-center gap-1.5">
              <Icon name="check-circle" size={14} />
              <span>Verify &amp; Reset MFA</span>
            </button>
          </div>
        </form>
      </div>
    </dialog>

    <script is:inline>
      function openResetMfaModal(userId, userEmail, userName, isMfaEnabled) {
        document.getElementById('modal-user-id').value = userId;
        document.getElementById('modal-target-user').textContent = userName + ' (' + userEmail + ')';
        var descEl = document.getElementById('modal-mfa-action-desc');
        if (descEl) {
          descEl.textContent = isMfaEnabled ? 'Resetting MFA for' : 'Issuing a new MFA Enrolment Code for';
        }
        var dialog = document.getElementById('reset-mfa-dialog');
        if (dialog.showModal) {
          dialog.showModal();
        } else {
          dialog.setAttribute('open', '');
        }
      }
    </script>

  </div>
</AdminLayout>
