---
import AdminLayout from '../../layouts/AdminLayout.astro';
import Icon from '../../components/Icon.astro';
import { isAdmin } from '../../utils/roles';
import { parseApiError, BACKEND_URL } from '../../utils/api-error';
import { readPageParams, fetchPaged, pageUrl } from '../../utils/pagination';
import PageNav from '../../components/PageNav.astro';

// Check authentication
const sessionToken = Astro.cookies.get('admin_session')?.value;
if (!sessionToken) {
  return Astro.redirect('/admin/login');
}

// Role protection: User management is ADMIN-only
const userRole = Astro.locals.user?.role;
if (!isAdmin(userRole)) {
  return Astro.redirect('/admin/dashboard');
}

let errorMessage = '';
let successMessage = '';

// Handle Delete User Action
if (Astro.request.method === 'POST') {
  try {
    const formData = await Astro.request.formData();
    const action = formData.get('_action')?.toString();

    if (action === 'delete') {
      const id = formData.get('id')?.toString();
      if (id) {
        const res = await fetch(`${BACKEND_URL}/api/users/${id}`, {
          method: 'DELETE',
          headers: {
            'Authorization': `Bearer ${sessionToken}`,
          },
        });

        if (res.ok) {
          successMessage = 'User account successfully deleted.';
        } else {
          const apiErr = await parseApiError(res, 'delete user account');
          if (apiErr.isUnauthorized) {
            return Astro.redirect('/admin/login');
          }
          errorMessage = apiErr.message;
        }
      }
    }
  } catch (e) {
    console.error('Error deleting user:', e);
    errorMessage = 'An error occurred while deleting the user account. Check backend service status.';
  }
}

// Fetch Users List
const { page, pageSize } = readPageParams(Astro.url);
const pagedExtra: Record<string, string | undefined> = {};
let users: any[] = [];
let pagedTotal = 0;
let pagedLastPage = 1;
try {
  const state = await fetchPaged('/api/users', { BACKEND_URL, token: sessionToken, page, pageSize, extra: pagedExtra });
  users = state.rows;
  pagedTotal = state.total;
  pagedLastPage = state.lastPage;
  if (state.error) errorMessage = errorMessage || state.error;
} catch (e) {
  console.error('Error fetching list:', e);
  errorMessage = 'Network failure: Unable to reach backend server.';
}
const pagedState = { rows: users, total: pagedTotal, page, pageSize, lastPage: pagedLastPage, error: null };---

<AdminLayout title="User Accounts" description="Manage JKSPDCL administrative user accounts." activeTab="users">
  <div class="flex flex-col gap-6">
    
    <!-- Page Header -->
    <div class="admin-page-header">
      <div>
        <h1 class="admin-page-title">Administrative User Accounts</h1>
        <p class="admin-page-subtitle">Manage console access, assign editor permissions, and maintain administrator accounts.</p>
      </div>
      <a 
        href="/admin/users-form" 
        class="admin-btn admin-btn-primary flex items-center gap-1.5 self-start sm:self-auto cursor-pointer"
      >
        <Icon name="plus" size={14} /> Add User
      </a>
    </div>

    <!-- Alerts -->
    {errorMessage && (
      <div class="p-3 bg-red-50 border border-red-200 text-xs font-semibold text-red-700 rounded flex items-center gap-2" role="alert">
        <Icon name="info" size={14} class="text-red-600 shrink-0" /> {errorMessage}
      </div>
    )}
    {successMessage && (
      <div class="p-3 bg-green-50 border border-green-200 text-xs font-semibold text-green-700 rounded flex items-center gap-2" role="alert">
        <Icon name="info" size={14} class="text-green-600 shrink-0" /> {successMessage}
      </div>
    )}

    <!-- Administrative Data Table -->
    <div class="admin-table-card">
    <div class="admin-table-container">
      <table class="admin-table">
        <thead>
          <tr>
            <th scope="col" class="w-12 text-center">#</th>
            <th scope="col" class="min-w-[180px]">Full Name</th>
            <th scope="col" class="min-w-[220px]">Email Address</th>
            <th scope="col" class="w-28">Access Role</th>
            <th scope="col" class="w-24">Status</th>
            <th scope="col" class="w-36">Created Date</th>
            <th scope="col" class="w-28 text-center sticky-col-right">Action</th>
          </tr>
        </thead>
        <tbody>
          {users.length === 0 ? (
            <tr>
              <td colspan="7" class="text-center text-slate-500 py-12 text-xs font-semibold italic">
                <Icon name="folder" size={32} class="mx-auto text-slate-300 mb-2" />
                No user accounts found. Click 'Add User' to register one.
              </td>
            </tr>
          ) : (
            users.map((user: any, idx: number) => (
              <tr key={user.id} class="transition-colors">
                <td class="text-center font-bold text-slate-400 text-xs">{idx + 1}</td>
                <td class="font-bold text-slate-900 text-xs">{user.name}</td>
                <td class="font-medium text-[color:var(--adm-primary)] font-mono text-xs">{user.email}</td>
                <td>
                  <span class={`admin-badge ${user.role === 'ADMIN' ? 'admin-badge-info' : 'admin-badge-neutral'}`}>
                    {user.role}
                  </span>
                </td>
                <td>
                  <span class={`admin-badge ${user.isActive ? 'admin-badge-success' : 'admin-badge-danger'}`}>
                    {user.isActive ? 'Active' : 'Inactive'}
                  </span>
                </td>
                <td class="text-slate-600 text-xs font-medium whitespace-nowrap">
                  {new Date(user.createdAt).toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric' })}
                </td>
                <td class="td-actions sticky-col-right text-center">
                  <div class="admin-action-group justify-center">
                    <a 
                      href={`/admin/users-form?id=${user.id}`}
                      class="admin-btn-action"
                      aria-label={`Edit User ${user.email}`}
                      title="Edit User"
                    >
                      <Icon name="pencil" size={13} />
                    </a>
                    {user.email !== 'admin@jkspdc.co.in' ? (
                      <form method="POST" class="inline m-0 p-0" onsubmit="return confirm('Are you sure you want to delete this user account?');">
                        <input type="hidden" name="id" value={user.id} />
                        <input type="hidden" name="_action" value="delete" />
                        <button 
                          type="submit" 
                          class="admin-btn-action action-delete"
                          aria-label={`Delete User ${user.email}`}
                          title="Delete User"
                        >
                          <Icon name="trash-2" size={13} />
                        </button>
                      </form>
                    ) : (
                      <button 
                        disabled
                        class="admin-btn-action opacity-40 cursor-not-allowed text-slate-400"
                        title="Primary Admin account cannot be deleted"
                        aria-label="System Protected Admin"
                      >
                        <Icon name="lock" size={13} />
                      </button>
                    )}
                  </div>
                </td>
              </tr>
            ))
          )}
        </tbody>
      </table>


    <PageNav state={pagedState} url={(p: number) => pageUrl(Astro.url, p, pageSize, pagedExtra)} />    </div>
    </div>

  </div>
</AdminLayout>
