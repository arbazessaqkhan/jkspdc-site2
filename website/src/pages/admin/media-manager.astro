---
import AdminLayout from '../../layouts/AdminLayout.astro';
import Icon from '../../components/Icon.astro';
import FileUploader from '../../components/admin/FileUploader.astro';
import { canUploadFile, canDeleteFile } from '../../utils/roles';
import { parseApiError, BACKEND_URL } from '../../utils/api-error';

// Check authentication
const sessionToken = Astro.cookies.get('admin_session')?.value;
if (!sessionToken) {
  return Astro.redirect('/admin/login');
}

const userRole = Astro.locals.user?.role;
const canUpload = canUploadFile(userRole);
const canDelete = canDeleteFile(userRole);

let filesList: any[] = [];
let errorMessage = '';

try {
  const response = await fetch(`${BACKEND_URL}/api/upload`, {
    headers: {
      'Authorization': `Bearer ${sessionToken}`
    }
  });

  if (response.ok) {
    filesList = await response.json();
  } else {
    const apiErr = await parseApiError(response, 'load uploaded files list');
    if (apiErr.isUnauthorized) {
      return Astro.redirect('/admin/login');
    }
    errorMessage = apiErr.message;
  }
} catch (e) {
  console.error('Error fetching uploaded files:', e);
  errorMessage = 'Failed to load uploaded files. Unable to communicate with the server.';
}
---

<AdminLayout title="Media & Documents" description="Central file repository for portal PDFs, images, and attachments" activeTab="media-manager">
  <div class="flex flex-col gap-6" id="media-manager-root">
    
    <!-- Page Header -->
    <div class="admin-page-header">
      <div>
        <h1 class="admin-page-title">Media &amp; Document Manager</h1>
        <p class="admin-page-subtitle">Central authoritative file repository for portal PDFs, circulars, photographs, and public attachments.</p>
      </div>
    </div>

    {errorMessage && (
      <div class="p-3 bg-red-50 border border-red-200 text-xs font-semibold text-red-700 rounded flex items-center gap-2" role="alert">
        <Icon name="info" size={14} class="text-red-600 shrink-0" /> {errorMessage}
      </div>
    )}

    <!-- Upload Box & Info -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
      
      <!-- Upload Card (ADMIN and EDITOR only) -->
      {canUpload && (
        <div class="bg-white rounded-lg border border-slate-200 p-5 shadow-xs lg:col-span-1 flex flex-col gap-4 self-start">
          <h2 class="text-xs font-bold text-slate-800 uppercase tracking-wider border-b border-slate-100 pb-2">Upload File</h2>
          
          <FileUploader
            id="media-doc"
            variant="document"
            accept=".pdf,.jpg,.jpeg,.png,.doc,.docx,.xls,.xlsx"
            helpText="PDF, JPG, PNG, DOCX, XLSX (Max 20MB / 100MB if Important)"
            important
          />

          <div class="text-[11px] text-slate-600 leading-relaxed bg-slate-50 border border-slate-200 rounded p-3">
            <p class="font-bold text-slate-800 mb-1 flex items-center gap-1">
              <Icon name="info" size={12} class="text-[color:var(--adm-primary)]" /> Referencing Uploads:
            </p>
            Once uploaded, click <strong class="text-slate-800">Copy URL</strong> to reference the document anywhere across the admin portal.
          </div>
        </div>
      )}

      <!-- Files Registry Table -->
      <div class={canUpload ? "lg:col-span-2 space-y-4" : "lg:col-span-3 space-y-4"}>
        <div class="admin-toolbar flex-wrap">
          <div>
            <h2 class="text-xs font-bold text-slate-800 uppercase tracking-wider">Repository Files ({filesList.length})</h2>
            <span class="text-[10px] text-slate-500 font-medium">Authoritative file storage across all portal modules</span>
          </div>

          <!-- Filter / Search input -->
          <div class="relative w-full sm:w-60">
            <input 
              type="text" 
              id="search-files-input" 
              placeholder="Filter files..." 
              class="w-full bg-white border border-slate-300 rounded text-xs text-slate-800 pl-8 pr-3 py-1.5 focus:ring-1 focus:ring-[color:var(--adm-primary)] focus:border-[color:var(--adm-primary)] outline-none"
            />
            <div class="absolute left-2.5 top-2 text-slate-400">
              <Icon name="search" size={13} />
            </div>
          </div>
        </div>

        {filesList.length === 0 ? (
          <div class="text-center py-12 bg-white border border-slate-200 rounded-lg shadow-xs text-slate-400 space-y-2">
            <Icon name="folder" size={32} class="text-slate-300 mx-auto" />
            <p class="text-xs font-medium">No files uploaded yet.</p>
            <p class="text-[11px] text-slate-400">Use the upload box on the left to add documents or images.</p>
          </div>
        ) : (
          <div class="admin-table-card">
          <div class="admin-table-container">
            <table class="admin-table min-w-full" id="files-table">
              <thead>
                <tr>
                  <th scope="col" class="w-10 text-center">#</th>
                  <th scope="col" class="w-14 text-center">Type</th>
                  <th scope="col" class="min-w-[200px]">File Name</th>
                  <th scope="col" class="w-24 whitespace-nowrap">Size</th>
                  <th scope="col" class="w-28 whitespace-nowrap">Uploaded</th>
                  <th scope="col" class="w-28 text-center sticky-col-right">Action</th>
                </tr>
              </thead>
              <tbody id="files-tbody">
                {filesList.map((file, idx) => {
                  const isImage = /\.(jpg|jpeg|png|webp)$/i.test(file.filename);
                  const ext = file.filename.split('.').pop()?.toUpperCase() || 'FILE';
                  const sizeFormatted = file.sizeBytes > 1024 * 1024 
                    ? `${(file.sizeBytes / (1024 * 1024)).toFixed(2)} MB`
                    : `${Math.round(file.sizeBytes / 1024)} KB`;
                  const dateFormatted = new Date(file.createdAt).toLocaleDateString('en-GB', {
                    day: 'numeric',
                    month: 'short',
                    year: 'numeric'
                  });

                  return (
                    <tr class="file-row transition-colors" data-filename={file.filename}>
                      <td class="text-center font-bold text-slate-400 text-xs file-idx">{idx + 1}</td>
                      <td class="text-center p-2">
                        <div class="w-8 h-8 rounded bg-slate-100 border border-slate-200 mx-auto flex items-center justify-center overflow-hidden">
                          {isImage ? (
                            <img src={file.url} alt={file.filename} class="w-full h-full object-cover" />
                          ) : (
                            <span class="text-[9px] font-black text-[color:var(--adm-primary)] uppercase">
                              {ext}
                            </span>
                          )}
                        </div>
                      </td>
                      <td>
                        <div class="flex flex-col">
                          <span class="font-bold text-slate-900 text-xs break-all leading-snug" title={file.filename}>
                            {file.filename}
                          </span>
                          <span class="text-[10px] text-slate-400 font-mono truncate max-w-xs">{file.url}</span>
                        </div>
                      </td>
                      <td class="whitespace-nowrap text-xs font-medium text-slate-700">
                        {sizeFormatted}
                      </td>
                      <td class="whitespace-nowrap text-xs text-slate-600 font-medium">
                        {dateFormatted}
                      </td>
                      <td class="td-actions sticky-col-right text-center">
                        <div class="admin-action-group justify-center">
                          <button 
                            type="button" 
                            class="admin-btn-action btn-copy-url"
                            data-url={file.url}
                            aria-label="Copy Absolute URL"
                            title="Copy Absolute URL"
                          >
                            <Icon name="copy" size={13} />
                          </button>
                          <a 
                            href={file.url} 
                            target="_blank" 
                            rel="noopener noreferrer"
                            class="admin-btn-action"
                            aria-label="Open File in New Tab"
                            title="Open File in New Tab"
                          >
                            <Icon name="external-link" size={13} />
                          </a>
                          {canDelete && (
                            <button 
                              type="button" 
                              class="admin-btn-action action-delete btn-delete-file"
                              data-filename={file.filename}
                              aria-label="Delete File"
                              title="Delete File"
                            >
                              <Icon name="trash-2" size={13} />
                            </button>
                          )}
                        </div>
                      </td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
          </div>
          </div>

        )}
      </div>

    </div>

  </div>

  <!-- Client-side Scripts -->
  <script is:inline define:vars={{ sessionToken, canUpload, canDelete, backendUrl: BACKEND_URL }}>
    // Setup references
    const fileUploader = document.getElementById('media-doc-input');
        const uploadContainer = document.getElementById('media-doc-dropzone');
    const isImportantCheckbox = document.getElementById('media-doc-important');

    // Handle Upload
    if (canUpload && fileUploader) {
      fileUploader.addEventListener('change', async (event) => {
      const file = event.target?.files?.[0];
      if (!file) return;

      const isImportant = isImportantCheckbox?.checked || false;
      uploadContainer.classList.add('opacity-60', 'pointer-events-none');

      const formData = new FormData();
      formData.append('file', file);
      formData.append('isImportant', isImportant ? 'true' : 'false');

      try {
        const response = await fetch(`${backendUrl}/api/upload`, {
          method: 'POST',
          headers: {
            'Authorization': `Bearer ${sessionToken}`
          },
          body: formData
        });

        if (!response.ok) {
          if (response.status === 401) {
            window.location.href = '/admin/login';
            return;
          }
          if (response.status === 403) {
            alert('Access Denied: You do not have permission to upload files.');
            return;
          }
          const errorData = await response.json().catch(() => ({}));
          throw new Error(errorData.message || 'File upload failed');
        }

        // Reload the page to list the new file
        window.location.reload();
      } catch (error) {
        alert(`Upload Error: ${error.message}`);
        fileUploader.value = '';
      } finally {
        uploadContainer.classList.remove('opacity-60', 'pointer-events-none');
      }
    });
  }

    // Copy URL helper
    document.querySelectorAll('.btn-copy-url').forEach((btn) => {
      btn.addEventListener('click', () => {
        const url = btn.getAttribute('data-url');
        if (!url) return;

        // Formulate absolute link
        const fullUrl = window.location.origin + url;
        
        navigator.clipboard.writeText(fullUrl).then(() => {
          const originalHTML = btn.innerHTML;
          btn.innerHTML = `<span class="text-emerald-600 flex items-center gap-1 font-bold"><svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"></path></svg> Copied</span>`;
          btn.classList.add('bg-emerald-50', 'border-emerald-200');
          setTimeout(() => {
            btn.innerHTML = originalHTML;
            btn.classList.remove('bg-emerald-50', 'border-emerald-200');
          }, 2000);
        }).catch((err) => {
          alert('Could not copy URL: ' + err);
        });
      });
    });

    // Delete file handler (ADMIN only)
    if (canDelete) {
      document.querySelectorAll('.btn-delete-file').forEach((btn) => {
        btn.addEventListener('click', async () => {
          const filename = btn.getAttribute('data-filename');
          if (!filename) return;

          const confirmDelete = confirm(`Are you sure you want to delete ${filename}? This action will permanently remove it from the server.`);
          if (!confirmDelete) return;

          btn.disabled = true;
          btn.classList.add('opacity-50');

          try {
            const response = await fetch(`${backendUrl}/api/upload/${encodeURIComponent(filename)}`, {
              method: 'DELETE',
              headers: {
                'Authorization': `Bearer ${sessionToken}`
              }
            });

            if (!response.ok) {
              if (response.status === 401) {
                window.location.href = '/admin/login';
                return;
              }
              if (response.status === 403) {
                alert('Access Denied: You do not have permission to delete files.');
                btn.disabled = false;
                btn.classList.remove('opacity-50');
                return;
              }
              const errData = await response.json().catch(() => ({}));
              throw new Error(errData.message || 'Failed to delete file.');
            }

            // Remove file row from table
            const row = document.querySelector(`.file-row[data-filename="${CSS.escape(filename)}"], .file-card[data-filename="${CSS.escape(filename)}"]`);
            if (row) {
              row.style.transition = 'all 0.3s ease';
              row.style.opacity = '0';
              setTimeout(() => {
                row.remove();
                // Re-index remaining rows
                document.querySelectorAll('.file-row').forEach((r, i) => {
                  const idxEl = r.querySelector('.file-idx');
                  if (idxEl) idxEl.textContent = (i + 1).toString();
                });
                // Refresh page if no rows left to display blank state
                if (document.querySelectorAll('.file-row').length === 0) {
                  window.location.reload();
                }
              }, 300);
            }
          } catch (err) {
            alert(`Delete Error: ${err.message}`);
            btn.disabled = false;
            btn.classList.remove('opacity-50');
          }
        });
      });
    }

    // File quick filter
    const searchFilesInput = document.getElementById('search-files-input');
    if (searchFilesInput) {
      searchFilesInput.addEventListener('input', (e) => {
        const query = e.target.value.toLowerCase().trim();
        let visibleCount = 0;
        document.querySelectorAll('.file-row').forEach((row) => {
          const fn = (row.getAttribute('data-filename') || '').toLowerCase();
          if (!query || fn.includes(query)) {
            row.style.display = '';
            visibleCount++;
            const idxEl = row.querySelector('.file-idx');
            if (idxEl) idxEl.textContent = visibleCount.toString();
          } else {
            row.style.display = 'none';
          }
        });
      });
    }
  </script>
</AdminLayout>
