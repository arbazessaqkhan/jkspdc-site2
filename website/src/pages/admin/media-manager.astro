---
import AdminLayout from '../../layouts/AdminLayout.astro';
import Icon from '../../components/Icon.astro';

// Check authentication
const sessionToken = Astro.cookies.get('admin_session')?.value;
if (!sessionToken) {
  return Astro.redirect('/admin/login');
}

let filesList: any[] = [];
let errorMessage = '';

try {
  const response = await fetch('http://localhost:3000/api/upload', {
    headers: {
      'Authorization': `Bearer ${sessionToken}`
    }
  });

  if (response.ok) {
    filesList = await response.json();
  } else {
    errorMessage = 'Failed to fetch the uploaded documents list from the backend server.';
  }
} catch (e) {
  console.error('Error fetching uploaded files:', e);
  errorMessage = 'Could not connect to the backend server. Make sure the API service is running.';
}
---

<AdminLayout title="Media & Documents" description="Central file repository for portal PDFs, images, and attachments" activeTab="media-manager">
  <div class="flex flex-col gap-6" id="media-manager-root">
    
    <!-- Header -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 border-b border-slate-200 pb-5">
      <div class="space-y-1">
        <h1 class="text-2xl font-extrabold text-slate-900 tracking-tight flex items-center gap-2">
          <Icon name="folder" size={24} class="text-[#0B4F9C]" /> Media &amp; Document Manager
        </h1>
        <p class="text-xs text-slate-600 font-medium">One-stop repository to upload, reference, copy links, and delete documents and images across the website.</p>
      </div>
    </div>

    {errorMessage && (
      <div class="p-4 bg-amber-50 border-l-4 border-amber-500 rounded text-xs text-amber-800 font-semibold shadow-sm flex items-start gap-2.5" role="alert">
        <Icon name="info" size={16} class="text-amber-600 shrink-0 mt-0.5" />
        <span>{errorMessage}</span>
      </div>
    )}

    <!-- Upload Box & Info -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
      
      <!-- Upload Card -->
      <div class="card-static lg:col-span-1 flex flex-col gap-4 self-start">
        <h2 class="text-xs font-extrabold text-slate-900 uppercase tracking-wider border-b border-slate-100 pb-2">Upload File</h2>
        
        <div id="upload-container" class="border-2 border-dashed border-slate-300 hover:border-blue-400 rounded-lg p-6 bg-slate-50 flex flex-col items-center justify-center gap-2 hover:bg-blue-50/20 transition-all cursor-pointer relative min-h-[160px]">
          <input type="file" id="file-uploader" class="absolute inset-0 opacity-0 cursor-pointer" accept=".pdf,.jpg,.jpeg,.png,.doc,.docx,.xls,.xlsx" />
          <Icon name="upload" size={28} class="text-slate-400" />
          <span class="text-xs text-slate-600 font-bold text-center" id="upload-status-text">Click to browse or drag file here</span>
          <span class="text-[10px] text-slate-450 text-center">PDF, JPG, PNG, DOCX, XLSX (Max 10MB)</span>
        </div>

        <div class="text-[11px] text-slate-500 leading-relaxed bg-slate-50 border border-slate-100 rounded-lg p-3">
          <p class="font-bold text-slate-700 mb-1 flex items-center gap-1">
            <Icon name="info" size={12} class="text-slate-400" /> Referencing Uploads:
          </p>
          Once uploaded, click <strong class="text-slate-700">Copy URL</strong> and paste the link anywhere in rich text textareas, download buttons, or configuration modules.
        </div>
      </div>

      <!-- Files Registry -->
      <div class="lg:col-span-2 space-y-4">
        <div class="flex items-center justify-between border-b border-slate-100 pb-2">
          <h2 class="text-xs font-extrabold text-slate-900 uppercase tracking-wider">Repository Files ({filesList.length})</h2>
          <span class="text-[10px] text-slate-500 font-semibold uppercase">Sorted by newest upload</span>
        </div>

        {filesList.length === 0 ? (
          <div class="text-center py-12 bg-white border border-slate-200 rounded-xl shadow-sm text-slate-400 space-y-2">
            <Icon name="folder" size={36} class="text-slate-300 mx-auto" />
            <p class="text-sm font-medium">No files uploaded yet.</p>
            <p class="text-xs text-slate-400">Use the upload box on the left to add documents.</p>
          </div>
        ) : (
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4" id="files-grid">
            {filesList.map((file) => {
              const isImage = /\.(jpg|jpeg|png|webp)$/i.test(file.filename);
              const ext = file.filename.split('.').pop()?.toUpperCase() || 'FILE';
              const sizeFormatted = file.sizeBytes > 1024 * 1024 
                ? `${(file.sizeBytes / (1024 * 1024)).toFixed(2)} MB`
                : `${Math.round(file.sizeBytes / 1024)} KB`;
              const dateFormatted = new Date(file.createdAt).toLocaleDateString('en-GB', {
                day: 'numeric',
                month: 'short',
                year: 'numeric'
              });

              return (
                <div class="bg-white border border-slate-200 hover:border-slate-300 rounded-xl p-4 shadow-sm transition-all flex flex-col justify-between gap-3 relative file-card" data-filename={file.filename}>
                  <div class="flex items-start gap-3 min-w-0">
                    <!-- Icon / Thumbnail Preview -->
                    <div class="w-12 h-12 rounded bg-slate-100 border border-slate-200 shrink-0 flex items-center justify-center overflow-hidden">
                      {isImage ? (
                        <img src={file.url} alt={file.filename} class="w-full h-full object-cover" />
                      ) : (
                        <span class="text-[10px] font-extrabold text-[#0B4F9C] bg-[#0B4F9C]/5 w-full h-full flex items-center justify-center uppercase">
                          {ext}
                        </span>
                      )}
                    </div>
                    
                    <div class="min-w-0 flex-grow">
                      <p class="text-xs font-bold text-slate-900 truncate" title={file.filename}>
                        {file.filename}
                      </p>
                      <p class="text-[10px] text-slate-500 font-semibold mt-0.5">
                        {sizeFormatted} &bull; {dateFormatted}
                      </p>
                    </div>
                  </div>

                  <!-- Action Buttons -->
                  <div class="flex items-center gap-2 border-t border-slate-100 pt-3 mt-1 text-xs">
                    <button 
                      type="button" 
                      class="flex-grow inline-flex items-center justify-center gap-1 bg-slate-50 hover:bg-[#0B4F9C]/5 text-slate-700 hover:text-[#0B4F9C] font-bold py-1.5 px-3 rounded border border-slate-200 hover:border-[#0B4F9C]/30 transition-colors cursor-pointer btn-copy-url"
                      data-url={file.url}
                    >
                      <Icon name="file-text" size={13} /> Copy URL
                    </button>
                    <button 
                      type="button" 
                      class="inline-flex items-center justify-center bg-slate-50 hover:bg-red-50 text-slate-500 hover:text-red-600 font-bold py-1.5 px-2.5 rounded border border-slate-200 hover:border-red-200 transition-colors cursor-pointer btn-delete-file"
                      data-filename={file.filename}
                    >
                      <Icon name="trash" size={13} />
                    </button>
                  </div>
                </div>
              );
            })}
          </div>
        )}
      </div>

    </div>

  </div>

  <!-- Client-side Scripts -->
  <script is:inline define:vars={{ sessionToken }}>
    // Setup references
    const fileUploader = document.getElementById('file-uploader');
    const uploadStatusText = document.getElementById('upload-status-text');
    const uploadContainer = document.getElementById('upload-container');

    // Handle Upload
    fileUploader?.addEventListener('change', async (event) => {
      const file = event.target?.files?.[0];
      if (!file) return;

      uploadStatusText.textContent = `Uploading ${file.name}...`;
      uploadContainer.classList.add('opacity-60', 'pointer-events-none');

      const formData = new FormData();
      formData.append('file', file);

      try {
        const response = await fetch('http://localhost:3000/api/upload', {
          method: 'POST',
          headers: {
            'Authorization': `Bearer ${sessionToken}`
          },
          body: formData
        });

        if (!response.ok) {
          const errorData = await response.json().catch(() => ({}));
          throw new Error(errorData.message || 'File upload failed');
        }

        // Reload the page to list the new file
        window.location.reload();
      } catch (error) {
        alert(`Upload Error: ${error.message}`);
        uploadStatusText.textContent = 'Click to browse or drag file here';
      } finally {
        uploadContainer.classList.remove('opacity-60', 'pointer-events-none');
      }
    });

    // Copy URL helper
    document.querySelectorAll('.btn-copy-url').forEach((btn) => {
      btn.addEventListener('click', () => {
        const url = btn.getAttribute('data-url');
        if (!url) return;

        // Formulate absolute link
        const fullUrl = window.location.origin + url;
        
        navigator.clipboard.writeText(fullUrl).then(() => {
          const originalHTML = btn.innerHTML;
          btn.innerHTML = `<span class="text-emerald-600 flex items-center gap-1 font-bold">✓ Copied</span>`;
          btn.classList.add('bg-emerald-50', 'border-emerald-200');
          setTimeout(() => {
            btn.innerHTML = originalHTML;
            btn.classList.remove('bg-emerald-50', 'border-emerald-200');
          }, 2000);
        }).catch((err) => {
          alert('Could not copy URL: ' + err);
        });
      });
    });

    // Delete file handler
    document.querySelectorAll('.btn-delete-file').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const filename = btn.getAttribute('data-filename');
        if (!filename) return;

        const confirmDelete = confirm(`Are you sure you want to delete ${filename}? This action will permanently remove it from the server.`);
        if (!confirmDelete) return;

        btn.disabled = true;
        btn.classList.add('opacity-50');

        try {
          const response = await fetch(`http://localhost:3000/api/upload/${encodeURIComponent(filename)}`, {
            method: 'DELETE',
            headers: {
              'Authorization': `Bearer ${sessionToken}`
            }
          });

          if (!response.ok) {
            const errData = await response.json().catch(() => ({}));
            throw new Error(errData.message || 'Failed to delete file.');
          }

          // Remove file card from grid
          const card = document.querySelector(`.file-card[data-filename="${CSS.escape(filename)}"]`);
          if (card) {
            card.style.transition = 'all 0.3s ease';
            card.style.opacity = '0';
            card.style.transform = 'scale(0.9)';
            setTimeout(() => {
              card.remove();
              // Refresh page if no cards left to display blank state
              if (document.querySelectorAll('.file-card').length === 0) {
                window.location.reload();
              }
            }, 300);
          }
        } catch (err) {
          alert(`Delete Error: ${err.message}`);
          btn.disabled = false;
          btn.classList.remove('opacity-50');
        }
      });
    });
  </script>
</AdminLayout>
