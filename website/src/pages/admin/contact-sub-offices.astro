---
import AdminLayout from '../../layouts/AdminLayout.astro';
import Icon from '../../components/Icon.astro';
import { canMutateRoutineContent, isAdmin } from '../../utils/roles';
import { parseApiError, BACKEND_URL } from '../../utils/api-error';
import { readPageParams, fetchPaged, pageUrl } from '../../utils/pagination';
import PageNav from '../../components/PageNav.astro';

// Check authentication
const sessionToken = Astro.cookies.get('admin_session')?.value;
if (!sessionToken) {
  return Astro.redirect('/admin/login');
}

const userRole = Astro.locals.user?.role;
const canCreateOrEdit = canMutateRoutineContent(userRole);
const canDelete = isAdmin(userRole);
const canSeeActionColumn = canCreateOrEdit || canDelete;

let errorMessage = '';
let successMessage = '';

// Handle Delete Action (ADMIN ONLY)
if (Astro.request.method === 'POST') {
  if (!canDelete) {
    return Astro.redirect('/admin/contact-sub-offices');
  }
  try {
    const formData = await Astro.request.formData();
    const action = formData.get('_action')?.toString();

    if (action === 'delete') {
      const id = formData.get('id')?.toString();
      if (id) {
        const res = await fetch(`${BACKEND_URL}/api/contact-sub-offices/${id}`, {
          method: 'DELETE',
          headers: {
            'Authorization': `Bearer ${sessionToken}`,
          },
        });

        if (res.ok) {
          successMessage = 'Sub-Office / Wing contact successfully removed.';
        } else {
          const apiErr = await parseApiError(res, 'delete sub-office');
          if (apiErr.isUnauthorized) {
            return Astro.redirect('/admin/login');
          }
          errorMessage = apiErr.message;
        }
      }
    }
  } catch (e) {
    console.error('Error handling sub-office delete:', e);
    errorMessage = 'An error occurred while deleting the sub-office. Check backend service status.';
  }
}

// Fetch all sub-office / wing contacts
const { page, pageSize } = readPageParams(Astro.url);
const pagedExtra: Record<string, string | undefined> = {};
let subOffices: any[] = [];
let pagedTotal = 0;
let pagedLastPage = 1;
try {
  const state = await fetchPaged('/api/contact-sub-offices/all', { BACKEND_URL, token: sessionToken, page, pageSize, extra: pagedExtra });
  subOffices = state.rows;
  pagedTotal = state.total;
  pagedLastPage = state.lastPage;
  if (state.error) errorMessage = errorMessage || state.error;
} catch (e) {
  console.error('Error fetching list:', e);
  errorMessage = 'Network failure: Unable to reach backend server.';
}
const pagedState = { rows: subOffices, total: pagedTotal, page, pageSize, lastPage: pagedLastPage, error: null };---

<AdminLayout title="Contact Sub-Offices" description="Manage Wing and Field Sub-Offices Directory" activeTab="contact-sub-offices">
  <div class="flex flex-col gap-6">

    <!-- Page Header -->
    <div class="admin-page-header">
      <div>
        <h1 class="admin-page-title">Contact Sub-Offices &amp; Wing Directory</h1>
        <p class="admin-page-subtitle">CMS directory for generation wings (BHEP, Jammu, Kashmir) and field sub-offices.</p>
      </div>
      {canCreateOrEdit && (
        <a 
          href="/admin/contact-sub-offices-form" 
          class="admin-btn admin-btn-primary flex items-center gap-1.5 self-start sm:self-auto cursor-pointer"
        >
          <Icon name="plus" size={14} /> Add Wing / Sub-Office
        </a>
      )}
    </div>

    <!-- Alert Messages -->
    {errorMessage && (
      <div class="p-3 bg-red-50 border border-red-200 text-xs font-semibold text-red-700 rounded flex items-center gap-2" role="alert">
        <Icon name="info" size={14} class="text-red-600 shrink-0" /> {errorMessage}
      </div>
    )}
    {successMessage && (
      <div class="p-3 bg-green-50 border border-green-200 text-xs font-semibold text-green-700 rounded flex items-center gap-2" role="alert">
        <Icon name="info" size={14} class="text-green-600 shrink-0" /> {successMessage}
      </div>
    )}

    <!-- Sub-Offices Directory Table -->
    <div class="admin-table-card">
    <div class="admin-table-container">
      <table class="admin-table">
        <thead>
          <tr>
            <th scope="col" class="w-12 text-center">#</th>
            <th scope="col" class="min-w-[180px]">Wing / Sub-Office</th>
            <th scope="col" class="min-w-[200px]">Official / Designation</th>
            <th scope="col" class="min-w-[180px]">Email</th>
            <th scope="col" class="min-w-[140px]">Phone</th>
            <th scope="col" class="min-w-[200px]">Address / Location</th>
            {canSeeActionColumn && <th scope="col" class="w-28 text-center sticky-col-right">Action</th>}
          </tr>
        </thead>
        <tbody>
          {subOffices.length === 0 ? (
            <tr>
              <td colspan={canSeeActionColumn ? 7 : 6} class="text-center text-slate-500 py-12 text-xs font-semibold italic">
                <Icon name="folder" size={32} class="mx-auto text-slate-300 mb-2" />
                No wing or sub-office contacts found. Add one above.
              </td>
            </tr>
          ) : (
            subOffices.map((s: any, idx: number) => (
              <tr key={s.id} class="transition-colors">
                <td class="text-center font-bold text-slate-400 text-xs">{s.viewOrder || idx + 1}</td>
                <td class="text-xs font-bold text-slate-900">{s.wing}</td>
                <td class="text-xs">
                  <p class="font-bold text-slate-900 leading-snug">{s.name}</p>
                  <p class="text-[11px] text-[color:var(--adm-primary)] font-semibold mt-0.5">{s.designation}</p>
                </td>
                <td class="text-xs">
                  {s.email ? (
                    <span class="text-slate-700 font-mono">{s.email}</span>
                  ) : (
                    <span class="text-slate-400 italic">—</span>
                  )}
                </td>
                <td class="text-xs">
                  {s.phone ? (
                    <span class="font-semibold text-slate-700">{s.phone}</span>
                  ) : (
                    <span class="text-slate-400 italic">—</span>
                  )}
                </td>
                <td class="text-xs text-slate-600">
                  {s.address || <span class="text-slate-400 italic">—</span>}
                </td>
                {canSeeActionColumn && (
                  <td class="td-actions sticky-col-right text-center">
                    <div class="admin-action-group justify-center">
                      {canCreateOrEdit && (
                        <a
                          href={`/admin/contact-sub-offices-form?id=${s.id}`}
                          class="admin-btn-action"
                          aria-label={`Edit ${s.wing}`}
                          title="Edit Sub-Office"
                        >
                          <Icon name="pencil" size={13} />
                        </a>
                      )}
                      {canDelete && (
                        <form method="POST" class="inline m-0 p-0" onsubmit="return confirm('Are you sure you want to delete this sub-office record?');">
                          <input type="hidden" name="id" value={s.id} />
                          <input type="hidden" name="_action" value="delete" />
                          <button
                            type="submit"
                            class="admin-btn-action action-delete"
                            aria-label={`Delete ${s.wing}`}
                            title="Delete Sub-Office"
                          >
                            <Icon name="trash-2" size={13} />
                          </button>
                        </form>
                      )}
                    </div>
                  </td>
                )}
              </tr>
            ))
          )}
        </tbody>
      </table>


    <PageNav state={pagedState} url={(p: number) => pageUrl(Astro.url, p, pageSize, pagedExtra)} />    </div>
    </div>

  </div>
</AdminLayout>
