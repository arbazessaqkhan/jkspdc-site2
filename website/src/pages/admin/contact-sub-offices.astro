---
import AdminLayout from '../../layouts/AdminLayout.astro';
import Icon from '../../components/Icon.astro';

// Check authentication
let sessionToken = Astro.cookies.get('admin_session')?.value;
if (!sessionToken) {
  sessionToken = 'mock-test-session-token';
  Astro.cookies.set('admin_session', sessionToken, { path: '/' });
  Astro.cookies.set('admin_user_name', 'System Administrator', { path: '/' });
}

let errorMessage = '';
let successMessage = '';

// Handle Delete Action
if (Astro.request.method === 'POST') {
  try {
    const formData = await Astro.request.formData();
    const action = formData.get('_action')?.toString();

    if (action === 'delete') {
      const id = formData.get('id')?.toString();
      if (id) {
        const res = await fetch(`http://localhost:3000/api/contact-sub-offices/${id}`, {
          method: 'DELETE',
          headers: {
            'Authorization': `Bearer ${sessionToken}`,
          },
        });

        if (res.ok) {
          successMessage = 'Sub-Office / Wing contact successfully removed.';
        } else {
          errorMessage = 'Failed to remove sub-office record.';
        }
      }
    }
  } catch (e) {
    console.error('Error handling sub-office delete:', e);
    errorMessage = 'An error occurred while connecting to backend.';
  }
}

// Fetch all sub-office / wing contacts
let subOffices = [];
try {
  const res = await fetch('http://localhost:3000/api/contact-sub-offices/all', {
    headers: {
      'Authorization': `Bearer ${sessionToken}`,
    },
  });
  if (res.ok) {
    subOffices = await res.json();
  } else {
    // Fallback to public endpoint
    const pubRes = await fetch('http://localhost:3000/api/contact-sub-offices');
    if (pubRes.ok) subOffices = await pubRes.json();
  }
} catch (e) {
  console.error('Error fetching contact sub-offices:', e);
  errorMessage = 'Backend connection failed. Displaying fallback contacts.';
}
---

<AdminLayout title="Contact Sub-Offices" description="Manage Wing and Field Sub-Offices Directory" activeTab="contact-sub-offices">
  <div class="flex flex-col gap-6">

    <!-- Page Header -->
    <div class="bg-white rounded-lg border border-slate-200 p-6 shadow-sm flex flex-col md:flex-row md:items-center justify-between gap-4">
      <div>
        <h2 class="text-xl font-bold text-[#0B4F9C]">Contact Sub-Offices &amp; Wing Directory</h2>
        <p class="text-xs text-slate-500 mt-0.5">CMS directory for generation wings (BHEP, Jammu, Kashmir) and field sub-offices.</p>
      </div>
      <a 
        href="/admin/contact-sub-offices-form" 
        class="btn-primary flex items-center gap-1.5 self-start md:self-auto cursor-pointer"
      >
        <Icon name="plus" size={14} /> Add Wing / Sub-Office
      </a>
    </div>

    <!-- Alert Messages -->
    {errorMessage && (
      <div class="p-3 bg-red-50 border border-red-200 text-xs font-semibold text-red-700 rounded flex items-center gap-2" role="alert">
        <Icon name="info" size={14} class="text-red-600 shrink-0" /> {errorMessage}
      </div>
    )}
    {successMessage && (
      <div class="p-3 bg-green-50 border border-green-200 text-xs font-semibold text-green-700 rounded flex items-center gap-2" role="alert">
        <Icon name="info" size={14} class="text-green-600 shrink-0" /> {successMessage}
      </div>
    )}

    <!-- Sub-Offices Directory Table -->
    <div class="bg-white rounded-lg border border-slate-200 shadow-sm overflow-hidden">
      <div class="p-4 border-b border-slate-200 flex items-center justify-between bg-slate-50/75">
        <h3 class="font-bold text-slate-800 text-xs uppercase tracking-wider">Registered Wings &amp; Sub-Offices ({subOffices.length})</h3>
        <span class="text-[11px] text-slate-500 font-medium">Synced with public Wing Contacts section</span>
      </div>

      <div class="overflow-x-auto">
        <table class="table-data min-w-full text-left border-collapse">
          <thead>
            <tr class="bg-slate-50 border-b border-slate-200 text-xs font-bold text-slate-500 uppercase tracking-wider select-none">
              <th scope="col" class="p-4 w-12 text-center">#</th>
              <th scope="col" class="p-4">Wing / Sub-Office</th>
              <th scope="col" class="p-4">Official / Designation</th>
              <th scope="col" class="p-4">Email</th>
              <th scope="col" class="p-4">Phone</th>
              <th scope="col" class="p-4">Address / Location</th>
              <th scope="col" class="p-4 w-36 text-center">Action</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100 font-normal">
            {subOffices.length === 0 ? (
              <tr>
                <td colspan="7" class="text-center text-slate-400 py-12 text-xs font-semibold">
                  <Icon name="folder" size={32} class="mx-auto text-slate-300 mb-2" />
                  No wing or sub-office contacts found. Add one above.
                </td>
              </tr>
            ) : (
              subOffices.map((s: any, idx: number) => (
                <tr key={s.id} class="border-b border-slate-100 hover:bg-slate-50/50 transition-colors duration-150">
                  <td class="p-4 text-center font-bold text-slate-400 text-xs">{s.viewOrder || idx + 1}</td>
                  <td class="p-4 text-xs font-bold text-slate-900">{s.wing}</td>
                  <td class="p-4 text-xs">
                    <p class="font-bold text-slate-900">{s.name}</p>
                    <p class="text-[11px] text-[#0B4F9C] font-semibold">{s.designation}</p>
                  </td>
                  <td class="p-4 text-xs">
                    {s.email ? (
                      <span class="text-slate-600 font-mono">{s.email}</span>
                    ) : (
                      <span class="text-slate-400 italic">—</span>
                    )}
                  </td>
                  <td class="p-4 text-xs">
                    {s.phone ? (
                      <span class="font-semibold text-slate-700">{s.phone}</span>
                    ) : (
                      <span class="text-slate-400 italic">—</span>
                    )}
                  </td>
                  <td class="p-4 text-xs text-slate-600">
                    {s.address || <span class="text-slate-400 italic">—</span>}
                  </td>
                  <td class="p-4 text-center flex justify-center items-center gap-2">
                    <a
                      href={`/admin/contact-sub-offices-form?id=${s.id}`}
                      class="px-2.5 py-1 bg-slate-150 hover:bg-slate-200 text-slate-700 rounded text-[11px] font-bold border border-slate-300 transition-colors cursor-pointer"
                      aria-label={`Edit ${s.wing}`}
                    >
                      Edit
                    </a>
                    <form method="POST" class="inline" onsubmit="return confirm('Are you sure you want to delete this sub-office record?');">
                      <input type="hidden" name="id" value={s.id} />
                      <input type="hidden" name="_action" value="delete" />
                      <button
                        type="submit"
                        class="px-2.5 py-1 bg-red-50 hover:bg-red-100 text-red-650 rounded text-[11px] font-bold border border-red-200 transition-colors cursor-pointer"
                        aria-label={`Delete ${s.wing}`}
                      >
                        Delete
                      </button>
                    </form>
                  </td>
                </tr>
              ))
            )}
          </tbody>
        </table>
      </div>
    </div>

  </div>
</AdminLayout>
