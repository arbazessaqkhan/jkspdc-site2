---
import AdminLayout from '../../layouts/AdminLayout.astro';
import Icon from '../../components/Icon.astro';
import { isAdmin } from '../../utils/roles';
import { parseApiError, BACKEND_URL } from '../../utils/api-error';

// Check authentication
const sessionToken = Astro.cookies.get('admin_session')?.value;
if (!sessionToken) {
  return Astro.redirect('/admin/login');
}

const userRole = Astro.locals.user?.role;
const userIsAdmin = isAdmin(userRole);

let errorMessage = '';
let successMessage = '';

// Handle Server-Side Form Actions (if submitted without JS) (ADMIN ONLY)
if (Astro.request.method === 'POST') {
  if (!userIsAdmin) {
    return Astro.redirect('/admin/ipp-projects');
  }
  try {
    const formData = await Astro.request.formData();
    const action = formData.get('_action')?.toString();

    if (action === 'delete') {
      const id = formData.get('id')?.toString();
      if (id) {
        const res = await fetch(`${BACKEND_URL}/api/ipp-projects/${id}`, {
          method: 'DELETE',
          headers: {
            'Authorization': `Bearer ${sessionToken}`,
          },
        });
        if (res.ok) {
          successMessage = 'IPP project record successfully deleted.';
        } else {
          const apiErr = await parseApiError(res, 'delete IPP project');
          if (apiErr.isUnauthorized) {
            return Astro.redirect('/admin/login');
          }
          errorMessage = apiErr.message;
        }
      }
    } else if (action === 'save') {
      const id = formData.get('id')?.toString();
      const payload = {
        name: formData.get('name')?.toString() || '',
        location: formData.get('location')?.toString() || '',
        awardedTo: formData.get('awardedTo')?.toString() || '',
        capacityMw: parseFloat(formData.get('capacityMw')?.toString() || '0'),
        status: formData.get('status')?.toString() || '',
        phase: parseInt(formData.get('phase')?.toString() || '1', 10),
      };

      if (id) {
        // Update
        const res = await fetch(`${BACKEND_URL}/api/ipp-projects/${id}`, {
          method: 'PUT',
          headers: {
            'Content-Type': 'application/json',
            'Authorization': `Bearer ${sessionToken}`,
          },
          body: JSON.stringify(payload),
        });
        if (res.ok) {
          successMessage = 'IPP project successfully updated.';
        } else {
          const apiErr = await parseApiError(res, 'update IPP project');
          if (apiErr.isUnauthorized) {
            return Astro.redirect('/admin/login');
          }
          errorMessage = apiErr.message;
        }
      } else {
        // Create
        const res = await fetch(`${BACKEND_URL}/api/ipp-projects`, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Authorization': `Bearer ${sessionToken}`,
          },
          body: JSON.stringify(payload),
        });
        if (res.ok) {
          successMessage = 'New IPP project successfully added.';
        } else {
          const apiErr = await parseApiError(res, 'create IPP project');
          if (apiErr.isUnauthorized) {
            return Astro.redirect('/admin/login');
          }
          errorMessage = apiErr.message;
        }
      }
    }
  } catch (e) {
    console.error('Error handling IPP project action:', e);
    errorMessage = 'An unexpected error occurred while saving the IPP project. Check backend service status.';
  }
}

// Fetch list of all IPP projects from backend
interface IppProjectDto {
  id: string;
  name: string;
  capacityMw: number;
  status: string;
  location: string;
  awardedTo: string;
  phase: number;
  createdAt: string;
  updatedAt: string;
}

let ippProjects: IppProjectDto[] = [];
try {
  const res = await fetch(`${BACKEND_URL}/api/ipp-projects`);
  if (res.ok) {
    ippProjects = await res.json();
  } else {
    const apiErr = await parseApiError(res, 'load IPP projects');
    if (apiErr.isUnauthorized) {
      return Astro.redirect('/admin/login');
    }
    errorMessage = apiErr.message;
  }
} catch (e) {
  console.error('Error fetching IPP projects:', e);
  errorMessage = 'Failed to load IPP projects. Unable to communicate with the server.';
}

// All 56 locations provided by the user
const locations = [
  'Akhnur', 'Anantnag', 'Awantipur', 'Badgam', 'Bandipore', 'Bandipura', 'Banihal', 'Baramula',
  'Batoti', 'Bhadarwah', 'Bijbehara', 'Bishnah', 'Doda', 'Gandarbal', 'Ganderbal', 'Gho Brahmanan de',
  'Hajan', 'Hiranagar', 'Jammu', 'Jaurian', 'Kathua', 'Katra', 'Khaur', 'Kishtwar',
  'Kud', 'Kulgam', 'Kupwara', 'Ladakh', 'Magam', 'Nawanshahr', 'Noria', 'Padam',
  'Pahlgam', 'Parol', 'Pattan', 'Pulwama', 'Punch', 'Qazigund', 'Rajaori', 'Rajauri',
  'Ramban', 'Ramgarh', 'Ramnagar', 'Riasi', 'Samba', 'Shupiyan', 'Sopur', 'Soyibug',
  'Srinagar', 'Sumbal', 'Thang', 'Thanna Mandi', 'Tral', 'Tsrar Sharif', 'Udhampur', 'Uri'
];

// All 10 Phases
const phases = [
  { value: 1, label: 'Phase 1', legacyName: 'One' },
  { value: 2, label: 'Phase 2', legacyName: 'Two' },
  { value: 3, label: 'Phase 3', legacyName: 'Three' },
  { value: 4, label: 'Phase 4', legacyName: 'Four' },
  { value: 5, label: 'Phase 5', legacyName: 'Five' },
  { value: 6, label: 'Phase 6', legacyName: 'Six' },
  { value: 7, label: 'Phase 7', legacyName: 'Seven' },
  { value: 8, label: 'Phase 8', legacyName: 'Eight' },
  { value: 9, label: 'Phase 9', legacyName: 'Nine' },
  { value: 10, label: 'Phase 10', legacyName: 'Ten' },
];

// Calculate summary stats
const totalCapacity = ippProjects.reduce((acc, p) => acc + (p.capacityMw || 0), 0);
const commissionedCount = ippProjects.filter(p => p.status.toLowerCase().includes('commissioned')).length;
const inProgressCount = ippProjects.filter(p => p.status.toLowerCase().includes('progress') || p.status.toLowerCase().includes('dpr') || p.status.toLowerCase().includes('agreement')).length;
---

<AdminLayout title="IPP Projects" description="Manage Independent Power Producer (IPP) Hydroelectric Projects Across Phases I-X." activeTab="ipp">
  <div class="flex flex-col gap-6">

    <!-- Standard Admin Page Header -->
    <div class="admin-page-header">
      <div>
        <h1 class="text-lg font-extrabold text-[#0B4F9C] tracking-tight">IPP Projects Allotments</h1>
        <p class="text-xs text-slate-500 mt-0.5">Independent Power Producer (IPP) Hydroelectric Allotments Across Phase I–X Policies.</p>
      </div>

      {userIsAdmin && (
        <button 
          id="btn-add-ipp-project"
          type="button"
          class="btn-primary flex items-center gap-1.5 text-xs py-2 px-3.5 self-start md:self-auto cursor-pointer"
        >
          <Icon name="plus" size={13} strokeWidth={2.5} />
          <span>Add IPP Project</span>
        </button>
      )}
    </div>

    <!-- Feedback messages -->
    {errorMessage && (
      <div class="p-3 bg-red-50 border border-red-200 text-xs font-semibold text-red-700 rounded flex items-center justify-between gap-2" role="alert">
        <div class="flex items-center gap-2">
          <Icon name="info" size={14} class="text-red-600 shrink-0" />
          <span>{errorMessage}</span>
        </div>
        <button type="button" onclick="this.parentElement.remove()" class="text-red-600 hover:text-red-800 text-sm font-bold cursor-pointer">&times;</button>
      </div>
    )}
    {successMessage && (
      <div class="p-3 bg-green-50 border border-green-200 text-xs font-semibold text-green-700 rounded flex items-center justify-between gap-2" role="alert">
        <div class="flex items-center gap-2">
          <Icon name="check" size={14} class="text-green-600 shrink-0" />
          <span>{successMessage}</span>
        </div>
        <button type="button" onclick="this.parentElement.remove()" class="text-green-600 hover:text-green-800 text-sm font-bold cursor-pointer">&times;</button>
      </div>
    )}

    <!-- KPI Summary Cards -->
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-3.5">
      <div class="bg-white rounded-lg border border-slate-200 p-3.5 shadow-2xs">
        <span class="text-[10px] font-bold text-slate-500 uppercase tracking-wider block">Total IPP Projects</span>
        <div class="text-xl font-extrabold text-slate-900 tracking-tight mt-0.5" id="stat-total-projects">{ippProjects.length}</div>
        <span class="text-[11px] text-slate-500 font-medium">Across 10 Phases</span>
      </div>
      <div class="bg-white rounded-lg border border-slate-200 p-3.5 shadow-2xs">
        <span class="text-[10px] font-bold text-slate-500 uppercase tracking-wider block">Allocated Capacity</span>
        <div class="text-xl font-extrabold text-[#0B4F9C] tracking-tight mt-0.5">{totalCapacity.toLocaleString('en-IN', { maximumFractionDigits: 1 })} <span class="text-xs font-medium text-slate-400">MW</span></div>
        <span class="text-[11px] text-slate-500 font-medium">Generation Potential</span>
      </div>
      <div class="bg-white rounded-lg border border-slate-200 p-3.5 shadow-2xs">
        <span class="text-[10px] font-bold text-slate-500 uppercase tracking-wider block">Commissioned</span>
        <div class="text-xl font-extrabold text-emerald-700 tracking-tight mt-0.5">{commissionedCount}</div>
        <span class="text-[11px] text-emerald-700 font-medium">Active Commercial</span>
      </div>
      <div class="bg-white rounded-lg border border-slate-200 p-3.5 shadow-2xs">
        <span class="text-[10px] font-bold text-slate-500 uppercase tracking-wider block">Execution &amp; DPR</span>
        <div class="text-xl font-extrabold text-amber-700 tracking-tight mt-0.5">{inProgressCount}</div>
        <span class="text-[11px] text-amber-700 font-medium">Under Development</span>
      </div>
    </div>

    <!-- Filter & Search Controls Bar -->
    <div class="admin-toolbar">
      <div class="flex flex-wrap items-center gap-3 flex-1 min-w-0">
        <!-- Phase Dropdown -->
        <div class="flex items-center gap-2">
          <label for="filter-phase" class="text-xs font-bold text-slate-600 whitespace-nowrap">Phase:</label>
          <select 
            id="filter-phase" 
            class="bg-slate-50 border border-slate-300 rounded text-xs font-medium text-slate-800 px-2.5 py-1.5 focus:ring-1 focus:ring-[#0B4F9C] outline-none"
          >
            <option value="all">All Phases (10 Phases)</option>
            {phases.map((ph) => (
              <option value={ph.value.toString()}>{ph.label} ({ph.legacyName})</option>
            ))}
          </select>
        </div>

        <span class="text-xs font-medium text-slate-300 hidden sm:inline">|</span>

        <!-- Search Input -->
        <div class="relative flex-grow sm:flex-grow-0 sm:w-64">
          <input 
            type="text" 
            id="search-ipp-input"
            placeholder="Search name, location, company..." 
            class="w-full bg-slate-50 border border-slate-300 rounded text-xs text-slate-800 pl-8 pr-3 py-1.5 focus:ring-1 focus:ring-[#0B4F9C] focus:border-[#0B4F9C] outline-none"
          />
          <div class="absolute left-2.5 top-2 text-slate-400">
            <Icon name="search" size={13} />
          </div>
        </div>
      </div>

      <div class="text-xs text-slate-500 font-medium shrink-0">
        Showing <span id="count-visible" class="font-bold text-slate-800">{ippProjects.length}</span> of <span class="font-bold text-slate-800">{ippProjects.length}</span> projects
      </div>
    </div>

    <!-- IPP Projects Data Table -->
    <div class="admin-table-container">
      <table class="table-data min-w-full text-left" id="ipp-table">
        <thead>
          <tr>
            <th scope="col" class="w-12 text-center">#</th>
            <th scope="col" class="min-w-[140px]">Name</th>
            <th scope="col" class="w-32 whitespace-nowrap text-left">Installed Capacity in MW</th>
            <th scope="col" class="min-w-[220px]">Status</th>
            <th scope="col" class="w-28 text-left">Location</th>
            <th scope="col" class="min-w-[160px] text-left">Awarded To</th>
            <th scope="col" class="w-16 text-center">Phase</th>
            {userIsAdmin && (
              <th scope="col" class="w-20 text-center sticky-col-right">Action</th>
            )}
          </tr>
        </thead>
        <tbody id="ipp-table-body">
          {ippProjects.length === 0 ? (
            <tr>
              <td colspan={userIsAdmin ? 8 : 7} class="text-center py-12 text-slate-500 italic text-xs font-semibold">No IPP projects recorded in database yet.</td>
            </tr>
          ) : (
            ippProjects.map((item, index) => {
              return (
                <tr 
                  class="transition-colors ipp-row hover:bg-slate-50/70"
                  data-id={item.id}
                  data-phase={item.phase.toString()}
                  data-name={item.name.toLowerCase()}
                  data-location={item.location.toLowerCase()}
                  data-awarded={item.awardedTo.toLowerCase()}
                  data-status={item.status.toLowerCase()}
                >
                  <td class="text-center font-bold text-slate-400 text-xs row-index">{index + 1}</td>
                  <td class="font-bold text-slate-900 text-xs cell-name">{item.name}</td>
                  <td class="font-semibold text-slate-800 text-left text-xs cell-capacity">
                    {item.capacityMw}
                  </td>
                  <td class="cell-status text-xs text-slate-700 leading-relaxed whitespace-normal break-words py-2.5">
                    {item.status}
                  </td>
                  <td class="text-slate-700 text-xs cell-location">{item.location || '—'}</td>
                  <td class="text-slate-700 text-xs cell-awarded">{item.awardedTo || '—'}</td>
                  <td class="text-center text-xs font-semibold text-slate-800 cell-phase">
                    {item.phase}
                  </td>
                  {userIsAdmin && (
                    <td class="td-actions sticky-col-right">
                      <div class="admin-action-group">
                        <button 
                          type="button" 
                          class="btn-edit-ipp admin-btn-action"
                          title="Edit IPP Project"
                          aria-label={`Edit ${item.name}`}
                          data-project={JSON.stringify(item)}
                        >
                          <Icon name="pencil" size={13} />
                        </button>
                        <button 
                          type="button" 
                          class="btn-delete-ipp admin-btn-action action-delete"
                          title="Delete IPP Project"
                          aria-label={`Delete ${item.name}`}
                          data-id={item.id}
                          data-name={item.name}
                        >
                          <Icon name="trash-2" size={13} />
                        </button>
                      </div>
                    </td>
                  )}
                </tr>
              );
            })
          )}
          <tr id="no-matching-ipp-row" style="display: none;">
            <td colspan={userIsAdmin ? 8 : 7} class="text-center py-12 text-slate-500 italic text-xs font-semibold">
              No IPP projects found matching your search or filter criteria.
            </td>
          </tr>
        </tbody>
      </table>
    </div>

    <!-- MODAL: Add / Edit IPP Project (Matches Screenshot 2) -->
    {userIsAdmin && (
      <div id="ipp-modal" class="fixed inset-0 z-50 bg-slate-900/60 backdrop-blur-xs flex items-center justify-center p-4 hidden">
      <div class="bg-white rounded-2xl border border-slate-200 shadow-2xl w-full max-w-lg max-h-[90vh] flex flex-col overflow-hidden animate-fadeInUp">
        
        <!-- Modal Header -->
        <div class="px-6 py-4 border-b border-slate-200 flex items-center justify-between bg-slate-50/70 shrink-0">
          <h3 id="modal-title" class="text-base font-extrabold text-[#0B4F9C] tracking-tight">Add IPP Project</h3>
          <button type="button" id="modal-close-btn" class="w-8 h-8 rounded-lg text-slate-400 hover:text-slate-700 hover:bg-slate-200 flex items-center justify-center text-lg font-bold cursor-pointer transition-colors">&times;</button>
        </div>

        <!-- Modal Form -->
        <form id="ipp-form" method="POST" class="p-6 flex flex-col gap-4 overflow-y-auto">
          <input type="hidden" name="_action" value="save" />
          <input type="hidden" id="form-id" name="id" value="" />

          <!-- Name -->
          <div>
            <label for="form-name" class="text-xs font-bold text-slate-700 block mb-1">Name:</label>
            <input 
              type="text" 
              id="form-name" 
              name="name" 
              required
              placeholder="Enter project name" 
              class="w-full bg-slate-50 border border-slate-300 rounded-lg text-xs text-slate-800 px-3 py-2.5 focus:ring-2 focus:ring-[#0B4F9C] focus:border-[#0B4F9C] outline-none"
            />
          </div>

          <!-- Location (Single Searchable Combobox Input with Fixed Max-Height Dropdown) -->
          <div class="relative" id="location-field-container">
            <label for="form-location" class="text-xs font-bold text-slate-700 block mb-1">Location</label>
            <div class="relative">
              <input 
                type="text" 
                id="form-location" 
                name="location" 
                required 
                autocomplete="off"
                placeholder="Search or select location..." 
                class="w-full bg-slate-50 border border-slate-300 rounded-lg text-xs text-slate-800 pl-3 pr-9 py-2.5 focus:ring-2 focus:ring-[#0B4F9C] focus:border-[#0B4F9C] focus:bg-white outline-none transition-all cursor-pointer"
                role="combobox"
                aria-autocomplete="list"
                aria-expanded="false"
                aria-controls="location-options-list"
              />
              <button 
                type="button" 
                id="location-toggle-btn"
                tabindex="-1"
                aria-label="Toggle location list"
                class="absolute right-0 top-0 bottom-0 px-2.5 flex items-center justify-center text-slate-400 hover:text-slate-600 cursor-pointer"
              >
                <Icon name="chevron-down" size={16} class="transition-transform duration-200" id="location-chevron" />
              </button>
            </div>

            <!-- Dropdown Options List with Strict Fixed Max-Height -->
            <div 
              id="location-dropdown-menu" 
              class="hidden absolute left-0 right-0 top-full mt-1 bg-white border border-slate-200 rounded-lg shadow-xl z-50 overflow-hidden"
            >
              <div 
                id="location-options-list" 
                class="max-h-40 overflow-y-auto divide-y divide-slate-100 text-xs" 
                role="listbox"
              >
                {locations.map((loc) => (
                  <div 
                    class="location-option px-3 py-2.5 hover:bg-[#EAF4FF] hover:text-[#0B4F9C] cursor-pointer text-slate-700 transition-colors flex items-center justify-between"
                    role="option"
                    data-value={loc}
                  >
                    <span>{loc}</span>
                  </div>
                ))}
                <div id="no-location-found" class="hidden px-3 py-3 text-center text-xs text-slate-400">
                  No matching locations found
                </div>
              </div>
            </div>
          </div>

          <!-- Awarded To -->
          <div>
            <label for="form-awarded-to" class="text-xs font-bold text-slate-700 block mb-1">Awarded To:</label>
            <input 
              type="text" 
              id="form-awarded-to" 
              name="awardedTo" 
              required
              placeholder="Enter awarded to" 
              class="w-full bg-slate-50 border border-slate-300 rounded-lg text-xs text-slate-800 px-3 py-2.5 focus:ring-2 focus:ring-[#0B4F9C] focus:border-[#0B4F9C] outline-none"
            />
          </div>

          <!-- Installed Capacity -->
          <div>
            <label for="form-capacity" class="text-xs font-bold text-slate-700 block mb-1">Installed Capacity</label>
            <input 
              type="number" 
              step="0.01" 
              min="0"
              id="form-capacity" 
              name="capacityMw" 
              required
              placeholder="Enter capacity" 
              class="w-full bg-slate-50 border border-slate-300 rounded-lg text-xs text-slate-800 px-3 py-2.5 focus:ring-2 focus:ring-[#0B4F9C] focus:border-[#0B4F9C] outline-none"
            />
          </div>

          <!-- Status -->
          <div>
            <label for="form-status" class="text-xs font-bold text-slate-700 block mb-1">Status:</label>
            <textarea 
              id="form-status" 
              name="status" 
              rows="3"
              required
              placeholder="Enter status" 
              class="w-full bg-slate-50 border border-slate-300 rounded-lg text-xs text-slate-800 px-3 py-2 focus:ring-2 focus:ring-[#0B4F9C] focus:border-[#0B4F9C] outline-none resize-y"
            ></textarea>
          </div>

          <!-- State (Phases 1-10) -->
          <div>
            <label for="form-phase" class="text-xs font-bold text-slate-700 block mb-1">State</label>
            <select 
              id="form-phase" 
              name="phase" 
              required
              class="w-full bg-slate-50 border border-slate-300 rounded-lg text-xs text-slate-800 px-3 py-2.5 focus:ring-2 focus:ring-[#0B4F9C] focus:border-[#0B4F9C] outline-none"
            >
              {phases.map((ph) => (
                <option value={ph.value.toString()}>{ph.label}</option>
              ))}
            </select>
          </div>

          <!-- Modal Action Buttons -->
          <div class="flex items-center justify-end gap-3 pt-3 border-t border-slate-200">
            <button 
              type="button" 
              id="modal-reset-btn"
              class="bg-slate-200 hover:bg-slate-300 text-slate-700 text-xs font-bold px-4 py-2.5 rounded-lg transition-colors cursor-pointer"
            >
              Reset
            </button>
            <button 
              type="submit" 
              class="bg-[#0B4F9C] hover:bg-[#084A8F] text-white text-xs font-bold px-5 py-2.5 rounded-lg shadow-xs hover:shadow-md transition-all cursor-pointer"
            >
              Submit
            </button>
          </div>
        </form>
      </div>
    </div>

    <!-- MODAL: Delete Confirmation -->
    <div id="delete-modal" class="fixed inset-0 z-50 bg-slate-900/60 backdrop-blur-xs flex items-center justify-center p-4 hidden">
      <div class="bg-white rounded-2xl border border-slate-200 shadow-2xl w-full max-w-sm overflow-hidden p-6 flex flex-col gap-4 text-center">
        <div class="w-12 h-12 rounded-full bg-rose-100 text-rose-600 flex items-center justify-center mx-auto">
          <Icon name="trash-2" size={24} strokeWidth={2.2} />
        </div>
        <div>
          <h3 class="text-base font-extrabold text-slate-900">Delete IPP Project?</h3>
          <p class="text-xs text-slate-500 mt-1">Are you sure you want to delete <span id="delete-project-name" class="font-bold text-slate-800"></span>? This action cannot be undone.</p>
        </div>
        <form method="POST" class="flex items-center justify-center gap-3 mt-2">
          <input type="hidden" name="_action" value="delete" />
          <input type="hidden" id="delete-project-id" name="id" value="" />
          <button 
            type="button" 
            id="cancel-delete-btn"
            class="bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-bold px-4 py-2.5 rounded-lg transition-colors cursor-pointer"
          >
            Cancel
          </button>
          <button 
            type="submit" 
            class="bg-rose-600 hover:bg-rose-700 text-white text-xs font-bold px-5 py-2.5 rounded-lg shadow-xs hover:shadow-md transition-all cursor-pointer"
          >
            Yes, Delete
          </button>
        </form>
      </div>
    </div>
    )}

  </div>

  <!-- Client-Side Filtering, Modal, and Search Handlers -->
  <script is:inline>
    function initIppPage() {
      var modal = document.getElementById('ipp-modal');
      var deleteModal = document.getElementById('delete-modal');
      var form = document.getElementById('ipp-form');
      var modalTitle = document.getElementById('modal-title');
      var btnAdd = document.getElementById('btn-add-ipp-project');
      var btnCloseModal = document.getElementById('modal-close-btn');
      var btnReset = document.getElementById('modal-reset-btn');
      var btnCancelDelete = document.getElementById('cancel-delete-btn');
      
      var filterPhase = document.getElementById('filter-phase');
      var searchInput = document.getElementById('search-ipp-input');
      var countVisible = document.getElementById('count-visible');
      var rows = document.querySelectorAll('.ipp-row');

      // Location Single Combobox Handlers (Search & Select on same input)
      var locInput = document.getElementById('form-location');
      var locToggleBtn = document.getElementById('location-toggle-btn');
      var locMenu = document.getElementById('location-dropdown-menu');
      var locChevron = document.getElementById('location-chevron');
      var locOptions = document.querySelectorAll('.location-option');
      var locNoFound = document.getElementById('no-location-found');

      function closeLocationDropdown() {
        if (locMenu) locMenu.classList.add('hidden');
        if (locChevron) locChevron.classList.remove('rotate-180');
        if (locInput) locInput.setAttribute('aria-expanded', 'false');
      }

      function openLocationDropdown() {
        if (locMenu) locMenu.classList.remove('hidden');
        if (locChevron) locChevron.classList.add('rotate-180');
        if (locInput) {
          locInput.setAttribute('aria-expanded', 'true');
          filterLocationOptions(locInput.value);
        }
      }

      function filterLocationOptions(q) {
        var term = (q || '').toLowerCase().trim();
        var matchCount = 0;
        locOptions.forEach(function(opt) {
          var val = (opt.getAttribute('data-value') || '').toLowerCase();
          if (!term || val.includes(term)) {
            opt.style.display = '';
            matchCount++;
          } else {
            opt.style.display = 'none';
          }
        });
        if (locNoFound) {
          locNoFound.classList.toggle('hidden', matchCount > 0);
        }
      }

      if (locInput) {
        locInput.onfocus = function() {
          openLocationDropdown();
        };
        locInput.onclick = function(e) {
          e.stopPropagation();
          openLocationDropdown();
        };
        locInput.oninput = function() {
          openLocationDropdown();
          filterLocationOptions(locInput.value);
        };
      }

      if (locToggleBtn) {
        locToggleBtn.onclick = function(e) {
          e.stopPropagation();
          if (locMenu && locMenu.classList.contains('hidden')) {
            openLocationDropdown();
            if (locInput) locInput.focus();
          } else {
            closeLocationDropdown();
          }
        };
      }

      locOptions.forEach(function(opt) {
        opt.onclick = function(e) {
          e.stopPropagation();
          var val = opt.getAttribute('data-value') || '';
          if (locInput) {
            locInput.value = val;
            locInput.focus();
          }
          closeLocationDropdown();
        };
      });

      document.addEventListener('click', function(e) {
        var container = document.getElementById('location-field-container');
        if (container && !container.contains(e.target)) {
          closeLocationDropdown();
        }
      });

      // Open Add Modal
      if (btnAdd) {
        btnAdd.onclick = function() {
          form.reset();
          document.getElementById('form-id').value = '';
          if (locInput) locInput.value = '';
          closeLocationDropdown();
          modalTitle.textContent = 'Add IPP Project';
          modal.classList.remove('hidden');
        };
      }

      // Close Modals
      if (btnCloseModal) {
        btnCloseModal.onclick = function() {
          modal.classList.add('hidden');
          closeLocationDropdown();
        };
      }
      if (modal) {
        modal.onclick = function(e) {
          if (e.target === modal) {
            modal.classList.add('hidden');
            closeLocationDropdown();
          }
        };
      }
      if (deleteModal) {
        deleteModal.onclick = function(e) {
          if (e.target === deleteModal) deleteModal.classList.add('hidden');
        };
      }
      window.onkeydown = function(e) {
        if (e.key === 'Escape') {
          if (modal) {
            modal.classList.add('hidden');
            closeLocationDropdown();
          }
          if (deleteModal) deleteModal.classList.add('hidden');
        }
      };
      if (btnReset) {
        btnReset.onclick = function() {
          form.reset();
          if (locInput) locInput.value = '';
          closeLocationDropdown();
        };
      }
      if (btnCancelDelete) {
        btnCancelDelete.onclick = function() {
          deleteModal.classList.add('hidden');
        };
      }

      // Edit Button Handler
      document.querySelectorAll('.btn-edit-ipp').forEach(function(btn) {
        btn.onclick = function() {
          var dataStr = btn.getAttribute('data-project');
          if (!dataStr) return;
          try {
            var item = JSON.parse(dataStr);
            document.getElementById('form-id').value = item.id || '';
            document.getElementById('form-name').value = item.name || '';
            if (locInput) locInput.value = item.location || '';
            document.getElementById('form-awarded-to').value = item.awardedTo || '';
            document.getElementById('form-capacity').value = item.capacityMw || '';
            document.getElementById('form-status').value = item.status || '';
            document.getElementById('form-phase').value = item.phase ? item.phase.toString() : '1';
            
            modalTitle.textContent = 'Edit IPP Project';
            modal.classList.remove('hidden');
          } catch (err) {
            console.error('Error parsing project data:', err);
          }
        };
      });

      // Delete Button Handler
      document.querySelectorAll('.btn-delete-ipp').forEach(function(btn) {
        btn.onclick = function() {
          var id = btn.getAttribute('data-id');
          var name = btn.getAttribute('data-name');
          document.getElementById('delete-project-id').value = id || '';
          document.getElementById('delete-project-name').textContent = name || '';
          deleteModal.classList.remove('hidden');
        };
      });

      // Filter & Search Logic
      function applyFilterAndSearch() {
        var selectedPhase = filterPhase ? filterPhase.value : 'all';
        var query = searchInput ? searchInput.value.toLowerCase().trim() : '';
        var visibleCount = 0;

        rows.forEach(function(row) {
          var phase = row.getAttribute('data-phase');
          var name = row.getAttribute('data-name') || '';
          var location = row.getAttribute('data-location') || '';
          var awarded = row.getAttribute('data-awarded') || '';
          var status = row.getAttribute('data-status') || '';

          var matchesPhase = (selectedPhase === 'all' || phase === selectedPhase);
          var matchesQuery = !query || name.includes(query) || location.includes(query) || awarded.includes(query) || status.includes(query);

          if (matchesPhase && matchesQuery) {
            row.style.display = '';
            visibleCount++;
            var indexCell = row.querySelector('.row-index');
            if (indexCell) indexCell.textContent = visibleCount.toString();
          } else {
            row.style.display = 'none';
          }
        });

        if (countVisible) countVisible.textContent = visibleCount.toString();
        var emptyRow = document.getElementById('no-matching-ipp-row');
        if (emptyRow) {
          emptyRow.style.display = (visibleCount === 0 && rows.length > 0) ? 'table-row' : 'none';
        }
      }

      if (filterPhase) filterPhase.onchange = applyFilterAndSearch;
      if (searchInput) searchInput.oninput = applyFilterAndSearch;
    }

    document.addEventListener('astro:page-load', initIppPage);
    initIppPage();
  </script>
</AdminLayout>
