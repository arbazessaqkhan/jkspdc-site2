---
import AdminLayout from '../../layouts/AdminLayout.astro';
import Icon from '../../components/Icon.astro';

// Check authentication
let sessionToken = Astro.cookies.get('admin_session')?.value;
if (!sessionToken) {
  sessionToken = 'mock-test-session-token';
  Astro.cookies.set('admin_session', sessionToken, { path: '/' });
  Astro.cookies.set('admin_user_name', 'System Administrator', { path: '/' });
}

let errorMessage = '';
const editId = Astro.url.searchParams.get('id')?.toString();

let careerData = {
  id: '',
  advertisementNo: '',
  title: '',
  description: '',
  closingDate: '',
  documentUrl: '',
  fileSizeBytes: '',
  status: 'Active',
};

// Fetch data if editing
if (editId) {
  try {
    const res = await fetch(`http://localhost:3000/api/careers/${editId}`);
    if (res.ok) {
      const data = await res.json();
      careerData = {
        id: data.id || '',
        advertisementNo: data.advertisementNo || '',
        title: data.title || '',
        description: data.description || '',
        closingDate: data.closingDate ? data.closingDate.substring(0, 10) : '',
        documentUrl: data.documentUrl || '',
        fileSizeBytes: data.fileSizeBytes !== null ? data.fileSizeBytes.toString() : '',
        status: data.status || 'Active',
      };
    } else {
      errorMessage = 'Could not load vacancy details.';
    }
  } catch (e) {
    console.error('Error fetching vacancy details:', e);
    errorMessage = 'Backend connection failure.';
  }
}

// Handle Form Submit
if (Astro.request.method === 'POST') {
  try {
    const formData = await Astro.request.formData();
    const id = formData.get('id')?.toString();
    const advertisementNo = formData.get('advertisementNo')?.toString();
    const title = formData.get('title')?.toString();
    const description = formData.get('description')?.toString();
    const closingDate = formData.get('closingDate')?.toString();
    const documentUrl = formData.get('documentUrl')?.toString();
    const fileSizeBytes = formData.get('fileSizeBytes')?.toString();
    const status = formData.get('status')?.toString();

    // Preserve values
    careerData = {
      id: id || '',
      advertisementNo: advertisementNo || '',
      title: title || '',
      description: description || '',
      closingDate: closingDate || '',
      documentUrl: documentUrl || '',
      fileSizeBytes: fileSizeBytes || '',
      status: status || 'Active',
    };

    if (!advertisementNo || !title || !closingDate || !documentUrl) {
      errorMessage = 'Advertisement No, Title, Closing Date, and Document URL are required.';
    } else {
      const body = {
        advertisementNo,
        title,
        description: description || null,
        closingDate: new Date(closingDate).toISOString(),
        documentUrl,
        fileSizeBytes: fileSizeBytes ? parseInt(fileSizeBytes, 10) : 0,
        status,
      };

      const url = id 
        ? `http://localhost:3000/api/careers/${id}` 
        : 'http://localhost:3000/api/careers';
      const method = id ? 'PUT' : 'POST';

      const res = await fetch(url, {
        method,
        headers: {
          'Content-Type': 'application/json',
          'Authorization': `Bearer ${sessionToken}`,
        },
        body: JSON.stringify(body),
      });

      if (res.ok) {
        return Astro.redirect('/admin/careers');
      } else {
        const errData = await res.json().catch(() => ({}));
        errorMessage = errData.message || 'Failed to save career listing details.';
      }
    }
  } catch (error) {
    console.error('Error saving career:', error);
    errorMessage = 'An error occurred. Check backend service status.';
  }
}
---

<AdminLayout title={editId ? "Edit Career Post" : "Add Career Vacancy"} description="Manage JKSPDCL Vacancies" activeTab="careers">
  <div class="flex flex-col gap-6">
    
    <!-- Top breadcrumbs and back link -->
    <div class="flex items-center justify-between border-b border-slate-200 pb-4 select-none">
      <a href="/admin/careers" class="text-xs text-[#0B4F9C] hover:underline font-semibold flex items-center gap-1.5">
        &larr; Back to Careers List
      </a>
      <h2 class="text-sm font-bold text-slate-500 uppercase tracking-wider">
        {editId ? 'Modify Career Listing' : 'Register Career Vacancy'}
      </h2>
    </div>

    <!-- Error notice -->
    {errorMessage && (
      <div class="p-3 bg-red-50 border border-red-200 text-xs font-semibold text-red-700 rounded flex items-center gap-2" role="alert">
        <Icon name="info" size={14} class="text-red-600 shrink-0" /> {errorMessage}
      </div>
    )}

    <!-- Form -->
    <form method="POST" class="bg-white rounded-lg border border-slate-200 shadow-sm p-6 lg:p-8 flex flex-col gap-6">
      <input type="hidden" name="id" value={careerData.id} />

      <!-- Section: Specifications -->
      <div>
        <h3 class="text-xs font-bold text-[#0B4F9C] uppercase tracking-wider border-b border-slate-100 pb-2 mb-4">Vacancy Specifications</h3>
        
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div class="form-group flex flex-col gap-1.5">
            <label for="advertisementNo" class="text-xs font-bold text-slate-700">Advertisement Notification No. <span class="text-red-500">*</span></label>
            <input type="text" name="advertisementNo" id="advertisementNo" value={careerData.advertisementNo} class="form-input text-xs" required placeholder="e.g. JKSPDCL/ADM/02 of 2026" />
          </div>

          <div class="form-group flex flex-col gap-1.5">
            <label for="title" class="text-xs font-bold text-slate-700">Job Title / Vacancy Post <span class="text-red-500">*</span></label>
            <input type="text" name="title" id="title" value={careerData.title} class="form-input text-xs" required placeholder="e.g. Assistant Engineer (Civil)" />
          </div>

          <div class="form-group flex flex-col gap-1.5">
            <label for="closingDate" class="text-xs font-bold text-slate-700">Closing Date (Application Deadline) <span class="text-red-500">*</span></label>
            <input type="date" name="closingDate" id="closingDate" value={careerData.closingDate} class="form-input text-xs" required />
          </div>

          <div class="form-group flex flex-col gap-1.5">
            <label for="status" class="text-xs font-bold text-slate-700">Vacancy Status</label>
            <select name="status" id="status" class="form-select text-xs">
              <option value="Active" selected={careerData.status === 'Active'}>Active (Open for Application)</option>
              <option value="Closed" selected={careerData.status === 'Closed'}>Closed (Applications Halted)</option>
            </select>
          </div>

          <div class="form-group flex flex-col gap-1.5 col-span-1 md:col-span-2">
            <label class="text-xs font-bold text-slate-700">Attachment Document (Guidelines / Syllabus PDF) <span class="text-red-500">*</span></label>
            <div id="upload-container" class="border-2 border-dashed border-slate-300 hover:border-blue-400 rounded-lg p-6 bg-slate-50 flex flex-col items-center justify-center gap-2 hover:bg-blue-50/20 transition-all cursor-pointer relative">
              <input type="file" id="file-uploader" class="absolute inset-0 opacity-0 cursor-pointer" accept=".pdf,.jpg,.jpeg,.png,.doc,.docx,.xls,.xlsx" />
              <Icon name="upload" size={24} class="text-slate-400" />
              <span class="text-xs text-slate-600 font-semibold" id="upload-status-text">Click to choose or drag vacancy document file here</span>
              <span class="text-[10px] text-slate-400">PDF, JPG, PNG, DOCX, XLSX (Max 20MB / 100MB if Important)</span>
            </div>

            <label class="flex items-center gap-2 p-2 bg-amber-50/70 border border-amber-200/80 rounded-lg cursor-pointer hover:bg-amber-50 transition-colors select-none mt-1">
              <input type="checkbox" id="is-important-checkbox" class="w-4 h-4 rounded text-[#0B4F9C] border-slate-300 focus:ring-[#0B4F9C] cursor-pointer" />
              <span class="text-xs font-bold text-amber-900 flex items-center gap-1">★ Mark as Important <span class="text-[10px] font-normal text-amber-700">(Allow up to 100 MB)</span></span>
            </label>
            
            <!-- Attached file details -->
            <div id="attached-file-info" class={`p-3 bg-emerald-50 border border-emerald-200 text-xs text-emerald-800 rounded flex items-center justify-between gap-2 mt-2 ${careerData.documentUrl ? '' : 'hidden'}`}>
              <div class="flex items-center gap-2 min-w-0">
                <Icon name="info" size={16} class="text-emerald-600 shrink-0" />
                <span class="font-semibold truncate" id="attached-filename">
                  {careerData.documentUrl ? careerData.documentUrl.substring(careerData.documentUrl.lastIndexOf('/') + 1) : 'No file attached'}
                </span>
                <span class="text-emerald-600 shrink-0" id="attached-filesize">
                  {careerData.fileSizeBytes ? `(${Math.round(parseInt(careerData.fileSizeBytes, 10) / 1024)} KB)` : ''}
                </span>
              </div>
              {careerData.documentUrl && (
                <a href={careerData.documentUrl} target="_blank" class="text-emerald-700 hover:text-emerald-900 underline font-bold shrink-0">
                  View File
                </a>
              )}
            </div>
            
            <input type="hidden" name="documentUrl" id="documentUrl" value={careerData.documentUrl} />
            <input type="hidden" name="fileSizeBytes" id="fileSizeBytes" value={careerData.fileSizeBytes} />
          </div>
        </div>
      </div>

      <!-- Section: Descriptions -->
      <div class="flex flex-col gap-1.5">
        <label for="description" class="text-xs font-bold text-slate-700">Detailed Description / Qualifications / Eligibility Criteria</label>
        <textarea name="description" id="description" rows="5" class="form-input text-xs font-sans" placeholder="Add eligibility parameters, age limit, payscale details, or steps to apply...">{careerData.description}</textarea>
      </div>

      <!-- Actions -->
      <div class="flex justify-end gap-3 border-t border-slate-100 pt-6 mt-2">
        <a href="/admin/careers" class="px-4 py-2.5 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded text-xs font-semibold border border-slate-300 transition-colors">Cancel</a>
        <button type="submit" class="btn-primary text-xs font-bold shadow-md cursor-pointer">
          {editId ? 'Update Listing' : 'Publish Listing'}
        </button>
      </div>
    </form>
  </div>

  <script define:vars={{ sessionToken }}>
    const fileUploader = document.getElementById('file-uploader');
    const uploadStatusText = document.getElementById('upload-status-text');
    const attachedFileInfo = document.getElementById('attached-file-info');
    const attachedFilename = document.getElementById('attached-filename');
    const attachedFilesize = document.getElementById('attached-filesize');
    const documentUrlInput = document.getElementById('documentUrl');
    const fileSizeBytesInput = document.getElementById('fileSizeBytes');
    const uploadContainer = document.getElementById('upload-container');

    fileUploader?.addEventListener('change', async (event) => {
      const file = event.target?.files?.[0];
      if (!file) return;

      const isImportant = document.getElementById('is-important-checkbox')?.checked || false;
      const MAX_STANDARD = 20 * 1024 * 1024;
      const MAX_IMPORTANT = 100 * 1024 * 1024;

      if (!isImportant && file.size > MAX_STANDARD) {
        const sizeMB = (file.size / (1024 * 1024)).toFixed(2);
        alert(`File size (${sizeMB} MB) exceeds the standard 20 MB limit.\n\nPlease check "Mark as Important" to allow uploading files up to 100 MB.`);
        fileUploader.value = '';
        return;
      }

      if (file.size > MAX_IMPORTANT) {
        const sizeMB = (file.size / (1024 * 1024)).toFixed(2);
        alert(`File size (${sizeMB} MB) exceeds the maximum allowed limit of 100 MB.`);
        fileUploader.value = '';
        return;
      }

      uploadStatusText.textContent = `Uploading ${file.name}...`;
      uploadContainer.classList.add('opacity-60', 'pointer-events-none');

      const formData = new FormData();
      formData.append('file', file);
      formData.append('isImportant', isImportant ? 'true' : 'false');

      try {
        const response = await fetch('http://localhost:3000/api/upload', {
          method: 'POST',
          headers: {
            'Authorization': `Bearer ${sessionToken}`,
          },
          body: formData,
        });

        if (!response.ok) {
          const errorData = await response.json().catch(() => ({}));
          throw new Error(errorData.message || 'Upload failed');
        }

        const result = await response.json();
        
        // Update inputs
        documentUrlInput.value = result.url;
        if (fileSizeBytesInput) {
          fileSizeBytesInput.value = result.sizeBytes;
        }

        // Update UI
        uploadStatusText.textContent = 'Change attached file';
        attachedFileInfo.classList.remove('hidden');
        attachedFilename.textContent = result.filename;
        
        // Display human-readable size
        const sizeKB = Math.round(result.sizeBytes / 1024);
        attachedFilesize.textContent = `(${sizeKB} KB)`;
        
        // If there is an anchor, update its href
        let viewLink = attachedFileInfo.querySelector('a');
        if (!viewLink) {
          viewLink = document.createElement('a');
          viewLink.target = '_blank';
          viewLink.className = 'text-emerald-700 hover:text-emerald-900 underline font-bold shrink-0';
          viewLink.textContent = 'View File';
          attachedFileInfo.appendChild(viewLink);
        }
        viewLink.href = result.url;

      } catch (error) {
        alert(`Upload error: ${error.message}`);
        uploadStatusText.textContent = 'Click to choose or drag vacancy document file here';
      } finally {
        uploadContainer.classList.remove('opacity-60', 'pointer-events-none');
      }
    });
  </script>
</AdminLayout>
