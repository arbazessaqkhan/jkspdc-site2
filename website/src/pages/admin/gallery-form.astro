---
import AdminLayout from '../../layouts/AdminLayout.astro';
import Icon from '../../components/Icon.astro';
import { canMutateRoutineContent } from '../../utils/roles';
import { parseApiError, BACKEND_URL } from '../../utils/api-error';

// Check authentication
const sessionToken = Astro.cookies.get('admin_session')?.value;
if (!sessionToken) {
  return Astro.redirect('/admin/login');
}

const userRole = Astro.locals.user?.role;
if (!canMutateRoutineContent(userRole)) {
  return Astro.redirect('/admin/gallery');
}

let errorMessage = '';
const editId = Astro.url.searchParams.get('id')?.toString();

let itemData = {
  id: '',
  title: '',
  partition: 'General',
  projectId: '',
  imageUrl: '',
  images: [] as { id: string; imageUrl: string; caption?: string; displayOrder?: number }[],
};

// Fetch projects for optional assignment
let projectsList: { id: string; name: string }[] = [];
try {
  const pRes = await fetch(`${BACKEND_URL}/api/public/stations`);
  if (pRes.ok) {
    const rawStations = await pRes.json();
    projectsList = rawStations.map((s: any) => ({ id: s.id, name: s.name })).sort((a: any, b: any) => a.name.localeCompare(b.name));
  }
} catch (e) {
  console.error('Error fetching projects list:', e);
}

// Fetch data if editing
if (editId) {
  try {
    const res = await fetch(`${BACKEND_URL}/api/gallery/${editId}`);
    if (res.ok) {
      const data = await res.json();
      itemData = {
        id: data.id || '',
        title: data.title || '',
        partition: data.partition || 'General',
        projectId: data.projectId || '',
        imageUrl: data.imageUrl || '',
        images: Array.isArray(data.images) && data.images.length > 0 
          ? data.images 
          : (data.imageUrl ? [{ id: 'cover', imageUrl: data.imageUrl }] : []),
      };
    } else {
      const apiErr = await parseApiError(res, 'load gallery item details');
      if (apiErr.isUnauthorized) {
        return Astro.redirect('/admin/login');
      }
      errorMessage = apiErr.message;
    }
  } catch (e) {
    console.error('Error fetching gallery details:', e);
    errorMessage = 'Failed to load gallery item details. Check backend service status.';
  }
}

// Fetch overview settings to check if this image is in Corporate Overview carousel
let isInOverview = false;
let overviewSettings = { autoplay: true, duration: 5, items: [] as any[] };
try {
  const wRes = await fetch(`${BACKEND_URL}/api/site-settings/homepage_welcome_settings`, {
    headers: { 'Authorization': `Bearer ${sessionToken}` }
  });
  if (wRes.ok) {
    const wData = await wRes.json();
    if (wData?.value) {
      try { overviewSettings = Object.assign(overviewSettings, JSON.parse(wData.value)); } catch {}
    }
  }
} catch {}

if (itemData.id || itemData.imageUrl) {
  isInOverview = Array.isArray(overviewSettings.items) && overviewSettings.items.some(
    (it: any) => (itemData.id && it.id === itemData.id) || (itemData.imageUrl && it.imageUrl === itemData.imageUrl)
  );
}

function getImageUrl(url: string) {
  if (!url) return '';
  if (url.startsWith('/uploads/')) {
    return `${BACKEND_URL}${url}`;
  }
  return url;
}

// Handle Form Submission
if (Astro.request.method === 'POST') {
  try {
    const formData = await Astro.request.formData();
    const id = formData.get('id')?.toString();
    const title = formData.get('title')?.toString()?.trim() || '';
    const partition = formData.get('partition')?.toString()?.trim() || 'General';
    const projectId = formData.get('projectId')?.toString()?.trim() || '';
    const imagesJson = formData.get('imagesJson')?.toString()?.trim() || '[]';

    let imagesList: string[] = [];
    try {
      imagesList = JSON.parse(imagesJson);
    } catch {
      imagesList = [];
    }

    itemData = {
      id: id || '',
      title,
      partition,
      projectId,
      imageUrl: imagesList[0] || '',
      images: imagesList.map((url, i) => ({ id: `img-${i}`, imageUrl: url })),
    };

    if (!title) {
      errorMessage = 'Gallery Title is mandatory.';
    } else if (imagesList.length === 0) {
      errorMessage = 'At least 1 photo is required. Please upload photos for this gallery.';
    } else {
      const selectedProject = projectsList.find((p) => p.id === projectId);
      const payload: Record<string, any> = {
        title,
        partition,
        imageUrl: imagesList[0],
        images: imagesList,
        projectId: projectId || null,
        projectName: selectedProject ? selectedProject.name : null,
        status: 'Active',
      };

      const targetUrl = editId ? `${BACKEND_URL}/api/gallery/${editId}` : `${BACKEND_URL}/api/gallery`;
      const method = editId ? 'PUT' : 'POST';

      const res = await fetch(targetUrl, {
        method,
        headers: {
          'Content-Type': 'application/json',
          'Authorization': `Bearer ${sessionToken}`,
        },
        body: JSON.stringify(payload),
      });

      if (res.ok) {
        const savedItem = await res.json().catch(() => ({}));
        const itemId = savedItem.id || editId || id;
        const wantOverview = formData.get('featuredInOverview') === 'true';

        let items = Array.isArray(overviewSettings.items) ? [...overviewSettings.items] : [];
        const primaryImage = imagesList[0];
        const idx = items.findIndex((it: any) => (itemId && it.id === itemId) || it.imageUrl === primaryImage);

        if (wantOverview && idx < 0) {
          items.push({
            id: itemId,
            title,
            imageUrl: primaryImage,
            displayOrder: items.length + 1,
            isActive: true,
          });
          await fetch(`${BACKEND_URL}/api/site-settings/homepage_welcome_settings`, {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json', 'Authorization': `Bearer ${sessionToken}` },
            body: JSON.stringify({ value: JSON.stringify({ ...overviewSettings, items }) }),
          }).catch(() => null);
        } else if (!wantOverview && idx >= 0) {
          items.splice(idx, 1);
          await fetch(`${BACKEND_URL}/api/site-settings/homepage_welcome_settings`, {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json', 'Authorization': `Bearer ${sessionToken}` },
            body: JSON.stringify({ value: JSON.stringify({ ...overviewSettings, items }) }),
          }).catch(() => null);
        }

        return Astro.redirect('/admin/gallery');
      } else {
        const apiErr = await parseApiError(res, `${editId ? 'update' : 'create'} gallery`);
        if (apiErr.isUnauthorized) {
          return Astro.redirect('/admin/login');
        }
        errorMessage = apiErr.message;
      }
    }
  } catch (err) {
    console.error('Error saving gallery item:', err);
    errorMessage = 'An unexpected error occurred while saving the gallery.';
  }
}

const existingImagesJson = JSON.stringify(
  itemData.images.map(img => img.imageUrl).filter(Boolean)
);
---

<AdminLayout 
  title={editId ? "Edit Gallery" : "Add Gallery / Album — Central Media Gallery"} 
  description="Upload and catalog single or multi-photo galleries for JKSPDCL"
  activeTab="gallery"
>
  <div class="max-w-3xl mx-auto flex flex-col gap-6">
    
    <!-- Top Breadcrumb / Navigation -->
    <div class="flex items-center gap-2 text-xs text-slate-500">
      <a href="/admin/gallery" class="hover:text-[color:var(--adm-primary)] flex items-center gap-1 font-semibold">
        &larr; Back to Central Media Gallery
      </a>
      <span>/</span>
      <span class="text-slate-800 font-bold">{editId ? 'Edit Gallery' : 'Add Gallery'}</span>
    </div>

    <!-- Header Card -->
    <div class="bg-white rounded-xl border border-slate-200 p-6 shadow-xs">
      <h1 class="text-lg font-bold text-slate-900 mb-1">
        {editId ? 'Edit Gallery / Album' : 'Create New Gallery / Album'}
      </h1>
      <p class="text-xs text-slate-500">
        Upload 1 to 15 high-resolution photographs per gallery. The first photo will serve as the cover image.
      </p>

      {errorMessage && (
        <div class="mt-4 p-3 bg-red-50 border border-red-200 text-xs font-semibold text-red-700 rounded flex items-center gap-2" role="alert">
          <Icon name="info" size={14} class="text-red-600 shrink-0" /> {errorMessage}
        </div>
      )}

      <!-- Form -->
      <form method="POST" id="gallery-album-form" class="mt-6 flex flex-col gap-5">
        {editId && <input type="hidden" name="id" value={itemData.id} />}
        <input type="hidden" name="imagesJson" id="gallery-images-json" value={existingImagesJson} />
        
        <!-- 1. Mandatory Field: Gallery Title -->
        <div class="flex flex-col gap-1.5">
          <label for="title" class="text-xs font-bold text-slate-700">
            Gallery / Event Title <span class="text-red-500">*</span>
          </label>
          <input 
            type="text" 
            id="title" 
            name="title" 
            value={itemData.title}
            placeholder="e.g. Annual Board Review Meeting 2026 or Baglihar Dam Inspection" 
            class="admin-input text-xs" 
            required 
          />
          <p class="text-[11px] text-slate-400">Clear descriptive title displayed in cards, alt-text, and public lightboxes.</p>
        </div>

        <!-- 2. Category & Associated Project (Side-by-Side) -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <!-- Category Dropdown -->
          <div class="flex flex-col gap-1.5">
            <label for="partition" class="text-xs font-bold text-slate-700">
              Category <span class="text-red-500">*</span>
            </label>
            <select 
              id="partition" 
              name="partition" 
              class="admin-input text-xs cursor-pointer"
              required
            >
              <option value="Official Events" selected={itemData.partition === 'Official Events'}>Official Events</option>
              <option value="Corporate" selected={itemData.partition === 'Corporate'}>Corporate</option>
              <option value="Projects" selected={itemData.partition === 'Projects'}>Projects</option>
              <option value="General" selected={itemData.partition === 'General' || !itemData.partition}>General</option>
            </select>
            <p class="text-[11px] text-slate-400">Controls the badge and filter tag on the public gallery.</p>
          </div>

          <!-- Associated Project (Optional) -->
          <div class="flex flex-col gap-1.5">
            <label for="projectId" class="text-xs font-bold text-slate-700">
              Associated Power Station / Project (Optional)
            </label>
            <select 
              id="projectId" 
              name="projectId" 
              class="admin-input text-xs cursor-pointer"
            >
              <option value="">— None / General Corporate —</option>
              {projectsList.map((p) => (
                <option value={p.id} selected={p.id === itemData.projectId}>
                  {p.name}
                </option>
              ))}
            </select>
            <p class="text-[11px] text-slate-400">Links photographs to the designated power station.</p>
          </div>
        </div>

        <!-- 3. Multi-Image Uploader Block -->
        <div class="flex flex-col gap-2 pt-2 border-t border-slate-100">
          <div class="flex items-center justify-between">
            <label class="text-xs font-bold text-slate-700">
              Gallery Photographs <span class="text-red-500">*</span>
            </label>
            <span id="photo-count-badge" class="text-[11px] font-semibold text-slate-500">
              0 photos selected (max 15)
            </span>
          </div>

          <!-- Drag and Drop Browse Box -->
          <div 
            id="multi-dropzone" 
            class="border-2 border-dashed border-slate-300 hover:border-[#0B5C9E] bg-slate-50/70 hover:bg-slate-50 rounded-xl p-6 text-center cursor-pointer transition-colors"
          >
            <input 
              type="file" 
              id="multi-file-input" 
              class="hidden" 
              multiple 
              accept="image/jpeg,image/png,image/webp" 
            />
            <div class="flex flex-col items-center justify-center gap-2 pointer-events-none">
              <div class="w-10 h-10 rounded-full bg-blue-50 text-[#0B5C9E] flex items-center justify-center">
                <Icon name="image" size={20} />
              </div>
              <div>
                <p class="text-xs font-bold text-slate-800">
                  Click to choose photos or drag and drop here
                </p>
                <p class="text-[11px] text-slate-500 mt-0.5">
                  Select 1 to 15 images (JPG, PNG, WebP &bull; up to 2 MB each). First image is cover.
                </p>
              </div>
            </div>
          </div>

          <!-- Upload Progress Indicator -->
          <div id="upload-status" class="hidden text-xs text-blue-700 font-semibold bg-blue-50 p-2.5 rounded-lg border border-blue-200 flex items-center gap-2">
            <span class="inline-block w-3.5 h-3.5 border-2 border-blue-600 border-t-transparent rounded-full animate-spin"></span>
            <span id="upload-status-text">Uploading photos...</span>
          </div>

          <!-- Thumbnail Grid Preview with Removal & Cover Marker -->
          <div id="preview-grid" class="grid grid-cols-2 sm:grid-cols-4 md:grid-cols-5 gap-3 mt-2">
            <!-- Rendered dynamically by JavaScript -->
          </div>
        </div>

        <!-- 4. Corporate Overview Carousel Feature -->
        <div class="p-3.5 bg-sky-50/70 border border-sky-200/80 rounded-lg">
          <label class="flex items-start gap-2.5 cursor-pointer select-none">
            <input 
              type="checkbox" 
              name="featuredInOverview" 
              value="true" 
              checked={isInOverview}
              class="w-4 h-4 text-blue-600 rounded mt-0.5" 
            />
            <div>
              <span class="text-xs font-bold text-slate-800">Feature Cover in Corporate Overview Carousel</span>
              <p class="text-[11px] text-slate-500 mt-0.5">Include this gallery's cover photograph in the "Welcome to JKSPDCL" rotating carousel on the homepage.</p>
            </div>
          </label>
        </div>

        <!-- Action Buttons -->
        <div class="flex items-center justify-end gap-3 pt-4 border-t border-slate-100">
          <a href="/admin/gallery" class="admin-btn admin-btn-secondary text-xs px-4 py-2 cursor-pointer">
            Cancel
          </a>
          {!editId && (
            <button type="button" id="btn-clear-form" class="admin-btn admin-btn-secondary text-xs px-4 py-2 cursor-pointer">
              Clear
            </button>
          )}
          <button type="submit" id="btn-submit" class="admin-btn admin-btn-primary text-xs px-5 py-2 cursor-pointer bg-[#0B5C9E] hover:bg-[#094b82] text-white font-bold rounded-lg shadow-xs transition-colors">
            {editId ? 'Update Gallery' : 'Save Gallery'}
          </button>
        </div>
      </form>
    </div>

  </div>

  <script is:inline>
    (function() {
      var dropzone = document.getElementById('multi-dropzone');
      var fileInput = document.getElementById('multi-file-input');
      var jsonInput = document.getElementById('gallery-images-json');
      var previewGrid = document.getElementById('preview-grid');
      var countBadge = document.getElementById('photo-count-badge');
      var statusBox = document.getElementById('upload-status');
      var statusText = document.getElementById('upload-status-text');
      var submitBtn = document.getElementById('btn-submit');
      var isUploading = false;

      var imagesList = [];
      try {
        imagesList = JSON.parse(jsonInput ? jsonInput.value : '[]') || [];
      } catch (e) {
        imagesList = [];
      }

      function updateUI() {
        if (jsonInput) jsonInput.value = JSON.stringify(imagesList);
        if (countBadge) {
          countBadge.textContent = imagesList.length + ' photo' + (imagesList.length === 1 ? '' : 's') + ' selected (max 15)';
        }

        if (!previewGrid) return;
        previewGrid.innerHTML = '';

        imagesList.forEach(function(url, idx) {
          var col = document.createElement('div');
          col.className = 'relative group aspect-square rounded-lg overflow-hidden border border-slate-200 bg-slate-100 shadow-2xs';

          var img = document.createElement('img');
          img.src = url.startsWith('/uploads/') ? url : url;
          img.alt = 'Photo ' + (idx + 1);
          img.className = 'w-full h-full object-cover';
          img.onerror = function() { this.src = '/slider1.jpg'; };

          // Cover badge for first image
          if (idx === 0) {
            var coverBadge = document.createElement('span');
            coverBadge.className = 'absolute top-1.5 left-1.5 px-1.5 py-0.5 rounded text-[9px] font-extrabold uppercase tracking-wider bg-emerald-600 text-white shadow-xs z-10';
            coverBadge.textContent = 'Cover';
            col.appendChild(coverBadge);
          }

          // Remove Button
          var removeBtn = document.createElement('button');
          removeBtn.type = 'button';
          removeBtn.className = 'absolute top-1.5 right-1.5 w-6 h-6 rounded-full bg-slate-900/80 hover:bg-red-600 text-white flex items-center justify-center text-xs transition-colors cursor-pointer z-10';
          removeBtn.setAttribute('aria-label', 'Remove photo ' + (idx + 1));
          removeBtn.innerHTML = '&times;';
          removeBtn.onclick = function(e) {
            e.stopPropagation();
            imagesList.splice(idx, 1);
            updateUI();
          };

          col.appendChild(img);
          col.appendChild(removeBtn);
          previewGrid.appendChild(col);
        });
      }

      // Initial render
      updateUI();

      // Dropzone click & drag events
      if (dropzone && fileInput) {
        dropzone.addEventListener('click', function() {
          if (!isUploading) fileInput.click();
        });

        dropzone.addEventListener('dragover', function(e) {
          e.preventDefault();
          dropzone.classList.add('border-[#0B5C9E]', 'bg-blue-50/40');
        });

        dropzone.addEventListener('dragleave', function() {
          dropzone.classList.remove('border-[#0B5C9E]', 'bg-blue-50/40');
        });

        dropzone.addEventListener('drop', function(e) {
          e.preventDefault();
          dropzone.classList.remove('border-[#0B5C9E]', 'bg-blue-50/40');
          if (e.dataTransfer && e.dataTransfer.files) {
            handleFiles(e.dataTransfer.files);
          }
        });

        fileInput.addEventListener('change', function(e) {
          if (e.target && e.target.files) {
            handleFiles(e.target.files);
          }
        });
      }

      async function handleFiles(filesList) {
        var files = Array.from(filesList);
        if (files.length === 0) return;

        var availableSlots = 15 - imagesList.length;
        if (availableSlots <= 0) {
          alert('Maximum 15 photos allowed per gallery.');
          return;
        }

        if (files.length > availableSlots) {
          alert('Only ' + availableSlots + ' more photo(s) can be added. The remaining will be ignored.');
          files = files.slice(0, availableSlots);
        }

        isUploading = true;
        if (submitBtn) submitBtn.disabled = true;
        if (statusBox) statusBox.classList.remove('hidden');

        for (var i = 0; i < files.length; i++) {
          var file = files[i];
          if (statusText) statusText.textContent = 'Uploading photo ' + (i + 1) + ' of ' + files.length + ' (' + file.name + ')...';

          var formData = new FormData();
          formData.append('file', file);
          formData.append('category', 'image');

          try {
            var res = await fetch('/api/admin/upload', {
              method: 'POST',
              body: formData,
            });

            if (!res.ok) {
              if (res.status === 401) {
                window.location.href = '/admin/login';
                return;
              }
              var err = await res.json().catch(function() { return {}; });
              throw new Error(err.message || 'Upload failed');
            }

            var result = await res.json();
            var rawUrl = result.url || '';
            var serverUrl = rawUrl.includes('/uploads/') ? '/uploads/' + rawUrl.split('/uploads/')[1] : rawUrl;
            if (serverUrl) {
              imagesList.push(serverUrl);
              updateUI();
            }
          } catch (err) {
            alert('Failed to upload ' + file.name + ': ' + err.message);
          }
        }

        isUploading = false;
        if (submitBtn) submitBtn.disabled = false;
        if (statusBox) statusBox.classList.add('hidden');
        if (fileInput) fileInput.value = '';
      }

      // Clear Form button
      var clearBtn = document.getElementById('btn-clear-form');
      if (clearBtn) {
        clearBtn.addEventListener('click', function() {
          if (confirm('Are you sure you want to clear this gallery form?')) {
            var form = document.getElementById('gallery-album-form');
            if (form) {
              var titleInput = document.getElementById('title');
              if (titleInput) titleInput.value = '';
              var partition = document.getElementById('partition');
              if (partition) partition.value = 'General';
              var projectId = document.getElementById('projectId');
              if (projectId) projectId.value = '';
            }
            imagesList = [];
            updateUI();
          }
        });
      }

      // Prevent submit while uploading
      var formEl = document.getElementById('gallery-album-form');
      if (formEl) {
        formEl.addEventListener('submit', function(e) {
          if (isUploading) {
            e.preventDefault();
            alert('Please wait for photos to finish uploading before saving.');
            return false;
          }
          if (imagesList.length === 0) {
            e.preventDefault();
            alert('Please select and upload at least 1 photo for this gallery.');
            return false;
          }
        });
      }
    })();
  </script>
</AdminLayout>