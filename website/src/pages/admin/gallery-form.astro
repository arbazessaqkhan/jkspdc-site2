---
import AdminLayout from '../../layouts/AdminLayout.astro';
import Icon from '../../components/Icon.astro';
import FileUploader from '../../components/admin/FileUploader.astro';
import { canMutateRoutineContent } from '../../utils/roles';
import { parseApiError, BACKEND_URL } from '../../utils/api-error';

// Check authentication
const sessionToken = Astro.cookies.get('admin_session')?.value;
if (!sessionToken) {
  return Astro.redirect('/admin/login');
}

const userRole = Astro.locals.user?.role;
if (!canMutateRoutineContent(userRole)) {
  return Astro.redirect('/admin/gallery');
}

let errorMessage = '';
const editId = Astro.url.searchParams.get('id')?.toString();

let itemData = {
  id: '',
  title: '',
  imageUrl: '',
};

// Fetch data if editing
if (editId) {
  try {
    const res = await fetch(`${BACKEND_URL}/api/gallery/${editId}`);
    if (res.ok) {
      const data = await res.json();
      itemData = {
        id: data.id || '',
        title: data.title || '',
        imageUrl: data.imageUrl || '',
      };
    } else {
      const apiErr = await parseApiError(res, 'load gallery item details');
      if (apiErr.isUnauthorized) {
        return Astro.redirect('/admin/login');
      }
      errorMessage = apiErr.message;
    }
  } catch (e) {
    console.error('Error fetching gallery details:', e);
    errorMessage = 'Failed to load gallery item details. Check backend service status.';
  }
}

// Fetch overview settings to check if this image is in Corporate Overview carousel
let isInOverview = false;
let overviewSettings = { autoplay: true, duration: 5, items: [] as any[] };
try {
  const wRes = await fetch(`${BACKEND_URL}/api/site-settings/homepage_welcome_settings`, {
    headers: { 'Authorization': `Bearer ${sessionToken}` }
  });
  if (wRes.ok) {
    const wData = await wRes.json();
    if (wData?.value) {
      try { overviewSettings = Object.assign(overviewSettings, JSON.parse(wData.value)); } catch {}
    }
  }
} catch {}

if (itemData.id || itemData.imageUrl) {
  isInOverview = Array.isArray(overviewSettings.items) && overviewSettings.items.some(
    (it: any) => (itemData.id && it.id === itemData.id) || (itemData.imageUrl && it.imageUrl === itemData.imageUrl)
  );
}

function getImageUrl(url: string) {
  if (!url) return '';
  if (url.startsWith('/uploads/')) {
    return `${BACKEND_URL}${url}`;
  }
  return url;
}

// Handle Form Submission
if (Astro.request.method === 'POST') {
  try {
    const formData = await Astro.request.formData();
    const id = formData.get('id')?.toString();
    const title = formData.get('title')?.toString()?.trim() || '';
    const imageUrl = formData.get('imageUrl')?.toString()?.trim() || '';

    itemData = {
      id: id || '',
      title,
      imageUrl,
    };

    if (!title) {
      errorMessage = 'Image Title is mandatory.';
    } else if (!imageUrl) {
      errorMessage = 'Image File is mandatory. Please select and upload an image.';
    } else {
      const payload: Record<string, any> = {
        title,
        imageUrl,
        partition: 'General',
        status: 'Active',
      };

      const targetUrl = editId ? `${BACKEND_URL}/api/gallery/${editId}` : `${BACKEND_URL}/api/gallery`;
      const method = editId ? 'PUT' : 'POST';

      const res = await fetch(targetUrl, {
        method,
        headers: {
          'Content-Type': 'application/json',
          'Authorization': `Bearer ${sessionToken}`,
        },
        body: JSON.stringify(payload),
      });

      if (res.ok) {
        const savedItem = await res.json().catch(() => ({}));
        const itemId = savedItem.id || editId || id;
        const wantOverview = formData.get('featuredInOverview') === 'true';

        let items = Array.isArray(overviewSettings.items) ? [...overviewSettings.items] : [];
        const idx = items.findIndex((it: any) => (itemId && it.id === itemId) || it.imageUrl === imageUrl);

        if (wantOverview && idx < 0) {
          items.push({
            id: itemId,
            title,
            imageUrl,
            displayOrder: items.length + 1,
            isActive: true,
          });
          await fetch(`${BACKEND_URL}/api/site-settings/homepage_welcome_settings`, {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json', 'Authorization': `Bearer ${sessionToken}` },
            body: JSON.stringify({ value: JSON.stringify({ ...overviewSettings, items }) }),
          }).catch(() => null);
        } else if (!wantOverview && idx >= 0) {
          items.splice(idx, 1);
          await fetch(`${BACKEND_URL}/api/site-settings/homepage_welcome_settings`, {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json', 'Authorization': `Bearer ${sessionToken}` },
            body: JSON.stringify({ value: JSON.stringify({ ...overviewSettings, items }) }),
          }).catch(() => null);
        }

        return Astro.redirect('/admin/gallery');
      } else {
        const apiErr = await parseApiError(res, `${editId ? 'update' : 'create'} gallery image`);
        if (apiErr.isUnauthorized) {
          return Astro.redirect('/admin/login');
        }
        errorMessage = apiErr.message;
      }
    }
  } catch (err) {
    console.error('Error saving gallery item:', err);
    errorMessage = 'An unexpected error occurred while saving the gallery image.';
  }
}
---

<AdminLayout 
  title={editId ? "Edit Gallery Image" : "Add Image — Central Media Gallery"} 
  description="Upload and catalog images in the unified media library"
  activeTab="gallery"
>
  <div class="max-w-3xl mx-auto flex flex-col gap-6">
    
    <!-- Top Breadcrumb / Navigation -->
    <div class="flex items-center gap-2 text-xs text-slate-500">
      <a href="/admin/gallery" class="hover:text-[color:var(--adm-primary)] flex items-center gap-1 font-semibold">
        &larr; Back to Central Media Gallery
      </a>
      <span>/</span>
      <span class="text-slate-800 font-bold">{editId ? 'Edit Image' : 'Add Image'}</span>
    </div>

    <!-- Header Card -->
    <div class="bg-white rounded-xl border border-slate-200 p-6 shadow-xs">
      <h1 class="text-lg font-bold text-slate-900 mb-1">
        {editId ? 'Edit Gallery Image' : 'Add Image to Media Gallery'}
      </h1>
      <p class="text-xs text-slate-500">
        All images are organized in the central gallery and can be featured in the Corporate Overview carousel.
      </p>

      {errorMessage && (
        <div class="mt-4 p-3 bg-red-50 border border-red-200 text-xs font-semibold text-red-700 rounded flex items-center gap-2" role="alert">
          <Icon name="info" size={14} class="text-red-600 shrink-0" /> {errorMessage}
        </div>
      )}

      <!-- Form -->
      <form method="POST" id="gallery-image-form" class="mt-6 flex flex-col gap-5">
        {editId && <input type="hidden" name="id" value={itemData.id} />}
        
        <!-- 1. Mandatory Field: Image Title -->
        <div class="flex flex-col gap-1.5">
          <label for="title" class="text-xs font-bold text-slate-700">
            Image Title <span class="text-red-500">*</span>
          </label>
          <input 
            type="text" 
            id="title" 
            name="title" 
            value={itemData.title}
            placeholder="e.g. Baglihar Hydroelectric Power Dam & Spillway" 
            class="admin-input text-xs" 
            required 
          />
          <p class="text-[11px] text-slate-400">Clear descriptive title displayed in cards, alt-text, and lightboxes.</p>
        </div>

        <!-- 2. Mandatory Field: Image File (Standard 2 MB limit for images) -->
        <div class="flex flex-col gap-1.5">
          <FileUploader 
            id="gallery-image-file" 
            label="Image File" 
            required={!editId && !itemData.imageUrl}
            variant="image" 
            accept="image/jpeg,image/png,image/webp" 
            helpText="JPG, PNG, or WebP"
            maxSizeMB={2}
            existingUrl={getImageUrl(itemData.imageUrl)}
            existingName={itemData.title || 'Current Photo'}
          />
          <input type="hidden" name="imageUrl" id="gallery-image-url-input" value={itemData.imageUrl} />
        </div>

        <!-- 3. Corporate Overview Carousel Feature -->
        <div class="p-3.5 bg-sky-50/70 border border-sky-200/80 rounded-lg">
          <label class="flex items-start gap-2.5 cursor-pointer select-none">
            <input 
              type="checkbox" 
              name="featuredInOverview" 
              value="true" 
              checked={isInOverview}
              class="w-4 h-4 text-blue-600 rounded mt-0.5" 
            />
            <div>
              <span class="text-xs font-bold text-slate-800">Feature in Corporate Overview Carousel</span>
              <p class="text-[11px] text-slate-500 mt-0.5">Include this photograph in the "Welcome to JKSPDCL" rotating gallery carousel on the homepage.</p>
            </div>
          </label>
        </div>

        <!-- Action Buttons -->
        <div class="flex items-center justify-end gap-3 pt-4 border-t border-slate-100">
          <a href="/admin/gallery" class="admin-btn admin-btn-secondary text-xs px-4 py-2 cursor-pointer">
            Cancel
          </a>
          {!editId && (
            <button type="button" id="btn-clear-form" class="admin-btn admin-btn-secondary text-xs px-4 py-2 cursor-pointer">
              Clear
            </button>
          )}
          <button type="submit" class="admin-btn admin-btn-primary text-xs px-5 py-2 cursor-pointer">
            {editId ? 'Update Image' : 'Save Image'}
          </button>
        </div>
      </form>
    </div>

  </div>

  <script is:inline>
    var fileInput = document.getElementById('gallery-image-file-input');
    var dropzone = document.getElementById('gallery-image-file-dropzone');
    var urlInput = document.getElementById('gallery-image-url-input');
    var submitBtn = document.querySelector('button[type="submit"]');
    var isUploading = false;
    var initialBtnText = submitBtn ? submitBtn.textContent.trim() : 'Save Image';

    function removeGalleryPhoto() {
      if (urlInput) urlInput.value = '';
      if (fileInput) fileInput.value = '';
      if (dropzone) {
        dropzone.classList.remove('has-file');
        var nameEl = dropzone.querySelector('.admin-uploader-file-name');
        var sizeEl = dropzone.querySelector('.admin-uploader-file-size');
        var preview = dropzone.querySelector('.admin-uploader-preview img');
        if (nameEl) nameEl.textContent = '';
        if (sizeEl) sizeEl.textContent = '';
        if (preview) {
          preview.src = '';
          preview.classList.add('invisible');
        }
      }
    }

    if (fileInput) {
      fileInput.addEventListener('change', async function(e) {
        var file = e.target.files && e.target.files[0];
        if (!file) return;

        isUploading = true;
        if (submitBtn) {
          submitBtn.disabled = true;
          submitBtn.textContent = 'Uploading image…';
        }
        if (dropzone) dropzone.classList.add('opacity-50', 'pointer-events-none');

        var formData = new FormData();
        formData.append('file', file);
        formData.append('category', 'image');

        try {
          var res = await fetch('/api/admin/upload', {
            method: 'POST',
            body: formData,
          });

          if (!res.ok) {
            if (res.status === 401) {
              window.location.href = '/admin/login';
              return;
            }
            var err = await res.json().catch(function() { return {}; });
            throw new Error(err.message || 'Upload failed');
          }

          var result = await res.json();
          var rawUrl = result.url || '';
          var serverUrl = rawUrl.includes('/uploads/') ? '/uploads/' + rawUrl.split('/uploads/')[1] : rawUrl;

          if (urlInput) urlInput.value = serverUrl;
          if (dropzone) {
            dropzone.classList.add('has-file');
            var nameEl = dropzone.querySelector('.admin-uploader-file-name');
            var preview = dropzone.querySelector('.admin-uploader-preview img');
            if (nameEl) nameEl.textContent = file.name;
            if (preview) {
              preview.src = serverUrl;
              preview.classList.remove('invisible');
            }
          }
        } catch (err) {
          alert('Upload failed: ' + err.message);
          removeGalleryPhoto();
        } finally {
          isUploading = false;
          if (submitBtn) {
            submitBtn.disabled = false;
            submitBtn.textContent = initialBtnText;
          }
          if (dropzone) dropzone.classList.remove('opacity-50', 'pointer-events-none');
        }
      });

      fileInput.addEventListener('uploader:cleared', removeGalleryPhoto);
    }

    // Clear form handler
    var clearBtn = document.getElementById('btn-clear-form');
    if (clearBtn) {
      clearBtn.addEventListener('click', function() {
        var form = document.getElementById('gallery-image-form');
        var titleInput = document.getElementById('title');

        var hasData = (titleInput && titleInput.value.trim() !== '') ||
          (urlInput && urlInput.value.trim() !== '');

        if (hasData) {
          if (!confirm('Are you sure you want to clear all entered form fields and selected image?')) {
            return;
          }
        }

        if (form) {
          form.querySelectorAll('input:not([type="hidden"]):not([type="submit"]):not([type="button"]):not([type="checkbox"])').forEach(function(i) { i.value = ''; });
          var overviewCb = form.querySelector('input[name="featuredInOverview"]');
          if (overviewCb) overviewCb.checked = false;
        }
        removeGalleryPhoto();
        if (titleInput) titleInput.focus();
      });
    }

    var formEl = document.getElementById('gallery-image-form');
    if (formEl) {
      formEl.addEventListener('submit', function(e) {
        if (isUploading) {
          e.preventDefault();
          alert('Please wait for the image upload to finish before saving.');
          return false;
        }
      });
    }
  </script>
</AdminLayout>
