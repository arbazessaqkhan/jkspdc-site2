---
import AdminLayout from '../../layouts/AdminLayout.astro';
import Icon from '../../components/Icon.astro';

// Check authentication
let sessionToken = Astro.cookies.get('admin_session')?.value;
if (!sessionToken) {
  sessionToken = 'mock-test-session-token';
  Astro.cookies.set('admin_session', sessionToken, { path: '/' });
  Astro.cookies.set('admin_user_name', 'System Administrator', { path: '/' });
}

let errorMessage = '';
let successMessage = '';

// Handle Delete Action
if (Astro.request.method === 'POST') {
  try {
    const formData = await Astro.request.formData();
    const action = formData.get('_action')?.toString();

    if (action === 'delete') {
      const id = formData.get('id')?.toString();
      if (id) {
        const res = await fetch(`http://localhost:3000/api/official-contacts/${id}`, {
          method: 'DELETE',
          headers: {
            'Authorization': `Bearer ${sessionToken}`,
          },
        });

        if (res.ok) {
          successMessage = 'Official contact successfully removed.';
        } else {
          errorMessage = 'Failed to remove official contact.';
        }
      }
    }
  } catch (e) {
    console.error('Error handling official contact delete:', e);
    errorMessage = 'An error occurred while connecting to backend.';
  }
}

// Fetch all official contacts (including inactive for admin)
let contacts = [];
try {
  const res = await fetch('http://localhost:3000/api/official-contacts/all', {
    headers: {
      'Authorization': `Bearer ${sessionToken}`,
    },
  });
  if (res.ok) {
    contacts = await res.json();
  } else {
    // Fallback to public endpoint
    const pubRes = await fetch('http://localhost:3000/api/official-contacts');
    if (pubRes.ok) contacts = await pubRes.json();
  }
} catch (e) {
  console.error('Error fetching official contacts:', e);
  errorMessage = 'Backend connection failed. Displaying fallback contacts.';
}
---

<AdminLayout title="Official Contacts" description="Manage Corporate Office Contacts Directory" activeTab="official-contacts">
  <div class="flex flex-col gap-6">

    <!-- Page Header -->
    <div class="admin-page-header">
      <div>
        <h1 class="admin-page-title">Official Contacts (Corporate Office)</h1>
        <p class="admin-page-subtitle">Authoritative CMS directory for Corporate Office Srinagar and Jammu leadership.</p>
      </div>
      <a 
        href="/admin/official-contacts-form" 
        class="admin-btn admin-btn-primary flex items-center gap-1.5 self-start sm:self-auto cursor-pointer"
      >
        <Icon name="plus" size={14} /> Add Official
      </a>
    </div>

    <!-- Alert Messages -->
    {errorMessage && (
      <div class="p-3 bg-red-50 border border-red-200 text-xs font-semibold text-red-700 rounded flex items-center gap-2" role="alert">
        <Icon name="info" size={14} class="text-red-600 shrink-0" /> {errorMessage}
      </div>
    )}
    {successMessage && (
      <div class="p-3 bg-green-50 border border-green-200 text-xs font-semibold text-green-700 rounded flex items-center gap-2" role="alert">
        <Icon name="info" size={14} class="text-green-600 shrink-0" /> {successMessage}
      </div>
    )}

    <!-- Administrative Data Table -->
    <div class="admin-table-container">
      <table class="admin-table">
        <thead>
          <tr>
            <th scope="col" class="w-12 text-center">#</th>
            <th scope="col" class="min-w-[200px]">Official &amp; Designation</th>
            <th scope="col" class="min-w-[180px]">Email</th>
            <th scope="col" class="min-w-[180px]">Srinagar (Phone / Fax)</th>
            <th scope="col" class="min-w-[180px]">Jammu (Phone / Fax)</th>
            <th scope="col" class="w-28 text-center sticky-col-right">Action</th>
          </tr>
        </thead>
        <tbody>
          {contacts.length === 0 ? (
            <tr>
              <td colspan="6" class="text-center text-slate-500 py-12 text-xs font-semibold italic">
                <Icon name="folder" size={32} class="mx-auto text-slate-300 mb-2" />
                No official contacts found in database.
              </td>
            </tr>
          ) : (
            contacts.map((c: any, idx: number) => (
              <tr key={c.id} class="transition-colors">
                <td class="text-center font-bold text-slate-400 text-xs">{c.viewOrder || idx + 1}</td>
                <td>
                  <p class="font-bold text-slate-900 text-xs leading-snug">{c.name}</p>
                  <p class="text-[11px] text-[#0B4F9C] font-semibold mt-0.5">{c.position}</p>
                </td>
                <td class="text-xs">
                  {c.email ? (
                    <span class="text-slate-700 font-mono font-medium">{c.email}</span>
                  ) : (
                    <span class="text-slate-400 italic">—</span>
                  )}
                </td>
                <td class="text-xs">
                  <div class="space-y-0.5">
                    {c.srinagarPhone && <p class="text-slate-700"><span class="text-slate-500 font-medium">Ph:</span> {c.srinagarPhone}</p>}
                    {c.srinagarFax && <p class="text-slate-700"><span class="text-slate-500 font-medium">Fax:</span> {c.srinagarFax}</p>}
                    {!c.srinagarPhone && !c.srinagarFax && <span class="text-slate-400 italic">—</span>}
                  </div>
                </td>
                <td class="text-xs">
                  <div class="space-y-0.5">
                    {c.jammuPhone && <p class="text-slate-700"><span class="text-slate-500 font-medium">Ph:</span> {c.jammuPhone}</p>}
                    {c.jammuFax && <p class="text-slate-700"><span class="text-slate-500 font-medium">Fax:</span> {c.jammuFax}</p>}
                    {!c.jammuPhone && !c.jammuFax && <span class="text-slate-400 italic">—</span>}
                  </div>
                </td>
                <td class="td-actions sticky-col-right text-center">
                  <div class="admin-action-group justify-center">
                    <a
                      href={`/admin/official-contacts-form?id=${c.id}`}
                      class="admin-btn-action"
                      aria-label={`Edit ${c.name}`}
                      title="Edit Official Contact"
                    >
                      <Icon name="pencil" size={13} />
                    </a>
                    <form method="POST" class="inline m-0 p-0" onsubmit="return confirm('Are you sure you want to delete this official contact?');">
                      <input type="hidden" name="id" value={c.id} />
                      <input type="hidden" name="_action" value="delete" />
                      <button
                        type="submit"
                        class="admin-btn-action action-delete"
                        aria-label={`Delete ${c.name}`}
                        title="Delete Official Contact"
                      >
                        <Icon name="trash-2" size={13} />
                      </button>
                    </form>
                  </div>
                </td>
              </tr>
            ))
          )}
        </tbody>
      </table>
    </div>

  </div>
</AdminLayout>
