---
import AdminLayout from '../../layouts/AdminLayout.astro';
import Icon from '../../components/Icon.astro';

// Check authentication
let sessionToken = Astro.cookies.get('admin_session')?.value;
if (!sessionToken) {
  sessionToken = 'mock-test-session-token';
  Astro.cookies.set('admin_session', sessionToken, { path: '/' });
  Astro.cookies.set('admin_user_name', 'System Administrator', { path: '/' });
}

let errorMessage = '';
let successMessage = '';

// Handle Delete Action
if (Astro.request.method === 'POST') {
  try {
    const formData = await Astro.request.formData();
    const action = formData.get('_action')?.toString();

    if (action === 'delete') {
      const id = formData.get('id')?.toString();
      if (id) {
        const res = await fetch(`http://localhost:3000/api/official-contacts/${id}`, {
          method: 'DELETE',
          headers: {
            'Authorization': `Bearer ${sessionToken}`,
          },
        });

        if (res.ok) {
          successMessage = 'Official contact successfully removed.';
        } else {
          errorMessage = 'Failed to remove official contact.';
        }
      }
    }
  } catch (e) {
    console.error('Error handling official contact delete:', e);
    errorMessage = 'An error occurred while connecting to backend.';
  }
}

// Fetch all official contacts (including inactive for admin)
let contacts = [];
try {
  const res = await fetch('http://localhost:3000/api/official-contacts/all', {
    headers: {
      'Authorization': `Bearer ${sessionToken}`,
    },
  });
  if (res.ok) {
    contacts = await res.json();
  } else {
    // Fallback to public endpoint
    const pubRes = await fetch('http://localhost:3000/api/official-contacts');
    if (pubRes.ok) contacts = await pubRes.json();
  }
} catch (e) {
  console.error('Error fetching official contacts:', e);
  errorMessage = 'Backend connection failed. Displaying fallback contacts.';
}
---

<AdminLayout title="Official Contacts" description="Manage Corporate Office Contacts Directory" activeTab="official-contacts">
  <div class="flex flex-col gap-6">

    <!-- Page Header -->
    <div class="bg-white rounded-lg border border-slate-200 p-6 shadow-sm flex flex-col md:flex-row md:items-center justify-between gap-4">
      <div>
        <h2 class="text-xl font-bold text-[#0B4F9C]">Official Contacts (Corporate Office)</h2>
        <p class="text-xs text-slate-500 mt-0.5">Authoritative CMS directory for Corporate Office Srinagar and Jammu leadership.</p>
      </div>
      <a 
        href="/admin/official-contacts-form" 
        class="btn-primary flex items-center gap-1.5 self-start md:self-auto cursor-pointer"
      >
        <Icon name="plus" size={14} /> Add Official
      </a>
    </div>

    <!-- Alert Messages -->
    {errorMessage && (
      <div class="p-3 bg-red-50 border border-red-200 text-xs font-semibold text-red-700 rounded flex items-center gap-2" role="alert">
        <Icon name="info" size={14} class="text-red-600 shrink-0" /> {errorMessage}
      </div>
    )}
    {successMessage && (
      <div class="p-3 bg-green-50 border border-green-200 text-xs font-semibold text-green-700 rounded flex items-center gap-2" role="alert">
        <Icon name="info" size={14} class="text-green-600 shrink-0" /> {successMessage}
      </div>
    )}

    <!-- Official Contacts Directory Table -->
    <div class="bg-white rounded-lg border border-slate-200 shadow-sm overflow-hidden">
      <div class="p-4 border-b border-slate-200 flex items-center justify-between bg-slate-50/75">
        <h3 class="font-bold text-slate-800 text-xs uppercase tracking-wider">Current Corporate Office Officials ({contacts.length})</h3>
        <span class="text-[11px] text-slate-500 font-medium">Changes here instantly reflect on the public Contact Us page</span>
      </div>

      <div class="overflow-x-auto">
        <table class="table-data min-w-full text-left border-collapse">
          <thead>
            <tr class="bg-slate-50 border-b border-slate-200 text-xs font-bold text-slate-500 uppercase tracking-wider select-none">
              <th scope="col" class="p-4 w-12 text-center">#</th>
              <th scope="col" class="p-4">Official / Designation</th>
              <th scope="col" class="p-4">Email</th>
              <th scope="col" class="p-4">Srinagar (Phone/Fax)</th>
              <th scope="col" class="p-4">Jammu (Phone/Fax)</th>
              <th scope="col" class="p-4 w-36 text-center">Action</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100 font-normal">
            {contacts.length === 0 ? (
              <tr>
                <td colspan="6" class="text-center text-slate-400 py-12 text-xs font-semibold">
                  <Icon name="folder" size={32} class="mx-auto text-slate-300 mb-2" />
                  No official contacts found in database.
                </td>
              </tr>
            ) : (
              contacts.map((c: any, idx: number) => (
                <tr key={c.id} class="border-b border-slate-100 hover:bg-slate-50/50 transition-colors duration-150">
                  <td class="p-4 text-center font-bold text-slate-400 text-xs">{c.viewOrder || idx + 1}</td>
                  <td class="p-4 text-xs">
                    <p class="font-bold text-slate-900">{c.name}</p>
                    <p class="text-[11px] text-[#0B4F9C] font-semibold">{c.position}</p>
                  </td>
                  <td class="p-4 text-xs">
                    {c.email ? (
                      <span class="text-slate-600 font-mono">{c.email}</span>
                    ) : (
                      <span class="text-slate-400 italic">—</span>
                    )}
                  </td>
                  <td class="p-4 text-xs">
                    <div class="space-y-0.5">
                      {c.srinagarPhone && <p><span class="text-slate-500 font-semibold">Ph:</span> {c.srinagarPhone}</p>}
                      {c.srinagarFax && <p><span class="text-slate-500 font-semibold">Fax:</span> {c.srinagarFax}</p>}
                      {!c.srinagarPhone && !c.srinagarFax && <span class="text-slate-400 italic">—</span>}
                    </div>
                  </td>
                  <td class="p-4 text-xs">
                    <div class="space-y-0.5">
                      {c.jammuPhone && <p><span class="text-slate-500 font-semibold">Ph:</span> {c.jammuPhone}</p>}
                      {c.jammuFax && <p><span class="text-slate-500 font-semibold">Fax:</span> {c.jammuFax}</p>}
                      {!c.jammuPhone && !c.jammuFax && <span class="text-slate-400 italic">—</span>}
                    </div>
                  </td>
                  <td class="p-4 text-center flex justify-center items-center gap-2">
                    <a
                      href={`/admin/official-contacts-form?id=${c.id}`}
                      class="px-2.5 py-1 bg-slate-150 hover:bg-slate-200 text-slate-700 rounded text-[11px] font-bold border border-slate-300 transition-colors cursor-pointer"
                      aria-label={`Edit ${c.name}`}
                    >
                      Edit
                    </a>
                    <form method="POST" class="inline" onsubmit="return confirm('Are you sure you want to delete this official contact?');">
                      <input type="hidden" name="id" value={c.id} />
                      <input type="hidden" name="_action" value="delete" />
                      <button
                        type="submit"
                        class="px-2.5 py-1 bg-red-50 hover:bg-red-100 text-red-650 rounded text-[11px] font-bold border border-red-200 transition-colors cursor-pointer"
                        aria-label={`Delete ${c.name}`}
                      >
                        Delete
                      </button>
                    </form>
                  </td>
                </tr>
              ))
            )}
          </tbody>
        </table>
      </div>
    </div>

  </div>
</AdminLayout>
