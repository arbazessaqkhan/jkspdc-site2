---
import AdminLayout from '../../layouts/AdminLayout.astro';
import Icon from '../../components/Icon.astro';
import FileUploader from '../../components/admin/FileUploader.astro';
import { isAdmin } from '../../utils/roles';
import { parseApiError, BACKEND_URL } from '../../utils/api-error';
import { readPageParams, fetchPaged, pageUrl } from '../../utils/pagination';
import PageNav from '../../components/PageNav.astro';

// Check authentication
const sessionToken = Astro.cookies.get('admin_session')?.value;
if (!sessionToken) {
  return Astro.redirect('/admin/login');
}

const userRole = Astro.locals.user?.role;
const userIsAdmin = isAdmin(userRole);

let errorMessage = '';
let successMessage = '';

// Handle Delete Action (ADMIN ONLY)
if (Astro.request.method === 'POST') {
  if (!userIsAdmin) {
    return Astro.redirect('/admin/tenders');
  }
  try {
    const formData = await Astro.request.formData();
    const action = formData.get('_action')?.toString();

    if (action === 'delete') {
      const id = formData.get('id')?.toString();
      if (id) {
        const res = await fetch(`${BACKEND_URL}/api/tenders/${id}`, {
          method: 'DELETE',
          headers: {
            'Authorization': `Bearer ${sessionToken}`,
          },
        });

        if (res.ok) {
          successMessage = 'Tender posting successfully removed.';
        } else {
          const apiErr = await parseApiError(res, 'delete tender posting');
          if (apiErr.isUnauthorized) {
            return Astro.redirect('/admin/login');
          }
          errorMessage = apiErr.message;
        }
      }
    }
  } catch (e) {
    console.error('Error deleting tender:', e);
    errorMessage = 'Network failure: Unable to communicate with backend service.';
  }
}

// Fetch Tenders List (paginated — ?page / ?pageSize)
const { page, pageSize } = readPageParams(Astro.url);
let tenders: any[] = [];
let totalTenders = 0;
let lastPage = 1;
try {
  const state = await fetchPaged('/api/tenders', { BACKEND_URL, page, pageSize });
  tenders = state.rows;
  totalTenders = state.total;
  lastPage = state.lastPage;
  if (state.error) errorMessage = state.error;
} catch (e) {
  console.error('Error fetching tenders:', e);
  errorMessage = 'Network failure: Unable to reach backend server.';
}
const pagedState = { rows: tenders, total: totalTenders, page, pageSize, lastPage, error: errorMessage.includes('Network') ? errorMessage : null };
---

<AdminLayout title="Tenders & Bids" description="Manage JKSPDCL Tenders, Bids, and Attached Corrigendums" activeTab="tenders">
  <div class="flex flex-col gap-5">
    
    <!-- Standard Admin Page Header -->
    <div class="admin-page-header">
      <div>
        <h1 class="text-lg font-extrabold text-[color:var(--adm-primary)] tracking-tight">Tenders &amp; Procurement Notices</h1>
        <p class="text-xs text-slate-500 mt-0.5">Publish new tenders, attach corrigendums to active tenders, and manage bidding specifications.</p>
      </div>
      {userIsAdmin && (
        <div class="flex items-center gap-2.5 shrink-0 whitespace-nowrap">
          <button 
            type="button"
            id="btn-open-global-corr-modal"
            class="px-3 py-2 bg-white hover:bg-slate-50 text-slate-700 border border-slate-300 rounded text-xs font-bold transition-colors shadow-2xs flex items-center gap-1.5 cursor-pointer"
            title="Attach Corrigendum to a tender"
          >
            <Icon name="paperclip" size={13} class="text-amber-700" />
            <span>Attach Corrigendum</span>
          </button>
          <a 
            href="/admin/tenders-form" 
            class="btn-primary flex items-center gap-1.5 text-xs py-2 px-3.5"
          >
            <Icon name="plus" size={13} strokeWidth={2.5} />
            <span>Publish Tender</span>
          </a>
        </div>
      )}
    </div>

    <!-- Alerts -->
    {errorMessage && (
      <div class="p-3 bg-red-50 border border-red-200 text-xs font-semibold text-red-700 rounded flex items-center gap-2" role="alert">
        <Icon name="info" size={14} class="text-red-600 shrink-0" /> {errorMessage}
      </div>
    )}
    {successMessage && (
      <div class="p-3 bg-green-50 border border-green-200 text-xs font-semibold text-green-700 rounded flex items-center gap-2" role="alert">
        <Icon name="check" size={14} class="text-green-600 shrink-0" /> {successMessage}
      </div>
    )}

    <!-- Search & Filter Toolbar -->
    <div class="admin-toolbar">
      <div class="flex items-center gap-3 flex-wrap flex-1 min-w-0">
        <div class="relative w-full sm:w-72">
          <input 
            type="text" 
            id="search-tenders-input"             placeholder="Search eNIT, title, category, location..." 
            class="w-full bg-slate-50 border border-slate-300 rounded text-xs text-slate-800 pl-9 pr-3 py-1.5 focus:ring-1 focus:ring-[color:var(--adm-primary)] focus:border-[color:var(--adm-primary)] outline-none"
          />
          <div class="absolute left-2.5 top-2 text-slate-400">
            <Icon name="search" size={13} />
          </div>
        </div>

        <div class="flex items-center gap-2">
          <label for="filter-tender-status" class="text-xs font-bold text-slate-600 shrink-0">Status:</label>
          <select id="filter-tender-status" class="bg-slate-50 border border-slate-300 rounded text-xs py-1.5 px-2.5 text-slate-700 outline-none">
            <option value="All">All Statuses</option>
            <option value="Active">Active</option>
            <option value="Archived">Archived</option>
            <option value="Closed">Closed</option>
          </select>
        </div>
      </div>

      <div class="text-xs text-slate-500 font-medium shrink-0">
        Showing <span id="visible-tenders-count" class="font-bold text-slate-800">{tenders.length}</span> of <span class="font-bold text-slate-800">{totalTenders}</span> notices
      </div>
    </div>

    <!-- Tenders Data Table -->
    <div class="admin-table-card">
    <div class="admin-table-container">
      <table class="table-data min-w-full text-left" id="tenders-data-table">
        <thead>
          <tr>
            <th scope="col" class="w-12 text-center">#</th>
            <th scope="col" class="w-44 whitespace-nowrap">Reference No</th>
            <th scope="col" class="min-w-[260px]">Tender Title &amp; Corrigendums</th>
            <th scope="col" class="w-36 whitespace-nowrap">Timeline / Dates</th>
            <th scope="col" class="w-24 text-center whitespace-nowrap">Status</th>
            <th scope="col" class="w-24 text-center whitespace-nowrap">Files</th>
            {userIsAdmin && <th scope="col" class="w-28 text-center whitespace-nowrap sticky-col-right">Actions</th>}
          </tr>
        </thead>
        <tbody id="tenders-table-body">
            {tenders.length === 0 ? (
              <tr id="empty-tenders-row">
                <td colspan={userIsAdmin ? 7 : 6} class="text-center text-slate-500 py-10 font-semibold italic text-xs">
                  No tenders published.
                </td>
              </tr>
            ) : (
              tenders.map((tender: any, idx: number) => {
                const corrs = tender.corrigendums && Array.isArray(tender.corrigendums) ? tender.corrigendums : [];
                const searchString = `${tender.referenceNo} ${tender.title} ${tender.description || ''} ${tender.workCategory || ''} ${tender.locationTag || ''}`.toLowerCase();
                const statusType = tender.status?.toLowerCase() || 'active';
                const badgeClass = statusType === 'active' ? 'admin-badge-success' : statusType === 'archived' ? 'admin-badge-neutral' : 'admin-badge-danger';
                return (
                  <tr 
                    key={tender.id} 
                    class="tender-data-row transition-colors"
                    data-status={tender.status || 'Active'}
                    data-search={searchString}
                  >
                    <td class="text-center font-bold text-slate-400 text-xs row-idx">{idx + 1}</td>
                    <td class="font-mono font-bold text-[color:var(--adm-primary)] text-xs whitespace-nowrap">
                      {tender.referenceNo}
                    </td>
                    <td class="font-medium text-slate-800 text-left">
                      <div class="flex flex-col gap-1">
                        <span class="font-bold text-xs leading-snug text-slate-900">{tender.title}</span>
                        {tender.description && (
                          <span class="text-[11px] text-slate-500 font-normal line-clamp-1">{tender.description}</span>
                        )}
                        
                        <div class="flex items-center gap-1.5 flex-wrap mt-0.5 select-none">
                          <span class="px-1.5 py-0.5 rounded bg-blue-50 border border-blue-200 text-[color:var(--adm-primary)] text-[9px] font-bold uppercase">{tender.documentType || 'NIT'}</span>
                          <span class="px-1.5 py-0.5 rounded bg-slate-100 border border-slate-200 text-slate-700 text-[9px] font-bold">{tender.workCategory || 'Civil'}</span>
                          <span class="px-1.5 py-0.5 rounded bg-slate-100 border border-slate-200 text-slate-600 text-[9px] font-medium font-mono">{tender.locationTag?.replace(/^HQ_/i, 'HQ ')?.replace(/^HEP_/i, 'HEP ')?.replace(/_/g, ' ')}</span>
                          {corrs.length > 0 && (
                            <span class="px-1.5 py-0.5 rounded bg-amber-50 border border-amber-200 text-amber-900 text-[9px] font-bold flex items-center gap-1">
                              <Icon name="paperclip" size={11} class="text-amber-900 shrink-0" />
                              <span>{corrs.length} Corrigendum{corrs.length > 1 ? 's' : ''}</span>
                            </span>
                          )}
                        </div>

                        <!-- Corrigendums List -->
                        {corrs.length > 0 && (
                          <div class="mt-1.5 space-y-1 bg-amber-50/60 p-2 rounded border border-amber-200/70">
                            {corrs.map((c: any, cIdx: number) => (
                              <div class="text-[11px] font-semibold text-slate-700 flex items-center justify-between gap-2">
                                <span class="truncate flex items-center gap-1">
                                  <Icon name="file-text" size={11} class="text-amber-800 shrink-0" />
                                  <span><strong>Corr {cIdx + 1}:</strong> {c.title}</span>
                                </span>
                                <a href={c.documentUrl} target="_blank" rel="noopener noreferrer" class="text-amber-800 hover:underline font-bold text-[10px] shrink-0">
                                  View PDF
                                </a>
                              </div>
                            ))}
                          </div>
                        )}
                      </div>
                    </td>
                    <td class="whitespace-nowrap">
                      <div class="flex flex-col gap-0.5 text-xs">
                        <div class="flex items-center gap-1.5 text-slate-600">
                          <span class="text-[10px] uppercase font-bold text-slate-400 tracking-wider">Pub:</span>
                          <span class="font-medium text-slate-800">{tender.publishDate ? new Date(tender.publishDate).toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric' }) : '—'}</span>
                        </div>
                        <div class="flex items-center gap-1.5 text-slate-600">
                          <span class="text-[10px] uppercase font-bold text-amber-700 tracking-wider">Due:</span>
                          <span class="font-semibold text-amber-800">{tender.closingDate ? new Date(tender.closingDate).toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric' }) : '—'}</span>
                        </div>
                      </div>
                    </td>
                    <td class="text-center">
                      <span class={badgeClass}>
                        {tender.status}
                      </span>
                    </td>
                    <td class="text-center whitespace-nowrap">
                      <a 
                        href={tender.documentUrl} 
                        target="_blank" 
                        rel="noopener noreferrer"
                        class="admin-btn-action action-download mx-auto"
                        title={`Download Tender Document (${tender.fileSizeBytes ? `${(tender.fileSizeBytes / (1024 * 1024)).toFixed(2)} MB` : 'PDF'})`}
                        aria-label={`Download document for ${tender.referenceNo}`}
                      >
                        <Icon name="download" size={13} />
                      </a>
                    </td>
                    {userIsAdmin && (
                      <td class="td-actions sticky-col-right">
                        <div class="admin-action-group">
                          <button
                            type="button"
                            class="btn-attach-corr admin-btn-action action-special"
                            data-tender-id={tender.id}
                            data-tender-ref={tender.referenceNo}
                            data-tender-title={tender.title}
                            title="Attach Corrigendum PDF"
                            aria-label={`Attach Corrigendum to ${tender.referenceNo}`}
                          >
                            <Icon name="paperclip" size={13} />
                          </button>
                          <a 
                            href={`/admin/tenders-form?id=${tender.id}`}
                            class="admin-btn-action"
                            title="Edit Tender"
                            aria-label={`Edit ${tender.referenceNo}`}
                          >
                            <Icon name="pencil" size={13} />
                          </a>
                          <form method="POST" class="inline m-0 p-0" onsubmit="return confirm('Are you sure you want to remove this tender?');">
                            <input type="hidden" name="id" value={tender.id} />
                            <input type="hidden" name="_action" value="delete" />
                            <button 
                              type="submit" 
                              class="admin-btn-action action-delete"
                              title="Delete Tender"
                              aria-label={`Delete ${tender.referenceNo}`}
                            >
                              <Icon name="trash-2" size={13} />
                            </button>
                          </form>
                        </div>
                      </td>
                    )}
                  </tr>
                );
              })
            )}
            <tr id="no-matching-tenders-row" style="display: none;">
              <td colspan={userIsAdmin ? 7 : 6} class="text-center text-slate-500 py-12 text-xs font-semibold italic">
                No tenders found matching your search or filter criteria.
              </td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>

    <PageNav state={pagedState} url={(p: number) => pageUrl(Astro.url, p, pageSize)} />
  </div>
</div>

  <!-- ATTACH CORRIGENDUM MODAL DIALOG (ADMIN ONLY) -->
  {userIsAdmin && (
  <div id="corr-modal-backdrop" class="fixed inset-0 bg-slate-900/60 backdrop-blur-xs z-50 flex items-center justify-center p-3 sm:p-4 overflow-y-auto hidden">
    <div class="bg-white rounded-2xl shadow-2xl border border-slate-200 max-w-xl w-full max-h-[90vh] flex flex-col overflow-hidden animate-fadeIn my-auto">
      
      <!-- Modal Header -->
      <div class="px-6 py-4 border-b border-slate-100 flex items-center justify-between bg-slate-50/70 shrink-0">
        <div class="flex items-center gap-2 text-[color:var(--adm-primary)]">
          <Icon name="plus" size={18} />
          <h3 class="text-base font-extrabold">Attach Corrigendum / Amendment PDF</h3>
        </div>
        <button type="button" id="btn-close-corr-modal" class="w-8 h-8 rounded-lg text-slate-400 hover:text-slate-700 hover:bg-slate-200 flex items-center justify-center cursor-pointer transition-colors" title="Close">
          <Icon name="x" size={18} />
        </button>
      </div>

      <!-- Form Body -->
      <form id="attach-corr-modal-form" class="flex flex-col overflow-hidden flex-1 min-h-0">
        <div class="p-6 space-y-4 overflow-y-auto flex-1">
          <!-- Search & Select Target Tender -->
          <div class="form-group flex flex-col gap-1.5 relative">
            <label class="text-xs font-bold text-slate-700">Select Target Tender <span class="text-red-500">*</span></label>
            <input 
              type="text" 
              id="modal-tender-search" 
              class="form-input text-xs" 
              placeholder="Type eNIT No, Tender ID, Title, or Keyword to search..." 
              autocomplete="off"
              required
            />
            <input type="hidden" id="modal-selected-tender-id" />
            
            <!-- Dropdown search suggestions -->
            <div id="modal-tender-results" class="absolute left-0 right-0 top-[64px] bg-white border border-slate-200 rounded-lg shadow-xl max-h-48 overflow-y-auto z-20 hidden">
              <!-- Populated via JS search -->
            </div>

            <div id="modal-selected-tender-badge" class="p-2.5 bg-blue-50 border border-blue-200 rounded text-xs text-[color:var(--adm-primary)] font-semibold hidden">
              Selected: <span id="selected-tender-text" class="font-bold"></span>
            </div>
          </div>

          <!-- Corrigendum Title -->
          <div class="form-group flex flex-col gap-1.5">
            <label for="modal-corr-title" class="text-xs font-bold text-slate-700">Corrigendum Title / Subject <span class="text-red-500">*</span></label>
            <input 
              type="text" 
              id="modal-corr-title" 
              class="form-input text-xs" 
              placeholder="e.g. Corrigendum-I: Extension of bid submission deadline & amended BOQ" 
              required 
            />
          </div>

          <!-- Extended Dates (Optional) -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div class="form-group flex flex-col gap-1.5">
              <label for="modal-extended-closing" class="text-xs font-bold text-slate-700">Extended Closing Date (Optional)</label>
              <input type="date" id="modal-extended-closing" class="form-input text-xs" />
            </div>
            <div class="form-group flex flex-col gap-1.5">
              <label for="modal-extended-opening" class="text-xs font-bold text-slate-700">Extended Opening Date (Optional)</label>
              <input type="date" id="modal-extended-opening" class="form-input text-xs" />
            </div>
          </div>

          <!-- Corrigendum PDF File Attachment -->
          <div class="form-group flex flex-col gap-1.5">
            <FileUploader
              id="corr-modal-doc"
              label="Corrigendum PDF Document"
              required
              variant="document"
              accept=".pdf,.doc,.docx"
              helpText="PDF, DOC, DOCX (Max 20MB / 100MB if Important)"
              important
            />
            <input type="hidden" id="modal-doc-url" />
            <input type="hidden" id="modal-file-size" />
          </div>
        </div>

        <!-- Pinned Actions Footer -->
        <div class="px-6 py-3.5 border-t border-slate-100 bg-slate-50/70 flex justify-end gap-3 shrink-0">
          <button type="button" id="btn-cancel-corr-modal" class="px-4 py-2 bg-white hover:bg-slate-100 text-slate-700 rounded-lg text-xs font-semibold border border-slate-300 transition-colors cursor-pointer">
            Cancel
          </button>
          <button type="submit" id="btn-submit-corr-modal" class="px-5 py-2 bg-amber-500 hover:bg-amber-600 text-white rounded-lg text-xs font-bold shadow-sm transition-all cursor-pointer">
            Confirm Attach Corrigendum
          </button>
        </div>
      </form>
    </div>
  </div>
  )}

  <script define:vars={{ sessionToken, tenders, userIsAdmin, backendUrl: BACKEND_URL }}>
    (function() {
      // Table Live Search & Status Filter
      var searchInput = document.getElementById('search-tenders-input');
      var statusSelect = document.getElementById('filter-tender-status');
      var countEl = document.getElementById('visible-tenders-count');
      var rows = document.querySelectorAll('.tender-data-row');
      var emptyRow = document.getElementById('no-matching-tenders-row');

      function filterTable() {
        var query = (searchInput ? searchInput.value : '').toLowerCase().trim();
        var status = statusSelect ? statusSelect.value : 'All';
        var visible = 0;

        rows.forEach(function(row) {
          var rowSearch = (row.dataset.search || '').toLowerCase();
          var rowStatus = row.dataset.status || '';
          var matchesQuery = !query || rowSearch.includes(query);
          var matchesStatus = status === 'All' || rowStatus.toLowerCase() === status.toLowerCase();

          if (matchesQuery && matchesStatus) {
            row.style.display = '';
            visible++;
            var idxCell = row.querySelector('.row-idx');
            if (idxCell) idxCell.textContent = visible;
          } else {
            row.style.display = 'none';
          }
        });

        if (countEl) countEl.textContent = visible;
        if (emptyRow) {
          emptyRow.style.display = (visible === 0 && rows.length > 0) ? 'table-row' : 'none';
        }
      }

      searchInput?.addEventListener('input', filterTable);
      statusSelect?.addEventListener('change', filterTable);

      // If user is not admin, do not attach modal or mutation script handlers
      if (!userIsAdmin) {
        return;
      }

      function getElements() {
        return {
          modalBackdrop: document.getElementById('corr-modal-backdrop'),
          btnOpenGlobal: document.getElementById('btn-open-global-corr-modal'),
          btnCloseModal: document.getElementById('btn-close-corr-modal'),
          btnCancelModal: document.getElementById('btn-cancel-corr-modal'),
          searchInput: document.getElementById('modal-tender-search'),
          hiddenTenderId: document.getElementById('modal-selected-tender-id'),
          resultsBox: document.getElementById('modal-tender-results'),
          badgeBox: document.getElementById('modal-selected-tender-badge'),
          selectedTenderText: document.getElementById('selected-tender-text'),
          fileUploader: document.getElementById('corr-modal-doc-input'),
          uploadBox: document.getElementById('corr-modal-doc-dropzone'),
          hiddenDocUrl: document.getElementById('modal-doc-url'),
          hiddenFileSize: document.getElementById('modal-file-size'),
          modalForm: document.getElementById('attach-corr-modal-form'),
          submitBtn: document.getElementById('btn-submit-corr-modal'),
        };
      }

      function openModal(preSelectedTender) {
        var els = getElements();
        if (!els.modalBackdrop) return;
        els.modalBackdrop.classList.remove('hidden');
        resetModalForm();

        if (preSelectedTender) {
          selectTender(preSelectedTender);
        }
      }

      function closeModal() {
        var els = getElements();
        if (!els.modalBackdrop) return;
        els.modalBackdrop.classList.add('hidden');
        resetModalForm();
      }

      function resetModalForm() {
        var els = getElements();
        if (els.modalForm) els.modalForm.reset();
        if (els.hiddenTenderId) els.hiddenTenderId.value = '';
        if (els.hiddenDocUrl) els.hiddenDocUrl.value = '';
        if (els.hiddenFileSize) els.hiddenFileSize.value = '0';
        if (els.badgeBox) els.badgeBox.classList.add('hidden');
        if (els.resultsBox) els.resultsBox.classList.add('hidden');
        if (els.uploadBox) {
          els.uploadBox.classList.remove('has-file');
          var n = els.uploadBox.querySelector('.admin-uploader-file-name');
          if (n) n.textContent = '';
          var fi = els.uploadBox.querySelector('input[type="file"]');
          if (fi) fi.value = '';
        }
      }

      function selectTender(t) {
        var els = getElements();
        if (els.hiddenTenderId) els.hiddenTenderId.value = t.id;
        if (els.searchInput) els.searchInput.value = `${t.referenceNo} — ${t.title}`;
        if (els.selectedTenderText) els.selectedTenderText.textContent = `${t.referenceNo} (${t.title})`;
        if (els.badgeBox) els.badgeBox.classList.remove('hidden');
        if (els.resultsBox) els.resultsBox.classList.add('hidden');
      }

      // Delegated clicks for open, close, and row +Corr buttons
      document.addEventListener('click', function(e) {
        var openGlobal = e.target.closest('#btn-open-global-corr-modal');
        if (openGlobal) {
          e.preventDefault();
          openModal();
          return;
        }

        var corrBtn = e.target.closest('.btn-attach-corr');
        if (corrBtn) {
          e.preventDefault();
          var id = corrBtn.getAttribute('data-tender-id');
          var ref = corrBtn.getAttribute('data-tender-ref');
          var title = corrBtn.getAttribute('data-tender-title');
          openModal({ id: id, referenceNo: ref, title: title });
          return;
        }

        var closeBtn = e.target.closest('#btn-close-corr-modal, #btn-cancel-corr-modal');
        if (closeBtn) {
          e.preventDefault();
          closeModal();
          return;
        }

        var tenderOption = e.target.closest('.item-tender-option');
        if (tenderOption) {
          var id = tenderOption.getAttribute('data-id');
          var t = tenders.find(function(x) { return x.id === id; });
          if (t) selectTender(t);
          return;
        }

        // Close on outside backdrop click
        var els = getElements();
        if (els.modalBackdrop && !els.modalBackdrop.classList.contains('hidden') && e.target === els.modalBackdrop) {
          closeModal();
        }
      });

      // Close on Escape key
      document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') {
          closeModal();
        }
      });

      // Search input live filtering
      document.addEventListener('input', function(e) {
        if (e.target && e.target.id === 'modal-tender-search') {
          var els = getElements();
          var query = e.target.value.toLowerCase().trim();
          if (!query) {
            if (els.resultsBox) els.resultsBox.classList.add('hidden');
            return;
          }

          var matches = tenders.filter(function(t) {
            return (t.referenceNo || '').toLowerCase().includes(query) ||
              (t.title || '').toLowerCase().includes(query) ||
              (t.id || '').toLowerCase().includes(query) ||
              (t.workCategory || '').toLowerCase().includes(query);
          });

          if (!els.resultsBox) return;

          if (matches.length === 0) {
            els.resultsBox.innerHTML = '<div class="p-3 text-slate-400 italic text-xs">No matching tenders found</div>';
          } else {
            els.resultsBox.innerHTML = matches.map(function(t) {
              return '<div class="p-2.5 hover:bg-amber-50/70 border-b border-slate-100 last:border-0 cursor-pointer text-xs select-none item-tender-option" data-id="' + t.id + '">' +
                '<div class="font-bold text-[color:var(--adm-primary)]">' + t.referenceNo + '</div>' +
                '<div class="font-semibold text-slate-800 leading-snug truncate">' + t.title + '</div>' +
              '</div>';
            }).join('');
          }
          els.resultsBox.classList.remove('hidden');
        }
      });

      // File upload handler (unified uploader — validated upstream)
      document.addEventListener('change', async function(e) {
        if (e.target && e.target.id === 'corr-modal-doc-input') {
          var file = e.target.files && e.target.files[0];
          if (!file) return;

          var els = getElements();
          var isImportant = document.getElementById('corr-modal-doc-important')?.checked || false;

          var formData = new FormData();
          formData.append('file', file);
          formData.append('isImportant', isImportant ? 'true' : 'false');

          try {
            var res = await fetch(`${backendUrl}/api/upload`, {
              method: 'POST',
              headers: { 'Authorization': `Bearer ${sessionToken}` },
              body: formData,
            });

            if (!res.ok) {
              if (res.status === 401) { window.location.href = '/admin/login'; return; }
              if (res.status === 403) { alert('Access Denied: You do not have permission to upload files.'); return; }
              var err = await res.json().catch(function() { return {}; });
              throw new Error(err.message || 'Upload failed');
            }

            var result = await res.json();
            if (els.hiddenDocUrl) els.hiddenDocUrl.value = result.url;
            if (els.hiddenFileSize) els.hiddenFileSize.value = result.sizeBytes;
          } catch (err) {
            alert(`Upload failed: ${err.message}`);
            e.target.value = '';
          }
        }
      });

      // Submit Form Handler
      document.addEventListener('submit', async function(e) {
        if (e.target && e.target.id === 'attach-corr-modal-form') {
          e.preventDefault();

          var els = getElements();
          var targetId = els.hiddenTenderId?.value;
          var corrTitle = document.getElementById('modal-corr-title')?.value.trim();
          var extClosing = document.getElementById('modal-extended-closing')?.value;
          var extOpening = document.getElementById('modal-extended-opening')?.value;
          var docUrl = els.hiddenDocUrl?.value;
          var sizeBytes = parseInt(els.hiddenFileSize?.value || '0', 10);

          if (!targetId) {
            alert('Please select a target tender first.');
            return;
          }
          if (!corrTitle) {
            alert('Please enter the corrigendum title.');
            return;
          }
          if (!docUrl) {
            alert('Please attach the Corrigendum PDF file.');
            return;
          }

          if (els.submitBtn) { els.submitBtn.disabled = true; els.submitBtn.textContent = 'Saving...'; }

          try {
            var getRes = await fetch(`${backendUrl}/api/tenders/${targetId}`);
            if (!getRes.ok) throw new Error('Could not fetch target tender details.');
            var tenderObj = await getRes.json();

            var existingCorrs = Array.isArray(tenderObj.corrigendums) ? tenderObj.corrigendums : [];
            
            var newCorr = {
              id: Math.random().toString(36).substring(2, 12),
              title: corrTitle,
              publishDate: new Date().toISOString(),
              documentUrl: docUrl,
              fileSizeBytes: sizeBytes,
              extendedClosingDate: extClosing || null,
              extendedBidOpeningDate: extOpening || null,
            };

            var updatedCorrs = [...existingCorrs, newCorr];

            var putRes = await fetch(`${backendUrl}/api/tenders/${targetId}`, {
              method: 'PUT',
              headers: {
                'Content-Type': 'application/json',
                'Authorization': `Bearer ${sessionToken}`,
              },
              body: JSON.stringify({
                corrigendums: updatedCorrs,
              }),
            });

            if (putRes.ok) {
              alert('Corrigendum successfully attached to tender!');
              window.location.reload();
            } else {
              if (putRes.status === 401) {
                window.location.href = '/admin/login';
                return;
              }
              if (putRes.status === 403) {
                alert('Access Denied: You do not have permission to update tender corrigendums.');
                return;
              }
              var err = await putRes.json().catch(function() { return {}; });
              throw new Error(err.message || 'Failed to update tender with corrigendum.');
            }
          } catch (err) {
            alert(`Error attaching corrigendum: ${err.message}`);
          } finally {
            if (els.submitBtn) { els.submitBtn.disabled = false; els.submitBtn.textContent = 'Confirm Attach Corrigendum'; }
          }
        }
      });
    })();
  </script>
</AdminLayout>
