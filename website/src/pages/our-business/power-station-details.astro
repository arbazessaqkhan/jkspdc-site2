---
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import { formatProjectName } from '../../utils/projectFormatter';

const id = Astro.url.searchParams.get('id')?.toString();
let project: any = null;
let errorMessage = '';

try {
  if (!id) {
    errorMessage = 'Power Station ID is required.';
  } else {
    const res = await fetch(`http://localhost:3000/api/projects/${id}`);
    if (res.ok) {
      project = await res.json();
    } else {
      errorMessage = 'Power station details not found.';
    }
  }
} catch (e) {
  console.error('Error fetching power station details:', e);
  errorMessage = 'Failed to connect to the backend server.';
}

// Check if we have an image asset for this project
const getProjectPhotoUrl = (proj: any) => {
  if (!proj) return null;
  const slug = proj.name.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
  if (slug === 'kirthai-hep-stage-1') {
    return '/logo.png';
  }
  if (slug === 'ganderbal' || slug === 'ushp-i' || slug === 'sewa-iii') {
    return `/projects/${slug}.png`;
  }
  return `/projects/${slug}.jpg`;
};
const photoUrl = getProjectPhotoUrl(project);
const formattedTitle = project ? formatProjectName(project.name) : "Power Station Details";

// Build structured salient specifications matrix
const getSalientSpecs = (proj: any) => {
  if (!proj) return [];
  const specs: { label: string; value: string }[] = [];

  // Core Parameters
  specs.push({ label: 'Project Name & Scheme', value: proj.name });
  specs.push({ label: 'Installed Capacity', value: `${proj.capacityMw} MW (${proj.configuration || 'Multi-Unit Generation'})` });
  if (proj.type) specs.push({ label: 'Type of Hydel Scheme', value: proj.type });
  if (proj.status) specs.push({ label: 'Operational / Development Status', value: proj.status });
  if (proj.basin) specs.push({ label: 'River Basin System', value: proj.basin });
  if (proj.location) specs.push({ label: 'District Location', value: proj.location });
  if (proj.sector) specs.push({ label: 'Ownership Sector', value: `${proj.sector} Sector (JKSPDCL)` });
  if (proj.designEnergy) specs.push({ label: 'Annual Design Energy', value: `${proj.designEnergy} Million Units (MU)` });
  if (proj.yearOfCommissioning) specs.push({ label: 'Year of Commercial Operation (COD)', value: `Year ${proj.yearOfCommissioning}` });

  // Extract extra items from salientFeatures string
  const raw = proj.salientFeatures || '';
  
  // Extract <li> elements
  const liMatches = raw.match(/<li[^>]*>(.*?)<\/li>/gi);
  if (liMatches) {
    liMatches.forEach((li: string) => {
      const clean = li.replace(/<[^>]+>/g, '').trim();
      if (clean.includes(':')) {
        const parts = clean.split(':');
        const key = parts[0].replace(/^-\s*/, '').trim();
        const val = parts.slice(1).join(':').trim();
        if (key && val && !specs.some(s => s.label.toLowerCase() === key.toLowerCase())) {
          specs.push({ label: key, value: val });
        }
      }
    });
  }

  // Extract bold paragraph key-values
  const boldMatches = raw.match(/(?:<strong>|<b>)(.*?)(?:<\/strong>|<\/b>)\s*:?\s*([^<]+)/gi);
  if (boldMatches) {
    boldMatches.forEach((bm: string) => {
      const clean = bm.replace(/<[^>]+>/g, ':').replace(/\s+/g, ' ').trim();
      const parts = clean.split(':').map(s => s.trim()).filter(Boolean);
      if (parts.length >= 2) {
        const key = parts[0];
        const val = parts.slice(1).join(' ');
        if (key && val && key.length < 40 && !key.toLowerCase().includes('salient') && !specs.some(s => s.label.toLowerCase() === key.toLowerCase())) {
          specs.push({ label: key, value: val });
        }
      }
    });
  }

  return specs;
};

const salientSpecs = getSalientSpecs(project);
---

<Layout 
  title={formattedTitle} 
  description={project ? project.description : "Details of JKSPDCL power station."}
>
  <div class="space-y-0 max-w-5xl mx-auto">
    <!-- Premium Page Header Band -->
    <div class="page-header-band animate-fadeInUp">
      <nav class="breadcrumb-trail" aria-label="Breadcrumbs">
        <a href="/">Home</a>
        <span class="separator">/</span>
        <a href="/our-business/power-stations">Power Stations</a>
        <span class="separator">/</span>
        <span class="current">{project ? project.name : 'Details'}</span>
      </nav>
      <h1>{formattedTitle}</h1>
      <p class="page-subtitle">Jammu &amp; Kashmir State Power Development Corporation Limited (JKSPDCL)</p>
    </div>

    {errorMessage && (
      <div class="bg-red-50 border border-red-200 text-red-800 rounded-lg p-4 text-xs font-semibold">
        {errorMessage}
      </div>
    )}

    {project && (
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        <!-- Main Info -->
        <article class="lg:col-span-2 space-y-6">
          <header class="border-b border-gray-200 pb-4">
            <div class="flex flex-wrap items-center gap-2 mb-2">
              <span class="px-2.5 py-0.5 bg-[#0B4F9C]/10 rounded border border-[#0B4F9C]/20 text-[10px] font-bold text-[#0B4F9C] uppercase tracking-wide">
                {project.sector || 'State'} Sector
              </span>
              <span class="px-2.5 py-0.5 bg-emerald-50 rounded border border-emerald-200 text-[10px] font-bold text-emerald-700 uppercase tracking-wide">
                {project.basin || 'Basin'}
              </span>
            </div>
            <h2 class="text-3xl font-extrabold text-[#0B4F9C]">{project.name}</h2>
          </header>

          <!-- Top Card: Image and Technical Specifications combined -->
          <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-4 md:p-6 project-top-card">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6 items-center project-top-grid">
              
              <!-- Left Side: Image container -->
              {photoUrl && (
                <div class="project-image-card flex flex-col justify-center items-center">
                  <img 
                    src={photoUrl} 
                    alt={`${project.name} Power House Facility`} 
                    class={`w-full h-[322px] rounded-xl shadow-sm border border-slate-100 bg-slate-50 ${photoUrl === '/logo.png' ? 'object-contain p-8' : 'object-cover'}`}
                    onerror="handleImageError(this);"
                  />
                  <div class="mt-2 text-center text-[10px] text-slate-500 font-semibold italic">
                    Figure: {project.name} Hydroelectric Power House Facility
                  </div>
                </div>
              )}

              <!-- Right Side: Technical Specifications -->
              <div class="project-specs-card">
                <h3 class="font-extrabold text-gray-900 border-b border-gray-100 pb-2 flex items-center gap-1.5 text-xs uppercase tracking-wider text-[#0B4F9C]">
                  ⚙️ Technical Specifications
                </h3>
                
                <dl class="grid grid-cols-2 gap-x-6 gap-y-4 mt-4">
                  <div>
                    <dt class="text-slate-500 font-semibold uppercase tracking-wider text-xs">Installed Capacity</dt>
                    <dd class="text-xl font-extrabold text-[#0B4F9C] mt-0.5">{project.capacityMw} MW</dd>
                  </div>

                  <div>
                    <dt class="text-slate-500 font-semibold uppercase tracking-wider text-xs">Configuration</dt>
                    <dd class="text-base font-bold text-slate-800 mt-0.5">{project.configuration || '—'}</dd>
                  </div>

                  <div>
                    <dt class="text-slate-500 font-semibold uppercase tracking-wider text-xs">Design Energy</dt>
                    <dd class="text-base font-bold text-slate-800 mt-0.5">{project.designEnergy ? `${project.designEnergy} MU` : '—'}</dd>
                  </div>

                  <div>
                    <dt class="text-slate-500 font-semibold uppercase tracking-wider text-xs">Year of Commissioning</dt>
                    <dd class="text-base font-bold text-slate-800 mt-0.5">{project.yearOfCommissioning || '—'}</dd>
                  </div>

                  <div>
                    <dt class="text-slate-500 font-semibold uppercase tracking-wider text-xs">River Basin</dt>
                    <dd class="text-base font-bold text-slate-800 mt-0.5">{project.basin || '—'}</dd>
                  </div>

                  <div>
                    <dt class="text-slate-500 font-semibold uppercase tracking-wider text-xs">District Location</dt>
                    <dd class="text-base font-bold text-slate-800 mt-0.5">{project.location || '—'}</dd>
                  </div>
                </dl>
              </div>

            </div>
          </div>

          <!-- TOP ROW: 1:1 Split Grid - About Project (Left) & Salient Features Table (Right) -->
          <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 items-start">
            
            <!-- LEFT (50%): About Project -->
            <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-6 flex flex-col space-y-5 h-fit">
              <div class="space-y-4">
                <div class="flex items-center justify-between border-b border-slate-100 pb-3">
                  <h3 class="text-xs font-bold text-[#0B4F9C] uppercase tracking-wider flex items-center gap-1.5">
                    <Icon name="info" size={14} class="text-[#0B4F9C]" /> ABOUT PROJECT &amp; OVERVIEW
                  </h3>
                  <span class="bg-[#0B4F9C]/10 text-[#0B4F9C] border border-[#0B4F9C]/20 px-2.5 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider">
                    Executive Summary
                  </span>
                </div>

                <!-- Description Text -->
                {project.description ? (
                  <div class="text-slate-700 text-sm sm:text-base leading-relaxed whitespace-pre-line text-justify" set:html={project.description}></div>
                ) : (
                  <p class="text-slate-400 text-xs italic">No detailed description has been uploaded for this project.</p>
                )}

                <!-- Quick Project Metrics Sub-Grid -->
                <div class="grid grid-cols-2 gap-3 pt-2">
                  <div class="bg-slate-50 border border-slate-200/80 rounded-xl p-3">
                    <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider block">Capacity</span>
                    <span class="text-sm font-extrabold text-[#0B4F9C] mt-0.5 block">{project.capacityMw} MW</span>
                  </div>

                  <div class="bg-slate-50 border border-slate-200/80 rounded-xl p-3">
                    <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider block">River Basin</span>
                    <span class="text-sm font-extrabold text-slate-800 mt-0.5 block">{project.basin || 'J&K Basin'}</span>
                  </div>

                  <div class="bg-slate-50 border border-slate-200/80 rounded-xl p-3">
                    <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider block">District</span>
                    <span class="text-sm font-extrabold text-slate-800 mt-0.5 block">{project.location || 'UT of J&K'}</span>
                  </div>

                  <div class="bg-slate-50 border border-slate-200/80 rounded-xl p-3">
                    <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider block">Status</span>
                    <span class="text-sm font-extrabold text-emerald-700 mt-0.5 block">{project.status}</span>
                  </div>
                </div>

                <!-- Strategic Highlights List -->
                <div class="bg-slate-50 border border-slate-200 rounded-xl p-3.5 space-y-2">
                  <h4 class="text-[11px] font-extrabold text-[#0B4F9C] uppercase tracking-wider flex items-center gap-1.5">
                    <span>⚡</span> Key Project Objectives
                  </h4>
                  <ul class="text-xs text-slate-700 space-y-1.5 list-disc list-inside font-medium">
                    <li>Clean, sustainable hydroelectric energy generation</li>
                    <li>Grid stability &amp; peak power support across J&amp;K UT</li>
                    <li>Execution under official State Power Development Policy</li>
                  </ul>
                </div>
              </div>

              <div class="pt-3 border-t border-slate-100 text-[11px] text-slate-500 font-semibold flex items-center justify-between">
                <span>Ownership: {project.sector || 'State'} Sector (JKSPDCL)</span>
                <span>Cell: Corporate Monitoring</span>
              </div>
            </div>

            <!-- RIGHT (50%): Salient Features Specifications Table -->
            <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-6 flex flex-col space-y-4 h-fit">
              <div class="space-y-4">
                <div class="flex items-center justify-between border-b border-slate-100 pb-3">
                  <h3 class="text-xs font-bold text-[#0B4F9C] uppercase tracking-wider flex items-center gap-1.5">
                    <Icon name="file" size={14} class="text-[#0B4F9C]" /> SALIENT FEATURES TABLE
                  </h3>
                  <span class="bg-emerald-50 text-emerald-700 border border-emerald-200 px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider">
                    Specifications Matrix
                  </span>
                </div>

                <div class="table-wrapper">
                  <table class="table-data min-w-full">
                    <thead>
                      <tr>
                        <th scope="col" class="w-12 text-center text-[11px]">#</th>
                        <th scope="col" class="w-5/12 text-left text-[11px]">Salient Feature</th>
                        <th scope="col" class="text-left text-[11px]">Technical Specification</th>
                      </tr>
                    </thead>
                    <tbody>
                      {salientSpecs.length > 0 ? (
                        salientSpecs.map((spec: any, idx: number) => (
                          <tr class="hover:bg-[#EAF4FF]/80 transition-colors">
                            <td class="text-center font-bold text-[11px] text-slate-400 py-2.5">{idx + 1}</td>
                            <td class="font-extrabold text-xs text-slate-800 text-left py-2.5">{spec.label}</td>
                            <td class="font-bold text-xs text-[#0B4F9C] text-left py-2.5">{spec.value}</td>
                          </tr>
                        ))
                      ) : (
                        <tr>
                          <td colspan="3" class="text-center py-6 text-xs text-slate-400 font-semibold italic">
                            No salient technical features recorded.
                          </td>
                        </tr>
                      )}
                    </tbody>
                  </table>
                </div>
              </div>

              <div class="mt-4 pt-3 border-t border-slate-100 text-[11px] text-slate-400 italic text-right font-medium">
                Verified Technical Register &bull; JKSPDCL
              </div>
            </div>

          </div>

          <!-- BOTTOM ROW: Scheme & Site Overview (Separate Card Below) -->
          {project.salientFeatures && (
            <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-6 lg:p-8 space-y-4">
              <div class="flex items-center justify-between border-b border-slate-100 pb-3">
                <h3 class="text-xs font-bold text-[#0B4F9C] uppercase tracking-wider flex items-center gap-1.5">
                  <Icon name="layers" size={14} class="text-[#0B4F9C]" /> SCHEME &amp; SITE OVERVIEW
                </h3>
                <span class="bg-blue-50 text-[#0B4F9C] border border-blue-200 px-2.5 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider">
                  Technical Documentation
                </span>
              </div>
              <div class="text-slate-700 text-sm sm:text-base leading-relaxed salient-features-content text-justify" set:html={project.salientFeatures}></div>
            </div>
          )}
        </article>

        <!-- Sidebar Navigation -->
        <aside class="space-y-6">
          <div class="card-static bg-white rounded-2xl border border-slate-200 shadow-sm p-6">
            <h3 class="font-bold text-gray-900 mb-2 border-b border-gray-100 pb-2">Business Sectors</h3>
            <ul class="flex flex-col gap-2 text-xs font-semibold text-[#0B4F9C]">
              <li><a href="/our-business/power-stations" class="hover:underline block py-1">&rarr; Operating Power Stations</a></li>
              <li><a href="/our-business/construction" class="hover:underline block py-1">&rarr; Construction Projects</a></li>
              <li><a href="/our-business/under-development" class="hover:underline block py-1">&rarr; Projects Under Development</a></li>
              <li><a href="/our-business/jv-subsidiary-projects" class="hover:underline block py-1">&rarr; JV & Subsidiary Projects</a></li>
            </ul>
          </div>
        </aside>
      </div>
    )}
  </div>
</Layout>

<script is:inline>
  function handleImageError(img) {
    const card = img.closest('.project-image-card');
    if (card) {
      card.style.display = 'none';
      const grid = card.closest('.project-top-grid');
      if (grid) {
        grid.classList.remove('md:grid-cols-2');
        grid.classList.add('md:grid-cols-1');
      }
    }
  }
</script>

<style is:global>
  .salient-features-content p {
    font-size: 1rem !important; /* text-base */
    line-height: 1.625 !important; /* leading-relaxed */
    margin-bottom: 1rem !important;
    color: #334155 !important; /* text-slate-700 */
    text-align: justify !important;
  }
</style>
