---
import Layout from '../../layouts/Layout.astro';
import { formatProjectName } from '../../utils/projectFormatter';

let projects = [];
let errorMessage = '';

try {
  const res = await fetch('http://localhost:3000/api/projects?status=Under%20Construction');
  if (res.ok) {
    projects = await res.json();
  } else {
    errorMessage = 'Failed to load projects under construction.';
  }
} catch (e) {
  errorMessage = 'Failed to connect to the backend server.';
}
---

<Layout 
  title="Construction Projects - Our Business" 
  description="Hydroelectric and thermal power projects currently under construction by JKSPDC."
>
  <div class="space-y-0">
    <!-- Premium Page Header Band -->
    <div class="page-header-band animate-fadeInUp">
      <nav class="breadcrumb-trail" aria-label="Breadcrumbs">
        <a href="/">Home</a>
        <span class="separator">/</span>
        <span>Projects</span>
        <span class="separator">/</span>
        <span class="current">Construction Projects</span>
      </nav>
      <h1>Projects Under Construction</h1>
      <p class="page-subtitle">Jammu &amp; Kashmir State Power Development Corporation Limited (JKSPDCL)</p>
    </div>

    <!-- Content -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 animate-fadeInUp delay-200">
      <!-- Main Content -->
      <article class="lg:col-span-2">
        
        {errorMessage && (
          <div class="bg-red-50 border border-red-200 text-red-800 rounded-lg p-4 text-xs font-semibold">
            {errorMessage}
          </div>
        )}

        <div class="table-wrapper">
          <table class="table-data" role="table" aria-label="Projects Under Construction List">
            <thead>
              <tr>
                <th scope="col" class="text-center w-12">#</th>
                <th scope="col">Project Name</th>
                <th scope="col">Type</th>
                <th scope="col">Capacity</th>
                <th scope="col">Location / River Basin</th>
              </tr>
            </thead>
            <tbody>
              {projects.length === 0 && !errorMessage ? (
                <tr>
                  <td colspan="5" class="text-center text-slate-500 py-12 text-sm font-medium">
                    No projects under construction found.
                  </td>
                </tr>
              ) : (
                projects.map((p, idx) => (
                  <tr class="cursor-pointer" onclick={`window.location.href='/our-business/power-station-details?id=${p.id}'`}>
                    <td class="text-center font-bold text-slate-500">{idx + 1}</td>
                    <td class="font-bold text-[#0B4F9C]">
                      <a href={`/our-business/power-station-details?id=${p.id}`} class="text-[#0B4F9C] hover:underline" onclick="event.stopPropagation();">
                        {formatProjectName(p.name)}
                      </a>
                    </td>
                    <td>
                      <span class="inline-block px-2.5 py-0.5 text-[10px] font-bold uppercase tracking-wide text-[#0B4F9C] bg-[#EAF4FF] border border-[#BDD7EE] rounded-full">
                        {p.type || 'Hydro'}
                      </span>
                    </td>
                    <td class="font-bold text-slate-700">{p.capacityMw} MW</td>
                    <td class="text-slate-600">{p.location} {p.basin ? `/ ${p.basin}` : ''}</td>
                  </tr>
                ))
              )}
            </tbody>
          </table>
        </div>

        <p class="mt-3 text-[11px] text-slate-400 font-medium text-right mb-6">
          Total Projects: <strong class="text-slate-600">{projects.length}</strong>
        </p>

        <div class="bg-gray-50 border border-gray-200 text-gray-700 rounded-lg p-6 text-center text-sm shadow-sm">
          <p class="font-semibold text-gray-800 mb-1">Under-Construction Project Registries Pending Official Approval</p>
          <p class="text-xs text-gray-500">Official execution milestones, contractor listings, and completion timetables are currently undergoing official review.</p>
          <div class="mt-3 inline-block bg-neutral-200 text-neutral-800 px-3 py-1 rounded text-[10px] font-bold uppercase tracking-wider">
            [Content Pending Approval]
          </div>
        </div>
      </article>

      <!-- Sidebar -->
      <aside class="space-y-5 animate-fadeIn delay-300">
        <div class="card-static">
          <h3 class="sidebar-card-title">Business Sectors</h3>
          <ul class="flex flex-col gap-2 text-xs font-semibold text-[#0B4F9C]">
            <li><a href="/our-business/power-stations" class="sidebar-link">Operating Power Stations</a></li>
            <li><a href="/our-business/under-development" class="sidebar-link">Projects Under Development</a></li>
            <li><a href="/our-business/jv-subsidiary-projects" class="sidebar-link">JV & Subsidiary Projects</a></li>
          </ul>
        </div>
      </aside>
    </div>
  </div>
</Layout>
