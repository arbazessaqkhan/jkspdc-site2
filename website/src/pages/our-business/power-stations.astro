---
import Layout from '../../layouts/Layout.astro';

let projects: any[] = [];
let errorMessage = '';

try {
  const res = await fetch('http://localhost:3000/api/projects?status=Operational');
  if (res.ok) {
    projects = await res.json();
  } else {
    errorMessage = 'Failed to load operating power stations.';
  }
} catch (e) {
  errorMessage = 'Failed to connect to the backend server.';
}

// Group projects dynamically by sector and then by basin
const sectors = ['State', 'Central'];
const sectorGroups = sectors.map(secName => {
  const sectorProjects = projects.filter(p => (p.sector || 'State').toLowerCase() === secName.toLowerCase());
  
  // Find unique basins in this sector
  const uniqueBasins = [...new Set(sectorProjects.map(p => p.basin || 'Unspecified Basin'))];
  
  // Sort basins: Jhelum Basin first, then Chenab, then Ravi, then others
  const basinOrder = ['jhelum', 'chenab', 'ravi'];
  uniqueBasins.sort((a, b) => {
    const idxA = basinOrder.findIndex(o => a.toLowerCase().includes(o));
    const idxB = basinOrder.findIndex(o => b.toLowerCase().includes(o));
    if (idxA === -1 && idxB === -1) return a.localeCompare(b);
    if (idxA === -1) return 1;
    if (idxB === -1) return -1;
    return idxA - idxB;
  });

  const basinsData = uniqueBasins.map(basinName => {
    const basinProjects = sectorProjects.filter(p => (p.basin || 'Unspecified Basin') === basinName);
    
    // Sort projects within the basin to match the image sequence
    const projectOrder = [
      'MHEP PAHALGAM', 'KARNAH', 'GANDERBAL', 'USHP I', 'USHP II', 'LJHP',
      'BHADERWAH', 'CHEP III', 'CHEP II', 'CHEP I', 'BHEP I', 'BHEP II',
      'SEWA III'
    ];
    basinProjects.sort((a, b) => {
      const idxA = projectOrder.indexOf(a.name.toUpperCase());
      const idxB = projectOrder.indexOf(b.name.toUpperCase());
      if (idxA === -1 && idxB === -1) return a.name.localeCompare(b.name);
      if (idxA === -1) return 1;
      if (idxB === -1) return -1;
      return idxA - idxB;
    });

    const totalCapacity = basinProjects.reduce((sum, p) => sum + p.capacityMw, 0);

    return {
      name: basinName,
      projects: basinProjects,
      totalCapacity: Number(totalCapacity.toFixed(1))
    };
  });

  const totalCapacity = sectorProjects.reduce((sum, p) => sum + p.capacityMw, 0);

  return {
    name: secName,
    basins: basinsData,
    totalCapacity: Number(totalCapacity.toFixed(1))
  };
});

const stateGroup = sectorGroups.find(g => g.name === 'State') || { name: 'State', basins: [], totalCapacity: 0 };
const centralGroup = sectorGroups.find(g => g.name === 'Central') || { name: 'Central', basins: [], totalCapacity: 0 };
---

<Layout 
  title="Operating Power Stations - Our Business" 
  description="Operating power stations managed and owned by JKSPDC."
>
  <div class="space-y-6">
    <!-- Breadcrumbs -->
    <nav class="text-xs text-gray-500" aria-label="Breadcrumbs">
      <ol class="flex gap-2">
        <li><a href="/" class="hover:underline">Home</a></li>
        <li>/</li>
        <li><span class="text-gray-400">Projects</span></li>
        <li>/</li>
        <li><span class="font-semibold text-[#0B4F9C]">Power Stations</span></li>
      </ol>
    </nav>

    <!-- Page Header -->
    <header class="border-b border-gray-200 pb-4">
      <h2 class="text-3xl font-extrabold text-[#0B4F9C]">Operating Power Stations</h2>
      <p class="text-sm text-gray-600 mt-1">Registry of active hydroelectric power plants managed by the corporation.</p>
    </header>

    <!-- Content -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
      <!-- Stations List -->
      <article class="lg:col-span-2 space-y-8">
        
        {errorMessage && (
          <div class="bg-red-50 border border-red-200 text-red-800 rounded-lg p-4 text-xs font-semibold">
            {errorMessage}
          </div>
        )}

        <!-- STATE SECTOR -->
        <div class="space-y-6">
          <div class="border-b border-[#0B4F9C]/20 pb-2 flex items-center justify-between">
            <h3 class="text-lg font-bold text-[#0B4F9C] uppercase tracking-wider">State Sector</h3>
            <span class="bg-[#0B4F9C] text-white text-xs font-bold px-3 py-1 rounded-full shadow-xs">
              Total: {stateGroup.totalCapacity} MW
            </span>
          </div>

          {stateGroup.basins.length === 0 ? (
            <div class="bg-slate-50 border border-slate-200 text-slate-500 rounded-xl p-6 text-center text-xs font-semibold italic">
              No state sector projects are currently operational.
            </div>
          ) : (
            stateGroup.basins.map((basin) => (
              <div class="bg-white rounded-xl border border-slate-200/80 shadow-xs p-4 space-y-3">
                <h4 class="text-xs font-extrabold text-slate-700 bg-slate-100 px-3 py-2 rounded uppercase tracking-wider flex justify-between">
                  <span>{basin.name}</span>
                  <span class="text-[#0B4F9C]">{basin.totalCapacity} MW</span>
                </h4>
                <div class="table-wrapper">
                  <table class="table-data min-w-full">
                    <thead>
                      <tr>
                        <th scope="col" class="text-left">Name of Power House</th>
                        <th scope="col" class="text-left">Configuration</th>
                        <th scope="col" class="text-left">Installed Capacity</th>
                        <th scope="col" class="text-left">Design Energy (MU)</th>
                        <th scope="col" class="text-left">Year of Commissioning</th>
                      </tr>
                    </thead>
                    <tbody>
                      {basin.projects.map((p) => (
                        <tr class="hover:bg-slate-50/80 transition-colors">
                          <td class="font-bold text-left text-xs">
                            <a href={`/our-business/power-station-details?id=${p.id}`} class="text-[#0B4F9C] hover:underline">
                              {p.name}
                            </a>
                          </td>
                          <td class="text-left text-xs">{p.configuration || '—'}</td>
                          <td class="font-semibold text-slate-700 text-left text-xs">{p.capacityMw} MW</td>
                          <td class="text-left text-xs">{p.designEnergy || '—'}</td>
                          <td class="text-left text-xs">{p.yearOfCommissioning || '—'}</td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              </div>
            ))
          )}
        </div>

        <!-- CENTRAL SECTOR -->
        <div class="space-y-6 pt-4">
          <div class="border-b border-slate-300 pb-2 flex items-center justify-between">
            <h3 class="text-lg font-bold text-slate-600 uppercase tracking-wider">Central Sector</h3>
            <span class="bg-slate-500 text-white text-xs font-bold px-3 py-1 rounded-full shadow-xs">
              Total: {centralGroup.totalCapacity} MW
            </span>
          </div>

          {centralGroup.basins.length === 0 ? (
            <div class="bg-slate-50 border border-slate-200 text-slate-500 rounded-xl p-6 text-center text-xs font-semibold italic">
              No central sector projects are currently operational.
            </div>
          ) : (
            centralGroup.basins.map((basin) => (
              <div class="bg-white rounded-xl border border-slate-200/80 shadow-xs p-4 space-y-3">
                <h4 class="text-xs font-extrabold text-slate-700 bg-slate-100 px-3 py-2 rounded uppercase tracking-wider flex justify-between">
                  <span>{basin.name}</span>
                  <span class="text-[#0B4F9C]">{basin.totalCapacity} MW</span>
                </h4>
                <div class="table-wrapper">
                  <table class="table-data min-w-full">
                    <thead>
                      <tr>
                        <th scope="col" class="text-left">Name of Power House</th>
                        <th scope="col" class="text-left">Configuration</th>
                        <th scope="col" class="text-left">Installed Capacity</th>
                        <th scope="col" class="text-left">Design Energy (MU)</th>
                        <th scope="col" class="text-left">Year of Commissioning</th>
                      </tr>
                    </thead>
                    <tbody>
                      {basin.projects.map((p) => (
                        <tr class="hover:bg-slate-50/80 transition-colors">
                          <td class="font-bold text-left text-xs">
                            <a href={`/our-business/power-station-details?id=${p.id}`} class="text-[#0B4F9C] hover:underline">
                              {p.name}
                            </a>
                          </td>
                          <td class="text-left text-xs">{p.configuration || '—'}</td>
                          <td class="font-semibold text-slate-700 text-left text-xs">{p.capacityMw} MW</td>
                          <td class="text-left text-xs">{p.designEnergy || '—'}</td>
                          <td class="text-left text-xs">{p.yearOfCommissioning || '—'}</td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              </div>
            ))
          )}
        </div>

      </article>

      <!-- Sidebar -->
      <aside class="space-y-4">
        <div class="card-static">
          <h3 class="font-bold text-gray-900 mb-2 border-b border-gray-100 pb-2">Business Sectors</h3>
          <ul class="flex flex-col gap-2 text-xs font-semibold text-[#0B4F9C]">
            <li><a href="/our-business/construction" class="hover:underline block py-1">&rarr; Construction Projects</a></li>
            <li><a href="/our-business/under-development" class="hover:underline block py-1">&rarr; Projects Under Development</a></li>
            <li><a href="/our-business/jv-subsidiary-projects" class="hover:underline block py-1">&rarr; JV & Subsidiary Projects</a></li>
            <li><a href="/our-business/consultancy" class="hover:underline block py-1">&rarr; Consultancy Wings</a></li>
          </ul>
        </div>
      </aside>
    </div>
  </div>
</Layout>
