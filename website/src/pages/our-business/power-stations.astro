---
import Layout from '../../layouts/Layout.astro';
import TablePagination from '../../components/TablePagination.astro';
import { formatProjectName } from '../../utils/projectFormatter';
import { BACKEND_URL } from '../../utils/api-error';

const PAGE_SIZE = 10;

let projects: any[] = [];

const apiBase = import.meta.env.PUBLIC_API_BASE || BACKEND_URL;

try {
  const res = await fetch(`${apiBase}/api/projects?status=Operational`);
  if (res.ok) {
    const data = await res.json();
    if (Array.isArray(data)) {
      projects = data;
      projects.sort((a, b) => new Date(a.createdAt || 0).getTime() - new Date(b.createdAt || 0).getTime());
    }
  } else {
    console.error('Failed to load operating power stations. Status:', res.status);
  }
} catch (e) {
  console.error('Error fetching operating power stations:', e);
}

const safeProjects = Array.isArray(projects) ? projects : [];
const totalCapacity = safeProjects.reduce((sum, p) => sum + (p.capacityMw || 0), 0);

const totalProjects = safeProjects.length;
const lastPage = Math.max(1, Math.ceil(totalProjects / PAGE_SIZE));
const rawPage = parseInt(Astro.url.searchParams.get('page') || '1', 10);
const currentPage = Math.min(Math.max(Number.isFinite(rawPage) ? rawPage : 1, 1), lastPage);
const pagedProjects = safeProjects.slice((currentPage - 1) * PAGE_SIZE, currentPage * PAGE_SIZE);
---

<Layout 
  title="Operating Power Stations - Our Business" 
  description="Operating power stations managed and owned by JKSPDC."
>
  <div class="space-y-0 w-full">
    <!-- Premium Page Header Band -->
    <div class="page-header-band animate-fadeInUp">
      <nav class="breadcrumb-trail" aria-label="Breadcrumbs">
        <a href="/">Home</a>
        <span class="separator">/</span>
        <span>Projects</span>
        <span class="separator">/</span>
        <span class="current">Power Stations</span>
      </nav>
      <h1>Operating Power Stations</h1>
      <p class="page-subtitle">Jammu &amp; Kashmir State Power Development Corporation Limited (JKSPDCL)</p>
    </div>

    <!-- Content -->
    <div class="animate-fadeInUp delay-200 mt-6">
      <!-- Stations List -->
      <article class="w-full space-y-6">
        
        <div class="border-b border-[#0B3B60]/20 pb-2 flex items-center justify-between">
          <h2 class="text-lg font-bold text-[#0B3B60] uppercase tracking-wider">All Operating Stations ({safeProjects.length})</h2>
          <span class="bg-[#0B3B60] text-white text-xs font-bold px-3 py-1 rounded-full shadow-xs">
            Total Capacity: {totalCapacity.toFixed(2)} MW
          </span>
        </div>

        <div class="bg-white rounded-xl border border-slate-200/80 shadow-xs p-3 sm:p-4 space-y-3">
          <div class="table-wrapper is-card-table">
            <table class="table-data mobile-cards-table" role="table" aria-label="Operating Power Stations">
              <thead>
                <tr>
                  <th scope="col" class="text-center w-12">#</th>
                  <th scope="col">Name of Power House</th>
                  <th scope="col">Configuration</th>
                  <th scope="col">Installed Capacity</th>
                  <th scope="col">Design Energy</th>
                  <th scope="col">Commissioning</th>
                  <th scope="col">Status</th>
                </tr>
              </thead>
              <tbody>
                {pagedProjects.length === 0 ? (
                  <tr>
                    <td colspan="7" class="text-center text-slate-500 py-8 text-xs font-semibold italic">
                      No operational power stations recorded.
                    </td>
                  </tr>
                ) : (
                  pagedProjects.map((p, idx) => (
                    <tr class="cursor-pointer" onclick={`window.location.href='/our-business/power-station-details?id=${p.id}'`}>
                      <td class="text-center font-bold text-slate-500 row-idx">{(currentPage - 1) * PAGE_SIZE + idx + 1}</td>
                      <td class="font-bold text-[#0B3B60]">
                        <a href={`/our-business/power-station-details?id=${p.id}`} class="text-[#0B3B60] hover:text-[#0B3B60] hover:underline" onclick="event.stopPropagation();">
                          {formatProjectName(p.name)}
                        </a>
                      </td>
                      <td class="text-slate-700" data-label="Configuration">{p.configuration || '—'}</td>
                      <td data-label="Capacity">
                        <span class="inline-flex items-center px-2.5 py-0.5 rounded text-xs font-bold bg-[#EAF4FF] text-[#0B3B60] border border-[#BDD7EE]">
                          {p.capacityMw} MW
                        </span>
                      </td>
                      <td class="text-slate-700" data-label="Design Energy">{p.designEnergy ? `${p.designEnergy} MU` : '—'}</td>
                      <td class="text-slate-700" data-label="Commissioned">{p.yearOfCommissioning || '—'}</td>
                      <td data-label="Status">
                        <span class="inline-flex items-center px-2 py-0.5 text-[10px] font-bold uppercase tracking-wider rounded-full bg-emerald-50 text-emerald-700 border border-emerald-200">
                          Operational
                        </span>
                      </td>
                    </tr>
                  ))
                )}
              </tbody>
            </table>
          </div>

          <TablePagination
            page={currentPage}
            lastPage={lastPage}
            total={totalProjects}
            pageSize={PAGE_SIZE}
            baseUrl={Astro.url}
          />
        </div>

      </article>

    </div>
  </div>
</Layout>
