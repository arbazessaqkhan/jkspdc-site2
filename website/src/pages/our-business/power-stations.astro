---
import Layout from '../../layouts/Layout.astro';

let projects = [];
let errorMessage = '';

try {
  const res = await fetch('http://localhost:3000/api/projects?status=Operational');
  if (res.ok) {
    projects = await res.json();
  } else {
    errorMessage = 'Failed to load operating power stations.';
  }
} catch (e) {
  errorMessage = 'Failed to connect to the backend server.';
}
---

<Layout 
  title="Operating Power Stations - Our Business" 
  description="Operating power stations managed and owned by JKSPDC."
>
  <div class="space-y-6">
    <!-- Breadcrumbs -->
    <nav class="text-xs text-gray-500" aria-label="Breadcrumbs">
      <ol class="flex gap-2">
        <li><a href="/" class="hover:underline">Home</a></li>
        <li>/</li>
        <li><span class="text-gray-400">Projects</span></li>
        <li>/</li>
        <li><span class="font-semibold text-[#0B4F9C]">Power Stations</span></li>
      </ol>
    </nav>

    <!-- Page Header -->
    <header class="border-b border-gray-200 pb-4">
      <h2 class="text-3xl font-extrabold text-[#0B4F9C]">Operating Power Stations</h2>
      <p class="text-sm text-gray-600 mt-1">Registry of active hydroelectric and thermal power plants managed by the corporation.</p>
    </header>

    <!-- Content -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
      <!-- Stations List -->
      <article class="lg:col-span-2 space-y-6">
        
        {errorMessage && (
          <div class="bg-red-50 border border-red-200 text-red-800 rounded-lg p-4 text-xs font-semibold">
            {errorMessage}
          </div>
        )}

        <div class="table-wrapper">
          <table class="table-data" aria-label="Operating Power Stations List">
            <thead>
              <tr>
                <th scope="col">Station Name</th>
                <th scope="col">Type</th>
                <th scope="col">Installed Capacity (MW)</th>
                <th scope="col">Location / River Basin</th>
              </tr>
            </thead>
            <tbody>
              {projects.length === 0 && !errorMessage ? (
                <tr>
                  <td colspan="4" class="text-center text-slate-500 py-10 text-xs font-semibold">
                    No operating power stations found.
                  </td>
                </tr>
              ) : (
                projects.map((p) => (
                  <tr class="hover:bg-slate-50/80 transition-colors">
                    <td class="font-semibold text-gray-900 text-left">{p.name}</td>
                    <td class="text-left">{p.type}</td>
                    <td class="font-semibold text-slate-800 text-left">{p.capacityMw} MW</td>
                    <td class="text-left">{p.location} {p.basin ? `/ ${p.basin}` : ''}</td>
                  </tr>
                ))
              )}
            </tbody>
          </table>
        </div>

        <div class="bg-gray-50 border border-gray-200 text-gray-700 rounded-lg p-6 text-center text-sm shadow-sm">
          <p class="font-semibold text-gray-800 mb-1">Detailed Technical Parameters Pending Official Approval</p>
          <p class="text-xs text-gray-500">Official generation records, annual yield statistics, and turbine specifications are currently undergoing official review.</p>
          <div class="mt-3 inline-block bg-neutral-200 text-neutral-800 px-3 py-1 rounded text-[10px] font-bold uppercase tracking-wider">
            [Content Pending Approval]
          </div>
        </div>
      </article>

      <!-- Sidebar -->
      <aside class="space-y-4">
        <div class="card-static">
          <h3 class="font-bold text-gray-900 mb-2 border-b border-gray-100 pb-2">Business Sectors</h3>
          <ul class="flex flex-col gap-2 text-xs font-semibold text-[#0B4F9C]">
            <li><a href="/our-business/construction" class="hover:underline block py-1">&rarr; Construction Projects</a></li>
            <li><a href="/our-business/under-development" class="hover:underline block py-1">&rarr; Projects Under Development</a></li>
            <li><a href="/our-business/jv-subsidiary-projects" class="hover:underline block py-1">&rarr; JV & Subsidiary Projects</a></li>
            <li><a href="/our-business/consultancy" class="hover:underline block py-1">&rarr; Consultancy Wings</a></li>
          </ul>
        </div>
      </aside>
    </div>
  </div>
</Layout>
