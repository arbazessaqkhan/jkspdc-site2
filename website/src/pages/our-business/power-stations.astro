---
import Layout from '../../layouts/Layout.astro';
import { formatProjectName } from '../../utils/projectFormatter';

let projects: any[] = [];
let errorMessage = '';

try {
  const res = await fetch('http://localhost:3000/api/projects?status=Operational');
  if (res.ok) {
    projects = await res.json();
  } else {
    errorMessage = 'Failed to load operating power stations.';
  }
} catch (e) {
  errorMessage = 'Failed to connect to the backend server.';
}

function normalizeBasin(rawBasin?: string): string {
  if (!rawBasin) return 'Unspecified Basin';
  const lower = rawBasin.toLowerCase().trim();
  if (lower.includes('jhelum')) return 'Jhelum Basin';
  if (lower.includes('chenab')) return 'Chenab Basin';
  if (lower.includes('ravi')) return 'Ravi Basin';
  if (lower.includes('indus')) return 'Indus Basin';
  return rawBasin.includes('Basin') ? rawBasin : `${rawBasin} Basin`;
}

const sectorLabels: Record<string, string> = {
  'state': 'State Sector',
  'jv': 'Joint Venture (JV) Sector',
};

// JKSPDCL operates solely under State Sector and Joint Venture (JV) Sector
const allowedSectors = ['State', 'JV'];

// Group projects dynamically by sector and then by basin
const sectorGroups = allowedSectors.map(secName => {
  const sectorProjects = projects.filter(p => (p.sector || 'State').toLowerCase() === secName.toLowerCase());
  
  // Find unique basins in this sector
  const uniqueBasins = [...new Set(sectorProjects.map(p => normalizeBasin(p.basin)))];
  
  // Sort basins: Jhelum Basin first, then Chenab, then Ravi, then Indus, then others
  const basinOrder = ['jhelum', 'chenab', 'ravi', 'indus'];
  uniqueBasins.sort((a, b) => {
    const idxA = basinOrder.findIndex(o => a.toLowerCase().includes(o));
    const idxB = basinOrder.findIndex(o => b.toLowerCase().includes(o));
    if (idxA === -1 && idxB === -1) return a.localeCompare(b);
    if (idxA === -1) return 1;
    if (idxB === -1) return -1;
    return idxA - idxB;
  });

  const basinsData = uniqueBasins.map(basinName => {
    const basinProjects = sectorProjects.filter(p => normalizeBasin(p.basin) === basinName);
    
    basinProjects.sort((a, b) => (b.capacityMw || 0) - (a.capacityMw || 0));

    const totalCapacity = basinProjects.reduce((sum, p) => sum + (p.capacityMw || 0), 0);

    return {
      name: basinName,
      projects: basinProjects,
      totalCapacity: Number(totalCapacity.toFixed(1))
    };
  });

  const totalCapacity = sectorProjects.reduce((sum, p) => sum + (p.capacityMw || 0), 0);
  const displayName = sectorLabels[secName.toLowerCase()] || `${secName} Sector`;

  return {
    name: secName,
    displayName,
    basins: basinsData,
    totalCapacity: Number(totalCapacity.toFixed(1)),
    projectCount: sectorProjects.length
  };
});

const visibleSectorGroups = sectorGroups;
---

<Layout 
  title="Operating Power Stations - Our Business" 
  description="Operating power stations managed and owned by JKSPDC."
>
  <div class="space-y-0 max-w-5xl mx-auto">
    <!-- Premium Page Header Band -->
    <div class="page-header-band animate-fadeInUp">
      <nav class="breadcrumb-trail" aria-label="Breadcrumbs">
        <a href="/">Home</a>
        <span class="separator">/</span>
        <span>Projects</span>
        <span class="separator">/</span>
        <span class="current">Power Stations</span>
      </nav>
      <h1>Operating Power Stations</h1>
      <p class="page-subtitle">Jammu &amp; Kashmir State Power Development Corporation Limited (JKSPDCL)</p>
    </div>

    <!-- Content -->
    <div class="animate-fadeInUp delay-200 mt-6">
      <!-- Stations List -->
      <article class="w-full space-y-8">
        
        {errorMessage && (
          <div class="bg-red-50 border border-red-200 text-red-800 rounded-lg p-4 text-xs font-semibold">
            {errorMessage}
          </div>
        )}

        <!-- SECTOR GROUPS -->
        {visibleSectorGroups.map((group, groupIdx) => (
          <div class={`space-y-6 ${groupIdx > 0 ? 'pt-4' : ''}`}>
            <div class="border-b border-[#0B4F9C]/20 pb-2 flex items-center justify-between">
              <h3 class="text-lg font-bold text-[#0B4F9C] uppercase tracking-wider">{group.displayName}</h3>
              <span class="bg-[#0B4F9C] text-white text-xs font-bold px-3 py-1 rounded-full shadow-xs">
                Total: {group.totalCapacity} MW
              </span>
            </div>

            {group.basins.length === 0 ? (
              <div class="bg-slate-50 border border-slate-200 text-slate-500 rounded-xl p-6 text-center text-xs font-semibold italic">
                No {group.displayName.toLowerCase()} projects are currently operational.
              </div>
            ) : (
              group.basins.map((basin) => (
                <div class="bg-white rounded-xl border border-slate-200/80 shadow-xs p-4 space-y-3">
                  <h4 class="text-xs font-extrabold text-slate-700 bg-slate-100 px-3 py-2 rounded uppercase tracking-wider flex justify-between">
                    <span>{basin.name}</span>
                    <span class="text-[#0B4F9C]">{basin.totalCapacity} MW</span>
                  </h4>
                  <div class="table-wrapper">
                    <table class="table-data" role="table" aria-label={`Operating Power Stations - ${basin.name}`}>
                      <thead>
                        <tr>
                          <th scope="col" class="text-center w-12">#</th>
                          <th scope="col">Name of Power House</th>
                          <th scope="col">Configuration</th>
                          <th scope="col">Installed Capacity</th>
                          <th scope="col">Design Energy</th>
                          <th scope="col">Commissioning</th>
                        </tr>
                      </thead>
                      <tbody>
                        {basin.projects.map((p, idx) => (
                          <tr class="cursor-pointer" onclick={`window.location.href='/our-business/power-station-details?id=${p.id}'`}>
                            <td class="text-center font-bold text-slate-500">{idx + 1}</td>
                            <td class="font-bold text-[#0B4F9C]">
                              <a href={`/our-business/power-station-details?id=${p.id}`} class="text-[#0B4F9C] hover:underline" onclick="event.stopPropagation();">
                                {formatProjectName(p.name)}
                              </a>
                            </td>
                            <td class="text-slate-600">{p.configuration || '—'}</td>
                            <td class="font-bold text-slate-700">{p.capacityMw} MW</td>
                            <td class="text-slate-600">{p.designEnergy ? `${p.designEnergy} MU` : '—'}</td>
                            <td class="text-slate-600">{p.yearOfCommissioning || '—'}</td>
                          </tr>
                        ))}
                      </tbody>
                    </table>
                  </div>
                </div>
              ))
            )}
          </div>
        ))}

      </article>

    </div>
  </div>
</Layout>
