---
import Layout from '../../layouts/Layout.astro';
import TablePagination from '../../components/TablePagination.astro';
import { formatProjectName } from '../../utils/projectFormatter';
import { BACKEND_URL } from '../../utils/api-error';

const PAGE_SIZE = 10;

let projects = [];
let errorMessage = '';

const apiBase = import.meta.env.PUBLIC_API_BASE || BACKEND_URL;

try {
  const res = await fetch(`${apiBase}/api/projects?status=Upcoming`);
  if (res.ok) {
    projects = await res.json();
  } else {
    errorMessage = 'Failed to load projects under development.';
  }
} catch (e) {
  errorMessage = 'Failed to connect to the backend server.';
}

const totalProjects = projects.length;
const lastPage = Math.max(1, Math.ceil(totalProjects / PAGE_SIZE));
const rawPage = parseInt(Astro.url.searchParams.get('page') || '1', 10);
const currentPage = Math.min(Math.max(Number.isFinite(rawPage) ? rawPage : 1, 1), lastPage);
const pagedProjects = projects.slice((currentPage - 1) * PAGE_SIZE, currentPage * PAGE_SIZE);
---

<Layout 
  title="Projects Under Development - Our Business" 
  description="Power projects currently in the planning, survey, or design phase by JKSPDC."
>
  <div class="space-y-0 max-w-5xl mx-auto">
    <!-- Premium Page Header Band -->
    <div class="page-header-band animate-fadeInUp">
      <nav class="breadcrumb-trail" aria-label="Breadcrumbs">
        <a href="/">Home</a>
        <span class="separator">/</span>
        <span>Projects</span>
        <span class="separator">/</span>
        <span class="current">Under Development Projects</span>
      </nav>
      <h1>Projects Under Development</h1>
      <p class="page-subtitle">Jammu &amp; Kashmir State Power Development Corporation Limited (JKSPDCL)</p>
    </div>

    <!-- Content -->
    <div class="animate-fadeInUp delay-200 mt-6">
      <!-- Main Content -->
      <article class="w-full">
        
        {errorMessage && (
          <div class="bg-red-50 border border-red-200 text-red-800 rounded-lg p-4 text-xs font-semibold">
            {errorMessage}
          </div>
        )}

        <div class="bg-white rounded-xl border border-slate-200/80 shadow-xs p-4 space-y-3">
          <div class="table-wrapper">
            <table class="table-data" role="table" aria-label="Projects Under Development List">
              <thead>
                <tr>
                  <th scope="col" class="text-center w-12">#</th>
                  <th scope="col">Project Name</th>
                  <th scope="col">Type</th>
                  <th scope="col">Capacity</th>
                  <th scope="col">Location</th>
                  <th scope="col">Status</th>
                </tr>
              </thead>
              <tbody>
                {pagedProjects.length === 0 ? (
                  <tr>
                    <td colspan="6" class="text-center text-slate-500 py-8 text-xs font-semibold italic">
                      No upcoming projects recorded.
                    </td>
                  </tr>
                ) : (
                  pagedProjects.map((p, idx) => (
                    <tr class="cursor-pointer" onclick={`window.location.href='/our-business/power-station-details?id=${p.id}'`}>
                      <td class="text-center font-bold text-slate-500">{(currentPage - 1) * PAGE_SIZE + idx + 1}</td>
                      <td class="font-bold text-[#0B3B60]">
                        <a href={`/our-business/power-station-details?id=${p.id}`} class="text-[#0B3B60] hover:text-[#0B3B60] hover:underline" onclick="event.stopPropagation();">
                          {formatProjectName(p.name)}
                        </a>
                      </td>
                      <td>
                        <span class="inline-block px-2.5 py-0.5 text-[10px] font-bold uppercase tracking-wide text-slate-700 bg-slate-100 border border-slate-200 rounded-full">
                          {p.type || 'Hydro'}
                        </span>
                      </td>
                      <td>
                        <span class="inline-flex items-center px-2.5 py-0.5 rounded text-xs font-bold bg-[#EAF4FF] text-[#0B3B60] border border-[#BDD7EE]">
                          {p.capacityMw} MW
                        </span>
                      </td>
                      <td>
                        <div class="text-sm font-medium text-slate-800">{p.location || 'UT of J&K'}</div>
                      </td>
                      <td>
                        <span class="inline-flex items-center px-2.5 py-0.5 text-[10px] font-bold uppercase tracking-wider rounded-full bg-slate-100 text-slate-700 border border-slate-300">
                          Under Development
                        </span>
                      </td>
                    </tr>
                  ))
                )}
              </tbody>
            </table>
          </div>

          <TablePagination
            page={currentPage}
            lastPage={lastPage}
            total={totalProjects}
            pageSize={PAGE_SIZE}
            baseUrl={Astro.url}
          />
        </div>
      </article>

    </div>
  </div>
</Layout>
