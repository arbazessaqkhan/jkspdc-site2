---
import Layout from '../../layouts/Layout.astro';

let projects = [];
let errorMessage = '';

try {
  const res = await fetch('http://localhost:3000/api/projects?status=Upcoming');
  if (res.ok) {
    projects = await res.json();
  } else {
    errorMessage = 'Failed to load projects under development.';
  }
} catch (e) {
  errorMessage = 'Failed to connect to the backend server.';
}
---

<Layout 
  title="Projects Under Development - Our Business" 
  description="Power projects currently in the planning, survey, or design phase by JKSPDC."
>
  <div class="space-y-0">
    <!-- Premium Page Header Band -->
    <div class="page-header-band animate-fadeInUp">
      <nav class="breadcrumb-trail" aria-label="Breadcrumbs">
        <a href="/">Home</a>
        <span class="separator">/</span>
        <span>Projects</span>
        <span class="separator">/</span>
        <span class="current">Under Development Projects</span>
      </nav>
      <h1>Projects Under Development</h1>
      <p class="page-subtitle">Jammu &amp; Kashmir State Power Development Corporation Limited (JKSPDCL)</p>
    </div>

    <!-- Content -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 animate-fadeInUp delay-200">
      <!-- Main Content -->
      <article class="lg:col-span-2 prose-gov">
        
        {errorMessage && (
          <div class="bg-red-50 border border-red-200 text-red-800 rounded-lg p-4 text-xs font-semibold">
            {errorMessage}
          </div>
        )}

        <div class="table-wrapper">
          <table class="table-data" aria-label="Projects Under Development List">
            <thead>
              <tr>
                <th scope="col">Project Name</th>
                <th scope="col">Type</th>
                <th scope="col">Capacity (MW)</th>
                <th scope="col">Location / River Basin</th>
              </tr>
            </thead>
            <tbody>
              {projects.length === 0 && !errorMessage ? (
                <tr>
                  <td colspan="4" class="text-center text-slate-500 py-10 text-xs font-semibold">
                    No projects under development found.
                  </td>
                </tr>
              ) : (
                projects.map((p) => (
                  <tr class="hover:bg-slate-50/80 transition-colors">
                    <td class="font-bold text-left text-xs">
                      <a href={`/our-business/power-station-details?id=${p.id}`} class="text-[#0B4F9C] hover:underline">
                        {p.name}
                      </a>
                    </td>
                    <td class="text-left">{p.type}</td>
                    <td class="font-semibold text-slate-800 text-left">{p.capacityMw} MW</td>
                    <td class="text-left">{p.location} {p.basin ? `/ ${p.basin}` : ''}</td>
                  </tr>
                ))
              )}
            </tbody>
          </table>
        </div>

        <div class="bg-gray-50 border border-gray-200 text-gray-700 rounded-lg p-6 text-center text-sm shadow-sm">
          <p class="font-semibold text-gray-800 mb-1">Under-Development Project Registries Pending Official Approval</p>
          <p class="text-xs text-gray-500">Official surveys, pre-feasibility reports, and environmental clearance statuses are currently undergoing official review.</p>
          <div class="mt-3 inline-block bg-neutral-200 text-neutral-800 px-3 py-1 rounded text-[10px] font-bold uppercase tracking-wider">
            [Content Pending Approval]
          </div>
        </div>
      </article>

      <!-- Sidebar -->
      <aside class="space-y-5 animate-fadeIn delay-300">
        <div class="card-static">
          <h3 class="sidebar-card-title">Business Sectors</h3>
          <ul class="flex flex-col gap-2 text-xs font-semibold text-[#0B4F9C]">
            <li><a href="/our-business/power-stations" class="sidebar-link">Operating Power Stations</a></li>
            <li><a href="/our-business/construction" class="sidebar-link">Construction Projects</a></li>
            <li><a href="/our-business/jv-subsidiary-projects" class="sidebar-link">JV & Subsidiary Projects</a></li>
          </ul>
        </div>
      </aside>
    </div>
  </div>
</Layout>
