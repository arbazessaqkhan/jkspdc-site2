---
import Layout from '../../layouts/Layout.astro';
import { formatProjectName } from '../../utils/projectFormatter';

let projects = [];
let errorMessage = '';

try {
  const res = await fetch(`${import.meta.env.PUBLIC_API_BASE}/api/projects?status=Upcoming`);
  if (res.ok) {
    projects = await res.json();
  } else {
    errorMessage = 'Failed to load projects under development.';
  }
} catch (e) {
  errorMessage = 'Failed to connect to the backend server.';
}
---

<Layout 
  title="Projects Under Development - Our Business" 
  description="Power projects currently in the planning, survey, or design phase by JKSPDC."
>
  <div class="space-y-0 max-w-5xl mx-auto">
    <!-- Premium Page Header Band -->
    <div class="page-header-band animate-fadeInUp">
      <nav class="breadcrumb-trail" aria-label="Breadcrumbs">
        <a href="/">Home</a>
        <span class="separator">/</span>
        <span>Projects</span>
        <span class="separator">/</span>
        <span class="current">Under Development Projects</span>
      </nav>
      <h1>Projects Under Development</h1>
      <p class="page-subtitle">Jammu &amp; Kashmir State Power Development Corporation Limited (JKSPDCL)</p>
    </div>

    <!-- Content -->
    <div class="animate-fadeInUp delay-200 mt-6">
      <!-- Main Content -->
      <article class="w-full">
        
        {errorMessage && (
          <div class="bg-red-50 border border-red-200 text-red-800 rounded-lg p-4 text-xs font-semibold">
            {errorMessage}
          </div>
        )}

        <div class="table-wrapper">
          <table class="table-data" role="table" aria-label="Projects Under Development List">
            <thead>
              <tr>
                <th scope="col" class="text-center w-12">#</th>
                <th scope="col">Project Name</th>
                <th scope="col">Type</th>
                <th scope="col">Capacity</th>
                <th scope="col">Location / River Basin</th>
              </tr>
            </thead>
            <tbody>
              {projects.length === 0 && !errorMessage ? (
                <tr>
                  <td colspan="5" class="text-center text-slate-500 py-12 text-sm font-medium">
                    No projects under development found.
                  </td>
                </tr>
              ) : (
                projects.map((p, idx) => (
                  <tr class="cursor-pointer" onclick={`window.location.href='/our-business/power-station-details?id=${p.id}'`}>
                    <td class="text-center font-bold text-slate-500">{idx + 1}</td>
                    <td class="font-bold text-[#0B4F9C]">
                      <a href={`/our-business/power-station-details?id=${p.id}`} class="text-[#0B4F9C] hover:underline" onclick="event.stopPropagation();">
                        {formatProjectName(p.name)}
                      </a>
                    </td>
                    <td>
                      <span class="inline-block px-2.5 py-0.5 text-[10px] font-bold uppercase tracking-wide text-[#0B4F9C] bg-[#EAF4FF] border border-[#BDD7EE] rounded-full">
                        {p.type || 'Hydro'}
                      </span>
                    </td>
                    <td class="font-bold text-slate-700">{p.capacityMw} MW</td>
                    <td class="text-slate-600">{p.location} {p.basin ? `/ ${p.basin}` : ''}</td>
                  </tr>
                ))
              )}
            </tbody>
          </table>
        </div>

        <p class="mt-3 text-[11px] text-slate-400 font-medium text-right">
          Total Projects: <strong class="text-slate-600">{projects.length}</strong>
        </p>
      </article>

    </div>
  </div>
</Layout>
