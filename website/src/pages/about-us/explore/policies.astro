---
import Layout from '../../../layouts/Layout.astro';
import Icon from '../../../components/Icon.astro';

const policies = [
  {
    id: 1,
    title: "Whistle Blower Policy",
    description: "Framework establishing a transparent vigilance mechanism for safeguarding the corporation against malpractices, abuse of authority, and corporate threats.",
    fileUrl: "/Whistle Blower Policy.pdf",
    category: "Vigilance & Governance",
    status: "Active"
  }
];
---

<Layout 
  title="Corporate Policies - About Us" 
  description="One-stop directory of all official corporate policies, vigilance frameworks, and compliance guidelines of JKSPDC."
>
  <div class="space-y-6">
    <!-- Breadcrumbs -->
    <nav class="text-xs text-gray-500" aria-label="Breadcrumbs">
      <ol class="flex gap-2">
        <li><a href="/" class="hover:underline">Home</a></li>
        <li>/</li>
        <li><span class="text-gray-400">About Us</span></li>
        <li>/</li>
        <li><span class="font-semibold text-[#0B4F9C]">Policies</span></li>
      </ol>
    </nav>

    <!-- Page Header -->
    <header class="border-b border-gray-200 pb-4">
      <h2 class="text-3xl font-extrabold text-[#0B4F9C]">Corporate Policies</h2>
      <p class="text-sm text-gray-600 mt-1">Official governance charters, environmental compliance, and organizational guidelines of the corporation.</p>
    </header>

    <!-- Content Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
      <!-- Main List -->
      <article class="lg:col-span-2 space-y-4">
        {policies.map((p, index) => (
          <div class="bg-white border border-gray-200 hover:border-gray-300 rounded-xl p-5 shadow-sm transition-all duration-200 flex flex-col md:flex-row md:items-center justify-between gap-4">
            <div class="space-y-1 max-w-xl">
              <div class="flex items-center gap-2 flex-wrap">
                <span class="text-[9px] uppercase tracking-wider font-extrabold text-[#0B4F9C] bg-[#0B4F9C]/5 px-2 py-0.5 rounded">
                  {p.category}
                </span>
                {p.status === "Active" ? (
                  <span class="bg-emerald-100 text-emerald-700 text-[9px] font-extrabold uppercase px-2 py-0.5 rounded">
                    Active
                  </span>
                ) : (
                  <span class="bg-amber-100 text-amber-700 text-[9px] font-extrabold uppercase px-2 py-0.5 rounded">
                    Under Review
                  </span>
                )}
              </div>
              <h3 class="font-bold text-gray-900 text-base mt-1.5 flex items-center gap-1.5">
                <span class="text-slate-400">{index + 1}.</span> {p.title}
              </h3>
              <p class="text-xs text-slate-500 leading-relaxed mt-1">
                {p.description}
              </p>
            </div>
            
            <div class="shrink-0 flex items-center">
              {p.fileUrl ? (
                <a 
                  href={p.fileUrl} 
                  target="_blank" 
                  rel="noopener noreferrer" 
                  class="w-full md:w-auto inline-flex items-center justify-center gap-2 bg-[#0B4F9C] hover:bg-[#084A8F] text-white font-bold text-xs px-5 py-2.5 rounded transition-all duration-150 shadow-sm cursor-pointer"
                >
                  <Icon name="search" size={13} strokeWidth={2.5} /> View Policy PDF
                </a>
              ) : (
                <button 
                  disabled 
                  class="w-full md:w-auto inline-flex items-center justify-center gap-2 bg-slate-100 text-slate-400 font-bold text-xs px-5 py-2.5 rounded border border-slate-200 cursor-not-allowed"
                >
                  📄 Pending Approval
                </button>
              )}
            </div>
          </div>
        ))}
      </article>

      <!-- Sidebar -->
      <aside class="space-y-4">
        <div class="card-static bg-gradient-to-br from-[#0B4F9C]/5 to-[#0B4F9C]/10 border border-[#0B4F9C]/15">
          <h3 class="font-bold text-[#0B4F9C] mb-2 border-b border-[#0B4F9C]/15 pb-2">Policies Submissions</h3>
          <p class="text-xs text-slate-650 leading-relaxed mb-3">
            JKSPDCL updates its corporate governance framework periodically in compliance with statutory instructions. Newly formulated policy charters will be listed here immediately post Board clearance.
          </p>
        </div>
        
        <div class="card-static">
          <h3 class="font-bold text-gray-900 mb-2 border-b border-gray-100 pb-2">Quick Navigation</h3>
          <ul class="flex flex-col gap-2 text-xs font-semibold text-[#0B4F9C]">
            <li><a href="/about-us/explore/association-memorandum" class="hover:underline block py-1">&rarr; MoA & AoA</a></li>
            <li><a href="/about-us/explore/ethics-code" class="hover:underline block py-1">&rarr; Code of Conduct</a></li>
            <li><a href="/about-us/explore/roles-responsibility" class="hover:underline block py-1">&rarr; Roles & Responsibilities</a></li>
          </ul>
        </div>
      </aside>
    </div>
  </div>
</Layout>
