---
import Layout from '../../../layouts/Layout.astro';
import Icon from '../../../components/Icon.astro';

function getDocUrl(url?: string) {
  if (!url) return '#';
  if (url.startsWith('/uploads/')) {
    return `${import.meta.env.PUBLIC_API_BASE}${url}`;
  }
  return url;
}

let policies: any[] = [];

try {
  // Fetch from Resources / Downloads where category is Policies
  const downloadsRes = await fetch(`${import.meta.env.PUBLIC_API_BASE}/api/downloads`).catch(() => null);

  if (downloadsRes && downloadsRes.ok) {
    const dlData = await downloadsRes.json();
    if (Array.isArray(dlData)) {
      policies = dlData.filter((d: any) => 
        (!d.status || d.status === 'Active') &&
        (d.category && (d.category.toLowerCase() === 'policies' || d.category.toLowerCase() === 'corporate policies'))
      );
    }
  }
} catch (e) {
  console.error('Error fetching policies:', e);
}

// Fallback to preserve static whistleblower policy if backend is empty/unavailable
if (policies.length === 0) {
  policies = [
    {
      id: "fallback-1",
      title: "Whistle Blower Policy",
      description: "Framework establishing a transparent vigilance mechanism for safeguarding the corporation against malpractices, abuse of authority, and corporate threats.",
      documentUrl: "/Whistle Blower Policy.pdf",
      category: "Policies",
      status: "Active"
    }
  ];
}
---

<Layout 
  title="Corporate Policies - About Us" 
  description="One-stop directory of all official corporate policies, vigilance frameworks, and compliance guidelines of JKSPDC."
>
  <div class="space-y-0 max-w-5xl mx-auto">
    <!-- Premium Page Header Band -->
    <div class="page-header-band animate-fadeInUp">
      <nav class="breadcrumb-trail" aria-label="Breadcrumbs">
        <a href="/">Home</a>
        <span class="separator">/</span>
        <span>About Us</span>
        <span class="separator">/</span>
        <span class="current">Policies</span>
      </nav>
      <h1>Corporate Policies</h1>
      <p class="page-subtitle">Jammu &amp; Kashmir State Power Development Corporation Limited (JKSPDCL)</p>
    </div>

    <!-- Content -->
    <div class="animate-fadeInUp delay-200 mt-6">
      <!-- Main List -->
      <article class="prose-gov space-y-4 w-full">
        {policies.map((p, index) => (
          <div class="bg-white border border-gray-200 hover:border-[#9BC2E6] rounded-xl p-5 shadow-xs transition-all duration-200 flex flex-col md:flex-row md:items-center justify-between gap-4">
            <div class="space-y-2 flex-1">
              <div class="flex items-center gap-2 flex-wrap">
                <span class="text-[9px] uppercase tracking-wider font-extrabold text-[#0B4F9C] bg-[#0B4F9C]/5 px-2.5 py-1 rounded-sm">
                  {p.category || "Policies"}
                </span>
                {p.status === "Active" ? (
                  <span class="bg-emerald-100 text-emerald-700 text-[9px] font-extrabold uppercase px-2.5 py-1 rounded-sm">
                    Active
                  </span>
                ) : (
                  <span class="bg-amber-100 text-amber-700 text-[9px] font-extrabold uppercase px-2.5 py-1 rounded-sm">
                    Under Review
                  </span>
                )}
              </div>
              <div class="flex items-start gap-2.5 pt-0.5">
                <div class="w-1 h-5 bg-[#D8681B] rounded-full shrink-0 mt-0.5"></div>
                <h3 class="font-bold text-[#0B4F9C] text-base leading-snug flex items-center gap-1.5">
                  <span class="text-slate-500">{index + 1}.</span> {p.title}
                </h3>
              </div>
              {p.description && (
                <p class="text-xs text-slate-500 leading-relaxed pl-3.5">
                  {p.description}
                </p>
              )}
            </div>
            
            <div class="shrink-0 flex items-center">
              {p.documentUrl ? (
                <a 
                  href={getDocUrl(p.documentUrl)} 
                  target="_blank" 
                  rel="noopener noreferrer" 
                  class="w-full md:w-auto inline-flex items-center justify-center gap-2 bg-[#0B4F9C] hover:bg-[#084A8F] text-white font-bold text-xs px-5 py-2.5 rounded transition-all duration-150 shadow-sm cursor-pointer"
                >
                  <Icon name="search" size={13} strokeWidth={2.5} /> View Policy PDF
                </a>
              ) : (
                <button 
                  disabled 
                  class="w-full md:w-auto inline-flex items-center justify-center gap-2 bg-slate-100 text-slate-400 font-bold text-xs px-5 py-2.5 rounded border border-slate-200 cursor-not-allowed"
                >
                  <Icon name="file-text" size={13} class="text-slate-400" />
                  <span>Pending Approval</span>
                </button>
              )}
            </div>
          </div>
        ))}
      </article>

    </div>
  </div>
</Layout>
