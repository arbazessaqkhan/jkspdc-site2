---
import Layout from '../../../layouts/Layout.astro';
---

<Layout 
  title="Organization Chart - Explore About Us" 
  description="Corporate Organization Chart of the Jammu & Kashmir State Power Development Corporation."
>
  <div class="space-y-0">
    <!-- Premium Page Header Band -->
    <div class="page-header-band animate-fadeInUp">
      <nav class="breadcrumb-trail" aria-label="Breadcrumbs">
        <a href="/">Home</a>
        <span class="separator">/</span>
        <span>About Us</span>
        <span class="separator">/</span>
        <span class="current">Organization Chart</span>
      </nav>
      <h1>Organization Chart</h1>
      <p class="page-subtitle">Jammu &amp; Kashmir State Power Development Corporation Limited (JKSPDCL)</p>
    </div>

    <!-- Content -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 animate-fadeInUp delay-200">
      <!-- Org Chart Render -->
      <article class="lg:col-span-2 prose-gov">
        <div class="bg-white border border-gray-200 rounded-lg p-6 shadow-sm flex flex-col items-center">
          <img 
            src="/about-us/organisational-structure.png" 
            alt="JKSPDC Corporate Structure Chart" 
            class="max-w-full h-auto object-contain border border-gray-100 rounded-md"
          />
        </div>
      </article>

      <!-- Sidebar -->
      <aside class="space-y-5 animate-fadeIn delay-300">
        <div class="card-static">
          <h3 class="sidebar-card-title">Quick Navigation</h3>
          <ul class="flex flex-col gap-2 text-xs font-semibold text-[#0B4F9C]">
            <li><a href="/about-us/explore/roles-responsibility" class="sidebar-link">Roles & Responsibilities</a></li>
            <li><a href="/about-us/explore/executives-directory" class="sidebar-link">Senior Executives Contacts</a></li>
            <li><a href="/about-us/management/board" class="sidebar-link">Board of Directors</a></li>
          </ul>
        </div>
      </aside>
    </div>
  </div>
</Layout>
