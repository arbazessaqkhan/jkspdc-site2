---
import Layout from '../../../layouts/Layout.astro';
---

<Layout 
  title="Organization Chart - Explore About Us" 
  description="Corporate Organization Chart of the Jammu & Kashmir State Power Development Corporation."
>
  <div class="space-y-6">
    <!-- Breadcrumbs -->
    <nav class="text-xs text-gray-500" aria-label="Breadcrumbs">
      <ol class="flex gap-2">
        <li><a href="/" class="hover:underline">Home</a></li>
        <li>/</li>
        <li><span class="text-gray-400">About Us</span></li>
        <li>/</li>
        <li><span class="font-semibold text-[#0B4F9C]">Organization Chart</span></li>
      </ol>
    </nav>

    <!-- Page Header -->
    <header class="border-b border-gray-200 pb-4">
      <h2 class="text-3xl font-extrabold text-[#0B4F9C]">Organization Chart</h2>
      <p class="text-sm text-gray-600 mt-1">Hierarchical structure of the administrative and technical wings of the corporation.</p>
    </header>

    <!-- Content -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
      <!-- Org Chart Render -->
      <article class="lg:col-span-2 space-y-6">
        
        <!-- Interactive visual hierarchy tree (semantic layout) -->
        <div class="bg-white border border-gray-200 rounded-lg p-6 shadow-sm flex flex-col items-center gap-6">
          <div class="bg-[#0B4F9C] text-white font-bold px-6 py-3 rounded text-center text-sm shadow-sm" aria-label="Level 1: Governance Board">
            <p>Board of Directors</p>
            <p class="text-xs text-gray-300 font-normal">[Membership Details Pending Approval]</p>
          </div>
          
          <div class="w-1 h-8 bg-gray-300" aria-hidden="true"></div>
          
          <div class="bg-[#002244] text-white font-bold px-6 py-3 rounded text-center text-sm shadow-sm" aria-label="Level 2: Executive Management">
            <p>Managing Director</p>
            <p class="text-xs text-gray-300 font-normal">[Appointment Details Pending Approval]</p>
          </div>

          <div class="w-1 h-8 bg-gray-300" aria-hidden="true"></div>

          <!-- Child rows split -->
          <div class="flex flex-col md:flex-row gap-6 w-full justify-around items-stretch">
            <div class="bg-gray-50 border border-gray-300 rounded p-4 flex-1 text-center text-xs" aria-label="Level 3: Technical Wing">
              <p class="font-bold text-[#0B4F9C] mb-1">Technical Wing</p>
              <p class="text-gray-600">[Details Pending Approval]</p>
            </div>
            <div class="bg-gray-50 border border-gray-300 rounded p-4 flex-1 text-center text-xs" aria-label="Level 3: Finance Wing">
              <p class="font-bold text-[#0B4F9C] mb-1">Finance & Corporate Affairs Wing</p>
              <p class="text-gray-600">[Details Pending Approval]</p>
            </div>
            <div class="bg-gray-50 border border-gray-300 rounded p-4 flex-1 text-center text-xs" aria-label="Level 3: HR & Admin Wing">
              <p class="font-bold text-[#0B4F9C] mb-1">Human Resources & Administration</p>
              <p class="text-gray-600">[Details Pending Approval]</p>
            </div>
          </div>
        </div>
      </article>

      <!-- Sidebar -->
      <aside class="space-y-4">
        <div class="card-static">
          <h3 class="font-bold text-gray-900 mb-2 border-b border-gray-100 pb-2">Quick Navigation</h3>
          <ul class="flex flex-col gap-2 text-xs font-semibold text-[#0B4F9C]">
            <li><a href="/about-us/explore/roles-responsibility" class="hover:underline block py-1">&rarr; Roles & Responsibilities</a></li>
            <li><a href="/about-us/explore/executives-directory" class="hover:underline block py-1">&rarr; Senior Executives Contacts</a></li>
            <li><a href="/about-us/management/board" class="hover:underline block py-1">&rarr; Board of Directors</a></li>
          </ul>
        </div>
      </aside>
    </div>
  </div>
</Layout>
