<Layout 
  title="Overview - Explore About Us" 
  description="Overview of the Jammu & Kashmir State Power Development Corporation (JKSPDC)."
>
  <div class="space-y-0">
    <!-- Premium Page Header Band -->
    <div class="page-header-band animate-fadeInUp">
      <nav class="breadcrumb-trail" aria-label="Breadcrumbs">
        <a href="/">Home</a>
        <span class="separator">/</span>
        <span>About Us</span>
        <span class="separator">/</span>
        <span class="current">Overview</span>
