---
import Layout from '../../../layouts/Layout.astro';
import { formatEmail } from '../../../utils/formatEmail';

let executivesList: any[] = [];

try {
  const res = await fetch('http://localhost:3000/api/executives');
  if (res.ok) {
    executivesList = await res.json();
  }
} catch (e) {
  console.error('Error fetching executives:', e);
}

const defaultExecutives = [
  { designation: 'Managing Director', location: 'Srinagar / Jammu', phone: '[Content Pending Approval]', email: 'md@jkspdc.nic.in' },
  { designation: 'Executive Director (Technical)', location: 'Srinagar / Jammu', phone: '[Content Pending Approval]', email: 'edtech@jkspdc.nic.in' },
  { designation: 'Executive Director (Electric)', location: 'Jammu', phone: '[Content Pending Approval]', email: 'edelect@jkspdc.nic.in' },
  { designation: 'Director Finance', location: 'Srinagar / Jammu', phone: '[Content Pending Approval]', email: 'dirfin@jkspdc.nic.in' },
  { designation: 'Chief Engineer, CI&D Wing', location: 'Srinagar', phone: '[Content Pending Approval]', email: 'cecidkashmir@jkspdc.nic.in' },
  { designation: 'Chief Engineer, Generation Wing', location: 'Kashmir', phone: '[Content Pending Approval]', email: 'cegenkashmir@jkspdc.nic.in' },
  { designation: 'Chief Engineer, Generation Wing', location: 'Jammu', phone: '[Content Pending Approval]', email: 'cegenjammu@jkspdc.nic.in' },
  { designation: 'Company Secretary', location: 'Srinagar / Jammu', phone: '[Content Pending Approval]', email: 'cs@jkspdc.nic.in' },
];

const displayExecutives = executivesList.length > 0 ? executivesList.map(ex => ({
  designation: ex.name ? `${ex.name} (${ex.designation})` : ex.designation,
  location: ex.officeAddress || ex.department || 'Srinagar / Jammu',
  phone: ex.phone || '[Content Pending Approval]',
  email: ex.email || 'info@jkspdc.nic.in',
})) : defaultExecutives;
---

<Layout 
  title="Senior Executives Directory - Explore About Us" 
  description="Contact information and phone numbers of Senior Executives at JKSPDC."
>
  <div class="space-y-0">
    <!-- Premium Page Header Band -->
    <div class="page-header-band animate-fadeInUp">
      <nav class="breadcrumb-trail" aria-label="Breadcrumbs">
        <a href="/">Home</a>
        <span class="separator">/</span>
        <span>About Us</span>
        <span class="separator">/</span>
        <span class="current">Phone No. of Sr. Executives</span>
      </nav>
      <h1>Phone Directory of Senior Executives</h1>
      <p class="page-subtitle">Jammu &amp; Kashmir State Power Development Corporation Limited (JKSPDCL)</p>
    </div>

    <!-- Content -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 animate-fadeInUp delay-200">
      <!-- Directory Table -->
      <article class="lg:col-span-2 prose-gov">
        <div class="table-wrapper">
          <table class="table-data" aria-label="Senior Executive Contact Directory">
            <thead>
              <tr>
                <th scope="col">Designation / Department</th>
                <th scope="col">Office Location</th>
                <th scope="col">Official Phone No.</th>
                <th scope="col">Official Email</th>
              </tr>
            </thead>
            <tbody>
              {displayExecutives.map((ex) => (
                <tr>
                  <td class="font-semibold text-gray-900">{ex.designation}</td>
                  <td>{ex.location}</td>
                  <td>{ex.phone}</td>
                  <td><a href={`mailto:${ex.email}`} class="text-blue-600 hover:underline">{formatEmail(ex.email)}</a></td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <div class="alert-info" role="note">
          <span class="font-bold" aria-hidden="true">ℹ</span>
          <div>
            <strong>General Correspondence:</strong> For general public grievances and commercial inquiries, please direct emails to the corporate office at <strong>contact[at]jkspdc[dot]nic[dot]in</strong>.
          </div>
        </div>
      </article>

      <!-- Sidebar -->
      <aside class="space-y-5 animate-fadeIn delay-300">
        <div class="card-static">
          <h3 class="sidebar-card-title">Quick Navigation</h3>
          <ul class="flex flex-col gap-2 text-xs font-semibold text-[#0B4F9C]">
            <li><a href="/about-us/explore/organization-chart" class="sidebar-link">Organization Chart</a></li>
            <li><a href="/about-us/explore/roles-responsibility" class="sidebar-link">Roles & Responsibilities</a></li>
            <li><a href="/about-us/others/contact" class="sidebar-link">Corporate Office Address</a></li>
          </ul>
        </div>
      </aside>
    </div>
  </div>
</Layout>
