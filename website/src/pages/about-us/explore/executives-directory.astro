---
import Layout from '../../../layouts/Layout.astro';
---

<Layout 
  title="Senior Executives Directory - Explore About Us" 
  description="Contact information and phone numbers of Senior Executives at JKSPDC."
>
  <div class="space-y-6">
    <!-- Breadcrumbs -->
    <nav class="text-xs text-gray-500" aria-label="Breadcrumbs">
      <ol class="flex gap-2">
        <li><a href="/" class="hover:underline">Home</a></li>
        <li>/</li>
        <li><span class="text-gray-400">About Us</span></li>
        <li>/</li>
        <li><span class="text-gray-400">Explore</span></li>
        <li>/</li>
        <li><span class="font-semibold text-[#0B4F9C]">Phone No. of Sr. Executives</span></li>
      </ol>
    </nav>

    <!-- Page Header -->
    <header class="border-b border-gray-200 pb-4">
      <h2 class="text-3xl font-extrabold text-[#0B4F9C]">Phone Directory of Senior Executives</h2>
      <p class="text-sm text-gray-600 mt-1">Official contact registry for public interface and administrative departments.</p>
    </header>

    <!-- Content -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
      <!-- Directory Table -->
      <article class="lg:col-span-2 space-y-4">
        <div class="table-wrapper">
          <table class="table-data" aria-label="Senior Executive Contact Directory">
            <thead>
              <tr>
                <th scope="col">Designation / Department</th>
                <th scope="col">Office Location</th>
                <th scope="col">Official Phone No.</th>
                <th scope="col">Official Email</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td class="font-semibold text-gray-900">Managing Director</td>
                <td>Srinagar / Jammu</td>
                <td>[Content Pending Approval]</td>
                <td>md@jkspdc.nic.in</td>
              </tr>
              <tr>
                <td class="font-semibold text-gray-900">Executive Director (Technical)</td>
                <td>Srinagar</td>
                <td>[Content Pending Approval]</td>
                <td>edtech@jkspdc.nic.in</td>
              </tr>
              <tr>
                <td class="font-semibold text-gray-900">Executive Director (Finance)</td>
                <td>Jammu</td>
                <td>[Content Pending Approval]</td>
                <td>edfin@jkspdc.nic.in</td>
              </tr>
              <tr>
                <td class="font-semibold text-gray-900">Company Secretary</td>
                <td>Srinagar</td>
                <td>[Content Pending Approval]</td>
                <td>cs@jkspdc.nic.in</td>
              </tr>
            </tbody>
          </table>
        </div>

        <div class="alert-info" role="note">
          <span class="font-bold" aria-hidden="true">ℹ</span>
          <div>
            <strong>General Correspondence:</strong> For general public grievances and commercial inquiries, please direct emails to the corporate office at <strong>contact@jkspdc.nic.in</strong>.
          </div>
        </div>
      </article>

      <!-- Sidebar -->
      <aside class="space-y-4">
        <div class="card-static">
          <h3 class="font-bold text-gray-900 mb-2 border-b border-gray-100 pb-2">Quick Navigation</h3>
          <ul class="flex flex-col gap-2 text-xs font-semibold text-[#0B4F9C]">
            <li><a href="/about-us/explore/organization-chart" class="hover:underline block py-1">&rarr; Organization Chart</a></li>
            <li><a href="/about-us/explore/roles-responsibility" class="hover:underline block py-1">&rarr; Roles & Responsibilities</a></li>
            <li><a href="/about-us/others/contact" class="hover:underline block py-1">&rarr; Corporate Office Address</a></li>
          </ul>
        </div>
      </aside>
    </div>
  </div>
</Layout>
