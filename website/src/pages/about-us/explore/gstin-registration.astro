---
import Layout from '../../../layouts/Layout.astro';
import Icon from '../../../components/Icon.astro';
---

<Layout 
  title="GSTIN Registration Details - Explore About Us" 
  description="Official Goods and Services Tax Identification Number (GSTIN) registration details of JKSPDCL."
>
  <div class="space-y-0 max-w-5xl mx-auto">
    <!-- Premium Page Header Band -->
    <div class="page-header-band animate-fadeInUp">
      <nav class="breadcrumb-trail" aria-label="Breadcrumbs">
        <a href="/">Home</a>
        <span class="separator">/</span>
        <span>About Us</span>
        <span class="separator">/</span>
        <span class="current">GSTIN Registration</span>
      </nav>
      <h1>GSTIN — Goods & Services Tax Identification Number</h1>
      <p class="page-subtitle">Jammu &amp; Kashmir State Power Development Corporation Limited (JKSPDCL)</p>
    </div>

    <!-- Content -->
    <div class="animate-fadeInUp delay-200 mt-6 space-y-6">
      <!-- Main Content -->
      <article class="w-full space-y-6">
        
        <!-- Registration Identifiers Summary Cards -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
          <div class="bg-white border border-slate-200/90 border-t-[3px] border-t-[#0B3B60] rounded-xl p-5 shadow-xs flex flex-col justify-between">
            <span class="text-[11px] uppercase tracking-wider font-bold text-slate-500 block">CIN (Corporate Identity Number)</span>
            <span class="text-sm sm:text-base font-mono font-extrabold text-[#002B49] tracking-tight block mt-1.5 select-all">U40101JK1995SGC001418</span>
          </div>
          
          <div class="bg-white border border-slate-200/90 border-t-[3px] border-t-[#0B3B60] rounded-xl p-5 shadow-xs flex flex-col justify-between">
            <span class="text-[11px] uppercase tracking-wider font-bold text-slate-500 block">PAN (Permanent Account Number)</span>
            <span class="text-sm sm:text-base font-mono font-extrabold text-[#002B49] tracking-tight block mt-1.5 select-all">AAACJ9770H</span>
          </div>

          <div class="bg-white border border-slate-200/90 border-t-[3px] border-t-[#0EA4E5] rounded-xl p-5 shadow-xs flex flex-col justify-between">
            <span class="text-[11px] uppercase tracking-wider font-bold text-[#0B3B60] block">Primary GSTIN</span>
            <span class="text-sm sm:text-base font-mono font-extrabold text-[#0B3B60] tracking-tight block mt-1.5 select-all">01AAACJ9770H2ZL</span>
          </div>
        </div>

        <!-- Scannable Registration Details Card -->
        <div class="bg-white border border-slate-200/90 rounded-xl shadow-xs overflow-hidden">
          <!-- Primary Header Band -->
          <div class="bg-[#0B3B60] border-b border-[#002B49] px-5 sm:px-6 py-4 flex flex-wrap items-center justify-between gap-3">
            <div class="flex items-center gap-2.5">
              <span class="w-8 h-8 rounded-lg bg-white/15 border border-white/20 flex items-center justify-center shrink-0">
                <Icon name="clipboard" size={17} class="text-white" />
              </span>
              <div>
                <span class="block text-[10.5px] font-semibold uppercase tracking-wider text-[#A4D7F4]">Registered Entity &amp; Unit</span>
                <h2 class="text-base sm:text-lg font-bold text-white leading-tight">Corporate Office, JKSPDCL</h2>
              </div>
            </div>
            <div class="flex flex-wrap items-center gap-2">
              <span class="inline-flex items-center px-2.5 py-1 rounded-full text-[11px] font-bold bg-white/15 text-white border border-white/25">
                State Code: 01
              </span>
              <span class="inline-flex items-center px-2.5 py-1 rounded-full text-[11px] font-mono font-bold bg-[#0EA4E5]/25 text-white border border-[#38BDF8]/40 select-all">
                GSTIN: 01AAACJ9770H2ZL
              </span>
            </div>
          </div>

          <!-- Structured Key-Value Details Grid -->
          <dl class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 p-5 sm:p-6">
            <div class="bg-slate-50/90 border border-slate-200/70 rounded-lg p-3.5">
              <dt class="text-[10.5px] font-bold uppercase tracking-wider text-slate-500">Name of Projects / Units</dt>
              <dd class="text-sm font-bold text-[#0B3B60] mt-1">Corporate Office, JKSPDCL</dd>
            </div>
            <div class="bg-slate-50/90 border border-slate-200/70 rounded-lg p-3.5">
              <dt class="text-[10.5px] font-bold uppercase tracking-wider text-slate-500">State / Union Territory</dt>
              <dd class="text-sm font-bold text-slate-900 mt-1">Jammu &amp; Kashmir <span class="text-xs font-mono font-semibold text-slate-500">(Code: 01)</span></dd>
            </div>
            <div class="bg-slate-50/90 border border-slate-200/70 rounded-lg p-3.5">
              <dt class="text-[10.5px] font-bold uppercase tracking-wider text-slate-500">GSTIN</dt>
              <dd class="text-sm font-mono font-extrabold text-[#0B3B60] mt-1 select-all">01AAACJ9770H2ZL</dd>
            </div>
            <div class="bg-slate-50/90 border border-slate-200/70 rounded-lg p-3.5 md:col-span-2 lg:col-span-3 grid grid-cols-1 md:grid-cols-2 gap-4">
              <div>
                <dt class="text-[10.5px] font-bold uppercase tracking-wider text-slate-500">Address of Principal / Additional Place of Business</dt>
                <dd class="text-sm font-semibold text-slate-800 mt-1">Ashok Nagar, Satwari, Jammu-180004.</dd>
              </div>
              <div class="md:border-l md:border-slate-200 md:pl-4">
                <dt class="text-[10.5px] font-bold uppercase tracking-wider text-slate-500">Principal Place of Business for GST</dt>
                <dd class="text-sm font-semibold text-slate-800 mt-1">Ashok Nagar, Satwari, Jammu-180004.</dd>
              </div>
            </div>
          </dl>
        </div>
      </article>
    </div>
  </div>
</Layout>
