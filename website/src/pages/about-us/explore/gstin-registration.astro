---
import Layout from '../../../layouts/Layout.astro';
---

<Layout 
  title="GSTIN Registration Details - Explore About Us" 
  description="Official Goods and Services Tax Identification Number (GSTIN) registration details of JKSPDCL."
>
  <div class="space-y-6">
    <!-- Breadcrumbs -->
    <nav class="text-xs text-gray-500" aria-label="Breadcrumbs">
      <ol class="flex gap-2">
        <li><a href="/" class="hover:underline">Home</a></li>
        <li>/</li>
        <li><span class="text-gray-400">About Us</span></li>
        <li>/</li>
        <li><span class="font-semibold text-[#0B4F9C]">GSTIN Registration</span></li>
      </ol>
    </nav>

    <!-- Page Header -->
    <header class="border-b border-gray-200 pb-4">
      <h2 class="text-3xl font-extrabold text-[#0B4F9C]">GSTIN Registration Details</h2>
      <p class="text-sm text-gray-600 mt-1">Official taxation registries of Jammu & Kashmir State Power Development Corporation Limited.</p>
    </header>

    <!-- Content -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
      <!-- Main Content -->
      <article class="lg:col-span-2 space-y-6">
        
        <!-- Registration Identifiers Dashboard Cards -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
          <div class="bg-gradient-to-br from-[#0B4F9C]/5 to-[#0B4F9C]/10 border border-[#0B4F9C]/20 rounded-xl p-4 shadow-sm">
            <span class="text-[10px] uppercase tracking-wider font-extrabold text-[#0B4F9C] block">CIN (Corporate Identity Number)</span>
            <span class="text-xs font-mono font-bold text-slate-800 block mt-1">U40101JK1995SGC001418</span>
          </div>
          
          <div class="bg-gradient-to-br from-[#0B4F9C]/5 to-[#0B4F9C]/10 border border-[#0B4F9C]/20 rounded-xl p-4 shadow-sm">
            <span class="text-[10px] uppercase tracking-wider font-extrabold text-[#0B4F9C] block">PAN (Permanent Account Number)</span>
            <span class="text-xs font-mono font-bold text-slate-800 block mt-1">AAACJ9770H</span>
          </div>

          <div class="bg-gradient-to-br from-[#D8681B]/5 to-[#D8681B]/10 border border-[#D8681B]/20 rounded-xl p-4 shadow-sm">
            <span class="text-[10px] uppercase tracking-wider font-extrabold text-[#D8681B] block">Primary GSTIN</span>
            <span class="text-xs font-mono font-bold text-[#D8681B] block mt-1">01AAACJ9770H2ZL</span>
          </div>
        </div>

        <div class="bg-white border border-[#BDD7EE] rounded-xl p-6 shadow-sm space-y-4">
          <h3 class="text-lg font-bold text-[#0B4F9C] pb-2 border-b border-slate-100 flex items-center gap-2">
            📋 Registration Details of JKSPDCL
          </h3>
          <div class="overflow-x-auto">
            <table class="table-data text-xs">
              <thead>
                <tr>
                  <th class="text-center font-bold">#</th>
                  <th class="font-bold">Name of Projects/Units</th>
                  <th class="font-bold">Address of Principal / Additional Place of Business</th>
                  <th class="font-bold">State</th>
                  <th class="text-center font-bold">State Code</th>
                  <th class="font-bold">GSTIN</th>
                  <th class="font-bold">Principal Place of Business for GST</th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td class="text-center font-bold">1</td>
                  <td class="font-semibold text-slate-800">Corporate Office, JKSPDC</td>
                  <td class="text-slate-600">Ashok Nagar, Satwari, Jammu-180004. Ashok Nagar, Satwari, Jammu-180004.</td>
                  <td class="text-slate-600">Jammu & Kashmir</td>
                  <td class="text-center font-mono font-semibold text-slate-800">01</td>
                  <td class="font-mono font-bold text-[#0B4F9C]">01AAACJ9770H2ZL</td>
                  <td class="text-slate-600 font-semibold">Ashok Nagar, Satwari, Jammu-180004.</td>
                </tr>
              </tbody>
            </table>
          </div>
          <div class="mt-6 text-xs text-slate-500 leading-relaxed space-y-2 border-t border-slate-100 pt-4">
            <p><strong>Note:</strong> Vendors, contractors, and service providers must reference the correct GSTIN on all tax invoices submitted for billing.</p>
            <p>For any queries related to TDS under GST or financial transactions, please contact the Commercial and Accounts division.</p>
          </div>
        </div>
      </article>

      <!-- Sidebar Actions -->
      <aside class="space-y-4">
        <div class="card-static">
          <h3 class="font-bold text-gray-900 mb-2 border-b border-gray-100 pb-2">Quick Navigation</h3>
          <ul class="flex flex-col gap-2 text-xs font-semibold text-[#0B4F9C]">
            <li><a href="/about-us/explore/overview" class="hover:underline block py-1">&rarr; Overview</a></li>
            <li><a href="/about-us/explore/profile" class="hover:underline block py-1">&rarr; Corporate Profile</a></li>
            <li><a href="/about-us/explore/objectives" class="hover:underline block py-1">&rarr; Main Objectives</a></li>
          </ul>
        </div>
      </aside>
    </div>
  </div>
</Layout>
