---
import Layout from '../../../layouts/Layout.astro';

let ethicsDoc = null;

try {
  const res = await fetch('http://localhost:3000/api/policies?category=Ethics');
  if (res.ok) {
    const data = await res.json();
    const activeDocs = data.filter(d => d.status === 'Active');
    if (activeDocs.length > 0) {
      ethicsDoc = activeDocs[0];
    }
  }
} catch (e) {
  console.error('Error fetching ethics document:', e);
}
---

<Layout 
  title="Code of Business Conduct & Ethics - Explore About Us" 
  description="Code of Business Conduct and Ethics of the Jammu & Kashmir State Power Development Corporation."
>
  <div class="space-y-0">
    <!-- Premium Page Header Band -->
    <div class="page-header-band animate-fadeInUp">
      <nav class="breadcrumb-trail" aria-label="Breadcrumbs">
        <a href="/">Home</a>
        <span class="separator">/</span>
        <span>About Us</span>
        <span class="separator">/</span>
        <span class="current">Code of Business Conduct & Ethics</span>
      </nav>
      <h1>Code of Business Conduct & Ethics</h1>
      <p class="page-subtitle">Jammu &amp; Kashmir State Power Development Corporation Limited (JKSPDCL)</p>
    </div>

    <!-- Content -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 animate-fadeInUp delay-200">
      <!-- Main Content -->
      <article class="lg:col-span-2 prose-gov">
        <p class="text-sm text-gray-700 leading-relaxed">
          JKSPDC is committed to conducting its business operations with integrity, transparency, and in full compliance with corporate governance standards.
        </p>

        <!-- Document download box -->
        <div class="bg-white border border-gray-200 rounded-lg p-5 shadow-sm flex items-center justify-between gap-4">
          <div>
            <h3 class="font-bold text-gray-900 text-sm mb-1">{ethicsDoc ? ethicsDoc.title : "Official Code of Conduct & Ethics Document"}</h3>
            <p class="text-xs text-gray-550">{ethicsDoc ? (ethicsDoc.description || "Approved by the Board of Directors and applicable to all administrative and technical personnel.") : "Approved by the Board of Directors and applicable to all administrative and technical personnel."}</p>
          </div>
          {ethicsDoc ? (
            <a href={ethicsDoc.documentUrl} target="_blank" rel="noopener noreferrer" class="btn-primary text-xs whitespace-nowrap cursor-pointer">
              📄 View Code of Conduct PDF
            </a>
          ) : (
            <a href="#" class="btn-outline text-xs whitespace-nowrap cursor-not-allowed">
              📄 Download Code_of_Conduct.pdf <span class="text-[10px] text-gray-500 font-normal block mt-1">(Content Pending Approval)</span>
            </a>
          )}
        </div>
      </article>

      <!-- Sidebar -->
      <aside class="space-y-5 animate-fadeIn delay-300">
        <div class="card-static">
          <h3 class="sidebar-card-title">Quick Navigation</h3>
          <ul class="flex flex-col gap-2 text-xs font-semibold text-[#0B4F9C]">
            <li><a href="/about-us/explore/association-memorandum" class="sidebar-link">Memorandum & Articles of Association</a></li>
            <li><a href="/about-us/explore/roles-responsibility" class="sidebar-link">Roles & Responsibilities</a></li>
            <li><a href="/about-us/explore/overview" class="sidebar-link">Overview</a></li>
          </ul>
        </div>
      </aside>
    </div>
  </div>
</Layout>
