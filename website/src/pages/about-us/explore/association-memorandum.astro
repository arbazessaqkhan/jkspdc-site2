---
import Layout from '../../../layouts/Layout.astro';

function getDocUrl(url?: string) {
  if (!url) return '#';
  if (url.startsWith('/uploads/')) {
    return `http://localhost:3000${url}`;
  }
  return url;
}

let memoDocs: any[] = [];

try {
  const res = await fetch('http://localhost:3000/api/policies');
  if (res.ok) {
    const data = await res.json();
    memoDocs = data.filter((d: any) => 
      d.status === 'Active' && 
      (d.category === 'Memorandum' || d.category === 'MoA / AoA')
    );
  }
} catch (e) {
  console.error('Error fetching memorandum document:', e);
}

if (memoDocs.length === 0) {
  memoDocs = [
    {
      id: "fallback-moa",
      title: "Memorandum & Articles of Association (MoA & AoA)",
      description: "Official certified copies showing legal incorporation clauses under the Companies Act.",
      documentUrl: "/MoA_AoA.pdf"
    }
  ];
}
---

<Layout 
  title="Memorandum and Articles of Association - Explore About Us" 
  description="Memorandum and Articles of Association of the Jammu & Kashmir State Power Development Corporation."
>
  <div class="space-y-0">
    <!-- Premium Page Header Band -->
    <div class="page-header-band animate-fadeInUp">
      <nav class="breadcrumb-trail" aria-label="Breadcrumbs">
        <a href="/">Home</a>
        <span class="separator">/</span>
        <span>About Us</span>
        <span class="separator">/</span>
        <span class="current">Memorandum and Articles of Association</span>
      </nav>
      <h1>MoA & AoA — Memorandum & Articles of Association</h1>
      <p class="page-subtitle">Jammu &amp; Kashmir State Power Development Corporation Limited (JKSPDCL)</p>
    </div>

    <!-- Content -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 animate-fadeInUp delay-200">
      <!-- Main Content -->
      <article class="lg:col-span-2 prose-gov space-y-4">
        <p class="text-sm text-gray-700 leading-relaxed mb-4">
          The Memorandum and Articles of Association define the purpose, authorized capital limits, internal operations, and corporate boundaries within which JKSPDC operates.
        </p>

        <!-- Document download boxes -->
        {memoDocs.map((doc) => (
          <div class="bg-white border border-gray-200 hover:border-[#0B4F9C]/40 rounded-xl p-5 shadow-sm transition-all duration-200 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
            <div>
              <h3 class="font-bold text-gray-900 text-sm mb-1">{doc.title}</h3>
              <p class="text-xs text-gray-550">{doc.description || "Official certified copies showing legal incorporation clauses under the Companies Act."}</p>
            </div>
            <a href={getDocUrl(doc.documentUrl)} target="_blank" rel="noopener noreferrer" class="btn-primary text-xs whitespace-nowrap cursor-pointer shrink-0">
              📄 View MoA & AoA PDF
            </a>
          </div>
        ))}
      </article>

      <!-- Sidebar -->
      <aside class="space-y-5 animate-fadeIn delay-300">
        <div class="card-static">
          <h3 class="sidebar-card-title">Quick Navigation</h3>
          <ul class="flex flex-col gap-2 text-xs font-semibold text-[#0B4F9C]">
            <li><a href="/about-us/explore/policies" class="sidebar-link">Corporate Policies</a></li>
            <li><a href="/about-us/explore/roles-responsibility" class="sidebar-link">Roles & Responsibilities</a></li>
            <li><a href="/about-us/explore/overview" class="sidebar-link">Overview</a></li>
          </ul>
        </div>
      </aside>
    </div>
  </div>
</Layout>
