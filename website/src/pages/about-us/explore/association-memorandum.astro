---
import Layout from '../../../layouts/Layout.astro';

let memoDoc = null;
let policyUrl = "/MoA_AoA.pdf";
let memoTitle = "Memorandum & Articles of Association (MoA & AoA)";
let memoDesc = "Official certified copies showing legal incorporation clauses under the Companies Act.";

try {
  const res = await fetch('http://localhost:3000/api/policies?category=Memorandum');
  if (res.ok) {
    const data = await res.json();
    const activeDocs = data.filter(d => d.status === 'Active');
    if (activeDocs.length > 0) {
      memoDoc = activeDocs[0];
      policyUrl = memoDoc.documentUrl;
      memoTitle = memoDoc.title;
      if (memoDoc.description) {
        memoDesc = memoDoc.description;
      }
    }
  }
} catch (e) {
  console.error('Error fetching memorandum document:', e);
}
---

<Layout 
  title="Memorandum and Articles of Association - Explore About Us" 
  description="Memorandum and Articles of Association of the Jammu & Kashmir State Power Development Corporation."
>
  <div class="space-y-6">
    <!-- Breadcrumbs -->
    <nav class="text-xs text-gray-500" aria-label="Breadcrumbs">
      <ol class="flex gap-2">
        <li><a href="/" class="hover:underline">Home</a></li>
        <li>/</li>
        <li><span class="text-gray-400">About Us</span></li>
        <li>/</li>
        <li><span class="font-semibold text-[#0B4F9C]">Memorandum and Articles of Association</span></li>
      </ol>
    </nav>

    <!-- Page Header -->
    <header class="border-b border-gray-200 pb-4">
      <h2 class="text-3xl font-extrabold text-[#0B4F9C]">Memorandum and Articles of Association</h2>
      <p class="text-sm text-gray-600 mt-1">Foundational legal and corporate constitution files of the corporation.</p>
    </header>

    <!-- Content -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
      <!-- Main Content -->
      <article class="lg:col-span-2 space-y-6">
        <p class="text-sm text-gray-700 leading-relaxed">
          The Memorandum and Articles of Association define the purpose, authorized capital limits, internal operations, and corporate boundaries within which JKSPDC operates.
        </p>

        <!-- Document download box -->
        <div class="bg-white border border-gray-200 rounded-lg p-5 shadow-sm flex items-center justify-between gap-4">
          <div>
            <h3 class="font-bold text-gray-900 text-sm mb-1">{memoTitle}</h3>
            <p class="text-xs text-gray-550">{memoDesc}</p>
          </div>
          <a href={policyUrl} target="_blank" rel="noopener noreferrer" class="btn-primary text-xs whitespace-nowrap cursor-pointer">
            📄 View MoA & AoA PDF
          </a>
        </div>
      </article>

      <!-- Sidebar -->
      <aside class="space-y-4">
        <div class="card-static">
          <h3 class="font-bold text-gray-900 mb-2 border-b border-gray-100 pb-2">Quick Navigation</h3>
          <ul class="flex flex-col gap-2 text-xs font-semibold text-[#0B4F9C]">
            <li><a href="/about-us/explore/ethics-code" class="hover:underline block py-1">&rarr; Code of Conduct & Ethics</a></li>
            <li><a href="/about-us/explore/roles-responsibility" class="hover:underline block py-1">&rarr; Roles & Responsibilities</a></li>
            <li><a href="/about-us/explore/overview" class="hover:underline block py-1">&rarr; Overview</a></li>
          </ul>
        </div>
      </aside>
    </div>
  </div>
</Layout>
