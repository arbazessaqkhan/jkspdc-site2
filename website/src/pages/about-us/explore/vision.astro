---
import Layout from '../../../layouts/Layout.astro';
---

<Layout 
  title="Vision - Explore About Us" 
  description="Corporate Vision of the Jammu & Kashmir State Power Development Corporation."
>
  <div class="space-y-0 max-w-5xl mx-auto">
    <!-- Premium Page Header Band -->
    <div class="page-header-band animate-fadeInUp">
      <nav class="breadcrumb-trail" aria-label="Breadcrumbs">
        <a href="/">Home</a>
        <span class="separator">/</span>
        <span>About Us</span>
        <span class="separator">/</span>
        <span class="current">Vision</span>
      </nav>
      <h1>Corporate Vision</h1>
      <p class="page-subtitle">Jammu &amp; Kashmir State Power Development Corporation Limited (JKSPDCL)</p>
    </div>

    <!-- Content -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 animate-fadeInUp delay-200">
      <!-- Main Text -->
      <article class="lg:col-span-2 prose-gov">
        <div class="bg-slate-50 border border-slate-200 text-slate-700 rounded-xl p-8 text-center shadow-sm">
          <p class="font-semibold text-slate-800 text-lg mb-2">Corporate Vision Statement Pending Official Approval</p>
          <p class="text-sm text-slate-500">The authorized vision document is currently undergoing official review.</p>
          <div class="mt-4 inline-block bg-slate-200 text-slate-700 px-4 py-1.5 rounded text-[10px] font-bold uppercase tracking-wider">
            Content Pending Approval
          </div>
        </div>
      </article>

      <!-- Sidebar -->
      <aside class="space-y-5 animate-fadeIn delay-300">
        <div class="card-static">
          <h3 class="sidebar-card-title">Quick Navigation</h3>
          <div class="flex flex-col gap-1">
            <a href="/about-us/explore/overview" class="sidebar-link">Overview</a>
            <a href="/about-us/explore/mission" class="sidebar-link">Mission Statement</a>
            <a href="/about-us/explore/profile" class="sidebar-link">Corporate Profile</a>
            <a href="/about-us/explore/objectives" class="sidebar-link">Main Objectives</a>
          </div>
        </div>
      </aside>
    </div>
  </div>
</Layout>
