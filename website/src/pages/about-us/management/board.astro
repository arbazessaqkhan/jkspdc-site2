---
import Layout from '../../../layouts/Layout.astro';
---

<Layout 
  title="Board of Directors - Management" 
  description="Board of Directors of the Jammu & Kashmir State Power Development Corporation."
>
  <div class="space-y-6">
    <!-- Breadcrumbs -->
    <nav class="text-xs text-gray-500" aria-label="Breadcrumbs">
      <ol class="flex gap-2">
        <li><a href="/" class="hover:underline">Home</a></li>
        <li>/</li>
        <li><span class="text-gray-400">About Us</span></li>
        <li>/</li>
        <li><span class="text-gray-400">Management</span></li>
        <li>/</li>
        <li><span class="font-semibold text-[#0B4F9C]">Board of Directors</span></li>
      </ol>
    </nav>

    <!-- Page Header -->
    <header class="border-b border-gray-200 pb-4">
      <h2 class="text-3xl font-extrabold text-[#0B4F9C]">Board of Directors</h2>
      <p class="text-sm text-gray-600 mt-1">Authorized governing board of the corporation representing administrative and financial stakeholders.</p>
    </header>

    <!-- Content -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
      <!-- Board Listings -->
      <article class="lg:col-span-2 space-y-6">
        
        <!-- Safety placeholder alert -->
        <div class="alert-info" role="note">
          <span class="font-bold" aria-hidden="true">ℹ</span>
          <div>
            <strong>Board Appointments:</strong> The list of directors is updated dynamically post-appointive orders from the Government of Jammu & Kashmir.
          </div>
        </div>

        <!-- Directors Grid -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div class="card-static flex flex-col justify-between">
            <div>
              <span class="text-[10px] text-[#0B4F9C] font-bold uppercase tracking-wider">Chairman</span>
              <h3 class="font-extrabold text-[#0B4F9C] text-base mt-1">[Chairman's Name Pending Approval]</h3>
              <p class="text-xs text-gray-500 mt-1">Chief Secretary, Union Territory of J&K</p>
            </div>
          </div>

          <div class="card-static flex flex-col justify-between">
            <div>
              <span class="text-[10px] text-[#0B4F9C] font-bold uppercase tracking-wider">Managing Director</span>
              <h3 class="font-extrabold text-[#0B4F9C] text-base mt-1">[Managing Director's Name Pending Approval]</h3>
              <p class="text-xs text-gray-500 mt-1">JKSPDC Corporate Office</p>
            </div>
          </div>
        </div>

        <!-- General Board members placeholder -->
        <div class="bg-gray-50 border border-gray-200 text-gray-700 rounded-lg p-6 text-center text-sm shadow-sm">
          <p class="font-semibold text-gray-800 mb-1">Administrative Directors List Pending Official Approval</p>
          <p class="text-xs text-gray-500">Official names and postings of Administrative Secretaries serving as Directors are currently undergoing official review.</p>
          <div class="mt-3 inline-block bg-neutral-200 text-neutral-800 px-3 py-1 rounded text-[10px] font-bold uppercase tracking-wider">
            [Content Pending Approval]
          </div>
        </div>
      </article>

      <!-- Sidebar -->
      <aside class="space-y-4">
        <div class="card-static">
          <h3 class="font-bold text-gray-900 mb-2 border-b border-gray-100 pb-2">Quick Navigation</h3>
          <ul class="flex flex-col gap-2 text-xs font-semibold text-[#0B4F9C]">
            <li><a href="/about-us/management/committees" class="hover:underline block py-1">&rarr; Committee of Directors</a></li>
            <li><a href="/about-us/explore/organization-chart" class="hover:underline block py-1">&rarr; Organization Chart</a></li>
            <li><a href="/about-us/explore/executives-directory" class="hover:underline block py-1">&rarr; Senior Executives Directory</a></li>
          </ul>
        </div>
      </aside>
    </div>
  </div>
</Layout>
