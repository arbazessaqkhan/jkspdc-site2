---
import Layout from '../../../layouts/Layout.astro';

let directors = [];
let errorMessage = '';

try {
  const res = await fetch('http://localhost:3000/api/directors');
  if (res.ok) {
    directors = await res.json();
    directors.sort((a, b) => a.sNo - b.sNo);
  } else {
    errorMessage = 'Failed to load board of directors details.';
  }
} catch (e) {
  errorMessage = 'Failed to connect to the backend server.';
}
---

<Layout 
  title="Board of Directors - Management" 
  description="Board of Directors of the Jammu & Kashmir State Power Development Corporation."
>
  <div class="space-y-0">
    <!-- Premium Page Header Band -->
    <div class="page-header-band animate-fadeInUp">
      <nav class="breadcrumb-trail" aria-label="Breadcrumbs">
        <a href="/">Home</a>
        <span class="separator">/</span>
        <span>About Us</span>
        <span class="separator">/</span>
        <span class="current">Board of Directors</span>
      </nav>
      <h1>Board of Directors</h1>
      <p class="page-subtitle">Jammu &amp; Kashmir State Power Development Corporation Limited (JKSPDCL)</p>
    </div>

    <!-- Content -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 animate-fadeInUp delay-200">
      <!-- Board Listings -->
      <article class="lg:col-span-2 prose-gov">
        
        <!-- Safety placeholder alert -->
        <div class="alert-info" role="note">
          <span class="font-bold" aria-hidden="true">ℹ</span>
          <div>
            <strong>Board Appointments:</strong> The list of directors is updated dynamically post-appointive orders from the Government of Jammu & Kashmir.
          </div>
        </div>

        <!-- Directors Grid -->
        {errorMessage && (
          <div class="bg-red-50 border border-red-200 text-red-800 rounded-lg p-4 text-xs font-semibold">
            {errorMessage}
          </div>
        )}
        
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {directors.length === 0 && !errorMessage ? (
            <div class="col-span-2 text-center py-10 bg-slate-50 border border-slate-200 rounded-xl text-slate-500 text-sm font-medium">
              No Board of Directors listed at the moment.
            </div>
          ) : (
            directors.map((dir) => (
              <div class="group bg-white rounded-xl border border-slate-200 p-5 flex flex-col justify-between shadow-sm hover:shadow-md transition-all duration-200">
                <div>
                  <span class="text-[10px] text-[#0B4F9C] font-bold uppercase tracking-wider bg-[#EAF4FF] px-2 py-0.5 rounded border border-[#BDD7EE]/50 inline-block mb-2">
                    {dir.role}
                  </span>
                  <h3 class="font-extrabold text-[#0B4F9C] text-base mt-1 group-hover:text-[#084A8F] transition-colors">{dir.name}</h3>
                  <p class="text-xs text-slate-650 mt-1.5 leading-relaxed font-medium">{dir.position}</p>
                </div>
              </div>
            ))
          )}
        </div>
      </article>

      <!-- Sidebar -->
      <aside class="space-y-5 animate-fadeIn delay-300">
        <div class="card-static">
          <h3 class="sidebar-card-title">Quick Navigation</h3>
          <ul class="flex flex-col gap-2 text-xs font-semibold text-[#0B4F9C]">
            <li><a href="/about-us/management/committees" class="sidebar-link">Committee of Directors</a></li>
            <li><a href="/about-us/explore/organization-chart" class="sidebar-link">Organization Chart</a></li>
            <li><a href="/about-us/explore/executives-directory" class="sidebar-link">Senior Executives Directory</a></li>
          </ul>
        </div>
      </aside>
    </div>
  </div>
</Layout>
