---
import Layout from '../../../layouts/Layout.astro';
---

<Layout 
  title="Honours & Awards - Others" 
  description="Honours and Awards received by the Jammu & Kashmir State Power Development Corporation."
>
  <div class="space-y-0">
    <!-- Premium Page Header Band -->
    <div class="page-header-band animate-fadeInUp">
      <nav class="breadcrumb-trail" aria-label="Breadcrumbs">
        <a href="/">Home</a>
        <span class="separator">/</span>
        <span>About Us</span>
        <span class="separator">/</span>
        <span class="current">Honours & Awards</span>
      </nav>
      <h1>Honours & Awards</h1>
      <p class="page-subtitle">Jammu &amp; Kashmir State Power Development Corporation Limited (JKSPDCL)</p>
    </div>

    <!-- Content -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 animate-fadeInUp delay-200">
      <!-- Main Text -->
      <article class="lg:col-span-2 prose-gov">
        <!-- Safety content placeholder -->
        <div class="bg-gray-50 border border-gray-200 text-gray-700 rounded-lg p-6 text-center text-sm shadow-sm">
          <p class="font-semibold text-gray-800 mb-1">Corporate Awards List Pending Official Approval</p>
          <p class="text-xs text-gray-500">Official registry records for corporate safety milestones and honours are currently undergoing official review.</p>
          <div class="mt-3 inline-block bg-neutral-200 text-neutral-800 px-3 py-1 rounded text-[10px] font-bold uppercase tracking-wider">
            [Content Pending Approval]
          </div>
        </div>
      </article>

      <!-- Sidebar Actions -->
      <aside class="space-y-5 animate-fadeIn delay-300">
        <div class="card-static">
          <h3 class="sidebar-card-title">Quick Navigation</h3>
          <ul class="flex flex-col gap-2 text-xs font-semibold text-[#0B4F9C]">
            <li><a href="/about-us/others/contact" class="sidebar-link">Contact Info</a></li>
            <li><a href="/about-us/explore/overview" class="sidebar-link">Corporate Overview</a></li>
          </ul>
        </div>
      </aside>
    </div>
  </div>
</Layout>
