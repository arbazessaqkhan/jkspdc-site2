---
import Icon from './Icon.astro';

const currentYear = new Date().getFullYear();
const lastUpdated = new Date().toLocaleDateString('en-IN', { year: 'numeric', month: 'long', day: 'numeric' });
---

<footer class="bg-[#083B73] text-slate-200 border-t-4 border-[#0B4F9C] pt-10 pb-6 text-sm">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <!-- Footer Core Columns -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10 border-b border-slate-700 pb-8 mb-6 items-start">

      <!-- Column 1: Corporate Summary -->
      <div class="flex flex-col gap-4">
        <div class="flex items-center gap-3">
          <img src="/logo.png" alt="JKSPDCL logo" class="h-14 w-auto object-contain" />
        </div>
        <p class="text-xs text-slate-300 leading-relaxed">
          JKSPDCL is a wholly owned PSU of the Government of J&amp;K, mandated with harnessing power potential across the region since 1995.
        </p>
        <a href="/about-us/explore/overview" class="text-xs text-[#7FB3E8] hover:text-white font-semibold flex items-center gap-1 mt-1 transition-colors duration-200">
          Read Our History &rarr;
        </a>
      </div>

      <!-- Column 2: Site Utilities & Compliance Policies -->
      <div class="flex flex-col gap-1">
        <h2 class="font-bold text-white uppercase tracking-wider text-xs mb-4 pb-2 border-b border-slate-600">Compliance &amp; Utilities</h2>
        <div class="flex flex-col gap-2 text-xs text-slate-300">
          <a href="/policies/accessibility" class="hover:text-white hover:translate-x-1 transition-all duration-200 inline-flex items-center gap-1.5">
            <span class="text-slate-500">›</span> Accessibility Statement
          </a>
          <a href="/policies/privacy" class="hover:text-white hover:translate-x-1 transition-all duration-200 inline-flex items-center gap-1.5">
            <span class="text-slate-500">›</span> Privacy Policy
          </a>
          <a href="/policies/terms" class="hover:text-white hover:translate-x-1 transition-all duration-200 inline-flex items-center gap-1.5">
            <span class="text-slate-500">›</span> Terms of Use
          </a>
          <a href="/policies/hyperlinking" class="hover:text-white hover:translate-x-1 transition-all duration-200 inline-flex items-center gap-1.5">
            <span class="text-slate-500">›</span> Hyperlinking Policy
          </a>
          <a href="/policies/copyright" class="hover:text-white hover:translate-x-1 transition-all duration-200 inline-flex items-center gap-1.5">
            <span class="text-slate-500">›</span> Copyright Policy
          </a>
          <a href="/sitemap" class="hover:text-white hover:translate-x-1 transition-all duration-200 inline-flex items-center gap-1.5">
            <span class="text-slate-500">›</span> Sitemap
          </a>
          <a href="/help" class="hover:text-white hover:translate-x-1 transition-all duration-200 inline-flex items-center gap-1.5">
            <span class="text-slate-500">›</span> Help &amp; FAQ
          </a>
        </div>
      </div>

      <!-- Column 3: Contact Directory -->
      <div class="flex flex-col gap-1 text-xs text-slate-300">
        <h2 class="font-bold text-white uppercase tracking-wider text-xs mb-4 pb-2 border-b border-slate-600">Contact Directory</h2>
        <div class="space-y-2">
          <p class="font-semibold text-slate-200 text-xs uppercase tracking-wide">Srinagar Office</p>
          <p class="leading-relaxed">Exhibition Grounds, Jahangir Chowk,<br/>Srinagar — 190009</p>
          <p>
            <a href="tel:+911942451665" class="hover:text-white transition-colors inline-flex items-center gap-1.5">
              <Icon name="phone" size={13} strokeWidth={2} />
              +91 194 2451665
            </a>
          </p>
        </div>
        <div class="space-y-2 mt-4 pt-3 border-t border-slate-700">
          <p class="font-semibold text-slate-200 text-xs uppercase tracking-wide">Jammu Office</p>
          <p class="leading-relaxed">Ashok Nagar, Satwari,<br/>Jammu (J&amp;K) — 180004</p>
          <p>
            <a href="tel:+911912430548" class="hover:text-white transition-colors inline-flex items-center gap-1.5">
              <Icon name="phone" size={13} strokeWidth={2} />
              +91 191 2430548 / 2439039
            </a>
          </p>
        </div>
      </div>

      <!-- Column 4: Quick Navigation & Web Manager -->
      <div class="flex flex-col gap-1 text-xs text-slate-300">
        <h2 class="font-bold text-white uppercase tracking-wider text-xs mb-4 pb-2 border-b border-slate-600">Quick Navigation</h2>
        <div class="flex flex-col gap-2">
          <a href="/our-business/power-stations" class="hover:text-white hover:translate-x-1 transition-all duration-200 inline-flex items-center gap-1.5">
            <Icon name="zap" size={13} strokeWidth={2} class="text-[#7FB3E8]" /> Installed Power Stations
          </a>
          <a href="/stakeholders/vendors/tender-bids" class="hover:text-white hover:translate-x-1 transition-all duration-200 inline-flex items-center gap-1.5">
            <Icon name="file-text" size={13} strokeWidth={2} class="text-[#7FB3E8]" /> Tenders &amp; Bid Registry
          </a>
          <a href="/commercial/overview" class="hover:text-white hover:translate-x-1 transition-all duration-200 inline-flex items-center gap-1.5">
            <Icon name="briefcase" size={13} strokeWidth={2} class="text-[#7FB3E8]" /> Commercial Cell
          </a>
          <a href="/sustainability/environment/preamble" class="hover:text-white hover:translate-x-1 transition-all duration-200 inline-flex items-center gap-1.5">
            <Icon name="leaf" size={13} strokeWidth={2} class="text-[#7FB3E8]" /> Environment Clearances
          </a>
          <a href="/media/press-releases" class="hover:text-white hover:translate-x-1 transition-all duration-200 inline-flex items-center gap-1.5">
            <Icon name="newspaper" size={13} strokeWidth={2} class="text-[#7FB3E8]" /> Press Releases
          </a>
        </div>
        
        <!-- Web Information Manager (WIM) GIGW Mandatory -->
        <div class="mt-4 pt-3 border-t border-slate-700">
          <p class="font-semibold text-slate-200 text-[11px] mb-1">Web Information Manager (WIM)</p>
          <p class="text-[11px] text-slate-300">IT &amp; Systems Cell, JKSPDCL</p>
          <a href="mailto:md-jkspdcl@jk.gov.in" class="text-slate-300 hover:text-white hover:underline transition-colors inline-flex items-center gap-1.5 text-[11px] mt-1">
            <Icon name="mail" size={12} strokeWidth={2} />
            md-jkspdcl@jk.gov.in
          </a>
        </div>

        <!-- Social Links -->
        <div class="mt-4 pt-3 border-t border-slate-700">
          <p class="font-semibold text-slate-300 text-[11px] mb-2">Follow &amp; Connect</p>
          <div class="flex items-center gap-3">
            <a href="https://twitter.com" target="_blank" rel="noopener noreferrer" aria-label="Twitter" class="w-7 h-7 rounded-full bg-white/10 hover:bg-[#1DA1F2]/30 flex items-center justify-center transition-colors">
              <svg class="w-3.5 h-3.5 fill-current text-slate-300" viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.746l7.73-8.835L1.254 2.25H8.08l4.259 5.63 5.905-5.63zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
            </a>
            <a href="https://facebook.com" target="_blank" rel="noopener noreferrer" aria-label="Facebook" class="w-7 h-7 rounded-full bg-white/10 hover:bg-[#1877F2]/30 flex items-center justify-center transition-colors">
              <svg class="w-3.5 h-3.5 fill-current text-slate-300" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
            </a>
            <a href="https://youtube.com" target="_blank" rel="noopener noreferrer" aria-label="YouTube" class="w-7 h-7 rounded-full bg-white/10 hover:bg-[#FF0000]/30 flex items-center justify-center transition-colors">
              <svg class="w-3.5 h-3.5 fill-current text-slate-300" viewBox="0 0 24 24"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
            </a>
          </div>
        </div>
      </div>

    </div>

    <!-- Copyright and Compliance Info -->
    <div class="flex flex-col md:flex-row justify-between items-center gap-3 text-[11px] text-slate-400 border-t border-slate-700 pt-4">
      <p>&copy; {currentYear} Jammu &amp; Kashmir State Power Development Corporation Limited. All rights reserved.</p>
      <div class="flex items-center gap-3 flex-wrap justify-center md:justify-end">
        <span>Designed &amp; Developed by <span class="text-slate-300 font-semibold">JKSPDCL</span></span>
        <span class="text-slate-600">|</span>
        <span>Last Updated: {lastUpdated}</span>
      </div>
    </div>

  </div>
</footer>
