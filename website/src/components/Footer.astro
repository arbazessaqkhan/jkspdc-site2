---
import Icon from './Icon.astro';

const currentYear = new Date().getFullYear();
const lastUpdated = new Date().toLocaleDateString('en-IN', { year: 'numeric', month: 'long', day: 'numeric' });
---

<!-- Government PSU Footer (GIGW 3.0 Compliant) -->
<footer class="bg-[#0B3B60] text-white border-t-[3px] border-[#0EA4E5]">
  <div class="site-container pt-8 pb-6">

    <!-- Government Portal Identity Bar (GIGW Mandatory) -->
    <div class="flex flex-wrap items-center justify-between gap-4 border-b border-white/15 pb-5 mb-7">
      <div class="flex items-center gap-3.5">
        <div class="bg-white/95 p-1.5 sm:p-2 rounded-xl shadow-sm ring-1 ring-white/25 flex-shrink-0">
          <img src="/logo.png" alt="JKSPDCL Official Logo" class="h-8 sm:h-9 w-auto object-contain" />
        </div>
        <div>
          <p class="text-white font-bold text-xs sm:text-[15px] leading-tight tracking-wide">Jammu &amp; Kashmir State Power Development Corporation Limited</p>
          <p class="text-slate-300 text-[0.72rem] sm:text-xs mt-1 gov-code">A Government of J&amp;K Undertaking <span class="text-white/30 mx-1.5">|</span> CIN: U40101JK1995SGC001418</p>
        </div>
      </div>
      <div class="flex items-center gap-2.5 text-xs text-slate-200">
        <a href="https://india.gov.in" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-md bg-white/10 hover:bg-white/15 border border-white/15 hover:border-[#52B5E8]/50 hover:text-[#A4D7F4] transition-all font-medium">
          <Icon name="globe" size={13} strokeWidth={2} class="text-[#52B5E8]" />
          <span>National Portal of India</span>
          <span class="sr-only"> (opens in new tab)</span>
        </a>
        <a href="https://jkgov.nic.in" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-md bg-white/10 hover:bg-white/15 border border-white/15 hover:border-[#52B5E8]/50 hover:text-[#A4D7F4] transition-all font-medium">
          <Icon name="landmark" size={13} strokeWidth={2} class="text-[#52B5E8]" />
          <span>J&amp;K Government</span>
          <span class="sr-only"> (opens in new tab)</span>
        </a>
      </div>
    </div>

    <!-- Footer Core Columns -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-7 lg:gap-8 pb-6 items-start">

      <!-- Column 1: Corporate Summary -->
      <div class="flex flex-col">
        <h2 class="font-bold text-white uppercase tracking-wider text-xs sm:text-[13px] mb-2.5 pb-1 border-b border-white/20">About JKSPDCL</h2>
        <p class="text-xs sm:text-[12.5px] text-slate-200 leading-relaxed">
          Jammu &amp; Kashmir State Power Development Corporation Limited is a wholly owned Government PSU incorporated in 1995, mandated with planning, constructing, operating and maintaining hydro and renewable power generating assets across J&amp;K.
        </p>
        <div class="mt-2.5">
          <a href="/about-us/explore/overview" class="text-xs sm:text-[12.5px] text-[#A4D7F4] hover:text-[#52B5E8] font-medium inline-flex items-center gap-1 transition-colors duration-200">
            Read Corporate Profile &rarr;
          </a>
        </div>
      </div>

      <!-- Column 2: Site Utilities & Compliance Policies -->
      <div class="flex flex-col">
        <h2 class="font-bold text-white uppercase tracking-wider text-xs sm:text-[13px] mb-2.5 pb-1 border-b border-white/20">Compliance &amp; Utilities</h2>
        <div class="grid grid-cols-2 gap-x-4 gap-y-1.5 text-xs sm:text-[12.5px] text-slate-200">
          <a href="/about-us/explore/policies" class="hover:text-[#52B5E8] hover:translate-x-0.5 transition-all inline-flex items-center gap-1">
            <span class="text-slate-400" aria-hidden="true">›</span> Policies
          </a>
          <a href="/copyright" class="hover:text-[#52B5E8] hover:translate-x-0.5 transition-all inline-flex items-center gap-1">
            <span class="text-slate-400" aria-hidden="true">›</span> Copyright
          </a>
          <a href="/accessibility-statement" class="hover:text-[#52B5E8] hover:translate-x-0.5 transition-all inline-flex items-center gap-1">
            <span class="text-slate-400" aria-hidden="true">›</span> Accessibility
          </a>
          <a href="/hyperlinking-policy" class="hover:text-[#52B5E8] hover:translate-x-0.5 transition-all inline-flex items-center gap-1">
            <span class="text-slate-400" aria-hidden="true">›</span> Hyperlinking
          </a>
          <a href="/privacy-policy" class="hover:text-[#52B5E8] hover:translate-x-0.5 transition-all inline-flex items-center gap-1">
            <span class="text-slate-400" aria-hidden="true">›</span> Privacy Policy
          </a>
          <a href="/sitemap" class="hover:text-[#52B5E8] hover:translate-x-0.5 transition-all inline-flex items-center gap-1">
            <span class="text-slate-400" aria-hidden="true">›</span> Sitemap
          </a>
          <a href="/terms-conditions" class="hover:text-[#52B5E8] hover:translate-x-0.5 transition-all inline-flex items-center gap-1">
            <span class="text-slate-400" aria-hidden="true">›</span> Terms of Use
          </a>
          <a href="/help" class="hover:text-[#52B5E8] hover:translate-x-0.5 transition-all inline-flex items-center gap-1">
            <span class="text-slate-400" aria-hidden="true">›</span> Help &amp; FAQ
          </a>
          <a href="/disclaimer" class="hover:text-[#52B5E8] hover:translate-x-0.5 transition-all inline-flex items-center gap-1">
            <span class="text-slate-400" aria-hidden="true">›</span> Disclaimer
          </a>
          <a href="/feedback" class="hover:text-[#52B5E8] hover:translate-x-0.5 transition-all inline-flex items-center gap-1">
            <span class="text-slate-400" aria-hidden="true">›</span> Feedback
          </a>
        </div>
      </div>

      <!-- Column 3: Contact Directory -->
      <div class="flex flex-col text-xs sm:text-[12.5px] text-slate-200">
        <h2 class="font-bold text-white uppercase tracking-wider text-xs sm:text-[13px] mb-2.5 pb-1 border-b border-white/20">Contact Directory</h2>
        <div class="space-y-1">
          <p class="font-semibold text-white">Srinagar Corporate Office</p>
          <p class="text-xs sm:text-[12px] leading-snug text-slate-300">Exhibition Grounds, Jahangir Chowk, Srinagar — 190009</p>
          <p>
            <a href="tel:+911942451665" class="hover:text-[#52B5E8] transition-colors inline-flex items-center gap-1 text-slate-300">
              <Icon name="phone" size={12} strokeWidth={2} />
              +91 194 2451665
            </a>
          </p>
        </div>
        <div class="space-y-1 mt-2.5 pt-2 border-t border-white/10">
          <p class="font-semibold text-white">Jammu Regional Office</p>
          <p class="text-xs sm:text-[12px] leading-snug text-slate-300">Ashok Nagar, Satwari, Jammu (J&amp;K) — 180004</p>
          <p>
            <a href="tel:+911912430548" class="hover:text-[#52B5E8] transition-colors inline-flex items-center gap-1 text-slate-300">
              <Icon name="phone" size={12} strokeWidth={2} />
              +91 191 2430548 / 2439039
            </a>
          </p>
        </div>
      </div>

      <!-- Column 4: Quick Navigation -->
      <div class="flex flex-col text-xs sm:text-[12.5px] text-slate-200">
        <h2 class="font-bold text-white uppercase tracking-wider text-xs sm:text-[13px] mb-2.5 pb-1 border-b border-white/20">Quick Navigation</h2>
        <div class="flex flex-col gap-1.5">
          <a href="/our-business/power-stations" class="hover:text-[#52B5E8] hover:translate-x-0.5 transition-all inline-flex items-center gap-1.5">
            <Icon name="zap" size={13} strokeWidth={2} class="text-[#A4D7F4]" /> Operating Power Stations
          </a>
          <a href="/stakeholders/vendors/tender-bids" class="hover:text-[#52B5E8] hover:translate-x-0.5 transition-all inline-flex items-center gap-1.5">
            <Icon name="file-text" size={13} strokeWidth={2} class="text-[#A4D7F4]" /> Tenders &amp; Bid Registry
          </a>
          <a href="/media/gallery" class="hover:text-[#52B5E8] hover:translate-x-0.5 transition-all inline-flex items-center gap-1.5">
            <Icon name="image" size={13} strokeWidth={2} class="text-[#A4D7F4]" /> Photo &amp; Video Gallery
          </a>
        </div>
        <div class="mt-2.5 pt-2 border-t border-white/10">
          <p class="font-semibold text-white text-xs sm:text-[12.5px] mb-0.5">Official Email</p>
          <a href="mailto:md-jkspdcl@jk.gov.in" class="text-slate-300 hover:text-[#52B5E8] hover:underline transition-colors inline-flex items-center gap-1 gov-email">
            <Icon name="mail" size={12} strokeWidth={2} />
            md-jkspdcl@jk.gov.in
          </a>
        </div>
      </div>

    </div>

  </div>

  <!-- Unified Bottom Compliance & Copyright Bar (GIGW 3.0 Mandatory) -->
  <div class="bg-[#072945] border-t border-white/10">
    <div class="site-container py-4 pr-14 sm:pr-16 xl:pr-8">
      <!-- WIM & Governance Row -->
      <div class="flex flex-wrap items-center justify-between gap-x-4 gap-y-1.5 text-xs text-slate-300 pb-2.5">
        <div class="flex flex-wrap items-center gap-x-4 gap-y-1">
          <span><strong class="text-white font-semibold">Web Information Manager:</strong> [Nomination in Process, JKSPDCL]</span>
          <span class="text-white/30 hidden sm:inline">|</span>
          <span><strong class="text-white font-semibold">Technical Team:</strong> IT Cell, JKSPDCL, Srinagar / Jammu</span>
        </div>
        <div class="text-slate-300 text-[11px] sm:text-xs">
          <span>Last Reviewed: <strong class="text-white font-medium">{lastUpdated}</strong></span>
        </div>
      </div>

      <!-- Copyright Row -->
      <div class="border-t border-white/10 pt-2.5 flex flex-col sm:flex-row items-center justify-between gap-1.5 text-[11px] sm:text-xs text-slate-400">
        <p>&copy; {currentYear} Jammu &amp; Kashmir State Power Development Corporation Limited (JKSPDCL). All rights reserved.</p>
        <div class="flex items-center gap-2.5">
          <span>Designed &amp; Developed by <span class="text-slate-200 font-medium">IT Cell, JKSPDCL</span></span>
          <span class="text-slate-600">|</span>
          <span>Government of Jammu &amp; Kashmir</span>
        </div>
      </div>
    </div>
  </div>
</footer>
