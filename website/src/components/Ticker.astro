---
export interface TickerItem {
  type: string;
  text: string;
  colorClass: string;
  url?: string;
}

export interface Props {
  items?: TickerItem[];
}

const { items = [] } = Astro.props;

let tickerItems: TickerItem[] = items;

if (tickerItems.length === 0) {
  try {
    const [tendersRes, notifsRes] = await Promise.all([
      fetch(`${import.meta.env.PUBLIC_API_BASE}/api/public/tenders`).catch(() => null),
      fetch(`${import.meta.env.PUBLIC_API_BASE}/api/public/notifications`).catch(() => null),
    ]);

    let tenders: any[] = [];
    if (tendersRes && tendersRes.ok) tenders = await tendersRes.json();

    let notifs: any[] = [];
    if (notifsRes && notifsRes.ok) notifs = await notifsRes.json();

    const fetched: TickerItem[] = [];

    // Recent Active Tenders (Sorted by publication date descending, limit to recent 3)
    const recentTenders = tenders
      .filter((t: any) => t.status === 'Active')
      .sort((a: any, b: any) => new Date(b.publishDate).getTime() - new Date(a.publishDate).getTime())
      .slice(0, 3);

    recentTenders.forEach((t: any) => {
      fetched.push({
        type: 'TENDER',
        text: `${t.title} (NIT Ref: ${t.referenceNo})`,
        colorClass: 'text-cyan-300 bg-cyan-500/10 border-cyan-400/20',
        url: `/stakeholders/vendors/tender-details?id=${t.id}`,
      });

      // Recent corrigendums if any
      const corrs = t.corrigendums && Array.isArray(t.corrigendums) ? t.corrigendums : [];
      corrs.slice(0, 1).forEach((c: any) => {
        fetched.push({
          type: 'CORRIGENDUM',
          text: `Corrigendum: ${c.title} — ${t.title} (Ref: ${t.referenceNo})`,
          colorClass: 'text-orange-400 bg-orange-500/10 border-orange-400/20',
          url: `/stakeholders/vendors/tender-details?id=${t.id}#corrigendum-${c.id}`,
        });
      });
    });

    // Recent Notifications & Notices (Sorted by publication date descending, limit to recent 3)
    const recentNotifs = notifs
      .sort((a: any, b: any) => new Date(b.publishDate).getTime() - new Date(a.publishDate).getTime())
      .slice(0, 3);

    recentNotifs.forEach((n: any) => {
      const docUrl = n.documentUrl ? (n.documentUrl.startsWith('/uploads/') ? `${import.meta.env.PUBLIC_API_BASE}${n.documentUrl}` : n.documentUrl) : '/notifications';
      fetched.push({
        type: 'NOTICE',
        text: `${n.title}${n.fileName ? ` (${n.fileName})` : ''}`,
        colorClass: 'text-yellow-400 bg-yellow-500/10 border-yellow-400/20',
        url: docUrl,
      });
    });

    if (fetched.length > 0) {
      tickerItems = fetched;
    }
  } catch (e) {
    console.error('Error fetching ticker items:', e);
  }
}

if (tickerItems.length === 0) {
  tickerItems = [
    { 
      type: 'TENDER', 
      text: 'Active Notice Inviting Tenders (NITs) & Procurement Opportunities', 
      colorClass: 'text-cyan-300 bg-cyan-500/10 border-cyan-400/20',
      url: '/stakeholders/vendors/tender-bids'
    },
    { 
      type: 'NOTICE', 
      text: 'Official Notifications & Circulars Repository — JKSPDCL', 
      colorClass: 'text-yellow-400 bg-yellow-500/10 border-yellow-400/20',
      url: '/notifications'
    }
  ];
}
---

<div class="bg-[#08305C] text-white relative overflow-hidden border-t border-b border-[#075985]/30 h-9 flex items-center" aria-live="polite" aria-label="Live announcements">
  <div class="flex items-center h-full overflow-hidden" style="max-width:100%;">
    <div class="shrink-0 bg-[#1B3A6B] text-white text-xs font-bold px-4 h-full flex items-center gap-2 uppercase tracking-wide z-20 whitespace-nowrap">
      <span class="w-2 h-2 rounded-full bg-slate-300 animate-slow-pulse shrink-0"></span>
      Updates
    </div>
    <div class="flex-1 overflow-hidden relative h-full flex items-center" id="component-ticker-container">
      <!-- Fade-out overlays -->
      <div class="absolute left-0 top-0 bottom-0 w-10 bg-gradient-to-r from-[#08305C] to-transparent z-10 pointer-events-none"></div>
      <div class="absolute right-0 top-0 bottom-0 w-10 bg-gradient-to-l from-[#08305C] to-transparent z-10 pointer-events-none"></div>

      <div id="component-ticker-track" class="flex items-center whitespace-nowrap w-max shrink-0 cursor-pointer" style="gap: 3.5rem; font-size: 0.8rem; font-weight: 500; will-change: transform;">
        {[...tickerItems, ...tickerItems].map((item) => (
          <span class="inline-flex items-center whitespace-nowrap shrink-0" style="padding-right:4rem;">
            › <strong class={`font-extrabold uppercase tracking-wider text-[10px] mr-1.5 px-1.5 py-0.5 rounded border whitespace-nowrap shrink-0 ${item.colorClass}`}>{item.type}:</strong> 
            {item.url ? (
              <a 
                href={item.url} 
                target={item.url.startsWith('http') ? "_blank" : undefined} 
                rel={item.url.startsWith('http') ? "noopener noreferrer" : undefined} 
                class="text-slate-100 hover:underline hover:text-white transition-colors whitespace-nowrap"
              >
                {item.text}
              </a>
            ) : (
              <span class="text-slate-100 whitespace-nowrap">{item.text}</span>
            )}
          </span>
        ))}
      </div>
    </div>
  </div>
</div>

<script is:inline>
  (function() {
    var track = document.getElementById('component-ticker-track');
    var container = document.getElementById('component-ticker-container');
    if (!track || !container) return;
    
    var pos = 0;
    var speed = 0.75;
    var isPaused = false;

    container.addEventListener('mouseenter', function() { isPaused = true; });
    container.addEventListener('mouseleave', function() { isPaused = false; });

    function step() {
      if (!isPaused) {
        pos += speed;
        var halfWidth = track.scrollWidth / 2;
        if (halfWidth > 0 && pos >= halfWidth) {
          pos = pos - halfWidth;
        }
        track.style.transform = 'translate3d(-' + pos.toFixed(2) + 'px, 0, 0)';
      }
      requestAnimationFrame(step);
    }
    requestAnimationFrame(step);
  })();
</script>
