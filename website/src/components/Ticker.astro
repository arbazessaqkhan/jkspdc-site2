---
/**
 * Homepage updates ticker.
 *
 * Displays the latest 5 records combined across Tenders, Corrigenda, and Notices
 * in strict chronological (newest first / LIFO) order based on their actual
 * publication/upload date.
 * Closing dates are optional and are never used for ordering or filtering.
 */

const API_BASE = process.env.BACKEND_URL ?? import.meta.env.PUBLIC_API_BASE;

type TickerType = 'Tender' | 'Corrigendum' | 'Notification';

interface TickerRecord {
  key: string;
  type: TickerType;
  title: string;
  referenceNo: string | null;
  url: string;
  publishDate: Date;
  closingDate: Date | null;
  fileFormat: string | null;
  fileSizeBytes: number | null;
}

const toDate = (value: unknown): Date | null => {
  if (!value) return null;
  const d = value instanceof Date ? value : new Date(String(value));
  return Number.isNaN(d.getTime()) ? null : d;
};

const parseCorrigendums = (value: unknown): any[] => {
  if (Array.isArray(value)) return value;
  if (typeof value === 'string' && value.trim()) {
    try {
      const parsed = JSON.parse(value);
      return Array.isArray(parsed) ? parsed : [];
    } catch {
      return [];
    }
  }
  return [];
};

const detectFormat = (url?: string | null): string | null => {
  if (!url) return null;
  const match = /\.([a-z0-9]{2,5})(?:[?#]|$)/i.exec(url);
  return match ? match[1].toUpperCase() : null;
};

const resolveDocUrl = (url?: string | null): string => {
  if (!url) return '/notifications';
  if (/^https?:\/\//i.test(url)) return url;
  if (url.startsWith('/uploads/')) return `${API_BASE}${url}`;
  return url;
};

const formatBytes = (bytes?: number | null): string => {
  if (!bytes || bytes <= 0) return '';
  if (bytes < 1024) return `${bytes} B`;
  if (bytes < 1024 * 1024) return `${Math.round(bytes / 1024)} KB`;
  return `${(bytes / (1024 * 1024)).toFixed(1)} MB`;
};

const badgeClass: Record<TickerType, string> = {
  Tender: 'text-[#8FD8FF] border-[#0EA4E5]/40 bg-[#0EA4E5]/15',
  Corrigendum: 'text-[#FFD182] border-[#E58A00]/40 bg-[#E58A00]/15',
  Notification: 'text-[#8CE6C6] border-[#2BC59A]/40 bg-[#2BC59A]/15',
};

// Short display labels; record types stay unchanged.
const badgeLabel: Record<TickerType, string> = {
  Tender: 'Tender',
  Corrigendum: 'Corr',
  Notification: 'Notice',
};

const records: TickerRecord[] = [];

try {
  const [tendersRes, notificationsRes] = await Promise.all([
    fetch(`${API_BASE}/api/public/tenders`).catch(() => null),
    fetch(`${API_BASE}/api/public/notifications`).catch(() => null),
  ]);

  let tenders: any[] = [];
  if (tendersRes && tendersRes.ok) {
    const tData = await tendersRes.json();
    if (Array.isArray(tData)) tenders = tData;
  }

  let notifications: any[] = [];
  if (notificationsRes && notificationsRes.ok) {
    const nData = await notificationsRes.json();
    if (Array.isArray(nData)) notifications = nData;
  }

  // Tenders (a tender published with documentType 'CORRIGENDUM' keeps Corrigendum type).
  for (const t of Array.isArray(tenders) ? tenders : []) {
    if (t.status && t.status !== 'Active') continue;
    const pubDate = toDate(t.publishDate) ?? toDate(t.createdAt) ?? new Date(0);
    const type: TickerType = t.documentType === 'CORRIGENDUM' ? 'Corrigendum' : 'Tender';

    records.push({
      key: `tender-${t.id}`,
      type,
      title: t.title,
      referenceNo: t.referenceNo ?? null,
      url: t.documentUrl ? resolveDocUrl(t.documentUrl) : `/stakeholders/vendors/tender-details?id=${t.id}`,
      publishDate: pubDate,
      closingDate: toDate(t.closingDate),
      fileFormat: t.fileFormat || detectFormat(t.documentUrl),
      fileSizeBytes: t.fileSizeBytes ?? null,
    });
  }

  // Corrigenda attached to tenders.
  for (const t of Array.isArray(tenders) ? tenders : []) {
    if (t.status && t.status !== 'Active') continue;
    const tenderPubDate = toDate(t.publishDate) ?? toDate(t.createdAt) ?? new Date(0);

    const corrs = parseCorrigendums(t.corrigendums);
    for (let i = 0; i < corrs.length; i++) {
      const corr = corrs[i];
      if (!corr || typeof corr !== 'object') continue;
      const corrId = corr.id ?? `${t.id}-${i}`;
      const corrPubDate = toDate(corr.publishDate) ?? toDate(corr.createdAt) ?? toDate(corr.uploadedAt) ?? tenderPubDate;
      const corrDocUrl = corr.documentUrl || t.documentUrl;

      records.push({
        key: `corrigendum-${t.id}-${corrId}`,
        type: 'Corrigendum',
        title: corr.title || `Corrigendum to ${t.title}`,
        referenceNo: t.referenceNo ?? null,
        url: corrDocUrl ? resolveDocUrl(corrDocUrl) : `/stakeholders/vendors/tender-details?id=${t.id}#corrigendum-${corrId}`,
        publishDate: corrPubDate,
        closingDate: toDate(corr.extendedClosingDate) ?? toDate(t.closingDate),
        fileFormat: corr.fileFormat || detectFormat(corr.documentUrl) || t.fileFormat || detectFormat(t.documentUrl),
        fileSizeBytes: corr.fileSizeBytes ?? null,
      });
    }
  }

  // Notifications / notices.
  for (const n of Array.isArray(notifications) ? notifications : []) {
    if (n.status && n.status !== 'Active') continue;
    const pubDate = toDate(n.publishDate) ?? toDate(n.createdAt) ?? new Date(0);

    records.push({
      key: `notice-${n.id}`,
      type: 'Notification',
      title: n.title,
      referenceNo: null,
      url: resolveDocUrl(n.documentUrl),
      publishDate: pubDate,
      closingDate: toDate(n.validTillDate),
      fileFormat: n.fileFormat || detectFormat(n.documentUrl),
      fileSizeBytes: n.fileSizeBytes ?? null,
    });
  }
} catch (error) {
  console.error('Error fetching ticker records:', error);
}

// De-duplicate, order strictly by actual publication date (newest first), take top 5.
const seen = new Set<string>();
const tickerItems = records
  .filter((record) => {
    if (seen.has(record.key)) return false;
    seen.add(record.key);
    return true;
  })
  .sort((a, b) => {
    const aTime = a.publishDate?.getTime() ?? 0;
    const bTime = b.publishDate?.getTime() ?? 0;
    return bTime - aTime;
  })
  .slice(0, 5);
---

<div
  data-ticker
  class="relative flex min-h-[40px] w-full items-stretch overflow-hidden border-y border-[#0B3B60] bg-[#0E4976] text-slate-100"
  aria-label="Latest updates"
>
  <!-- UPDATES label (fixed on left) -->
  <div class="relative z-20 flex shrink-0 items-center gap-2 border-r border-white/15 bg-[#0B3B60] px-3 sm:px-4 shadow-[2px_0_6px_rgba(0,0,0,0.15)]">
    <span class="h-2 w-2 shrink-0 rounded-full bg-[#38BDF8]" aria-hidden="true"></span>
    <span class="text-[0.6875rem] font-bold uppercase tracking-[0.14em] text-white">Updates</span>
  </div>

  <!-- Marquee viewport -->
  <div id="ticker-viewport" class="relative flex min-w-0 flex-1 items-center overflow-hidden">
    {tickerItems.length > 0 ? (
      <div id="ticker-track" class="ticker-track flex w-max items-center">
        {[0, 1, 2].map((groupIndex) => (
          <div
            class="ticker-group flex shrink-0 items-center"
            data-ticker-group
            aria-hidden={groupIndex > 0 ? 'true' : undefined}
          >
            {tickerItems.map((item) => (
              <span class="inline-flex shrink-0 items-center gap-2.5 whitespace-nowrap pr-14">
                <strong class={`rounded-sm border px-2 py-0.5 text-[10px] font-bold uppercase tracking-wider ${badgeClass[item.type]}`}>
                  {badgeLabel[item.type]}
                </strong>
                <a
                  href={item.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  tabindex={groupIndex > 0 ? -1 : undefined}
                  class="text-[12.5px] font-medium text-white/95 transition-colors hover:text-white hover:underline focus-visible:text-white focus-visible:underline"
                >
                  {item.title}
                </a>
                {item.fileFormat && (
                  <span class="text-[11px] text-white/60">
                    {item.fileFormat}{formatBytes(item.fileSizeBytes) ? ` · ${formatBytes(item.fileSizeBytes)}` : ''}
                  </span>
                )}
              </span>
            ))}
          </div>
        ))}
      </div>
    ) : (
      <p class="px-4 text-[12px] text-white/70">No current updates.</p>
    )}
  </div>

  <!-- Play/Pause control (fixed on right) -->
  {tickerItems.length > 0 && (
    <button
      id="ticker-toggle"
      type="button"
      class="relative z-20 flex shrink-0 items-center justify-center min-w-[44px] min-h-[40px] gap-1.5 border-l border-white/15 bg-[#0B3B60] px-3 text-[0.6875rem] font-semibold uppercase tracking-wider text-white transition-colors hover:bg-[#002B49] focus-visible:bg-[#002B49] focus-visible:outline-none cursor-pointer"
      aria-label="Pause updates"
      aria-pressed="true"
    >
      <svg id="ticker-icon-pause" width="10" height="10" viewBox="0 0 10 10" fill="currentColor" aria-hidden="true">
        <rect x="2" y="1.5" width="2" height="7" rx="0.5"></rect>
        <rect x="6" y="1.5" width="2" height="7" rx="0.5"></rect>
      </svg>
      <svg id="ticker-icon-play" class="hidden" width="10" height="10" viewBox="0 0 10 10" fill="currentColor" aria-hidden="true">
        <path d="M2.5 1.4v7.2a.4.4 0 0 0 .61.34l5.6-3.6a.4.4 0 0 0 0-.68l-5.6-3.6a.4.4 0 0 0-.61.34Z"></path>
      </svg>
    </button>
  )}
</div>

<style>
  .ticker-track {
    animation-name: ticker-scroll-left;
    animation-duration: var(--ticker-duration, 45s);
    animation-timing-function: linear;
    animation-iteration-count: infinite;
    animation-play-state: paused;
    will-change: transform;
    -webkit-backface-visibility: hidden;
    backface-visibility: hidden;
    transform: translate3d(0, 0, 0);
  }

  [data-ticker].is-running .ticker-track {
    animation-play-state: running;
  }

  [data-ticker].is-running.is-hover-paused .ticker-track {
    animation-play-state: paused;
  }

  @keyframes ticker-scroll-left {
    0% {
      transform: translate3d(var(--ticker-start, 0px), 0, 0);
    }
    100% {
      transform: translate3d(calc(var(--ticker-start, 0px) - var(--ticker-shift, 0px)), 0, 0);
    }
  }
</style>

<script is:inline>
  (function () {
    var roots = Array.prototype.slice.call(document.querySelectorAll('[data-ticker]'));

    roots.forEach(function (root) {
      var track = root.querySelector('#ticker-track');
      var group = root.querySelector('[data-ticker-group]');
      var viewport = root.querySelector('#ticker-viewport');
      var toggle = root.querySelector('#ticker-toggle');
      if (!track || !group || !viewport) return;

      var speed = 65; // smooth px/sec

      function calibrate() {
        var groupW = group.getBoundingClientRect().width;
        var viewW = viewport.clientWidth;
        if (!groupW || !viewW) return;

        // Middle start position: start first item at the middle of the viewport
        var startX = Math.round(viewW / 2);
        root.style.setProperty('--ticker-start', startX + 'px');
        root.style.setProperty('--ticker-shift', Math.round(groupW) + 'px');
        root.style.setProperty('--ticker-duration', (groupW / speed).toFixed(2) + 's');
      }

      calibrate();
      window.addEventListener('resize', calibrate);
      if (typeof ResizeObserver !== 'undefined') {
        new ResizeObserver(calibrate).observe(group);
        new ResizeObserver(calibrate).observe(viewport);
      }

      // Autoplay by default
      root.classList.add('is-running');

      var pauseIcon = root.querySelector('#ticker-icon-pause');
      var playIcon = root.querySelector('#ticker-icon-play');

      function renderToggle() {
        var running = root.classList.contains('is-running');
        if (pauseIcon) pauseIcon.classList.toggle('hidden', !running);
        if (playIcon) playIcon.classList.toggle('hidden', running);
        if (toggle) {
          toggle.setAttribute('aria-label', running ? 'Pause updates' : 'Play updates');
          toggle.setAttribute('aria-pressed', running ? 'true' : 'false');
        }
      }

      if (toggle) {
        toggle.addEventListener('click', function () {
          root.classList.toggle('is-running');
          renderToggle();
        });
      }

      // Hover / focus freeze
      function freeze() {
        root.classList.add('is-hover-paused');
      }
      function resume() {
        root.classList.remove('is-hover-paused');
      }
      viewport.addEventListener('mouseenter', freeze);
      viewport.addEventListener('mouseleave', resume);
      viewport.addEventListener('focusin', freeze);
      viewport.addEventListener('focusout', function (event) {
        if (!viewport.contains(event.relatedTarget)) resume();
      });

      renderToggle();
    });
  })();
</script>
