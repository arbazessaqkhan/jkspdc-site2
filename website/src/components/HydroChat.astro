---
---

<!-- Hydro AI Floating Chatbot Widget -->
<div id="hydro-chatbot-container" class="fixed bottom-6 right-6 z-50 font-sans">

  <!-- Floating Toggle Button ("Ask Hydro") -->
  <button
    id="hydro-toggle-btn"
    class="flex items-center gap-3 bg-gradient-to-r from-[#0B4F9C] via-[#093B77] to-[#008080] hover:from-[#083A73] hover:to-[#006666] text-white px-4.5 py-3 rounded-full shadow-2xl transition-all duration-300 hover:scale-105 focus:outline-none focus:ring-4 focus:ring-[#0B4F9C]/30 border border-white/30 group"
    aria-label="Ask Hydro AI Assistant"
  >
    <div class="relative flex items-center justify-center w-8 h-8 rounded-full bg-white/10 group-hover:rotate-6 transition-transform border border-white/20 overflow-hidden">
      <img src="/hydro_ai_logo.png" alt="Hydro AI Logo" class="w-full h-full object-cover rounded-full" />
      <!-- Pulse Badge Indicator -->
      <span class="absolute -top-0.5 -right-0.5 flex h-2.5 w-2.5">
        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-cyan-400 opacity-75"></span>
        <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-cyan-400"></span>
      </span>
    </div>
    <div class="flex flex-col text-left">
      <span class="font-black text-xs uppercase tracking-wider text-white">Ask Hydro</span>
      <span class="text-[9px] text-cyan-200 font-medium tracking-tight">AI Project Specialist v2026</span>
    </div>
  </button>

  <!-- Chatbot Window Panel -->
  <div
    id="hydro-chat-window"
    class="hidden flex-col w-[380px] sm:w-[420px] h-[560px] bg-slate-900 rounded-2xl shadow-2xl border border-slate-800 overflow-hidden transition-all duration-300 transform origin-bottom-right text-slate-100"
  >
    <!-- Glassmorphic Header -->
    <div class="bg-gradient-to-r from-[#0B4F9C] via-[#083B75] to-[#006666] p-4 text-white flex items-center justify-between shadow-lg border-b border-cyan-500/20 backdrop-blur-md">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-full border-2 border-cyan-400/40 shadow-inner overflow-hidden flex-shrink-0 bg-slate-900">
          <img src="/hydro_ai_logo.png" alt="Hydro AI Logo" class="w-full h-full object-cover" />
        </div>
        <div>
          <div class="flex items-center gap-2">
            <h3 class="font-black text-sm tracking-wide text-white">HYDRO AI</h3>
            <span class="bg-cyan-400/20 text-cyan-300 text-[9px] font-bold px-2 py-0.5 rounded-full border border-cyan-400/30 uppercase tracking-wider">v2026.1</span>
          </div>
          <p class="text-[10px] text-blue-200 font-medium">JKSPDC Advanced AI Assistant</p>
        </div>
      </div>
      <div class="flex items-center gap-1">
        <button id="hydro-clear-btn" class="p-1.5 hover:bg-white/15 rounded-lg text-white/80 hover:text-white transition-colors" title="Clear History" aria-label="Clear History">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
        </button>
        <button id="hydro-minimize-btn" class="p-1.5 hover:bg-white/15 rounded-lg text-white/80 hover:text-white transition-colors" aria-label="Minimize Chat">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
        </button>
        <button id="hydro-close-btn" class="p-1.5 hover:bg-white/15 rounded-lg text-white/80 hover:text-white transition-colors" aria-label="Close Chat">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
        </button>
      </div>
    </div>

    <!-- Quick Prompts Horizontal Scroll -->
    <div class="bg-slate-950/80 border-b border-slate-800 px-3 py-2 flex items-center gap-2 overflow-x-auto no-scrollbar scroll-smooth">
      <span class="text-[9px] font-bold uppercase text-cyan-400 flex-shrink-0">Suggested:</span>
      <button class="hydro-prompt-chip whitespace-nowrap text-[10px] font-bold bg-cyan-950/60 hover:bg-cyan-900/80 text-cyan-300 border border-cyan-700/40 px-2.5 py-1 rounded-full transition-colors">Everything Globally</button>
      <button class="hydro-prompt-chip whitespace-nowrap text-[10px] font-bold bg-blue-950/60 hover:bg-blue-900/80 text-blue-300 border border-blue-700/40 px-2.5 py-1 rounded-full transition-colors">Compare BHEP I & BHEP II</button>
      <button class="hydro-prompt-chip whitespace-nowrap text-[10px] font-bold bg-indigo-950/60 hover:bg-indigo-900/80 text-indigo-300 border border-indigo-700/40 px-2.5 py-1 rounded-full transition-colors">Calculate Total Capacity</button>
      <button class="hydro-prompt-chip whitespace-nowrap text-[10px] font-bold bg-teal-950/60 hover:bg-teal-900/80 text-teal-300 border border-teal-700/40 px-2.5 py-1 rounded-full transition-colors">Kirthai HEP Stage-1</button>
      <button class="hydro-prompt-chip whitespace-nowrap text-[10px] font-bold bg-slate-800 hover:bg-slate-700 text-slate-200 border border-slate-700 px-2.5 py-1 rounded-full transition-colors">Active Tenders</button>
    </div>

    <!-- Messages Container -->
    <div id="hydro-messages" class="flex-1 p-4 overflow-y-auto space-y-4 bg-slate-900/90 scroll-smooth">
      <!-- Default Greeting -->
      <div class="flex items-start gap-3 animate-fadeIn">
        <div class="w-8 h-8 rounded-full border border-cyan-500/40 overflow-hidden flex-shrink-0 bg-slate-950 shadow-md mt-0.5">
          <img src="/hydro_ai_logo.png" alt="Hydro AI" class="w-full h-full object-cover" />
        </div>
        <div class="bg-slate-800/90 border border-slate-700/80 rounded-2xl rounded-tl-xs p-3.5 text-xs text-slate-200 shadow-md max-w-[88%] leading-relaxed">
          Hello! I am **HYDRO (v2026.1)**, your AI Project Specialist. I provide precise, context-grounded information, analytical comparisons, and mathematical workflows for all JKSPDC projects. How can I assist you today?
          <div class="text-[9px] text-slate-500 mt-1.5 font-mono">Just now</div>
        </div>
      </div>
    </div>

    <!-- Typing Indicator -->
    <div id="hydro-typing" class="hidden px-4 py-2 bg-slate-900/80 border-t border-slate-800">
      <div class="flex items-center gap-2.5">
        <div class="w-6 h-6 rounded-full border border-cyan-500/40 overflow-hidden bg-slate-950">
          <img src="/hydro_ai_logo.png" alt="Hydro Typing" class="w-full h-full object-cover" />
        </div>
        <div class="bg-slate-800 border border-slate-700 px-3.5 py-1.5 rounded-full flex items-center gap-1.5 shadow-sm">
          <span class="w-1.5 h-1.5 bg-cyan-400 rounded-full animate-bounce"></span>
          <span class="w-1.5 h-1.5 bg-cyan-400 rounded-full animate-bounce [animation-delay:0.2s]"></span>
          <span class="w-1.5 h-1.5 bg-cyan-400 rounded-full animate-bounce [animation-delay:0.4s]"></span>
          <span class="text-[10px] text-cyan-300 font-bold ml-1">Analyzing...</span>
        </div>
      </div>
    </div>

    <!-- Input Form with Live Suggestions Dropdown -->
    <div class="relative p-3 bg-slate-950 border-t border-slate-800">
      <!-- Live Search Suggestions Dropdown -->
      <div
        id="hydro-suggestions-dropdown"
        class="hidden absolute bottom-full left-3 right-3 mb-2 bg-slate-900/95 border border-cyan-500/40 rounded-xl shadow-2xl overflow-hidden z-50 backdrop-blur-md max-h-56 overflow-y-auto divide-y divide-slate-800"
      >
      </div>

      <form id="hydro-form" class="flex items-center gap-2">
        <input
          id="hydro-input"
          type="text"
          placeholder="Ask Hydro or type keywords for suggestions..."
          class="flex-1 bg-slate-900 border border-slate-700 rounded-xl px-3.5 py-2.5 text-xs text-slate-100 placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-cyan-500 focus:border-transparent transition-all"
          autocomplete="off"
        />
        <button
          type="submit"
          class="bg-gradient-to-r from-[#0B4F9C] to-[#008080] hover:from-[#083A73] hover:to-[#006666] text-white p-2.5 rounded-xl transition-all shadow-md flex items-center justify-center focus:outline-none focus:ring-2 focus:ring-cyan-400"
          aria-label="Send Message"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
          </svg>
        </button>
      </form>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const toggleBtn = document.getElementById('hydro-toggle-btn');
    const chatWindow = document.getElementById('hydro-chat-window');
    const closeBtn = document.getElementById('hydro-close-btn');
    const minimizeBtn = document.getElementById('hydro-minimize-btn');
    const messagesContainer = document.getElementById('hydro-messages');
    const form = document.getElementById('hydro-form') as HTMLFormElement;
    const input = document.getElementById('hydro-input') as HTMLInputElement;
    const typingIndicator = document.getElementById('hydro-typing');
    const chips = document.querySelectorAll('.hydro-prompt-chip');
    const clearBtn = document.getElementById('hydro-clear-btn');

    let isWindowOpen = localStorage.getItem('hydro_chat_open') === 'true';
    let chatHistory: Array<{ role: string; text: string; timestamp: string }> = [];

    // Reset history on page view for clean operational state
    chatHistory = [];

    const chatbotContainer = document.getElementById('hydro-chatbot-container');

    function setOpenState(open: boolean) {
      isWindowOpen = open;
      localStorage.setItem('hydro_chat_open', open ? 'true' : 'false');
      if (open) {
        chatWindow?.classList.remove('hidden');
        chatWindow?.classList.add('flex');
        toggleBtn?.classList.add('hidden');
        input?.focus();
        scrollToBottom();
      } else {
        chatWindow?.classList.remove('flex');
        chatWindow?.classList.add('hidden');
        toggleBtn?.classList.remove('hidden');
      }
    }

    function clearChatHistory() {
      chatHistory = [];
      renderHistory();
    }

    toggleBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      setOpenState(true);
    });
    closeBtn?.addEventListener('click', () => setOpenState(false));
    minimizeBtn?.addEventListener('click', () => setOpenState(false));
    clearBtn?.addEventListener('click', () => clearChatHistory());

    // Auto-minimize when user clicks outside the chatbot box
    document.addEventListener('click', (event: MouseEvent) => {
      if (isWindowOpen && chatbotContainer) {
        const target = event.target as Node;
        if (!chatbotContainer.contains(target)) {
          setOpenState(false);
        }
      }
    });

    if (isWindowOpen) {
      setOpenState(true);
    }
    renderHistory();

    chips.forEach(chip => {
      chip.addEventListener('click', () => {
        const text = chip.textContent?.trim();
        if (text) {
          submitUserMessage(text);
        }
      });
    });

    // Live Suggestions Index for Search Auto-Suggestions
    const SUGGESTIONS_INDEX = [
      { keyword: "gst", title: "GSTIN Registration Details", path: "/about-us/explore/gstin-registration", category: "Taxation", query: "GSTIN Registration Details" },
      { keyword: "gstin", title: "Primary GSTIN (01AAACJ9770H2ZL)", path: "/about-us/explore/gstin-registration", category: "Taxation", query: "GSTIN Profile" },
      { keyword: "bhep", title: "Baglihar Hydroelectric Project (BHEP)", path: "/our-business/power-stations", category: "Operating Station", query: "BHEP Power Station" },
      { keyword: "chep", title: "Chenani Hydroelectric Project (CHEP)", path: "/our-business/power-stations", category: "Operating Station", query: "CHEP Power Station" },
      { keyword: "kirthai", title: "Kirthai HEP Stage-1 (390 MW)", path: "/our-business/under-development", category: "Under Development", query: "Kirthai HEP Stage-1" },
      { keyword: "tender", title: "Active Tenders, eNITs & Bids Portal", path: "/stakeholders/vendors/tender-bids", category: "Procurement", query: "Active Tenders" },
      { keyword: "board", title: "Board of Directors & Leadership", path: "/about-us/management/board", category: "Governance", query: "Board of Directors" },
      { keyword: "executives", title: "Senior Executive Directory", path: "/about-us/explore/executives-directory", category: "Directory", query: "Executives Directory" },
      { keyword: "tariff", title: "Commercial Tariffs & Billing Schedules", path: "/commercial/tariff", category: "Commercial", query: "Tariff Schedules" },
      { keyword: "csr", title: "CSR Policy, Activities & Reports", path: "/sustainability/csr/policy", category: "Sustainability", query: "CSR Policy" },
      { keyword: "environment", title: "Environmental Clearances & EMP Reports", path: "/sustainability/environment/clearance", category: "Environment", query: "Environmental Clearances" },
      { keyword: "rti", title: "RTI Act Section 4 Statutory Disclosures", path: "/about-us/explore/rti", category: "Transparency", query: "RTI Act Disclosures" },
      { keyword: "careers", title: "Current Openings & Job Notifications", path: "/stakeholders/career-seekers/current-openings", category: "Careers", query: "Current Openings" },
      { keyword: "overview", title: "Corporate History & Overview", path: "/about-us/explore/overview", category: "About Us", query: "Corporate Overview" },
      { keyword: "profile", title: "Corporate Profile & Financials", path: "/about-us/explore/profile", category: "About Us", query: "Corporate Profile" },
      { keyword: "moa", title: "Memorandum & Articles of Association (MoA/AoA)", path: "/about-us/explore/association-memorandum", category: "Legal", query: "MoA & AoA" },
      { keyword: "ethics", title: "Corporate Governance & Policies", path: "/about-us/explore/policies", category: "Governance", query: "Corporate Policies" },
      { keyword: "downloads", title: "Official Downloads & Forms (NIT, User Creation)", path: "/media/downloads", category: "Media & Downloads", query: "Downloads" },
      { keyword: "contact", title: "Contact Corporate Headquarters (Srinagar & Jammu)", path: "/about-us/others/contact", category: "Contact", query: "Contact Corporate Offices" },
      { keyword: "annual report", title: "Annual Reports & Financial Results", path: "/stakeholders/investors/annual-reports", category: "Financials", query: "Annual Reports" },
      { keyword: "msme", title: "Startups & MSME Corner", path: "/stakeholders/vendors/msme-corner", category: "Vendors", query: "MSME Corner" },
      { keyword: "clpm", title: "Contract Labor Payment Management (CLPM)", path: "/stakeholders/vendors/clpm-portal", category: "Compliance", query: "CLPM Portal" },
      { keyword: "online payment", title: "Online Tender Fee & EMD Payment Gateway", path: "/stakeholders/vendors/online-payment", category: "Payment", query: "Online Payment Gateway" },
      { keyword: "sitemap", title: "Website Sitemap (All 67 Routes)", path: "/sitemap", category: "Navigation", query: "Website Sitemap" },
    ];

    const suggestionsDropdown = document.getElementById('hydro-suggestions-dropdown');

    function updateSuggestions(val: string) {
      if (!val || val.length < 1) {
        if (suggestionsDropdown) suggestionsDropdown.classList.add('hidden');
        return;
      }

      const q = val.toLowerCase();
      const matches = SUGGESTIONS_INDEX.filter(item => 
        item.keyword.toLowerCase().includes(q) ||
        item.title.toLowerCase().includes(q) ||
        item.category.toLowerCase().includes(q)
      ).slice(0, 5);

      if (matches.length === 0) {
        if (suggestionsDropdown) suggestionsDropdown.classList.add('hidden');
        return;
      }

      if (suggestionsDropdown) {
        suggestionsDropdown.innerHTML = matches.map(m => `
          <button type="button" data-query="${m.query}" class="hydro-suggestion-item w-full text-left p-2.5 hover:bg-cyan-950/80 transition-colors flex items-center justify-between gap-2 group cursor-pointer border-b border-slate-800 last:border-0">
            <div class="truncate">
              <div class="text-xs font-bold text-slate-100 group-hover:text-cyan-300 truncate">${m.title}</div>
              <div class="text-[10px] text-slate-400 truncate">${m.path}</div>
            </div>
            <span class="text-[9px] font-extrabold uppercase bg-cyan-950 text-cyan-400 border border-cyan-800/60 px-1.5 py-0.5 rounded shrink-0">${m.category}</span>
          </button>
        `).join('');

        suggestionsDropdown.classList.remove('hidden');

        suggestionsDropdown.querySelectorAll('.hydro-suggestion-item').forEach(btn => {
          btn.addEventListener('click', (e) => {
            e.stopPropagation();
            const query = (btn as HTMLElement).getAttribute('data-query');
            if (query) {
              submitUserMessage(query);
              if (input) input.value = '';
              suggestionsDropdown.classList.add('hidden');
            }
          });
        });
      }
    }

    input?.addEventListener('input', (e) => {
      const target = e.target as HTMLInputElement;
      updateSuggestions(target.value.trim());
    });

    input?.addEventListener('focus', (e) => {
      const target = e.target as HTMLInputElement;
      if (target.value.trim().length > 0) {
        updateSuggestions(target.value.trim());
      }
    });

    document.addEventListener('click', (e) => {
      if (suggestionsDropdown && !suggestionsDropdown.contains(e.target as Node) && e.target !== input) {
        suggestionsDropdown.classList.add('hidden');
      }
    });

    form?.addEventListener('submit', (e) => {
      e.preventDefault();
      const text = input.value.trim();
      if (text) {
        if (suggestionsDropdown) suggestionsDropdown.classList.add('hidden');
        submitUserMessage(text);
        input.value = '';
      }
    });

    async function submitUserMessage(userText: string) {
      const timeStr = new Date().toLocaleTimeString('en-IN', { hour: '2-digit', minute: '2-digit' });

      chatHistory.push({ role: 'user', text: userText, timestamp: timeStr });
      renderHistory();
      scrollToBottom();

      typingIndicator?.classList.remove('hidden');

      try {
        const res = await fetch('http://localhost:3000/api/chat', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            message: userText,
            currentPage: window.location.pathname,
            history: chatHistory
          })
        });

        typingIndicator?.classList.add('hidden');

        if (res.ok) {
          const data = await res.json();
          const replyTime = new Date().toLocaleTimeString('en-IN', { hour: '2-digit', minute: '2-digit' });
          chatHistory.push({ role: 'assistant', text: data.reply, timestamp: replyTime });
          renderHistory();
          scrollToBottom();
        } else {
          chatHistory.push({ role: 'assistant', text: "I do not have that specific data point available in the project records.", timestamp: timeStr });
          renderHistory();
          scrollToBottom();
        }
      } catch (err) {
        typingIndicator?.classList.add('hidden');
        chatHistory.push({ role: 'assistant', text: "I do not have that specific data point available in the project records.", timestamp: timeStr });
        renderHistory();
        scrollToBottom();
      }
    }

    function renderHistory() {
      if (!messagesContainer) return;

      let html = `
        <div class="flex items-start gap-3">
          <div class="w-8 h-8 rounded-full border border-cyan-500/40 overflow-hidden flex-shrink-0 bg-slate-950 shadow-md mt-0.5">
            <img src="/hydro_ai_logo.png" alt="Hydro AI" class="w-full h-full object-cover" />
          </div>
          <div class="bg-slate-800/90 border border-slate-700/80 rounded-2xl rounded-tl-xs p-3.5 text-xs text-slate-200 shadow-md max-w-[88%] leading-relaxed">
            Hello! I am **HYDRO (v2026.1)**, your AI Project Specialist. I provide precise, context-grounded information, analytical comparisons, and mathematical workflows for all JKSPDC projects. How can I assist you today?
            <div class="text-[9px] text-slate-500 mt-1.5 font-mono">Just now</div>
          </div>
        </div>
      `;

      chatHistory.forEach(item => {
        if (item.role === 'user') {
          html += `
            <div class="flex justify-end">
              <div class="bg-gradient-to-r from-[#0B4F9C] to-[#008080] text-white rounded-2xl rounded-tr-xs p-3.5 text-xs shadow-md max-w-[85%] leading-relaxed border border-cyan-400/20">
                ${escapeHtml(item.text)}
                <div class="text-[9px] text-cyan-200 mt-1 text-right font-mono">${item.timestamp}</div>
              </div>
            </div>
          `;
        } else {
          html += `
            <div class="flex items-start gap-3">
              <div class="w-8 h-8 rounded-full border border-cyan-500/40 overflow-hidden flex-shrink-0 bg-slate-950 shadow-md mt-0.5">
                <img src="/hydro_ai_logo.png" alt="Hydro AI" class="w-full h-full object-cover" />
              </div>
              <div class="bg-slate-800/90 border border-slate-700/80 rounded-2xl rounded-tl-xs p-3.5 text-xs text-slate-200 shadow-md max-w-[90%] leading-relaxed prose-invert">
                ${formatMarkdown(item.text)}
                <div class="text-[9px] text-slate-500 mt-2 font-mono border-t border-slate-700/50 pt-1 flex justify-between">
                  <span>HYDRO AI v2026.1</span>
                  <span>${item.timestamp}</span>
                </div>
              </div>
            </div>
          `;
        }
      });

      messagesContainer.innerHTML = html;
    }

    function scrollToBottom() {
      if (messagesContainer) {
        messagesContainer.scrollTop = messagesContainer.scrollHeight;
      }
    }

    function escapeHtml(str: string) {
      return str.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
    }

    function formatMarkdown(text: string) {
      let formatted = escapeHtml(text);

      // Markdown Tables
      const tableRegex = /((?:\|[^\n]+\|\n?)+)/g;
      formatted = formatted.replace(tableRegex, (match) => {
        const lines = match.trim().split('\n').map(l => l.trim()).filter(l => l.length > 0);
        if (lines.length < 2) return match;

        const headerLine = lines[0];
        const rowsLines = lines.slice(1).filter(l => !l.includes('---'));

        const parseRow = (line: string) => line.split('|').slice(1, -1).map(cell => cell.trim());

        const headers = parseRow(headerLine);
        const rows = rowsLines.map(parseRow);

        let tableHtml = '<div class="my-2.5 overflow-x-auto rounded-xl border border-slate-700 shadow-lg"><table class="w-full text-[11px] text-left border-collapse"><thead class="bg-slate-950 text-cyan-400 font-extrabold uppercase border-b border-slate-800"><tr>';
        headers.forEach(h => {
          tableHtml += `<th class="px-2.5 py-2">${h}</th>`;
        });
        tableHtml += '</tr></thead><tbody class="divide-y divide-slate-800 bg-slate-900/90 font-medium text-slate-200">';
        rows.forEach(r => {
          tableHtml += '<tr class="hover:bg-slate-800/80 transition-colors">';
          r.forEach((cell, idx) => {
            if (idx === 0) {
              tableHtml += `<td class="px-2.5 py-2 font-bold text-slate-300">${cell}</td>`;
            } else if (idx === 1) {
              tableHtml += `<td class="px-2.5 py-2 font-extrabold text-cyan-300">${cell}</td>`;
            } else {
              tableHtml += `<td class="px-2.5 py-2 font-semibold text-slate-300">${cell}</td>`;
            }
          });
          tableHtml += '</tr>';
        });
        tableHtml += '</tbody></table></div>';
        return tableHtml;
      });

      // Headings
      formatted = formatted.replace(/^### (.*$)/gim, '<h4 class="font-black text-cyan-400 text-xs mt-2 mb-1.5 tracking-wide uppercase flex items-center gap-1.5"><span class="text-cyan-500">⚡</span> $1</h4>');

      // Bold
      formatted = formatted.replace(/\*\*(.*?)\*\*/g, '<strong class="font-extrabold text-cyan-200">$1</strong>');

      // Markdown Links
      formatted = formatted.replace(/\[([^\]]+)\]\(([^)]+)\)/g, '<a href="$2" class="text-cyan-400 font-bold underline hover:text-cyan-300 transition-colors">$1</a>');

      // Bullets
      formatted = formatted.replace(/^- (.*$)/gim, '<li class="ml-3 list-disc text-slate-300 my-1">$1</li>');

      // Code blocks
      formatted = formatted.replace(/`([^`]+)`/g, '<code class="bg-slate-950 text-cyan-300 font-mono text-[10px] px-1.5 py-0.5 rounded border border-slate-700">$1</code>');

      // Line breaks
      formatted = formatted.replace(/\n/g, '<br />');

      return formatted;
    }
  });
</script>
