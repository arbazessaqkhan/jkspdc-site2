---
// HydroChat.astro — Official HYDRO AI Knowledge Assistant Widget
---

<div id="hydro-widget-container" class="fixed bottom-6 right-6 z-[9999] font-sans antialiased select-none print:hidden">

  <!-- Floating Launcher Button (Bottom Right) -->
  <button
    id="hydro-launcher-btn"
    type="button"
    class="flex items-center gap-2.5 bg-gradient-to-r from-[#073B75] via-[#0B4F9C] to-[#1264B8] text-white px-4 py-3.5 rounded-full shadow-2xl hover:shadow-[#0B4F9C]/40 border-2 border-white/20 transition-all duration-300 hover:scale-105 active:scale-95 focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-[#7FB3E8] cursor-pointer group"
    aria-label="Open HYDRO AI Assistant"
    aria-expanded="false"
    aria-controls="hydro-chat-panel"
  >
    <!-- HYDRO Sparkle / Bot Icon -->
    <div class="relative flex items-center justify-center w-7 h-7 rounded-full bg-white/20 text-cyan-200 group-hover:rotate-12 transition-transform duration-300">
      <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
        <path d="M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z" />
      </svg>
      <!-- Live pulse dot -->
      <span class="absolute -top-0.5 -right-0.5 w-2 h-2 rounded-full bg-emerald-400 animate-ping"></span>
      <span class="absolute -top-0.5 -right-0.5 w-2 h-2 rounded-full bg-emerald-400"></span>
    </div>

    <div class="flex flex-col text-left">
      <span class="text-xs font-black tracking-wider uppercase leading-none text-white drop-shadow">Ask HYDRO</span>
      <span class="text-[10px] text-cyan-200 font-medium leading-none mt-0.5">AI Knowledge Assistant</span>
    </div>
  </button>

  <!-- Expandable Chat Panel -->
  <div
    id="hydro-chat-panel"
    class="hidden fixed bottom-6 right-6 w-[92vw] sm:w-[420px] max-w-[440px] h-[600px] max-h-[85vh] bg-white text-slate-850 rounded-2xl shadow-2xl border border-slate-200 flex flex-col overflow-hidden transition-all duration-300 z-[10000] focus:outline-none"
    role="dialog"
    aria-modal="true"
    aria-labelledby="hydro-dialog-title"
    tabindex="-1"
  >
    <!-- Header -->
    <div class="bg-gradient-to-r from-[#073B75] via-[#0B4F9C] to-[#042750] text-white px-4 py-3.5 flex items-center justify-between shadow-md flex-shrink-0">
      <div class="flex items-center gap-2.5">
        <div class="w-8 h-8 rounded-full bg-white/15 border border-white/30 flex items-center justify-center text-cyan-200">
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z" />
          </svg>
        </div>
        <div>
          <h2 id="hydro-dialog-title" class="text-sm font-bold leading-tight flex items-center gap-1.5">
            HYDRO
            <span class="text-[9px] bg-cyan-400/20 text-cyan-200 border border-cyan-300/30 px-1.5 py-0.2 rounded font-semibold uppercase tracking-wider">Official AI</span>
          </h2>
          <p class="text-[10px] text-cyan-100/80 font-medium">JKSPDCL Grounded Knowledge Expert</p>
        </div>
      </div>

      <!-- Actions -->
      <div class="flex items-center gap-1">
        <!-- Clear chat -->
        <button
          id="hydro-clear-btn"
          type="button"
          class="p-1.5 text-white/80 hover:text-white hover:bg-white/10 rounded-lg transition-colors cursor-pointer"
          title="Clear Conversation"
          aria-label="Clear Conversation"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
          </svg>
        </button>

        <!-- Close / Minimize -->
        <button
          id="hydro-close-btn"
          type="button"
          class="p-1.5 text-white/80 hover:text-white hover:bg-white/10 rounded-lg transition-colors cursor-pointer"
          title="Close HYDRO"
          aria-label="Close HYDRO Assistant"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
    </div>

    <!-- Messages Container -->
    <div id="hydro-messages" class="flex-1 overflow-y-auto p-4 space-y-3.5 bg-slate-50 text-xs leading-relaxed select-text" role="log" aria-live="polite">
      <!-- Welcome Message -->
      <div class="flex gap-2.5 items-start">
        <div class="w-6 h-6 rounded-full bg-[#0B4F9C] text-white flex items-center justify-center flex-shrink-0 text-[10px] font-bold mt-0.5">
          H
        </div>
        <div class="flex-1 bg-white border border-slate-200 rounded-2xl rounded-tl-sm p-3.5 shadow-sm space-y-2">
          <p class="font-semibold text-slate-800">
            Hello! I am <strong class="text-[#0B4F9C]">HYDRO</strong>, the official AI knowledge assistant for Jammu &amp; Kashmir State Power Development Corporation Limited.
          </p>
          <p class="text-slate-600 text-[11px]">
            I answer exclusively from approved website content, power project portfolios, active tenders, corporate policies, and RTI disclosures.
          </p>

          <!-- Suggested Starters -->
          <div class="pt-2 border-t border-slate-100">
            <p class="text-[10px] font-bold text-slate-400 uppercase tracking-wider mb-1.5">Suggested Questions:</p>
            <div class="flex flex-wrap gap-1.5">
              <button type="button" class="hydro-suggest-btn text-[11px] bg-slate-100 hover:bg-[#EAF4FF] hover:text-[#0B4F9C] text-slate-700 px-2.5 py-1 rounded-full border border-slate-200 transition-colors text-left cursor-pointer">
                ⚡ What is Baglihar HEP capacity?
              </button>
              <button type="button" class="hydro-suggest-btn text-[11px] bg-slate-100 hover:bg-[#EAF4FF] hover:text-[#0B4F9C] text-slate-700 px-2.5 py-1 rounded-full border border-slate-200 transition-colors text-left cursor-pointer">
                📋 Show active tenders
              </button>
              <button type="button" class="hydro-suggest-btn text-[11px] bg-slate-100 hover:bg-[#EAF4FF] hover:text-[#0B4F9C] text-slate-700 px-2.5 py-1 rounded-full border border-slate-200 transition-colors text-left cursor-pointer">
                🏢 What is JKSPDC GSTIN?
              </button>
              <button type="button" class="hydro-suggest-btn text-[11px] bg-slate-100 hover:bg-[#EAF4FF] hover:text-[#0B4F9C] text-slate-700 px-2.5 py-1 rounded-full border border-slate-200 transition-colors text-left cursor-pointer">
                👥 Who are the Board of Directors?
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Input Form -->
    <div class="p-3 bg-white border-t border-slate-200 flex-shrink-0">
      <form id="hydro-chat-form" class="flex items-center gap-2">
        <label for="hydro-input" class="sr-only">Ask HYDRO a question</label>
        <input
          id="hydro-input"
          type="text"
          placeholder="Ask anything about JKSPDC..."
          maxlength="2000"
          autocomplete="off"
          class="flex-1 text-xs px-3.5 py-2.5 bg-slate-50 border border-slate-300 rounded-xl focus:bg-white focus:border-[#0B4F9C] focus:outline-none transition-colors placeholder:text-slate-400"
        />
        <button
          id="hydro-send-btn"
          type="submit"
          class="bg-[#0B4F9C] hover:bg-[#073B75] text-white p-2.5 rounded-xl shadow-md transition-all duration-150 active:scale-95 disabled:opacity-50 disabled:cursor-not-allowed cursor-pointer flex items-center justify-center"
          aria-label="Send message"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </button>
      </form>
      <div class="flex items-center justify-between text-[9px] text-slate-400 px-1 mt-1.5">
        <span>Grounded on official JKSPDC knowledge</span>
        <span>Version 2026.1</span>
      </div>
    </div>
  </div>
</div>

<script is:inline>
  (function () {
    const launcherBtn = document.getElementById('hydro-launcher-btn');
    const chatPanel = document.getElementById('hydro-chat-panel');
    const closeBtn = document.getElementById('hydro-close-btn');
    const clearBtn = document.getElementById('hydro-clear-btn');
    const chatForm = document.getElementById('hydro-chat-form');
    const chatInput = document.getElementById('hydro-input');
    const messagesContainer = document.getElementById('hydro-messages');
    const sendBtn = document.getElementById('hydro-send-btn');

    if (!launcherBtn || !chatPanel || !chatForm || !chatInput || !messagesContainer) return;

    // Session Memory Key
    const SESSION_KEY = 'hydro_session_id';
    let sessionId = sessionStorage.getItem(SESSION_KEY);
    if (!sessionId) {
      sessionId = 'hydro_' + Math.random().toString(36).substring(2, 11) + '_' + Date.now();
      sessionStorage.setItem(SESSION_KEY, sessionId);
    }

    let isWaiting = false;

    // Toggle Dialog
    function toggleChat(open) {
      const isHidden = chatPanel.classList.contains('hidden');
      const shouldOpen = open !== undefined ? open : isHidden;

      if (shouldOpen) {
        chatPanel.classList.remove('hidden');
        launcherBtn.classList.add('hidden');
        launcherBtn.setAttribute('aria-expanded', 'true');
        chatInput.focus();
      } else {
        chatPanel.classList.add('hidden');
        launcherBtn.classList.remove('hidden');
        launcherBtn.setAttribute('aria-expanded', 'false');
        launcherBtn.focus();
      }
    }

    launcherBtn.addEventListener('click', () => toggleChat(true));
    closeBtn?.addEventListener('click', () => toggleChat(false));

    // Close on Escape key
    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !chatPanel.classList.contains('hidden')) {
        toggleChat(false);
      }
    });

    // Clear Conversation
    clearBtn?.addEventListener('click', () => {
      const welcome = messagesContainer.firstElementChild;
      messagesContainer.innerHTML = '';
      if (welcome) messagesContainer.appendChild(welcome);
      attachSuggestionHandlers();
    });

    // Format simple Markdown
    function renderMarkdown(text) {
      if (!text) return '';
      return text
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/^### (.*$)/gim, '<h3 class="font-bold text-sm text-[#0B4F9C] mt-2 mb-1">$1</h3>')
        .replace(/^## (.*$)/gim, '<h2 class="font-bold text-base text-[#0B4F9C] mt-2.5 mb-1">$1</h2>')
        .replace(/^# (.*$)/gim, '<h1 class="font-black text-base text-[#0B4F9C] mt-3 mb-1.5">$1</h1>')
        .replace(/\*\*(.*?)\*\*/g, '<strong class="font-bold text-slate-900">$1</strong>')
        .replace(/\*(.*?)\*/g, '<em class="italic">$1</em>')
        .replace(/\[([^\]]+)\]\(([^)]+)\)/g, '<a href="$2" class="text-[#0B4F9C] font-semibold underline hover:text-[#073B75]">$1</a>')
        .replace(/^\s*-\s+(.*$)/gim, '<li class="ml-4 list-disc">$1</li>')
        .replace(/\n\n/g, '<br/><br/>')
        .replace(/\n/g, '<br/>');
    }

    // Append a message bubble
    function appendMessage(role, text, sources, conversationId) {
      const row = document.createElement('div');
      row.className = `flex gap-2.5 items-start ${role === 'user' ? 'justify-end' : ''}`;

      if (role === 'assistant') {
        const avatar = document.createElement('div');
        avatar.className = 'w-6 h-6 rounded-full bg-[#0B4F9C] text-white flex items-center justify-center flex-shrink-0 text-[10px] font-bold mt-0.5';
        avatar.textContent = 'H';
        row.appendChild(avatar);
      }

      const bubble = document.createElement('div');
      if (role === 'user') {
        bubble.className = 'max-w-[80%] bg-[#0B4F9C] text-white rounded-2xl rounded-tr-sm p-3 shadow-sm text-xs select-text';
        bubble.textContent = text;
      } else {
        bubble.className = 'flex-1 bg-white border border-slate-200 rounded-2xl rounded-tl-sm p-3.5 shadow-sm text-slate-800 space-y-2 select-text';
        bubble.innerHTML = `<div>${renderMarkdown(text)}</div>`;

        // Citations / Feedback row
        if (conversationId) {
          const feedbackRow = document.createElement('div');
          feedbackRow.className = 'flex items-center justify-between pt-2 border-t border-slate-100 text-[10px] text-slate-400 select-none';
          feedbackRow.innerHTML = `
            <span>Was this helpful?</span>
            <div class="flex items-center gap-1">
              <button type="button" class="hydro-fb-up px-1.5 py-0.5 rounded hover:bg-slate-100 hover:text-emerald-600 transition-colors" title="Helpful" aria-label="Helpful response">👍</button>
              <button type="button" class="hydro-fb-down px-1.5 py-0.5 rounded hover:bg-slate-100 hover:text-rose-600 transition-colors" title="Not helpful" aria-label="Not helpful response">👎</button>
            </div>
          `;

          const upBtn = feedbackRow.querySelector('.hydro-fb-up');
          const downBtn = feedbackRow.querySelector('.hydro-fb-down');

          upBtn?.addEventListener('click', () => sendFeedback(conversationId, 1, upBtn, downBtn));
          downBtn?.addEventListener('click', () => sendFeedback(conversationId, -1, upBtn, downBtn));

          bubble.appendChild(feedbackRow);
        }
      }

      row.appendChild(bubble);
      messagesContainer.appendChild(row);
      messagesContainer.scrollTop = messagesContainer.scrollHeight;
    }

    // Feedback Sender
    async function sendFeedback(conversationId, rating, upBtn, downBtn) {
      try {
        await fetch('http://localhost:3000/api/hydro/feedback', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ conversationId, rating }),
        });
        upBtn.disabled = true;
        downBtn.disabled = true;
        if (rating === 1) upBtn.classList.add('text-emerald-600', 'font-bold');
        if (rating === -1) downBtn.classList.add('text-rose-600', 'font-bold');
      } catch (e) {}
    }

    // Typing indicator
    function showTypingIndicator() {
      const ind = document.createElement('div');
      ind.id = 'hydro-typing';
      ind.className = 'flex gap-2.5 items-center text-slate-400 text-xs italic';
      ind.innerHTML = `
        <div class="w-6 h-6 rounded-full bg-[#0B4F9C] text-white flex items-center justify-center text-[10px] font-bold">H</div>
        <div class="bg-white border border-slate-200 rounded-xl px-3 py-2 shadow-sm flex items-center gap-1">
          <span class="w-1.5 h-1.5 bg-slate-400 rounded-full animate-bounce"></span>
          <span class="w-1.5 h-1.5 bg-slate-400 rounded-full animate-bounce [animation-delay:0.2s]"></span>
          <span class="w-1.5 h-1.5 bg-slate-400 rounded-full animate-bounce [animation-delay:0.4s]"></span>
        </div>
      `;
      messagesContainer.appendChild(ind);
      messagesContainer.scrollTop = messagesContainer.scrollHeight;
    }

    function removeTypingIndicator() {
      const ind = document.getElementById('hydro-typing');
      if (ind) ind.remove();
    }

    // Send Message Handler
    async function sendMessage(text) {
      const query = (text || chatInput.value).trim();
      if (!query || isWaiting) return;

      chatInput.value = '';
      appendMessage('user', query);
      isWaiting = true;
      if (sendBtn) sendBtn.disabled = true;
      showTypingIndicator();

      try {
        const res = await fetch('http://localhost:3000/api/hydro/chat', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            message: query,
            sessionId: sessionId,
            currentPage: window.location.pathname,
          }),
        });

        removeTypingIndicator();

        if (res.ok) {
          const data = await res.json();
          appendMessage('assistant', data.reply || 'No response', data.sources, data.conversationId);
        } else {
          appendMessage('assistant', "I'm temporarily unable to process that request. Please try again shortly.");
        }
      } catch (err) {
        removeTypingIndicator();
        appendMessage('assistant', "I'm currently unable to reach the knowledge server. Please ensure the backend server is running.");
      } finally {
        isWaiting = false;
        if (sendBtn) sendBtn.disabled = false;
        chatInput.focus();
      }
    }

    chatForm.addEventListener('submit', (e) => {
      e.preventDefault();
      sendMessage();
    });

    // Attach suggested query buttons
    function attachSuggestionHandlers() {
      document.querySelectorAll('.hydro-suggest-btn').forEach((btn) => {
        btn.addEventListener('click', () => {
          const text = btn.textContent.replace(/^[^\w\s]+/, '').trim();
          sendMessage(text);
        });
      });
    }

    attachSuggestionHandlers();
  })();
</script>
