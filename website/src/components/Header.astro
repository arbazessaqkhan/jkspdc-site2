          </button>
          <div class="absolute left-0 mt-0 hidden group-hover:block group-focus-within:block bg-white text-slate-800 shadow-2xl border-t-4 border-[#0695D6] rounded-b-lg z-50 py-2 w-[250px]">
            <ul class="flex flex-col gap-0.5 text-xs px-2">
              <li><a href="/stakeholders/vendors/tender-bids#live" class="block p-2 rounded hover:bg-slate-100 hover:text-[#0695D6]">Live Tenders &amp; Notices</a></li>
              <li><a href="/stakeholders/vendors/tender-bids#amendments" class="block p-2 rounded hover:bg-slate-100 hover:text-[#0695D6]">Amendments &amp; Clarifications</a></li>
              <li><a href="/stakeholders/vendors/tender-bids#awards" class="block p-2 rounded hover:bg-slate-100 hover:text-[#0695D6]">Awards &amp; Compliance</a></li>
              <li><a href="/stakeholders/vendors/tender-bids#portals" class="block p-2 rounded hover:bg-slate-100 hover:text-[#0695D6]">Access &amp; Portals</a></li>
              <li><a href="https://jktenders.gov.in/nicgep/app" target="_blank" rel="noopener" class="block p-2 rounded hover:bg-slate-100 hover:text-[#0695D6]">JK Tenders</a></li>
            </ul>
          </div>
        </li>

        <!-- Notifications -->
        <li>
          <a href="/stakeholders/investors/announcement" class="block px-1.5 sm:px-2 lg:px-2 xl:px-2.5 2xl:px-3.5 py-3 text-white hover:bg-white/10 transition-all duration-150 border-b-2 border-transparent hover:border-white/60 focus-visible:outline-none focus-visible:bg-white/15">Notifications</a>
        </li>

        <!-- Investors Corner -->
        <li class="relative group">
          <button class="flex items-center gap-0.5 lg:gap-1 px-1.5 sm:px-2 lg:px-2 xl:px-2.5 2xl:px-3.5 py-3 hover:bg-white/10 group-hover:bg-white/10 transition-all duration-150 border-b-2 border-transparent group-hover:border-white/60 text-white focus-visible:outline-none focus-visible:bg-white/15" aria-haspopup="true" aria-expanded="false">
            Investors Corner
            <Icon name="chevron-down" size={10} strokeWidth={2.5} class="transition-transform duration-200 group-hover:rotate-180 shrink-0" />
          </button>
          <div class="absolute left-0 mt-0 hidden group-hover:block group-focus-within:block bg-white text-slate-800 shadow-2xl border-t-4 border-[#0695D6] rounded-b-lg z-50 py-2 w-[230px]">
            <ul class="flex flex-col gap-0.5 text-xs px-2">
              <li><a href="/stakeholders/investors/agm" class="block p-2 rounded hover:bg-slate-100 hover:text-[#0695D6]">Annual General Meetings</a></li>
              <li><a href="/stakeholders/investors/ipp-projects" class="block p-2 rounded hover:bg-slate-100 hover:text-[#0695D6]">IPP Projects</a></li>
            </ul>
          </div>
        </li>

        <!-- RTI -->
        <li class="relative group">
          <button class="flex items-center gap-0.5 lg:gap-1 px-1.5 sm:px-2 lg:px-2 xl:px-2.5 2xl:px-3.5 py-3 hover:bg-white/10 group-hover:bg-white/10 transition-all duration-150 border-b-2 border-transparent group-hover:border-white/60 text-white focus-visible:outline-none focus-visible:bg-white/15" aria-haspopup="true" aria-expanded="false">
            RTI
            <Icon name="chevron-down" size={10} strokeWidth={2.5} class="transition-transform duration-200 group-hover:rotate-180 shrink-0" />
          </button>
          <div class="absolute left-0 mt-0 hidden group-hover:block group-focus-within:block bg-white text-slate-800 shadow-2xl border-t-4 border-[#0695D6] rounded-b-lg z-50 py-2 w-[210px]">
            <ul class="flex flex-col gap-0.5 text-xs px-2">
              <li><a href="/about-us/explore/rti" class="block p-2 rounded hover:bg-slate-100 hover:text-[#0695D6]">RTI Act (Sec 4)</a></li>
            </ul>
          </div>
        </li>

        <!-- Gallery -->
        <li>
          <a href="/media/gallery" class="block px-1.5 sm:px-2 lg:px-2 xl:px-2.5 2xl:px-3.5 py-3 text-white hover:bg-white/10 transition-all duration-150 border-b-2 border-transparent hover:border-white/60 focus-visible:outline-none focus-visible:bg-white/15">Gallery</a>
        </li>

        <!-- Downloads -->
        <li>
          <a href="/media/downloads" class="block px-1.5 sm:px-2 lg:px-2 xl:px-2.5 2xl:px-3.5 py-3 text-white hover:bg-white/10 transition-all duration-150 border-b-2 border-transparent hover:border-white/60 focus-visible:outline-none focus-visible:bg-white/15">Downloads</a>
        </li>

        <!-- Employees Corner -->
        <li class="relative group">
          <button class="flex items-center gap-0.5 lg:gap-1 px-1.5 sm:px-2 lg:px-2 xl:px-2.5 2xl:px-3.5 py-3 hover:bg-white/10 group-hover:bg-white/10 transition-all duration-150 border-b-2 border-transparent group-hover:border-white/60 text-white focus-visible:outline-none focus-visible:bg-white/15" aria-haspopup="true" aria-expanded="false">
            Employees Corner
            <Icon name="chevron-down" size={10} strokeWidth={2.5} class="transition-transform duration-200 group-hover:rotate-180 shrink-0" />
          </button>
          <div class="absolute right-0 mt-0 hidden group-hover:block group-focus-within:block bg-white text-slate-800 shadow-2xl border-t-4 border-[#0695D6] rounded-b-lg z-50 py-2 w-[220px]">
            <ul class="flex flex-col gap-0.5 text-xs px-2">
              <li><a href="https://www.jkspdcl.com:2096/" target="_blank" rel="noopener noreferrer" class="block p-2 rounded hover:bg-slate-100 hover:text-[#0695D6]">Web Mail<span class="sr-only"> (opens in new tab)</span></a></li>
              <li><a href="https://saccess.nic.in/" target="_blank" rel="noopener noreferrer" class="block p-2 rounded hover:bg-slate-100 hover:text-[#0695D6]">Nic-e-File<span class="sr-only"> (opens in new tab)</span></a></li>
              <li><a href="https://eoffice.jk.gov.in/" target="_blank" rel="noopener noreferrer" class="block p-2 rounded hover:bg-slate-100 hover:text-[#0695D6]">E-Office<span class="sr-only"> (opens in new tab)</span></a></li>
              <li><a href="https://hrms.jk.gov.in/" target="_blank" rel="noopener noreferrer" class="block p-2 rounded hover:bg-slate-100 hover:text-[#0695D6]">JKHRMS<span class="sr-only"> (opens in new tab)</span></a></li>
              <li><a href="https://prs.jk.gov.in/" target="_blank" rel="noopener noreferrer" class="block p-2 rounded hover:bg-slate-100 hover:text-[#0695D6]">Property Return (GAD)<span class="sr-only"> (opens in new tab)</span></a></li>
              <li><a href="https://law.pmgatishakti.gov.in/EETMS/login" target="_blank" rel="noopener noreferrer" class="block p-2 rounded hover:bg-slate-100 hover:text-[#0695D6]">EETMS<span class="sr-only"> (opens in new tab)</span></a></li>
              <li><a href="https://bg.jkspdc.in/" target="_blank" rel="noopener noreferrer" class="block p-2 rounded hover:bg-slate-100 hover:text-[#0695D6]">BG Management<span class="sr-only"> (opens in new tab)</span></a></li>
              <li><a href="https://asset.jkspdcl.co.in/login" target="_blank" rel="noopener noreferrer" class="block p-2 rounded hover:bg-slate-100 hover:text-[#0695D6]">Asset Management<span class="sr-only"> (opens in new tab)</span></a></li>
              <li><a href="https://janparichay.meripehchaan.gov.in/v1/pehchaan/login.html?service=passive&active=true&rm_5=false&continue=https%3A%2F%2Fjan_com%2Fmail%2F&pp=1&scc=1&lmpl=default&ltmplcache=2&emr=1&osid=1&flowName=GlifWebSignIn&flowEntry=ServiceLogin&sid=JanSugamJK&v=2.0&lang=&urlid=82ae2068-ada6-4154-ae21-649b90598534" target="_blank" rel="noopener noreferrer" class="block p-2 rounded hover:bg-slate-100 hover:text-[#0695D6]">JKSPDC RAS<span class="sr-only"> (opens in new tab)</span></a></li>
            </ul>
          </div>
        </li>

        <!-- Contact Us -->
        <li class="relative group">
          <button class="flex items-center gap-0.5 lg:gap-1 px-1.5 sm:px-2 lg:px-2 xl:px-2.5 2xl:px-3.5 py-3 hover:bg-white/10 group-hover:bg-white/10 transition-all duration-150 border-b-2 border-transparent group-hover:border-white/60 text-white focus-visible:outline-none focus-visible:bg-white/15" aria-haspopup="true" aria-expanded="false">
            Contact Us
            <Icon name="chevron-down" size={10} strokeWidth={2.5} class="transition-transform duration-200 group-hover:rotate-180 shrink-0" />
          </button>
          <div class="absolute right-0 mt-0 hidden group-hover:block group-focus-within:block bg-white text-slate-800 shadow-2xl border-t-4 border-[#0695D6] rounded-b-lg z-50 py-2 w-[200px]">
            <ul class="flex flex-col gap-0.5 text-xs px-2">
              <li><a href="/about-us/others/contact" class="block p-2 rounded hover:bg-slate-100 hover:text-[#0695D6]">Contact Us</a></li>
              <li><a href="/feedback" class="block p-2 rounded hover:bg-slate-100 hover:text-[#0695D6]">Feedback</a></li>
            </ul>
          </div>
        </li>
      </ul>
    </div>
  </nav>

  <!-- Header Search Autocomplete Script -->
  <script is:inline>var API_BASE = window.__API_BASE__;

    (function() {
      var searchForm = document.getElementById('header-search-form');
      var searchInput = document.getElementById('header-search');
      var suggestionsBox = document.getElementById('header-search-suggestions');
      var searchIndex = [];
      var loadPromise = null;

      function closeLangDropdown() {
        var langMenu = document.getElementById('lang-dropdown-menu');
        var langArrow = document.getElementById('lang-arrow');
        var langBtn = document.getElementById('lang-dropdown-btn');
        if (langMenu && !langMenu.classList.contains('hidden')) {
          langMenu.classList.add('hidden');
          if (langBtn) langBtn.setAttribute('aria-expanded', 'false');
          if (langArrow) langArrow.classList.remove('rotate-180');
        }
      }

      async function loadIndex() {
        try {
          var sitemapRes = await fetch('/search-index.json');
          if (sitemapRes.ok) {
            searchIndex = await sitemapRes.json();
          }
        } catch(err) {
          console.error('Failed to load sitemap search index:', err);
        }
        try {
          var projectsRes = await fetch('window.__API_BASE__/api/projects');
          if (projectsRes.ok) {
            var projects = await projectsRes.json();
            projects.forEach(function(p) {
              searchIndex.push({
                title: p.name,
                url: '/our-business/power-station-details?id=' + p.id,
                description: 'About ' + p.name + ' - Capacity: ' + p.capacityMw + ' MW, Location: ' + (p.location || 'J&K') + '. Status: ' + p.status + '.'
              });
            });
          }
        } catch(e) {
          // Ignore optional project lookup error
        }
      }

      function renderSuggestions(query) {
        if (!query) {
          suggestionsBox.innerHTML = '';
          suggestionsBox.classList.add('hidden');
          return;
        }

        var matches = searchIndex.filter(function(item) {
          return (item.title && item.title.toLowerCase().indexOf(query) !== -1) ||
                 (item.description && item.description.toLowerCase().indexOf(query) !== -1);
        }).slice(0, 8);

        if (matches.length > 0) {
          suggestionsBox.innerHTML = matches.map(function(item) {
            var titleRegex = new RegExp('(' + query.replace(/[-\/\\^$*+?.()|[\]{}]/g, '\\$&') + ')', 'gi');
            var highlightedTitle = (item.title || '').replace(titleRegex, '<mark style="background-color: #fef08a; color: #1e293b; font-weight: 700; padding: 0px 2px; border-radius: 2px;">$1</mark>');
            return '<button type="button" class="w-full text-left px-3 py-1.5 hover:bg-slate-100 transition-colors block cursor-pointer border-b border-slate-50 last:border-0" data-url="' + item.url + '" style="font-size: 11px; outline: none; border-bottom: 1px solid #f1f5f9; display: block; background: transparent; border-left: 0; border-right: 0; border-top: 0; font-family: inherit; margin: 0; padding: 6px 12px; width: 100%; text-align: left;">' +
                   '<span style="color: #0695D6; font-weight: 700; display: block;">' + highlightedTitle + '</span>' +
                   '<span style="font-size: 9.5px; color: #64748b; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; display: block; margin-top: 2px;">' + (item.description || '') + '</span>' +
                   '</button>';
          }).join('');
          suggestionsBox.classList.remove('hidden');
        } else {
          suggestionsBox.innerHTML = '';
          suggestionsBox.classList.add('hidden');
        }
      }

      function handleInput() {
        var query = searchInput.value.toLowerCase().trim();
        if (!query) {
          suggestionsBox.innerHTML = '';
          suggestionsBox.classList.add('hidden');
          return;
        }

        if (searchIndex.length === 0) {
          if (!loadPromise) loadPromise = loadIndex();
          loadPromise.then(function() {
            renderSuggestions(query);
          });
        } else {
          renderSuggestions(query);
        }
      }

      if (searchInput && searchForm && suggestionsBox) {
        // Preload index immediately
        loadPromise = loadIndex();

        searchInput.addEventListener('focus', function() {
          closeLangDropdown();
          if (searchInput.value.trim()) {
            handleInput();
          }
        });

        searchInput.addEventListener('input', function() {
          closeLangDropdown();
          handleInput();
        });

        suggestionsBox.addEventListener('click', function(e) {
          var btn = e.target.closest('button');
          if (btn && btn.dataset.url) {
            window.location.href = btn.dataset.url;
          }
        });

        document.addEventListener('click', function(e) {
          if (!e.target.closest('#header-search-form')) {
            suggestionsBox.classList.add('hidden');
          }
        });

        document.addEventListener('keydown', function(e) {
          if (e.key === 'Escape') {
            suggestionsBox.classList.add('hidden');
          }
        });

        searchForm.addEventListener('submit', function(e) {
          e.preventDefault();
          var query = searchInput.value.trim();
          if (!query) return;

          var lowerQuery = query.toLowerCase();
          var bestMatch = null;
          
          for (var i = 0; i < searchIndex.length; i++) {
            if (searchIndex[i].title && searchIndex[i].title.toLowerCase() === lowerQuery) {
              bestMatch = searchIndex[i];
              break;
            }
          }
          
          if (!bestMatch) {
            for (var i = 0; i < searchIndex.length; i++) {
              if (searchIndex[i].title && searchIndex[i].title.toLowerCase().indexOf(lowerQuery) !== -1) {
                bestMatch = searchIndex[i];
                break;
              }
            }
          }

          if (bestMatch) {
            window.location.href = bestMatch.url;
          } else {
            window.location.href = '/search?q=' + encodeURIComponent(query);
          }
        });
      }
    })();
  </script>
</header>
