---
import Icon from './Icon.astro';
import AccessibilityBar from './AccessibilityBar.astro';
import Ticker from './Ticker.astro';
---

<header class="bg-white border-t-[3px] border-[#0695D6] border-b border-slate-200/90 shadow-2xs relative z-[60]" style="position: relative; z-index: 60;">
  <div class="max-w-[1400px] mx-auto px-3 sm:px-5 lg:px-6 py-2.5 sm:py-3 flex flex-col md:flex-row items-center justify-between gap-3 md:gap-6">
    <!-- Left: Official Institutional Identity Lockup -->
    <div class="flex items-center gap-3 sm:gap-4 min-w-0 flex-1 w-full md:w-auto">
      <!-- Official Logo -->
      <a href="/" class="flex-shrink-0 group focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#0695D6] rounded-lg p-0.5 transition-transform duration-150 hover:scale-[1.02]" aria-label="JKSPDCL Official Portal Home">
        <img src="/logo.png" alt="JKSPDCL Official Emblem" class="h-12 sm:h-14 md:h-15 lg:h-16 w-auto object-contain" />
      </a>

      <!-- Subtle Institutional Divider -->
      <div class="w-px h-11 sm:h-12 bg-slate-200/90 hidden sm:block shrink-0"></div>

      <!-- Official Organization Typography -->
      <div class="flex flex-col min-w-0 justify-center text-left">
        <h1 class="font-extrabold text-[#0F025E] text-[14px] sm:text-[16px] md:text-[17px] lg:text-[18.5px] xl:text-[19.5px] leading-tight tracking-tight">
          Jammu &amp; Kashmir State Power Development Corporation Limited
        </h1>
        <div class="flex items-center gap-1.5 sm:gap-2 mt-0.5 flex-wrap">
          <span class="text-slate-600 font-semibold text-[11px] sm:text-xs tracking-wide">
            A Government of J&amp;K Undertaking
          </span>
          <span class="text-slate-300 hidden sm:inline">•</span>
          <span class="text-[#0F025E] font-bold text-[11px] sm:text-xs">
            (JKSPDCL)
          </span>
        </div>
        <p class="text-slate-700 font-medium text-[11px] sm:text-xs leading-snug mt-0.5 font-devanagari" lang="hi">
          जम्मू और कश्मीर राज्य विद्युत विकास निगम लिमिटेड (जेकेएसपीडीसीएल)
        </p>
      </div>
    </div>

    <!-- Right: Utility Controls & Integrated Search Toolbar -->
    <div class="flex flex-col items-center md:items-end gap-2 shrink-0 w-full md:w-auto">
      <!-- Accessibility Controls Component -->
      <AccessibilityBar />

      <!-- Integrated Government Search Form -->
      <form action="/search" method="GET" class="flex items-center w-full justify-end relative" id="header-search-form" autocomplete="off">
        <div class="relative flex items-center w-full max-w-full md:max-w-[270px] lg:max-w-[290px]">
          <label for="header-search" class="sr-only">Search portal pages, tenders, notifications</label>
          <div class="flex items-center w-full bg-white hover:bg-slate-50/50 focus-within:bg-white border border-slate-300 focus-within:border-[#0695D6] rounded-lg pl-2.5 pr-1 py-0.5 transition-all duration-150 shadow-2xs outline-none focus-within:outline-none ring-0 focus-within:ring-0">
            <Icon name="search" size={13} strokeWidth={2.2} class="text-slate-400 shrink-0 mr-1.5" />
            <input 
              type="search" 
              name="q" 
              id="header-search" 
              placeholder="Search portal, tenders…" 
              class="w-full bg-transparent text-xs text-slate-700 placeholder:text-slate-400 font-normal py-1 px-1 outline-none focus:outline-none border-0 focus:ring-0" 
              style="outline: none !important; box-shadow: none !important; border: none !important; font-weight: 400 !important;"
              required
            />
            <button 
              type="submit" 
              class="shrink-0 px-2.5 py-1 bg-[#0F025E] hover:bg-[#0695D6] text-white text-[11px] font-semibold rounded-md transition-colors duration-150 shadow-2xs focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-[#0695D6] cursor-pointer" 
              aria-label="Submit Search"
            >
              Search
            </button>
          </div>
          <!-- Suggestions Dropdown Container -->
          <div id="header-search-suggestions" class="absolute left-0 right-0 top-full mt-1 bg-white text-slate-800 border border-slate-200 rounded-lg shadow-2xl hidden z-[9999] max-h-72 overflow-y-auto text-left py-1 w-full sm:w-[320px] sm:left-auto sm:right-0">
          </div>
        </div>
      </form>
    </div>
  </div>

  <!-- Live News Ticker -->
  <Ticker />

  <!-- Navigation Bar -->
  <nav class="bg-[#0F025E] border-t border-white/10 shadow-xl sticky top-0 z-50 transition-all duration-200" aria-label="Primary Navigation">
    <div class="max-w-[1400px] mx-auto px-2 sm:px-3 lg:px-4 nav-scroll-container">
      <ul class="flex flex-nowrap w-full justify-between items-center text-[13px] sm:text-[13.5px] lg:text-[13.5px] xl:text-[14.5px] 2xl:text-[15.5px] font-bold whitespace-nowrap min-w-0">
        <!-- Home -->
        <li>
          <a href="/" class="block px-1.5 sm:px-2 lg:px-2 xl:px-2.5 2xl:px-3.5 py-3 text-white hover:bg-white/10 transition-all duration-150 border-b-2 border-transparent hover:border-white/60 focus-visible:outline-none focus-visible:bg-white/15">
            Home
          </a>
        </li>

        <!-- About Us -->
        <li class="relative group">
          <button class="flex items-center gap-0.5 lg:gap-1 px-1.5 sm:px-2 lg:px-2 xl:px-2.5 2xl:px-3.5 py-3 hover:bg-white/10 group-hover:bg-white/10 transition-all duration-150 border-b-2 border-transparent group-hover:border-white/60 text-white focus-visible:outline-none focus-visible:bg-white/15" aria-haspopup="true" aria-expanded="false">
            About Us
            <Icon name="chevron-down" size={10} strokeWidth={2.5} class="transition-transform duration-200 group-hover:rotate-180 shrink-0" />
          </button>
          <div class="absolute left-0 mt-0 hidden group-hover:block group-focus-within:block bg-white text-slate-800 shadow-2xl border-t-4 border-[#0695D6] rounded-b-lg z-50 py-2 w-[260px]">
            <ul class="flex flex-col gap-0.5 text-xs px-2">
              <li><a href="/about-us/explore/overview" class="block p-2 rounded hover:bg-slate-100 hover:text-[#0695D6]">About Us</a></li>
              <li><a href="/about-us/explore/association-memorandum" class="block p-2 rounded hover:bg-slate-100 hover:text-[#0695D6]">MoA &amp; AoA</a></li>
              <li><a href="/about-us/explore/organization-chart" class="block p-2 rounded hover:bg-slate-100 hover:text-[#0695D6]">Organizational Structure</a></li>
              <li><a href="/about-us/management/board" class="block p-2 rounded hover:bg-slate-100 hover:text-[#0695D6]">Board Of Director</a></li>
              <li><a href="/about-us/explore/gstin-registration" class="block p-2 rounded hover:bg-slate-100 hover:text-[#0695D6]">GSTIN Registration Details</a></li>
              <li><a href="/about-us/explore/policies" class="block p-2 rounded hover:bg-slate-100 hover:text-[#0695D6]">Policies</a></li>
              <li><a href="/sustainability/csr/policy" class="block p-2 rounded hover:bg-slate-100 hover:text-[#0695D6]">CSR Policy</a></li>
            </ul>
          </div>
        </li>

        <!-- Projects -->
        <li class="relative group">
          <button class="flex items-center gap-0.5 lg:gap-1 px-1.5 sm:px-2 lg:px-2 xl:px-2.5 2xl:px-3.5 py-3 hover:bg-white/10 group-hover:bg-white/10 transition-all duration-150 border-b-2 border-transparent group-hover:border-white/60 text-white focus-visible:outline-none focus-visible:bg-white/15" aria-haspopup="true" aria-expanded="false">
            Projects
            <Icon name="chevron-down" size={10} strokeWidth={2.5} class="transition-transform duration-200 group-hover:rotate-180 shrink-0" />
          </button>
          <div class="absolute left-0 mt-0 hidden group-hover:block group-focus-within:block bg-white text-slate-800 shadow-2xl border-t-4 border-[#0695D6] rounded-b-lg z-50 py-2 w-[240px]">
            <ul class="flex flex-col gap-0.5 text-xs px-2">
              <li><a href="/our-business/power-stations" class="block p-2 rounded hover:bg-slate-100 hover:text-[#0695D6]">Operational Projects</a></li>
              <li><a href="/our-business/construction" class="block p-2 rounded hover:bg-slate-100 hover:text-[#0695D6]">Projects Under Construction</a></li>
              <li><a href="/our-business/under-development" class="block p-2 rounded hover:bg-slate-100 hover:text-[#0695D6]">Upcoming Projects</a></li>
            </ul>
          </div>
        </li>

        <!-- Tenders -->
        <li class="relative group">
          <button class="flex items-center gap-0.5 lg:gap-1 px-1.5 sm:px-2 lg:px-2 xl:px-2.5 2xl:px-3.5 py-3 hover:bg-white/10 group-hover:bg-white/10 transition-all duration-150 border-b-2 border-transparent group-hover:border-white/60 text-white focus-visible:outline-none focus-visible:bg-white/15" aria-haspopup="true" aria-expanded="false">
            Tenders
