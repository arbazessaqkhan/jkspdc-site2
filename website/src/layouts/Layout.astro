---
import '../styles/global.css';
import Icon from '../components/Icon.astro';

interface Props {
  title: string;
  description: string;
  canonicalUrl?: string;
  isHome?: boolean;
}

const { title, description, canonicalUrl, isHome = false } = Astro.props;
const canonical = canonicalUrl || Astro.url.href;
const currentYear = new Date().getFullYear();
---


<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | JKSPDC Official Portal</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    
    <!-- GIGW SEO & Browser Compatibility -->
    <meta name="robots" content="index, follow" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <link rel="icon" type="image/png" href="/logo.png" />
    <!-- Google Fonts: Noto Sans for Hindi support -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans:ital,wght@0,400;0,500;0,600;0,700;0,800;1,400&family=Noto+Sans+Devanagari:wght@400;500;600;700&display=swap" rel="stylesheet" />
    
    <!-- Custom styling for high contrast mode -->
    <style>
      .high-contrast {
        background-color: #000000 !important;
        color: #ffff00 !important;
      }
      .high-contrast header, 
      .high-contrast footer,
      .high-contrast nav,
      .high-contrast div,
      .high-contrast section,
      .high-contrast aside,
      .high-contrast article,
      .high-contrast table,
      .high-contrast th,
      .high-contrast td {
        background-color: #000000 !important;
        color: #ffff00 !important;
        border-color: #ffff00 !important;
      }
      .high-contrast a,
      .high-contrast button {
        color: #ffff00 !important;
        text-decoration: underline !important;
      }
      .high-contrast a:hover,
      .high-contrast button:hover {
        background-color: #333333 !important;
        color: #ffffff !important;
      }

      /* ── Ticker scroll animation ───────────────────────────────── */
      @keyframes ticker-scroll {
        0%   { transform: translateX(0); }
        100% { transform: translateX(-50%); }
      }
      .animate-ticker {
        display: flex;
        white-space: nowrap;
        animation: ticker-scroll 38s linear infinite;
        will-change: transform;
      }
      .animate-ticker:hover {
        animation-play-state: paused;
      }

      /* ── Slow pulse for status dots ────────────────────────────── */
      @keyframes slow-pulse {
        0%, 100% { opacity: 1; }
        50%       { opacity: 0.35; }
      }
      .animate-slow-pulse {
        animation: slow-pulse 2.5s ease-in-out infinite;
      }
    </style>
    <!-- Incremental font size helper (GIGW Accessibility) -->
    <script is:inline>
      function adjustFontSize(action) {
        var html = document.documentElement;
        var cur = parseFloat(window.getComputedStyle(html).fontSize) || 16;
        if (action === 'inc') {
          if (cur < 24) html.style.fontSize = (cur + 1) + 'px';
        } else if (action === 'dec') {
          if (cur > 12) html.style.fontSize = (cur - 1) + 'px';
        } else {
          html.style.fontSize = '16px';
        }
      }
    </script>
  </head>
  <body class="min-h-screen flex flex-col bg-slate-50 text-slate-800 font-sans transition-colors duration-150">
    
    <!-- Skip to Main Content Link (GIGW Mandatory) -->
    <a href="#main-content" class="skip-link">Skip to Main Content</a>

    <!-- Top Utility Bar (Accessibility & Bilingual Switchers) -->
    <div class="bg-[#083B73] text-slate-100 text-xs py-2 border-b border-[#0B4F9C]/30">
      <div class="max-w-7xl mx-auto px-4 flex justify-between items-center">
        <!-- Office Info / Contact Helpline -->
        <div class="hidden sm:flex items-center gap-4">
          <span class="flex items-center gap-1.5"><Icon name="phone" size={12} strokeWidth={2} /> Jammu Office: +91 191 2430548</span>
          <span class="flex items-center gap-1.5"><Icon name="phone" size={12} strokeWidth={2} /> Srinagar Office: +91 194 2451665</span>
        </div>
        <!-- Accessibility Controls -->
        <div class="flex items-center gap-4 ml-auto">
          <div class="flex items-center gap-1.5" aria-label="Font Size Controls" role="group">
            <button class="flex items-center gap-1 px-2 py-0.5 bg-white/20 hover:bg-white/40 border border-white/40 rounded text-[11px] font-bold text-white transition-colors" onclick="adjustFontSize('dec')" aria-label="Decrease Font Size" title="Decrease Font Size">
              <Icon name="minus" size={9} strokeWidth={2.5} /> A
            </button>
            <button class="flex items-center px-2.5 py-0.5 bg-white/20 hover:bg-white/40 border border-white/40 rounded text-[11px] font-bold text-white transition-colors" onclick="adjustFontSize('reset')" aria-label="Reset Font Size" title="Reset Font Size">A</button>
            <button class="flex items-center gap-1 px-2 py-0.5 bg-white/20 hover:bg-white/40 border border-white/40 rounded text-[11px] font-bold text-white transition-colors" onclick="adjustFontSize('inc')" aria-label="Increase Font Size" title="Increase Font Size">
              <Icon name="plus" size={9} strokeWidth={2.5} /> A
            </button>
          </div>
          <span class="text-slate-600">|</span>
          <!-- Contrast Switcher -->
          <button class="flex items-center gap-1.5 px-2 py-0.5 bg-[#0B4F9C]/40 hover:bg-[#0B4F9C]/60 rounded text-[10px] font-semibold" onclick="document.body.classList.toggle('high-contrast')" aria-label="Toggle High Contrast Mode"><Icon name="contrast" size={12} strokeWidth={2} /> Contrast</button>
          <span class="text-slate-600">|</span>
          <!-- Language Selector -->
          <a href="#" class="flex items-center gap-1 hover:text-white transition-colors font-semibold" aria-label="Switch Language to Hindi"><Icon name="globe" size={12} strokeWidth={2} /> हिन्दी</a>
        </div>
      </div>
    </div>

    <!-- Live News Ticker Bar -->
    <div class="bg-[#F0F9FF] text-[#1B2A41] relative overflow-hidden" aria-live="polite" aria-label="Live announcements" style="border-top:1px solid #BAE6FD; border-bottom:1px solid #BAE6FD;">
      <div class="flex items-stretch" style="max-width:100%;">
        <div class="shrink-0 bg-[#0B4F9C] text-white text-xs font-bold px-4 flex items-center gap-2 uppercase tracking-wide" style="white-space:nowrap;">
          <span class="w-2 h-2 rounded-full bg-[#C62828] animate-slow-pulse" style="display:inline-block;flex-shrink:0;"></span>
          Live
        </div>
        <div style="overflow:hidden; flex:1; position:relative;">
          <div class="animate-ticker" style="gap: 3rem; padding: 0.5rem 0; font-size: 0.8rem; font-weight: 500;">
            <span style="padding-right:3rem;">› NEW: Recruitment 2025 — 250 Junior Engineer posts announced. Apply by 30 Jun 2025</span>
            <span style="padding-right:3rem;">› TENDER: NIT-521 for Baglihar Refurbishment closing 28 Jun 2025</span>
            <span style="padding-right:3rem;">› PRESS: JKSPDC signs MoU for 3,000 MW hydro expansion with NHPC</span>
            <span style="padding-right:3rem;">› CORRIGENDUM: COR/2025/56 issued for Pakal Dul E&amp;M works</span>
            <span style="padding-right:3rem;">› INVESTOR: 32nd AGM scheduled for 25 Jun 2025</span>
            <span style="padding-right:3rem;">› NEW: Recruitment 2025 — 250 Junior Engineer posts announced. Apply by 30 Jun 2025</span>
            <span style="padding-right:3rem;">› TENDER: NIT-521 for Baglihar Refurbishment closing 28 Jun 2025</span>
            <span style="padding-right:3rem;">› PRESS: JKSPDC signs MoU for 3,000 MW hydro expansion with NHPC</span>
            <span style="padding-right:3rem;">› CORRIGENDUM: COR/2025/56 issued for Pakal Dul E&amp;M works</span>
            <span style="padding-right:3rem;">› INVESTOR: 32nd AGM scheduled for 25 Jun 2025</span>
          </div>
        </div>
      </div>
    </div>

    <header class="bg-[#EAF4FF] border-b-2 border-[#0B4F9C] shadow-sm">
      <div class="max-w-full px-4 py-4 flex items-center justify-between">
        <!-- Left Logo -->
        <a href="/" class="flex-shrink-0 focus:outline-none focus:ring-2 focus:ring-[#0B4F9C] rounded p-1" aria-label="JKSPDCL Home">
          <img src="/logo.png" alt="JKSPDCL Logo" class="h-14 w-auto object-contain" />
        </a>

        <!-- Centered Organization Name -->
        <div class="flex-1 text-center px-4">
          <h1 class="text-lg md:text-2xl font-bold text-[#0B4F9C] leading-tight">
            Jammu &amp; Kashmir State Power Development Corporation Limited (JKSPDCL)
          </h1>
          <p class="text-sm md:text-base font-bold text-[#0B4F9C] mt-1.5" lang="hi">
            जम्मू और कश्मीर राज्य विद्युत विकास निगम लिमिटेड (जेकेएसपीडीसीएल)
          </p>
        </div>

        <!-- Right Logo -->
        <a href="/" class="flex-shrink-0 focus:outline-none focus:ring-2 focus:ring-[#0B4F9C] rounded p-1" aria-label="JKSPDCL Home" tabindex="-1" aria-hidden="true">
          <img src="/logo.png" alt="" class="h-14 w-auto object-contain" />
        </a>
      </div>

      <!-- Navigation Bar (With CSS and Keyboard Accessible Dropdowns) -->
      <nav class="bg-[#0B4F9C] border-t border-white/10 relative" aria-label="Primary Navigation">
        <div class="max-w-7xl mx-auto px-4 flex flex-col md:flex-row justify-between items-center gap-4">
          <ul class="flex flex-wrap gap-0 text-sm font-semibold">
            <!-- Home -->
            <li>
              <a href="/" class="block px-3.5 py-3.5 text-white hover:bg-[#084A8F] transition-colors border-b-2 border-transparent hover:border-white/60">
                Home
              </a>
            </li>

            <!-- About Us -->
            <li class="relative group">
              <button class="flex items-center gap-1.5 px-3.5 py-3.5 hover:bg-[#084A8F] transition-colors border-b-2 border-transparent group-hover:border-white/60 text-white focus:outline-none focus:bg-[#073A80]" aria-haspopup="true" aria-expanded="false">
                About Us
                <svg class="w-3 h-3 transition-transform duration-200 group-hover:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7"></path></svg>
              </button>
              <div class="absolute left-0 mt-0 hidden group-hover:block group-focus-within:block bg-white text-slate-800 shadow-2xl border-t-4 border-[#0B4F9C] rounded-b-lg z-50 py-2 w-[260px]">
                <ul class="flex flex-col gap-0.5 text-xs px-2">
                  <li><a href="/about-us/explore/overview" class="block p-2 rounded hover:bg-slate-100 hover:text-[#0B4F9C]">About Us</a></li>
                  <li><a href="/about-us/explore/association-memorandum" class="block p-2 rounded hover:bg-slate-100 hover:text-[#0B4F9C]">MoA &amp; AoA</a></li>
                  <li><a href="/about-us/explore/organization-chart" class="block p-2 rounded hover:bg-slate-100 hover:text-[#0B4F9C]">Organizational Structure</a></li>
                  <li><a href="/about-us/management/board" class="block p-2 rounded hover:bg-slate-100 hover:text-[#0B4F9C]">Board Of Director</a></li>
                  <li><a href="/about-us/explore/gstin-registration" class="block p-2 rounded hover:bg-slate-100 hover:text-[#0B4F9C]">GSTIN Registration Details</a></li>
                  <li><a href="/policies/privacy" class="block p-2 rounded hover:bg-slate-100 hover:text-[#0B4F9C]">Policies</a></li>
                  <li><a href="/sustainability/csr/overview" class="block p-2 rounded hover:bg-slate-100 hover:text-[#0B4F9C]">CSR</a></li>
                </ul>
              </div>
            </li>

            <!-- Projects -->
            <li class="relative group">
              <button class="flex items-center gap-1.5 px-3.5 py-3.5 hover:bg-[#084A8F] transition-colors border-b-2 border-transparent group-hover:border-white/60 text-white focus:outline-none focus:bg-[#073A80]" aria-haspopup="true" aria-expanded="false">
                Projects
                <svg class="w-3 h-3 transition-transform duration-200 group-hover:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7"></path></svg>
              </button>
              <div class="absolute left-0 mt-0 hidden group-hover:block group-focus-within:block bg-white text-slate-800 shadow-2xl border-t-4 border-[#0B4F9C] rounded-b-lg z-50 py-2 w-[240px]">
                <ul class="flex flex-col gap-0.5 text-xs px-2">
                  <li><a href="/our-business/power-stations" class="block p-2 rounded hover:bg-slate-100 hover:text-[#0B4F9C]">Operational Projects</a></li>
                  <li><a href="/our-business/construction" class="block p-2 rounded hover:bg-slate-100 hover:text-[#0B4F9C]">Projects Under Construction</a></li>
                  <li><a href="/our-business/under-development" class="block p-2 rounded hover:bg-slate-100 hover:text-[#0B4F9C]">Upcoming Projects</a></li>
                </ul>
              </div>
            </li>

            <!-- Tenders -->
            <li>
              <a href="/stakeholders/vendors/tender-bids" class="block px-3.5 py-3.5 text-white hover:bg-[#084A8F] transition-colors border-b-2 border-transparent hover:border-white/60">Tenders</a>
            </li>

            <!-- Notifications -->
            <li>
              <a href="/stakeholders/investors/announcement" class="block px-3.5 py-3.5 text-white hover:bg-[#084A8F] transition-colors border-b-2 border-transparent hover:border-white/60">Notifications</a>
            </li>

            <!-- Investors Corner -->
            <li class="relative group">
              <button class="flex items-center gap-1.5 px-3.5 py-3.5 hover:bg-[#084A8F] transition-colors border-b-2 border-transparent group-hover:border-white/60 text-white focus:outline-none focus:bg-[#073A80]" aria-haspopup="true" aria-expanded="false">
                Investors Corner
                <svg class="w-3 h-3 transition-transform duration-200 group-hover:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7"></path></svg>
              </button>
              <div class="absolute left-0 mt-0 hidden group-hover:block group-focus-within:block bg-white text-slate-800 shadow-2xl border-t-4 border-[#0B4F9C] rounded-b-lg z-50 py-2 w-[230px]">
                <ul class="flex flex-col gap-0.5 text-xs px-2">
                  <li><a href="/stakeholders/investors/announcement" class="block p-2 rounded hover:bg-slate-100 hover:text-[#0B4F9C]">Annual General Meetings</a></li>
                  <li><a href="/stakeholders/investors/more" class="block p-2 rounded hover:bg-slate-100 hover:text-[#0B4F9C]">IPP Project</a></li>
                </ul>
              </div>
            </li>

            <!-- RTI -->
            <li class="relative group">
              <button class="flex items-center gap-1.5 px-3.5 py-3.5 hover:bg-[#084A8F] transition-colors border-b-2 border-transparent group-hover:border-white/60 text-white focus:outline-none focus:bg-[#073A80]" aria-haspopup="true" aria-expanded="false">
                RTI
                <svg class="w-3 h-3 transition-transform duration-200 group-hover:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7"></path></svg>
              </button>
              <div class="absolute left-0 mt-0 hidden group-hover:block group-focus-within:block bg-white text-slate-800 shadow-2xl border-t-4 border-[#0B4F9C] rounded-b-lg z-50 py-2 w-[210px]">
                <ul class="flex flex-col gap-0.5 text-xs px-2">
                  <li><a href="/about-us/explore/rti" class="block p-2 rounded hover:bg-slate-100 hover:text-[#0B4F9C]">RTI Act (Sec 4)</a></li>
                </ul>
              </div>
            </li>

            <!-- Gallery -->
            <li>
              <a href="/media/gallery" class="block px-3.5 py-3.5 text-white hover:bg-[#084A8F] transition-colors border-b-2 border-transparent hover:border-white/60">Gallery</a>
            </li>

            <!-- Downloads -->
            <li>
              <a href="/media/downloads" class="block px-3.5 py-3.5 text-white hover:bg-[#084A8F] transition-colors border-b-2 border-transparent hover:border-white/60">Downloads</a>
            </li>

            <!-- Employees Corner -->
            <li class="relative group">
              <button class="flex items-center gap-1.5 px-3.5 py-3.5 hover:bg-[#084A8F] transition-colors border-b-2 border-transparent group-hover:border-white/60 text-white focus:outline-none focus:bg-[#073A80]" aria-haspopup="true" aria-expanded="false">
                Employees Corner
                <svg class="w-3 h-3 transition-transform duration-200 group-hover:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7"></path></svg>
              </button>
              <div class="absolute right-0 mt-0 hidden group-hover:block group-focus-within:block bg-white text-slate-800 shadow-2xl border-t-4 border-[#0B4F9C] rounded-b-lg z-50 py-2 w-[210px]">
                <ul class="flex flex-col gap-0.5 text-xs px-2">
                  <li><a href="https://mail.nic.in" target="_blank" rel="noopener" class="block p-2 rounded hover:bg-slate-100 hover:text-[#0B4F9C]">Web Mail</a></li>
                  <li><a href="https://eoffice.gov.in" target="_blank" rel="noopener" class="block p-2 rounded hover:bg-slate-100 hover:text-[#0B4F9C]">Nic-e-File</a></li>
                  <li><a href="https://eoffice.gov.in" target="_blank" rel="noopener" class="block p-2 rounded hover:bg-slate-100 hover:text-[#0B4F9C]">E-Office</a></li>
                  <li><a href="#" class="block p-2 rounded hover:bg-slate-100 hover:text-[#0B4F9C]">JKHMRS</a></li>
                  <li><a href="https://gad.jk.gov.in" target="_blank" rel="noopener" class="block p-2 rounded hover:bg-slate-100 hover:text-[#0B4F9C]">Property Return (GAD)</a></li>
                </ul>
              </div>
            </li>

            <!-- Contact Us -->
            <li class="relative group">
              <button class="flex items-center gap-1.5 px-3.5 py-3.5 hover:bg-[#084A8F] transition-colors border-b-2 border-transparent group-hover:border-white/60 text-white focus:outline-none focus:bg-[#073A80]" aria-haspopup="true" aria-expanded="false">
                Contact Us
                <svg class="w-3 h-3 transition-transform duration-200 group-hover:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7"></path></svg>
              </button>
              <div class="absolute right-0 mt-0 hidden group-hover:block group-focus-within:block bg-white text-slate-800 shadow-2xl border-t-4 border-[#0B4F9C] rounded-b-lg z-50 py-2 w-[200px]">
                <ul class="flex flex-col gap-0.5 text-xs px-2">
                  <li><a href="/about-us/others/contact" class="block p-2 rounded hover:bg-slate-100 hover:text-[#0B4F9C]">Contact Us</a></li>
                  <li><a href="/about-us/others/contact#feedback" class="block p-2 rounded hover:bg-slate-100 hover:text-[#0B4F9C]">Feedback</a></li>
                </ul>
              </div>
            </li>
          </ul>

          <!-- Search form in primary header navigation (GIGW/Accessibility standards) -->
          <form action="/search" method="GET" class="flex items-center gap-1 py-2 md:py-0">
            <label for="header-search" class="sr-only">Search portal pages</label>
            <input 
              type="search" 
              name="q" 
              id="header-search" 
              placeholder="Search..." 
              class="bg-white/10 hover:bg-white/20 focus:bg-white text-xs text-white focus:text-slate-900 px-3 py-1.5 rounded border border-white/10 focus:border-white focus:outline-none transition-colors w-36 lg:w-44 placeholder-white/50" 
              required
            />
            <button type="submit" class="p-1.5 bg-[#0B4F9C] hover:bg-[#084A8F] rounded text-xs text-white font-bold flex items-center justify-center border border-white/20" aria-label="Submit Search">
              <Icon name="search" size={14} strokeWidth={2.5} />
            </button>
          </form>
        </div>
      </nav>
    </header>

    <!-- Main Content Container -->
    <main id="main-content" class={isHome ? "flex-grow focus:outline-none" : "flex-grow max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-8 focus:outline-none"} tabindex="-1">
      <slot />
    </main>

    <!-- Footer Section (Professional Dark Slate) -->
    <footer class="bg-[#083B73] text-slate-200 border-t-4 border-[#0B4F9C] pt-14 pb-8 text-sm">
      <div class="max-w-7xl mx-auto px-4">

        <!-- Footer Core Columns -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10 border-b border-slate-700 pb-10 mb-8">

          <!-- Column 1: About Corporate -->
          <div class="flex flex-col gap-4">
            <div class="flex items-center gap-3">
              <div class="bg-white p-1.5 rounded-xl h-14 w-28 flex items-center justify-center shadow-lg border border-slate-300 shrink-0">
                <img src="/logo.png" alt="JKSPDCL logo" class="h-full w-full object-contain" />
              </div>
            </div>
            <p class="text-xs text-slate-300 leading-relaxed">
              JKSPDCL is a wholly owned PSU of the Government of J&K, mandated with harnessing power potential across the region since 1995.
            </p>
            <a href="/about-us/explore/overview" class="text-xs text-[#7FB3E8] hover:text-white font-semibold flex items-center gap-1 mt-1 transition-colors duration-200">
              Read Our History &rarr;
            </a>
          </div>

          <!-- Column 2: Web Policies & Accessibility -->
          <div class="flex flex-col gap-1">
            <h2 class="font-bold text-white uppercase tracking-wider text-xs mb-4 pb-2 border-b border-slate-600">Website Policies</h2>
            <div class="flex flex-col gap-2 text-xs text-slate-300">
              <a href="/policies/privacy" class="hover:text-white hover:translate-x-1 transition-all duration-200 inline-flex items-center gap-1.5">
                <span class="text-slate-500">›</span> Privacy Policy
              </a>
              <a href="/policies/terms" class="hover:text-white hover:translate-x-1 transition-all duration-200 inline-flex items-center gap-1.5">
                <span class="text-slate-500">›</span> Terms & Conditions
              </a>
              <a href="/policies/hyperlinking" class="hover:text-white hover:translate-x-1 transition-all duration-200 inline-flex items-center gap-1.5">
                <span class="text-slate-500">›</span> Hyperlinking Policy
              </a>
              <a href="/policies/accessibility" class="hover:text-white hover:translate-x-1 transition-all duration-200 inline-flex items-center gap-1.5">
                <span class="text-slate-500">›</span> Accessibility Statement
              </a>
              <a href="/sitemap" class="hover:text-white hover:translate-x-1 transition-all duration-200 inline-flex items-center gap-1.5">
                <span class="text-slate-500">›</span> Sitemap
              </a>
              <a href="/help" class="hover:text-white hover:translate-x-1 transition-all duration-200 inline-flex items-center gap-1.5">
