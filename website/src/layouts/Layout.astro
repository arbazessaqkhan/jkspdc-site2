                    <li><a href="/sustainability/environment/policy" class="block p-1.5 rounded hover:bg-slate-100 hover:text-[#003366]">Environment Policy</a></li>
                  </ul>
                </div>
                <div>
                  <h3 class="font-bold text-xs uppercase tracking-wider text-[#003366] border-b border-slate-100 pb-1.5 mb-2">CSR</h3>
                  <ul class="flex flex-col gap-1 text-xs">
                    <li><a href="/sustainability/csr/overview" class="block p-1.5 rounded hover:bg-slate-100 hover:text-[#003366]">Overview</a></li>
                    <li><a href="/sustainability/csr/policy" class="block p-1.5 rounded hover:bg-slate-100 hover:text-[#003366]">CSR Policy</a></li>
                    <li><a href="/sustainability/csr/communication-policy" class="block p-1.5 rounded hover:bg-slate-100 hover:text-[#003366]">CSR Communication</a></li>
                    <li><a href="/sustainability/csr/project-selection" class="block p-1.5 rounded hover:bg-slate-100 hover:text-[#003366]">Project Selection</a></li>
                    <li><a href="/sustainability/csr/guidelines" class="block p-1.5 rounded hover:bg-slate-100 hover:text-[#003366]">Guidelines</a></li>
                    <li><a href="/sustainability/csr/plans" class="block p-1.5 rounded hover:bg-slate-100 hover:text-[#003366]">CSR Plan/Activity</a></li>
                    <li><a href="/sustainability/csr/reports" class="block p-1.5 rounded hover:bg-slate-100 hover:text-[#003366]">Activities Reports</a></li>
