    </script>

    <!-- Mobile Accordion Drawer & Search Drawer Logic -->
    <script is:inline>
      (function() {
        var drawer = document.getElementById('mobile-nav-drawer');
        var backdrop = document.getElementById('mobile-drawer-backdrop');
        var openBtn = document.getElementById('mobile-menu-toggle');
        var closeBtn = document.getElementById('mobile-drawer-close');
        var searchToggle = document.getElementById('mobile-search-toggle');
        var searchPanel = document.getElementById('mobile-search-panel');
        var mobileSearchInput = document.getElementById('mobile-search-input');

        function openDrawer() {
          if (!drawer) return;
          drawer.classList.remove('hidden');
          document.body.classList.add('mobile-drawer-open');
          if (openBtn) openBtn.setAttribute('aria-expanded', 'true');
          if (searchPanel && !searchPanel.classList.contains('hidden')) {
            searchPanel.classList.add('hidden');
            if (searchToggle) searchToggle.setAttribute('aria-expanded', 'false');
          }
          setTimeout(function() { if (closeBtn) closeBtn.focus(); }, 20);
        }

        function closeDrawer() {
          if (!drawer || drawer.classList.contains('hidden')) return;
          drawer.classList.add('hidden');
          document.body.classList.remove('mobile-drawer-open');
          if (openBtn) {
            openBtn.setAttribute('aria-expanded', 'false');
            openBtn.focus();
          }
        }

        if (openBtn) openBtn.addEventListener('click', openDrawer);
        if (closeBtn) closeBtn.addEventListener('click', closeDrawer);
        if (backdrop) backdrop.addEventListener('click', closeDrawer);

        document.querySelectorAll('.mobile-acc-btn').forEach(function(btn) {
          btn.addEventListener('click', function() {
            var group = btn.closest('.mobile-acc-group');
            var panel = group && group.querySelector('.mobile-acc-panel');
            var icon = btn.querySelector('.mobile-acc-icon');
            if (!panel) return;
            var expanded = btn.getAttribute('aria-expanded') === 'true';
            btn.setAttribute('aria-expanded', String(!expanded));
            panel.classList.toggle('hidden', expanded);
            if (icon) icon.classList.toggle('rotate-180', !expanded);
          });
        });

        if (searchToggle && searchPanel) {
          searchToggle.addEventListener('click', function() {
            var isHidden = searchPanel.classList.toggle('hidden');
            searchToggle.setAttribute('aria-expanded', String(!isHidden));
            if (!isHidden && mobileSearchInput) {
              setTimeout(function() { mobileSearchInput.focus(); }, 20);
            }
          });
        }

        document.addEventListener('keydown', function(e) {
          if (e.key === 'Escape') {
            if (drawer && !drawer.classList.contains('hidden')) {
              closeDrawer();
            }
            if (searchPanel && !searchPanel.classList.contains('hidden')) {
              searchPanel.classList.add('hidden');
              if (searchToggle) {
                searchToggle.setAttribute('aria-expanded', 'false');
                searchToggle.focus();
              }
            }
          }
        });
      })();
    </script>

    <!-- Global Search Autocomplete (Shared across Desktop & Mobile Search) -->
    <script is:inline>var API_BASE = window.__API_BASE__;

      (function() {
        var searchIndex = [];
        var loadPromise = null;

        function closeLangDropdowns() {
          ['', '-mob'].forEach(function(s) {
            var langMenu = document.getElementById('lang-dropdown-menu' + s);
            var langArrow = document.getElementById('lang-arrow' + s);
            var langBtn = document.getElementById('lang-dropdown-btn' + s);
            if (langMenu && !langMenu.classList.contains('hidden')) {
              langMenu.classList.add('hidden');
              if (langBtn) langBtn.setAttribute('aria-expanded', 'false');
              if (langArrow) langArrow.classList.remove('rotate-180');
            }
          });
        }

        async function loadIndex() {
          try {
            var sitemapRes = await fetch('/search-index.json');
            if (sitemapRes.ok) {
              var sData = await sitemapRes.json();
              if (Array.isArray(sData)) searchIndex = sData;
            }
          } catch (err) {
            console.error('Failed to load sitemap search index:', err);
          }
          try {
            var projectsRes = await fetch((window.__API_BASE__ || '') + '/api/projects');
            if (projectsRes.ok) {
              var projects = await projectsRes.json();
              if (Array.isArray(projects)) {
                projects.forEach(function(p) {
                  searchIndex.push({
                    title: p.name,
                    url: '/our-business/power-station-details?id=' + p.id,
                    description: 'About ' + p.name + ' - Capacity: ' + p.capacityMw + ' MW, Location: ' + (p.location || 'J&K') + '. Status: ' + p.status + '.'
                  });
                });
              }
            }
          } catch (e) {}
        }

        function bindSearchBox(formId, inputId, boxId) {
          var searchForm = document.getElementById(formId);
          var searchInput = document.getElementById(inputId);
          var suggestionsBox = document.getElementById(boxId);
          if (!searchForm || !searchInput || !suggestionsBox) return;

          function renderSuggestions(query) {
            if (!query) {
              suggestionsBox.innerHTML = '';
              suggestionsBox.classList.add('hidden');
              return;
            }
            var matches = searchIndex.filter(function(item) {
              return (item.title && item.title.toLowerCase().indexOf(query) !== -1) ||
                     (item.description && item.description.toLowerCase().indexOf(query) !== -1);
            }).slice(0, 8);

            if (matches.length > 0) {
              suggestionsBox.innerHTML = matches.map(function(item) {
                var titleRegex = new RegExp('(' + query.replace(/[-\/\\^$*+?.()|[\]{}]/g, '\\$&') + ')', 'gi');
                var highlightedTitle = (item.title || '').replace(titleRegex, '<mark style="background-color: #fef08a; color: #1e293b; font-weight: 700; padding: 0px 2px; border-radius: 2px;">$1</mark>');
                return '<button type="button" class="w-full text-left px-3 py-2 hover:bg-slate-100 transition-colors block cursor-pointer border-b border-slate-100 last:border-0" data-url="' + item.url + '" style="font-size: 12px; text-align: left;">' +
                       '<span style="color: #0B3B60; font-weight: 700; display: block;">' + highlightedTitle + '</span>' +
                       '<span style="font-size: 10.5px; color: #64748b; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; display: block; margin-top: 2px;">' + (item.description || '') + '</span>' +
                       '</button>';
              }).join('');
              suggestionsBox.classList.remove('hidden');
            } else {
              suggestionsBox.innerHTML = '';
              suggestionsBox.classList.add('hidden');
            }
          }

          function handleInput() {
            var query = searchInput.value.toLowerCase().trim();
            if (!query) {
              suggestionsBox.innerHTML = '';
              suggestionsBox.classList.add('hidden');
              return;
            }
            if (searchIndex.length === 0) {
              if (!loadPromise) loadPromise = loadIndex();
              loadPromise.then(function() { renderSuggestions(query); });
            } else {
              renderSuggestions(query);
            }
          }

          searchInput.addEventListener('focus', function() {
            closeLangDropdowns();
            if (searchInput.value.trim()) handleInput();
          });

          searchInput.addEventListener('input', function() {
            closeLangDropdowns();
            handleInput();
          });

          suggestionsBox.addEventListener('click', function(e) {
            var btn = e.target.closest('button');
            if (btn && btn.dataset.url) window.location.href = btn.dataset.url;
          });

          document.addEventListener('click', function(e) {
            if (!e.target.closest('#' + formId) && !e.target.closest('#' + boxId)) {
              suggestionsBox.classList.add('hidden');
            }
          });

          document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape') suggestionsBox.classList.add('hidden');
          });

          searchForm.addEventListener('submit', function(e) {
            e.preventDefault();
            var query = searchInput.value.trim();
            if (!query) return;
            var lowerQuery = query.toLowerCase();
            var bestMatch = null;
            for (var i = 0; i < searchIndex.length; i++) {
              if (searchIndex[i].title && searchIndex[i].title.toLowerCase() === lowerQuery) {
                bestMatch = searchIndex[i];
                break;
              }
            }
            if (!bestMatch) {
              for (var i = 0; i < searchIndex.length; i++) {
                if (searchIndex[i].title && searchIndex[i].title.toLowerCase().indexOf(lowerQuery) !== -1) {
                  bestMatch = searchIndex[i];
                  break;
                }
              }
            }
            window.location.href = bestMatch ? bestMatch.url : ('/search?q=' + encodeURIComponent(query));
          });
        }

        loadPromise = loadIndex();
        bindSearchBox('header-search-form', 'header-search', 'header-search-suggestions');
        bindSearchBox('mobile-search-form', 'mobile-search-input', 'mobile-search-suggestions');
      })();
    </script>

    <!-- Global Document Link Target Handler (Ensures all document/upload links open in a new blank tab) -->
    <script is:inline>
      document.addEventListener('click', function(e) {
        var anchor = e.target.closest('a');
        if (!anchor) return;
        var href = anchor.getAttribute('href');
        if (!href) return;
        var isDoc = href.indexOf('/uploads/') !== -1 || 
                    /\.(pdf|docx?|xlsx?|pptx?|zip|rar|csv)$/i.test(href) ||
                    (href.indexOf('http') === 0 && href.indexOf('/uploads/') !== -1);
        if (isDoc) {
          anchor.setAttribute('target', '_blank');
          anchor.setAttribute('rel', 'noopener noreferrer');
        }
      }, true);
    </script>
  </body>
</html>
