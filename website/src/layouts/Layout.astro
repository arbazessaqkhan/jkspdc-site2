---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon.astro';
import Ticker from '../components/Ticker.astro';

interface Props {
  title: string;
  description: string;
  canonicalUrl?: string;
  isHome?: boolean;
}

const { title, description, canonicalUrl, isHome = false } = Astro.props;
const canonical = canonicalUrl || Astro.url.href;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | JKSPDC Official Portal</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    
    <!-- GIGW SEO & Browser Compatibility -->
    <meta name="robots" content="index, follow" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <link rel="icon" type="image/png" href="/logo.png" />
    <!-- Google Fonts: Noto Sans (Regular 400, Medium 500, Semi Bold 600, Bold 700) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans:ital,wght@0,400;0,500;0,600;0,700;0,800;1,400;1,500;1,600;1,700&family=Noto+Sans+Devanagari:wght@400;500;600;700&display=swap" rel="stylesheet" />
    
    <!-- Custom Translation Utility -->
    <script src="/js/translation.js" is:inline></script>

    <!-- Custom styling for high contrast mode & animations -->
    <style is:global>
      .high-contrast,
      .high-contrast * {
        background-color: #000000 !important;
        background-image: none !important;
        color: #ffff00 !important;
        border-color: #ffff00 !important;
        box-shadow: none !important;
      }
      .high-contrast a,
      .high-contrast button {
        color: #ffff00 !important;
        text-decoration: underline !important;
      }
      .high-contrast a:hover,
      .high-contrast button:hover {
        background-color: #333333 !important;
        color: #ffffff !important;
      }

      /* ── Ticker scroll animation ───────────────────────────────── */
      @keyframes ticker-scroll {
        0%   { transform: translateX(0); }
        100% { transform: translateX(-50%); }
      }
      .animate-ticker {
        display: flex;
        white-space: nowrap;
        animation: ticker-scroll 35s linear infinite;
        will-change: transform;
      }
      .animate-ticker:hover {
        animation-play-state: paused;
      }

      /* ── Slow pulse for status dots ────────────────────────────── */
      @keyframes slow-pulse {
        0%, 100% { opacity: 1; }
        50%       { opacity: 0.35; }
      }
      .animate-slow-pulse {
        animation: slow-pulse 2.5s ease-in-out infinite;
      }

      /* ── Hide Bhashini default widget elements ── */
      #bhashini-translation,
      .bhashini-feedback-modal,
      .bhashini-feedback-div,
      .bhashini-toast {
        display: none !important;
      }
    </style>

    <!-- GIGW Accessibility & Preference persistence scripts -->
    <script is:inline>
      function adjustFontSize(action) {
        var html = document.documentElement;
        var cur = parseFloat(window.getComputedStyle(html).fontSize) || 16;
        var nextSize = cur;
        if (action === 'inc') {
          if (cur < 24) nextSize = cur + 1;
        } else if (action === 'dec') {
          if (cur > 12) nextSize = cur - 1;
        } else {
          nextSize = 16;
        }
        var sizeStr = nextSize + 'px';
        html.style.fontSize = sizeStr;
        try {
          localStorage.setItem('preferred-font-size', sizeStr);
        } catch (e) {}
      }

      function toggleHighContrast() {
        var html = document.documentElement;
        var isDark = html.classList.toggle('high-contrast');
        try {
          localStorage.setItem('high-contrast', isDark ? 'true' : 'false');
        } catch (e) {}
      }

      function changeLanguage(langCode) {
        try {
          localStorage.setItem('preferredLanguage', langCode);
          window.location.reload();
        } catch (e) {}
      }

      function toggleLangDropdown(event) {
        if (event) event.stopPropagation();
        var menu = document.getElementById('lang-dropdown-menu');
        var btn = document.getElementById('lang-dropdown-btn');
        var arrow = document.getElementById('lang-arrow');
        if (!menu) return;
        
        var isHidden = menu.classList.toggle('hidden');
        if (btn) btn.setAttribute('aria-expanded', !isHidden);
        if (arrow) {
          if (isHidden) {
            arrow.classList.remove('rotate-180');
          } else {
            arrow.classList.add('rotate-180');
          }
        }
      }

      (function() {
        try {
          var savedSize = localStorage.getItem('preferred-font-size');
          if (savedSize) {
            document.documentElement.style.fontSize = savedSize;
          }
          var savedContrast = localStorage.getItem('high-contrast');
          if (savedContrast === 'true') {
            document.documentElement.classList.add('high-contrast');
          }
          
          var preferredLang = localStorage.getItem('preferredLanguage') || 'en';
          var labels = {
            'en': 'English',
            'hi': 'हिन्दी',
            'ur': 'اردو',
            'ks': 'کٲشُر',
            'doi': 'डोगरी'
          };
          var labelText = labels[preferredLang] || 'English';
          
          document.addEventListener('DOMContentLoaded', function() {
            var labelEl = document.getElementById('current-lang-label');
            if (labelEl) labelEl.textContent = labelText;
            
            var btn = document.getElementById('lang-dropdown-btn');
            if (btn) {
              btn.addEventListener('click', toggleLangDropdown);
            }
            
            window.addEventListener('click', function(e) {
              var menu = document.getElementById('lang-dropdown-menu');
              var btn = document.getElementById('lang-dropdown-btn');
              var arrow = document.getElementById('lang-arrow');
              if (menu && !menu.classList.contains('hidden')) {
                if (btn && !btn.contains(e.target) && !menu.contains(e.target)) {
                  menu.classList.add('hidden');
                  btn.setAttribute('aria-expanded', 'false');
                  if (arrow) arrow.classList.remove('rotate-180');
                }
              }
            });
          });
        } catch (e) {}
      })();
    </script>
  </head>
  <body class="min-h-screen flex flex-col bg-slate-50 text-slate-800 font-sans transition-colors duration-150">
    
    <!-- Skip to Main Content Link (GIGW Mandatory) -->
    <a href="#main-content" class="skip-link">Skip to Main Content</a>

    <!-- Composite Header Component -->

    <header class="bg-[#EAF4FF] border-b-2 border-[#0B4F9C] shadow-sm">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-2.5 flex items-center justify-between">
        <!-- Left Logo -->
        <a href="/" class="flex-shrink-0 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#0B4F9C] rounded p-1 lg:-ml-[22px]" aria-label="JKSPDCL Home">
          <img src="/logo.png" alt="JKSPDCL Logo" class="h-12 w-auto object-contain" />
        </a>

        <!-- Centered Organization Name -->
        <div class="flex-1 text-center px-4">
          <h1 class="text-base md:text-xl font-bold text-[#0B4F9C] leading-tight">
            Jammu &amp; Kashmir State Power Development Corporation Limited
          </h1>
          <p class="text-xs md:text-sm font-bold text-[#0B4F9C] mt-0.5">(JKSPDCL)</p>
          <p class="text-xs text-[#0B4F9C] font-semibold mt-0.5" lang="hi">
            जम्मू और कश्मीर राज्य विद्युत विकास निगम लिमिटेड (जेकेएसपीडीसीएल)
          </p>
        </div>

        <!-- Right Accessibility Controls & Search Bar -->
        <div class="flex flex-col items-end gap-2 flex-shrink-0">
          <!-- Accessibility Controls -->
          <div class="flex items-center gap-2.5 text-xs text-slate-700 select-none">
            <!-- Font Sizing -->
            <div class="flex items-center gap-1" aria-label="Font Size Controls" role="group">
              <button class="flex items-center gap-1 px-2 py-0.5 bg-white hover:bg-slate-100 border border-slate-300 rounded text-xs font-bold text-slate-700 transition-colors cursor-pointer" onclick="adjustFontSize('dec')" aria-label="Decrease Font Size" title="Decrease Font Size">
                <Icon name="minus" size={9} strokeWidth={2.5} /> A
              </button>
              <button class="flex items-center px-2.5 py-0.5 bg-white hover:bg-slate-100 border border-slate-300 rounded text-xs font-bold text-slate-700 transition-colors cursor-pointer" onclick="adjustFontSize('reset')" aria-label="Reset Font Size" title="Reset Font Size">A</button>
              <button class="flex items-center gap-1 px-2 py-0.5 bg-white hover:bg-slate-100 border border-slate-300 rounded text-xs font-bold text-slate-700 transition-colors cursor-pointer" onclick="adjustFontSize('inc')" aria-label="Increase Font Size" title="Increase Font Size">
                <Icon name="plus" size={9} strokeWidth={2.5} /> A
              </button>
            </div>
            <span class="text-slate-300">|</span>
            <!-- Contrast Switcher -->
            <button class="flex items-center gap-1.5 px-2.5 py-0.5 bg-white hover:bg-slate-100 border border-slate-300 rounded text-xs font-bold text-slate-700 transition-colors cursor-pointer" onclick="toggleHighContrast()" aria-label="Toggle High Contrast Mode">
              <Icon name="contrast" size={11} strokeWidth={2.5} /> Contrast
            </button>
            <span class="text-slate-300">|</span>
            <!-- Custom Language Selector Dropdown -->
            <div class="relative inline-block text-left select-none dont-translate z-[9999]" id="custom-language-selector">
              <button
                id="lang-dropdown-btn"
                type="button"
                class="flex items-center gap-1 px-2.5 py-0.5 bg-white hover:bg-slate-100 border border-slate-300 rounded text-xs font-bold text-slate-700 transition-colors cursor-pointer focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-slate-400"
                aria-expanded="false"
                aria-haspopup="true"
              >
                <Icon name="globe" size={11} strokeWidth={2.5} />
                <span id="current-lang-label">English</span>
                <svg class="w-3 h-3 ml-0.5 transition-transform duration-200" id="lang-arrow" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7"></path>
                </svg>
              </button>
              
              <div
                id="lang-dropdown-menu"
                class="absolute right-0 mt-1 w-36 bg-white text-slate-800 rounded shadow-xl border border-slate-200/85 hidden z-[9999] py-1 text-left"
                role="menu"
                aria-orientation="vertical"
                aria-labelledby="lang-dropdown-btn"
              >
                <button class="w-full text-left px-3 py-1.5 text-xs hover:bg-slate-100 font-semibold transition-colors block cursor-pointer" role="menuitem" onclick="changeLanguage('en')">English</button>
                <button class="w-full text-left px-3 py-1.5 text-xs hover:bg-slate-100 font-semibold transition-colors block cursor-pointer" role="menuitem" onclick="changeLanguage('hi')">हिन्दी (Hindi)</button>
                <button class="w-full text-left px-3 py-1.5 text-xs hover:bg-slate-100 font-semibold transition-colors block cursor-pointer" role="menuitem" onclick="changeLanguage('ur')">اردو (Urdu)</button>
                <button class="w-full text-left px-3 py-1.5 text-xs hover:bg-slate-100 font-semibold transition-colors block cursor-pointer" role="menuitem" onclick="changeLanguage('ks')">کٲشُر (Kashmiri)</button>
                <button class="w-full text-left px-3 py-1.5 text-xs hover:bg-slate-100 font-semibold transition-colors block cursor-pointer" role="menuitem" onclick="changeLanguage('doi')">डोगरी (Dogri)</button>
              </div>
            </div>
          </div>

          <!-- Search Form -->
          <form action="/search" method="GET" class="flex items-center w-full justify-end relative" id="header-search-form" autocomplete="off">
            <div class="relative flex items-center">
              <label for="header-search" class="sr-only">Search portal pages</label>
              <input 
                type="search" 
                name="q" 
                id="header-search" 
                placeholder="Search…" 
                class="bg-white hover:bg-slate-50 focus-visible:bg-white text-xs text-slate-850 focus-visible:text-slate-900 px-3 py-2 rounded-l-md border border-slate-300 border-r-0 focus-visible:border-[#0B4F9C] focus-visible:outline-none transition-[background-color,border-color,color] duration-150 w-36 lg:w-44 placeholder-slate-400 shadow-sm" 
                required
              />
              <!-- Suggestions Dropdown Container -->
              <div id="header-search-suggestions" class="absolute left-0 right-0 top-full mt-1 bg-white text-slate-850 border border-slate-200 rounded-md shadow-xl hidden z-[9999] max-h-60 overflow-y-auto text-left py-1 w-full lg:w-48">
              </div>
            </div>
            <button type="submit" class="p-2 bg-[#1a5276] hover:bg-[#084A8F] rounded-r-md text-xs text-white font-bold flex items-center justify-center border border-transparent transition-[background-color,border-color] duration-150 shadow-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#0B4F9C]/50 cursor-pointer" aria-label="Submit Search">
              <Icon name="search" size={14} strokeWidth={2.5} />
            </button>
          </form>
        </div>
      </div>

      <!-- Live News Ticker Bar (Placed between organization heading and navigation menu bar) -->
      <Ticker />

      <!-- Navigation Bar (With CSS and Keyboard Accessible Dropdowns) -->
      <nav class="bg-gradient-to-r from-[#073B75] via-[#0B4F9C] to-[#042750] border-t border-white/10 shadow-md relative" aria-label="Primary Navigation">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col md:flex-row justify-between items-center gap-4">
          <ul class="flex flex-wrap w-full justify-between text-sm font-semibold">
            <!-- Home -->
            <li>
              <a href="/" class="block px-3.5 py-3.5 text-white hover:bg-white/10 transition-all duration-200 border-b-2 border-transparent hover:border-white/60 focus-visible:outline-none focus-visible:bg-white/15">
                Home
              </a>
            </li>

            <!-- About Us -->
            <li class="relative group">
              <button class="flex items-center gap-1.5 px-3.5 py-3.5 hover:bg-[#084A8F] transition-[background-color,border-color] duration-150 border-b-2 border-transparent group-hover:border-white/60 text-white focus-visible:outline-none focus-visible:bg-[#073A80]" aria-haspopup="true" aria-expanded="false">
                About Us
                <svg class="w-3 h-3 transition-transform duration-200 group-hover:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7"></path></svg>
              </button>
              <div class="absolute left-0 mt-0 hidden group-hover:block group-focus-within:block bg-white text-slate-800 shadow-2xl border-t-4 border-[#0B4F9C] rounded-b-lg z-50 py-2 w-[260px]">
                <ul class="flex flex-col gap-0.5 text-xs px-2">
                  <li><a href="/about-us/explore/overview" class="block p-2 rounded hover:bg-slate-100 hover:text-[#0B4F9C]">About Us</a></li>
                  <li><a href="/about-us/explore/association-memorandum" class="block p-2 rounded hover:bg-slate-100 hover:text-[#0B4F9C]">MoA &amp; AoA</a></li>
                  <li><a href="/about-us/explore/organization-chart" class="block p-2 rounded hover:bg-slate-100 hover:text-[#0B4F9C]">Organizational Structure</a></li>
                  <li><a href="/about-us/management/board" class="block p-2 rounded hover:bg-slate-100 hover:text-[#0B4F9C]">Board Of Director</a></li>
                  <li><a href="/about-us/explore/gstin-registration" class="block p-2 rounded hover:bg-slate-100 hover:text-[#0B4F9C]">GSTIN Registration Details</a></li>
                  <li><a href="/about-us/explore/policies" class="block p-2 rounded hover:bg-slate-100 hover:text-[#0B4F9C]">Policies</a></li>
                  <li><a href="/sustainability/csr/overview" class="block p-2 rounded hover:bg-slate-100 hover:text-[#0B4F9C]">CSR</a></li>
                </ul>
              </div>
            </li>

            <!-- Projects -->
            <li class="relative group">
              <button class="flex items-center gap-1.5 px-3.5 py-3.5 hover:bg-[#084A8F] transition-[background-color,border-color] duration-150 border-b-2 border-transparent group-hover:border-white/60 text-white focus-visible:outline-none focus-visible:bg-[#073A80]" aria-haspopup="true" aria-expanded="false">
                Projects
                <svg class="w-3 h-3 transition-transform duration-200 group-hover:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7"></path></svg>
              </button>
              <div class="absolute left-0 mt-0 hidden group-hover:block group-focus-within:block bg-white text-slate-800 shadow-2xl border-t-4 border-[#0B4F9C] rounded-b-lg z-50 py-2 w-[240px]">
                <ul class="flex flex-col gap-0.5 text-xs px-2">
                  <li><a href="/our-business/power-stations" class="block p-2 rounded hover:bg-slate-100 hover:text-[#0B4F9C]">Operational Projects</a></li>
                  <li><a href="/our-business/construction" class="block p-2 rounded hover:bg-slate-100 hover:text-[#0B4F9C]">Projects Under Construction</a></li>
                  <li><a href="/our-business/under-development" class="block p-2 rounded hover:bg-slate-100 hover:text-[#0B4F9C]">Upcoming Projects</a></li>
                </ul>
              </div>
            </li>

            <!-- Tenders -->
            <li class="relative group">
              <button class="flex items-center gap-1.5 px-3.5 py-3.5 hover:bg-[#084A8F] transition-[background-color,border-color] duration-150 border-b-2 border-transparent group-hover:border-white/60 text-white focus-visible:outline-none focus-visible:bg-[#073A80]" aria-haspopup="true" aria-expanded="false">
                Tenders
                <svg class="w-3 h-3 transition-transform duration-200 group-hover:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7"></path></svg>
              </button>
              <div class="absolute left-0 mt-0 hidden group-hover:block group-focus-within:block bg-white text-slate-800 shadow-2xl border-t-4 border-[#0B4F9C] rounded-b-lg z-50 py-2 w-[250px]">
                <ul class="flex flex-col gap-0.5 text-xs px-2">
                  <li><a href="/stakeholders/vendors/tender-bids#live" class="block p-2 rounded hover:bg-slate-100 hover:text-[#0B4F9C]">Live Tenders &amp; Notices</a></li>
                  <li><a href="/stakeholders/vendors/tender-bids#amendments" class="block p-2 rounded hover:bg-slate-100 hover:text-[#0B4F9C]">Amendments &amp; Clarifications</a></li>
                  <li><a href="/stakeholders/vendors/tender-bids#awards" class="block p-2 rounded hover:bg-slate-100 hover:text-[#0B4F9C]">Awards &amp; Compliance</a></li>
                  <li><a href="/stakeholders/vendors/tender-bids#portals" class="block p-2 rounded hover:bg-slate-100 hover:text-[#0B4F9C]">Access &amp; Portals</a></li>
                  <li><a href="https://jktenders.gov.in/nicgep/app" target="_blank" rel="noopener" class="block p-2 rounded hover:bg-slate-100 hover:text-[#0B4F9C]">JK Tenders</a></li>
                </ul>
              </div>
            </li>

            <!-- Notifications -->
            <li>
              <a href="/stakeholders/investors/announcement" class="block px-3.5 py-3.5 text-white hover:bg-[#084A8F] transition-colors border-b-2 border-transparent hover:border-white/60">Notifications</a>
            </li>

            <!-- Investors Corner -->
            <li class="relative group">
              <button class="flex items-center gap-1.5 px-3.5 py-3.5 hover:bg-[#084A8F] transition-[background-color,border-color] duration-150 border-b-2 border-transparent group-hover:border-white/60 text-white focus-visible:outline-none focus-visible:bg-[#073A80]" aria-haspopup="true" aria-expanded="false">
                Investors Corner
                <svg class="w-3 h-3 transition-transform duration-200 group-hover:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7"></path></svg>
              </button>
              <div class="absolute left-0 mt-0 hidden group-hover:block group-focus-within:block bg-white text-slate-800 shadow-2xl border-t-4 border-[#0B4F9C] rounded-b-lg z-50 py-2 w-[230px]">
                <ul class="flex flex-col gap-0.5 text-xs px-2">
                  <li><a href="/stakeholders/investors/announcement" class="block p-2 rounded hover:bg-slate-100 hover:text-[#0B4F9C]">Annual General Meetings</a></li>
                  <li><a href="/stakeholders/investors/ipp-projects" class="block p-2 rounded hover:bg-slate-100 hover:text-[#0B4F9C]">IPP Projects</a></li>
                </ul>
              </div>
            </li>

            <!-- RTI -->
            <li class="relative group">
              <button class="flex items-center gap-1.5 px-3.5 py-3.5 hover:bg-[#084A8F] transition-[background-color,border-color] duration-150 border-b-2 border-transparent group-hover:border-white/60 text-white focus-visible:outline-none focus-visible:bg-[#073A80]" aria-haspopup="true" aria-expanded="false">
                RTI
                <svg class="w-3 h-3 transition-transform duration-200 group-hover:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7"></path></svg>
              </button>
              <div class="absolute left-0 mt-0 hidden group-hover:block group-focus-within:block bg-white text-slate-800 shadow-2xl border-t-4 border-[#0B4F9C] rounded-b-lg z-50 py-2 w-[210px]">
                <ul class="flex flex-col gap-0.5 text-xs px-2">
                  <li><a href="/about-us/explore/rti" class="block p-2 rounded hover:bg-slate-100 hover:text-[#0B4F9C]">RTI Act (Sec 4)</a></li>
                </ul>
              </div>
            </li>

            <!-- Gallery -->
            <li>
              <a href="/media/gallery" class="block px-3.5 py-3.5 text-white hover:bg-[#084A8F] transition-colors border-b-2 border-transparent hover:border-white/60">Gallery</a>
            </li>

            <!-- Downloads -->
            <li>
              <a href="/media/downloads" class="block px-3.5 py-3.5 text-white hover:bg-[#084A8F] transition-colors border-b-2 border-transparent hover:border-white/60">Downloads</a>
            </li>

            <!-- Employees Corner -->
            <li class="relative group">
              <button class="flex items-center gap-1.5 px-3.5 py-3.5 hover:bg-[#084A8F] transition-[background-color,border-color] duration-150 border-b-2 border-transparent group-hover:border-white/60 text-white focus-visible:outline-none focus-visible:bg-[#073A80]" aria-haspopup="true" aria-expanded="false">
                Employees Corner
                <svg class="w-3 h-3 transition-transform duration-200 group-hover:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7"></path></svg>
              </button>
              <div class="absolute right-0 mt-0 hidden group-hover:block group-focus-within:block bg-white text-slate-800 shadow-2xl border-t-4 border-[#0B4F9C] rounded-b-lg z-50 py-2 w-[220px]">
                <ul class="flex flex-col gap-0.5 text-xs px-2">
                  <li><a href="https://www.jkspdcl.com:2096/" target="_blank" rel="noopener" class="block p-2 rounded hover:bg-slate-100 hover:text-[#0B4F9C]">Web Mail</a></li>
