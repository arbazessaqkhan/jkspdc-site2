            </li>
          </ul>
        </div>
      </nav>

    <!-- Main Content Container -->
    <main id="main-content" class={isHome ? "flex-grow focus:outline-none" : "flex-grow max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-8 focus:outline-none"} tabindex="-1">
      <slot />
    </main>

    <Footer />



    <!-- Floating Scroll to Top Button -->
    <button
      id="scroll-to-top-btn"
      class="fixed bottom-8 right-8 z-50 bg-[#0B3B60] hover:bg-[#0EA4E5] text-white w-12 h-12 rounded-full shadow-2xl flex items-center justify-center transition-all duration-300 opacity-0 pointer-events-none focus:outline-none focus:ring-2 focus:ring-[#BDD7EE] border-2 border-white/20 hover:scale-110"
      aria-label="Scroll to top of page"
    >
      <Icon name="arrow-up" size={20} strokeWidth={2.5} />
    </button>

    <!-- Scroll to Top Script -->
    <script is:inline>
      (function () {
        var btn = document.getElementById('scroll-to-top-btn');
        if (!btn) return;
        function onScroll() {
          if (window.scrollY > 300) {
            btn.style.opacity = '1';
            btn.style.pointerEvents = 'auto';
          } else {
            btn.style.opacity = '0';
            btn.style.pointerEvents = 'none';
          }
        }
        window.addEventListener('scroll', onScroll, { passive: true });
        btn.addEventListener('click', function () {
          window.scrollTo({ top: 0, behavior: 'smooth' });
        });
      })();
    </script>

    <!-- Dropdown positioning helper -->
    <script is:inline>
      (function() {
        function adjustDropdownPosition(li) {
          var dropdown = li.querySelector('div.absolute');
          if (!dropdown) return;
          dropdown.style.left = '';
          dropdown.style.right = '';
          var rect = dropdown.getBoundingClientRect();
          var viewportWidth = window.innerWidth;
          if (rect.right > viewportWidth) {
            dropdown.style.right = '0';
            dropdown.style.left = 'auto';
          } else if (rect.left < 0) {
            dropdown.style.left = '0';
            dropdown.style.right = 'auto';
          }
        }

        document.querySelectorAll('nav li.relative.group').forEach(function(li) {
          li.addEventListener('mouseenter', function() {
            adjustDropdownPosition(li);
          });
          li.addEventListener('focusin', function() {
            adjustDropdownPosition(li);
          });
        });
      })();
    </script>

    <!-- Active Nav Indicator (GIGW 3.0 Requirement) -->
    <script is:inline>
      (function() {
        function updateActiveNav() {
          var path = window.location.pathname.replace(/\/$/, '') || '/';

          // Reset all inline borders
          document.querySelectorAll('nav .nav-link, nav .nav-dropdown-btn').forEach(function(el) {
            el.style.borderBottomColor = '';
            el.style.borderBottomWidth = '';
            el.style.borderBottomStyle = '';
          });

          // Match section rules
          var activeSection = '';
          if (path === '/') {
            activeSection = 'home';
          } else if (path.includes('/rti')) {
            activeSection = 'rti';
          } else if (path.includes('/contact') || path === '/feedback') {
            activeSection = 'contact';
          } else if (path.startsWith('/about-us') || path.startsWith('/sustainability/csr')) {
            activeSection = 'about';
          } else if (path.startsWith('/our-business') || path.startsWith('/power-trading')) {
            activeSection = 'projects';
          } else if (path.startsWith('/stakeholders/vendors') || path.startsWith('/tenders')) {
            activeSection = 'tenders';
          } else if (path.startsWith('/notifications')) {
            activeSection = 'notifications';
          } else if (path.startsWith('/stakeholders/investors')) {
            activeSection = 'investors';
          } else if (path.startsWith('/media/gallery')) {
            activeSection = 'gallery';
          } else if (path.startsWith('/media/downloads')) {
            activeSection = 'downloads';
          } else if (path.startsWith('/employees')) {
            activeSection = 'employees';
          }

          var items = [
            { key: 'home', selector: 'nav a[href="/"]' },
            { key: 'about', selector: 'nav li:nth-child(2) > .nav-dropdown-btn' },
            { key: 'projects', selector: 'nav li:nth-child(3) > .nav-dropdown-btn' },
            { key: 'tenders', selector: 'nav li:nth-child(4) > .nav-dropdown-btn' },
            { key: 'notifications', selector: 'nav a[href="/notifications"]' },
            { key: 'investors', selector: 'nav li:nth-child(6) > .nav-dropdown-btn' },
            { key: 'rti', selector: 'nav li:nth-child(7) > .nav-dropdown-btn' },
            { key: 'gallery', selector: 'nav a[href="/media/gallery"]' },
            { key: 'downloads', selector: 'nav a[href="/media/downloads"]' },
            { key: 'employees', selector: 'nav li:nth-child(10) > .nav-dropdown-btn' },
            { key: 'contact', selector: 'nav li:nth-child(11) > .nav-dropdown-btn' }
          ];

          items.forEach(function(item) {
            var el = document.querySelector(item.selector);
            if (!el) return;
            if (item.key === activeSection) {
              el.classList.add('nav-item-active');
              el.style.borderBottomColor = '#0B3B60';
              el.style.borderBottomWidth = '3px';
              el.style.borderBottomStyle = 'solid';
            } else {
              el.classList.remove('nav-item-active');
              el.style.borderBottomColor = 'transparent';
            }
          });

          // Highlight matching sublink in dropdowns
          document.querySelectorAll('nav .nav-dropdown-menu a[href]').forEach(function(sublink) {
            var href = (sublink.getAttribute('href') || '').replace(/\/$/, '');
            if (href && (path === href || path.startsWith(href + '/') || path.startsWith(href + '?'))) {
              sublink.classList.add('nav-sublink-active');
            } else {
              sublink.classList.remove('nav-sublink-active');
            }
          });
        }

        updateActiveNav();
        window.addEventListener('popstate', updateActiveNav);
      })();
    </script>

    <!-- Global Header Search Autocomplete -->
    <script is:inline>var API_BASE = window.__API_BASE__;

      (function() {
        var searchForm = document.getElementById('header-search-form');
        var searchInput = document.getElementById('header-search');
        var suggestionsBox = document.getElementById('header-search-suggestions');
        var searchIndex = [];
        var loadPromise = null;

        function closeLangDropdown() {
          var langMenu = document.getElementById('lang-dropdown-menu');
          var langArrow = document.getElementById('lang-arrow');
          var langBtn = document.getElementById('lang-dropdown-btn');
          if (langMenu && !langMenu.classList.contains('hidden')) {
            langMenu.classList.add('hidden');
            if (langBtn) langBtn.setAttribute('aria-expanded', 'false');
            if (langArrow) langArrow.classList.remove('rotate-180');
          }
        }

        async function loadIndex() {
          try {
            var sitemapRes = await fetch('/search-index.json');
            if (sitemapRes.ok) {
              searchIndex = await sitemapRes.json();
            }
          } catch(err) {
            console.error('Failed to load sitemap search index:', err);
          }
          try {
            var projectsRes = await fetch('window.__API_BASE__/api/projects');
            if (projectsRes.ok) {
              var projects = await projectsRes.json();
              projects.forEach(function(p) {
                searchIndex.push({
                  title: p.name,
                  url: '/our-business/power-station-details?id=' + p.id,
                  description: 'About ' + p.name + ' - Capacity: ' + p.capacityMw + ' MW, Location: ' + (p.location || 'J&K') + '. Status: ' + p.status + '.'
                });
              });
            }
          } catch(e) {
            // Ignore optional project lookup error
          }
        }

        function renderSuggestions(query) {
          if (!query) {
            suggestionsBox.innerHTML = '';
            suggestionsBox.classList.add('hidden');
            return;
          }

          var matches = searchIndex.filter(function(item) {
            return (item.title && item.title.toLowerCase().indexOf(query) !== -1) ||
                   (item.description && item.description.toLowerCase().indexOf(query) !== -1);
          }).slice(0, 8);

          if (matches.length > 0) {
            suggestionsBox.innerHTML = matches.map(function(item) {
              var titleRegex = new RegExp('(' + query.replace(/[-\/\\^$*+?.()|[\]{}]/g, '\\$&') + ')', 'gi');
              var highlightedTitle = (item.title || '').replace(titleRegex, '<mark style="background-color: #fef08a; color: #1e293b; font-weight: 700; padding: 0px 2px; border-radius: 2px;">$1</mark>');
              return '<button type="button" class="w-full text-left px-3 py-1.5 hover:bg-slate-100 transition-colors block cursor-pointer border-b border-slate-50 last:border-0" data-url="' + item.url + '" style="font-size: 11px; outline: none; border-bottom: 1px solid #f1f5f9; display: block; background: transparent; border-left: 0; border-right: 0; border-top: 0; font-family: inherit; margin: 0; padding: 6px 12px; width: 100%; text-align: left;">' +
                     '<span style="color: #0B3B60; font-weight: 700; display: block;">' + highlightedTitle + '</span>' +
                     '<span style="font-size: 9.5px; color: #64748b; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; display: block; margin-top: 2px;">' + (item.description || '') + '</span>' +
                     '</button>';
            }).join('');
            suggestionsBox.classList.remove('hidden');
          } else {
            suggestionsBox.innerHTML = '';
            suggestionsBox.classList.add('hidden');
          }
        }

        function handleInput() {
          var query = searchInput.value.toLowerCase().trim();
          if (!query) {
            suggestionsBox.innerHTML = '';
            suggestionsBox.classList.add('hidden');
            return;
          }

          if (searchIndex.length === 0) {
            if (!loadPromise) loadPromise = loadIndex();
            loadPromise.then(function() {
              renderSuggestions(query);
            });
          } else {
            renderSuggestions(query);
          }
        }

        if (searchInput && searchForm && suggestionsBox) {
          // Preload index immediately
          loadPromise = loadIndex();

          searchInput.addEventListener('focus', function() {
            closeLangDropdown();
            if (searchInput.value.trim()) {
              handleInput();
            }
          });

          searchInput.addEventListener('input', function() {
            closeLangDropdown();
            handleInput();
          });

          suggestionsBox.addEventListener('click', function(e) {
            var btn = e.target.closest('button');
            if (btn && btn.dataset.url) {
              window.location.href = btn.dataset.url;
            }
          });

          document.addEventListener('click', function(e) {
            if (!e.target.closest('#header-search-form')) {
              suggestionsBox.classList.add('hidden');
            }
          });

          document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape') {
              suggestionsBox.classList.add('hidden');
            }
          });

          searchForm.addEventListener('submit', function(e) {
            e.preventDefault();
            var query = searchInput.value.trim();
            if (!query) return;

            var lowerQuery = query.toLowerCase();
            var bestMatch = null;
            
            for (var i = 0; i < searchIndex.length; i++) {
              if (searchIndex[i].title && searchIndex[i].title.toLowerCase() === lowerQuery) {
                bestMatch = searchIndex[i];
                break;
              }
            }
            
            if (!bestMatch) {
              for (var i = 0; i < searchIndex.length; i++) {
                if (searchIndex[i].title && searchIndex[i].title.toLowerCase().indexOf(lowerQuery) !== -1) {
                  bestMatch = searchIndex[i];
                  break;
                }
              }
            }

            if (bestMatch) {
              window.location.href = bestMatch.url;
            } else {
              window.location.href = '/search?q=' + encodeURIComponent(query);
            }
          });
        }
      })();
    </script>

    <!-- Header Ticker Smooth Continuous Horizontal Motion Script -->
    <script is:inline>
      (function() {
        var track = document.getElementById('header-ticker-track');
        var container = document.getElementById('header-ticker-container');
        if (!track || !container) return;
        
        var pos = 0;
        var speed = 0.75; // pixels per frame
        var isPaused = false;

        container.addEventListener('mouseenter', function() { isPaused = true; });
        container.addEventListener('mouseleave', function() { isPaused = false; });

        function step() {
          if (!isPaused) {
            pos += speed;
            var halfWidth = track.scrollWidth / 2;
            if (halfWidth > 0 && pos >= halfWidth) {
              pos = pos - halfWidth;
            }
            track.style.transform = 'translate3d(-' + pos.toFixed(2) + 'px, 0, 0)';
          }
          requestAnimationFrame(step);
        }
        requestAnimationFrame(step);
      })();
    </script>
    <!-- Global Document Link Target Handler (Ensures all document/upload links open in a new blank tab) -->
    <script is:inline>
      document.addEventListener('click', function(e) {
        var anchor = e.target.closest('a');
        if (!anchor) return;
        var href = anchor.getAttribute('href');
        if (!href) return;
        var isDoc = href.indexOf('/uploads/') !== -1 || 
                    /\.(pdf|docx?|xlsx?|pptx?|zip|rar|csv)$/i.test(href) ||
                    (href.indexOf('http') === 0 && href.indexOf('/uploads/') !== -1);
        if (isDoc) {
          anchor.setAttribute('target', '_blank');
          anchor.setAttribute('rel', 'noopener noreferrer');
        }
      }, true);
    </script>
  </body>
</html>
