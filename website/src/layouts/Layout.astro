                  <li><a href="/about-us/management/board" class="block p-2 rounded hover:bg-slate-100 hover:text-[#0B4F9C]">Board Of Director</a></li>
                  <li><a href="/about-us/explore/gstin-registration" class="block p-2 rounded hover:bg-slate-100 hover:text-[#0B4F9C]">GSTIN Registration Details</a></li>
                  <li><a href="/about-us/explore/policies" class="block p-2 rounded hover:bg-slate-100 hover:text-[#0B4F9C]">Policies</a></li>
                  <li><a href="/sustainability/csr/policy" class="block p-2 rounded hover:bg-slate-100 hover:text-[#0B4F9C]">CSR Policy</a></li>
                </ul>
              </div>
            </li>

            <!-- Projects -->
            <li class="relative nav-dropdown-item">
              <button class="nav-dropdown-btn flex items-center gap-1.5 px-3.5 py-3.5 hover:bg-[#084A8F] transition-[background-color,border-color] duration-150 border-b-2 border-transparent text-white focus-visible:outline-none focus-visible:bg-[#073A80]" aria-haspopup="true" aria-expanded="false">
                Projects
                <svg class="dropdown-arrow w-3 h-3 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7"></path></svg>
              </button>
              <div class="nav-dropdown-menu absolute left-0 mt-0 hidden bg-white text-slate-800 shadow-2xl border-t-4 border-[#0B4F9C] rounded-b-lg z-50 py-2 w-[240px]">
