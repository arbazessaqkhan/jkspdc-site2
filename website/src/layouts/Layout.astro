---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon.astro';
import Ticker from '../components/Ticker.astro';

interface Props {
  title: string;
  description: string;
  canonicalUrl?: string;
  isHome?: boolean;
}

const { title, description, canonicalUrl, isHome = false } = Astro.props;
const canonical = canonicalUrl || Astro.url.href;
const currentYear = new Date().getFullYear();

function getDocUrl(url?: string) {
  if (!url) return undefined;
  if (url.startsWith('/uploads/')) {
    return `http://localhost:3000${url}`;
  }
  return url;
}

function isDocUrl(url?: string) {
  if (!url) return false;
  return (
    url.includes('/uploads/') ||
    /\.(pdf|docx?|xlsx?|pptx?|zip|rar|csv)$/i.test(url) ||
    (url.startsWith('http') && url.includes('/uploads/'))
  );
}

// Dynamically fetch ticker items from the public APIs
let tickerItems: any[] = [];
try {
  const [tendersRes, notifsRes] = await Promise.all([
    fetch('http://localhost:3000/api/public/tenders').catch(() => null),
    fetch('http://localhost:3000/api/public/notifications').catch(() => null),
  ]);

  let tenders: any[] = [];
  if (tendersRes && tendersRes.ok) {
    tenders = await tendersRes.json();
  }

  let notifs: any[] = [];
  if (notifsRes && notifsRes.ok) {
    notifs = await notifsRes.json();
  }

  // Populate active tenders (limit to top 4)
  tenders.filter((t: any) => t.status === 'Active').slice(0, 4).forEach((t: any) => {
    const tenderDocUrl = getDocUrl(t.documentUrl) || `/stakeholders/vendors/tender-details?id=${t.id}`;
    tickerItems.push({
      type: 'TENDER',
      text: `${t.title} (NIT Ref: ${t.referenceNo})`,
      colorClass: 'text-cyan-300 bg-cyan-500/10 border-cyan-400/20',
      url: tenderDocUrl,
    });

    // Populate corrigendums (limit to top 2 per tender)
    const corrs = t.corrigendums && Array.isArray(t.corrigendums) ? t.corrigendums : [];
    corrs.slice(0, 2).forEach((c: any) => {
      const corrDocUrl = getDocUrl(c.documentUrl) || `/stakeholders/vendors/tender-details?id=${t.id}#corrigendum-${c.id}`;
      tickerItems.push({
        type: 'CORRIGENDUM',
        text: `Corrigendum: ${c.title} — ${t.title} (Ref: ${t.referenceNo})`,
        colorClass: 'text-orange-400 bg-orange-500/10 border-orange-400/20',
        url: corrDocUrl,
      });
    });
  });

  // Populate notifications (limit to top 4)
  notifs.slice(0, 4).forEach((n: any) => {
    const notifDocUrl = getDocUrl(n.documentUrl) || `/notifications`;
    tickerItems.push({
      type: 'NOTIFICATION',
      text: `${n.title} (File: ${n.fileName})`,
      colorClass: 'text-yellow-400 bg-yellow-500/10 border-yellow-400/20',
      url: notifDocUrl,
    });
  });
} catch (e) {
  console.error('Error fetching dynamic ticker items:', e);
}

// Fallback items if database or backend is offline
if (tickerItems.length === 0) {
  tickerItems = [
    { type: 'LIVE', text: 'Jammu & Kashmir State Power Development Corporation Limited official portal online.', colorClass: 'text-yellow-400 bg-yellow-500/10 border-yellow-400/20' }
  ];
}
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | JKSPDC Official Portal</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <!-- GIGW 3.0 — Last reviewed/updated meta -->
    <meta name="last-modified" content={new Date().toISOString().split('T')[0]} />
    <meta name="author" content="Jammu & Kashmir State Power Development Corporation Limited" />
    <meta name="publisher" content="JKSPDC — Government of Jammu & Kashmir" />
    
    <!-- GIGW SEO & Browser Compatibility -->
    <meta name="robots" content="index, follow" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <link rel="icon" type="image/png" href="/logo.png" />
    <!-- Google Fonts: Noto Sans (Regular 400, Medium 500, Semi Bold 600, Bold 700) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans:ital,wght@0,400;0,500;0,600;0,700;0,800;1,400;1,500;1,600;1,700&family=Noto+Sans+Devanagari:wght@400;500;600;700&display=swap" rel="stylesheet" />
    
    <!-- Custom Translation Utility -->
    <script src="/js/translation.js" is:inline></script>

    <!-- Custom styling for high contrast mode & animations -->
    <style is:global>
      .high-contrast,
      .high-contrast * {
        background-color: #000000 !important;
        background-image: none !important;
        color: #ffff00 !important;
        border-color: #ffff00 !important;
        box-shadow: none !important;
      }
      .high-contrast a,
      .high-contrast button {
        color: #ffff00 !important;
        text-decoration: underline !important;
      }
      .high-contrast a:hover,
      .high-contrast button:hover {
        background-color: #333333 !important;
        color: #ffffff !important;
      }

      /* ── Ticker scroll animation ───────────────────────────────── */
      @keyframes ticker-scroll {
        0%   { transform: translate3d(0, 0, 0); }
        100% { transform: translate3d(-50%, 0, 0); }
      }
      .animate-ticker {
        display: inline-flex !important;
        width: max-content !important;
        white-space: nowrap !important;
        animation: ticker-scroll 30s linear infinite !important;
        will-change: transform;
      }
      .animate-ticker:hover {
        animation-play-state: paused !important;
      }

      /* ── Slow pulse for status dots ────────────────────────────── */
      @keyframes slow-pulse {
        0%, 100% { opacity: 1; }
        50%       { opacity: 0.35; }
      }
      .animate-slow-pulse {
        animation: slow-pulse 2.5s ease-in-out infinite;
      }

      /* ── Hide Bhashini default widget elements ── */
      #bhashini-translation,
      .bhashini-feedback-modal,
      .bhashini-feedback-div,
      .bhashini-toast {
        display: none !important;
      }

      /* ── Navigation Menu Dropdown Toggle ─────────────────── */
      .nav-dropdown-item:hover > .nav-dropdown-menu:not(.is-closed),
      .nav-dropdown-item.is-open > .nav-dropdown-menu {
        display: block !important;
      }

      .nav-dropdown-item.is-closed > .nav-dropdown-menu {
        display: none !important;
      }

      .nav-dropdown-item:hover .dropdown-arrow:not(.is-arrow-closed),
      .nav-dropdown-item.is-open .dropdown-arrow {
        transform: rotate(180deg);
      }

      .nav-dropdown-item.is-closed .dropdown-arrow {
        transform: rotate(0deg) !important;
      }
    </style>

    <!-- GIGW Accessibility & Preference persistence scripts -->
    <script is:inline>
      function adjustFontSize(action) {
        var html = document.documentElement;
        var cur = parseFloat(window.getComputedStyle(html).fontSize) || 17;
        var nextSize = cur;
        if (action === 'inc') {
          if (cur < 24) nextSize = cur + 1;
        } else if (action === 'dec') {
          if (cur > 12) nextSize = cur - 1;
        } else {
          nextSize = 17;
        }
        var sizeStr = nextSize + 'px';
        html.style.fontSize = sizeStr;
        try {
          localStorage.setItem('preferred-font-size', sizeStr);
        } catch (e) {}
      }

      function toggleHighContrast() {
        var html = document.documentElement;
        var isDark = html.classList.toggle('high-contrast');
        try {
          localStorage.setItem('high-contrast', isDark ? 'true' : 'false');
        } catch (e) {}
      }

      function changeLanguage(langCode) {
        try {
          localStorage.setItem('preferredLanguage', langCode);
          window.location.reload();
        } catch (e) {}
      }

      function toggleLangDropdown(event) {
        if (event) event.stopPropagation();
        var menu = document.getElementById('lang-dropdown-menu');
        var btn = document.getElementById('lang-dropdown-btn');
        var arrow = document.getElementById('lang-arrow');
        if (!menu) return;
        
        var isHidden = menu.classList.toggle('hidden');
        if (btn) btn.setAttribute('aria-expanded', !isHidden);
        if (arrow) {
          if (isHidden) {
            arrow.classList.remove('rotate-180');
          } else {
            arrow.classList.add('rotate-180');
          }
        }
      }

      (function() {
        try {
          var savedSize = localStorage.getItem('preferred-font-size');
          if (savedSize) {
            document.documentElement.style.fontSize = savedSize;
          }
          var savedContrast = localStorage.getItem('high-contrast');
          if (savedContrast === 'true') {
            document.documentElement.classList.add('high-contrast');
          }
          
          var preferredLang = localStorage.getItem('preferredLanguage') || 'en';
          var labels = {
            'en': 'English',
            'hi': 'हिन्दी',
            'ur': 'اردو',
            'ks': 'کٲشُر',
            'doi': 'डोगरी'
          };
          var labelText = labels[preferredLang] || 'English';
          
          document.addEventListener('DOMContentLoaded', function() {
            var labelEl = document.getElementById('current-lang-label');
            if (labelEl) labelEl.textContent = labelText;
            
            var btn = document.getElementById('lang-dropdown-btn');
            if (btn) {
              btn.addEventListener('click', toggleLangDropdown);
            }
            
            // Navigation Menu Toggle & Smart Viewport Edge Alignment Logic
            var navItems = document.querySelectorAll('.nav-dropdown-item');
            
            function positionDropdown(item) {
              var menu = item.querySelector('.nav-dropdown-menu');
              if (!menu) return;
              var rect = item.getBoundingClientRect();
              var windowWidth = window.innerWidth || document.documentElement.clientWidth;
              var itemCenter = rect.left + (rect.width / 2);

              if (itemCenter > windowWidth / 2) {
                // Item is on right half of screen -> align right so menu opens to the left
                menu.style.left = 'auto';
                menu.style.right = '0';
              } else {
                // Item is on left half of screen -> align left so menu opens to the right
                menu.style.left = '0';
                menu.style.right = 'auto';
              }
            }

            function updateAllDropdownPositions() {
              navItems.forEach(positionDropdown);
            }

            // Initial positioning
            updateAllDropdownPositions();
            window.addEventListener('resize', updateAllDropdownPositions);

            navItems.forEach(function(item) {
              var btn = item.querySelector('.nav-dropdown-btn');
              var menu = item.querySelector('.nav-dropdown-menu');
              if (!btn || !menu) return;

              // Ensure correct positioning before opening on mouseenter
              item.addEventListener('mouseenter', function() {
                positionDropdown(item);
              });

              btn.addEventListener('click', function(e) {
                e.preventDefault();
                e.stopPropagation();
                positionDropdown(item);

                var isClosed = item.classList.contains('is-closed');
                var isOpen = item.classList.contains('is-open');

                // Determine if menu is currently visible
                var isShowing = isOpen || (!isClosed && window.getComputedStyle(menu).display !== 'none');

                // Close all other dropdowns
                navItems.forEach(function(other) {
                  if (other !== item) {
                    other.classList.remove('is-open');
                    other.classList.add('is-closed');
                    var otherBtn = other.querySelector('.nav-dropdown-btn');
                    if (otherBtn) otherBtn.setAttribute('aria-expanded', 'false');
                  }
                });

                if (isShowing) {
                  // SECOND CLICK -> MINIMIZE / CLOSE
                  item.classList.remove('is-open');
                  item.classList.add('is-closed');
                  btn.setAttribute('aria-expanded', 'false');
                } else {
                  // FIRST CLICK -> MAXIMIZE / OPEN
                  item.classList.remove('is-closed');
                  item.classList.add('is-open');
                  btn.setAttribute('aria-expanded', 'true');
                }
              });

              item.addEventListener('mouseleave', function() {
                item.classList.remove('is-closed');
                item.classList.remove('is-open');
                btn.setAttribute('aria-expanded', 'false');
              });
            });

            // Close dropdown when clicking outside
            window.addEventListener('click', function(e) {
              navItems.forEach(function(item) {
                if (!item.contains(e.target)) {
                  item.classList.remove('is-open');
                  item.classList.add('is-closed');
                  var btn = item.querySelector('.nav-dropdown-btn');
                  if (btn) btn.setAttribute('aria-expanded', 'false');
                }
              });
              var menu = document.getElementById('lang-dropdown-menu');
              var btn = document.getElementById('lang-dropdown-btn');
              var arrow = document.getElementById('lang-arrow');
              if (menu && !menu.classList.contains('hidden')) {
                if (btn && !btn.contains(e.target) && !menu.contains(e.target)) {
                  menu.classList.add('hidden');
                  btn.setAttribute('aria-expanded', 'false');
                  if (arrow) arrow.classList.remove('rotate-180');
                }
              }
            });
          });
        } catch (e) {}
      })();
    </script>
  </head>
  <body class="min-h-screen flex flex-col bg-slate-50 text-slate-800 font-sans transition-colors duration-150">
    
    <!-- Skip to Main Content Link (GIGW Mandatory) -->
    <a href="#main-content" class="skip-link">Skip to Main Content</a>

    <!-- noscript fallback for JavaScript-dependent features (WCAG) -->
    <noscript>
      <div style="background:#f59e0b;color:#1e293b;text-align:center;padding:8px 16px;font-size:12px;font-weight:600;border-bottom:2px solid #d97706;" role="alert">
        ⚠️ JavaScript is disabled. Some features (language translation, search autocomplete) require JavaScript. Core content remains accessible.
      </div>
    </noscript>

    <header class="bg-[#EAF4FF] border-b-2 border-[#0B4F9C] shadow-sm">
      <div class="max-w-7xl mx-auto px-2 sm:px-4 lg:px-6 py-1.5 flex items-center justify-between gap-2">
        <!-- Left Logo -->
        <a href="/" class="flex-shrink-0 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#0B4F9C] rounded p-0.5" aria-label="JKSPDCL Home">
          <img src="/logo.png" alt="JKSPDCL Logo" class="h-11 sm:h-12 md:h-14 lg:h-[3.75rem] w-auto object-contain" />
        </a>

        <!-- Centered Organization Name -->
        <div class="flex-1 text-center px-1 sm:px-2 min-w-0">
          <h1 class="text-sm sm:text-base md:text-lg lg:text-xl font-bold text-[#0B4F9C] leading-tight whitespace-nowrap">
            Jammu &amp; Kashmir State Power Development Corporation Limited
          </h1>
          <p class="text-[11px] sm:text-xs md:text-sm font-bold text-[#0B4F9C] mt-0.5 whitespace-nowrap">(JKSPDCL)</p>
          <p class="text-[10px] sm:text-xs text-[#0B4F9C] font-semibold mt-0.5 whitespace-nowrap" lang="hi">
            जम्मू और कश्मीर राज्य विद्युत विकास निगम लिमिटेड (जेकेएसपीडीसीएल)
          </p>
        </div>

        <!-- Right Accessibility Controls & Search Bar -->
        <div class="flex flex-col items-end gap-1.5 flex-shrink-0">
          <!-- Accessibility Controls -->
          <div class="flex items-center gap-1.5 sm:gap-2 text-xs text-slate-700 select-none">
            <!-- Font Sizing -->
            <div class="flex items-center gap-1" aria-label="Font Size Controls" role="group">
              <button class="flex items-center gap-1 px-1.5 py-0.5 bg-white hover:bg-slate-100 border border-slate-300 rounded text-xs font-bold text-slate-700 transition-colors cursor-pointer" onclick="adjustFontSize('dec')" aria-label="Decrease Font Size" title="Decrease Font Size">
                <Icon name="minus" size={9} strokeWidth={2.5} /> A
              </button>
              <button class="flex items-center px-2 py-0.5 bg-white hover:bg-slate-100 border border-slate-300 rounded text-xs font-bold text-slate-700 transition-colors cursor-pointer" onclick="adjustFontSize('reset')" aria-label="Reset Font Size" title="Reset Font Size">A</button>
              <button class="flex items-center gap-1 px-1.5 py-0.5 bg-white hover:bg-slate-100 border border-slate-300 rounded text-xs font-bold text-slate-700 transition-colors cursor-pointer" onclick="adjustFontSize('inc')" aria-label="Increase Font Size" title="Increase Font Size">
                <Icon name="plus" size={9} strokeWidth={2.5} /> A
              </button>
            </div>
            <span class="text-slate-300">|</span>
            <!-- Contrast Switcher -->
            <button class="flex items-center gap-1 px-2 py-0.5 bg-white hover:bg-slate-100 border border-slate-300 rounded text-xs font-bold text-slate-700 transition-colors cursor-pointer" onclick="toggleHighContrast()" aria-label="Toggle High Contrast Mode">
              <Icon name="contrast" size={11} strokeWidth={2.5} /> Contrast
            </button>
            <span class="text-slate-300">|</span>
            <!-- Custom Language Selector Dropdown -->
            <div class="relative inline-block text-left select-none dont-translate z-[9999]" id="custom-language-selector">
              <button
                id="lang-dropdown-btn"
                type="button"
                class="flex items-center gap-1 px-2 py-0.5 bg-white hover:bg-slate-100 border border-slate-300 rounded text-xs font-bold text-slate-700 transition-colors cursor-pointer focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-slate-400"
                aria-expanded="false"
                aria-haspopup="true"
              >
                <Icon name="globe" size={11} strokeWidth={2.5} />
                <span id="current-lang-label">English</span>
                <svg class="w-3 h-3 ml-0.5 transition-transform duration-200" id="lang-arrow" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7"></path>
                </svg>
              </button>
              
              <div
                id="lang-dropdown-menu"
                class="absolute right-0 mt-1 w-36 bg-white text-slate-800 rounded shadow-xl border border-slate-200/85 hidden z-[9999] py-1 text-left"
                role="menu"
                aria-orientation="vertical"
                aria-labelledby="lang-dropdown-btn"
              >
                <button class="w-full text-left px-3 py-1.5 text-xs hover:bg-slate-100 font-semibold transition-colors block cursor-pointer" role="menuitem" onclick="changeLanguage('en')">English</button>
                <button class="w-full text-left px-3 py-1.5 text-xs hover:bg-slate-100 font-semibold transition-colors block cursor-pointer" role="menuitem" onclick="changeLanguage('hi')">हिन्दी (Hindi)</button>
                <button class="w-full text-left px-3 py-1.5 text-xs hover:bg-slate-100 font-semibold transition-colors block cursor-pointer" role="menuitem" onclick="changeLanguage('ur')">اردو (Urdu)</button>
                <button class="w-full text-left px-3 py-1.5 text-xs hover:bg-slate-100 font-semibold transition-colors block cursor-pointer" role="menuitem" onclick="changeLanguage('ks')">کٲشُر (Kashmiri)</button>
                <button class="w-full text-left px-3 py-1.5 text-xs hover:bg-slate-100 font-semibold transition-colors block cursor-pointer" role="menuitem" onclick="changeLanguage('doi')">डोगरी (Dogri)</button>
              </div>
            </div>
          </div>

          <!-- Search Form -->
          <form action="/search" method="GET" class="flex items-center w-full justify-end relative" id="header-search-form" autocomplete="off">
            <div class="relative flex items-center">
              <label for="header-search" class="sr-only">Search portal pages</label>
              <input 
                type="search" 
                name="q" 
                id="header-search" 
                placeholder="Search…" 
                class="bg-white hover:bg-slate-50 focus-visible:bg-white text-xs text-slate-850 focus-visible:text-slate-900 px-2.5 py-1.5 rounded-l-md border border-slate-300 border-r-0 focus-visible:border-[#0B4F9C] focus-visible:outline-none transition-[background-color,border-color,color] duration-150 w-32 sm:w-36 lg:w-40 placeholder-slate-400 shadow-sm" 
                required
              />
              <!-- Suggestions Dropdown Container -->
              <div id="header-search-suggestions" class="absolute left-0 right-0 top-full mt-1 bg-white text-slate-850 border border-slate-200 rounded-md shadow-xl hidden z-[9999] max-h-60 overflow-y-auto text-left py-1 w-full lg:w-48">
              </div>
            </div>
            <button type="submit" class="p-1.5 bg-[#1a5276] hover:bg-[#084A8F] rounded-r-md text-xs text-white font-bold flex items-center justify-center border border-transparent transition-[background-color,border-color] duration-150 shadow-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#0B4F9C]/50 cursor-pointer" aria-label="Submit Search">
              <Icon name="search" size={14} strokeWidth={2.5} />
            </button>
          </form>
        </div>
      </div>

      <!-- Live News Ticker Bar -->
      <!-- WCAG: aria-hidden on animated region; static sr-only list for screen readers -->
      <div class="bg-[#08305C] text-white relative overflow-hidden border-t border-b border-[#0B4F9C]/30">
        <!-- Screen-reader-only summary of ticker items (accessible alternative to animation) -->
        <div class="sr-only" aria-live="polite" aria-label="Latest announcements">
          <p>Latest updates from JKSPDC:</p>
          <ul>
            {tickerItems.map((item: any) => (
              <li>
                <strong>{item.type}:</strong> {item.url ? <a href={item.url} target={isDocUrl(item.url) ? "_blank" : undefined} rel={isDocUrl(item.url) ? "noopener noreferrer" : undefined}>{item.text}</a> : item.text}
              </li>
            ))}
          </ul>
        </div>
        <!-- Visual animated ticker (hidden from screen readers) -->
        <div class="flex items-center h-9 overflow-hidden" style="max-width:100%;" aria-hidden="true">
          <div class="shrink-0 bg-[#1B3A6B] text-white text-xs font-bold px-4 h-full flex items-center gap-2 uppercase tracking-wide z-20 whitespace-nowrap">
            <span class="w-2 h-2 rounded-full bg-slate-300 animate-slow-pulse shrink-0"></span>
            Updates
          </div>
          <div class="flex-1 overflow-hidden relative h-full flex items-center" id="header-ticker-container">
            <div class="absolute left-0 top-0 bottom-0 w-10 bg-gradient-to-r from-[#08305C] to-transparent z-10 pointer-events-none"></div>
            <div class="absolute right-0 top-0 bottom-0 w-10 bg-gradient-to-l from-[#08305C] to-transparent z-10 pointer-events-none"></div>
            <div id="header-ticker-track" class="flex items-center whitespace-nowrap w-max shrink-0 cursor-pointer" style="gap: 3.5rem; font-size: 0.8rem; font-weight: 500; will-change: transform;">
              {[...tickerItems, ...tickerItems].map((item: any) => (
                <span class="inline-flex items-center whitespace-nowrap shrink-0" style="padding-right:4rem;">
                  › <strong class={`font-extrabold uppercase tracking-wider text-[10px] mr-1.5 px-1.5 py-0.5 rounded border whitespace-nowrap shrink-0 ${item.colorClass}`}>{item.type}:</strong>
                  {item.url ? (
                    <a href={item.url} target={isDocUrl(item.url) ? "_blank" : undefined} rel={isDocUrl(item.url) ? "noopener noreferrer" : undefined} class="text-slate-100 hover:underline hover:text-white transition-colors whitespace-nowrap">
                      {item.text}
                    </a>
                  ) : (
                    <span class="text-slate-100 whitespace-nowrap">{item.text}</span>
                  )}
                </span>
              ))}
            </div>
          </div>
        </div>
      </div>
    </header>

    <!-- Navigation Bar (Sticky Top-0 Globally Across Entire Website) -->
    <nav class="bg-gradient-to-r from-[#073B75] via-[#0B4F9C] to-[#042750] border-t border-white/10 shadow-xl sticky top-0 z-50 transition-all duration-200" aria-label="Primary Navigation">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col md:flex-row justify-between items-center gap-4">
          <ul class="flex flex-wrap w-full justify-between text-sm font-semibold">
            <!-- Home -->
            <li>
              <a href="/" class="block px-3.5 py-3.5 text-white hover:bg-white/10 transition-all duration-200 border-b-2 border-transparent hover:border-white/60 focus-visible:outline-none focus-visible:bg-white/15">
                Home
              </a>
