            <!-- Commercial -->
            <li class="relative group">
              <button class="flex items-center gap-1.5 px-4 py-3.5 hover:bg-[#084A8F] transition-colors border-b-2 border-transparent group-hover:border-white/60 text-white focus:outline-none focus:bg-[#073A80]" aria-haspopup="true" aria-expanded="false">
                Commercial
                <svg class="w-3 h-3 transition-transform duration-200 group-hover:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7"></path>
                </svg>
              </button>
              <!-- 2-Column Grid Dropdown -->
              <div class="absolute left-0 mt-0 hidden group-hover:grid group-focus-within:grid bg-white text-slate-800 shadow-2xl border-t-4 border-[#0B4F9C] rounded-b-lg z-50 p-5 gap-x-6 gap-y-2 w-[420px] grid-cols-2 transition-all duration-200 ease-out">
                <div class="col-span-2 font-bold text-xs uppercase tracking-wider text-[#0B4F9C] border-b border-slate-100 pb-1.5 mb-2">Commercial Directory</div>
                <ul class="flex flex-col gap-1 text-xs">
                  <li><a href="/commercial/overview" class="block p-1.5 rounded hover:bg-slate-100 hover:text-[#0B4F9C]">Overview</a></li>
