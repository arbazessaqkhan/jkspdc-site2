---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  canonicalUrl?: string;
}

const { title, description, canonicalUrl } = Astro.props;
const canonical = canonicalUrl || Astro.url.href;
const currentYear = new Date().getFullYear();
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | JKSPDC Official Portal</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    
    <!-- GIGW SEO & Browser Compatibility -->
    <meta name="robots" content="index, follow" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <link rel="icon" type="image/png" href="/logo.png" />
    
    <!-- Custom styling for high contrast mode -->
    <style>
      .high-contrast {
        background-color: #000000 !important;
        color: #ffff00 !important;
      }
      .high-contrast header, 
      .high-contrast footer,
      .high-contrast nav,
      .high-contrast div,
      .high-contrast section,
      .high-contrast aside,
      .high-contrast article,
      .high-contrast table,
      .high-contrast th,
      .high-contrast td {
        background-color: #000000 !important;
        color: #ffff00 !important;
        border-color: #ffff00 !important;
      }
      .high-contrast a,
      .high-contrast button {
        color: #ffff00 !important;
        text-decoration: underline !important;
      }
      .high-contrast a:hover,
      .high-contrast button:hover {
        background-color: #333333 !important;
        color: #ffffff !important;
      }
    </style>
  </head>
  <body class="min-h-screen flex flex-col bg-slate-50 text-slate-800 font-sans transition-colors duration-150">
    
    <!-- Skip to Main Content Link (GIGW Mandatory) -->
    <a href="#main-content" class="skip-link">Skip to Main Content</a>

    <!-- Top Utility Bar (Accessibility & Bilingual Switchers) -->
    <div class="bg-slate-900 text-slate-300 text-xs py-2 border-b border-slate-800">
      <div class="max-w-7xl mx-auto px-4 flex justify-between items-center">
        <!-- Office Info / Contact Helpline -->
        <div class="hidden sm:flex items-center gap-4">
          <span>📞 Jammu Office: +91 191 2430548</span>
          <span>📞 Srinagar Office: +91 194 2451665</span>
        </div>
        <!-- Accessibility Controls -->
        <div class="flex items-center gap-4 ml-auto">
          <div class="flex items-center gap-2" aria-label="Font Adjustments">
            <button class="px-2 py-0.5 bg-slate-800 hover:bg-slate-700 rounded text-[10px] font-bold" onclick="document.documentElement.style.fontSize = '14px'" aria-label="Decrease Font Size">A-</button>
            <button class="px-2 py-0.5 bg-slate-800 hover:bg-slate-700 rounded text-[10px] font-bold" onclick="document.documentElement.style.fontSize = '16px'" aria-label="Normal Font Size">A</button>
            <button class="px-2 py-0.5 bg-slate-800 hover:bg-slate-700 rounded text-[10px] font-bold" onclick="document.documentElement.style.fontSize = '18px'" aria-label="Increase Font Size">A+</button>
          </div>
          <span class="text-slate-600">|</span>
          <!-- Contrast Switcher -->
          <button class="px-2 py-0.5 bg-slate-800 hover:bg-slate-700 rounded text-[10px] font-semibold" onclick="document.body.classList.toggle('high-contrast')" aria-label="Toggle High Contrast Mode">👁️ Contrast</button>
          <span class="text-slate-600">|</span>
          <!-- Language Selector -->
          <a href="#" class="hover:text-white transition-colors font-semibold" aria-label="Switch Language to Hindi">हिन्दी</a>
        </div>
      </div>
    </div>

    <!-- Header Section (GIGW/Government Standards) -->
    <header class="bg-gradient-to-r from-[#002244] via-[#003366] to-[#004488] text-white shadow-lg border-b-4 border-[#f15a24]">
      <div class="max-w-7xl mx-auto px-4 py-5 flex flex-col lg:flex-row justify-between items-center gap-4">
        <!-- Logo and Brand Identity -->
        <div class="flex items-center gap-4 flex-col sm:flex-row text-center sm:text-left">
          <a href="/" class="flex items-center gap-4 focus:outline-none focus:ring-2 focus:ring-orange-500 rounded p-1">
            <img src="/logo.png" alt="JKSPDCL Logo" class="h-16 w-auto object-contain bg-white/10 p-1.5 rounded-lg border border-white/20 shadow-inner" />
            <div>
              <h1 class="text-lg md:text-2xl font-extrabold tracking-wide text-white drop-shadow-md">
                Jammu & Kashmir State Power Development Corporation Ltd.
              </h1>
              <p class="text-xs md:text-sm text-slate-200 mt-0.5 font-medium">JKSPDCL — A wholly owned PSU of the Government of Jammu & Kashmir</p>
              <p class="text-[10px] text-orange-400 font-bold tracking-wider uppercase mt-1">Incorporated 1995 under the Companies Act</p>
            </div>
          </a>
        </div>

        <!-- Corporate Info Banner (Optional highlight) -->
        <div class="hidden xl:flex items-center gap-3 bg-white/5 border border-white/10 px-4 py-2 rounded-lg backdrop-blur-sm">
          <div class="text-right text-xs">
            <p class="text-orange-400 font-bold uppercase tracking-wider text-[10px]">UT's Installed Capacity</p>
            <p class="text-base font-extrabold text-white">1197.4 MW</p>
          </div>
          <span class="text-xl">⚡</span>
        </div>
      </div>

      <!-- Navigation Bar (With CSS and Keyboard Accessible Dropdowns) -->
      <nav class="bg-[#001f3f] border-t border-white/5 relative" aria-label="Primary Navigation">
        <div class="max-w-7xl mx-auto px-4 flex flex-col md:flex-row justify-between items-center gap-4">
          <ul class="flex flex-wrap gap-1 text-sm font-semibold">
            <!-- Home -->
            <li>
              <a href="/" class="block px-4 py-3.5 hover:bg-[#003366] transition-colors border-b-2 border-transparent hover:border-[#f15a24]">
                Home
              </a>
            </li>

            <!-- About Us -->
            <li class="relative group">
              <button class="flex items-center gap-1.5 px-4 py-3.5 hover:bg-[#003366] transition-colors border-b-2 border-transparent group-hover:border-[#f15a24] text-white focus:outline-none focus:bg-[#003366]" aria-haspopup="true" aria-expanded="false">
                About Us
                <svg class="w-3 h-3 transition-transform duration-200 group-hover:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7"></path>
                </svg>
              </button>
              <!-- Mega Dropdown (3 columns) -->
              <div class="absolute left-0 mt-0 hidden group-hover:grid group-focus-within:grid bg-white text-slate-800 shadow-2xl border-t-4 border-[#f15a24] rounded-b-lg z-50 p-6 gap-6 w-[560px] grid-cols-3 transition-all duration-200 ease-out">
                <div>
                  <h3 class="font-bold text-xs uppercase tracking-wider text-[#003366] border-b border-slate-100 pb-1.5 mb-2">Explore</h3>
                  <ul class="flex flex-col gap-1 text-xs">
                    <li><a href="/about-us/explore/overview" class="block p-1.5 rounded hover:bg-slate-100 hover:text-[#003366]">Corporate Overview</a></li>
                    <li><a href="/about-us/explore/vision" class="block p-1.5 rounded hover:bg-slate-100 hover:text-[#003366]">Vision</a></li>
                    <li><a href="/about-us/explore/mission" class="block p-1.5 rounded hover:bg-slate-100 hover:text-[#003366]">Mission</a></li>
                    <li><a href="/about-us/explore/profile" class="block p-1.5 rounded hover:bg-slate-100 hover:text-[#003366]">Corporate Profile</a></li>
                    <li><a href="/about-us/explore/objectives" class="block p-1.5 rounded hover:bg-slate-100 hover:text-[#003366]">Main Objectives</a></li>
                    <li><a href="/about-us/explore/organization-chart" class="block p-1.5 rounded hover:bg-slate-100 hover:text-[#003366]">Organization Chart</a></li>
                    <li><a href="/about-us/explore/roles-responsibility" class="block p-1.5 rounded hover:bg-slate-100 hover:text-[#003366]">Roles & Responsibility</a></li>
                    <li><a href="/about-us/explore/executives-directory" class="block p-1.5 rounded hover:bg-slate-100 hover:text-[#003366]">Sr. Executives Directory</a></li>
                    <li><a href="/about-us/explore/ethics-code" class="block p-1.5 rounded hover:bg-slate-100 hover:text-[#003366]">Conduct & Ethics Code</a></li>
                    <li><a href="/about-us/explore/association-memorandum" class="block p-1.5 rounded hover:bg-slate-100 hover:text-[#003366]">Memorandum & Association</a></li>
                  </ul>
                </div>
                <div>
                  <h3 class="font-bold text-xs uppercase tracking-wider text-[#003366] border-b border-slate-100 pb-1.5 mb-2">Management</h3>
                  <ul class="flex flex-col gap-1 text-xs">
                    <li><a href="/about-us/management/board" class="block p-1.5 rounded hover:bg-slate-100 hover:text-[#003366]">Board of Directors</a></li>
                    <li><a href="/about-us/management/committees" class="block p-1.5 rounded hover:bg-slate-100 hover:text-[#003366]">Committee of Directors</a></li>
                  </ul>
                </div>
                <div>
                  <h3 class="font-bold text-xs uppercase tracking-wider text-[#003366] border-b border-slate-100 pb-1.5 mb-2">Others</h3>
                  <ul class="flex flex-col gap-1 text-xs">
                    <li><a href="/about-us/others/awards" class="block p-1.5 rounded hover:bg-slate-100 hover:text-[#003366]">Honours & Awards</a></li>
                    <li><a href="/about-us/others/contact" class="block p-1.5 rounded hover:bg-slate-100 hover:text-[#003366]">Contact Directory</a></li>
                  </ul>
                </div>
              </div>
            </li>

            <!-- Our Business -->
            <li class="relative group">
              <button class="flex items-center gap-1.5 px-4 py-3.5 hover:bg-[#003366] transition-colors border-b-2 border-transparent group-hover:border-[#f15a24] text-white focus:outline-none focus:bg-[#003366]" aria-haspopup="true" aria-expanded="false">
                Our Business
                <svg class="w-3 h-3 transition-transform duration-200 group-hover:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7"></path>
                </svg>
              </button>
              <!-- Single Column Dropdown -->
              <div class="absolute left-0 mt-0 hidden group-hover:block group-focus-within:block bg-white text-slate-800 shadow-2xl border-t-4 border-[#f15a24] rounded-b-lg z-50 py-2 w-[260px] transition-all duration-200 ease-out">
                <ul class="flex flex-col gap-0.5 text-xs px-2">
                  <li><a href="/our-business/power-stations" class="block p-2 rounded hover:bg-slate-100 hover:text-[#003366]">⚡ Power Stations</a></li>
                  <li><a href="/our-business/construction" class="block p-2 rounded hover:bg-slate-100 hover:text-[#003366]">🛠️ Construction Projects</a></li>
                  <li><a href="/our-business/under-development" class="block p-2 rounded hover:bg-slate-100 hover:text-[#003366]">📈 Under Development Projects</a></li>
                  <li><a href="/our-business/jv-subsidiary-projects" class="block p-2 rounded hover:bg-slate-100 hover:text-[#003366]">🤝 JV / Subsidiary Projects</a></li>
                  <li><a href="/our-business/turnkey" class="block p-2 rounded hover:bg-slate-100 hover:text-[#003366]">📦 Deposit / Turnkey</a></li>
                  <li><a href="/our-business/consultancy" class="block p-2 rounded hover:bg-slate-100 hover:text-[#003366]">💼 Consultancy</a></li>
                  <li><a href="/our-business/jv-companies" class="block p-2 rounded hover:bg-slate-100 hover:text-[#003366]">🏢 JV & Subsidiary Companies</a></li>
                </ul>
              </div>
            </li>

            <!-- Stakeholders -->
            <li class="relative group">
              <button class="flex items-center gap-1.5 px-4 py-3.5 hover:bg-[#003366] transition-colors border-b-2 border-transparent group-hover:border-[#f15a24] text-white focus:outline-none focus:bg-[#003366]" aria-haspopup="true" aria-expanded="false">
                Stakeholders
                <svg class="w-3 h-3 transition-transform duration-200 group-hover:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7"></path>
                </svg>
              </button>
              <!-- 2 Column Dropdown -->
              <div class="absolute left-0 mt-0 hidden group-hover:grid group-focus-within:grid bg-white text-slate-800 shadow-2xl border-t-4 border-[#f15a24] rounded-b-lg z-50 p-5 gap-6 w-[400px] grid-cols-2 transition-all duration-200 ease-out">
                <div>
                  <h3 class="font-bold text-xs uppercase tracking-wider text-[#003366] border-b border-slate-100 pb-1.5 mb-2">Investors</h3>
                  <ul class="flex flex-col gap-1 text-xs">
                    <li><a href="/stakeholders/investors/chairman-statement" class="block p-1.5 rounded hover:bg-slate-100 hover:text-[#003366]">Chairman's Statement</a></li>
                    <li><a href="/stakeholders/investors/financial-results" class="block p-1.5 rounded hover:bg-slate-100 hover:text-[#003366]">Financial Results</a></li>
                    <li><a href="/stakeholders/investors/announcement" class="block p-1.5 rounded hover:bg-slate-100 hover:text-[#003366]">Announcements</a></li>
                    <li><a href="/stakeholders/investors/annual-reports" class="block p-1.5 rounded hover:bg-slate-100 hover:text-[#003366]">Annual Reports</a></li>
                    <li><a href="/stakeholders/investors/mou-mop" class="block p-1.5 rounded hover:bg-slate-100 hover:text-[#003366]">MOU signed with MOP</a></li>
                    <li><a href="/stakeholders/investors/more" class="block p-1.5 rounded hover:bg-slate-100 hover:text-[#003366]">More Info</a></li>
                  </ul>
                </div>
                <div>
                  <h3 class="font-bold text-xs uppercase tracking-wider text-[#003366] border-b border-slate-100 pb-1.5 mb-2">Vendors</h3>
                  <ul class="flex flex-col gap-1 text-xs">
                    <li><a href="/stakeholders/vendors/msme-corner" class="block p-1.5 rounded hover:bg-slate-100 hover:text-[#003366]">Startups / MSME Corner</a></li>
                    <li><a href="/stakeholders/vendors/vendor-portal" class="block p-1.5 rounded hover:bg-slate-100 hover:text-[#003366]">Vendor Portal</a></li>
                    <li><a href="/stakeholders/vendors/tender-bids" class="block p-1.5 rounded hover:bg-slate-100 hover:text-[#003366]">Tenders & Bids</a></li>
                    <li><a href="/stakeholders/vendors/online-payment" class="block p-1.5 rounded hover:bg-slate-100 hover:text-[#003366]">Online Payment Portal</a></li>
                    <li><a href="/stakeholders/vendors/clpm-portal" class="block p-1.5 rounded hover:bg-slate-100 hover:text-[#003366]">CLPM Portal</a></li>
                  </ul>
                </div>
              </div>
            </li>

            <!-- Commercial -->
            <li class="relative group">
              <button class="flex items-center gap-1.5 px-4 py-3.5 hover:bg-[#003366] transition-colors border-b-2 border-transparent group-hover:border-[#f15a24] text-white focus:outline-none focus:bg-[#003366]" aria-haspopup="true" aria-expanded="false">
                Commercial
                <svg class="w-3 h-3 transition-transform duration-200 group-hover:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7"></path>
                </svg>
              </button>
              <!-- 2-Column Grid Dropdown -->
              <div class="absolute left-0 mt-0 hidden group-hover:grid group-focus-within:grid bg-white text-slate-800 shadow-2xl border-t-4 border-[#f15a24] rounded-b-lg z-50 p-5 gap-x-6 gap-y-2 w-[420px] grid-cols-2 transition-all duration-200 ease-out">
                <div class="col-span-2 font-bold text-xs uppercase tracking-wider text-[#003366] border-b border-slate-100 pb-1.5 mb-2">Commercial Directory</div>
                <ul class="flex flex-col gap-1 text-xs">
                  <li><a href="/commercial/overview" class="block p-1.5 rounded hover:bg-slate-100 hover:text-[#003366]">Overview</a></li>
                  <li><a href="/commercial/power-trading" class="block p-1.5 rounded hover:bg-slate-100 hover:text-[#003366]">Power Trading Cell</a></li>
