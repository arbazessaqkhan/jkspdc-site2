---
import '../styles/global.css';
import Icon from '../components/Icon.astro';

interface Props {
  title: string;
  description: string;
  canonicalUrl?: string;
  isHome?: boolean;
}

const { title, description, canonicalUrl, isHome = false } = Astro.props;
const canonical = canonicalUrl || Astro.url.href;
const currentYear = new Date().getFullYear();
---


<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | JKSPDC Official Portal</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    
    <!-- GIGW SEO & Browser Compatibility -->
    <meta name="robots" content="index, follow" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <link rel="icon" type="image/png" href="/logo.png" />
    <!-- Google Fonts: Noto Sans for Hindi support -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans:ital,wght@0,400;0,500;0,600;0,700;0,800;1,400&family=Noto+Sans+Devanagari:wght@400;500;600;700&display=swap" rel="stylesheet" />
    
    <!-- Custom Translation Utility -->
    <script src="/js/translation.js" is:inline></script>

    <!-- Custom styling for high contrast mode -->
    <style is:global>
      .high-contrast,
      .high-contrast * {
        background-color: #000000 !important;
        background-image: none !important;
        color: #ffff00 !important;
        border-color: #ffff00 !important;
        box-shadow: none !important;
      }
      .high-contrast a,
      .high-contrast button {
        color: #ffff00 !important;
        text-decoration: underline !important;
      }
      .high-contrast a:hover,
      .high-contrast button:hover {
        background-color: #333333 !important;
        color: #ffffff !important;
      }

      /* ── Ticker scroll animation ───────────────────────────────── */
      @keyframes ticker-scroll {
        0%   { transform: translateX(0); }
        100% { transform: translateX(-50%); }
      }
      .animate-ticker {
        display: flex;
        white-space: nowrap;
        animation: ticker-scroll 26s linear infinite;
        will-change: transform;
      }
      .animate-ticker:hover {
        animation-play-state: paused;
      }

      /* ── Slow pulse for status dots ────────────────────────────── */
      @keyframes slow-pulse {
        0%, 100% { opacity: 1; }
        50%       { opacity: 0.35; }
      }
      .animate-slow-pulse {
        animation: slow-pulse 2.5s ease-in-out infinite;
      }

      /* ── Hide Bhashini default widget elements to maintain clean design ── */
      #bhashini-translation,
      .bhashini-feedback-modal,
      .bhashini-feedback-div,
      .bhashini-toast {
        display: none !important;
      }
    </style>
    <!-- Incremental font size helper (GIGW Accessibility) & Preference persistence -->
    <script is:inline>
      function adjustFontSize(action) {
        var html = document.documentElement;
        var cur = parseFloat(window.getComputedStyle(html).fontSize) || 16;
        var nextSize = cur;
        if (action === 'inc') {
          if (cur < 24) nextSize = cur + 1;
        } else if (action === 'dec') {
          if (cur > 12) nextSize = cur - 1;
        } else {
          nextSize = 16;
        }
        var sizeStr = nextSize + 'px';
        html.style.fontSize = sizeStr;
        try {
          localStorage.setItem('preferred-font-size', sizeStr);
        } catch (e) {}
      }

      function toggleHighContrast() {
        var html = document.documentElement;
        var isDark = html.classList.toggle('high-contrast');
        try {
          localStorage.setItem('high-contrast', isDark ? 'true' : 'false');
        } catch (e) {}
      }

      // Custom Language Dropdown logic
      function changeLanguage(langCode) {
        try {
          localStorage.setItem('preferredLanguage', langCode);
          window.location.reload();
        } catch (e) {}
      }

      function toggleLangDropdown(event) {
        if (event) event.stopPropagation();
        var menu = document.getElementById('lang-dropdown-menu');
        var btn = document.getElementById('lang-dropdown-btn');
        var arrow = document.getElementById('lang-arrow');
        if (!menu) return;
        
        var isHidden = menu.classList.toggle('hidden');
        if (btn) btn.setAttribute('aria-expanded', !isHidden);
        if (arrow) {
          if (isHidden) {
            arrow.classList.remove('rotate-180');
          } else {
            arrow.classList.add('rotate-180');
          }
        }
      }

      // Apply saved preferences immediately to avoid layout shifts or color flashes
      (function() {
        try {
          var savedSize = localStorage.getItem('preferred-font-size');
          if (savedSize) {
            document.documentElement.style.fontSize = savedSize;
          }
          var savedContrast = localStorage.getItem('high-contrast');
          if (savedContrast === 'true') {
            document.documentElement.classList.add('high-contrast');
          }
          
          // Apply initial preferred language label
          var preferredLang = localStorage.getItem('preferredLanguage') || 'en';
          var labels = {
            'en': 'English',
            'hi': 'हिन्दी',
            'ur': 'اردو',
            'ks': 'کٲشُر',
            'doi': 'डোগরী'
          };
          var labelText = labels[preferredLang] || 'English';
          
          document.addEventListener('DOMContentLoaded', function() {
            var labelEl = document.getElementById('current-lang-label');
            if (labelEl) labelEl.textContent = labelText;
            
            var btn = document.getElementById('lang-dropdown-btn');
            if (btn) {
              btn.addEventListener('click', toggleLangDropdown);
            }
            
            // Close dropdown when clicking outside
            window.addEventListener('click', function(e) {
              var menu = document.getElementById('lang-dropdown-menu');
              var btn = document.getElementById('lang-dropdown-btn');
              var arrow = document.getElementById('lang-arrow');
              if (menu && !menu.classList.contains('hidden')) {
                if (btn && !btn.contains(e.target) && !menu.contains(e.target)) {
                  menu.classList.add('hidden');
                  btn.setAttribute('aria-expanded', 'false');
                  if (arrow) arrow.classList.remove('rotate-180');
                }
              }
            });
          });
        } catch (e) {}
      })();
    </script>
  </head>
  <body class="min-h-screen flex flex-col bg-slate-50 text-slate-800 font-sans transition-colors duration-150">
    
    <!-- Skip to Main Content Link (GIGW Mandatory) -->
    <a href="#main-content" class="skip-link">Skip to Main Content</a>

    <header class="bg-[#EAF4FF] border-b-2 border-[#0B4F9C] shadow-sm">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4 flex items-center justify-between">
        <!-- Left Logo -->
        <a href="/" class="flex-shrink-0 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#0B4F9C] rounded p-1 lg:-ml-[22px]" aria-label="JKSPDCL Home">
          <img src="/logo.png" alt="JKSPDCL Logo" class="h-14 w-auto object-contain" />
        </a>

        <!-- Centered Organization Name -->
        <div class="flex-1 text-center px-4">
          <h1 class="text-lg md:text-2xl font-bold text-[#0B4F9C] leading-tight">
            Jammu &amp; Kashmir State Power Development Corporation Limited
          </h1>
          <p class="text-sm md:text-base font-bold text-[#0B4F9C] mt-0.5">(JKSPDCL)</p>
          <p class="text-sm md:text-base font-bold text-[#0B4F9C] mt-1" lang="hi">
            जम्मू और कश्मीर राज्य विद्युत विकास निगम लिमिटेड (जेकेएसपीडीसीएल)
          </p>
        </div>

        <!-- Right Accessibility Controls & Search Bar -->
        <div class="flex flex-col items-end gap-2 flex-shrink-0">
          <!-- Accessibility Controls -->
          <div class="flex items-center gap-2.5 text-xs text-slate-700 select-none">
            <!-- Font Sizing -->
            <div class="flex items-center gap-1" aria-label="Font Size Controls" role="group">
              <button class="flex items-center gap-1 px-1.5 py-0.5 bg-white hover:bg-slate-100 border border-slate-300 rounded text-[10px] font-bold text-slate-700 transition-colors cursor-pointer" onclick="adjustFontSize('dec')" aria-label="Decrease Font Size" title="Decrease Font Size">
                <Icon name="minus" size={8} strokeWidth={2.5} /> A
              </button>
              <button class="flex items-center px-2 py-0.5 bg-white hover:bg-slate-100 border border-slate-300 rounded text-[10px] font-bold text-slate-700 transition-colors cursor-pointer" onclick="adjustFontSize('reset')" aria-label="Reset Font Size" title="Reset Font Size">A</button>
              <button class="flex items-center gap-1 px-1.5 py-0.5 bg-white hover:bg-slate-100 border border-slate-300 rounded text-[10px] font-bold text-slate-700 transition-colors cursor-pointer" onclick="adjustFontSize('inc')" aria-label="Increase Font Size" title="Increase Font Size">
                <Icon name="plus" size={8} strokeWidth={2.5} /> A
              </button>
            </div>
            <span class="text-slate-300">|</span>
            <!-- Contrast Switcher -->
            <button class="flex items-center gap-1.5 px-2 py-0.5 bg-white hover:bg-slate-100 border border-slate-300 rounded text-[9px] font-bold text-slate-700 transition-colors cursor-pointer" onclick="toggleHighContrast()" aria-label="Toggle High Contrast Mode">
              <Icon name="contrast" size={10} strokeWidth={2.5} /> Contrast
            </button>
            <span class="text-slate-300">|</span>
            <!-- Custom Language Selector Dropdown -->
            <div class="relative inline-block text-left select-none dont-translate z-[9999]" id="custom-language-selector">
              <button
                id="lang-dropdown-btn"
                type="button"
                class="flex items-center gap-1 px-2.5 py-0.5 bg-white hover:bg-slate-100 border border-slate-300 rounded text-[9px] font-bold text-slate-700 transition-colors cursor-pointer focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-slate-400"
                aria-expanded="false"
                aria-haspopup="true"
              >
                <Icon name="globe" size={10} strokeWidth={2.5} />
                <span id="current-lang-label">English</span>
                <svg class="w-2 h-2 ml-0.5 transition-transform duration-200" id="lang-arrow" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7"></path>
                </svg>
              </button>
              
              <div
                id="lang-dropdown-menu"
                class="absolute right-0 mt-1 w-32 bg-white text-slate-800 rounded shadow-xl border border-slate-200/85 hidden z-[9999] py-1 text-left"
                role="menu"
                aria-orientation="vertical"
                aria-labelledby="lang-dropdown-btn"
              >
                <button class="w-full text-left px-3 py-1.5 text-[10px] hover:bg-slate-100 font-semibold transition-colors block cursor-pointer" role="menuitem" onclick="changeLanguage('en')">English</button>
                <button class="w-full text-left px-3 py-1.5 text-[10px] hover:bg-slate-100 font-semibold transition-colors block cursor-pointer" role="menuitem" onclick="changeLanguage('hi')">हिन्दी (Hindi)</button>
                <button class="w-full text-left px-3 py-1.5 text-[10px] hover:bg-slate-100 font-semibold transition-colors block cursor-pointer" role="menuitem" onclick="changeLanguage('ur')">اردو (Urdu)</button>
                <button class="w-full text-left px-3 py-1.5 text-[10px] hover:bg-slate-100 font-semibold transition-colors block cursor-pointer" role="menuitem" onclick="changeLanguage('ks')">کٲشُر (Kashmiri)</button>
                <button class="w-full text-left px-3 py-1.5 text-[10px] hover:bg-slate-100 font-semibold transition-colors block cursor-pointer" role="menuitem" onclick="changeLanguage('doi')">डोगरी (Dogri)</button>
              </div>
            </div>
          </div>

          <!-- Search Form -->
          <form action="/search" method="GET" class="flex items-center gap-1 w-full justify-end">
            <label for="header-search" class="sr-only">Search portal pages</label>
            <input 
              type="search" 
              name="q" 
              id="header-search" 
              placeholder="Search…" 
              class="bg-white hover:bg-slate-50 focus-visible:bg-white text-xs text-slate-850 focus-visible:text-slate-900 px-3 py-2 rounded border border-slate-300 focus-visible:border-[#0B4F9C] focus-visible:outline-none transition-[background-color,border-color,color] duration-150 w-36 lg:w-44 placeholder-slate-400 shadow-sm" 
              required
            />
            <button type="submit" class="p-2 bg-[#0B4F9C] hover:bg-[#084A8F] rounded text-xs text-white font-bold flex items-center justify-center border border-transparent transition-[background-color,border-color] duration-150 shadow-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#0B4F9C]/50 cursor-pointer" aria-label="Submit Search">
              <Icon name="search" size={14} strokeWidth={2.5} />
            </button>
          </form>
        </div>
      </div>

      <!-- Live News Ticker Bar (Placed between organization heading and navigation menu bar) -->
      <div class="bg-[#08305C] text-white relative overflow-hidden border-t border-b border-[#0B4F9C]/30" aria-live="polite" aria-label="Live announcements">
        <div class="flex items-stretch" style="max-width:100%;">
          <div class="shrink-0 bg-[#C62828] text-white text-xs font-bold px-4 flex items-center gap-2 uppercase tracking-wide z-20" style="white-space:nowrap;">
            <span class="w-2 h-2 rounded-full bg-white animate-slow-pulse" style="display:inline-block;flex-shrink:0;"></span>
            Live
