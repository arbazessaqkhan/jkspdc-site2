                  <h3 class="font-bold text-xs uppercase tracking-wider text-[#0B4F9C] border-b border-slate-100 pb-1.5 mb-2">Investors</h3>
                  <ul class="flex flex-col gap-1 text-xs">
                    <li><a href="/stakeholders/investors/chairman-statement" class="block p-1.5 rounded hover:bg-slate-100 hover:text-[#0B4F9C]">Chairman's Statement</a></li>
