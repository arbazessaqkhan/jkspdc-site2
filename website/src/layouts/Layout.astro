---
import '../styles/global.css';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon.astro';
import Ticker from '../components/Ticker.astro';

interface Props {
  title: string;
  description: string;
  canonicalUrl?: string;
  isHome?: boolean;
}

const { title, description, canonicalUrl, isHome = false } = Astro.props;
const canonical = canonicalUrl || Astro.url.href;
const currentYear = new Date().getFullYear();
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';

const NAV_ITEMS = [
  { key: 'home', label: 'Home', href: '/' },
  {
    key: 'about',
    label: 'About Us',
    children: [
      { label: 'About Us', href: '/about-us/explore/overview' },
      { label: 'MoA & AoA', href: '/about-us/explore/association-memorandum' },
      { label: 'Organizational Structure', href: '/about-us/explore/organization-chart' },
      { label: 'Board Of Director', href: '/about-us/management/board' },
      { label: 'GSTIN Registration Details', href: '/about-us/explore/gstin-registration' },
      { label: 'Policies', href: '/about-us/explore/policies' },
      { label: 'CSR Policy', href: '/sustainability/csr/policy' },
    ],
  },
  {
    key: 'projects',
    label: 'Projects',
    children: [
      { label: 'Operational Projects', href: '/our-business/power-stations' },
      { label: 'Projects Under Construction', href: '/our-business/construction' },
      { label: 'Upcoming Projects', href: '/our-business/under-development' },
    ],
  },
  {
    key: 'tenders',
    label: 'Tenders',
    children: [
      { label: 'Live Tenders & Notices', href: '/stakeholders/vendors/tender-bids' },
      { label: 'JK Tenders Portal', href: 'https://jktenders.gov.in/nicgep/app', external: true },
    ],
  },
  { key: 'notifications', label: 'Notifications', href: '/notifications' },
  {
    key: 'investors',
    label: 'Investors Corner',
    children: [
      { label: 'Annual General Meetings', href: '/stakeholders/investors/agm' },
      { label: 'IPP Projects', href: '/stakeholders/investors/ipp-projects' },
    ],
  },
  {
    key: 'rti',
    label: 'RTI',
    children: [{ label: 'RTI Act (Sec 4)', href: '/about-us/explore/rti' }],
  },
  { key: 'gallery', label: 'Gallery', href: '/media/gallery' },
  { key: 'downloads', label: 'Downloads', href: '/media/downloads' },
  {
    key: 'employees',
    label: 'Employees Corner',
    alignRight: true,
    children: [
      { label: 'Web Mail', href: 'https://www.jkspdcl.com:2096/', external: true },
      { label: 'Nic-e-File', href: 'https://saccess.nic.in/', external: true },
      { label: 'E-Office', href: 'https://eoffice.jk.gov.in/', external: true },
      { label: 'JKHRMS', href: 'https://hrms.jk.gov.in/', external: true },
      { label: 'EETMS', href: 'https://law.pmgatishakti.gov.in/EETMS/login', external: true },
      { label: 'BG Management', href: 'https://bg.jkspdc.in/', external: true },
      { label: 'Asset Management', href: 'https://asset.jkspdcl.co.in/login', external: true },
      {
        label: 'JKSPDC RAS',
        href: 'https://janparichay.meripehchaan.gov.in/v1/pehchaan/login.html?service=passive&active=true&rm_5=false&continue=https%3A%2F%2Fjan_com%2Fmail%2F&pp=1&scc=1&lmpl=default&ltmplcache=2&emr=1&osid=1&flowName=GlifWebSignIn&flowEntry=ServiceLogin&sid=JanSugamJK&v=2.0&lang=&urlid=82ae2068-ada6-4154-ae21-649b90598534',
        external: true,
      },
    ],
  },
  {
    key: 'contact',
    label: 'Contact Us',
    alignRight: true,
    children: [
      { label: 'Contact Us', href: '/about-us/others/contact' },
      { label: 'Feedback', href: '/feedback' },
    ],
  },
];

function isSublinkActive(href: string): boolean {
  if (!href || href.startsWith('http')) return false;
  const clean = href.replace(/\/$/, '');
  return currentPath === clean || currentPath.startsWith(clean + '/') || currentPath.startsWith(clean + '?');
}

function isSectionActive(section: string): boolean {
  if (section === 'home') return currentPath === '/' || isHome;
  if (section === 'about') {
    return (currentPath.startsWith('/about-us') || currentPath.startsWith('/sustainability/csr')) && 
           !currentPath.includes('/about-us/explore/rti') && 
           !currentPath.includes('/about-us/others/contact');
  }
  if (section === 'projects') return currentPath.startsWith('/our-business') || currentPath.startsWith('/power-trading');
  if (section === 'tenders') return currentPath.startsWith('/stakeholders/vendors') || currentPath.startsWith('/tenders');
  if (section === 'notifications') return currentPath.startsWith('/notifications');
  if (section === 'investors') return currentPath.startsWith('/stakeholders/investors');
  if (section === 'rti') return currentPath.includes('/rti');
  if (section === 'gallery') return currentPath.startsWith('/media/gallery');
  if (section === 'downloads') return currentPath.startsWith('/media/downloads');
  if (section === 'employees') return currentPath.startsWith('/employees');
  if (section === 'contact') return currentPath.includes('/contact') || currentPath === '/feedback';
  return false;
}

---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | JKSPDC Official Portal</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <!-- GIGW 3.0 — Last reviewed/updated meta -->
    <meta name="last-modified" content={new Date().toISOString().split('T')[0]} />
    <meta name="author" content="Jammu & Kashmir State Power Development Corporation Limited" />
    <meta name="publisher" content="JKSPDC — Government of Jammu & Kashmir" />
    
    <!-- GIGW SEO & Browser Compatibility -->
    <meta name="robots" content="index, follow" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <link rel="icon" type="image/png" href="/logo.png" />
    <!-- Google Fonts: Noto Sans (Regular 400, Medium 500, Semi Bold 600, Bold 700) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans:ital,wght@0,400;0,500;0,600;0,700;0,800;1,400;1,500;1,600;1,700&family=Noto+Sans+Devanagari:wght@400;500;600;700&display=swap" rel="stylesheet" />
    
    <!-- API base URL for inline scripts -->
    <script is:inline define:vars={{ apiBase: import.meta.env.PUBLIC_API_BASE }}>window.__API_BASE__ = apiBase;</script>

    <!-- Custom Translation Utility -->
    <script src="/js/translation.js" is:inline></script>

    <!-- Custom styling for high contrast mode & animations -->
    <style is:global>
      .high-contrast,
      .high-contrast * {
        background-color: #000000 !important;
        background-image: none !important;
        color: #ffff00 !important;
        border-color: #ffff00 !important;
        box-shadow: none !important;
      }
      .high-contrast a,
      .high-contrast button {
        color: #ffff00 !important;
        text-decoration: underline !important;
      }
      .high-contrast a:hover,
      .high-contrast button:hover {
        background-color: #333333 !important;
        color: #ffffff !important;
      }
      .high-contrast .border-glow-overlay,
      .high-contrast .border-glow-overlay::before,
      .high-contrast .border-glow-overlay::after {
        display: none !important;
      }

      /* ── Slow pulse for status dots ────────────────────────────── */
      @keyframes slow-pulse {
        0%, 100% { opacity: 1; }
        50%       { opacity: 0.35; }
      }
      .animate-slow-pulse {
        animation: slow-pulse 2.5s ease-in-out infinite;
      }

      /* ── Hide Bhashini default widget elements ── */
      #bhashini-translation,
      .bhashini-feedback-modal,
      .bhashini-feedback-div,
      .bhashini-toast {
        display: none !important;
      }

      /* ── Navigation Menu Dropdown Toggle (Click / Keyboard + Hover fallback) ── */
      .nav-dropdown-item:hover > .nav-dropdown-menu:not(.is-closed),
      .nav-dropdown-item.is-open > .nav-dropdown-menu {
        display: block !important;
      }

      .nav-dropdown-item.is-closed > .nav-dropdown-menu {
        display: none !important;
      }

      .nav-dropdown-item:hover .dropdown-arrow:not(.is-arrow-closed),
      .nav-dropdown-item.is-open .dropdown-arrow {
        transform: rotate(180deg);
      }

      .nav-dropdown-item.is-closed .dropdown-arrow {
        transform: rotate(0deg) !important;
      }

      /* ── Nav Item Active & Interactive Highlight System ──── */
      .nav-dropdown-item:hover > .nav-dropdown-btn:not(.nav-item-active),
      .nav-dropdown-item.is-open > .nav-dropdown-btn:not(.nav-item-active),
      .nav-link:hover:not(.nav-item-active) {
        background-color: rgba(255, 255, 255, 0.12) !important;
        border-bottom-color: rgba(255, 255, 255, 0.7) !important;
      }

      .nav-item-active,
      .nav-dropdown-btn.nav-item-active,
      .nav-dropdown-item.is-open > .nav-dropdown-btn.nav-item-active,
      .nav-dropdown-item:hover > .nav-dropdown-btn.nav-item-active {
        border-bottom-color: #52B5E8 !important;
        border-bottom-width: 3px !important;
        border-bottom-style: solid !important;
        background-color: rgba(255, 255, 255, 0.14) !important;
        color: #ffffff !important;
      }

      .nav-sublink-active {
        background-color: #F4F8FB !important;
        color: #0B3B60 !important;
        font-weight: 700 !important;
        border-left: 4px solid #0B3B60 !important;
      }

      .desktop-nav-list {
        overflow: visible;
      }
    </style>

    <!-- GIGW Accessibility & Preference persistence scripts -->
    <script is:inline>
      function adjustFontSize(action) {
        var html = document.documentElement;
        var cur = parseFloat(window.getComputedStyle(html).fontSize) || 17;
        var nextSize = cur;
        if (action === 'inc') {
          if (cur < 24) nextSize = cur + 1;
        } else if (action === 'dec') {
          if (cur > 12) nextSize = cur - 1;
        } else {
          nextSize = 17;
        }
        var sizeStr = nextSize + 'px';
        html.style.fontSize = sizeStr;
        try {
          localStorage.setItem('preferred-font-size', sizeStr);
        } catch (e) {}
        if (typeof window.__checkDesktopNavOverflow === 'function') {
          window.__checkDesktopNavOverflow();
        }
      }

      function toggleHighContrast() {
        var html = document.documentElement;
        var isDark = html.classList.toggle('high-contrast');
        try {
          localStorage.setItem('high-contrast', isDark ? 'true' : 'false');
        } catch (e) {}
      }

      function changeLanguage(langCode) {
        try {
          localStorage.setItem('preferredLanguage', langCode);
          window.location.reload();
        } catch (e) {}
      }

      function toggleLangDropdown(event, suffix) {
        if (event) {
          event.preventDefault();
          event.stopPropagation();
        }
        var s = suffix || '';
        var menu = document.getElementById('lang-dropdown-menu' + s);
        var btn = document.getElementById('lang-dropdown-btn' + s);
        var arrow = document.getElementById('lang-arrow' + s);
        if (!menu) return;
        
        // Immediately close and clear search suggestions if open
        var searchSuggestions = document.getElementById('header-search-suggestions');
        if (searchSuggestions) {
          searchSuggestions.innerHTML = '';
          searchSuggestions.classList.add('hidden');
        }

        var isHidden = menu.classList.toggle('hidden');
        if (btn) btn.setAttribute('aria-expanded', String(!isHidden));
        if (arrow) {
          if (isHidden) {
            arrow.classList.remove('rotate-180');
          } else {
            arrow.classList.add('rotate-180');
          }
        }
      }
      window.toggleLangDropdown = toggleLangDropdown;
      window.toggleLanguageDropdown = toggleLangDropdown;

      (function() {
        try {
          var savedSize = localStorage.getItem('preferred-font-size');
          if (savedSize) {
            document.documentElement.style.fontSize = savedSize;
          }
          var savedContrast = localStorage.getItem('high-contrast');
          if (savedContrast === 'true') {
            document.documentElement.classList.add('high-contrast');
          }
          
          var preferredLang = localStorage.getItem('preferredLanguage') || 'en';
          var labels = {
            'en': 'English',
            'hi': 'हिन्दी',
            'ur': 'اردو',
            'ks': 'کٲشُر',
            'doi': 'डोगरी'
          };
          var labelText = labels[preferredLang] || 'English';
          
          document.addEventListener('DOMContentLoaded', function() {
            document.querySelectorAll('.lang-label-text').forEach(function(el) {
              el.textContent = labelText;
            });
            
            // Overflow fallback guard: if desktop nav overflows horizontally (+A / Hindi), switch cleanly to drawer
            function checkDesktopNavOverflow() {
              var htmlEl = document.documentElement;
              if (window.innerWidth < 1200) {
                htmlEl.classList.remove('nav-force-drawer');
                return;
              }
              htmlEl.classList.remove('nav-force-drawer');
              var ul = document.getElementById('desktop-nav-list');
              if (ul && ul.scrollWidth > ul.clientWidth + 2) {
                htmlEl.classList.add('nav-force-drawer');
              }
            }
            window.__checkDesktopNavOverflow = checkDesktopNavOverflow;
            checkDesktopNavOverflow();
            if (document.fonts && document.fonts.ready) {
              document.fonts.ready.then(checkDesktopNavOverflow);
            }

            // Desktop Navigation Menu Toggle & Smart Viewport Edge Alignment + Keyboard Support
            var navItems = document.querySelectorAll('.nav-dropdown-item');
            
            function positionDropdown(item) {
              var menu = item.querySelector('.nav-dropdown-menu');
              if (!menu) return;
              var rect = item.getBoundingClientRect();
              var windowWidth = window.innerWidth || document.documentElement.clientWidth;
              var itemCenter = rect.left + (rect.width / 2);

              menu.style.position = 'fixed';
              menu.style.top = rect.bottom + 'px';
              menu.style.zIndex = '9999';

              if (itemCenter > windowWidth / 2) {
                menu.style.left = 'auto';
                menu.style.right = Math.max(8, windowWidth - rect.right) + 'px';
              } else {
                menu.style.left = Math.max(8, rect.left) + 'px';
                menu.style.right = 'auto';
              }
            }

            function closeAllDesktopDropdowns(exceptItem) {
              navItems.forEach(function(other) {
                if (other !== exceptItem) {
                  other.classList.remove('is-open');
                  other.classList.add('is-closed');
                  var otherBtn = other.querySelector('.nav-dropdown-btn');
                  if (otherBtn) otherBtn.setAttribute('aria-expanded', 'false');
                }
              });
            }

            function updateAllDropdownPositions() {
              navItems.forEach(positionDropdown);
            }

            updateAllDropdownPositions();
            window.addEventListener('resize', function() {
              checkDesktopNavOverflow();
              updateAllDropdownPositions();
            });
            window.addEventListener('scroll', updateAllDropdownPositions, { passive: true });

            navItems.forEach(function(item) {
              var btn = item.querySelector('.nav-dropdown-btn');
              var menu = item.querySelector('.nav-dropdown-menu');
              if (!btn || !menu) return;

              item.addEventListener('mouseenter', function() {
                positionDropdown(item);
              });

              btn.addEventListener('click', function(e) {
                e.preventDefault();
                e.stopPropagation();
                positionDropdown(item);
                var isClosed = item.classList.contains('is-closed');
                var isOpen = item.classList.contains('is-open');
                var isShowing = isOpen || (!isClosed && window.getComputedStyle(menu).display !== 'none');

                closeAllDesktopDropdowns(item);

                if (isShowing) {
                  item.classList.remove('is-open');
                  item.classList.add('is-closed');
                  btn.setAttribute('aria-expanded', 'false');
                } else {
                  item.classList.remove('is-closed');
                  item.classList.add('is-open');
                  btn.setAttribute('aria-expanded', 'true');
                }
              });

              // Keyboard: Enter/Space toggles, Escape closes & restores focus to button
              item.addEventListener('keydown', function(e) {
                if (e.key === 'Escape') {
                  item.classList.remove('is-open');
                  item.classList.add('is-closed');
                  btn.setAttribute('aria-expanded', 'false');
                  btn.focus();
                } else if ((e.key === ' ' || e.key === 'Enter') && e.target === btn) {
                  e.preventDefault();
                  btn.click();
                }
              });

              item.addEventListener('focusout', function(e) {
                if (!item.contains(e.relatedTarget)) {
                  item.classList.remove('is-open');
                  item.classList.add('is-closed');
                  btn.setAttribute('aria-expanded', 'false');
                }
              });

              item.addEventListener('mouseleave', function() {
                item.classList.remove('is-closed');
                item.classList.remove('is-open');
                btn.setAttribute('aria-expanded', 'false');
              });
            });

            // Close dropdowns when clicking outside
            window.addEventListener('click', function(e) {
              navItems.forEach(function(item) {
                if (!item.contains(e.target)) {
                  item.classList.remove('is-open');
                  item.classList.add('is-closed');
                  var btn = item.querySelector('.nav-dropdown-btn');
                  if (btn) btn.setAttribute('aria-expanded', 'false');
                }
              });
              ['', '-mob'].forEach(function(s) {
                var menu = document.getElementById('lang-dropdown-menu' + s);
                var btn = document.getElementById('lang-dropdown-btn' + s);
                var arrow = document.getElementById('lang-arrow' + s);
                if (menu && !menu.classList.contains('hidden')) {
                  if (btn && !btn.contains(e.target) && !menu.contains(e.target)) {
                    menu.classList.add('hidden');
                    btn.setAttribute('aria-expanded', 'false');
                    if (arrow) arrow.classList.remove('rotate-180');
                  }
                }
              });
            });
          });
        } catch (e) {}
      })();
    </script>
  </head>
  <body class="min-h-screen flex flex-col bg-slate-50 text-slate-800 font-sans transition-colors duration-150">
    <!-- Skip to Main Content Link (GIGW Mandatory) -->
    <a href="#main-content" class="skip-link">Skip to Main Content</a>

    <!-- noscript fallback for JavaScript-dependent features (WCAG) -->
    <noscript>
      <div class="flex items-center justify-center gap-1.5" style="background:#f59e0b;color:#1e293b;text-align:center;padding:8px 16px;font-size:12px;font-weight:600;border-bottom:2px solid #d97706;" role="alert">
        <Icon name="alert-triangle" size={14} class="text-amber-950 shrink-0" />
        <span>JavaScript is disabled. Some features (language translation, search autocomplete) require JavaScript. Core content remains accessible.</span>
      </div>
    </noscript>

    <!-- Desktop Header (1200px+, aligned to .site-container) -->
    <header class="desktop-brand-bar hidden min-[1200px]:block bg-white border-t-[3px] border-[#0B3B60] border-b border-slate-200/90 shadow-2xs relative z-[60]">
      <div class="site-container py-2.5 flex items-center justify-between gap-6">
        <!-- Left: Official Institutional Identity Lockup -->
        <div class="flex items-center gap-4 min-w-0 flex-1">
          <a href="/" class="flex-shrink-0 group focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#0B3B60] rounded-lg p-0.5 transition-transform duration-150 hover:scale-[1.02]" aria-label="JKSPDCL Official Portal Home">
            <img src="/logo.png" alt="JKSPDCL Official Emblem" width="64" height="64" fetchpriority="high" loading="eager" class="h-15 w-auto object-contain" />
          </a>
          <div class="w-px h-12 bg-slate-200/90 shrink-0"></div>
          <div class="flex flex-col min-w-0 justify-center text-left">
            <h1 class="font-extrabold text-[#002B49] text-[1.1rem] xl:text-[1.18rem] leading-tight tracking-tight">
              Jammu &amp; Kashmir State Power Development Corporation Limited
            </h1>
            <div class="flex items-center gap-2 mt-0.5 flex-wrap">
              <span class="text-slate-600 font-semibold text-[0.75rem] tracking-wide">A Government of J&amp;K Undertaking</span>
              <span class="text-slate-300">•</span>
              <span class="text-[#0B3B60] font-bold text-[0.75rem]">(JKSPDCL)</span>
            </div>
            <p class="text-slate-700 font-medium text-[0.78rem] leading-snug mt-0.5 font-devanagari" lang="hi">
              जम्मू और कश्मीर राज्य विद्युत विकास निगम लिमिटेड (जेकेएसपीडीसीएल)
            </p>
          </div>
        </div>

        <!-- Right: Accessibility Controls & Search -->
        <div class="flex flex-col items-end gap-2 shrink-0">
          <div class="flex items-center justify-end gap-2 text-xs text-slate-700 select-none">
            <div class="inline-flex items-center bg-slate-100/90 hover:bg-slate-100 p-0.5 rounded-lg border border-slate-200/80 shadow-2xs" role="group" aria-label="Font Size Controls">
              <button type="button" class="flex items-center gap-0.5 px-2 py-1 bg-transparent hover:bg-white text-slate-700 hover:text-[#0B3B60] rounded-md text-[0.7rem] font-bold transition-all cursor-pointer" onclick="adjustFontSize('dec')" aria-label="Decrease Font Size" title="Decrease font size (-A)">
                <Icon name="minus" size={8} strokeWidth={2.5} /> A
              </button>
              <div class="w-px h-3.5 bg-slate-200"></div>
              <button type="button" class="px-2.5 py-1 bg-transparent hover:bg-white text-slate-700 hover:text-[#0B3B60] rounded-md text-[0.7rem] font-bold transition-all cursor-pointer" onclick="adjustFontSize('reset')" aria-label="Reset Font Size" title="Reset font size (A)">A</button>
              <div class="w-px h-3.5 bg-slate-200"></div>
              <button type="button" class="flex items-center gap-0.5 px-2 py-1 bg-transparent hover:bg-white text-slate-700 hover:text-[#0B3B60] rounded-md text-[0.7rem] font-bold transition-all cursor-pointer" onclick="adjustFontSize('inc')" aria-label="Increase Font Size" title="Increase font size (+A)">
                <Icon name="plus" size={8} strokeWidth={2.5} /> A
              </button>
            </div>
            <button type="button" class="inline-flex items-center gap-1.5 px-2.5 py-1 bg-slate-100/90 hover:bg-white text-slate-700 hover:text-[#0B3B60] border border-slate-200/80 rounded-lg text-[0.7rem] font-bold transition-all cursor-pointer" onclick="toggleHighContrast()" aria-label="Toggle High Contrast Mode" title="Toggle high contrast">
              <Icon name="eye" size={12} strokeWidth={2.2} class="text-[#0B3B60]" />
              <span>Contrast</span>
            </button>
            <div class="relative" id="lang-dropdown-wrapper">
              <button type="button" id="lang-dropdown-btn" class="inline-flex items-center gap-1.5 px-2.5 py-1 bg-slate-100/90 hover:bg-white text-slate-700 hover:text-[#0B3B60] border border-slate-200/80 rounded-lg text-[0.7rem] font-bold transition-all cursor-pointer" aria-haspopup="true" aria-expanded="false" aria-controls="lang-dropdown-menu" onclick="toggleLangDropdown(event)" title="Select language">
                <Icon name="globe" size={12} strokeWidth={2.2} class="text-[#0B3B60]" />
                <span class="lang-label-text">English</span>
                <Icon name="chevron-down" size={10} strokeWidth={2.5} class="text-slate-400" id="lang-arrow" />
              </button>
              <div id="lang-dropdown-menu" class="absolute right-0 mt-1.5 w-44 bg-white text-slate-800 rounded-lg shadow-xl border border-slate-200/90 hidden z-[10000] py-1 text-left" role="menu" aria-orientation="vertical" aria-labelledby="lang-dropdown-btn">
                <button class="w-full text-left px-3 py-1.5 text-xs hover:bg-slate-50 hover:text-[#0B3B60] font-semibold block cursor-pointer" role="menuitem" onclick="changeLanguage('en')">English</button>
