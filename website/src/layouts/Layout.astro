---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon.astro';

interface Props {
  title: string;
  description: string;
  canonicalUrl?: string;
  isHome?: boolean;
}

const { title, description, canonicalUrl, isHome = false } = Astro.props;
const canonical = canonicalUrl || Astro.url.href;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | JKSPDC Official Portal</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    
    <!-- GIGW SEO & Browser Compatibility -->
    <meta name="robots" content="index, follow" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <link rel="icon" type="image/png" href="/logo.png" />
    <!-- Google Fonts: Noto Sans for Hindi support -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans:ital,wght@0,400;0,500;0,600;0,700;0,800;1,400&family=Noto+Sans+Devanagari:wght@400;500;600;700&display=swap" rel="stylesheet" />
    
    <!-- Custom Translation Utility -->
    <script src="/js/translation.js" is:inline></script>

    <!-- Custom styling for high contrast mode & animations -->
    <style is:global>
      .high-contrast,
      .high-contrast * {
        background-color: #000000 !important;
        background-image: none !important;
        color: #ffff00 !important;
        border-color: #ffff00 !important;
        box-shadow: none !important;
      }
      .high-contrast a,
      .high-contrast button {
        color: #ffff00 !important;
        text-decoration: underline !important;
      }
      .high-contrast a:hover,
      .high-contrast button:hover {
        background-color: #333333 !important;
        color: #ffffff !important;
      }

      /* ── Ticker scroll animation ───────────────────────────────── */
      @keyframes ticker-scroll {
        0%   { transform: translateX(0); }
        100% { transform: translateX(-50%); }
      }
      .animate-ticker {
        display: flex;
        white-space: nowrap;
        animation: ticker-scroll 35s linear infinite;
        will-change: transform;
      }
      .animate-ticker:hover {
        animation-play-state: paused;
      }

      /* ── Slow pulse for status dots ────────────────────────────── */
      @keyframes slow-pulse {
        0%, 100% { opacity: 1; }
        50%       { opacity: 0.35; }
      }
      .animate-slow-pulse {
        animation: slow-pulse 2.5s ease-in-out infinite;
      }

      /* ── Hide Bhashini default widget elements ── */
      #bhashini-translation,
      .bhashini-feedback-modal,
      .bhashini-feedback-div,
      .bhashini-toast {
        display: none !important;
      }
    </style>

    <!-- GIGW Accessibility & Preference persistence scripts -->
    <script is:inline>
      function adjustFontSize(action) {
        var html = document.documentElement;
        var cur = parseFloat(window.getComputedStyle(html).fontSize) || 16;
        var nextSize = cur;
        if (action === 'inc') {
          if (cur < 24) nextSize = cur + 1;
        } else if (action === 'dec') {
          if (cur > 12) nextSize = cur - 1;
        } else {
          nextSize = 16;
        }
        var sizeStr = nextSize + 'px';
        html.style.fontSize = sizeStr;
        try {
          localStorage.setItem('preferred-font-size', sizeStr);
        } catch (e) {}
      }

      function toggleHighContrast() {
        var html = document.documentElement;
        var isDark = html.classList.toggle('high-contrast');
        try {
          localStorage.setItem('high-contrast', isDark ? 'true' : 'false');
        } catch (e) {}
      }

      function changeLanguage(langCode) {
        try {
          localStorage.setItem('preferredLanguage', langCode);
          window.location.reload();
        } catch (e) {}
      }

      function toggleLangDropdown(event) {
        if (event) event.stopPropagation();
        var menu = document.getElementById('lang-dropdown-menu');
        var btn = document.getElementById('lang-dropdown-btn');
        var arrow = document.getElementById('lang-arrow');
        if (!menu) return;
        
        var isHidden = menu.classList.toggle('hidden');
        if (btn) btn.setAttribute('aria-expanded', !isHidden);
        if (arrow) {
          if (isHidden) {
            arrow.classList.remove('rotate-180');
          } else {
            arrow.classList.add('rotate-180');
          }
        }
      }

      (function() {
        try {
          var savedSize = localStorage.getItem('preferred-font-size');
          if (savedSize) {
            document.documentElement.style.fontSize = savedSize;
          }
          var savedContrast = localStorage.getItem('high-contrast');
          if (savedContrast === 'true') {
            document.documentElement.classList.add('high-contrast');
          }
          
          var preferredLang = localStorage.getItem('preferredLanguage') || 'en';
          var labels = {
            'en': 'English',
            'hi': 'हिन्दी',
            'ur': 'اردو',
            'ks': 'کٲشُر',
            'doi': 'डोगरी'
          };
          var labelText = labels[preferredLang] || 'English';
          
          document.addEventListener('DOMContentLoaded', function() {
            var labelEl = document.getElementById('current-lang-label');
            if (labelEl) labelEl.textContent = labelText;
            
            var btn = document.getElementById('lang-dropdown-btn');
            if (btn) {
              btn.addEventListener('click', toggleLangDropdown);
            }
            
            window.addEventListener('click', function(e) {
              var menu = document.getElementById('lang-dropdown-menu');
              var btn = document.getElementById('lang-dropdown-btn');
              var arrow = document.getElementById('lang-arrow');
              if (menu && !menu.classList.contains('hidden')) {
                if (btn && !btn.contains(e.target) && !menu.contains(e.target)) {
                  menu.classList.add('hidden');
                  btn.setAttribute('aria-expanded', 'false');
                  if (arrow) arrow.classList.remove('rotate-180');
                }
              }
            });
          });
        } catch (e) {}
      })();
    </script>
  </head>
  <body class="min-h-screen flex flex-col bg-slate-50 text-slate-800 font-sans transition-colors duration-150">
    
    <!-- Skip to Main Content Link (GIGW Mandatory) -->
    <a href="#main-content" class="skip-link">Skip to Main Content</a>

    <!-- Composite Header Component -->
    <Header />

    <!-- Main Content Container -->
    <main id="main-content" class={isHome ? "flex-grow focus:outline-none" : "flex-grow max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-8 focus:outline-none"} tabindex="-1">
      <slot />
    </main>

    <!-- Composite Footer Component -->
    <Footer />

    <!-- Floating Scroll to Top Button -->
    <button
      id="scroll-to-top-btn"
      class="fixed bottom-8 right-8 z-50 bg-[#0B4F9C] hover:bg-[#084A8F] text-white w-12 h-12 rounded-full shadow-2xl flex items-center justify-center transition-all duration-300 opacity-0 pointer-events-none focus:outline-none focus:ring-2 focus:ring-[#BDD7EE] border-2 border-white/20 hover:scale-110"
      aria-label="Scroll to top of page"
    >
      <Icon name="arrow-up" size={20} strokeWidth={2.5} />
    </button>

    <!-- Scroll to Top Script -->
    <script is:inline>
      (function () {
        var btn = document.getElementById('scroll-to-top-btn');
        if (!btn) return;
        function onScroll() {
          if (window.scrollY > 300) {
            btn.style.opacity = '1';
            btn.style.pointerEvents = 'auto';
          } else {
            btn.style.opacity = '0';
            btn.style.pointerEvents = 'none';
          }
        }
        window.addEventListener('scroll', onScroll, { passive: true });
        btn.addEventListener('click', function () {
          window.scrollTo({ top: 0, behavior: 'smooth' });
        });
      })();
    </script>

    <!-- Dropdown positioning helper -->
    <script is:inline>
      (function() {
        function adjustDropdownPosition(li) {
          var dropdown = li.querySelector('div.absolute');
          if (!dropdown) return;
          dropdown.style.left = '';
          dropdown.style.right = '';
          var rect = dropdown.getBoundingClientRect();
          var viewportWidth = window.innerWidth;
          if (rect.right > viewportWidth) {
            dropdown.style.right = '0';
            dropdown.style.left = 'auto';
          } else if (rect.left < 0) {
            dropdown.style.left = '0';
            dropdown.style.right = 'auto';
          }
        }

        document.querySelectorAll('nav li.relative.group').forEach(function(li) {
          li.addEventListener('mouseenter', function() {
            adjustDropdownPosition(li);
          });
          li.addEventListener('focusin', function() {
            adjustDropdownPosition(li);
          });
        });
      })();
    </script>

    <!-- Active Nav Indicator (GIGW 3.0 Requirement) -->
    <script is:inline>
      (function() {
        var path = window.location.pathname;
        var navLinks = document.querySelectorAll('nav a[href]');
        navLinks.forEach(function(link) {
          var href = link.getAttribute('href');
          if (!href || href === '#') return;
          var isActive = (href === '/' && path === '/') || (href !== '/' && path.startsWith(href));
          if (isActive) {
            link.style.borderBottomColor = '#D8681B';
            link.style.borderBottomWidth = '3px';
            link.style.borderBottomStyle = 'solid';
          }
        });
      })();
    </script>

    <!-- Global Header Search Autocomplete -->
    <script is:inline>
      (function() {
        var searchForm = document.getElementById('header-search-form');
        var searchInput = document.getElementById('header-search');
        var suggestionsBox = document.getElementById('header-search-suggestions');
        var searchIndex = [];

        async function loadIndex() {
          try {
            var sitemapRes = await fetch('/search-index.json');
            if (sitemapRes.ok) {
              searchIndex = await sitemapRes.json();
            }
            var projectsRes = await fetch('http://localhost:3000/api/projects');
            if (projectsRes.ok) {
              var projects = await projectsRes.json();
              projects.forEach(function(p) {
                searchIndex.push({
                  title: p.name,
                  url: '/our-business/power-station-details?id=' + p.id,
                  description: 'About ' + p.name + ' - Capacity: ' + p.capacityMw + ' MW, Location: ' + (p.location || 'J&K') + '. Status: ' + p.status + '.'
                });
              });
            }
          } catch(err) {
            console.error('Failed to load sitemap search index:', err);
          }
        }

        function handleInput() {
          var query = searchInput.value.toLowerCase().trim();
          if (!query) {
            suggestionsBox.innerHTML = '';
            suggestionsBox.classList.add('hidden');
            return;
          }

          var matches = searchIndex.filter(function(item) {
            return item.title.toLowerCase().indexOf(query) !== -1 ||
                   item.description.toLowerCase().indexOf(query) !== -1;
          }).slice(0, 8);

          if (matches.length > 0) {
            suggestionsBox.innerHTML = matches.map(function(item) {
              var titleRegex = new RegExp('(' + query.replace(/[-\/\\^$*+?.()|[\]{}]/g, '\\$&') + ')', 'gi');
              var highlightedTitle = item.title.replace(titleRegex, '<mark style="background-color: #fef08a; color: #1e293b; font-weight: 700; padding: 0px 2px; border-radius: 2px;">$1</mark>');
              return '<button type="button" class="w-full text-left px-3 py-1.5 hover:bg-slate-100 transition-colors block cursor-pointer border-b border-slate-50 last:border-0" data-url="' + item.url + '" style="font-size: 11px; outline: none; border-bottom: 1px solid #f1f5f9; display: block; background: transparent; border-left: 0; border-right: 0; border-top: 0; font-family: inherit; margin: 0; padding: 6px 12px; width: 100%;">' +
                     '<span style="color: #0B4F9C; font-weight: 700; display: block;">' + highlightedTitle + '</span>' +
                     '<span style="font-size: 9px; color: #64748b; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; display: block; margin-top: 2px;">' + item.description + '</span>' +
                     '</button>';
            }).join('');
            suggestionsBox.classList.remove('hidden');
          } else {
            suggestionsBox.innerHTML = '';
            suggestionsBox.classList.add('hidden');
          }
        }

        if (searchInput && searchForm && suggestionsBox) {
          searchInput.addEventListener('focus', function() {
            if (searchIndex.length === 0) loadIndex();
          });
          searchInput.addEventListener('input', handleInput);

          suggestionsBox.addEventListener('click', function(e) {
            var btn = e.target.closest('button');
            if (btn && btn.dataset.url) {
              window.location.href = btn.dataset.url;
            }
          });

          document.addEventListener('click', function(e) {
            if (!e.target.closest('#header-search-form')) {
              suggestionsBox.classList.add('hidden');
            }
          });

          searchForm.addEventListener('submit', function(e) {
            e.preventDefault();
            var query = searchInput.value.trim();
            if (!query) return;

            var lowerQuery = query.toLowerCase();
            var bestMatch = null;
            
            for (var i = 0; i < searchIndex.length; i++) {
              if (searchIndex[i].title.toLowerCase() === lowerQuery) {
                bestMatch = searchIndex[i];
                break;
              }
            }
            
            if (!bestMatch) {
              for (var i = 0; i < searchIndex.length; i++) {
                if (searchIndex[i].title.toLowerCase().indexOf(lowerQuery) !== -1) {
                  bestMatch = searchIndex[i];
                  break;
                }
              }
            }

            if (bestMatch) {
              window.location.href = bestMatch.url;
            } else {
              window.location.href = '/search?q=' + encodeURIComponent(query);
            }
          });
        }
      })();
    </script>
  </body>
</html>
