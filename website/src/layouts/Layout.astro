---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon.astro';
import Ticker from '../components/Ticker.astro';

interface Props {
  title: string;
  description: string;
  canonicalUrl?: string;
  isHome?: boolean;
}

const { title, description, canonicalUrl, isHome = false } = Astro.props;
const canonical = canonicalUrl || Astro.url.href;
const currentYear = new Date().getFullYear();
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';

function isSectionActive(section: string): boolean {
  if (section === 'home') return currentPath === '/' || isHome;
  if (section === 'about') {
    return (currentPath.startsWith('/about-us') || currentPath.startsWith('/sustainability/csr')) && 
           !currentPath.includes('/about-us/explore/rti') && 
           !currentPath.includes('/about-us/others/contact');
  }
  if (section === 'projects') return currentPath.startsWith('/our-business') || currentPath.startsWith('/power-trading');
  if (section === 'tenders') return currentPath.startsWith('/stakeholders/vendors') || currentPath.startsWith('/tenders');
  if (section === 'notifications') return currentPath.startsWith('/notifications');
  if (section === 'investors') return currentPath.startsWith('/stakeholders/investors');
  if (section === 'rti') return currentPath.includes('/rti');
  if (section === 'gallery') return currentPath.startsWith('/media/gallery');
  if (section === 'downloads') return currentPath.startsWith('/media/downloads');
  if (section === 'employees') return currentPath.startsWith('/employees');
  if (section === 'contact') return currentPath.includes('/contact') || currentPath === '/feedback';
  return false;
}

function getDocUrl(url?: string) {
  if (!url) return undefined;
  if (url.startsWith('/uploads/')) {
    return `${import.meta.env.PUBLIC_API_BASE}${url}`;
  }
  return url;
}

function isDocUrl(url?: string) {
  if (!url) return false;
  return (
    url.includes('/uploads/') ||
    /\.(pdf|docx?|xlsx?|pptx?|zip|rar|csv)$/i.test(url) ||
    (url.startsWith('http') && url.includes('/uploads/'))
  );
}

// Dynamically fetch ticker items from the public APIs (GIGW 3.0: Recent Active Tenders & Notices)
let tickerItems: any[] = [];
try {
  const [tendersRes, notifsRes] = await Promise.all([
    fetch(`${import.meta.env.PUBLIC_API_BASE}/api/public/tenders`).catch(() => null),
    fetch(`${import.meta.env.PUBLIC_API_BASE}/api/public/notifications`).catch(() => null),
  ]);

  let tenders: any[] = [];
  if (tendersRes && tendersRes.ok) {
    tenders = await tendersRes.json();
  }

  let notifs: any[] = [];
  if (notifsRes && notifsRes.ok) {
    notifs = await notifsRes.json();
  }

  // Recent Active Tenders (Sorted by publication date descending, limit to recent 3)
  const recentTenders = tenders
    .filter((t: any) => t.status === 'Active')
    .sort((a: any, b: any) => new Date(b.publishDate).getTime() - new Date(a.publishDate).getTime())
    .slice(0, 3);

  recentTenders.forEach((t: any) => {
    // Link directly to the official Tender Details page on the website
    const tenderUrl = `/stakeholders/vendors/tender-details?id=${t.id}`;
    tickerItems.push({
      type: 'TENDER',
      text: `${t.title} (NIT Ref: ${t.referenceNo})`,
      colorClass: 'text-cyan-300 bg-cyan-500/10 border-cyan-400/20',
      url: tenderUrl,
    });

    // Populate recent corrigendums if any
    const corrs = t.corrigendums && Array.isArray(t.corrigendums) ? t.corrigendums : [];
    corrs.slice(0, 1).forEach((c: any) => {
      const corrUrl = `/stakeholders/vendors/tender-details?id=${t.id}#corrigendum-${c.id}`;
      tickerItems.push({
        type: 'CORRIGENDUM',
        text: `Corrigendum: ${c.title} — ${t.title} (Ref: ${t.referenceNo})`,
        colorClass: 'text-orange-400 bg-orange-500/10 border-orange-400/20',
        url: corrUrl,
      });
    });
  });

  // Recent Notifications & Notices (Sorted by publication date descending, limit to recent 3)
  const recentNotifs = notifs
    .sort((a: any, b: any) => new Date(b.publishDate).getTime() - new Date(a.publishDate).getTime())
    .slice(0, 3);

  recentNotifs.forEach((n: any) => {
    // Directly open that specific notice document
    const notifDocUrl = getDocUrl(n.documentUrl) || `/notifications`;
    tickerItems.push({
      type: 'NOTICE',
      text: `${n.title}${n.fileName ? ` (${n.fileName})` : ''}`,
      colorClass: 'text-yellow-400 bg-yellow-500/10 border-yellow-400/20',
      url: notifDocUrl,
    });
  });
} catch (e) {
  console.error('Error fetching dynamic ticker items:', e);
}

// Fallback items if database or backend is offline
if (tickerItems.length === 0) {
  tickerItems = [
    { 
      type: 'TENDER', 
      text: 'Active Notice Inviting Tenders (NITs) & Procurement Opportunities', 
      colorClass: 'text-cyan-300 bg-cyan-500/10 border-cyan-400/20',
      url: '/stakeholders/vendors/tender-bids'
    },
    { 
      type: 'NOTICE', 
      text: 'Official Notifications & Circulars Repository — JKSPDCL', 
      colorClass: 'text-yellow-400 bg-yellow-500/10 border-yellow-400/20',
      url: '/notifications'
    }
  ];
}
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | JKSPDC Official Portal</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <!-- GIGW 3.0 — Last reviewed/updated meta -->
    <meta name="last-modified" content={new Date().toISOString().split('T')[0]} />
    <meta name="author" content="Jammu & Kashmir State Power Development Corporation Limited" />
    <meta name="publisher" content="JKSPDC — Government of Jammu & Kashmir" />
    
    <!-- GIGW SEO & Browser Compatibility -->
    <meta name="robots" content="index, follow" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <!-- Google Fonts: Noto Sans (Regular 400, Medium 500, Semi Bold 600, Bold 700) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans:ital,wght@0,400;0,500;0,600;0,700;0,800;1,400;1,500;1,600;1,700&family=Noto+Sans+Devanagari:wght@400;500;600;700&display=swap" rel="stylesheet" />
    
    <!-- API base URL for inline scripts -->
    <script is:inline define:vars={{ apiBase: import.meta.env.PUBLIC_API_BASE }}>window.__API_BASE__ = apiBase;</script>

    <!-- Custom Translation Utility -->
    <script src="/js/translation.js" is:inline></script>

    <!-- Custom styling for high contrast mode & animations -->
    <style is:global>
      .high-contrast,
      .high-contrast * {
        background-color: #000000 !important;
        background-image: none !important;
        color: #ffff00 !important;
        border-color: #ffff00 !important;
        box-shadow: none !important;
      }
      .high-contrast a,
      .high-contrast button {
        color: #ffff00 !important;
        text-decoration: underline !important;
      }
      .high-contrast a:hover,
      .high-contrast button:hover {
        background-color: #333333 !important;
        color: #ffffff !important;
      }

      /* ── Ticker scroll animation ───────────────────────────────── */
      @keyframes ticker-scroll {
        0%   { transform: translate3d(0, 0, 0); }
        100% { transform: translate3d(-50%, 0, 0); }
      }
      .animate-ticker {
        display: inline-flex !important;
        width: max-content !important;
        white-space: nowrap !important;
        animation: ticker-scroll 30s linear infinite !important;
        will-change: transform;
      }
      .animate-ticker:hover {
        animation-play-state: paused !important;
      }

      /* ── Slow pulse for status dots ────────────────────────────── */
      @keyframes slow-pulse {
        0%, 100% { opacity: 1; }
        50%       { opacity: 0.35; }
      }
      .animate-slow-pulse {
        animation: slow-pulse 2.5s ease-in-out infinite;
      }

      /* ── Hide Bhashini default widget elements ── */
      #bhashini-translation,
      .bhashini-feedback-modal,
      .bhashini-feedback-div,
      .bhashini-toast {
        display: none !important;
      }

      /* ── Navigation Menu Dropdown Toggle ─────────────────── */
      .nav-dropdown-item:hover > .nav-dropdown-menu:not(.is-closed),
      .nav-dropdown-item.is-open > .nav-dropdown-menu {
        display: block !important;
      }

      .nav-dropdown-item.is-closed > .nav-dropdown-menu {
        display: none !important;
      }

      .nav-dropdown-item:hover .dropdown-arrow:not(.is-arrow-closed),
      .nav-dropdown-item.is-open .dropdown-arrow {
        transform: rotate(180deg);
      }

      .nav-dropdown-item.is-closed .dropdown-arrow {
        transform: rotate(0deg) !important;
      }

      /* ── Nav Item Active & Interactive Highlight System ──── */
      .nav-dropdown-item:hover > .nav-dropdown-btn:not(.nav-item-active),
      .nav-dropdown-item.is-open > .nav-dropdown-btn:not(.nav-item-active),
      .nav-link:hover:not(.nav-item-active) {
        background-color: rgba(255, 255, 255, 0.10) !important;
        border-bottom-color: rgba(255, 255, 255, 0.6) !important;
      }

      .nav-item-active,
      .nav-dropdown-btn.nav-item-active,
      .nav-dropdown-item.is-open > .nav-dropdown-btn.nav-item-active,
      .nav-dropdown-item:hover > .nav-dropdown-btn.nav-item-active {
        border-bottom-color: #0B3B60 !important;
        border-bottom-width: 3px !important;
        border-bottom-style: solid !important;
        background-color: rgba(255, 255, 255, 0.12) !important;
        color: #ffffff !important;
      }

      .nav-sublink-active {
        background-color: #F4F8FB !important;
        color: #0B3B60 !important;
        font-weight: 700 !important;
        border-left: 4px solid #0B3B60 !important;
      }

      /* ── Navigation Bar Horizontal Scrolling ─────────────────── */
      .nav-scroll-container {
        overflow-x: auto;
        overflow-y: visible;
        -webkit-overflow-scrolling: touch;
      }
      @media (min-width: 1024px) {
        .nav-scroll-container {
          overflow-x: visible;
        }
      }
      .nav-scroll-container::-webkit-scrollbar {
        height: 3px;
      }
      .nav-scroll-container::-webkit-scrollbar-track {
        background: rgba(0, 0, 0, 0.15);
      }
      .nav-scroll-container::-webkit-scrollbar-thumb {
        background: rgba(255, 255, 255, 0.35);
        border-radius: 2px;
      }
      .nav-scroll-container::-webkit-scrollbar-thumb:hover {
        background: rgba(255, 255, 255, 0.6);
      }
    </style>

    <!-- GIGW Accessibility & Preference persistence scripts -->
    <script is:inline>
      function adjustFontSize(action) {
        var html = document.documentElement;
        var cur = parseFloat(window.getComputedStyle(html).fontSize) || 17;
        var nextSize = cur;
        if (action === 'inc') {
          if (cur < 24) nextSize = cur + 1;
        } else if (action === 'dec') {
          if (cur > 12) nextSize = cur - 1;
        } else {
          nextSize = 17;
        }
        var sizeStr = nextSize + 'px';
        html.style.fontSize = sizeStr;
        try {
          localStorage.setItem('preferred-font-size', sizeStr);
        } catch (e) {}
      }

      function toggleHighContrast() {
        var html = document.documentElement;
        var isDark = html.classList.toggle('high-contrast');
        try {
          localStorage.setItem('high-contrast', isDark ? 'true' : 'false');
        } catch (e) {}
      }

      function changeLanguage(langCode) {
        try {
          localStorage.setItem('preferredLanguage', langCode);
          window.location.reload();
        } catch (e) {}
      }

      function toggleLangDropdown(event) {
        if (event) {
          event.preventDefault();
          event.stopPropagation();
        }
        var menu = document.getElementById('lang-dropdown-menu');
        var btn = document.getElementById('lang-dropdown-btn');
        var arrow = document.getElementById('lang-arrow');
        if (!menu) return;
        
        // Immediately close and clear search suggestions if open
        var searchSuggestions = document.getElementById('header-search-suggestions');
        if (searchSuggestions) {
          searchSuggestions.innerHTML = '';
          searchSuggestions.classList.add('hidden');
        }

        var isHidden = menu.classList.toggle('hidden');
        if (btn) btn.setAttribute('aria-expanded', String(!isHidden));
        if (arrow) {
          if (isHidden) {
            arrow.classList.remove('rotate-180');
          } else {
            arrow.classList.add('rotate-180');
          }
        }
      }
      window.toggleLangDropdown = toggleLangDropdown;
      window.toggleLanguageDropdown = toggleLangDropdown;

      (function() {
        try {
          var savedSize = localStorage.getItem('preferred-font-size');
          if (savedSize) {
            document.documentElement.style.fontSize = savedSize;
          }
          var savedContrast = localStorage.getItem('high-contrast');
          if (savedContrast === 'true') {
            document.documentElement.classList.add('high-contrast');
          }
          
          var preferredLang = localStorage.getItem('preferredLanguage') || 'en';
          var labels = {
            'en': 'English',
            'hi': 'हिन्दी',
            'ur': 'اردو',
            'ks': 'کٲشُر',
            'doi': 'डोगरी'
          };
          var labelText = labels[preferredLang] || 'English';
          
          document.addEventListener('DOMContentLoaded', function() {
            var labelEl = document.getElementById('current-lang-label');
            if (labelEl) labelEl.textContent = labelText;
            
            // Navigation Menu Toggle & Smart Viewport Edge Alignment Logic
            var navItems = document.querySelectorAll('.nav-dropdown-item');
            
            function positionDropdown(item) {
              var menu = item.querySelector('.nav-dropdown-menu');
              if (!menu) return;
              var rect = item.getBoundingClientRect();
              var windowWidth = window.innerWidth || document.documentElement.clientWidth;
              var itemCenter = rect.left + (rect.width / 2);

              menu.style.position = 'fixed';
              menu.style.top = rect.bottom + 'px';
              menu.style.zIndex = '9999';

              if (itemCenter > windowWidth / 2) {
                // Item is on right half of screen -> align right so menu opens to the left
                menu.style.left = 'auto';
                menu.style.right = Math.max(8, windowWidth - rect.right) + 'px';
              } else {
                // Item is on left half of screen -> align left so menu opens to the right
                menu.style.left = Math.max(8, rect.left) + 'px';
                menu.style.right = 'auto';
              }
            }

            function updateAllDropdownPositions() {
              navItems.forEach(positionDropdown);
            }

            // Initial positioning
            updateAllDropdownPositions();
            window.addEventListener('resize', updateAllDropdownPositions);
            window.addEventListener('scroll', updateAllDropdownPositions, { passive: true });

            navItems.forEach(function(item) {
              var btn = item.querySelector('.nav-dropdown-btn');
              var menu = item.querySelector('.nav-dropdown-menu');
              if (!btn || !menu) return;

              // Ensure correct positioning before opening on mouseenter
              item.addEventListener('mouseenter', function() {
                positionDropdown(item);
              });

              btn.addEventListener('click', function(e) {
                e.preventDefault();
                e.stopPropagation();
                positionDropdown(item);

                var isClosed = item.classList.contains('is-closed');
                var isOpen = item.classList.contains('is-open');

                // Determine if menu is currently visible
                var isShowing = isOpen || (!isClosed && window.getComputedStyle(menu).display !== 'none');

                // Close all other dropdowns
                navItems.forEach(function(other) {
                  if (other !== item) {
                    other.classList.remove('is-open');
                    other.classList.add('is-closed');
                    var otherBtn = other.querySelector('.nav-dropdown-btn');
                    if (otherBtn) otherBtn.setAttribute('aria-expanded', 'false');
                  }
                });

                if (isShowing) {
                  // SECOND CLICK -> MINIMIZE / CLOSE
                  item.classList.remove('is-open');
                  item.classList.add('is-closed');
                  btn.setAttribute('aria-expanded', 'false');
                } else {
                  // FIRST CLICK -> MAXIMIZE / OPEN
                  item.classList.remove('is-closed');
                  item.classList.add('is-open');
                  btn.setAttribute('aria-expanded', 'true');
                }
              });

              item.addEventListener('mouseleave', function() {
                item.classList.remove('is-closed');
                item.classList.remove('is-open');
                btn.setAttribute('aria-expanded', 'false');
              });
            });

            // Close dropdown when clicking outside
            window.addEventListener('click', function(e) {
              navItems.forEach(function(item) {
                if (!item.contains(e.target)) {
                  item.classList.remove('is-open');
                  item.classList.add('is-closed');
                  var btn = item.querySelector('.nav-dropdown-btn');
                  if (btn) btn.setAttribute('aria-expanded', 'false');
                }
              });
              var menu = document.getElementById('lang-dropdown-menu');
              var btn = document.getElementById('lang-dropdown-btn');
              var arrow = document.getElementById('lang-arrow');
              if (menu && !menu.classList.contains('hidden')) {
                if (btn && !btn.contains(e.target) && !menu.contains(e.target)) {
                  menu.classList.add('hidden');
                  btn.setAttribute('aria-expanded', 'false');
                  if (arrow) arrow.classList.remove('rotate-180');
                }
              }
            });
          });
        } catch (e) {}
      })();
    </script>
  </head>
  <body class="min-h-screen flex flex-col bg-slate-50 text-slate-800 font-sans transition-colors duration-150">
    <div class="border-glow-overlay" aria-hidden="true"></div>

    
    <!-- Skip to Main Content Link (GIGW Mandatory) -->
    <a href="#main-content" class="skip-link">Skip to Main Content</a>

    <!-- noscript fallback for JavaScript-dependent features (WCAG) -->
    <noscript>
      <div class="flex items-center justify-center gap-1.5" style="background:#f59e0b;color:#1e293b;text-align:center;padding:8px 16px;font-size:12px;font-weight:600;border-bottom:2px solid #d97706;" role="alert">
        <Icon name="alert-triangle" size={14} class="text-amber-950 shrink-0" />
        <span>JavaScript is disabled. Some features (language translation, search autocomplete) require JavaScript. Core content remains accessible.</span>
      </div>
    </noscript>

    <header class="bg-white border-t-[3px] border-[#0B3B60] border-b border-slate-200/90 shadow-2xs relative z-[60]" style="position: relative; z-index: 60;">
      <div class="max-w-[1400px] mx-auto px-3 sm:px-5 lg:px-6 py-2.5 sm:py-3 flex flex-col md:flex-row items-center justify-between gap-3 md:gap-6">
        
        <!-- Left: Official Institutional Identity Lockup -->
        <div class="flex items-center gap-3 sm:gap-4 min-w-0 flex-1 w-full md:w-auto">
          <!-- Official Logo -->
          <a href="/" class="flex-shrink-0 group focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#0B3B60] rounded-lg p-0.5 transition-transform duration-150 hover:scale-[1.02]" aria-label="JKSPDCL Official Portal Home">
            <img src="/logo.png" alt="JKSPDCL Official Emblem" class="h-12 sm:h-14 md:h-15 lg:h-16 w-auto object-contain" />
          </a>

          <!-- Subtle Institutional Divider -->
          <div class="w-px h-11 sm:h-12 bg-slate-200/90 hidden sm:block shrink-0"></div>

          <!-- Official Organization Typography -->
          <div class="flex flex-col min-w-0 justify-center text-left">
            <h1 class="font-extrabold text-[#002B49] text-[14px] sm:text-[16px] md:text-[17px] lg:text-[18.5px] xl:text-[19.5px] leading-tight tracking-tight">
              Jammu &amp; Kashmir State Power Development Corporation Limited
            </h1>
            <div class="flex items-center gap-1.5 sm:gap-2 mt-0.5 flex-wrap">
              <span class="text-slate-600 font-semibold text-[11px] sm:text-xs tracking-wide">
                A Government of J&amp;K Undertaking
              </span>
              <span class="text-slate-300 hidden sm:inline">•</span>
              <span class="text-[#0B3B60] font-bold text-[11px] sm:text-xs">
                (JKSPDCL)
              </span>
            </div>
            <p class="text-slate-700 font-medium text-[11px] sm:text-xs leading-snug mt-0.5 font-devanagari" lang="hi">
              जम्मू और कश्मीर राज्य विद्युत विकास निगम लिमिटेड (जेकेएसपीडीसीएल)
            </p>
          </div>
        </div>

        <!-- Right: Utility Controls & Integrated Search Toolbar -->
        <div class="flex flex-col items-center md:items-end gap-2 shrink-0 w-full md:w-auto">
          
          <!-- Accessibility Controls & Language Cluster -->
          <div class="flex items-center justify-between md:justify-end gap-2 w-full md:w-auto text-xs text-slate-700 select-none">
            
            <!-- Font Sizing (Segmented Pill) -->
            <div class="inline-flex items-center bg-slate-100/90 hover:bg-slate-100 p-0.5 rounded-lg border border-slate-200/80 shadow-2xs" role="group" aria-label="Font Size Controls">
              <button 
                type="button"
                class="flex items-center gap-0.5 px-2 py-1 bg-transparent hover:bg-white text-slate-700 hover:text-[#0B3B60] rounded-md text-[11px] font-bold transition-all duration-150 cursor-pointer focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-[#0B3B60]" 
                onclick="adjustFontSize('dec')" 
                aria-label="Decrease Font Size" 
                title="Decrease font size (-A)"
              >
                <Icon name="minus" size={8} strokeWidth={2.5} /> A
              </button>
              <div class="w-px h-3.5 bg-slate-200"></div>
              <button 
                type="button"
                class="px-2.5 py-1 bg-transparent hover:bg-white text-slate-700 hover:text-[#0B3B60] rounded-md text-[11px] font-bold transition-all duration-150 cursor-pointer focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-[#0B3B60]" 
                onclick="adjustFontSize('reset')" 
                aria-label="Reset Font Size" 
                title="Reset font size (A)"
              >
                A
              </button>
              <div class="w-px h-3.5 bg-slate-200"></div>
              <button 
                type="button"
                class="flex items-center gap-0.5 px-2 py-1 bg-transparent hover:bg-white text-slate-700 hover:text-[#0B3B60] rounded-md text-[11px] font-bold transition-all duration-150 cursor-pointer focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-[#0B3B60]" 
                onclick="adjustFontSize('inc')" 
                aria-label="Increase Font Size" 
                title="Increase font size (+A)"
              >
                <Icon name="plus" size={8} strokeWidth={2.5} /> A
              </button>
            </div>

            <!-- Contrast Switcher -->
            <button 
              type="button"
              class="inline-flex items-center gap-1.5 px-2.5 py-1 bg-slate-100/90 hover:bg-white text-slate-700 hover:text-[#0B3B60] border border-slate-200/80 hover:border-[#0B3B60]/30 rounded-lg text-[11px] font-bold transition-all duration-150 cursor-pointer shadow-2xs hover:shadow-xs focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-[#0B3B60]" 
              onclick="toggleHighContrast()" 
              aria-label="Toggle High Contrast Mode"
              title="Toggle high contrast"
            >
              <Icon name="eye" size={12} strokeWidth={2.2} class="text-[#0B3B60]" />
              <span>Contrast</span>
            </button>

            <!-- Language Switcher Dropdown -->
            <div class="relative" id="lang-dropdown-wrapper">
              <button
                type="button"
                id="lang-dropdown-btn"
                class="inline-flex items-center gap-1.5 px-2.5 py-1 bg-slate-100/90 hover:bg-white text-slate-700 hover:text-[#0B3B60] border border-slate-200/80 hover:border-[#0B3B60]/30 rounded-lg text-[11px] font-bold transition-all duration-150 cursor-pointer shadow-2xs hover:shadow-xs focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-[#0B3B60]"
                aria-haspopup="true"
                aria-expanded="false"
                aria-controls="lang-dropdown-menu"
                onclick="toggleLangDropdown(event)"
