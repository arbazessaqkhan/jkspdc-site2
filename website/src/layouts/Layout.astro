            <!-- Fade-out overlays at both entry and exit edges -->
            <div class="absolute left-0 top-0 bottom-0 w-10 bg-gradient-to-r from-[#08305C] to-transparent z-10 pointer-events-none"></div>
            <div class="absolute right-0 top-0 bottom-0 w-10 bg-gradient-to-l from-[#08305C] to-transparent z-10 pointer-events-none"></div>

            <div class="animate-ticker" style="gap: 3.5rem; padding: 0.5rem 0; font-size: 0.8rem; font-weight: 500;">
              <span style="padding-right:3rem;">› <strong class="text-yellow-400 font-extrabold uppercase tracking-wider text-[10px] mr-1 bg-yellow-500/10 px-1.5 py-0.5 rounded border border-yellow-400/20">NEW:</strong> <span class="text-slate-100">Recruitment 2025 — <span class="font-bold text-yellow-300">250 Junior Engineer</span> posts announced. Apply by <span class="underline decoration-yellow-400 font-medium">30 Jun 2025</span></span></span>
              <span style="padding-right:3rem;">› <strong class="text-cyan-300 font-extrabold uppercase tracking-wider text-[10px] mr-1 bg-cyan-500/10 px-1.5 py-0.5 rounded border border-cyan-400/20">TENDER:</strong> <span class="text-slate-100">NIT-521 for <span class="font-bold text-cyan-200">Baglihar Refurbishment</span> closing <span class="underline decoration-cyan-300 font-medium">28 Jun 2025</span></span></span>
              <span style="padding-right:3rem;">› <strong class="text-emerald-400 font-extrabold uppercase tracking-wider text-[10px] mr-1 bg-emerald-500/10 px-1.5 py-0.5 rounded border border-emerald-400/20">PRESS:</strong> <span class="text-slate-100">JKSPDC signs MoU for <span class="font-bold text-emerald-300">3,000 MW hydro expansion</span> with NHPC</span></span>
              <span style="padding-right:3rem;">› <strong class="text-orange-400 font-extrabold uppercase tracking-wider text-[10px] mr-1 bg-orange-500/10 px-1.5 py-0.5 rounded border border-orange-400/20">CORRIGENDUM:</strong> <span class="text-slate-100">COR/2025/56 issued for <span class="font-bold text-orange-300">Pakal Dul E&amp;M</span> works</span></span>
              <span style="padding-right:3rem;">› <strong class="text-sky-300 font-extrabold uppercase tracking-wider text-[10px] mr-1 bg-sky-500/10 px-1.5 py-0.5 rounded border border-sky-400/20">INVESTOR:</strong> <span class="text-slate-100"><span class="font-bold text-sky-200">32nd AGM</span> scheduled for <span class="underline decoration-sky-300 font-medium">25 Jun 2025</span></span></span>
              
              <span style="padding-right:3rem;">› <strong class="text-yellow-400 font-extrabold uppercase tracking-wider text-[10px] mr-1 bg-yellow-500/10 px-1.5 py-0.5 rounded border border-yellow-400/20">NEW:</strong> <span class="text-slate-100">Recruitment 2025 — <span class="font-bold text-yellow-300">250 Junior Engineer</span> posts announced. Apply by <span class="underline decoration-yellow-400 font-medium">30 Jun 2025</span></span></span>
              <span style="padding-right:3rem;">› <strong class="text-cyan-300 font-extrabold uppercase tracking-wider text-[10px] mr-1 bg-cyan-500/10 px-1.5 py-0.5 rounded border border-cyan-400/20">TENDER:</strong> <span class="text-slate-100">NIT-521 for <span class="font-bold text-cyan-200">Baglihar Refurbishment</span> closing <span class="underline decoration-cyan-300 font-medium">28 Jun 2025</span></span></span>
              <span style="padding-right:3rem;">› <strong class="text-emerald-400 font-extrabold uppercase tracking-wider text-[10px] mr-1 bg-emerald-500/10 px-1.5 py-0.5 rounded border border-emerald-400/20">PRESS:</strong> <span class="text-slate-100">JKSPDC signs MoU for <span class="font-bold text-emerald-300">3,000 MW hydro expansion</span> with NHPC</span></span>
              <span style="padding-right:3rem;">› <strong class="text-orange-400 font-extrabold uppercase tracking-wider text-[10px] mr-1 bg-orange-500/10 px-1.5 py-0.5 rounded border border-orange-400/20">CORRIGENDUM:</strong> <span class="text-slate-100">COR/2025/56 issued for <span class="font-bold text-orange-300">Pakal Dul E&amp;M</span> works</span></span>
              <span style="padding-right:3rem;">› <strong class="text-sky-300 font-extrabold uppercase tracking-wider text-[10px] mr-1 bg-sky-500/10 px-1.5 py-0.5 rounded border border-sky-400/20">INVESTOR:</strong> <span class="text-slate-100"><span class="font-bold text-sky-200">32nd AGM</span> scheduled for <span class="underline decoration-sky-300 font-medium">25 Jun 2025</span></span></span>
            </div>
          </div>
        </div>
      </div>
          </div>
        </div>
      </div>

