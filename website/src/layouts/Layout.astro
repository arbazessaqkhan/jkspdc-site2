                    <li><a href="/about-us/others/contact" class="block p-1.5 rounded hover:bg-slate-100 hover:text-[#0B4F9C]">Contact Directory</a></li>
                  </ul>
                </div>
              </div>
            </li>

            <!-- Our Business -->
            <li class="relative group">
              <button class="flex items-center gap-1.5 px-4 py-3.5 hover:bg-[#084A8F] transition-colors border-b-2 border-transparent group-hover:border-white/60 text-white focus:outline-none focus:bg-[#073A80]" aria-haspopup="true" aria-expanded="false">
                Our Business
                <svg class="w-3 h-3 transition-transform duration-200 group-hover:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7"></path>
                </svg>
              </button>
              <!-- Single Column Dropdown -->
              <div class="absolute left-0 mt-0 hidden group-hover:block group-focus-within:block bg-white text-slate-800 shadow-2xl border-t-4 border-[#0B4F9C] rounded-b-lg z-50 py-2 w-[260px] transition-all duration-200 ease-out">
                <ul class="flex flex-col gap-0.5 text-xs px-2">
                  <li><a href="/our-business/power-stations" class="flex items-center gap-2 p-2 rounded hover:bg-slate-100 hover:text-[#0B4F9C]"><Icon name="zap" size={13} strokeWidth={1.75} class="text-[#0B4F9C] shrink-0" /> Power Stations</a></li>
                  <li><a href="/our-business/construction" class="flex items-center gap-2 p-2 rounded hover:bg-slate-100 hover:text-[#0B4F9C]"><Icon name="hardhat" size={13} strokeWidth={1.75} class="text-[#0B4F9C] shrink-0" /> Construction Projects</a></li>
                  <li><a href="/our-business/under-development" class="flex items-center gap-2 p-2 rounded hover:bg-slate-100 hover:text-[#0B4F9C]"><Icon name="trending-up" size={13} strokeWidth={1.75} class="text-[#0B4F9C] shrink-0" /> Under Development Projects</a></li>
                  <li><a href="/our-business/jv-subsidiary-projects" class="flex items-center gap-2 p-2 rounded hover:bg-slate-100 hover:text-[#0B4F9C]"><Icon name="users" size={13} strokeWidth={1.75} class="text-[#0B4F9C] shrink-0" /> JV / Subsidiary Projects</a></li>
                  <li><a href="/our-business/turnkey" class="flex items-center gap-2 p-2 rounded hover:bg-slate-100 hover:text-[#0B4F9C]"><Icon name="briefcase" size={13} strokeWidth={1.75} class="text-[#0B4F9C] shrink-0" /> Deposit / Turnkey</a></li>
                  <li><a href="/our-business/consultancy" class="flex items-center gap-2 p-2 rounded hover:bg-slate-100 hover:text-[#0B4F9C]"><Icon name="bar-chart" size={13} strokeWidth={1.75} class="text-[#0B4F9C] shrink-0" /> Consultancy</a></li>
                  <li><a href="/our-business/jv-companies" class="flex items-center gap-2 p-2 rounded hover:bg-slate-100 hover:text-[#0B4F9C]"><Icon name="building" size={13} strokeWidth={1.75} class="text-[#0B4F9C] shrink-0" /> JV &amp; Subsidiary Companies</a></li>
                </ul>
              </div>
            </li>

            <!-- Stakeholders -->
            <li class="relative group">
              <button class="flex items-center gap-1.5 px-4 py-3.5 hover:bg-[#084A8F] transition-colors border-b-2 border-transparent group-hover:border-white/60 text-white focus:outline-none focus:bg-[#073A80]" aria-haspopup="true" aria-expanded="false">
                Stakeholders
                <svg class="w-3 h-3 transition-transform duration-200 group-hover:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7"></path>
                </svg>
              </button>
              <!-- 2 Column Dropdown -->
              <div class="absolute left-0 mt-0 hidden group-hover:grid group-focus-within:grid bg-white text-slate-800 shadow-2xl border-t-4 border-[#0B4F9C] rounded-b-lg z-50 p-5 gap-6 w-[400px] grid-cols-2 transition-all duration-200 ease-out">
