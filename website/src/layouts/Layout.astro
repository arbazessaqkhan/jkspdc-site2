                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7"></path>
                </svg>
              </button>
              <!-- Mega Dropdown (3 columns) -->
              <div class="absolute left-0 mt-0 hidden group-hover:grid group-focus-within:grid bg-white text-slate-800 shadow-2xl border-t-4 border-[#0B4F9C] rounded-b-lg z-50 p-6 gap-6 w-[560px] grid-cols-3 transition-all duration-200 ease-out">
                <div>
                  <h3 class="font-bold text-xs uppercase tracking-wider text-[#0B4F9C] border-b border-slate-100 pb-1.5 mb-2">Explore</h3>
                  <ul class="flex flex-col gap-1 text-xs">
                    <li><a href="/about-us/explore/overview" class="block p-1.5 rounded hover:bg-slate-100 hover:text-[#0B4F9C]">Corporate Overview</a></li>
                    <li><a href="/about-us/explore/vision" class="block p-1.5 rounded hover:bg-slate-100 hover:text-[#0B4F9C]">Vision</a></li>
