              <div class="absolute right-0 mt-0 hidden group-hover:grid group-focus-within:grid bg-white text-slate-800 shadow-2xl border-t-4 border-[#f15a24] rounded-b-lg z-50 p-6 gap-6 w-[560px] grid-cols-3 transition-all duration-200 ease-out">
                <div>
                  <h3 class="font-bold text-xs uppercase tracking-wider text-[#003366] border-b border-slate-100 pb-1.5 mb-2">Environment</h3>
                  <ul class="flex flex-col gap-1 text-xs">
                    <li><a href="/sustainability/environment/preamble" class="block p-1.5 rounded hover:bg-slate-100 hover:text-[#003366]">Preamble</a></li>
