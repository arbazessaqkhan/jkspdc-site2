---
import '../styles/global.css';
import Icon from '../components/Icon.astro';
import HydroChat from '../components/HydroChat.astro';

interface Props {
  title: string;
  description: string;
  canonicalUrl?: string;
  isHome?: boolean;
}

const { title, description, canonicalUrl, isHome = false } = Astro.props;
const canonical = canonicalUrl || Astro.url.href;
const currentYear = new Date().getFullYear();

function getDocUrl(url?: string) {
  if (!url) return undefined;
  if (url.startsWith('/uploads/')) {
    return `http://localhost:3000${url}`;
  }
  return url;
}

// Dynamically fetch ticker items from the public APIs
let tickerItems: any[] = [];
try {
  const [tendersRes, notifsRes] = await Promise.all([
    fetch('http://localhost:3000/api/public/tenders').catch(() => null),
    fetch('http://localhost:3000/api/public/notifications').catch(() => null),
  ]);

  let tenders: any[] = [];
  if (tendersRes && tendersRes.ok) {
    tenders = await tendersRes.json();
  }

  let notifs: any[] = [];
  if (notifsRes && notifsRes.ok) {
    notifs = await notifsRes.json();
  }

  // Populate active tenders (limit to top 4)
  tenders.filter((t: any) => t.status === 'Active').slice(0, 4).forEach((t: any) => {
    const tenderDocUrl = getDocUrl(t.documentUrl) || `/stakeholders/vendors/tender-details?id=${t.id}`;
    tickerItems.push({
      type: 'TENDER',
      text: `${t.title} (NIT Ref: ${t.referenceNo})`,
      colorClass: 'text-cyan-300 bg-cyan-500/10 border-cyan-400/20',
      url: tenderDocUrl,
    });

    // Populate corrigendums (limit to top 2 per tender)
    const corrs = t.corrigendums && Array.isArray(t.corrigendums) ? t.corrigendums : [];
    corrs.slice(0, 2).forEach((c: any) => {
      const corrDocUrl = getDocUrl(c.documentUrl) || tenderDocUrl;
      tickerItems.push({
        type: 'CORRIGENDUM',
        text: `${c.title} (Ref: ${t.referenceNo})`,
        colorClass: 'text-orange-400 bg-orange-500/10 border-orange-400/20',
        url: corrDocUrl,
      });
    });
  });

  // Populate notifications (limit to top 4)
  notifs.slice(0, 4).forEach((n: any) => {
    const notifDocUrl = getDocUrl(n.documentUrl) || `/notifications`;
    tickerItems.push({
      type: 'NOTIFICATION',
      text: `${n.title} (File: ${n.fileName})`,
      colorClass: 'text-yellow-400 bg-yellow-500/10 border-yellow-400/20',
      url: notifDocUrl,
    });
  });
} catch (e) {
  console.error('Error fetching dynamic ticker items:', e);
}

// Fallback items if database or backend is offline
if (tickerItems.length === 0) {
  tickerItems = [
    { type: 'LIVE', text: 'Jammu & Kashmir State Power Development Corporation Limited official portal online.', colorClass: 'text-yellow-400 bg-yellow-500/10 border-yellow-400/20' }
  ];
}
---


<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | JKSPDC Official Portal</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    
    <!-- GIGW SEO & Browser Compatibility -->
    <meta name="robots" content="index, follow" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <link rel="icon" type="image/png" href="/logo.png" />
    <!-- Google Fonts: Noto Sans (Regular 400, Medium 500, Semi Bold 600, Bold 700) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans:ital,wght@0,400;0,500;0,600;0,700;0,800;1,400;1,500;1,600;1,700&family=Noto+Sans+Devanagari:wght@400;500;600;700&display=swap" rel="stylesheet" />
    
    <!-- Custom Translation Utility -->
    <script src="/js/translation.js" is:inline></script>

    <!-- Custom styling for high contrast mode -->
    <style is:global>
      .high-contrast,
      .high-contrast * {
        background-color: #000000 !important;
        background-image: none !important;
        color: #ffff00 !important;
        border-color: #ffff00 !important;
        box-shadow: none !important;
      }
      .high-contrast a,
      .high-contrast button {
        color: #ffff00 !important;
        text-decoration: underline !important;
      }
      .high-contrast a:hover,
      .high-contrast button:hover {
        background-color: #333333 !important;
        color: #ffffff !important;
      }

      /* ── Ticker scroll animation ───────────────────────────────── */
      @keyframes ticker-scroll {
        0%   { transform: translateX(0); }
        100% { transform: translateX(-50%); }
      }
      .animate-ticker {
        display: flex;
        white-space: nowrap;
        animation: ticker-scroll 35s linear infinite;
        will-change: transform;
      }
      .animate-ticker:hover {
        animation-play-state: paused;
      }

      /* ── Slow pulse for status dots ────────────────────────────── */
      @keyframes slow-pulse {
        0%, 100% { opacity: 1; }
        50%       { opacity: 0.35; }
      }
      .animate-slow-pulse {
        animation: slow-pulse 2.5s ease-in-out infinite;
      }

      /* ── Hide Bhashini default widget elements to maintain clean design ── */
      #bhashini-translation,
      .bhashini-feedback-modal,
      .bhashini-feedback-div,
      .bhashini-toast {
        display: none !important;
      }

      /* ── Navigation Menu Dropdown Toggle ─────────────────── */
      .nav-dropdown-item:hover > .nav-dropdown-menu:not(.is-closed),
      .nav-dropdown-item.is-open > .nav-dropdown-menu {
        display: block !important;
      }

      .nav-dropdown-item.is-closed > .nav-dropdown-menu {
        display: none !important;
      }

      .nav-dropdown-item:hover .dropdown-arrow:not(.is-arrow-closed),
      .nav-dropdown-item.is-open .dropdown-arrow {
        transform: rotate(180deg);
      }

      .nav-dropdown-item.is-closed .dropdown-arrow {
        transform: rotate(0deg) !important;
      }
    </style>
    <!-- Incremental font size helper (GIGW Accessibility) & Preference persistence -->
    <script is:inline>
      function adjustFontSize(action) {
        var html = document.documentElement;
        var cur = parseFloat(window.getComputedStyle(html).fontSize) || 16;
        var nextSize = cur;
        if (action === 'inc') {
          if (cur < 24) nextSize = cur + 1;
        } else if (action === 'dec') {
          if (cur > 12) nextSize = cur - 1;
        } else {
          nextSize = 16;
        }
        var sizeStr = nextSize + 'px';
        html.style.fontSize = sizeStr;
        try {
          localStorage.setItem('preferred-font-size', sizeStr);
        } catch (e) {}
      }

      function toggleHighContrast() {
        var html = document.documentElement;
        var isDark = html.classList.toggle('high-contrast');
        try {
          localStorage.setItem('high-contrast', isDark ? 'true' : 'false');
        } catch (e) {}
      }

      // Custom Language Dropdown logic
      function changeLanguage(langCode) {
        try {
          localStorage.setItem('preferredLanguage', langCode);
          window.location.reload();
        } catch (e) {}
      }

      function toggleLangDropdown(event) {
        if (event) event.stopPropagation();
        var menu = document.getElementById('lang-dropdown-menu');
        var btn = document.getElementById('lang-dropdown-btn');
        var arrow = document.getElementById('lang-arrow');
        if (!menu) return;
        
        var isHidden = menu.classList.toggle('hidden');
        if (btn) btn.setAttribute('aria-expanded', !isHidden);
        if (arrow) {
          if (isHidden) {
            arrow.classList.remove('rotate-180');
          } else {
            arrow.classList.add('rotate-180');
          }
        }
      }

      // Apply saved preferences immediately to avoid layout shifts or color flashes
      (function() {
        try {
          var savedSize = localStorage.getItem('preferred-font-size');
          if (savedSize) {
            document.documentElement.style.fontSize = savedSize;
          }
          var savedContrast = localStorage.getItem('high-contrast');
          if (savedContrast === 'true') {
            document.documentElement.classList.add('high-contrast');
          }
          
          // Apply initial preferred language label
          var preferredLang = localStorage.getItem('preferredLanguage') || 'en';
          var labels = {
            'en': 'English',
            'hi': 'हिन्दी',
            'ur': 'اردو',
            'ks': 'کٲشُر',
            'doi': 'डোগরী'
          };
          var labelText = labels[preferredLang] || 'English';
          
          document.addEventListener('DOMContentLoaded', function() {
            var labelEl = document.getElementById('current-lang-label');
            if (labelEl) labelEl.textContent = labelText;
            
            var btn = document.getElementById('lang-dropdown-btn');
            if (btn) {
              btn.addEventListener('click', toggleLangDropdown);
            }
            
            // Navigation Menu Toggle Logic (1st click = maximize/open, 2nd click = minimize/close)
            var navItems = document.querySelectorAll('.nav-dropdown-item');
            navItems.forEach(function(item) {
              var btn = item.querySelector('.nav-dropdown-btn');
              var menu = item.querySelector('.nav-dropdown-menu');
              if (!btn || !menu) return;

              btn.addEventListener('click', function(e) {
                e.preventDefault();
                e.stopPropagation();

                var isClosed = item.classList.contains('is-closed');
                var isOpen = item.classList.contains('is-open');

                // Determine if menu is currently visible
                var isShowing = isOpen || (!isClosed && window.getComputedStyle(menu).display !== 'none');

                // Close all other dropdowns
                navItems.forEach(function(other) {
                  if (other !== item) {
                    other.classList.remove('is-open');
                    other.classList.add('is-closed');
                    var otherBtn = other.querySelector('.nav-dropdown-btn');
                    if (otherBtn) otherBtn.setAttribute('aria-expanded', 'false');
                  }
                });

                if (isShowing) {
                  // SECOND CLICK -> MINIMIZE / CLOSE
                  item.classList.remove('is-open');
                  item.classList.add('is-closed');
                  btn.setAttribute('aria-expanded', 'false');
                } else {
                  // FIRST CLICK -> MAXIMIZE / OPEN
                  item.classList.remove('is-closed');
                  item.classList.add('is-open');
                  btn.setAttribute('aria-expanded', 'true');
                }
              });

              item.addEventListener('mouseleave', function() {
                item.classList.remove('is-closed');
                item.classList.remove('is-open');
                btn.setAttribute('aria-expanded', 'false');
              });
            });

            // Close dropdown when clicking outside
            window.addEventListener('click', function(e) {
              navItems.forEach(function(item) {
                if (!item.contains(e.target)) {
                  item.classList.remove('is-open');
                  item.classList.add('is-closed');
                  var btn = item.querySelector('.nav-dropdown-btn');
                  if (btn) btn.setAttribute('aria-expanded', 'false');
                }
              });
              var menu = document.getElementById('lang-dropdown-menu');
              var btn = document.getElementById('lang-dropdown-btn');
              var arrow = document.getElementById('lang-arrow');
              if (menu && !menu.classList.contains('hidden')) {
                if (btn && !btn.contains(e.target) && !menu.contains(e.target)) {
                  menu.classList.add('hidden');
                  btn.setAttribute('aria-expanded', 'false');
                  if (arrow) arrow.classList.remove('rotate-180');
                }
              }
            });
          });
        } catch (e) {}
      })();
    </script>
  </head>
  <body class="min-h-screen flex flex-col bg-slate-50 text-slate-800 font-sans transition-colors duration-150">
    
    <!-- Skip to Main Content Link (GIGW Mandatory) -->
    <a href="#main-content" class="skip-link">Skip to Main Content</a>

    <header class="bg-[#EAF4FF] border-b-2 border-[#0B4F9C] shadow-sm">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-2.5 flex items-center justify-between">
        <!-- Left Logo -->
        <a href="/" class="flex-shrink-0 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#0B4F9C] rounded p-1 lg:-ml-[22px]" aria-label="JKSPDCL Home">
          <img src="/logo.png" alt="JKSPDCL Logo" class="h-20 w-auto object-contain" />
        </a>

        <!-- Centered Organization Name -->
        <div class="flex-1 text-center px-4">
          <h1 class="text-base md:text-xl font-bold text-[#0B4F9C] leading-tight">
            Jammu &amp; Kashmir State Power Development Corporation Limited
          </h1>
          <p class="text-xs md:text-sm font-bold text-[#0B4F9C] mt-0.5">(JKSPDCL)</p>
          <p class="text-xs text-[#0B4F9C] font-semibold mt-0.5" lang="hi">
            जम्मू और कश्मीर राज्य विद्युत विकास निगम लिमिटेड (जेकेएसपीडीसीएल)
          </p>
        </div>

        <!-- Right Accessibility Controls & Search Bar -->
        <div class="flex flex-col items-end gap-2 flex-shrink-0">
          <!-- Accessibility Controls -->
          <div class="flex items-center gap-2.5 text-xs text-slate-700 select-none">
            <!-- Font Sizing -->
            <div class="flex items-center gap-1" aria-label="Font Size Controls" role="group">
              <button class="flex items-center gap-1 px-2 py-0.5 bg-white hover:bg-slate-100 border border-slate-300 rounded text-xs font-bold text-slate-700 transition-colors cursor-pointer" onclick="adjustFontSize('dec')" aria-label="Decrease Font Size" title="Decrease Font Size">
                <Icon name="minus" size={9} strokeWidth={2.5} /> A
              </button>
              <button class="flex items-center px-2.5 py-0.5 bg-white hover:bg-slate-100 border border-slate-300 rounded text-xs font-bold text-slate-700 transition-colors cursor-pointer" onclick="adjustFontSize('reset')" aria-label="Reset Font Size" title="Reset Font Size">A</button>
              <button class="flex items-center gap-1 px-2 py-0.5 bg-white hover:bg-slate-100 border border-slate-300 rounded text-xs font-bold text-slate-700 transition-colors cursor-pointer" onclick="adjustFontSize('inc')" aria-label="Increase Font Size" title="Increase Font Size">
                <Icon name="plus" size={9} strokeWidth={2.5} /> A
              </button>
            </div>
            <span class="text-slate-300">|</span>
            <!-- Contrast Switcher -->
            <button class="flex items-center gap-1.5 px-2.5 py-0.5 bg-white hover:bg-slate-100 border border-slate-300 rounded text-xs font-bold text-slate-700 transition-colors cursor-pointer" onclick="toggleHighContrast()" aria-label="Toggle High Contrast Mode">
              <Icon name="contrast" size={11} strokeWidth={2.5} /> Contrast
            </button>
            <span class="text-slate-300">|</span>
            <!-- Custom Language Selector Dropdown -->
            <div class="relative inline-block text-left select-none dont-translate z-[9999]" id="custom-language-selector">
