    <!-- Main Content Container -->
    <main id="main-content" class={isHome ? "flex-grow focus:outline-none" : "flex-grow max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-8 focus:outline-none"} tabindex="-1">
      <slot />
    </main>

    <!-- Composite Footer Component -->
    <Footer />

    <!-- Floating Scroll to Top Button -->
    <button
      id="scroll-to-top-btn"
      class="fixed bottom-8 right-8 z-50 bg-[#0B4F9C] hover:bg-[#084A8F] text-white w-12 h-12 rounded-full shadow-2xl flex items-center justify-center transition-all duration-300 opacity-0 pointer-events-none focus:outline-none focus:ring-2 focus:ring-[#BDD7EE] border-2 border-white/20 hover:scale-110"
      aria-label="Scroll to top of page"
    >
      <Icon name="arrow-up" size={20} strokeWidth={2.5} />
    </button>

    <!-- Scroll to Top Script -->
    <script is:inline>
      (function () {
        var btn = document.getElementById('scroll-to-top-btn');
        if (!btn) return;
        function onScroll() {
          if (window.scrollY > 300) {
            btn.style.opacity = '1';
            btn.style.pointerEvents = 'auto';
          } else {
            btn.style.opacity = '0';
            btn.style.pointerEvents = 'none';
          }
        }
        window.addEventListener('scroll', onScroll, { passive: true });
        btn.addEventListener('click', function () {
          window.scrollTo({ top: 0, behavior: 'smooth' });
        });
      })();
    </script>

    <!-- Dropdown positioning helper -->
    <script is:inline>
      (function() {
        function adjustDropdownPosition(li) {
          var dropdown = li.querySelector('div.absolute');
          if (!dropdown) return;
          dropdown.style.left = '';
          dropdown.style.right = '';
          var rect = dropdown.getBoundingClientRect();
          var viewportWidth = window.innerWidth;
          if (rect.right > viewportWidth) {
            dropdown.style.right = '0';
            dropdown.style.left = 'auto';
          } else if (rect.left < 0) {
            dropdown.style.left = '0';
            dropdown.style.right = 'auto';
          }
        }

        document.querySelectorAll('nav li.relative.group').forEach(function(li) {
          li.addEventListener('mouseenter', function() {
            adjustDropdownPosition(li);
          });
          li.addEventListener('focusin', function() {
            adjustDropdownPosition(li);
          });
        });
      })();
    </script>

    <!-- Active Nav Indicator (GIGW 3.0 Requirement) -->
    <script is:inline>
      (function() {
        var path = window.location.pathname;
        var navLinks = document.querySelectorAll('nav a[href]');
        navLinks.forEach(function(link) {
          var href = link.getAttribute('href');
          if (!href || href === '#') return;
          var isActive = (href === '/' && path === '/') || (href !== '/' && path.startsWith(href));
          if (isActive) {
            link.style.borderBottomColor = '#D8681B';
            link.style.borderBottomWidth = '3px';
            link.style.borderBottomStyle = 'solid';
          }
        });
      })();
    </script>

    <!-- Global Header Search Autocomplete -->
    <script is:inline>
      (function() {
        var searchForm = document.getElementById('header-search-form');
        var searchInput = document.getElementById('header-search');
        var suggestionsBox = document.getElementById('header-search-suggestions');
        var searchIndex = [];

        async function loadIndex() {
          try {
            var sitemapRes = await fetch('/search-index.json');
            if (sitemapRes.ok) {
              searchIndex = await sitemapRes.json();
            }
            var projectsRes = await fetch('http://localhost:3000/api/projects');
            if (projectsRes.ok) {
              var projects = await projectsRes.json();
              projects.forEach(function(p) {
                searchIndex.push({
                  title: p.name,
                  url: '/our-business/power-station-details?id=' + p.id,
                  description: 'About ' + p.name + ' - Capacity: ' + p.capacityMw + ' MW, Location: ' + (p.location || 'J&K') + '. Status: ' + p.status + '.'
                });
              });
            }
          } catch(err) {
            console.error('Failed to load sitemap search index:', err);
          }
        }

        function handleInput() {
          var query = searchInput.value.toLowerCase().trim();
          if (!query) {
            suggestionsBox.innerHTML = '';
            suggestionsBox.classList.add('hidden');
            return;
          }

          var matches = searchIndex.filter(function(item) {
            return item.title.toLowerCase().indexOf(query) !== -1 ||
                   item.description.toLowerCase().indexOf(query) !== -1;
          }).slice(0, 8);

          if (matches.length > 0) {
            suggestionsBox.innerHTML = matches.map(function(item) {
              var titleRegex = new RegExp('(' + query.replace(/[-\/\\^$*+?.()|[\]{}]/g, '\\$&') + ')', 'gi');
              var highlightedTitle = item.title.replace(titleRegex, '<mark style="background-color: #fef08a; color: #1e293b; font-weight: 700; padding: 0px 2px; border-radius: 2px;">$1</mark>');
              return '<button type="button" class="w-full text-left px-3 py-1.5 hover:bg-slate-100 transition-colors block cursor-pointer border-b border-slate-50 last:border-0" data-url="' + item.url + '" style="font-size: 11px; outline: none; border-bottom: 1px solid #f1f5f9; display: block; background: transparent; border-left: 0; border-right: 0; border-top: 0; font-family: inherit; margin: 0; padding: 6px 12px; width: 100%;">' +
                     '<span style="color: #0B4F9C; font-weight: 700; display: block;">' + highlightedTitle + '</span>' +
                     '<span style="font-size: 9px; color: #64748b; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; display: block; margin-top: 2px;">' + item.description + '</span>' +
                     '</button>';
            }).join('');
            suggestionsBox.classList.remove('hidden');
          } else {
            suggestionsBox.innerHTML = '';
            suggestionsBox.classList.add('hidden');
          }
        }

        if (searchInput && searchForm && suggestionsBox) {
          searchInput.addEventListener('focus', function() {
            if (searchIndex.length === 0) loadIndex();
          });
          searchInput.addEventListener('input', handleInput);

          suggestionsBox.addEventListener('click', function(e) {
            var btn = e.target.closest('button');
            if (btn && btn.dataset.url) {
              window.location.href = btn.dataset.url;
            }
          });

          document.addEventListener('click', function(e) {
            if (!e.target.closest('#header-search-form')) {
              suggestionsBox.classList.add('hidden');
            }
          });

          searchForm.addEventListener('submit', function(e) {
            e.preventDefault();
            var query = searchInput.value.trim();
            if (!query) return;

            var lowerQuery = query.toLowerCase();
            var bestMatch = null;
            
            for (var i = 0; i < searchIndex.length; i++) {
              if (searchIndex[i].title.toLowerCase() === lowerQuery) {
                bestMatch = searchIndex[i];
                break;
              }
            }
            
            if (!bestMatch) {
              for (var i = 0; i < searchIndex.length; i++) {
                if (searchIndex[i].title.toLowerCase().indexOf(lowerQuery) !== -1) {
                  bestMatch = searchIndex[i];
                  break;
                }
              }
            }

            if (bestMatch) {
              window.location.href = bestMatch.url;
            } else {
              window.location.href = '/search?q=' + encodeURIComponent(query);
            }
          });
        }
      })();
    </script>
  </body>
</html>
