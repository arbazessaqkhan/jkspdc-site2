---
import '../styles/global.css';
import '../styles/admin.css';
import Icon from '../components/Icon.astro';
import type { AdminTab } from '../pages/admin/types';
import { ClientRouter } from 'astro:transitions';

import { isAdmin } from '../utils/roles';

interface Props {
  title: string;
  description: string;
  activeTab: AdminTab;
}

const { title, description, activeTab } = Astro.props;
const currentYear = new Date().getFullYear();
const user = Astro.locals.user;
const userRole = (user?.role || 'VIEWER').toUpperCase();
const userIsAdmin = isAdmin(userRole);

// Absolute session expiry supplied by middleware (ISO 8601). Used for the final 30s warning.
const sessionExpiresAt = Astro.locals.sessionExpiresAt;
const serverTime = Astro.locals.serverTime;
const showSessionWarning = Boolean(sessionExpiresAt && serverTime);

const ACTIVE = 'sidebar-nav-link admin-nav-active';
const INACTIVE = 'sidebar-nav-link';

interface NavItem { href: string; tab: AdminTab; label: string; icon: string; }
interface NavSection { title: string; items: NavItem[]; adminOnly?: boolean; }

const NAV_SECTIONS: NavSection[] = [
  {
    title: 'Overview',
    items: [
      { href: '/admin/dashboard', tab: 'dashboard', label: 'Dashboard Overview', icon: 'bar-chart' },
    ],
  },
  {
    title: 'Projects & Infrastructure',
    items: [
      { href: '/admin/operational-projects', tab: 'operational', label: 'Operational Projects', icon: 'zap' },
      { href: '/admin/under-construction', tab: 'construction', label: 'Under Construction', icon: 'hardhat' },
      { href: '/admin/upcoming-projects', tab: 'upcoming', label: 'Projects Under Development', icon: 'rocket' },
      { href: '/admin/ipp-projects', tab: 'ipp', label: 'IPP Projects', icon: 'building' },
    ],
  },
  { title: 'Tenders & Procurement', items: [{ href: '/admin/tenders', tab: 'tenders', label: 'Tenders & Bids', icon: 'file-text' }] },
  {
    title: 'Corporate Governance',
    adminOnly: true,
    items: [
      { href: '/admin/dignitaries', tab: 'dignitaries', label: 'Dignitaries', icon: 'award' },
      { href: '/admin/board-of-directors', tab: 'directors', label: 'Board of Directors', icon: 'users' },
      { href: '/admin/notifications', tab: 'notifications', label: 'Notifications', icon: 'bell' },
    ],
  },
  {
    title: 'Media & Publications',
    items: [
      { href: '/admin/carousel', tab: 'carousel', label: 'Homepage Carousel', icon: 'settings' },
      { href: '/admin/gallery', tab: 'gallery', label: 'Media Gallery', icon: 'image' },
      { href: '/admin/policies', tab: 'policies', label: 'CSR Documents Manager', icon: 'file-text' },
      { href: '/admin/resources', tab: 'resources', label: 'Resources', icon: 'archive' },
    ],
  },
  {
    title: 'Contact Directory',
    items: [
      { href: '/admin/official-contacts', tab: 'official-contacts', label: 'Official Contact', icon: 'phone' },
      { href: '/admin/contact-sub-offices', tab: 'contact-sub-offices', label: 'Contact Sub-Offices', icon: 'building-2' },
    ],
  },
  { title: 'Feedback & Inquiries', items: [{ href: '/admin/contacts', tab: 'contacts', label: 'Feedbacks & Inquiries', icon: 'mail' }] },
  {
    title: 'Security & Logs',
    adminOnly: true,
    items: [
      { href: '/admin/users', tab: 'users', label: 'User Accounts', icon: 'shield-check' },
      { href: '/admin/audit-logs', tab: 'audit-logs', label: 'Audit Logs Feed', icon: 'scroll-text' },
      { href: '/admin/site-settings', tab: 'site-settings', label: 'Site Settings', icon: 'settings' },
    ],
  },
];

const visibleSections = NAV_SECTIONS.filter((s) => !s.adminOnly || userIsAdmin);
---

<!DOCTYPE html>
<html lang="en" class="h-full">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | JKSPDC Admin Portal</title>
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, nofollow" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <link rel="icon" type="image/png" href="/logo.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <!-- Quill.js Rich Text Editor Styles & Script (Admin Console Only) -->
    <link href="https://cdn.quilljs.com/1.3.6/quill.snow.css" rel="stylesheet" />
    <script is:inline src="https://cdn.quilljs.com/1.3.6/quill.min.js"></script>
    <ClientRouter />

    <script is:inline>
      (function() {
        try {
          var savedCollapsed = localStorage.getItem('admin-sidebar-collapsed');
          if (savedCollapsed === 'true') {
            document.documentElement.classList.add('sidebar-collapsed-preload');
          }
        } catch (e) {}
      })();
    </script>
  </head>
  <body class="admin-page min-h-screen h-full overflow-x-hidden flex bg-[color:var(--adm-bg-subtle)]">

    <a href="#main-admin-content" class="skip-link">Skip to Main Content</a>

    <!-- Sidebar Navigation -->
    <aside id="admin-sidebar" transition:persist="admin-sidebar" class="relative shrink-0 text-[color:var(--adm-text)] flex flex-col h-full z-45 transform -translate-x-full md:translate-x-0 md:static fixed top-0 left-0">

      <!-- Desktop Sidebar Toggle Button -->
      <button
        id="toggle-sidebar-collapse"
        type="button"
        class="sidebar-collapse-btn hidden md:flex absolute -right-3.5 top-5 z-50 w-7 h-7 rounded-full bg-white border border-[color:var(--adm-border)] text-[color:var(--adm-muted)] shadow-md items-center justify-center cursor-pointer transition-all duration-150 hover:scale-110 focus:outline-none select-none"
        aria-label="Toggle Navigation Sidebar"
        title="Toggle sidebar (icons only)"
      >
        <span id="collapse-icon-expanded" class="flex items-center justify-center">
          <Icon name="chevron-left" size={13} strokeWidth={2.5} />
        </span>
        <span id="collapse-icon-collapsed" class="hidden items-center justify-center">
          <Icon name="chevron-right" size={13} strokeWidth={2.5} />
        </span>
      </button>

      <!-- Brand Logo / Title -->
      <div class="sidebar-brand-container h-16 flex items-center px-5 gap-3 shrink-0 transition-all duration-200">
        <img src="/logo.png" alt="JKSPDC Logo" class="h-9 w-auto object-contain shrink-0" />
        <div class="sidebar-text flex flex-col min-w-0">
          <span class="admin-brand-name truncate">JKSPDC</span>
          <span class="admin-brand-sub truncate">Admin Console</span>
        </div>
      </div>

      <!-- Navigation Links -->
      <nav id="admin-nav-container" class="flex-grow py-5 px-3 overflow-y-auto flex flex-col gap-5" aria-label="Admin Navigation">
        {visibleSections.map((section) => (
          <div class="flex flex-col gap-0.5">
            <p class="sidebar-section-title uppercase px-3 tracking-wider mb-1 select-none">{section.title}</p>
            {section.items.map((item) => (
              <a
                href={item.href}
                title={item.label}
                class={`${(activeTab === item.tab || (item.tab === 'carousel' && activeTab === 'hero-slides')) ? ACTIVE : INACTIVE}`}
                aria-current={(activeTab === item.tab || (item.tab === 'carousel' && activeTab === 'hero-slides')) ? 'page' : undefined}
              >
                <Icon name={item.icon} size={15} strokeWidth={2.2} />
                <span class="sidebar-label">{item.label}</span>
              </a>
            ))}
          </div>
        ))}
      </nav>

      <!-- Sidebar Footer / Simple copyright -->
      <div class="sidebar-footer p-4 border-t border-[color:var(--adm-border)] bg-[color:var(--adm-bg-subtle)] text-[10px] text-[color:var(--adm-muted)] shrink-0 select-none">
        <p class="font-semibold text-[color:var(--adm-text)]">&copy; {currentYear} JKSPDC Admin.</p>
        <p class="mt-0.5 opacity-75">Auditing Standard: GIGW 3.0</p>
      </div>
    </aside>

    <!-- Overlay on mobile to dismiss sidebar -->
    <div id="sidebar-overlay" class="fixed inset-0 bg-black/40 z-40 hidden md:hidden"></div>

    <!-- Main Content Panel -->
    <div class="flex-grow flex flex-col min-w-0 h-full overflow-hidden">

      <!-- Top Brand Accent Line (locked palette) -->
      <div class="admin-accent-line"></div>

      <!-- Top Action Bar -->
      <header class="admin-topbar h-16 px-6 flex items-center justify-between shrink-0 select-none">

        <!-- Toggle button on mobile -->
        <button id="toggle-sidebar-btn" class="md:hidden p-2 text-[color:var(--adm-muted)] hover:bg-[color:var(--adm-bg-subtle)] rounded focus:outline-none" aria-label="Toggle Navigation Sidebar">
          <Icon name="menu" size={20} />
        </button>

        <!-- Dynamic Page Title / Breadcrumb (desktop) -->
        <h2 class="admin-topbar-crumb hidden md:block">
          JKSPDC Admin / <span class="admin-topbar-current">{title}</span>
        </h2>

        <!-- Right Utilities & Profile Session -->
        <div class="flex items-center gap-3 ml-auto">
          <!-- Profile Badge -->
          <span class="admin-role-badge select-none">
            <span class="admin-role-dot" aria-hidden="true"></span>
            {userRole}
          </span>

          <form method="POST" action="/admin/logout" class="inline m-0 p-0">
            <button type="submit" id="admin-logout-btn" class="admin-btn admin-btn-ghost-danger admin-btn-sm">
              <Icon name="x" size={13} strokeWidth={2.5} /> Sign Out
            </button>
          </form>
        </div>
      </header>

      <!-- Main Slot Content -->
      <main id="main-admin-content" transition:animate="fade" class="flex-1 min-w-0 overflow-y-auto overflow-x-hidden p-5 sm:p-6 md:p-8 bg-[color:var(--adm-bg-subtle)] focus:outline-none" tabindex="-1">
        <slot />
      </main>

    </div>

    <!-- Absolute session expiry warning: shown only during the final 30 seconds. -->
    {showSessionWarning && (
      <div id="admin-session-warning" hidden>
        <div class="fixed inset-0 z-[200] flex items-center justify-center p-4 bg-slate-900/60 backdrop-blur-[2px]">
          <div
            id="admin-session-dialog"
            role="alertdialog"
            aria-modal="true"
            aria-labelledby="admin-session-title"
            aria-describedby="admin-session-desc"
            tabindex="-1"
            data-expires-at={sessionExpiresAt}
            data-server-time={serverTime}
            class="w-full max-w-md rounded-xl border border-slate-200 bg-white p-6 shadow-2xl focus:outline-none"
          >
            <div class="flex items-start gap-4">
              <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-amber-50 text-amber-600">
                <Icon name="clock" size={22} strokeWidth={2} />
              </span>
              <div class="min-w-0">
                <h2 id="admin-session-title" class="text-base font-bold text-slate-900">Session expiring soon</h2>
                <p id="admin-session-desc" class="mt-1.5 text-xs leading-relaxed text-slate-600">
                  For security, your admin session ends automatically 30 minutes after sign-in, even while you are active. You will be signed out in
                </p>
              </div>
            </div>

            <p class="mt-5 text-center text-4xl font-bold tabular-nums text-[#0B3B60]" aria-hidden="true">
              <span id="admin-session-countdown">30</span><span class="ml-1.5 text-base font-semibold text-slate-500">seconds</span>
            </p>

            <form method="POST" action="/admin/logout?reason=timeout" class="mt-6">
              <button type="submit" class="admin-btn admin-btn-primary w-full justify-center">Sign out now</button>
            </form>
            <p class="mt-3 text-center text-[11px] text-slate-500">Any unsaved changes will be lost.</p>
          </div>
        </div>
      </div>
    )}

    <script is:inline>
      // Mobile sidebar logic
      var sidebar = document.getElementById('admin-sidebar');
      var toggleBtn = document.getElementById('toggle-sidebar-btn');
      var overlay = document.getElementById('sidebar-overlay');

      function toggleSidebar() {
        var isOpen = sidebar.classList.contains('translate-x-0');
        if (isOpen) {
          sidebar.classList.remove('translate-x-0');
          sidebar.classList.add('-translate-x-full');
          overlay.classList.add('hidden');
        } else {
          sidebar.classList.remove('-translate-x-full');
          sidebar.classList.add('translate-x-0');
          overlay.classList.remove('hidden');
        }
      }

      toggleBtn?.addEventListener('click', toggleSidebar);
      overlay?.addEventListener('click', toggleSidebar);

      function toggleSidebarCollapse() {
        var sidebar = document.getElementById('admin-sidebar');
        var isCollapsed = document.body.classList.toggle('sidebar-collapsed');
        if (sidebar) sidebar.classList.toggle('collapsed', isCollapsed);
        if (isCollapsed) {
          document.documentElement.classList.add('sidebar-collapsed-preload');
        } else {
          document.documentElement.classList.remove('sidebar-collapsed-preload');
        }
        try {
          localStorage.setItem('admin-sidebar-collapsed', isCollapsed ? 'true' : 'false');
        } catch (e) {}
      }

      function syncSidebarCollapseState(doc) {
        doc = doc || document;
        try {
          var saved = localStorage.getItem('admin-sidebar-collapsed');
          var isCollapsed = (saved === 'true');
          var body = doc.body;
          var html = doc.documentElement;
          var sidebar = doc.getElementById('admin-sidebar');
          if (isCollapsed) {
            if (body) body.classList.add('sidebar-collapsed');
            if (html) html.classList.add('sidebar-collapsed-preload');
            if (sidebar) sidebar.classList.add('collapsed');
          } else {
            if (body) body.classList.remove('sidebar-collapsed');
            if (html) html.classList.remove('sidebar-collapsed-preload');
            if (sidebar) sidebar.classList.remove('collapsed');
          }
        } catch (e) {}
      }

      document.addEventListener('click', function(e) {
        var collapseBtn = e.target.closest('#toggle-sidebar-collapse');
        if (collapseBtn) {
          e.preventDefault();
          toggleSidebarCollapse();
          return;
        }
      });

      syncSidebarCollapseState();

      // Synchronize sidebar active tab highlighting with current route on client SPA navigation.
      // Active state is driven purely by the .admin-nav-active class (styled in admin.css).
      function syncAdminSidebarActive() {
        var currentPath = window.location.pathname.replace(/\/$/, '');
        var sidebarLinks = document.querySelectorAll('#admin-sidebar nav a[href]');
        sidebarLinks.forEach(function(a) {
          var href = (a.getAttribute('href') || '').replace(/\/$/, '');
          var isActive = false;
          if (href && (currentPath === href || (href !== '/admin/dashboard' && href !== '/admin' && currentPath.startsWith(href)))) {
            isActive = true;
          }
          a.classList.toggle('admin-nav-active', isActive);
          if (isActive) {
            a.setAttribute('aria-current', 'page');
          } else {
            a.removeAttribute('aria-current');
          }
        });
      }

      function saveSidebarScroll() {
        var container = document.getElementById('admin-nav-container');
        if (container) {
          sessionStorage.setItem('admin_sidebar_scroll_pos', container.scrollTop.toString());
        }
      }

      function restoreSidebarScroll() {
        var container = document.getElementById('admin-nav-container');
        var savedPos = sessionStorage.getItem('admin_sidebar_scroll_pos');
        if (container && savedPos !== null) {
          var target = parseInt(savedPos, 10);
          if (Math.abs(container.scrollTop - target) > 3) {
            container.scrollTop = target;
          }
        }
      }

      document.addEventListener('astro:before-preparation', saveSidebarScroll);
      document.addEventListener('astro:before-swap', function(e) {
        saveSidebarScroll();
        syncSidebarCollapseState(e.newDocument);
        if (document.documentElement.classList.contains('high-contrast')) {
          e.newDocument.documentElement.classList.add('high-contrast');
        }
        if (document.documentElement.style.fontSize) {
          e.newDocument.documentElement.style.fontSize = document.documentElement.style.fontSize;
        }
      });
      document.addEventListener('astro:page-load', function() {
        syncSidebarCollapseState();
        syncAdminSidebarActive();
        restoreSidebarScroll();
        if (window.initQuillRichEditors) window.initQuillRichEditors();
      });
      syncAdminSidebarActive();
      restoreSidebarScroll();

      // Global Helper: Initialize Quill Rich Text Editors on Admin forms
      window.initQuillRichEditors = function() {
        if (typeof Quill === 'undefined') return;

        var editorContainers = document.querySelectorAll('[data-rich-editor]');
        editorContainers.forEach(function(container) {
          var targetInputId = container.dataset.richEditor;
          var targetInput = document.getElementById(targetInputId);

          function formatInitialValue(val) {
            if (!val) return '';
            var str = String(val).trim();
            if (/<[a-z][\s\S]*>/i.test(str)) {
              return str;
            }
            return str.split(/\r?\n\s*\r?\n/).map(function(p) {
              return '<p>' + p.replace(/\r?\n/g, '<br>') + '</p>';
            }).join('');
          }

          if (container.dataset.quillInitialized === 'true') {
            if (container.__quill && targetInput) {
              container.__quill.root.innerHTML = formatInitialValue(targetInput.value);
            }
            return;
          }

          var quill = new Quill(container, {
            theme: 'snow',
            placeholder: container.dataset.placeholder || 'Type formatted content here...',
            modules: {
              toolbar: [
                [{ 'header': [2, 3, 4, false] }],
                ['bold', 'italic', 'underline'],
                [{ 'list': 'ordered'}, { 'list': 'bullet' }],
                ['blockquote', 'link', 'clean']
              ]
            }
          });

          if (targetInput && targetInput.value) {
            quill.root.innerHTML = formatInitialValue(targetInput.value);
          }

          quill.on('text-change', function() {
            if (targetInput) {
              targetInput.value = quill.root.innerHTML === '<p><br></p>' ? '' : quill.root.innerHTML;
            }
          });

          var form = container.closest('form');
          if (form) {
            form.addEventListener('submit', function() {
              if (targetInput) {
                targetInput.value = quill.root.innerHTML === '<p><br></p>' ? '' : quill.root.innerHTML;
              }
            });
          }

          container.dataset.quillInitialized = 'true';
          container.__quill = quill;
        });
      };
      setTimeout(function() { if (window.initQuillRichEditors) window.initQuillRichEditors(); }, 100);
    </script>

    <!-- Absolute session timeout: 30-minute cap with a final 30-second warning. -->
    <script is:inline>
      (function () {
        var WARNING_MS = 30 * 1000;
        var CHANNEL_NAME = 'jk-spdc-admin-session';
        var expiring = false;
        var timer = null;

        function expire() {
          if (expiring) return;
          expiring = true;

          // Sign out every other open admin tab as well.
          try {
            if (window.__adminSessionChannel) {
              window.__adminSessionChannel.postMessage({ type: 'expired' });
            }
          } catch (e) {}

          // POST so the httpOnly cookie is cleared server-side, then land on login with a notice.
          var form = document.createElement('form');
          form.method = 'POST';
          form.action = '/admin/logout?reason=timeout';
          form.style.display = 'none';
          document.body.appendChild(form);
          form.submit();
        }

        window.__adminSessionExpire = expire;

        function init() {
          if (expiring) return;

          var wrapper = document.getElementById('admin-session-warning');
          var dialog = document.getElementById('admin-session-dialog');
          var countdown = document.getElementById('admin-session-countdown');
          if (!wrapper || !dialog) return;

          if (timer) {
            clearInterval(timer);
            timer = null;
          }

          var expiresAt = Date.parse(dialog.getAttribute('data-expires-at') || '');
          var serverTime = Date.parse(dialog.getAttribute('data-server-time') || '');
          if (!isFinite(expiresAt) || !isFinite(serverTime)) return;

          // Correct for client clock skew using the server's clock at page render time.
          var skew = serverTime - Date.now();

          function tick() {
            var msLeft = expiresAt - (Date.now() + skew);

            if (msLeft <= 0) {
              if (timer) {
                clearInterval(timer);
                timer = null;
              }
              expire();
              return;
            }

            if (msLeft <= WARNING_MS) {
              if (countdown) countdown.textContent = String(Math.max(1, Math.ceil(msLeft / 1000)));
              if (wrapper.hidden) {
                wrapper.hidden = false;
                if (!dialog.contains(document.activeElement)) {
                  try {
                    dialog.focus({ preventScroll: true });
                  } catch (e) {
                    dialog.focus();
                  }
                }
              }
            } else if (!wrapper.hidden) {
              wrapper.hidden = true;
            }
          }

          timer = setInterval(tick, 250);
          tick();
        }

        window.__adminSessionInit = init;

        if (!window.__adminSessionBound) {
          window.__adminSessionBound = true;

          try {
            window.__adminSessionChannel = new BroadcastChannel(CHANNEL_NAME);
            window.__adminSessionChannel.addEventListener('message', function (event) {
              if (event.data && event.data.type === 'expired' && window.__adminSessionExpire) {
                window.__adminSessionExpire();
              }
            });
          } catch (e) {}

          // Background tabs throttle timers, so re-evaluate as soon as the tab is visible again.
          document.addEventListener('visibilitychange', function () {
            if (!document.hidden && window.__adminSessionInit) window.__adminSessionInit();
          });

          // ClientRouter swaps pages without a full reload.
          document.addEventListener('astro:page-load', function () {
            if (window.__adminSessionInit) window.__adminSessionInit();
          });

          // Keep keyboard focus inside the warning while it is open.
          document.addEventListener('keydown', function (e) {
            if (e.key !== 'Tab') return;
            var wrap = document.getElementById('admin-session-warning');
            var box = document.getElementById('admin-session-dialog');
            if (!wrap || wrap.hidden || !box) return;

            var focusable = box.querySelectorAll('button, a[href], [tabindex]:not([tabindex="-1"])');
            if (!focusable.length) {
              e.preventDefault();
              box.focus();
              return;
            }
            var first = focusable[0];
            var last = focusable[focusable.length - 1];
            if (e.shiftKey && document.activeElement === first) {
              e.preventDefault();
              last.focus();
            } else if (!e.shiftKey && document.activeElement === last) {
              e.preventDefault();
              first.focus();
            }
          });
        }

        init();
      })();
    </script>

    <!-- Unified admin file uploader: one delegated controller for every
         .admin-uploader instance on the page (click / drag-drop / keyboard /
         validation / remove). Pages keep their own upload fetch logic by
         listening for the 'change' event on the native input. -->
    <script is:inline>
      (function() {
        function formatSize(bytes) {
          if (bytes >= 1024 * 1024) return (bytes / (1024 * 1024)).toFixed(1) + ' MB';
          if (bytes >= 1024) return Math.round(bytes / 1024) + ' KB';
          return bytes + ' B';
        }

        function matchesAccept(file, accept) {
          if (!accept) return true;
          var parts = accept.split(',').map(function(s) { return s.trim().toLowerCase(); }).filter(Boolean);
          var name = (file.name || '').toLowerCase();
          return parts.some(function(p) {
            if (p.startsWith('.')) return name.endsWith(p);
            if (p.endsWith('/*')) return (file.type || '').toLowerCase().startsWith(p.slice(0, -1));
            return (file.type || '').toLowerCase() === p;
          });
        }

        function showInvalid(zone, input, msg) {
          // Reject the selection completely: a rejected file must never remain
          // visible as if it were attached. If an existing valid attachment was
          // already present, restore it instead of clearing the field.
          var nameEl = zone.querySelector('.admin-uploader-file-name');
          var sizeEl = zone.querySelector('.admin-uploader-file-size');
          var preview = zone.querySelector('.admin-uploader-preview img');
          var existingName = zone.dataset.existingName || '';
          input.value = '';
          if (nameEl) nameEl.textContent = existingName;
          if (sizeEl) sizeEl.textContent = '';
          if (preview) {
            if (zone.dataset.existingUrl) {
              preview.src = zone.dataset.existingUrl;
              preview.classList.remove('invisible');
            } else {
              preview.src = '';
              preview.classList.add('invisible');
            }
          }
          zone.classList.toggle('has-file', !!existingName);
          zone.classList.add('is-invalid');
          var err = zone.querySelector('.admin-uploader-error');
          if (err) err.textContent = msg;
          var status = zone.querySelector('[id$="-status"]');
          if (status) status.textContent = msg;
          // Keep stored values when restoring an existing attachment; otherwise
          // let page scripts clear any stored URL/size for the rejected file.
          if (!existingName) {
            input.dispatchEvent(new CustomEvent('uploader:cleared', { bubbles: true }));
          }
        }

        function clearInvalid(zone) {
          zone.classList.remove('is-invalid');
          var err = zone.querySelector('.admin-uploader-error');
          if (err) err.textContent = '';
        }

        function setSelection(zone, input, files) {
          clearInvalid(zone);
          var fileRow = zone.querySelector('.admin-uploader-file');
          var nameEl = zone.querySelector('.admin-uploader-file-name');
          var sizeEl = zone.querySelector('.admin-uploader-file-size');
          var status = zone.querySelector('[id$="-status"]');
          var preview = zone.querySelector('.admin-uploader-preview img');
          if (!files || !files.length) { return; }
          zone.classList.add('has-file');
          if (nameEl) nameEl.textContent = files.length > 1 ? files.length + ' files selected' : files[0].name;
          if (sizeEl) sizeEl.textContent = files.length > 1 ? formatSize(Array.from(files).reduce(function(a, f) { return a + f.size; }, 0)) : formatSize(files[0].size);
          if (preview && files.length === 1 && (files[0].type || '').startsWith('image/')) {
            preview.src = URL.createObjectURL(files[0]);
            preview.classList.remove('invisible');
          }
          // Remember this accepted selection so a later rejected file can
          // restore the last valid choice instead of leaving the field empty.
          zone.dataset.existingName = files.length > 1 ? files.length + ' files selected' : files[0].name;
          if (preview && files.length === 1 && preview.src) zone.dataset.existingUrl = preview.src;
          if (status) status.textContent = files.length > 1
            ? files.length + ' files selected'
            : files[0].name + ', ' + formatSize(files[0].size);
        }

        function clearSelection(zone, input, silent) {
          input.value = '';
          zone.classList.remove('has-file');
          clearInvalid(zone);
          var nameEl = zone.querySelector('.admin-uploader-file-name');
          var sizeEl = zone.querySelector('.admin-uploader-file-size');
          var preview = zone.querySelector('.admin-uploader-preview img');
          var status = zone.querySelector('[id$="-status"]');
          if (nameEl) nameEl.textContent = '';
          if (sizeEl) sizeEl.textContent = '';
          if (preview) { preview.src = ''; preview.classList.add('invisible'); }
          if (status) status.textContent = 'File removed';
          // Forget any remembered selection so a later invalid file is not
          // silently restored after the user explicitly removed the file.
          delete zone.dataset.existingName;
          delete zone.dataset.existingUrl;
          // Notify page scripts the selection was cleared. Skip this when the
          // reset originated from `uploader:cleared` itself to avoid a loop.
          if (!silent) {
            input.dispatchEvent(new CustomEvent('uploader:cleared', { bubbles: true }));
          }
        }

        function handleFiles(zone, input, files) {
          if (!files || !files.length) return;
          var maxMB = parseFloat(zone.dataset.maxSizeMb || '0');
          var accept = zone.dataset.accept || '';
          var variant = zone.dataset.variant || 'document';
          for (var i = 0; i < files.length; i++) {
            if (!matchesAccept(files[i], accept)) {
              showInvalid(zone, input, 'File type not allowed. Allowed: ' + accept);
              return;
            }
            if (maxMB > 0 && files[i].size > maxMB * 1024 * 1024) {
              var errorPrefix = variant === 'image' ? 'Image' : 'File';
              showInvalid(zone, input, errorPrefix + ' exceeds the maximum allowed size of ' + maxMB + ' MB.');
              return;
            }
          }
          setSelection(zone, input, files);
        }

        function bindZone(zone) {
          if (zone.dataset.uploaderBound) return;
          zone.dataset.uploaderBound = 'true';
          var input = zone.querySelector('input[type="file"]');
          if (!input) return;

          zone.addEventListener('click', function(e) {
            if (e.target.closest('.admin-uploader-file-remove')) return;
            input.click();
          });
          zone.addEventListener('keydown', function(e) {
            if ((e.key === 'Enter' || e.key === ' ') && e.target === zone) {
              e.preventDefault();
              input.click();
            }
          });
          zone.addEventListener('dragover', function(e) { e.preventDefault(); zone.classList.add('is-dragover'); });
          zone.addEventListener('dragleave', function(e) { e.preventDefault(); zone.classList.remove('is-dragover'); });
          zone.addEventListener('drop', function(e) {
            e.preventDefault();
            zone.classList.remove('is-dragover');
            if (e.dataTransfer && e.dataTransfer.files) {
              if (!input.multiple) { input.files = e.dataTransfer.files; }
              handleFiles(zone, input, e.dataTransfer.files);
              // Always fire change so page upload logic runs
              input.dispatchEvent(new Event('change', { bubbles: true }));
            }
          });
          zone.addEventListener('change', function(e) {
            if (e.target === input) handleFiles(zone, input, input.files);
          });
          // Page scripts reset the uploader by dispatching this event (for
          // example after a save or Cancel). Clear the visible chip as well.
          // Only act when a file is shown, so our own notifications (which may
          // accompany a validation error) never erase that error.
          input.addEventListener('uploader:cleared', function() {
            if (zone.classList.contains('has-file')) clearSelection(zone, input, true);
          });
          var removeBtn = zone.querySelector('.admin-uploader-file-remove');
          if (removeBtn) {
            removeBtn.addEventListener('click', function(e) {
              e.preventDefault();
              e.stopPropagation();
              clearSelection(zone, input);
            });
          }
        }

        function bindAll(root) {
          (root || document).querySelectorAll('.admin-uploader').forEach(bindZone);
        }

        // Re-bind after Astro view transitions
        document.addEventListener('astro:page-load', function() { bindAll(document); });
        document.addEventListener('astro:after-swap', function() { bindAll(document); });
        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', function() { bindAll(document); });
        } else {
          bindAll(document);
        }
        window.bindAdminUploaders = bindAll;
      })();
    </script>
  </body>
</html>
