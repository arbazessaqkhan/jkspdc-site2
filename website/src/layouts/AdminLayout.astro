---
import '../styles/global.css';
import '../styles/admin.css';
import Icon from '../components/Icon.astro';
import type { AdminTab } from '../pages/admin/types';
import { ClientRouter } from 'astro:transitions';

import { isAdmin } from '../utils/roles';

interface Props {
  title: string;
  description: string;
  activeTab: AdminTab;
}

const { title, description, activeTab } = Astro.props;
const currentYear = new Date().getFullYear();
const user = Astro.locals.user;
const userRole = (user?.role || 'VIEWER').toUpperCase();
const userIsAdmin = isAdmin(userRole);

const ACTIVE = 'sidebar-nav-link admin-nav-active';
const INACTIVE = 'sidebar-nav-link';

interface NavItem { href: string; tab: AdminTab; label: string; icon: string; }
interface NavSection { title: string; items: NavItem[]; adminOnly?: boolean; }

const NAV_SECTIONS: NavSection[] = [
  { title: 'Overview', items: [{ href: '/admin/dashboard', tab: 'dashboard', label: 'Dashboard Overview', icon: 'bar-chart' }] },
  {
    title: 'Projects & Infrastructure',
    items: [
      { href: '/admin/operational-projects', tab: 'operational', label: 'Operational Projects', icon: 'zap' },
      { href: '/admin/under-construction', tab: 'construction', label: 'Under Construction', icon: 'hardhat' },
      { href: '/admin/upcoming-projects', tab: 'upcoming', label: 'Projects Under Development', icon: 'rocket' },
      { href: '/admin/ipp-projects', tab: 'ipp', label: 'IPP Projects', icon: 'building' },
    ],
  },
  { title: 'Tenders & Procurement', items: [{ href: '/admin/tenders', tab: 'tenders', label: 'Tenders & Bids', icon: 'file-text' }] },
  {
    title: 'Corporate Governance',
    adminOnly: true,
    items: [
      { href: '/admin/dignitaries', tab: 'dignitaries', label: 'Dignitaries', icon: 'award' },
      { href: '/admin/board-of-directors', tab: 'directors', label: 'Board of Directors', icon: 'users' },
      { href: '/admin/notifications', tab: 'notifications', label: 'Notifications', icon: 'bell' },
    ],
  },
  {
    title: 'Media & Publications',
    items: [
      { href: '/admin/gallery', tab: 'gallery', label: 'Media Gallery', icon: 'image' },
      { href: '/admin/policies', tab: 'policies', label: 'CSR Documents Manager', icon: 'file-text' },
      { href: '/admin/resources', tab: 'resources', label: 'Resources', icon: 'archive' },
    ],
  },
  {
    title: 'Contact Directory',
    items: [
      { href: '/admin/official-contacts', tab: 'official-contacts', label: 'Official Contact', icon: 'phone' },
      { href: '/admin/contact-sub-offices', tab: 'contact-sub-offices', label: 'Contact Sub-Offices', icon: 'building-2' },
    ],
  },
  { title: 'Feedback & Inquiries', items: [{ href: '/admin/contacts', tab: 'contacts', label: 'Feedbacks & Inquiries', icon: 'mail' }] },
  {
    title: 'Security & Logs',
    adminOnly: true,
    items: [
      { href: '/admin/users', tab: 'users', label: 'User Accounts', icon: 'shield-check' },
      { href: '/admin/audit-logs', tab: 'audit-logs', label: 'Audit Logs Feed', icon: 'scroll-text' },
      { href: '/admin/site-settings', tab: 'site-settings', label: 'Site Settings', icon: 'settings' },
    ],
  },
];

const visibleSections = NAV_SECTIONS.filter((s) => !s.adminOnly || userIsAdmin);
---

<!DOCTYPE html>
<html lang="en" class="h-full">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | JKSPDC Admin Portal</title>
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, nofollow" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <link rel="icon" type="image/png" href="/logo.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <!-- Quill.js Rich Text Editor Styles & Script (Admin Console Only) -->
    <link href="https://cdn.quilljs.com/1.3.6/quill.snow.css" rel="stylesheet" />
    <script is:inline src="https://cdn.quilljs.com/1.3.6/quill.min.js"></script>
    <ClientRouter />

    <script is:inline>
      (function() {
        try {
          var savedCollapsed = localStorage.getItem('admin-sidebar-collapsed');
          if (savedCollapsed === 'true') {
            document.documentElement.classList.add('sidebar-collapsed-preload');
          }
        } catch (e) {}
      })();
    </script>
  </head>
  <body class="admin-page min-h-screen h-full overflow-x-hidden flex bg-[color:var(--adm-bg-subtle)]">
    <a href="#main-admin-content" class="skip-link">Skip to Main Content</a>

    <!-- Sidebar Navigation -->
    <aside id="admin-sidebar" transition:persist="admin-sidebar" class="relative shrink-0 text-[color:var(--adm-text)] flex flex-col h-full z-45 transform -translate-x-full md:translate-x-0 md:static fixed top-0 left-0">

      <!-- Desktop Sidebar Toggle Button -->
      <button
        id="toggle-sidebar-collapse"
        type="button"
        class="sidebar-collapse-btn hidden md:flex absolute -right-3.5 top-5 z-50 w-7 h-7 rounded-full bg-white border border-[color:var(--adm-border)] text-[color:var(--adm-muted)] shadow-md items-center justify-center cursor-pointer transition-all duration-150 hover:scale-110 focus:outline-none select-none"
        aria-label="Toggle Navigation Sidebar"
        title="Toggle sidebar (icons only)"
      >
        <span id="collapse-icon-expanded" class="flex items-center justify-center">
          <Icon name="chevron-left" size={13} strokeWidth={2.5} />
        </span>
        <span id="collapse-icon-collapsed" class="hidden items-center justify-center">
          <Icon name="chevron-right" size={13} strokeWidth={2.5} />
        </span>
      </button>

      <!-- Brand Logo / Title -->
      <div class="sidebar-brand-container h-16 flex items-center px-5 gap-3 shrink-0 transition-all duration-200">
        <img src="/logo.png" alt="JKSPDC Logo" class="h-9 w-auto object-contain shrink-0" />
        <div class="sidebar-text flex flex-col min-w-0">
          <span class="admin-brand-name truncate">JKSPDC</span>
          <span class="admin-brand-sub truncate">Admin Console</span>
        </div>
      </div>

      <!-- Navigation Links -->
      <nav id="admin-nav-container" class="flex-grow py-5 px-3 overflow-y-auto flex flex-col gap-5" aria-label="Admin Navigation">
        {visibleSections.map((section) => (
          <div class="flex flex-col gap-0.5">
            <p class="sidebar-section-title uppercase px-3 tracking-wider mb-1 select-none">{section.title}</p>
            {section.items.map((item) => (
              <a
                href={item.href}
                title={item.label}
                class={`${activeTab === item.tab ? ACTIVE : INACTIVE}`}
                aria-current={activeTab === item.tab ? 'page' : undefined}
              >
                <Icon name={item.icon} size={15} strokeWidth={2.2} />
                <span class="sidebar-label">{item.label}</span>
              </a>
            ))}
          </div>
        ))}
      </nav>

      <!-- Sidebar Footer / Simple copyright -->
      <div class="sidebar-footer p-4 border-t border-[color:var(--adm-border)] bg-[color:var(--adm-bg-subtle)] text-[10px] text-[color:var(--adm-muted)] shrink-0 select-none">
        <p class="font-semibold text-[color:var(--adm-text)]">&copy; {currentYear} JKSPDC Admin.</p>
        <p class="mt-0.5 opacity-75">Auditing Standard: GIGW 3.0</p>
      </div>
    </aside>

    <!-- Overlay on mobile to dismiss sidebar -->
    <div id="sidebar-overlay" class="fixed inset-0 bg-black/40 z-40 hidden md:hidden"></div>

    <!-- Main Content Panel -->
    <div class="flex-grow flex flex-col min-w-0 h-full overflow-hidden">

      <!-- Top Brand Accent Line (locked palette) -->
      <div class="admin-accent-line"></div>

      <!-- Top Action Bar -->
      <header class="admin-topbar h-16 px-6 flex items-center justify-between shrink-0 select-none">

        <!-- Toggle button on mobile -->
        <button id="toggle-sidebar-btn" class="md:hidden p-2 text-[color:var(--adm-muted)] hover:bg-[color:var(--adm-bg-subtle)] rounded focus:outline-none" aria-label="Toggle Navigation Sidebar">
          <Icon name="menu" size={20} />
        </button>

        <!-- Dynamic Page Title / Breadcrumb (desktop) -->
        <h2 class="admin-topbar-crumb hidden md:block">
          JKSPDC Admin / <span class="admin-topbar-current">{title}</span>
        </h2>

        <!-- Right Utilities & Profile Session -->
        <div class="flex items-center gap-3 ml-auto">
          <!-- Profile Badge -->
          <span class="admin-role-badge select-none">
            <span class="admin-role-dot" aria-hidden="true"></span>
            {userRole}
          </span>

          <form method="POST" action="/admin/logout" class="inline m-0 p-0">
            <button type="submit" id="admin-logout-btn" class="admin-btn admin-btn-ghost-danger admin-btn-sm">
              <Icon name="x" size={13} strokeWidth={2.5} /> Sign Out
            </button>
          </form>
        </div>
      </header>

      <!-- Main Slot Content -->
      <main id="main-admin-content" transition:animate="fade" class="flex-1 min-w-0 overflow-y-auto overflow-x-hidden p-5 sm:p-6 md:p-8 bg-[color:var(--adm-bg-subtle)] focus:outline-none" tabindex="-1">
        <slot />
      </main>

    </div>

    <script is:inline>
      // Mobile sidebar logic
      var sidebar = document.getElementById('admin-sidebar');
      var toggleBtn = document.getElementById('toggle-sidebar-btn');
      var overlay = document.getElementById('sidebar-overlay');

      function toggleSidebar() {
        var isOpen = sidebar.classList.contains('translate-x-0');
        if (isOpen) {
          sidebar.classList.remove('translate-x-0');
          sidebar.classList.add('-translate-x-full');
          overlay.classList.add('hidden');
        } else {
          sidebar.classList.remove('-translate-x-full');
          sidebar.classList.add('translate-x-0');
          overlay.classList.remove('hidden');
        }
      }

      toggleBtn?.addEventListener('click', toggleSidebar);
      overlay?.addEventListener('click', toggleSidebar);

      function toggleSidebarCollapse() {
        var sidebar = document.getElementById('admin-sidebar');
        var isCollapsed = document.body.classList.toggle('sidebar-collapsed');
        if (sidebar) sidebar.classList.toggle('collapsed', isCollapsed);
        if (isCollapsed) {
          document.documentElement.classList.add('sidebar-collapsed-preload');
        } else {
          document.documentElement.classList.remove('sidebar-collapsed-preload');
        }
        try {
          localStorage.setItem('admin-sidebar-collapsed', isCollapsed ? 'true' : 'false');
        } catch (e) {}
      }

      function syncSidebarCollapseState(doc) {
        doc = doc || document;
        try {
          var saved = localStorage.getItem('admin-sidebar-collapsed');
          var isCollapsed = (saved === 'true');
          var body = doc.body;
          var html = doc.documentElement;
          var sidebar = doc.getElementById('admin-sidebar');
          if (isCollapsed) {
            if (body) body.classList.add('sidebar-collapsed');
            if (html) html.classList.add('sidebar-collapsed-preload');
            if (sidebar) sidebar.classList.add('collapsed');
          } else {
            if (body) body.classList.remove('sidebar-collapsed');
            if (html) html.classList.remove('sidebar-collapsed-preload');
            if (sidebar) sidebar.classList.remove('collapsed');
          }
        } catch (e) {}
      }

      document.addEventListener('click', function(e) {
        var collapseBtn = e.target.closest('#toggle-sidebar-collapse');
        if (collapseBtn) {
          e.preventDefault();
          toggleSidebarCollapse();
          return;
        }
      });

      syncSidebarCollapseState();

      // Synchronize sidebar active tab highlighting with current route on client SPA navigation.
      // Active state is driven purely by the .admin-nav-active class (styled in admin.css).
      function syncAdminSidebarActive() {
        var currentPath = window.location.pathname.replace(/\/$/, '');
        var sidebarLinks = document.querySelectorAll('#admin-sidebar nav a[href]');
        sidebarLinks.forEach(function(a) {
          var href = (a.getAttribute('href') || '').replace(/\/$/, '');
          var isActive = false;
          if (href && (currentPath === href || (href !== '/admin/dashboard' && href !== '/admin' && currentPath.startsWith(href)))) {
            isActive = true;
          }
          a.classList.toggle('admin-nav-active', isActive);
          if (isActive) {
            a.setAttribute('aria-current', 'page');
          } else {
            a.removeAttribute('aria-current');
          }
        });
      }

      function saveSidebarScroll() {
        var container = document.getElementById('admin-nav-container');
        if (container) {
          sessionStorage.setItem('admin_sidebar_scroll_pos', container.scrollTop.toString());
        }
      }

      function restoreSidebarScroll() {
        var container = document.getElementById('admin-nav-container');
        var savedPos = sessionStorage.getItem('admin_sidebar_scroll_pos');
        if (container && savedPos !== null) {
          var target = parseInt(savedPos, 10);
          if (Math.abs(container.scrollTop - target) > 3) {
            container.scrollTop = target;
          }
        }
      }

      document.addEventListener('astro:before-preparation', saveSidebarScroll);
      document.addEventListener('astro:before-swap', function(e) {
        saveSidebarScroll();
        syncSidebarCollapseState(e.newDocument);
        if (document.documentElement.classList.contains('high-contrast')) {
          e.newDocument.documentElement.classList.add('high-contrast');
        }
        if (document.documentElement.style.fontSize) {
          e.newDocument.documentElement.style.fontSize = document.documentElement.style.fontSize;
        }
      });
      document.addEventListener('astro:page-load', function() {
        syncSidebarCollapseState();
        syncAdminSidebarActive();
        restoreSidebarScroll();
        if (window.initQuillRichEditors) window.initQuillRichEditors();
      });
      syncAdminSidebarActive();
      restoreSidebarScroll();

      // Global Helper: Initialize Quill Rich Text Editors on Admin forms
      window.initQuillRichEditors = function() {
        if (typeof Quill === 'undefined') return;

        var editorContainers = document.querySelectorAll('[data-rich-editor]');
        editorContainers.forEach(function(container) {
          var targetInputId = container.dataset.richEditor;
          var targetInput = document.getElementById(targetInputId);

          function formatInitialValue(val) {
            if (!val) return '';
            var str = String(val).trim();
            if (/<[a-z][\s\S]*>/i.test(str)) {
              return str;
            }
            return str.split(/\r?\n\s*\r?\n/).map(function(p) {
              return '<p>' + p.replace(/\r?\n/g, '<br>') + '</p>';
            }).join('');
          }

          if (container.dataset.quillInitialized === 'true') {
            if (container.__quill && targetInput) {
              container.__quill.root.innerHTML = formatInitialValue(targetInput.value);
            }
            return;
          }

          var quill = new Quill(container, {
            theme: 'snow',
            placeholder: container.dataset.placeholder || 'Type formatted content here...',
            modules: {
              toolbar: [
                [{ 'header': [2, 3, 4, false] }],
                ['bold', 'italic', 'underline'],
                [{ 'list': 'ordered'}, { 'list': 'bullet' }],
                ['blockquote', 'link', 'clean']
              ]
            }
          });

          if (targetInput && targetInput.value) {
            quill.root.innerHTML = formatInitialValue(targetInput.value);
          }

          quill.on('text-change', function() {
            if (targetInput) {
              targetInput.value = quill.root.innerHTML === '<p><br></p>' ? '' : quill.root.innerHTML;
            }
          });

          var form = container.closest('form');
          if (form) {
            form.addEventListener('submit', function() {
              if (targetInput) {
                targetInput.value = quill.root.innerHTML === '<p><br></p>' ? '' : quill.root.innerHTML;
              }
            });
          }

          container.dataset.quillInitialized = 'true';
          container.__quill = quill;
        });
      };
      setTimeout(function() { if (window.initQuillRichEditors) window.initQuillRichEditors(); }, 100);
    </script>
  </body>
</html>
